Dialogue: 0,0:00:01.35,0:00:03.39,Default,,0,0,0,,Hey! Ne oldu Tsubasa?
Dialogue: 0,0:00:03.73,0:00:05.52,Default,,0,0,0,,Çözemedin mi bunu?
Dialogue: 0,0:00:07.32,0:00:12.04,Default,,0,0,0,,Eğer bu seviyede devam edersen turnuvayı kazansan bile Brezilya'ya gidemezsin.
Dialogue: 0,0:00:12.04,0:00:14.40,Default,,0,0,0,,Evet, o problem olabilir...
Dialogue: 0,0:00:16.18,0:00:18.28,Default,,0,0,0,,Carlos, kısa bir ara verelim olur mu?
Dialogue: 0,0:00:18.28,0:00:21.94,Default,,0,0,0,,Hayır! Futbolda ara veremezsin!
Dialogue: 0,0:00:21.94,0:00:23.29,Default,,0,0,0,,Wakabayashi'den! {zero shits given}
Dialogue: 0,0:00:23.29,0:00:27.27,Default,,0,0,0,,{le typesetter nightmare}{holy shit what the fuck is that :o learn 2 insta msg, waka!}
Dialogue: 0,0:00:24.08,0:00:27.27,Default,,0,0,0,,{\i1}Ne var ne yok Tsubasa?{\i0}
Dialogue: 0,0:00:27.27,0:00:33.30,Default,,0,0,0,,{\i1}Hamburg'daki klübe katıldığımdan beri her gün antreman yapıyorum. {I'm practicing everyday after I got in this club at Hamburg.} {or the club name is? dear tsu-wikis enlighten me}{\i0}{or "after joining this Hamburger club". I love calling ppl living in Hamburg Hamburger too}
Dialogue: 0,0:00:33.30,0:00:37.80,Default,,0,0,0,,Japoyonya'daki geleneksel \Nturnuva başlamak üzere değil mi?
Dialogue: 0,0:00:37.80,0:00:41.81,Default,,0,0,0,,{\i1}Zaferlerini övmelerini dinlemekten yoruldum.{\i0}
Dialogue: 0,0:00:41.81,0:00:45.08,Default,,0,0,0,,{\i1}Bundan sonra sadece yenildiğinde haber ver. {dafuq, just how many mails tsubasa spammed}{he tags waka in every instagram post and embarasses him} {\i0}{yea p much}
Dialogue: 0,0:00:45.08,0:00:47.81,Default,,0,0,0,,{\i1}Seni yenebilecek kişi oldukça ilgimi çeker.{\i0}
Dialogue: 0,0:00:48.48,0:00:51.32,Default,,0,0,0,,{\i1}Aslında sana bu maili göderme sebebim{\i0}
Dialogue: 0,0:00:51.32,0:00:56.92,Default,,0,0,0,,{\i1}senin yaşlarında çok yetenekli biriyle görüşmüş olmam.{\i0}
Dialogue: 0,0:00:58.87,0:01:00.36,Default,,0,0,0,,Wakabayashi!
Dialogue: 0,0:01:12.49,0:01:14.05,Default,,0,0,0,,Mi...
Dialogue: 0,0:01:14.05,0:01:16.43,Default,,0,0,0,,Misaki! {football Jesus is back!}
Dialogue: 0,0:01:16.43,0:01:17.36,Default,,0,0,0,,{\i1}Bil bakalım kim.{\i0}
Dialogue: 0,0:01:17.36,0:01:19.97,Default,,0,0,0,,{\i1}Taro Misaki!{\i0}
Dialogue: 0,0:01:19.97,0:02:50.02,Default,,0,0,0,,{OP}
