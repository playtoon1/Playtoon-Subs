Dialogue: 0,0:20:33.34,0:20:34.25,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:20:34.25,0:20:37.75,Default,,0,0,0,,{surprised pikachu meme}
Dialogue: 0,0:20:42.76,0:20:44.46,Default,,0,0,0,,Acele et!
Dialogue: 0,0:20:47.16,0:20:49.14,Default,,0,0,0,,Görünüşe göre tam vaktinde geldik!
Dialogue: 0,0:20:49.14,0:20:52.64,Default,,0,0,0,,Hadi ezin onları hadi!
Dialogue: 0,0:20:52.93,0:20:56.19,Default,,0,0,0,,HADİ! HADİ! Nankatsu! {srsly tho just fking change this already}
Dialogue: 0,0:20:56.19,0:20:57.99,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:20:58.69,0:21:00.98,Default,,0,0,0,,Söz verdiğimiz gibi sizi desteklemeye geldik!
Dialogue: 0,0:21:00.98,0:21:02.58,Default,,0,0,0,,Ah, Urabe ve diğerleri gelmiş!
Dialogue: 0,0:21:02.58,0:21:05.93,Default,,0,0,0,,Shizuoka'nın temsilcilerisiniz siz!
Dialogue: 0,0:21:05.93,0:21:07.57,Default,,0,0,0,,Şampiyon olmadan gelmeyin!
Dialogue: 0,0:21:07.57,0:21:09.57,Default,,0,0,0,,Yoksa acımam size! {now that boy is swag}
Dialogue: 0,0:21:09.57,0:21:11.10,Default,,0,0,0,,Kesinlikle güvenin bize!
Dialogue: 0,0:21:11.10,0:21:14.04,Default,,0,0,0,,Hey, kendine gel biraz!
Dialogue: 0,0:21:14.04,0:21:14.58,Default,,0,0,0,,Ne dedin sen?!
Dialogue: 0,0:21:14.97,0:21:18.17,Default,,0,0,0,,İki kez şampiyon oldunuz diye kendinize güvenmeyin.
Dialogue: 0,0:21:18.17,0:21:19.87,Default,,0,0,0,,Yiyorsa bir daha de pislik!
Dialogue: 0,0:21:19.87,0:21:20.75,Default,,0,0,0,,Ishizaki. {https://comment-cdn.9gag.com/image?ref=9gag.com#https://img-comment-fun.9cache.com/media/a9dnPzm/aQeP6L5m_700w_0.jpg, the most suitable thing ever for this}
Dialogue: 0,0:21:22.70,0:21:24.85,Default,,0,0,0,,Sen de öyle Tsubasa Ozora.
Dialogue: 0,0:21:24.85,0:21:27.68,Default,,0,0,0,,O kadar da korkunç gözükmüyorsun.
Dialogue: 0,0:21:27.68,0:21:30.06,Default,,0,0,0,,Seni ben markajlayacağım o yüzden birbirimize nazik olalım.
Dialogue: 0,0:21:30.06,0:21:33.06,Default,,0,0,0,,Hey sen düzgün konuş.
Dialogue: 0,0:21:33.06,0:21:36.81,Default,,0,0,0,,Maçtan önce bile olsa, eğer böyle devam edersen, seni çıkaracağım. {a refereee who does other things than blowing his whistle!}
Dialogue: 0,0:21:36.81,0:21:38.20,Default,,0,0,0,,Sırana geç!
Dialogue: 0,0:21:38.20,0:21:40.32,Default,,0,0,0,,Peki, tamam, tamam, anladım.
Dialogue: 0,0:21:41.74,0:21:44.82,Default,,0,0,0,,Bu Makoto Soda.
Dialogue: 0,0:21:44.82,0:21:48.54,Default,,0,0,0,,{\i1}Yazı turayla topu Nankatsu aldı.{\i0}
Dialogue: 0,0:21:48.54,0:21:52.16,Default,,0,0,0,,{\i1}İki takım da yerlerine geçti.{\i0}
Dialogue: 0,0:21:52.16,0:21:54.29,Default,,0,0,0,,{\i1}Hadi ilk maça başlayalım.{\i0}
Dialogue: 0,0:21:54.29,0:21:56.54,Default,,0,0,0,,{\i1}Yine şampiyon olacağız!{\i0}
