Dialogue: 0,0:10:08.97,0:10:13.96,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:02.06,0:00:05.14,Default,,0,0,0,,{\i1}İkinci yarıda Meiwa\Nsahaya çok azimli çıkmıştı.{\i0}
Dialogue: 0,0:00:10.02,0:00:14.24,Default,,0,0,0,,{\i1}Sürekli köşeye sıkıştırarak sonunda\Nberaberliği sağlamışlardı.{\i0}
Dialogue: 0,0:00:15.11,0:00:20.82,Default,,0,0,0,,{\i1}Nankatsu SC, Meiwa FC'nin ataklarını\Nhep birlikte defansta durarak engelliyor.{\i0}
Dialogue: 0,0:00:20.82,0:00:25.71,Default,,0,0,0,,{\i1}Ve en güvendikleri oyuncu Misaki-kun\Nayağına tedavi gördükten sonra...{\i0}
Dialogue: 0,0:00:25.71,0:00:28.46,Default,,0,0,0,,{\i1}...sahaya döndü!{\i0}
Dialogue: 0,0:00:28.46,0:00:29.84,Default,,0,0,0,,Misaki-kun.
Dialogue: 0,0:00:29.84,0:00:32.63,Default,,0,0,0,,Ne düşündüğünü biliyorum.
Dialogue: 0,0:00:32.63,0:00:35.51,Default,,0,0,0,,Topu alıp sana pas atacağım.
Dialogue: 0,0:00:36.57,0:00:40.55,Default,,0,0,0,,{\i1}Tsubasa'nın kontra atağı şimdi başlıyor!{\i0}
Dialogue: 0,0:00:40.55,0:00:41.88,Default,,0,0,0,,Misaki!
Dialogue: 0,0:00:41.88,0:00:43.45,Default,,0,0,0,,Sana güveniyoruz Misaki!
Dialogue: 0,0:00:43.45,0:00:45.31,Default,,0,0,0,,Elinden geleni yap Misaki!
Dialogue: 0,0:00:45.31,0:00:47.38,Default,,0,0,0,,Koç, emin misiniz?
Dialogue: 0,0:00:47.38,0:00:50.92,Default,,0,0,0,,Bu maçtan sonra başka okula transfer olacak.
Dialogue: 0,0:00:50.92,0:00:52.74,Default,,0,0,0,,Herkesle son anısı.
Dialogue: 0,0:00:52.74,0:00:54.24,Default,,0,0,0,,Oynamak istiyorsa oynasın.
Dialogue: 0,0:00:54.24,0:00:55.82,Default,,0,0,0,,A-Ama...
Dialogue: 0,0:00:55.82,0:00:59.32,Default,,0,0,0,,Misaki, takımı en çok umursayan kişi.
Dialogue: 0,0:00:59.32,0:01:01.92,Default,,0,0,0,,Yaralandığı için istediği\Ngibi oynayamazsa...
Dialogue: 0,0:01:01.92,0:01:04.23,Default,,0,0,0,,...ve takıma yük olduğunu fark ederse...
Dialogue: 0,0:01:04.23,0:01:07.04,Default,,0,0,0,,...kendisi çıkmak isteyecektir.
Dialogue: 0,0:01:07.04,0:01:07.84,Default,,0,0,0,,Hadi!
Dialogue: 0,0:01:07.84,0:01:10.92,Default,,0,0,0,,Ne olursa olsun kale önündeki\NHyuga-san'a ulaştırın!
Dialogue: 0,0:01:15.30,0:01:16.77,Default,,0,0,0,,Misaki-san!
Dialogue: 0,0:01:18.36,0:01:19.64,Default,,0,0,0,,Taro...
Dialogue: 0,0:01:19.64,0:01:23.58,Default,,0,0,0,,{\i1}Misaki-kun, senin yaran benimkinden daha kötü.{\i0}
Dialogue: 0,0:01:23.58,0:01:27.27,Default,,0,0,0,,{\i1}Yine de bu acıya dayanarak\Ntopu bana ulaştırmaya çalışıyorsun.{\i0}
Dialogue: 0,0:01:27.27,0:01:29.96,Default,,0,0,0,,{\i1}Bu çabana cevap olarak...{\i0}
Dialogue: 0,0:01:29.96,0:01:32.90,Default,,0,0,0,,{\i1}...kesinlikle gol atacağım!{\i0}
Dialogue: 0,0:03:04.24,0:03:09.24,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}Bölüm 25:\NKontra Atak Vakti
Dialogue: 0,0:03:04.24,0:03:09.24,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs55\pos(1504,1022.333)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:03:06.74,0:03:09.75,Default - Top,,0,0,0,,{\i1}Hyuga-kun'a orta açmasını engellemek için...{\i0}
Dialogue: 0,0:03:09.75,0:03:12.33,Default,,0,0,0,,{\i1}...Misaki-kun onu tutuyor.{\i0}
Dialogue: 0,0:03:14.33,0:03:15.38,Default,,0,0,0,,Misaki...
Dialogue: 0,0:03:16.06,0:03:18.42,Default,,0,0,0,,{\i1}Sawada-kun orta sahanın kalbi.{\i0}
Dialogue: 0,0:03:18.42,0:03:22.76,Default,,0,0,0,,{\i1}O bu kadar baskılanıyorken\NMeiwa düzeni sağlayamaz.{\i0}
Dialogue: 0,0:03:23.88,0:03:27.66,Default,,0,0,0,,{\i1}Misaki-san'ın yaralanması benim hatam.{\i0}
Dialogue: 0,0:03:27.66,0:03:30.04,Default,,0,0,0,,{\t(1899,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Ama yapacak bir şeyim yok.{\i0}
Dialogue: 0,0:03:30.48,0:03:32.23,Default,,0,0,0,,{\i1}Kendimi tutamam!{\i0}
Dialogue: 0,0:03:33.52,0:03:35.27,Default,,0,0,0,,{\i1}Sawada-kun çalımlıyor!{\i0}
Dialogue: 0,0:03:37.08,0:03:38.40,Default,,0,0,0,,{\i1}Ve duvar pası!{\i0}
Dialogue: 0,0:03:38.40,0:03:39.82,Default,,0,0,0,,{\i1}Misaki-kun'u geçiyor!{\i0}
Dialogue: 0,0:03:39.82,0:03:41.30,Default,,0,0,0,,{\i1}Eyvah!{\i0}
Dialogue: 0,0:03:41.30,0:03:42.78,Default,,0,0,0,,{\i1}Şimdi Kojiro'yu tutmalıyım!{\i0}
Dialogue: 0,0:03:43.78,0:03:44.94,Default,,0,0,0,,{\i1}Aynen öyle.{\i0}
Dialogue: 0,0:03:44.94,0:03:49.15,Default,,0,0,0,,{\i1}Tek amacım Hyuga-san'a\Npas vermek.{\i0}
Dialogue: 0,0:03:49.15,0:03:50.94,Default,,0,0,0,,Meiwa'nın zaferi için...
Dialogue: 0,0:03:50.94,0:03:52.58,Default,,0,0,0,,Hyuga-san, sana güveniyorum!
Dialogue: 0,0:03:54.00,0:03:54.75,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:03:54.75,0:03:56.92,Default,,0,0,0,,Güzel pas Takeshi!
Dialogue: 0,0:03:57.82,0:04:00.59,Default,,0,0,0,,{\i1}Misaki-kun pası kesiyor!{\i0}
Dialogue: 0,0:04:00.59,0:04:01.46,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:01.46,0:04:03.63,Default,,0,0,0,,{\i1}Ama top, Hyuga-kun'dan sekiyor.{\i0}
Dialogue: 0,0:04:03.63,0:04:05.18,Default,,0,0,0,,{\i1}Henüz her şey bitmedi.{\i0}
Dialogue: 0,0:04:05.18,0:04:06.09,Default,,0,0,0,,Uzaklaştıralım!
Dialogue: 0,0:04:06.74,0:04:08.16,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:04:08.16,0:04:10.06,Default,,0,0,0,,{\i1}Hyuga-kun kafa vuruşu yapıyor!{\i0}
Dialogue: 0,0:04:11.58,0:04:15.00,Default,,0,0,0,,{\i1}Ama Wakabayashi-kun yumruklayarak savuşturuyor!{\i0}
Dialogue: 0,0:04:15.00,0:04:17.66,Default,,0,0,0,,{\i1}Hiçbir oyuncu vazgeçmiyor!{\i0}
Dialogue: 0,0:04:18.90,0:04:19.73,Default,,0,0,0,,{\i1}İşte bu!{\i0}
Dialogue: 0,0:04:23.94,0:04:25.41,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:04:25.41,0:04:29.24,Default,,0,0,0,,{\i1}Misaki-kun yaralı sağ bacağıyla\Ntopu uzaklaştırıyor!{\i0}
Dialogue: 0,0:04:31.56,0:04:34.54,Default,,0,0,0,,{\i1}Tsubasa-kun için harika bir pas.{\i0}
Dialogue: 0,0:04:34.54,0:04:35.70,Default,,0,0,0,,{\i1}Misaki-kun!{\i0}
Dialogue: 0,0:04:35.70,0:04:37.81,Default,,0,0,0,,{\i1}Onu tutan kimse yok.{\i0}
Dialogue: 0,0:04:37.81,0:04:40.54,Default,,0,0,0,,{\i1}Ve kendi sahalarında olduğu\Niçin ofsayt da yok.{\i0}
Dialogue: 0,0:04:40.54,0:04:44.05,Default,,0,0,0,,Demek öyle! Tsubasa-kun bunun mu peşindeymiş?!
Dialogue: 0,0:04:44.05,0:04:47.30,Default,,0,0,0,,{\i1}Nankatsu'nun karşı atak vakti!{\i0}
Dialogue: 0,0:04:47.30,0:04:48.64,Default,,0,0,0,,E-Eyvah!
Dialogue: 0,0:04:48.64,0:04:49.30,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:04:50.27,0:04:52.06,Default,,0,0,0,,Sana güveniyorum Tsubasa-kun.
Dialogue: 0,0:04:52.06,0:04:56.64,Default,,0,0,0,,{\i1}Sanki bu an için gücünü saklıyordu.{\i0}
Dialogue: 0,0:04:56.64,0:05:01.40,Default,,0,0,0,,{\i1}Tsubasa-kun Meiwa kalesine doğru\Nson sürat top sürüyor.{\i0}
Dialogue: 0,0:05:01.40,0:05:06.53,Default,,0,0,0,,{\i1}Atağa odaklanmış Meiwa'da\Ndefans tamamen boş durumdaydı!{\i0}
Dialogue: 0,0:05:06.53,0:05:07.39,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:05:07.39,0:05:10.53,Default,,0,0,0,,{\i1}Daha önce fark etmiş olsam\Nherkese talimat verebilirdim!{\i0}
Dialogue: 0,0:05:10.53,0:05:12.54,Default,,0,0,0,,{\i1}Birebir mücadele bile olsa...{\i0}
Dialogue: 0,0:05:12.54,0:05:14.91,Default,,0,0,0,,{\i1}...ne kadar yaklaşırsa yaklaşsın onu durduracağım!{\i0}
Dialogue: 0,0:05:14.91,0:05:16.92,Default,,0,0,0,,Tamamdır! Hadi yap şunu!
Dialogue: 0,0:05:16.92,0:05:18.79,Default,,0,0,0,,Tsubasa-kun, sana güveniyoruz!
Dialogue: 0,0:05:20.21,0:05:21.84,Default,,0,0,0,,{\i1}Bacağım...{\i0}
Dialogue: 0,0:05:21.84,0:05:26.84,Default,,0,0,0,,{\i1}Wakabayashi-kun ve Misaki-kun da\Nbu acıya dişlerini sıkarak oynadı.{\i0}
Dialogue: 0,0:05:26.84,0:05:28.22,Default,,0,0,0,,{\i1}Ben de yapabilirim!{\i0}
Dialogue: 0,0:05:28.22,0:05:29.13,Default,,0,0,0,,{\i1}Olamaz!{\i0}
Dialogue: 0,0:05:29.13,0:05:31.35,Default,,0,0,0,,{\i1}Gol atarsa çok kötü olur!{\i0}
Dialogue: 0,0:05:31.35,0:05:33.14,Default,,0,0,0,,Sana güveniyorum Takeshi!
Dialogue: 0,0:05:33.14,0:05:35.14,Default,,0,0,0,,Maçı belirleyecek nokta.
Dialogue: 0,0:05:35.14,0:05:37.64,Default,,0,0,0,,Bu karşılaşma maçı belirleyecek.
Dialogue: 0,0:05:38.24,0:05:40.23,Default,,0,0,0,,{\i1}Tsubasa-kun şut çekiyor.{\i0}
Dialogue: 0,0:05:40.23,0:05:41.73,Default,,0,0,0,,Kesinlikle durduracağım!
Dialogue: 0,0:05:43.80,0:05:45.91,Default,,0,0,0,,{\i1}Sawada-kun onu durduruyor.{\i0}
Dialogue: 0,0:05:45.91,0:05:48.40,Default,,0,0,0,,{\i1}Tsubasa-kun'un şutunu\Nkayarak engelliyor.{\i0}
Dialogue: 0,0:05:50.53,0:05:53.41,Default,,0,0,0,,{\i1}Tsubasa-kun orta mesafeden\Ngüçlü bir şut çekiyor!{\i0}
Dialogue: 0,0:05:54.80,0:05:57.08,Default,,0,0,0,,{\i1}Wakashimazu-kun koluyla savuşturuyor!{\i0}
Dialogue: 0,0:05:57.08,0:05:58.91,Default,,0,0,0,,{\i1}Harika refleksler!{\i0}
Dialogue: 0,0:06:00.29,0:06:03.96,Default,,0,0,0,,{\i1}Ama Tsubasa-kun'un şut çekme\Nkonusunda hala fırsatı var.{\i0}
Dialogue: 0,0:06:03.96,0:06:05.96,Default,,0,0,0,,{\i1}Beraberliği sağlayacak gol mü gelecek yoksa?{\i0}
Dialogue: 0,0:06:07.63,0:06:12.93,Default,,0,0,0,,{\i1}Wakashimazu-kun karatede kullanılan arka tekme ile\Nbedenini 180 derece döndürerek topu uzaklaştırıyor!{\i0}
Dialogue: 0,0:06:14.43,0:06:20.69,Default,,0,0,0,,{\i1}Nankatsu bu karşı atak planı sonucunda yıldız oyuncu\NTsubasa-kun'un çektiği şutla bile golü bulamıyor!{\i0}
Dialogue: 0,0:06:20.69,0:06:22.69,Default,,0,0,0,,Aferin Wakashimazu!
Dialogue: 0,0:06:22.69,0:06:24.19,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:06:24.19,0:06:26.56,Default,,0,0,0,,Çok yakındı...
Dialogue: 0,0:06:26.56,0:06:27.57,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:06:29.13,0:06:31.07,Default,,0,0,0,,Hayır, daha değil!
Dialogue: 0,0:06:31.07,0:06:33.43,Default,,0,0,0,,Tsubasa hala kalenin önünde!
Dialogue: 0,0:06:33.43,0:06:35.95,Default,,0,0,0,,Bir kez daha Tsubasa'ya\Npas atmalıyız!
Dialogue: 0,0:06:35.95,0:06:38.66,Default,,0,0,0,,Nankatsu'nun bu topu\Nalmasına izin vermeyin!
Dialogue: 0,0:06:38.66,0:06:41.42,Default,,0,0,0,,{\i1}Orta sahada tekrar bir mücadele olacak!{\i0}
Dialogue: 0,0:06:41.42,0:06:44.17,Default,,0,0,0,,Kafa topunu bana bırakın!
Dialogue: 0,0:06:45.39,0:06:48.17,Default,,0,0,0,,{\i1}Hava mücadelesini Izawa-kun kazanıyor!{\i0}
Dialogue: 0,0:06:49.26,0:06:50.05,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:06:50.05,0:06:51.44,Default,,0,0,0,,Geçmene izin vermeyiz.
Dialogue: 0,0:06:51.44,0:06:54.51,Default,,0,0,0,,Meiwa'nın kayma ekibi saldırın!
Dialogue: 0,0:06:54.51,0:06:57.26,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:06:59.81,0:07:00.89,Default,,0,0,0,,Alın!
Dialogue: 0,0:07:00.89,0:07:02.06,Default,,0,0,0,,İzin vermeyin!
Dialogue: 0,0:07:02.06,0:07:04.07,Default,,0,0,0,,{\i1}Büyük bir mücadele!{\i0}
Dialogue: 0,0:07:04.07,0:07:06.21,Default,,0,0,0,,{\i1}Top, Hyuga-kun'a mı gidecek?{\i0}
Dialogue: 0,0:07:06.21,0:07:08.07,Default,,0,0,0,,{\i1}Yoksa Tsubasa-kun'a mı gidecek?{\i0}
Dialogue: 0,0:07:08.07,0:07:09.85,Default,,0,0,0,,Elinizden geleni yapın Nankatsu!
Dialogue: 0,0:07:09.85,0:07:11.32,Default,,0,0,0,,Tsubasa'ya atın!
Dialogue: 0,0:07:11.32,0:07:12.83,Default,,0,0,0,,Dayanın Meiwa!
Dialogue: 0,0:07:12.83,0:07:13.95,Default,,0,0,0,,Size güveniyoruz!
Dialogue: 0,0:07:14.61,0:07:16.28,Default,,0,0,0,,{\i1}Maçın son anları!{\i0}
Dialogue: 0,0:07:16.28,0:07:18.95,Default,,0,0,0,,{\i1}Sadece 5 dakika kaldı.{\i0}
Dialogue: 0,0:07:19.58,0:07:21.35,Default,,0,0,0,,{\i1}Top yükseldi!{\i0}
Dialogue: 0,0:07:21.35,0:07:23.00,Default,,0,0,0,,{\i1}Hangi taraf alacak acaba?{\i0}
Dialogue: 0,0:07:24.65,0:07:25.50,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:07:25.50,0:07:27.21,Default,,0,0,0,,{\i1}Meiwa bir an daha hızlı!{\i0}
Dialogue: 0,0:07:27.21,0:07:28.13,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:07:28.13,0:07:30.51,Default,,0,0,0,,{\i1}Top, direkt ilerilere gidiyor.{\i0}
Dialogue: 0,0:07:30.51,0:07:31.17,Default,,0,0,0,,Millet!
Dialogue: 0,0:07:31.69,0:07:34.18,Default,,0,0,0,,{\i1}Hyuga-kun pası aldı!{\i0}
Dialogue: 0,0:07:34.18,0:07:37.18,Default,,0,0,0,,{\i1}Önünde sadece Misaki-kun ve\NWakabayashi-kun var.{\i0}
Dialogue: 0,0:07:37.18,0:07:38.72,Default,,0,0,0,,{\i1}Kojiro...{\i0}
Dialogue: 0,0:07:39.39,0:07:40.95,Default,,0,0,0,,{\t(1068,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Misaki!{\i0}
Dialogue: 0,0:07:40.95,0:07:43.27,Default,,0,0,0,,{\i1}Hey, şuna bakın!{\i0}
Dialogue: 0,0:07:40.95,0:07:43.27,Default,,0,0,0,,{\an8}# Meiwa İlkokulu #
Dialogue: 0,0:07:43.27,0:07:47.02,Default,,0,0,0,,{\i1}Dün transfer gelen Misaki'nin\Ntop sürüşüne bakın.{\i0}
Dialogue: 0,0:07:51.57,0:07:54.25,Default,,0,0,0,,{\i1}Vay, çok teknik oynuyorsun.{\i0}
Dialogue: 0,0:07:54.25,0:07:55.72,Default,,0,0,0,,{\i1}Pes, pes.{\i0}
Dialogue: 0,0:07:55.72,0:07:58.41,Default,,0,0,0,,{\i1}Bana da böyle harika\Nhareketler öğretsene.{\i0}
Dialogue: 0,0:07:58.41,0:07:59.56,Default,,0,0,0,,{\i1}Tamam.{\i0}
Dialogue: 0,0:08:00.87,0:08:04.23,Default,,0,0,0,,{\i1}Böyle aptal numaralar\Nöğrenmeye gerek yok!{\i0}
Dialogue: 0,0:08:04.23,0:08:05.37,Default,,0,0,0,,{\i1}Hyuga-san!{\i0}
Dialogue: 0,0:08:05.37,0:08:08.60,Default,,0,0,0,,{\i1}Etrafta böyle koşuşturmanın amacı ne?{\i0}
Dialogue: 0,0:08:08.60,0:08:09.17,Default,,0,0,0,,{\i1}Ne?{\i0}
Dialogue: 0,0:08:09.17,0:08:11.92,Default,,0,0,0,,{\i1}Topu alınca dümdüz koşarsınız!{\i0}
Dialogue: 0,0:08:11.92,0:08:14.09,Default,,0,0,0,,{\i1}Yolunuza çıkanları ezersiniz...{\i0}
Dialogue: 0,0:08:14.09,0:08:16.51,Default,,0,0,0,,{\i1}...ve direkt kaleye doğru ilerlersiniz!{\i0}
Dialogue: 0,0:08:16.51,0:08:18.97,Default,,0,0,0,,{\i1}Anladınız mı?!{\i0}
Dialogue: 0,0:08:27.40,0:08:29.52,Default,,0,0,0,,{\i1}Hyuga-kun kaba kuvvetiyle\Nonu geçebilecek mi?{\i0}
Dialogue: 0,0:08:29.52,0:08:32.00,Default,,0,0,0,,{\i1}Yoksa Misaki-kun tekniğiyle durduracak mı?{\i0}
Dialogue: 0,0:08:32.00,0:08:33.66,Default,,0,0,0,,{\i1}Geçmene izin veremem Kojiro!{\i0}
Dialogue: 0,0:08:33.66,0:08:36.07,Default,,0,0,0,,{\i1}Ezebiliyorsan ez bakalım beni!{\i0}
Dialogue: 0,0:08:36.07,0:08:37.66,Default,,0,0,0,,{\i1}Misaki!{\i0}
Dialogue: 0,0:08:37.66,0:08:38.95,Default,,0,0,0,,Abi!
Dialogue: 0,0:08:43.30,0:08:48.33,Default,,0,0,0,,{\i1}Hyuga-kun, kenara zıplayarak\NMisaki-kun'dan kurtuluyor.{\i0}
Dialogue: 0,0:08:48.33,0:08:48.83,Default,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:08:48.83,0:08:49.84,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:49.84,0:08:54.79,Default,,0,0,0,,{\i1}Her zaman rakibinin üstüne koşup\Nonu ezip geçen Hyuga-kun...{\i0}
Dialogue: 0,0:08:54.79,0:08:56.47,Default,,0,0,0,,{\i1}...ilk kez çalım atıyor!{\i0}
Dialogue: 0,0:08:57.51,0:09:00.10,Default,,0,0,0,,{\i1}Hyuga-kun dengesini kaybetti!{\i0}
Dialogue: 0,0:09:00.10,0:09:01.62,Default,,0,0,0,,Birebir mücadele!
Dialogue: 0,0:09:01.62,0:09:03.35,Default,,0,0,0,,Onu burada durdurmam gerek!
Dialogue: 0,0:09:03.35,0:09:06.89,Default,,0,0,0,,{\i1}Hyuga-kun dengesini tekrar\Nsağlayıp şut pozisyonu alıyor!{\i0}
Dialogue: 0,0:09:09.22,0:09:11.73,Default,,0,0,0,,{\i1}İki oyuncu da aynı anda\Nharekete geçti!{\i0}
Dialogue: 0,0:09:32.00,0:09:33.80,Default,,0,0,0,,Başardın abi!
Dialogue: 0,0:09:35.84,0:09:37.32,Default,,0,0,0,,Kojiro!
Dialogue: 0,0:09:38.34,0:09:40.85,Default,,0,0,0,,Başardın! Sonunda başardın!
Dialogue: 0,0:09:40.85,0:09:44.10,Default,,0,0,0,,{\i1}Meiwa sonunda durumu tersine çeviriyor.{\i0}
Dialogue: 0,0:09:44.10,0:09:46.24,Default,,0,0,0,,{\i1}İkinci yarıda 4 dakika kalmışken...{\i0}
Dialogue: 0,0:09:46.24,0:09:48.60,Default,,0,0,0,,{\i1}...bu gol çok şey ifade ediyor!{\i0}
Dialogue: 0,0:09:50.04,0:09:51.81,Default,,0,0,0,,Lanet olası Hyuga!
Dialogue: 0,0:09:51.81,0:09:53.32,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:09:55.68,0:10:02.99,Default,,0,0,0,,{\i1}Turnuva öncesinde yaptığı pozun\Naynısıyla Hyuga-kun'un zaferini duyuruyor!{\i0}
Dialogue: 0,0:10:02.99,0:10:05.87,Default,,0,0,0,,{\i1}Bu maçı kazandım!{\i0}
Dialogue: 0,0:10:15.32,0:10:17.26,Default,,0,0,0,,{\i1}Maçın bitişi yaklaşırken...{\i0}
Dialogue: 0,0:10:17.26,0:10:22.05,Default,,0,0,0,,{\i1}...Hyuga-kun'un golüyle Meiwa,\NNankatsu'nun önüne geçti sonunda.{\i0}
Dialogue: 0,0:10:22.05,0:10:24.05,Default,,0,0,0,,{\i1}Tamamdır, başarabiliriz.{\i0}
Dialogue: 0,0:10:24.05,0:10:26.56,Default,,0,0,0,,{\i1}Böylelikle zafer bayrağı bizim olacak.{\i0}
Dialogue: 0,0:10:26.56,0:10:29.36,Default,,0,0,0,,{\i1}Bu gol büyük fark açtı.{\i0}
Dialogue: 0,0:10:29.36,0:10:32.06,Default,,0,0,0,,{\i1}Sadece maç bitmeye yakın olduğu için değil.{\i0}
Dialogue: 0,0:10:32.52,0:10:37.86,Default,,0,0,0,,{\i1}Nankatsu; Tsubasa, Misaki,\NWakabayashi etrafında şekillenirken...{\i0}
Dialogue: 0,0:10:37.86,0:10:41.61,Default,,0,0,0,,{\i1}...kalan oyuncular takımın\Nboşluğunu dolduruyor.{\i0}
Dialogue: 0,0:10:41.78,0:10:46.32,Default,,0,0,0,,{\i1}Meiwa ise Hyuga, Sawada,\NWakashimazu etrafında...{\i0}
Dialogue: 0,0:10:46.32,0:10:49.04,Default,,0,0,0,,{\i1}...kalan oyuncuların desteğiyle şekilleniyor.{\i0}
Dialogue: 0,0:10:49.04,0:10:55.58,Default,,0,0,0,,{\i1}Son mücadelede yıldız oyuncu Tsubasa'yı\NMeiwa'dan Sawada ve Wakashimazu durdurdu.{\i0}
Dialogue: 0,0:10:55.58,0:11:00.08,Default,,0,0,0,,{\i1}Üstelik orta saha mücadelesinde\Nçok önemli işler koyan birisi yoktu...{\i0}
Dialogue: 0,0:11:00.08,0:11:01.47,Default,,0,0,0,,{\i1}...ve Meiwa kazandı.{\i0}
Dialogue: 0,0:11:01.55,0:11:04.14,Default,,0,0,0,,{\i1}Şimdi ise Nankatsu kalesinde...{\i0}
Dialogue: 0,0:11:04.14,0:11:07.89,Default,,0,0,0,,{\i1}...Misaki ve Wakabayashi'nin\Noluşturduğu duvarı Hyuga kırdı.{\i0}
Dialogue: 0,0:11:07.93,0:11:15.69,Default,,0,0,0,,{\i1}Başka bir deyişle bu gol, Meiwa'nın\NNankatsu'dan daha güçlü olduğunu gösteriyordu.{\i0}
Dialogue: 0,0:11:15.69,0:11:18.19,Default,,0,0,0,,{\i1}Ne yapacaksın Tsubasa?{\i0}
Dialogue: 0,0:11:19.03,0:11:20.40,Default,,0,0,0,,{\an8}Başardık, değil mi?
Dialogue: 0,0:11:19.34,0:11:21.13,Default,,0,0,0,,Güzel şuttu Hyuga-kun.
Dialogue: 0,0:11:21.13,0:11:21.90,Default,,0,0,0,,Ne?
Dialogue: 0,0:11:22.58,0:11:25.49,Default,,0,0,0,,Ama maç henüz bitmedi.
Dialogue: 0,0:11:27.62,0:11:28.91,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:11:29.35,0:11:32.21,Default,,0,0,0,,Aynen öyle. Hala mücadele edebiliriz.
Dialogue: 0,0:11:32.21,0:11:34.82,Default,,0,0,0,,Biz de henüz yenilgiyi kabullenmedik!
Dialogue: 0,0:11:34.82,0:11:35.46,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:35.46,0:11:40.34,Default,,0,0,0,,Şimdiye kadar çok zorluğu\Natlatarak kazandık.
Dialogue: 0,0:11:40.34,0:11:42.47,Default,,0,0,0,,Henüz kaybetmedik Meiwa!
Dialogue: 0,0:11:42.47,0:11:43.98,Default,,0,0,0,,Millet...
Dialogue: 0,0:11:43.98,0:11:47.30,Default,,0,0,0,,Wakabayashi-san, yedek eldiven.
Dialogue: 0,0:11:47.30,0:11:49.22,Default,,0,0,0,,Teşekkürler Morisaki.
Dialogue: 0,0:11:49.22,0:11:51.43,Default,,0,0,0,,Wakabayashi-san, bacağın nasıl?
Dialogue: 0,0:11:51.43,0:11:54.23,Default,,0,0,0,,Ayrıca az önceki çarpışmada...
Dialogue: 0,0:11:54.23,0:11:55.24,Default,,0,0,0,,Ne?
Dialogue: 0,0:11:55.24,0:11:56.98,Default,,0,0,0,,Lafını etmeye değmez.
Dialogue: 0,0:11:56.98,0:11:59.98,Default,,0,0,0,,Siz de buraya gelene\Nkadar elinizden geleni yaptınız.
Dialogue: 0,0:11:59.98,0:12:03.66,Default,,0,0,0,,Son 4 dakikada\Ntezahüratınızı bekliyorum.
Dialogue: 0,0:12:03.66,0:12:04.86,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:04.86,0:12:08.24,Default,,0,0,0,,Tsubasa'nın dediği gibi.\NŞimdi mücadele vakti.
Dialogue: 0,0:12:08.24,0:12:11.00,Default,,0,0,0,,Gerçek bir mücadele.
Dialogue: 0,0:12:11.00,0:12:14.14,Default,,0,0,0,,Çok iyi arkadaşların var Tsubasa.
Dialogue: 0,0:12:16.00,0:12:18.92,Default,,0,0,0,,Dinleyin millet. Rehavete kapılmayın.
Dialogue: 0,0:12:18.92,0:12:21.76,Default,,0,0,0,,Nankatsu köşeye sıkıştığında\Nçok güçlü bir rakip oluyor.
Dialogue: 0,0:12:21.76,0:12:22.72,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:22.72,0:12:24.72,Default,,0,0,0,,{\i1}Size maç vermem.{\i0}
Dialogue: 0,0:12:24.72,0:12:29.22,Default,,0,0,0,,{\i1}Amacıma ulaşmak için\Ngururumu bile bir kenara koydum!{\i0}
Dialogue: 0,0:12:29.22,0:12:34.60,Default,,0,0,0,,Az önce atılan gol, bu maçta\NHyuga-kun'un ne kadar geliştiğini gösteriyor.
Dialogue: 0,0:12:35.64,0:12:38.62,Default,,0,0,0,,Şu ana kadar sadece\Nkaba kuvvetle oynayan Hyuga-kun...
Dialogue: 0,0:12:38.62,0:12:41.16,Default,,0,0,0,,...ilk kez teknik kullandı.
Dialogue: 0,0:12:41.16,0:12:43.16,Default,,0,0,0,,O saf güçle oynayan oğlan...
Dialogue: 0,0:12:43.16,0:12:47.36,Default,,0,0,0,,...takımının zaferi uğruna\Ninatçılığı bir kenara bıraktı.
Dialogue: 0,0:12:47.36,0:12:51.37,Default,,0,0,0,,{\i1}Tsubasa-kun, bu gole cevap vermeyi dene.{\i0}
Dialogue: 0,0:12:51.37,0:12:54.40,Default,,0,0,0,,{\i1}Maçın 4 dakikadan az bir vakti kaldı.{\i0}
Dialogue: 0,0:12:54.40,0:12:57.63,Default,,0,0,0,,{\i1}Nankatsu oyunu beraberliğe getirebilecek mi?{\i0}
Dialogue: 0,0:13:00.12,0:13:01.56,Default,,0,0,0,,Gidelim Misaki-kun!
Dialogue: 0,0:13:01.56,0:13:02.21,Default,,0,0,0,,Evet!
Dialogue: 0,0:13:02.21,0:13:03.14,Default,,0,0,0,,Tutun!
Dialogue: 0,0:13:03.14,0:13:05.84,Default,,0,0,0,,Tsubasa ve Misaki'yi boş bırakmayın sakın!
Dialogue: 0,0:13:05.84,0:13:06.68,Default,,0,0,0,,Tamam!
Dialogue: 0,0:13:06.68,0:13:09.26,Default,,0,0,0,,{\i1}Meiwa beklenildiği gibi\Nikiliyi tutmaya gidiyor!{\i0}
Dialogue: 0,0:13:13.42,0:13:17.50,Default,,0,0,0,,Tsubasa ve Misaki şu an yaralıyken\Nelimizden geleni yapmaktan başka çaremiz yok!
Dialogue: 0,0:13:18.60,0:13:20.74,Default,,0,0,0,,{\i1}Nankatsu'nun son çabalamaları!{\i0}
Dialogue: 0,0:13:20.74,0:13:24.53,Default,,0,0,0,,{\i1}Azimli bir takım oyunuyla\Ntopu Meiwa kalesine taşıyorlar.{\i0}
Dialogue: 0,0:13:24.53,0:13:26.82,Default,,0,0,0,,Tamamdır, hadi Nankatsu!
Dialogue: 0,0:13:26.82,0:13:28.96,Default,,0,0,0,,Son gücünüzü koyun ortaya!
Dialogue: 0,0:13:28.96,0:13:31.33,Default,,0,0,0,,Kesinlikle gol atıp beraberliği sağlayın!
Dialogue: 0,0:13:31.33,0:13:36.91,Default,,0,0,0,,{\i1}Büyük tezahüratlar altında Nankatsu,\Nşut için bir fırsat yakalayabilecek mi?{\i0}
Dialogue: 0,0:13:41.09,0:13:44.64,Default,,0,0,0,,{\i1}Normalde rakibimi geçtiğim gibi\Nburadan şut çekerdim.{\i0}
Dialogue: 0,0:13:44.64,0:13:46.70,Default,,0,0,0,,{\i1}Ama kaleci Wakashimazu-kun.{\i0}
Dialogue: 0,0:13:46.70,0:13:48.18,Default,,0,0,0,,{\i1}Henüz şut çekemem.{\i0}
Dialogue: 0,0:13:49.32,0:13:51.26,Default,,0,0,0,,{\i1}Tsubasa-kun sağ tarafa gönderiyor.{\i0}
Dialogue: 0,0:13:51.26,0:13:53.11,Default,,0,0,0,,{\i1}O noktada Izawa-kun var.{\i0}
Dialogue: 0,0:13:53.11,0:13:55.22,Default,,0,0,0,,{\i1}Sürpriz bir uzun şut mu gelecek?{\i0}
Dialogue: 0,0:13:55.22,0:13:56.98,Default,,0,0,0,,{\i1}Geleceksen gel!{\i0}
Dialogue: 0,0:13:56.98,0:14:01.05,Default,,0,0,0,,{\i1}Olmaz. Bu noktadan şut çekersem etkili olmaz.{\i0}
Dialogue: 0,0:14:02.31,0:14:03.02,Default,,0,0,0,,Taki!
Dialogue: 0,0:14:05.03,0:14:06.39,Default,,0,0,0,,{\i1}Şut mu çekmeliyim?{\i0}
Dialogue: 0,0:14:06.39,0:14:07.95,Default,,0,0,0,,{\i1}Hayır, orta açmalıyım!{\i0}
Dialogue: 0,0:14:07.95,0:14:10.27,Default,,0,0,0,,{\i1}Ama kaleye doğru gönderirsem...{\i0}
Dialogue: 0,0:14:10.27,0:14:13.12,Default,,0,0,0,,{\i1}...Wakashimazu yükselerek kesebilir.{\i0}
Dialogue: 0,0:14:13.12,0:14:14.12,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:14:14.12,0:14:16.30,Default,,0,0,0,,{\i1}El mecbur geri pas atıyor.{\i0}
Dialogue: 0,0:14:17.00,0:14:18.06,Default,,0,0,0,,{\i1}Olamaz.{\i0}
Dialogue: 0,0:14:18.06,0:14:21.32,Default,,0,0,0,,{\i1}Böyle sadece kalan vakti bitiriyoruz.{\i0}
Dialogue: 0,0:14:21.32,0:14:24.59,Default,,0,0,0,,{\i1}Sadece 3 dakika kaldı!\NÇok bir vakit yok!{\i0}
Dialogue: 0,0:14:24.59,0:14:25.46,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:14:25.46,0:14:29.80,Default,,0,0,0,,Kalenin önündeyiz ama\Nşut çekemezsek nasıl başaracağız bunu?!
Dialogue: 0,0:14:29.80,0:14:30.51,Default,,0,0,0,,Alalım!
Dialogue: 0,0:14:30.51,0:14:32.67,Default,,0,0,0,,{\i1}Meiwa'nın inatçı defansı!{\i0}
Dialogue: 0,0:14:32.67,0:14:34.18,Default,,0,0,0,,{\i1}Misaki-kun ne yapacak?{\i0}
Dialogue: 0,0:14:34.18,0:14:36.51,Default,,0,0,0,,{\i1}Meiwa'nın defansının inatçı olduğu doğru.{\i0}
Dialogue: 0,0:14:36.51,0:14:39.71,Default,,0,0,0,,{\i1}Ama şut çekemiyorsak gol atamayız.{\i0}
Dialogue: 0,0:14:39.71,0:14:43.23,Default,,0,0,0,,{\i1}Ve şu an bu şutu çekebilecek\Ntek kişi Tsubasa-kun!{\i0}
Dialogue: 0,0:14:44.48,0:14:47.82,Default,,0,0,0,,Şut çek! Senden başkası çekemez!
Dialogue: 0,0:14:47.82,0:14:49.22,Default,,0,0,0,,Aynen öyle Tsubasa!
Dialogue: 0,0:14:49.22,0:14:53.57,Default,,0,0,0,,Şu an senden başkasına şut\Nkonusunda güvenemeyiz Tsubasa!
Dialogue: 0,0:14:53.57,0:14:55.95,Default,,0,0,0,,{\i1}Misaki-kun, millet...{\i0}
Dialogue: 0,0:14:57.08,0:14:59.04,Default,,0,0,0,,{\i1}Tamamdır, gidelim!{\i0}
Dialogue: 0,0:15:00.04,0:15:02.00,Default,,0,0,0,,{\i1}Tsubasa-kun zıplıyor!{\i0}
Dialogue: 0,0:15:02.00,0:15:03.08,Default,,0,0,0,,{\i1}Bu...{\i0}
Dialogue: 0,0:15:03.08,0:15:04.13,Default,,0,0,0,,Yakalayacağım!
Dialogue: 0,0:15:04.13,0:15:07.27,Default,,0,0,0,,{\i1}İşte! Tsubasa'nın favori hareketi!{\i0}
Dialogue: 0,0:15:07.27,0:15:10.88,Default,,0,0,0,,{\i1}Rövaşata vuruşu gol alacak mı?!{\i0}
Dialogue: 0,0:15:12.04,0:15:14.60,Default,,0,0,0,,Git!
Dialogue: 0,0:15:14.60,0:15:15.50,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:15.50,0:15:16.43,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:15:17.18,0:15:18.06,Default,,0,0,0,,Yakalayacağım!
Dialogue: 0,0:15:19.10,0:15:20.82,Default,,0,0,0,,{\i1}Y-Yakaladı!{\i0}
Dialogue: 0,0:15:20.82,0:15:23.31,Default,,0,0,0,,{\i1}Nankatsu beraberliği sağlayamıyor!{\i0}
Dialogue: 0,0:15:23.31,0:15:24.90,Default,,0,0,0,,Başardın Wakashimazu!
Dialogue: 0,0:15:26.82,0:15:27.57,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:15:27.57,0:15:28.65,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:15:29.88,0:15:32.32,Default,,0,0,0,,{\i1}Wakashimazu hızlıca topu uzaklaştırıyor!{\i0}
Dialogue: 0,0:15:32.32,0:15:35.28,Default,,0,0,0,,{\i1}Ve top...{\i0}
Dialogue: 0,0:15:35.28,0:15:37.28,Default,,0,0,0,,{\i1}Başardık! Şampiyonuz!{\i0}
Dialogue: 0,0:15:37.28,0:15:39.54,Default,,0,0,0,,{\i1}Maçta sadece 1 dakika kaldı.{\i0}
Dialogue: 0,0:15:39.54,0:15:41.79,Default,,0,0,0,,{\i1}Hyuga-kun bu topu tutarsa...{\i0}
Dialogue: 0,0:15:41.79,0:15:44.38,Default,,0,0,0,,{\i1}...maçın kazananı belli olacak!{\i0}
Dialogue: 0,0:15:44.38,0:15:45.79,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:15:47.17,0:15:48.00,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:48.00,0:15:49.90,Default,,0,0,0,,{\i1}W-Wakabayashi!{\i0}
Dialogue: 0,0:15:49.90,0:15:54.72,Default,,0,0,0,,{\i1}B-Bu... Nankatsu kalecisi Wakabayashi-kun\Nriskli bir çıkışla topu çalıyor!{\i0}
Dialogue: 0,0:15:54.72,0:15:56.14,Default,,0,0,0,,Wakabayashi-san!
Dialogue: 0,0:15:56.14,0:15:57.76,Default,,0,0,0,,İnatçı pislikler!
Dialogue: 0,0:15:57.76,0:16:02.35,Default,,0,0,0,,{\i1}Wakabayashi-kun, Meiwa\Nsahasında topu sürüyor.{\i0}
Dialogue: 0,0:16:02.35,0:16:04.56,Default,,0,0,0,,{\i1}Bir dakikadan az bir süre kaldı.{\i0}
Dialogue: 0,0:16:04.56,0:16:08.13,Default,,0,0,0,,{\i1}Nankatsu'nun hala bir şansı\Nvar gibi gözüküyor!{\i0}
Dialogue: 0,0:16:08.13,0:16:09.11,Default,,0,0,0,,{\i1}Genzo...{\i0}
Dialogue: 0,0:16:09.11,0:16:12.37,Default,,0,0,0,,{\i1}Kaleci Wakabayashi-kun bile\Natakta yer alıyor.{\i0}
Dialogue: 0,0:16:12.37,0:16:16.62,Default,,0,0,0,,{\i1}Son atakları tam anlamıyla\N11 kişiyle olacak.{\i0}
Dialogue: 0,0:16:16.62,0:16:19.37,Default,,0,0,0,,{\i1}Hyuga'nın 2 gol atmasına izin verdim.{\i0}
Dialogue: 0,0:16:19.37,0:16:24.62,Default,,0,0,0,,{\i1}En azından... En azından son anda\Nkendi pisliğimi temizleyeceğim!{\i0}
Dialogue: 0,0:16:24.62,0:16:29.21,Default,,0,0,0,,{\i1}Wakabayashi-kun top sürmeyi\Nbırakıp şut çekme pozisyonu alıyor!{\i0}
Dialogue: 0,0:16:29.21,0:16:30.46,Default,,0,0,0,,{\i1}Hadi!{\i0}
Dialogue: 0,0:16:31.63,0:16:33.53,Default,,0,0,0,,{\i1}Meiwa defansı tepki veremiyor!{\i0}
Dialogue: 0,0:16:33.53,0:16:37.85,Default,,0,0,0,,{\i1}Wakabayashi-kun tüm gücüyle\Nkaderi belirleyecek uzun bir şut çekiyor!{\i0}
Dialogue: 0,0:16:37.85,0:16:40.37,Default,,0,0,0,,Uzun şutlar bana işlemez!
Dialogue: 0,0:16:40.37,0:16:41.47,Default,,0,0,0,,Yakalayacağım!
Dialogue: 0,0:16:41.47,0:16:42.47,Default,,0,0,0,,Misaki!
Dialogue: 0,0:16:42.47,0:16:43.06,Default,,0,0,0,,Tamam!
Dialogue: 0,0:16:44.68,0:16:47.89,Default,,0,0,0,,{\i1}Misaki-kun yaralı bacağıyla zıplıyor!{\i0}
Dialogue: 0,0:16:47.89,0:16:49.69,Default,,0,0,0,,{\i1}Yönü değiştirdi!{\i0}
Dialogue: 0,0:16:49.69,0:16:50.57,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:16:50.57,0:16:51.26,Default,,0,0,0,,Başardı!
Dialogue: 0,0:16:51.26,0:16:52.19,Default,,0,0,0,,Misaki!
Dialogue: 0,0:16:53.40,0:16:55.65,Default,,0,0,0,,{\i1}Top dışarı gidiyor!{\i0}
Dialogue: 0,0:16:55.65,0:16:56.45,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:16:56.45,0:16:57.66,Default,,0,0,0,,Kaçırdı!
Dialogue: 0,0:16:57.66,0:16:59.12,Default,,0,0,0,,Olmayacak mı?!
Dialogue: 0,0:16:59.58,0:17:02.45,Default,,0,0,0,,{\i1}Tsubasa-kun hızla sıçrıyor!{\i0}
Dialogue: 0,0:17:02.45,0:17:04.08,Default,,0,0,0,,{\i1}Ama yetişemeyecek gibi!{\i0}
Dialogue: 0,0:17:04.08,0:17:06.12,Default,,0,0,0,,{\i1}Top çok uzakta!{\i0}
Dialogue: 0,0:17:06.12,0:17:10.63,Default,,0,0,0,,{\i1}Herkesin güvendiği rövaşata\Nvuruşum boşa çıktı.{\i0}
Dialogue: 0,0:17:10.63,0:17:16.97,Default,,0,0,0,,{\i1}Ama bu kez bu şansı Wakabayashi-kun\Nve Misaki-kun için...{\i0}
Dialogue: 0,0:17:17.70,0:17:22.06,Default,,0,0,0,,{\i1}...ne olursa olsun şut çekerek\Ngole çevireceğim!{\i0}
Dialogue: 0,0:17:22.06,0:17:25.35,Default,,0,0,0,,{\i1}Tsubasa-kun sol elini\Nkullanarak yerde takla atıyor!{\i0}
Dialogue: 0,0:17:26.34,0:17:29.23,Default,,0,0,0,,{\i1}Ve bu sayede öne atılarak topa ulaşıyor!{\i0}
Dialogue: 0,0:17:30.23,0:17:31.73,Default,,0,0,0,,Hadi!
Dialogue: 0,0:17:31.73,0:17:34.40,Default,,0,0,0,,{\i1}Vurdu!{\i0}
Dialogue: 0,0:17:34.40,0:17:36.40,Default,,0,0,0,,{\i1}G-Gol!{\i0}
Dialogue: 0,0:17:36.40,0:17:38.41,Default,,0,0,0,,{\i1}B-Beraberlik!{\i0}
Dialogue: 0,0:17:38.41,0:17:42.28,Default,,0,0,0,,{\i1}Maç bitmeden önce Tsubasa-kun'un\Ntaklası gol oluyor...{\i0}
Dialogue: 0,0:17:42.28,0:17:47.08,Default,,0,0,0,,{\i1}...ve Nankatsu, 2-2 beraberliği yakalıyor!{\i0}
Dialogue: 0,0:17:47.08,0:17:48.96,Default,,0,0,0,,B-Başardı!
Dialogue: 0,0:17:48.96,0:17:50.38,Default,,0,0,0,,Başardın Tsubasa!
Dialogue: 0,0:17:50.38,0:17:51.59,Default,,0,0,0,,Onlara yetiştik!
Dialogue: 0,0:17:51.59,0:17:52.98,Default,,0,0,0,,Beraberlik...
Dialogue: 0,0:17:52.98,0:17:56.97,Default,,0,0,0,,Sadece bir adım...\NSadece bir adım uzağındaydık zaferin.
Dialogue: 0,0:17:58.54,0:18:02.22,Default,,0,0,0,,{\i1}Misaki'nin atlayışını daha önce\Nfark edebilmiş olsam...{\i0}
Dialogue: 0,0:18:02.22,0:18:03.96,Default,,0,0,0,,Başardılar Anego!
Dialogue: 0,0:18:03.96,0:18:04.49,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:04.49,0:18:06.85,Default,,0,0,0,,Başardık, başardık! Beraberlik!
Dialogue: 0,0:18:06.85,0:18:09.73,Default,,0,0,0,,{\i1}Mucizevi bir goldü bu!{\i0}
Dialogue: 0,0:18:09.73,0:18:13.40,Default,,0,0,0,,{\i1}3 yıldız oyuncu bir arada attı!{\i0}
Dialogue: 0,0:18:13.40,0:18:17.90,Default,,0,0,0,,{\i1}Üçünün de bacağı yaralı\Nolmasına rağmen ellerinden geleni yaptılar.{\i0}
Dialogue: 0,0:18:21.40,0:18:26.66,Default,,0,0,0,,{\i1}Lanet olsun! Wakabayashi'nin çıktığını\Nfark edip topu çalmasını engelleyebilsem...{\i0}
Dialogue: 0,0:18:26.66,0:18:29.86,Default,,0,0,0,,{\i1}...o şutu çekemezlerdi!{\i0}
Dialogue: 0,0:18:31.14,0:18:34.80,Default,,0,0,0,,{\i1}Ve maçın 2. yarısını bitiren düdük!{\i0}
Dialogue: 0,0:18:35.46,0:18:40.29,Default,,0,0,0,,{\i1}İlk yarı ve ikinci yarı toplam\N40 mücadele sonrasında bir sonuca varılamadı.{\i0}
Dialogue: 0,0:18:40.29,0:18:44.35,Default,,0,0,0,,{\i1}Ama finallerde penaltı vuruşları olmayacak...{\i0}
Dialogue: 0,0:18:44.35,0:18:50.31,Default,,0,0,0,,{\i1}...ve 10 dakikalık ara sonrasında\Nbeşer dakikalık uzatma oynanacak.{\i0}
Dialogue: 0,0:18:50.31,0:18:53.54,Default,,0,0,0,,{\i1}Eğer yine bir sonuca ulaşılmazsa...{\i0}
Dialogue: 0,0:18:53.54,0:18:56.03,Default,,0,0,0,,{\i1}...5 dakikalık 2 uzatma daha oynanacak.{\i0}
Dialogue: 0,0:18:56.03,0:19:01.78,Default,,0,0,0,,{\i1}Uzatmalar sonucunda iki takım da\Nberabere devam ederse ikisi de şampiyon olacak.{\i0}
Dialogue: 0,0:19:01.78,0:19:03.75,Default,,0,0,0,,Son anda gardınızı indirdiniz.
Dialogue: 0,0:19:03.75,0:19:05.03,Default,,0,0,0,,E-Evet.
Dialogue: 0,0:19:05.03,0:19:08.06,Default,,0,0,0,,Ama olan oldu.
Dialogue: 0,0:19:08.06,0:19:09.21,Default,,0,0,0,,Kafanıza takmayın.
Dialogue: 0,0:19:09.21,0:19:11.18,Default,,0,0,0,,Şimdi uzatmalara odaklanmalıyız!
Dialogue: 0,0:19:12.08,0:19:14.89,Default,,0,0,0,,Rakibimizin 3 yıldız oyuncusu yaralı.
Dialogue: 0,0:19:14.89,0:19:17.46,Default,,0,0,0,,Avantajlı taraf biziz.
Dialogue: 0,0:19:17.46,0:19:18.74,Default,,0,0,0,,Dinleyin!
Dialogue: 0,0:19:18.74,0:19:20.02,Default,,0,0,0,,Şimdi azim konuşacak!
Dialogue: 0,0:19:20.02,0:19:23.00,Default,,0,0,0,,Azim olarak çökmezseniz\Nzafer sizindir!
Dialogue: 0,0:19:23.00,0:19:23.97,Default,,0,0,0,,Evet!
Dialogue: 0,0:19:24.55,0:19:26.97,Default,,0,0,0,,Misaki, yaranı gösterir misin?
Dialogue: 0,0:19:28.22,0:19:32.27,Default,,0,0,0,,Sen olmadan çok zor\Nolur ama uzatmalarda oynamamalısın.
Dialogue: 0,0:19:32.27,0:19:34.73,Default,,0,0,0,,Taro, nasılsın?
Dialogue: 0,0:19:34.73,0:19:36.70,Default,,0,0,0,,Baba...
Dialogue: 0,0:19:36.70,0:19:38.46,Default,,0,0,0,,Devam edebilecek misin, edemeyecek misin?
Dialogue: 0,0:19:38.46,0:19:41.36,Default,,0,0,0,,En iyisini sen bilirsin.
Dialogue: 0,0:19:41.36,0:19:43.74,Default,,0,0,0,,İyiyim. Devam edebilirim.
Dialogue: 0,0:19:43.74,0:19:49.03,Default,,0,0,0,,Sen bile başladığın tüm\Nresimleri bitirmedin mi baba?
Dialogue: 0,0:19:49.03,0:19:53.75,Default,,0,0,0,,Ben de sahaya çıkacağım ve\Nbaşladığım maçta sonuna dek oynayacağım.
Dialogue: 0,0:19:53.75,0:19:55.75,Default,,0,0,0,,Taro...
Dialogue: 0,0:19:56.92,0:19:58.75,Default,,0,0,0,,Ben halledeyim.
Dialogue: 0,0:19:59.38,0:20:00.98,Default,,0,0,0,,Mikami-san!
Dialogue: 0,0:20:02.60,0:20:05.51,Default,,0,0,0,,Bandaj ile sarmalıyız.
Dialogue: 0,0:20:05.51,0:20:08.70,Default,,0,0,0,,Genzo, nasıl hissettiğini biliyorum.
Dialogue: 0,0:20:08.70,0:20:10.47,Default,,0,0,0,,Uzatmalarda elinden geleni yap.
Dialogue: 0,0:20:10.47,0:20:12.23,Default,,0,0,0,,Tamam.
Dialogue: 0,0:20:13.05,0:20:18.07,Default,,0,0,0,,Ben oynarken antrenörüm\Nbana böyle masaj yapardı.
Dialogue: 0,0:20:18.07,0:20:21.29,Default,,0,0,0,,Tsubasa, son şutun çok iyiydi.
Dialogue: 0,0:20:21.29,0:20:24.48,Default,,0,0,0,,Beni oyununla her zaman hayran bırakıyorsun.
Dialogue: 0,0:20:24.48,0:20:25.49,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:25.49,0:20:29.32,Default,,0,0,0,,Üçünüz arasında yaralanması\Nen hafif olan sensin.
Dialogue: 0,0:20:29.32,0:20:32.16,Default,,0,0,0,,Uzatmalarda elimizden geleni\Nyapmaktan başka çaremiz yok.
Dialogue: 0,0:20:32.16,0:20:34.16,Default,,0,0,0,,Biliyorum Roberto.
Dialogue: 0,0:20:34.16,0:20:36.31,Default,,0,0,0,,Nankatsu kesinlikle kazanacak.
Dialogue: 0,0:20:36.31,0:20:37.71,Default,,0,0,0,,Sonra da Brezilya'ya gideceğiz!
Dialogue: 0,0:20:39.21,0:20:41.38,Default,,0,0,0,,Evet, biliyorum.
Dialogue: 0,0:20:41.38,0:20:43.87,Default,,0,0,0,,Ama şimdilik bu maça odaklanmalısın.
Dialogue: 0,0:20:43.87,0:20:46.05,Default,,0,0,0,,Maçı kazanmayı düşün sadece.
Dialogue: 0,0:20:46.05,0:20:47.80,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:47.80,0:20:51.06,Default,,0,0,0,,{\i1}Şu an sıcaklık 35 derece.{\i0}
Dialogue: 0,0:20:51.06,0:20:55.27,Default,,0,0,0,,{\i1}Oyuncular bu terletici\Nsıcaklıkta büyük bir mücadele veriyor.{\i0}
Dialogue: 0,0:20:55.27,0:20:59.77,Default,,0,0,0,,{\i1}Nankatsu-Meiwa maçının\Nuzatmaları başlamak üzere.{\i0}
Dialogue: 0,0:21:00.47,0:21:01.94,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:21:01.94,0:21:03.35,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:21:03.35,0:21:05.07,Default,,0,0,0,,Elinden geleni yap abi!
Dialogue: 0,0:21:05.62,0:21:08.87,Default,,0,0,0,,{\i1}Bu kez gol atıp işi bitireceğim!{\i0}
Dialogue: 0,0:21:09.66,0:21:11.37,Default,,0,0,0,,{\i1}Kaybetmeyeceğiz Meiwa.{\i0}
Dialogue: 0,0:21:11.37,0:21:13.62,Default,,0,0,0,,{\i1}Biz kazanacağız!{\i0}
Dialogue: 0,0:21:13.62,0:21:19.00,Default,,0,0,0,,{\i1}Meiwa'nın top vuruşuyla\Nuzatmaların ilk yarışı başlıyor.{\i0}
Dialogue: 0,0:21:20.79,0:21:24.84,Default,,0,0,0,,{\i1}Her zamanki gibi Meiwa'nın yıldız\Noyuncusu Hyuga-kun topu ileri sürüyor.{\i0}
Dialogue: 0,0:21:24.84,0:21:27.18,Default,,0,0,0,,Tamamdır, gidelim! Topu alalım!
Dialogue: 0,0:21:27.18,0:21:30.81,Default,,0,0,0,,{\i1}Nankatsu da her zamanki gibi\Ntopu almak üzere davranıyor!{\i0}
Dialogue: 0,0:21:31.46,0:21:33.39,Default,,0,0,0,,{\i1}Sawada-kun'a bir pas.{\i0}
Dialogue: 0,0:21:34.06,0:21:35.77,Default,,0,0,0,,{\i1}Meiwa'dan duvar pası!{\i0}
Dialogue: 0,0:21:36.28,0:21:39.71,Default,,0,0,0,,{\i1}Final maçı başladıktan sonra Hyuga-kun...{\i0}
Dialogue: 0,0:21:39.71,0:21:42.40,Default,,0,0,0,,{\i1}...bencilliğini bırakarak takım\Narkadaşlarına güvenmeye başladı.{\i0}
Dialogue: 0,0:21:42.40,0:21:44.03,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:21:45.53,0:21:49.78,Default,,0,0,0,,{\i1}Yaralı olduğun için buradan\Nbir şut bile yeter sana!{\i0}
Dialogue: 0,0:21:49.78,0:21:50.62,Default,,0,0,0,,Ne?!
Dialogue: 0,0:21:50.62,0:21:54.12,Default,,0,0,0,,{\i1}Hyuga-kun hemen şut mu çekecek?!{\i0}
Dialogue: 0,0:21:54.12,0:21:55.00,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:21:55.00,0:21:58.16,Default,,0,0,0,,{\i1}Çok uzaktan hızlı bir şut!{\i0}
Dialogue: 0,0:21:58.16,0:21:59.25,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:21:59.25,0:22:03.13,Default,,0,0,0,,{\i1}Wakabayashi-kun yaralı bacağıyla\Nbu topu durdurabilecek mi?{\i0}
Dialogue: 0,0:22:05.27,0:22:08.92,Default,,0,0,0,,{\i1}D-Durdurdu! Wakabayashi-kun\Nsıkıca yakalıyor!{\i0}
Dialogue: 0,0:22:08.92,0:22:09.80,Default,,0,0,0,,Ne?!
Dialogue: 0,0:22:11.05,0:22:12.85,Default,,0,0,0,,Başardın Wakabayashi-kun!
Dialogue: 0,0:22:12.85,0:22:20.02,Default,,0,0,0,,{\i1}Hyuga, bacağım kırılsa bile\Nsenden bir gol daha yemeyeceğim!{\i0}
Dialogue: 0,0:22:20.40,0:22:23.22,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:23:50.03,0:24:00.64,Default,,0,0,0,,Gelecek 26. Bölümde:\NHayalet Gol
Dialogue: 0,0:01:46.01,0:01:51.60,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:01:51.60,0:01:56.27,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:01:57.52,0:02:02.19,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:02:03.07,0:02:10.78,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:02:10.78,0:02:16.54,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:02:16.54,0:02:25.30,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:02:25.30,0:02:30.85,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:02:30.85,0:02:36.77,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:02:36.77,0:02:38.44,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:02:38.44,0:02:45.65,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:02:45.65,0:02:48.66,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:02:48.66,0:02:53.08,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:01:46.01,0:01:51.60,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:01:51.60,0:01:56.27,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:01:57.52,0:02:02.19,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:02:03.07,0:02:10.78,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:02:10.78,0:02:16.54,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:02:16.54,0:02:25.30,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:02:25.30,0:02:30.85,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:02:30.85,0:02:36.77,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:02:36.77,0:02:38.44,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:02:38.44,0:02:45.65,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo
Dialogue: 0,0:02:45.65,0:02:48.66,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:02:48.66,0:02:53.08,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Romaji,,0,0,0,,chotto aremi na eesu ga tooru
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Romaji,,0,0,0,,suguremono da to machijuu sawagu
