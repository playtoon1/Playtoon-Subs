Dialogue: 0,0:16:00.43,0:16:02.60,Default,,0,0,0,,{\i1}Otomo'nun dörtlüsünden son çırpınışlar!{\i0}
Dialogue: 0,0:16:02.60,0:16:05.08,Default,,0,0,0,,{\i1}Ancak, Tsubasa'nın şut çekmesi onlardan daha hızlıydı!{\i0}
Dialogue: 0,0:16:05.08,0:16:08.23,Default,,0,0,0,,{\i1}Sadece 1 saniyeyle başardı!{\i0}
Dialogue: 0,0:16:08.23,0:16:09.11,Default,,0,0,0,,Ichijo!
Dialogue: 0,0:16:09.11,0:16:10.24,Default,,0,0,0,,Her şey sana bağlı!
Dialogue: 0,0:16:12.76,0:16:13.77,Default,,0,0,0,,{\i1}Kurtardı!{\i0}
Dialogue: 0,0:16:13.77,0:16:15.95,Default,,0,0,0,,{\i1}Ichijo'dan mükemmel bir atlayış!{\i0}
Dialogue: 0,0:16:16.83,0:16:17.84,Default,,0,0,0,,Başardı!
Dialogue: 0,0:16:17.84,0:16:18.95,Default,,0,0,0,,Süpersin, Ichijo!
Dialogue: 0,0:16:19.58,0:16:21.29,Default,,0,0,0,,{\i1}Zar zor kurtardılar değil mi?{\i0}
Dialogue: 0,0:16:21.54,0:16:24.70,Default,,0,0,0,,{\i1}Otomo dörlüsü Tsubasa'yı durdurmaya gittiğinde,{\i0}
Dialogue: 0,0:16:24.70,0:16:28.05,Default,,0,0,0,,{\i1}Tsubasa'nın sadece 1 saniyelik bir avantajı vardı.{\i0}
Dialogue: 0,0:16:28.30,0:16:31.84,Default,,0,0,0,,{\i1}Bu şekilde Tsubasa'nın şutunu zayıflatabildiler.{\i0} {its passive voice in original, thats why his shot become less powerful, gibing contextes <3}
Dialogue: 0,0:16:31.84,0:16:34.59,Default,,0,0,0,,Otomo Orta Okulu'nun vahşeti dediğin şey buydu, bilirsin.
Dialogue: 0,0:16:34.59,0:16:39.60,Default,,0,0,0,,{\i1}Otomo Orta Okulu, Tsubasa saldırısını engellemek için savunma güçlerinin tamamını kullandı!{\i0}
Dialogue: 0,0:16:39.60,0:16:41.30,Default,,0,0,0,,Ah, hadi ama...
Dialogue: 0,0:16:41.30,0:16:43.32,Default,,0,0,0,,Talihsizlikti, değil mi, Sanae?
Dialogue: 0,0:16:43.32,0:16:45.32,Default,,0,0,0,,Hala çok zamanımız var.
Dialogue: 0,0:16:45.32,0:16:48.27,Default,,0,0,0,,Biliyorum, doğru ve öndeyiz de.
Dialogue: 0,0:16:48.27,0:16:50.28,Default,,0,0,0,,Ama gardımızı düşürmemeliyiz!
Dialogue: 0,0:16:50.28,0:16:52.90,Default,,0,0,0,,Nasıl biteceğini bilemezsin.
Dialogue: 0,0:16:52.90,0:16:54.41,Default,,0,0,0,,Hadi, Ichijo!
Dialogue: 0,0:16:54.41,0:16:55.70,Default,,0,0,0,,Bu bizim şansımız!
Dialogue: 0,0:16:55.70,0:16:56.49,Default,,0,0,0,,Tamam!
Dialogue: 0,0:16:57.91,0:16:58.95,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:16:58.95,0:17:01.52,Default,,0,0,0,,{\i1}Ichijo topu Urabe'ye atıyor.{\i0}
Dialogue: 0,0:17:04.70,0:17:05.46,Default,,0,0,0,,Nitta!
Dialogue: 0,0:17:06.71,0:17:08.69,Default,,0,0,0,,{\i1}O da topu boşta olan Nitta'ya atıyor!{\i0}
Dialogue: 0,0:17:08.69,0:17:10.90,Default,,0,0,0,,{\i1}Gerçirdikleri tehlike büyük bir şansa dönüştü!{\i0}
Dialogue: 0,0:17:10.90,0:17:13.01,Default,,0,0,0,,{\i1}Nitta'nın bu gol atacağından eminler.{\i0} {morisaki the zero effect}
Dialogue: 0,0:17:13.01,0:17:15.59,Default,,0,0,0,,{\i1}Tsubasa bu sefer onu markajlayamayacak!{\i0}
Dialogue: 0,0:17:15.59,0:17:16.35,Default,,0,0,0,,Başardık!
Dialogue: 0,0:17:16.35,0:17:17.66,Default,,0,0,0,,Sonunda golü atacağız!
Dialogue: 0,0:17:17.66,0:17:18.72,Default,,0,0,0,,Her şey sana bağlı Nitta!
Dialogue: 0,0:17:18.72,0:17:20.60,Default,,0,0,0,,Topu kontrol etmek için zamanın var.
Dialogue: 0,0:17:22.22,0:17:23.64,Default,,0,0,0,,{\i1}Ichijo...{\i0}
Dialogue: 0,0:17:23.64,0:17:25.53,Default,,0,0,0,,{\i1}ve herkes..{\i0}
Dialogue: 0,0:17:25.53,0:17:28.53,Default,,0,0,0,,{\i1}Son atağı durdurduğunuz için size minnettarım...{\i0}
Dialogue: 0,0:17:28.53,0:17:32.47,Default,,0,0,0,,{\i1}Ancak, markajlanmamış olsam bile top yere değmeden şut vuracağım.{\i0}
Dialogue: 0,0:17:32.47,0:17:34.49,Default,,0,0,0,,{\i1}Doğrudan gol atacağım!{\i0}
Dialogue: 0,0:17:38.13,0:17:39.24,Default,,0,0,0,,Nitta!
Dialogue: 0,0:17:39.24,0:17:40.27,Default,,0,0,0,,Nitta!
Dialogue: 0,0:17:40.99,0:17:41.74,Default,,0,0,0,,Hadi!
Dialogue: 0,0:17:41.74,0:17:45.58,Default,,0,0,0,,Senin için Kontrolsüz Koşu Volesi Şahin Vuruşu! {https://tsubasa.im/global/en/skill/?id=100273}
Dialogue: 0,0:17:48.78,0:17:51.03,Default,,0,0,0,,{\i1}Top ağlarda! Gol!{\i0}
Dialogue: 0,0:17:51.03,0:17:52.30,Default,,0,0,0,,{\i1}Maç berabere!{\i0}
Dialogue: 0,0:17:52.96,0:17:57.24,Default,,0,0,0,,{\i1}Kaleci Morisaki ve Nankatsu'nun defansı dona kaldı!{\i0}
Dialogue: 0,0:17:57.24,0:17:58.97,Default,,0,0,0,,İ-İnanılmaz...
Dialogue: 0,0:17:59.90,0:18:01.37,Default,,0,0,0,,Bu sefer başardı...
Dialogue: 0,0:18:01.37,0:18:03.79,Default,,0,0,0,,Ne yapacağız? Berabere oldu.
Dialogue: 0,0:18:09.58,0:18:11.96,Default,,0,0,0,,Başardım... {even nitta is surprised}
Dialogue: 0,0:18:11.96,0:18:13.13,Default,,0,0,0,,Başardım!
Dialogue: 0,0:18:13.13,0:18:14.94,Default,,0,0,0,,Sonunda hareketi yaptım!
Dialogue: 0,0:18:14.94,0:18:18.07,Default,,0,0,0,,Benim Kontrolsüz Koşu Şahin Vurşu'm! {If the says this one more time I'm going to scream}
Dialogue: 0,0:18:18.07,0:18:19.82,Default,,0,0,0,,Vay piç...
Dialogue: 0,0:18:19.82,0:18:21.58,Default,,0,0,0,,Sonunda başardı!
Dialogue: 0,0:18:21.58,0:18:26.83,Default,,0,0,0,,{\i1}İkinci yarının ilk 10 dakikasında Otomo Ortaokulu sonunda skoru 1-1 yaptı.{\i0}
Dialogue: 0,0:18:26.83,0:18:28.92,Default,,0,0,0,,Hadi Otomo Hadi!
Dialogue: 0,0:18:28.92,0:18:30.72,Default,,0,0,0,,Harikaydın Nitta!
Dialogue: 0,0:18:30.72,0:18:32.14,Default,,0,0,0,,Bu şekilde öne geçeceğiz!
Dialogue: 0,0:18:32.14,0:18:36.76,Default,,0,0,0,,Şimdi Tsubasa'nın markajı bile seni durduramaz.
Dialogue: 0,0:18:36.76,0:18:38.40,Default,,0,0,0,,Gollere devam et, Nitta!
Dialogue: 0,0:18:38.40,0:18:41.54,Default,,0,0,0,,{\i1}Otomo Ortaokulu Nankatsu'yu yenme hırsı iyice arttı.{\i0}
Dialogue: 0,0:18:41.54,0:18:44.39,Default,,0,0,0,,{\i1}Maç gittikçe ilgi çekici bir hal almaya başladı!{\i0}
Dialogue: 0,0:18:44.39,0:18:47.50,Default,,0,0,0,,{\i1}Nitta... Nasıl bir çocuksun sen..!{\i0}
Dialogue: 0,0:18:47.50,0:18:48.94,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:18:48.94,0:18:51.31,Default,,0,0,0,,Daha kaybetmedim.
Dialogue: 0,0:18:51.31,0:18:53.60,Default,,0,0,0,,Haklı! Maç asıl şimdi başlıyor!
Dialogue: 0,0:18:53.60,0:18:56.32,Default,,0,0,0,,Kazanmışsınız gibi davranma Otomo!
Dialogue: 0,0:18:56.32,0:18:59.30,Default,,0,0,0,,Evet! Biz üçüncü kez şampiyon olmayı hedefliyoruz!
Dialogue: 0,0:18:59.30,0:19:01.49,Default,,0,0,0,,Sanki kaybedeceğiz!
Dialogue: 0,0:19:01.49,0:19:03.62,Default,,0,0,0,,Tsubasa, hadi yenelim!
Dialogue: 0,0:19:04.64,0:19:05.83,Default,,0,0,0,,Beyler...
Dialogue: 0,0:19:05.83,0:19:09.54,Default,,0,0,0,,Tamam! Eğer gol yersen sen de gol atarsın! Futbolun temel prensibi bu!  {it's like a mom saying "if they hit you, you hit them back!" to her child}
Dialogue: 0,0:19:09.54,0:19:10.66,Default,,0,0,0,,Hadi gidelim, beyler!
Dialogue: 0,0:19:10.66,0:19:11.96,Default,,0,0,0,,Evet!
Dialogue: 0,0:19:11.96,0:19:14.18,Default,,0,0,0,,Nankatsu yenilgiyi kabul etmiyor değil mi?
Dialogue: 0,0:19:14.18,0:19:18.26,Default,,0,0,0,,Tabiki de etmiyorlar. Daha yeni başlıyorlar değil mi Sanae?
Dialogue: 0,0:19:18.26,0:19:19.47,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:19.47,0:19:22.32,Default,,0,0,0,,{\i1}Maç berabere. Ne yapıcaksın Tsubasa?{\i0}
Dialogue: 0,0:19:22.32,0:19:24.72,Default,,0,0,0,,{\i1}Nitta'ya markaj yapmaya devam mı edeceksin?{\i0}
Dialogue: 0,0:19:24.72,0:19:25.97,Default,,0,0,0,,{\i1}Yoksa...{\i0}
Dialogue: 0,0:19:25.97,0:19:27.68,Default,,0,0,0,,{\i1}Eğer gol yersen sen de gol atarsın!{\i0}
Dialogue: 0,0:19:27.68,0:19:30.98,Default,,0,0,0,,{\i1}Nitta, bu sefer golü ben size atacağım!{\i0}
Dialogue: 0,0:19:30.98,0:19:34.23,Default,,0,0,0,,Çocuklar hevesiniz kırılmasın.
Dialogue: 0,0:19:34.23,0:19:38.24,Default,,0,0,0,,{\i1}Nankatsu karşı saldırıya hazılanıyor!{\i0} {ehh, this sounds awkward, i don't like it}
Dialogue: 0,0:19:38.24,0:19:39.52,Default,,0,0,0,,Hadi gidelim Kisugi!
Dialogue: 0,0:19:39.52,0:19:40.49,Default,,0,0,0,,Evet!
Dialogue: 0,0:19:44.99,0:19:46.50,Default,,0,0,0,,Saldırıyoruz beyler!
Dialogue: 0,0:19:46.50,0:19:48.33,Default,,0,0,0,,Tekrar öne geçeceğiz. {or shake them off}
Dialogue: 0,0:19:48.33,0:19:49.12,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:50.16,0:19:53.71,Default,,0,0,0,,Hadi gidelim! En iyi savunma saldırıdır!
Dialogue: 0,0:19:53.71,0:19:56.32,Default,,0,0,0,,Eğer Tsubasa saldırıya gelirse top bize geçer geçmez
Dialogue: 0,0:19:56.32,0:19:58.74,Default,,0,0,0,,topu hızlıca Nitta'ya atın.
Dialogue: 0,0:19:58.74,0:19:59.71,Default,,0,0,0,,Evet!
Dialogue: 0,0:19:59.71,0:20:00.80,Default,,0,0,0,,Hadi gidelim, Izawa!
Dialogue: 0,0:20:00.80,0:20:01.80,Default,,0,0,0,,Kisugi!
Dialogue: 0,0:20:01.80,0:20:02.80,Default,,0,0,0,,Taki!
Dialogue: 0,0:20:02.80,0:20:06.01,Default,,0,0,0,,İkinci yarıda iyi bir forvet oluşturuyoruz.
Dialogue: 0,0:20:06.01,0:20:10.06,Default,,0,0,0,,Bu sefer Otomo dörtlüsünü yıkıp geçeceğiz.
Dialogue: 0,0:20:10.06,0:20:12.68,Default,,0,0,0,,{\i1}Beklendiği gibi, Tsubasa atağa katıldığı için{\i0}
Dialogue: 0,0:20:12.68,0:20:18.15,Default,,0,0,0,,{\i1}Izawa, Kisugi ve Taki rahat hareket etmeye başladı.{\i0}
Dialogue: 0,0:20:18.15,0:20:21.40,Default,,0,0,0,,Lanet olsun! Şu ana kadar topu hep kolaylık alıyorduk.
Dialogue: 0,0:20:21.40,0:20:24.03,Default,,0,0,0,,Harika! Otomo'nun savunması çöküyor!
Dialogue: 0,0:20:24.03,0:20:26.22,Default,,0,0,0,,Doğrudan golü hedefleyeceğiz!
Dialogue: 0,0:20:27.16,0:20:29.84,Default,,0,0,0,,Evet, öyle yapacağız ... \NTopu sal!
Dialogue: 0,0:20:30.54,0:20:31.25,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:31.25,0:20:34.20,Default,,0,0,0,,{\i1}Rakip savunma hattını geçtikten sonra,{\i0}
Dialogue: 0,0:20:34.20,0:20:37.25,Default,,0,0,0,,{\i1}Nankatsu topu tekrardan Tsubasa'ya atıyor!{\i0}
Dialogue: 0,0:20:39.88,0:20:42.67,Default,,0,0,0,,{\i1}Tsubasa kaleye doğru bir pas atıyor.{\i0}
Dialogue: 0,0:20:42.67,0:20:45.43,Default,,0,0,0,,{\i1}Pası attıktan sonra koşmaya da devam ediyor!{\i0}
Dialogue: 0,0:20:45.43,0:20:47.18,Default,,0,0,0,,{\i1}Pası attı ve koşuyor!{\i0} {"pass and go"? how do i make it make sense? or "give and go"}
Dialogue: 0,0:20:48.10,0:20:52.02,Default,,0,0,0,,{\i1}Kisugi kafasıyla topu Tsubasa'nın önüne indiriyor.{\i0}
Dialogue: 0,0:20:52.54,0:20:53.52,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:20:53.92,0:20:55.23,Default,,0,0,0,,{\i1}Gol atacağım!.{\i0}
Dialogue: 0,0:20:55.23,0:21:00.03,Default,,0,0,0,,{\i1}Ortasaha oyuncusu olsam bile ben Nankatsu'nun oyun kurucusuyum.{\i0}
