Dialogue: 0,0:01:30.11,0:01:35.24,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}46. BÖLÜM: \NYÜZYILIN BAŞLANGICI
Dialogue: 0,0:01:30.40,0:01:32.69,Default-TOP,,0,0,0,,İşte, formalarınızı getirdim!
Dialogue: 0,0:01:32.69,0:01:33.94,Default-TOP,,0,0,0,,Vayyy!
Dialogue: 0,0:01:33.94,0:01:35.74,Default-TOP,,0,0,0,,Beyaz mavi çizgiler...
Dialogue: 0,0:01:35.74,0:01:39.20,Default,,0,0,0,,Sonuçta iç saha formalarımız final maçımız için en iyisi.
Dialogue: 0,0:01:39.20,0:01:39.87,Default,,0,0,0,,Evet!
Dialogue: 0,0:01:39.87,0:01:43.70,Default,,0,0,0,,Hepsini düzgün bir şekilde yıkadık, \Nyarın elinizden gelenin en iyisini yapın!
Dialogue: 0,0:01:43.70,0:01:45.75,Default,,0,0,0,,Tabii ki! Bize güvenebilirsiniz!
Dialogue: 0,0:01:45.75,0:01:48.38,Default,,0,0,0,,Hayal ettiğimiz 3. şampiyonluk \Nyolunda sadece bir maç kaldı...
Dialogue: 0,0:01:48.38,0:01:49.13,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:01:49.13,0:01:54.67,Default,,0,0,0,,En azından final maçı için gerçekten de\N Tsubasa'nın en iyi formda olmasını dilerdim.
Dialogue: 0,0:01:54.67,0:01:56.09,Default,,0,0,0,,Doğru.
Dialogue: 0,0:01:56.09,0:01:58.93,Default,,0,0,0,,Bu yüzden Tsubasa bu gece hastanede kalıyor.
Dialogue: 0,0:01:58.93,0:02:02.64,Default,,0,0,0,,Nakazawa, yarın erken kalk ve formasını götür!
Dialogue: 0,0:02:02.64,0:02:04.43,Default,,0,0,0,,T-Tamam.
Dialogue: 0,0:02:06.77,0:02:07.69,Default - i,,0,0,0,,"Kısa tutacağım.
Dialogue: 0,0:02:07.69,0:02:11.44,Default - i,,0,0,0,,Toho Akademisi'nin koçu Bay Makoto Kitazume,
Dialogue: 0,0:02:11.44,0:02:15.36,Default - i,,0,0,0,,Sizden bir iyilik istemek için bu mektubu yazıyorum.
Dialogue: 0,0:02:15.36,0:02:21.07,Default - i,,0,0,0,,Koç Kitazume, lütfen Kojiro Hyuga'nın final maçında oynamasına izin verin.
Dialogue: 0,0:02:21.07,0:02:24.08,Default - i,,0,0,0,,Takımını bir kenara bırakıp beni Okinawa'da görmeye
Dialogue: 0,0:02:24.08,0:02:29.87,Default - i,,0,0,0,,geldiği için oynamasına izin vermediğini varsayıyorum.
Dialogue: 0,0:02:29.87,0:02:33.55,Default - i,,0,0,0,,Ama onu affedemez misin? Sadece bu seferlik?
Dialogue: 0,0:02:33.55,0:02:36.34,Default - i,,0,0,0,,Onu çağıran bendim."
Dialogue: 0,0:02:42.43,0:02:43.30,Default,,0,0,0,,Girin.
Dialogue: 0,0:02:45.56,0:02:46.81,Default,,0,0,0,,Hmm...?
Dialogue: 0,0:02:47.73,0:02:48.94,Default,,0,0,0,,Koç.
Dialogue: 0,0:02:48.94,0:02:52.27,Default,,0,0,0,,Hepimiz münakaşa ettik ve buna birlikte karar verdik.
Dialogue: 0,0:02:52.27,0:02:54.44,Default,,0,0,0,,Bunu göz önünde bulundurarak, lütfen bizi dinleyin.
Dialogue: 0,0:02:54.44,0:02:59.03,Default,,0,0,0,,Lütfen, Kaptan Hyuga'nın yarın finalde oynamasına izin verin.
Dialogue: 0,0:03:00.24,0:03:04.37,Default,,0,0,0,,İsteğimize uymayı reddederseniz,
Dialogue: 0,0:03:04.37,0:03:05.62,Default,,0,0,0,,biz...
Dialogue: 0,0:03:05.62,0:03:07.66,Default,,0,0,0,,Kaptan...?
Dialogue: 0,0:03:09.04,0:03:09.87,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:03:09.87,0:03:11.04,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:03:19.42,0:03:20.84,Default,,0,0,0,,Koç.
Dialogue: 0,0:03:20.84,0:03:22.93,Default,,0,0,0,,Lütfen bunu kabul edin.
Dialogue: 0,0:03:22.93,0:03:26.68,Default-TOP,,0,0,0,,MEYDAN OKUMA MEKTUBU
Dialogue: 0,0:03:24.55,0:03:25.72,Default,,0,0,0,,B-Bu...
Dialogue: 0,0:03:25.72,0:03:26.68,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:03:28.48,0:03:30.98,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:03:30.98,0:03:33.02,Default,,0,0,0,,MEYDAN OKUMA MEKTUBU
Dialogue: 0,0:03:35.82,0:03:41.65,Default,,0,0,0,,Bu akşam saat 8'de, Toho Futbol\N Kulübü'nün sahasında sizi bekliyor olacağım.
Dialogue: 0,0:04:07.10,0:04:10.43,Default,,0,0,0,,Hyuga-san gerçekten onunla düello yapmak niyetinde mi?
Dialogue: 0,0:04:24.74,0:04:26.28,Default,,0,0,0,,Kaptan...!
Dialogue: 0,0:04:26.28,0:04:29.87,Default,,0,0,0,,Gerçekten bunu yapacağıma ölmeyi tercih ederim...
Dialogue: 0,0:04:29.87,0:04:30.75,Default,,0,0,0,,Ama,
Dialogue: 0,0:04:31.50,0:04:33.04,Default,,0,0,0,,Şimdi söylemeliyim ki,
Dialogue: 0,0:04:33.04,0:04:36.58,Default,,0,0,0,,bu oldukça küçük düşürücü.
Dialogue: 0,0:04:36.58,0:04:37.84,Default,,0,0,0,,Yalvarıyorum!
Dialogue: 0,0:04:37.84,0:04:40.09,Default,,0,0,0,,Lütfen maçta oynamama izin verin!
Dialogue: 0,0:04:46.05,0:04:47.97,Default,,0,0,0,,Kafanı kaldır, Hyuga.
Dialogue: 0,0:04:49.64,0:04:54.73,Default,,0,0,0,,İnançlarıma dayanarak her zaman futbol takımlarına koçluk yaptım.
Dialogue: 0,0:04:54.73,0:04:59.02,Default,,0,0,0,,Bu inançlara asla ihanet etmedim.
Dialogue: 0,0:04:59.02,0:05:03.03,Default,,0,0,0,,Koçluğumun inşa edildiği temeller benim gururum.
Dialogue: 0,0:05:03.03,0:05:07.32,Default,,0,0,0,,Ve bu inançlara sadık kalarak,\N bu maçta oynamana izin veremem!
Dialogue: 0,0:05:08.74,0:05:09.95,Default,,0,0,0,,Anladın mı?!
Dialogue: 0,0:05:12.54,0:05:14.16,Default,,0,0,0,,Hyuga-san...
Dialogue: 0,0:05:16.12,0:05:17.67,Default,,0,0,0,,Anlıyorum...
Dialogue: 0,0:05:21.88,0:05:24.55,Default,,0,0,0,,Gerçekten inançlarınızı bilmiyorum veya umurumda değil;
Dialogue: 0,0:05:24.55,0:05:26.68,Default,,0,0,0,,öyleyse, yapacak başka bir şey kalmadı!
Dialogue: 0,0:05:27.97,0:05:29.89,Default,,0,0,0,,Kesinlikle oynayacağım!
Dialogue: 0,0:05:29.89,0:05:33.47,Default,,0,0,0,,Seni dövmek zorunda kalsam bile, o maça gireceğim!
Dialogue: 0,0:05:33.47,0:05:35.94,Default,,0,0,0,,Toho sana ait değil!
Dialogue: 0,0:05:35.94,0:05:37.94,Default,,0,0,0,,İstediğin gibi yapmana izin vermeyeceğim!
Dialogue: 0,0:05:37.94,0:05:41.02,Default,,0,0,0,,Burada istediği şeyleri yapan tek kişi sensin!
Dialogue: 0,0:05:42.03,0:05:42.69,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:05:44.78,0:05:46.32,Default,,0,0,0,,Bekle biraz, Kaptan!
Dialogue: 0,0:05:47.32,0:05:48.82,Default,,0,0,0,,Koç sizde bekleyin!
Dialogue: 0,0:05:48.82,0:05:50.41,Default,,0,0,0,,Sizler...
Dialogue: 0,0:05:53.33,0:05:55.21,Default,,0,0,0,,Gördüğün gibi koç!
Dialogue: 0,0:05:55.21,0:05:57.29,Default,,0,0,0,,Lütfen Hyuga-san'nın bu maçta oynamasına izin verin!
Dialogue: 0,0:05:58.08,0:06:01.04,Default,,0,0,0,,Bu doğru; Kaptanımız izniniz olmadan ekibi terk etti.
Dialogue: 0,0:06:01.04,0:06:05.13,Default,,0,0,0,,Ama Okinawa'da, Nankatsu ile olan maçımıza hazırlık olarak,
Dialogue: 0,0:06:05.13,0:06:06.80,Default,,0,0,0,,Nankatsu'yu yenmek için,
Dialogue: 0,0:06:06.80,0:06:09.39,Default,,0,0,0,,hepimizden daha yoğun bir şekilde çalıştı!
Dialogue: 0,0:06:09.39,0:06:10.89,Default,,0,0,0,,Size yalvarıyoruz Koç!
Dialogue: 0,0:06:10.89,0:06:13.06,Default,,0,0,0,,Lütfen, Kaptanımızın oynamasına izin vermelisin!
Dialogue: 0,0:06:13.06,0:06:14.10,Default,,0,0,0,,Koç lütfen!
Dialogue: 0,0:06:14.10,0:06:15.93,Default,,0,0,0,,Sizler...
Dialogue: 0,0:06:15.93,0:06:19.31,Default - i,,0,0,0,,Hepiniz Hyuga için bu kadar ileri mi gidiyorsunuz...?
Dialogue: 0,0:06:26.07,0:06:28.24,Default,,0,0,0,,Biri buraya bir top getirsin.
Dialogue: 0,0:06:30.57,0:06:35.58,Default,,0,0,0,,Hyuga, az önce Toho'nun sahibi\N olmadığımı söylemiştin, değil mi?
Dialogue: 0,0:06:35.58,0:06:39.37,Default,,0,0,0,,Ancak, ben koçum ve burada kararları veriyorum.
Dialogue: 0,0:06:39.37,0:06:45.13,Default,,0,0,0,,Ve bu durumda, sensiz bile, Toho finallere doğru ilerledi.
Dialogue: 0,0:06:45.13,0:06:48.97,Default,,0,0,0,,Bu başarının arkasındaki güç, forvetimiz, Sorimachi,
Dialogue: 0,0:06:48.97,0:06:51.18,Default,,0,0,0,,orta saha oyuncumuz, Sawada,
Dialogue: 0,0:06:51.18,0:06:53.39,Default,,0,0,0,,ve kalecimiz, Wakashimazu.
Dialogue: 0,0:06:53.85,0:06:56.98,Default,,0,0,0,,Eğer bu üçünden bir gol çalabilirsen,
Dialogue: 0,0:06:56.98,0:06:58.43,Default,,0,0,0,,Hyuga,
Dialogue: 0,0:06:58.43,0:07:00.06,Default,,0,0,0,,o zaman maçta oynamana izin vereceğim.
Dialogue: 0,0:07:02.40,0:07:04.86,Default,,0,0,0,,Sözünden geri dönmeyeceksin değil mi?
Dialogue: 0,0:07:04.86,0:07:08.90,Default,,0,0,0,,Ancak! Arkadaşları olduğun için kolay oynarlarsa,
Dialogue: 0,0:07:08.90,0:07:10.45,Default,,0,0,0,,oynamana izin vermeyeceğim!
Dialogue: 0,0:07:10.45,0:07:12.32,Default,,0,0,0,,Gözlerimi kandıramazsınız.
Dialogue: 0,0:07:12.32,0:07:14.20,Default,,0,0,0,,Sizler anladınız mı?
Dialogue: 0,0:07:14.20,0:07:15.83,Default,,0,0,0,,E-Evet!
Dialogue: 0,0:07:21.92,0:07:24.92,Default - i,,0,0,0,,Koçumuzu gerçekten kandıramayız.
Dialogue: 0,0:07:24.92,0:07:26.09,Default,,0,0,0,,Düdüğü çalın!
Dialogue: 0,0:07:26.09,0:07:27.01,Default,,0,0,0,,Evet!
Dialogue: 0,0:07:27.67,0:07:28.59,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:07:28.59,0:07:29.17,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:30.43,0:07:31.93,Default,,0,0,0,,İşte geliyoruz Hyuga-san!
Dialogue: 0,0:07:33.47,0:07:35.89,Default - i,,0,0,0,,Koç Kira gözlerimi açtı,
Dialogue: 0,0:07:35.89,0:07:38.27,Default - i,,0,0,0,,ve ne kadar zayıf olduğumu anlamama yardımcı oldu.
Dialogue: 0,0:07:39.02,0:07:41.73,Default - i,,0,0,0,,Kojiro! Futbolda vücudunla savaşmalısın!
Dialogue: 0,0:07:41.73,0:07:44.90,Default - i,,0,0,0,,Ne olursa olsun, mücadele ruhunu bırakma!
Dialogue: 0,0:07:44.90,0:07:46.69,Default - i,,0,0,0,,Tamam!
Dialogue: 0,0:07:47.36,0:07:48.86,Default - i,,0,0,0,,Mücadele ruhu!
Dialogue: 0,0:07:48.86,0:07:52.70,Default - i,,0,0,0,,{\t(2840,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Bunu kafama soktu! Kemiklerime kazındı!{\i0}
Dialogue: 0,0:07:53.20,0:07:55.70,Default - i,,0,0,0,,Koç Kira'nın beklentilerine cevap vermek için,
Dialogue: 0,0:07:55.70,0:07:58.45,Default - i,,0,0,0,,beni tekrar düzeltti,
Dialogue: 0,0:07:59.08,0:08:01.46,Default - i,,0,0,0,,o maçta oynayacağım!
Dialogue: 0,0:08:05.21,0:08:11.01,Default - i,,0,0,0,,Geçen yaz, tayfun ortasında, Okinawa'nın kuzeyindeki kumlu plajlarda buldum!
Dialogue: 0,0:08:12.01,0:08:13.68,Default,,0,0,0,,{\bord0\blur0.6\c&H00F7FF&}Tiger...
Dialogue: 0,0:08:12.01,0:08:19.72,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:08:17.43,0:08:19.72,Default,,0,0,0,,{\bord0\blur0.6\c&H00F7FF&}Shot!
Dialogue: 0,0:08:21.64,0:08:22.77,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:22.77,0:08:24.85,Default,,0,0,0,,Göremedim! Gerçekten!
Dialogue: 0,0:08:32.99,0:08:34.32,Default,,0,0,0,,Düşündüğün gibi değil!
Dialogue: 0,0:08:34.32,0:08:35.99,Default,,0,0,0,,Kolay oynamadım!
Dialogue: 0,0:08:35.99,0:08:37.58,Default,,0,0,0,,Bu atış çok hızlıydı, ben...
Dialogue: 0,0:08:37.58,0:08:39.33,Default,,0,0,0,,Tepki bile veremedim!
Dialogue: 0,0:08:40.37,0:08:42.29,Default,,0,0,0,,Nankatsu ile yarınki maçın
Dialogue: 0,0:08:42.29,0:08:44.08,Default,,0,0,0,,başlangıç üyelerini açıklayacağım!
Dialogue: 0,0:08:44.79,0:08:46.96,Default,,0,0,0,,Kaleci: Wakashimazu.
Dialogue: 0,0:08:47.71,0:08:48.50,Default,,0,0,0,,Cevabın?
Dialogue: 0,0:08:48.50,0:08:49.96,Default,,0,0,0,,T-Tamam!
Dialogue: 0,0:08:49.96,0:08:51.21,Default,,0,0,0,,Savunma oyuncuları: Imai.
Dialogue: 0,0:08:51.21,0:08:51.67,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:51.67,0:08:52.09,Default,,0,0,0,,Kawabe.
Dialogue: 0,0:08:52.09,0:08:52.51,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:52.51,0:08:53.01,Default,,0,0,0,,Takashima.
Dialogue: 0,0:08:53.01,0:08:53.42,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:53.42,0:08:53.88,Default,,0,0,0,,Furuta.
Dialogue: 0,0:08:53.88,0:08:54.26,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:54.26,0:08:55.64,Default,,0,0,0,,Orta saha oyuncuları: Shimano.
Dialogue: 0,0:08:55.64,0:08:56.09,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:56.09,0:08:56.55,Default,,0,0,0,,Koike.
Dialogue: 0,0:08:56.55,0:08:56.84,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:56.84,0:08:57.35,Default,,0,0,0,,Matsuki.
Dialogue: 0,0:08:57.35,0:08:57.89,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:57.89,0:08:58.47,Default,,0,0,0,,Sawada.
Dialogue: 0,0:08:58.47,0:08:59.43,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:59.43,0:09:01.68,Default,,0,0,0,,Ve forvetler: sağ kanatta, Sorimachi.
Dialogue: 0,0:09:01.68,0:09:02.39,Default,,0,0,0,,Tamam!
Dialogue: 0,0:09:02.39,0:09:04.60,Default,,0,0,0,,Ve sol kanatta...
Dialogue: 0,0:09:06.15,0:09:07.15,Default,,0,0,0,,Kojiro Hyuga!
Dialogue: 0,0:09:07.15,0:09:08.40,Default,,0,0,0,,Tamam!
Dialogue: 0,0:09:15.82,0:09:20.03,Default - i,,0,0,0,,Ve nihayet büyük finalin yapıldığı günün şafağı.
Dialogue: 0,0:09:21.95,0:09:24.71,Default,,0,0,0,,{\pos(960,872.667)}TOHO AKADEMİ BAŞKANI
Dialogue: 0,0:09:21.95,0:09:24.71,Default,,0,0,0,,{\pos(960,802.667)}NAOKI MIZAWA
Dialogue: 0,0:09:22.25,0:09:24.71,Default-TOP,,0,0,0,,Bana nedenini söyler misin?
Dialogue: 0,0:09:24.71,0:09:26.79,Default-TOP,,0,0,0,,Nedenini mi?
Dialogue: 0,0:09:24.71,0:09:26.79,Default,,0,0,0,,İSTİFA DİLEKÇESİ
Dialogue: 0,0:09:26.79,0:09:30.71,Default,,0,0,0,,Bırakma sebebim, Kojiro Hyuga'nın bugünkü maçta oynaması.
Dialogue: 0,0:09:30.71,0:09:31.92,Default,,0,0,0,,Ne—
Dialogue: 0,0:09:31.92,0:09:36.51,Default,,0,0,0,,Şimdiye kadar kendi inançlarıma göre koçluk yaptım.
Dialogue: 0,0:09:36.51,0:09:38.20,Default,,0,0,0,,Ama bu inançları kırdım
Dialogue: 0,0:09:38.20,0:09:41.47,Default,,0,0,0,,ve Hyuga'nın bu maçta oynamasına izin vereceğime söz verdim.
Dialogue: 0,0:09:41.47,0:09:46.02,Default,,0,0,0,,Başka bir deyişle, koç olarak başarısız oldum.
Dialogue: 0,0:09:46.02,0:09:48.02,Default,,0,0,0,,Bunun sorumluluğunu alacağım,
Dialogue: 0,0:09:48.02,0:09:51.02,Default,,0,0,0,,ve Toho Akademisin de koçluk yapmayı bırakacağım.
Dialogue: 0,0:09:52.90,0:09:54.49,Default,,0,0,0,,Koç Kitazume...
Dialogue: 0,0:09:54.49,0:09:57.20,Default,,0,0,0,,Ama içiniz rahat olsun.
Dialogue: 0,0:09:57.20,0:10:00.75,Default,,0,0,0,,Kojiro Hyuga'nın oynamasına izin veriyorsam,
Dialogue: 0,0:10:00.75,0:10:04.29,Default,,0,0,0,,bu Toho Akademi'nin zaferi içindir.
Dialogue: 0,0:10:05.50,0:10:06.79,Default,,0,0,0,,Beni dinleyin millet!
Dialogue: 0,0:10:06.79,0:10:11.54,Default,,0,0,0,,Sahip olduğunuz her şeyi vermenizi ve bugünkü maçta daha fazla gürültü yapmanızı istiyorum.
Dialogue: 0,0:10:11.54,0:10:15.55,Default,,0,0,0,,Tezahüratlarımız kesinlikle oyunculara ulaşmalı.
Dialogue: 0,0:10:15.55,0:10:18.51,Default,,0,0,0,,Nankatsu bugün kesinlikle galip çıkacak!
Dialogue: 0,0:10:18.51,0:10:19.55,Default,,0,0,0,,Evet!
Dialogue: 0,0:10:19.55,0:10:22.68,Default,,0,0,0,,NAKATA HASTANESİ
Dialogue: 0,0:10:26.85,0:10:29.77,Default,,0,0,0,,Doktor, Tsubasa nasıl?
Dialogue: 0,0:10:30.19,0:10:34.15,Default,,0,0,0,,Eğer kendini çok fazla zorlar ve tekrar kendini incitirse,
Dialogue: 0,0:10:34.15,0:10:39.28,Default,,0,0,0,,hayatının geri kalanında \NTsubasa-kun'nun futbol kariyerine gölge düşebilir.
Dialogue: 0,0:10:39.28,0:10:44.41,Default,,0,0,0,,Geleceğini önemsiyorsak, doktoru olarak durdurmalıyım.
Dialogue: 0,0:10:44.41,0:10:46.91,Default,,0,0,0,,Ne dediğinizi anlıyorum.
Dialogue: 0,0:10:46.91,0:10:48.92,Default,,0,0,0,,Tsubasa'nın bu konudaki görüşü nedir?
Dialogue: 0,0:10:48.92,0:10:50.42,Default,,0,0,0,,Eh...
Dialogue: 0,0:10:51.08,0:10:54.88,Default - i,,0,0,0,,Doktor, bana imkansız olduğunu \Nsöyleseniz bile, hala yarınki maçta oynayacağım.
Dialogue: 0,0:10:54.88,0:10:58.42,Default - i,,0,0,0,,Ama bir futbolcu olarak kariyerini tehlikeye atıyor olacaksın...
Dialogue: 0,0:10:58.42,0:11:00.38,Default - i,,0,0,0,,Hyuga-kun'nun oynayacağından eminim.
Dialogue: 0,0:11:00.38,0:11:02.64,Default - i,,0,0,0,,Ben sadece nazikçe karşılık verebilirim.
Dialogue: 0,0:11:04.51,0:11:06.10,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:11:06.10,0:11:07.81,Default,,0,0,0,,O zaman lütfen, bırakın oynasın.
Dialogue: 0,0:11:10.02,0:11:13.31,Default,,0,0,0,,Tsubasa oynayacağını söylüyorsa, bırakın oynasın.
Dialogue: 0,0:11:13.31,0:11:16.07,Default,,0,0,0,,Oynadığı zaman kaybetseler bile,
Dialogue: 0,0:11:16.07,0:11:20.40,Default,,0,0,0,,bu maçta yaralandığı için dünyanın \N1 numaralı futbolcusu olamasa bile,
Dialogue: 0,0:11:20.40,0:11:25.91,Default,,0,0,0,,Tsubasa, bu maçta oynamayı seçtiği \Niçin pişmanlık duyacak bir çocuk değil.
Dialogue: 0,0:11:26.41,0:11:28.20,Default,,0,0,0,,Ozora-san...
Dialogue: 0,0:11:28.20,0:11:29.83,Default,,0,0,0,,Günaydın!
Dialogue: 0,0:11:29.83,0:11:31.37,Default,,0,0,0,,Ah, Sanae-chan...
Dialogue: 0,0:11:31.37,0:11:33.58,Default,,0,0,0,,Tsubasa-kun'nun formasını getirdim.
Dialogue: 0,0:11:33.58,0:11:35.38,Default,,0,0,0,,Öyle mi? Teşekkür ederim!
Dialogue: 0,0:11:35.38,0:11:38.13,Default,,0,0,0,,Çok güçlüsünüz Bayan Ozora.
Dialogue: 0,0:11:38.13,0:11:43.47,Default,,0,0,0,,Yaraları o kadar kötüyken, ben\N olsaydım oynamasına izin vermezdim.
Dialogue: 0,0:11:44.60,0:11:46.14,Default - i,,0,0,0,,Sanae-chan...
Dialogue: 0,0:11:48.31,0:11:50.06,Default,,0,0,0,,Millet günaydın!
Dialogue: 0,0:11:50.06,0:11:51.14,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:11:51.14,0:11:52.10,Default,,0,0,0,,Hey!
Dialogue: 0,0:11:52.10,0:11:55.73,Default,,0,0,0,,Doktor, maç için bantlamanın vakti geldi. Lütfen!
Dialogue: 0,0:11:55.73,0:11:57.32,Default,,0,0,0,,T-Tamam...
Dialogue: 0,0:11:57.32,0:11:58.86,Default,,0,0,0,,Hey, Tsubasa!
Dialogue: 0,0:11:58.86,0:12:00.36,Default,,0,0,0,,Hazır mısın?
Dialogue: 0,0:12:03.82,0:12:06.20,Default,,0,0,0,,Ah millet!
Dialogue: 0,0:12:06.20,0:12:11.25,Default,,0,0,0,,Tsubasa! Bugün ortaokul \Nöğrencileri olarak son resmi maçımız!
Dialogue: 0,0:12:11.25,0:12:15.13,Default,,0,0,0,,Final maçı için toplanıp birlikte oraya gidelim!
Dialogue: 0,0:12:16.00,0:12:17.50,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:12:18.05,0:12:19.96,Default,,0,0,0,,Millet...
Dialogue: 0,0:12:19.96,0:12:21.01,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:12:21.84,0:12:23.05,Default,,0,0,0,,İşte, al bunu.
Dialogue: 0,0:12:26.05,0:12:26.97,Default,,0,0,0,,Tamam.
Dialogue: 0,0:12:26.97,0:12:28.26,Default,,0,0,0,,Teşekkürler!
Dialogue: 0,0:12:28.97,0:12:30.22,Default - i,,0,0,0,,Çok şanslı...
Dialogue: 0,0:12:30.77,0:12:32.60,Default - i,,0,0,0,,Keşke bende bir kere bile olsa,
Dialogue: 0,0:12:32.60,0:12:33.52,Default - i,,0,0,0,,aynı böyle,
Dialogue: 0,0:12:34.35,0:12:38.52,Default - i,,0,0,0,,Tsubasa senpai'nin yanında olabilseydim, bu yaz...
Dialogue: 0,0:12:39.44,0:12:41.24,Default,,0,0,0,,Hayır olamaz! Ne düşünüyorum?!
Dialogue: 0,0:12:41.24,0:12:44.07,Default,,0,0,0,,Yukari-san! Lütfen vur bana!
Dialogue: 0,0:12:44.07,0:12:44.91,Default,,0,0,0,,Ne...?
Dialogue: 0,0:12:44.91,0:12:47.24,Default,,0,0,0,,N-Ne diyorsun sen?
Dialogue: 0,0:12:56.83,0:12:57.63,Default,,0,0,0,,Buradalar!
Dialogue: 0,0:12:58.25,0:12:59.63,Default,,0,0,0,,Toho burada!
Dialogue: 0,0:13:05.68,0:13:09.01,Default,,0,0,0,,{\pos(960,980)}TOHO AKADEMİ
Dialogue: 0,0:13:05.68,0:13:09.01,Default,,0,0,0,,10.15: STADYUMA GELİŞ
Dialogue: 0,0:13:10.26,0:13:11.89,Default,,0,0,0,,Ve işte Nankatsu!
Dialogue: 0,0:13:17.52,0:13:21.19,Default,,0,0,0,,{\pos(960,980)}NANKATSU ORTAOKULU
Dialogue: 0,0:13:17.52,0:13:21.19,Default,,0,0,0,,10.17: STADYUMA GELİŞ
Dialogue: 0,0:13:21.19,0:13:23.53,Default - i,,0,0,0,,Bu Japonya'daki son resmi maçım,
Dialogue: 0,0:13:23.53,0:13:26.66,Default - i,,0,0,0,,ve aynı zamanda bir ortaokullu olarak sonuncusu.
Dialogue: 0,0:13:26.66,0:13:29.78,Default - i,,0,0,0,,Aynı zamanda herkese veda edeceğim maç.
Dialogue: 0,0:13:32.62,0:13:37.63,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:13:40.59,0:13:43.26,Default,,0,0,0,,Elinden geleni yap, elinden geleni yap Nankatsu!
Dialogue: 0,0:13:43.26,0:13:46.22,Default,,0,0,0,,Savaş, savaş, Toho!
Dialogue: 0,0:13:46.22,0:13:49.14,Default,,0,0,0,,Vay canına, bu ne kalabalık.
Dialogue: 0,0:13:49.14,0:13:50.76,Default,,0,0,0,,Bir koltuk bulmak zor olacak.
Dialogue: 0,0:13:50.76,0:13:52.35,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:13:52.35,0:13:54.02,Default,,0,0,0,,Buradayız!
Dialogue: 0,0:13:54.02,0:13:55.85,Default,,0,0,0,,Oh, Misugi ve Yayoi!
Dialogue: 0,0:13:56.56,0:13:57.69,Default,,0,0,0,,Teşekkürler.
Dialogue: 0,0:13:57.69,0:13:59.81,Default,,0,0,0,,Dün çok yakındınız.
Dialogue: 0,0:13:59.81,0:14:02.73,Default,,0,0,0,,Evet, ama pişmanlık duymadığım bir maçtı.
Dialogue: 0,0:14:02.73,0:14:04.40,Default,,0,0,0,,Bir bakıma memnun oldum.
Dialogue: 0,0:14:04.82,0:14:06.78,Default,,0,0,0,,Geride kalan tek kişi siz misiniz?
Dialogue: 0,0:14:06.78,0:14:07.99,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:07.99,0:14:12.74,Default,,0,0,0,,Koç, gelecekte yararlı olması \Niçin bu maçı izlemem gerektiğini söyledi.
Dialogue: 0,0:14:12.74,0:14:15.16,Default,,0,0,0,,Ayrıca, onlarla geri dönersem...
Dialogue: 0,0:14:15.16,0:14:18.21,Default - i,,0,0,0,,Kaptan, neden onun peşinden havaalanına gittin?
Dialogue: 0,0:14:18.21,0:14:20.08,Default - i,,0,0,0,,Siz ikiniz ne hakkında konuştunuz?
Dialogue: 0,0:14:20.08,0:14:23.38,Default - i,,0,0,0,,Hey, hey! Sen de Yoshiko'yu \Nseviyorsun, değil mi Matsuyama-kun?!
Dialogue: 0,0:14:25.21,0:14:27.80,Default - i,,0,0,0,,Kesin olarak böyle bitecekti.
Dialogue: 0,0:14:28.18,0:14:30.93,Default,,0,0,0,,İkiniz çok şanslısınız, bunca zamandır birlikteydiniz...
Dialogue: 0,0:14:30.93,0:14:32.30,Default,,0,0,0,,Hah?
Dialogue: 0,0:14:32.30,0:14:34.39,Default-TOP,,0,0,0,,TOHO AKADEMİ \NTOKYO
Dialogue: 0,0:14:33.31,0:14:34.39,Default,,0,0,0,,Affedersiniz.
Dialogue: 0,0:14:35.31,0:14:38.39,Default,,0,0,0,,Toho Akademisi'nin Koçu Kitazume olmalısın.
Dialogue: 0,0:14:40.81,0:14:42.98,Default,,0,0,0,,Mektubumu okudun mu?
Dialogue: 0,0:14:42.98,0:14:45.15,Default,,0,0,0,,Benim adım Kozo Kira.
Dialogue: 0,0:14:45.61,0:14:46.61,Default,,0,0,0,,Kira mı?
Dialogue: 0,0:14:49.28,0:14:50.41,Default,,0,0,0,,Gördüğünüz gibi.
Dialogue: 0,0:14:50.41,0:14:53.91,Default,,0,0,0,,Lütfen yalvarıyorum, Kojiro'nun\N bugünkü maçta oynamasına izin ver!
Dialogue: 0,0:14:54.74,0:14:56.37,Default,,0,0,0,,Koç Kira!
Dialogue: 0,0:14:56.37,0:14:57.37,Default,,0,0,0,,Kira-san.
Dialogue: 0,0:14:57.37,0:14:58.75,Default,,0,0,0,,Lütfen başınızı kaldırın.
Dialogue: 0,0:14:58.75,0:15:01.58,Default,,0,0,0,,Bugün oynayacağını duymadığım sürece kesinlikle olmaz.
Dialogue: 0,0:15:02.04,0:15:03.38,Default,,0,0,0,,Endişelenmeyin.
Dialogue: 0,0:15:03.38,0:15:05.80,Default,,0,0,0,,Hyuga bugün bütün maçta oynuyor olacak.
Dialogue: 0,0:15:05.80,0:15:07.26,Default,,0,0,0,,Ha–
Dialogue: 0,0:15:07.26,0:15:08.34,Default,,0,0,0,,Bu doğru mu?!
Dialogue: 0,0:15:08.80,0:15:09.68,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:09.68,0:15:13.51,Default,,0,0,0,,Dün gece Hyuga şu anda yaptığınız şeyi yaptı.
Dialogue: 0,0:15:13.51,0:15:14.85,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:15:15.81,0:15:17.02,Default,,0,0,0,,Koç...
Dialogue: 0,0:15:18.81,0:15:23.40,Default - i,,0,0,0,,Şimdi, her iki takım da oyun öncesi ısınma için sahaya çıktı.
Dialogue: 0,0:15:24.02,0:15:24.90,Default,,0,0,0,,Nankatsu!
Dialogue: 0,0:15:24.90,0:15:26.03,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:26.03,0:15:28.28,Default,,0,0,0,,Hyuga, bugün oynamalısın!
Dialogue: 0,0:15:28.74,0:15:32.07,Default - i,,0,0,0,,Her iki takım için de başlangıç\Noyuncularını şimdi açıklayacağım.
Dialogue: 0,0:15:32.07,0:15:36.91,Default - i,,0,0,0,,Shizuoka Eyaletini temsil eden\N Nankatsu MS, beyaz formalarını giyecek.
Dialogue: 0,0:15:37.83,0:15:40.96,Default - i,,0,0,0,,Kaleci olarak Morisaki-kun.
Dialogue: 0,0:15:40.96,0:15:47.63,Default - i,,0,0,0,,Savunma oyuncusu olarak Nakazato-kun, Oda-kun, Takasugi-kun ve Ishizaki-kun.
Dialogue: 0,0:15:47.63,0:15:48.42,Default,,0,0,0,,Heh.
Dialogue: 0,0:15:48.42,0:15:51.84,Default - i,,0,0,0,,Orta saha oyuncuları için, Ozora Tsubasa-kun...
Dialogue: 0,0:15:52.84,0:15:54.89,Default,,0,0,0,,Demek bugün de oynayacak, ha?
Dialogue: 0,0:15:54.89,0:15:56.35,Default,,0,0,0,,İyi iş! Yaralanmalara aldırma!
Dialogue: 0,0:15:56.35,0:15:58.10,Default,,0,0,0,,Sensiz eğlenceli olmaz!
Dialogue: 0,0:15:58.68,0:16:00.94,Default,,0,0,0,,Tanrım, ne kadar popüler olduğuna bak.
Dialogue: 0,0:16:00.94,0:16:03.48,Default,,0,0,0,,Burada biraz bile bize yer yok! 
Dialogue: 0,0:16:03.48,0:16:05.94,Default,,0,0,0,,Popüler olmak eğlenceli ve güzel olmalı!
Dialogue: 0,0:16:05.94,0:16:11.24,Default - i,,0,0,0,,Ve şimdi: Tokyo'yu temsil eden Toho Akademi, siyah formalarını giyecek.
Dialogue: 0,0:16:11.24,0:16:13.86,Default - i,,0,0,0,,Kaleci olarak Wakashimazu-kun.
Dialogue: 0,0:16:15.24,0:16:21.12,Default - i,,0,0,0,,Savunma oyuncusu olarak\N Furuta-kun, Kawade-kun, Imai-kun ve Takashima-kun.
Dialogue: 0,0:16:21.12,0:16:27.75,Default - i,,0,0,0,,Orta saha oyuncusu olarak Sawada-kun, Koike-kun, Shimada-kun ve Matsuki-kun.
Dialogue: 0,0:16:27.75,0:16:29.76,Default - i,,0,0,0,,Forvetler Sorimachi-kun...
Dialogue: 0,0:16:31.09,0:16:32.34,Default - i,,0,0,0,,Ve Hyuga-kun.
Dialogue: 0,0:16:33.01,0:16:34.39,Default,,0,0,0,,Hyuga oynuyor mu?
Dialogue: 0,0:16:34.39,0:16:36.72,Default,,0,0,0,,Seni bekliyorduk, Toho'nun Ası!
Dialogue: 0,0:16:36.72,0:16:39.43,Default - i,,0,0,0,,Şu tezahüratlara bir bakın.
Dialogue: 0,0:16:39.43,0:16:45.40,Default - i,,0,0,0,,Seyirci umutsuzca Hyuga-kun'nun maçta oynamasını bekliyordu!
Dialogue: 0,0:16:45.40,0:16:46.56,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:16:46.56,0:16:47.40,Default,,0,0,0,,Demek yaptın.
Dialogue: 0,0:16:47.40,0:16:48.73,Default - i,,0,0,0,,Yapacağım.
Dialogue: 0,0:16:48.73,0:16:51.15,Default - i,,0,0,0,,Şampiyonluğu kesin olarak alacağım!
Dialogue: 0,0:16:55.20,0:16:58.99,Default - i,,0,0,0,,Isınmalarını bitirdikten sonra her iki \Ntakım da soyunma odalarına gidiyor.
Dialogue: 0,0:16:58.99,0:17:00.49,Default,,0,0,0,,TOHO ACADEMY \NTOKYO
Dialogue: 0,0:17:01.66,0:17:02.66,Default,,0,0,0,,Kaptan...!
Dialogue: 0,0:17:02.66,0:17:05.92,Default,,0,0,0,,Gerçekten bu sıcakta formanın \Naltından bir kazak mı giyiyordun?
Dialogue: 0,0:17:05.92,0:17:10.00,Default,,0,0,0,,Tam olarak hiçbir şey yapmadan \Nyedek kulübesinde oturmuyordum.
Dialogue: 0,0:17:10.00,0:17:13.38,Default,,0,0,0,,Bu yakan güneş için hazırlıklarımı yaptım.
Dialogue: 0,0:17:13.38,0:17:15.55,Default,,0,0,0,,Bu miktarda ısı beni yormaz.
Dialogue: 0,0:17:15.97,0:17:21.81,Default,,0,0,0,,Maçta ne kadar sıcak olursa, bir o kadar da avantajlı olacağım.
Dialogue: 0,0:17:21.81,0:17:23.06,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:17:23.06,0:17:26.98,Default - i,,0,0,0,,Kasları böyle kısa bir süre sonra bile daha da güçlü görünüyor.
Dialogue: 0,0:17:26.98,0:17:31.28,Default - i,,0,0,0,,Hyuga-san dövülmüş çelik gibi bir gövdeyle geri döndü.
Dialogue: 0,0:17:32.78,0:17:35.78,Default,,0,0,0,,İSTİFA DİLEKÇESİ
Dialogue: 0,0:17:34.28,0:17:35.78,Default-TOP,,0,0,0,,Tamam çocuklar, dinleyin.
Dialogue: 0,0:17:35.78,0:17:37.11,Default,,0,0,0,,Kendinize güvenin!
Dialogue: 0,0:17:37.11,0:17:40.45,Default,,0,0,0,,Kesinlikle şu anki gücünüzle kazanabilirsiniz.
Dialogue: 0,0:17:40.45,0:17:42.83,Default,,0,0,0,,Nankatsu'yu tahttan indirmenin tam zamanı!
Dialogue: 0,0:17:42.83,0:17:45.58,Default,,0,0,0,,Şampiyonluk bayrağıyla Toho Akademisine geri döneceğiz!
Dialogue: 0,0:17:45.58,0:17:46.58,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:46.58,0:17:49.08,Default-TOP,,0,0,0,,{\i1}Evet, bu yıl yapacağız!
Dialogue: 0,0:17:48.00,0:17:51.84,Default - i,,0,0,0,,Sanırım bu konuda maçtan sonra endişeleneceğim.
Dialogue: 0,0:17:51.84,0:17:55.05,Default,,0,0,0,,NANKATSU ORTAOKULU \NSHİZUOKA EYALETİ
Dialogue: 0,0:17:52.34,0:17:55.05,Default-TOP,,0,0,0,,Zamanımı önemsiz şeylerle boşa harcamayacağım.
Dialogue: 0,0:17:55.05,0:17:59.43,Default,,0,0,0,,Tek yapmanız gereken her zaman olduğu gibi oynamak.
Dialogue: 0,0:17:59.43,0:18:00.47,Default,,0,0,0,,Tamam!
Dialogue: 0,0:18:00.47,0:18:04.48,Default,,0,0,0,,Tsubasa, kaptan olarak ekleyeceğin başka bir şey var mı?
Dialogue: 0,0:18:04.48,0:18:05.56,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:08.31,0:18:10.81,Default,,0,0,0,,Nankatsu MS’e kabul edildiğim 
Dialogue: 0,0:18:10.81,0:18:16.24,Default,,0,0,0,,ve son üç yıldır sizinle futbol\N oynayabildiğim için çok mutluyum.
Dialogue: 0,0:18:16.24,0:18:19.41,Default,,0,0,0,,Bugün son karşılaşmamızda, buraya kadar geldikten sonra...
Dialogue: 0,0:18:19.41,0:18:21.45,Default,,0,0,0,,Kazanıp 3. şampiyonluğumuzu gerçeğe dönüştürelim!
Dialogue: 0,0:18:21.45,0:18:22.95,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:22.95,0:18:25.12,Default-TOP,,0,0,0,,Tamamdır, çocuklar!
Dialogue: 0,0:18:23.41,0:18:25.00,Default,,0,0,0,,Nankatsu, vakit geldi!
Dialogue: 0,0:18:25.00,0:18:26.16,Default,,0,0,0,,Tamam.
Dialogue: 0,0:18:26.16,0:18:27.62,Default,,0,0,0,,Tamam, hadi millet gidelim!
Dialogue: 0,0:18:27.62,0:18:29.08,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:29.08,0:18:30.42,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:18:30.42,0:18:31.13,Default,,0,0,0,,Bunu al.
Dialogue: 0,0:18:32.00,0:18:32.84,Default,,0,0,0,,Tabii.
Dialogue: 0,0:18:33.75,0:18:37.59,Default - i,,0,0,0,,Nankatsu kaptanı olarak son maçım.
Dialogue: 0,0:18:37.59,0:18:40.72,Default - i,,0,0,0,,Ortaokul futbol kariyerimi namağlup hale getireceğim,
Dialogue: 0,0:18:40.72,0:18:46.35,Default - i,,0,0,0,,ve bu sefer Roberto'nun ülkesi Brezilya'ya gideceğim!
Dialogue: 0,0:18:46.35,0:18:48.39,Default,,0,0,0,,TOHO AKADEMİ \NTOKYO
Dialogue: 0,0:18:46.35,0:18:48.39,Default-TOP,,0,0,0,,Toho, vakit geldi!
Dialogue: 0,0:18:48.39,0:18:50.65,Default,,0,0,0,,Hadi gidelim millet!
Dialogue: 0,0:18:50.65,0:18:51.40,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:51.40,0:18:52.82,Default,,0,0,0,,Yapacağız!
Dialogue: 0,0:18:52.82,0:18:53.86,Default,,0,0,0,,Nankatsu'yu tahttan indireceğiz! 
Dialogue: 0,0:18:53.86,0:18:54.61,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:18:55.82,0:18:58.70,Default - i,,0,0,0,,Düşününce hepsi benim küçük zeki oyuncularım.
Dialogue: 0,0:18:59.86,0:19:03.87,Default - i,,0,0,0,,Uzun zorlu eğitimime katlanmakta başarılı oldular.
Dialogue: 0,0:19:03.87,0:19:06.62,Default,,0,0,0,,Durumun nasıl, Tsubasa?
Dialogue: 0,0:19:06.62,0:19:07.54,Default,,0,0,0,,Sorun yok.
Dialogue: 0,0:19:07.54,0:19:09.75,Default,,0,0,0,,Bu süreçte incinsem bile, elimden geleni yapacağım. 
Dialogue: 0,0:19:09.75,0:19:11.88,Default,,0,0,0,,İşte ruh budur.
Dialogue: 0,0:19:12.33,0:19:13.88,Default,,0,0,0,,Doktor!
Dialogue: 0,0:19:13.88,0:19:16.46,Default,,0,0,0,,Maçtan sonra seninle ben ilgilenirim.
Dialogue: 0,0:19:16.46,0:19:19.22,Default,,0,0,0,,Yine de oynayacaksın, bu yüzden sahip olduğun her şeyi ver!
Dialogue: 0,0:19:19.97,0:19:24.89,Default - i,,0,0,0,,Ulusal Ortaokul Futbol \NTurnuvasının final maçı başlamak üzere.
Dialogue: 0,0:19:24.89,0:19:27.22,Default - i,,0,0,0,,Her iki takım da ortaya çıkıyor.
Dialogue: 0,0:19:28.64,0:19:30.02,Default,,0,0,0,,Abi!
Dialogue: 0,0:19:30.02,0:19:34.86,Default - i,,0,0,0,,Shizuoka'yı temsil eden, Toho Akademisi'ne karşı, Tokyo'yu temsil eden Nankatsu MS.
Dialogue: 0,0:19:34.86,0:19:37.48,Default,,0,0,0,,NAGASAKİ \NHİRADO MS
Dialogue: 0,0:19:35.52,0:19:39.86,Default-TOP,,0,0,0,,{\i1}Son üç yıldır aynı final maçını görüyoruz.{\i0}
Dialogue: 0,0:19:39.86,0:19:42.91,Default-TOP,,0,0,0,,{\i1}Eminim en iyi üyeleri ile başlayan iki takım da{\i0}
Dialogue: 0,0:19:39.86,0:19:42.91,Default,,0,0,0,,OSAKA \NAZUMAİCHİ MS
Dialogue: 0,0:19:42.91,0:19:45.12,Default-TOP,,0,0,0,,{\i1}maçın 60 dakikasında bize{\i0}
Dialogue: 0,0:19:42.91,0:19:45.12,Default,,0,0,0,,AKİTA \NTACHİBANA EVİ
Dialogue: 0,0:19:45.12,0:19:50.87,Default-TOP,,0,0,0,,{\i1}harika oyunlar gösterecek ve gözlerimizi ayıramayacağız.{\i0}
Dialogue: 0,0:19:45.12,0:19:48.12,Default,,0,0,0,,WAKASHİMAZU EVİ
Dialogue: 0,0:19:51.42,0:19:57.42,Default,,0,0,0,,Tatlım, gerçekten kaybederse Ken'e futbolu bıraktıracak mısın?
Dialogue: 0,0:19:57.42,0:19:59.97,Default,,0,0,0,,Şimdiye kadar oynamasına izin vermemin şartı buydu.
Dialogue: 0,0:20:00.51,0:20:03.76,Default,,0,0,0,,Ken her maçta, bunun tam olarak farkında.
Dialogue: 0,0:20:03.76,0:20:07.56,Default - i,,0,0,0,,Top, bozuk para atılarak Toho Akademi'ye gider.
Dialogue: 0,0:20:07.56,0:20:09.52,Default - i,,0,0,0,,Sahada olmayalı uzun zaman oldu.
Dialogue: 0,0:20:09.52,0:20:12.56,Default - i,,0,0,0,,{\t(2294,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Lütfen millet, bana gücünüzü ödünç verin.{\i0}
Dialogue: 0,0:20:13.60,0:20:15.73,Default - i,,0,0,0,,Ortaokul turnuvasının ilk yılı...
Dialogue: 0,0:20:17.73,0:20:20.03,Default - i,,0,0,0,,Tsubasa-kun tepeden bir şut çekiyor!
Dialogue: 0,0:20:20.03,0:20:22.11,Default - i,,0,0,0,,Nankatsu ilk şampiyonluğunu aldı!
Dialogue: 0,0:20:22.11,0:20:23.57,Default - i,,0,0,0,,Geçen yıl...
Dialogue: 0,0:20:23.57,0:20:24.24,Default - i,,0,0,0,,{\i1}Gidelim!{\i0}
Dialogue: 0,0:20:24.24,0:20:25.32,Default - i,,0,0,0,,{\i1}Evet!{\i0}
Dialogue: 0,0:20:25.32,0:20:26.74,Default - i,,0,0,0,,O turnuvada da... 
Dialogue: 0,0:20:28.79,0:20:30.04,Default - i,,0,0,0,,İçerde!
Dialogue: 0,0:20:30.04,0:20:33.21,Default - i,,0,0,0,,Nankatsu, ülke çapında hüküm\N süren 2. şampiyonluğunu gerçekleştirdi!
Dialogue: 0,0:20:34.42,0:20:37.54,Default - i,,0,0,0,,Daha fazla kaybetmeyi reddediyorum, Tsubasa.
Dialogue: 0,0:20:37.54,0:20:41.22,Default - i,,0,0,0,,Son 3 senedir ortaokul hayatımın bu son maçıyla,
Dialogue: 0,0:20:41.22,0:20:44.93,Default - i,,0,0,0,,hissettiğim utancı iade edeceğim.
Dialogue: 0,0:20:45.34,0:20:47.22,Default - i,,0,0,0,,Maç öğlen başlayacak.
Dialogue: 0,0:20:47.22,0:20:49.93,Default - i,,0,0,0,,Kader anı yaklaşıyor! 
Dialogue: 0,0:20:49.93,0:20:51.02,Default,,0,0,0,,5,{\alpha&HFF&}4,3,2,1,0!
Dialogue: 0,0:20:51.02,0:20:51.93,Default,,0,0,0,,5,4,{\alpha&HFF&}3,2,1,0!
Dialogue: 0,0:20:51.93,0:20:52.94,Default,,0,0,0,,5,4,3,{\alpha&HFF&}2,1,0!
Dialogue: 0,0:20:52.94,0:20:53.94,Default,,0,0,0,,5,4,3,2,{\alpha&HFF&}1,0!
Dialogue: 0,0:20:53.94,0:20:55.19,Default,,0,0,0,,5,4,3,2,1,{\alpha&HFF&}0!
Dialogue: 0,0:20:55.19,0:20:56.19,Default,,0,0,0,,5,4,3,2,1,0!
Dialogue: 0,0:20:58.02,0:20:59.78,Default - i,,0,0,0,,Maç sonunda başlıyor!
Dialogue: 0,0:20:59.78,0:21:03.82,Default - i,,0,0,0,,Yüzyılın maçı için düdük açık ve net çalıyor!
Dialogue: 0,0:21:04.24,0:21:05.45,Default,,0,0,0,,Gidelim millet!
Dialogue: 0,0:21:05.45,0:21:06.32,Default,,0,0,0,,Evet!
Dialogue: 0,0:21:10.41,0:21:15.42,Default - i,,0,0,0,,Hyuga santra çizgisinde şut atmaya hazırlanıyor!
Dialogue: 0,0:21:16.38,0:21:17.63,Default,,0,0,0,,Ne?!
Dialogue: 0,0:21:17.63,0:21:18.59,Default - i,,0,0,0,,İşte geliyor. 
Dialogue: 0,0:21:18.59,0:21:20.55,Default - i,,0,0,0,,Başından beri belliydi!
Dialogue: 0,0:21:20.55,0:21:22.97,Default - i,,0,0,0,,Arkada kalmakta haklıydım!
Dialogue: 0,0:21:23.63,0:21:25.38,Default,,0,0,0,,Ye bunu, Nankatsu!
Dialogue: 0,0:21:25.38,0:21:26.55,Default,,0,0,0,,Bu benim...
Dialogue: 0,0:21:27.89,0:21:30.81,Default,,0,0,0,,{\bord0\blur0.6\c&H00F7FF&}Tiger Shot!
Dialogue: 0,0:21:27.89,0:21:30.81,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:21:34.39,0:21:34.89,Default,,0,0,0,,Hızlı!
Dialogue: 0,0:21:34.89,0:21:36.79,Default - i,,0,0,0,,Hyuga-kun'nun uzun şutu,
Dialogue: 0,0:21:36.79,0:21:41.11,Default - i,,0,0,0,,Nankatsu'nun kalesine doğru alçak bir yörüngede ilerliyor!
Dialogue: 0,0:21:43.61,0:21:45.90,Default - i,,0,0,0,,Direğe çarptı!
Dialogue: 0,0:21:45.90,0:21:49.49,Default - i,,0,0,0,,Kaleci Morisaki-kun şu an şaşırıyor, bir santim hareket edemiyor!
Dialogue: 0,0:21:49.49,0:21:51.24,Default - i,,0,0,0,,Kahretsin!
Dialogue: 0,0:21:52.91,0:21:56.00,Default - i,,0,0,0,,Ahh, top patlamış!
Dialogue: 0,0:21:57.00,0:21:58.54,Default,,0,0,0,,Ne muhteşem bir atış!
Dialogue: 0,0:21:58.54,0:21:59.88,Default,,0,0,0,,Senden beklendiği gibi Hyuga!
Dialogue: 0,0:21:59.88,0:22:00.88,Default,,0,0,0,,Abi!
Dialogue: 0,0:22:00.88,0:22:02.71,Default - i,,0,0,0,,Böyle bir güç...
Dialogue: 0,0:22:02.71,0:22:07.89,Default - i,,0,0,0,,Hyuga-kun bu kadar kısa sürede müthiş bir atış mı yaptı...?
Dialogue: 0,0:22:07.89,0:22:08.68,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:22:09.39,0:22:12.97,Default - i,,0,0,0,,Son maç şok edici bir şekilde başladı!
Dialogue: 0,0:22:12.97,0:22:17.48,Default - i,,0,0,0,,Vahşi Kaplan, Kojiro Hyuga mükemmel dönüşünü yapıyor!
Dialogue: 0,0:22:19.67,0:22:34.67,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.61,0:23:59.46,Default,,0,0,0,,47. BÖLÜM: BİR KEZ DAHA KAÇINILMAZ BİR GÖSTERİ
Dialogue: 0,0:23:49.61,0:24:00.00,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:00:02.27,0:00:04.98,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:05.90,0:00:08.57,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:09.48,0:00:12.20,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:19.08,0:00:21.91,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:00:21.91,0:00:28.17,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:00:28.17,0:00:34.05,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta no ni
Dialogue: 0,0:00:34.05,0:00:40.64,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:00:40.64,0:00:44.64,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:00:44.64,0:00:49.15,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:00:49.15,0:00:54.74,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:00:54.74,0:00:56.28,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:00:56.28,0:00:57.49,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:00:57.49,0:01:00.99,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:01:00.99,0:01:10.88,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:01:10.88,0:01:11.71,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:11.71,0:01:15.51,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:01:15.51,0:01:19.51,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:01:19.51,0:01:25.77,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:01:25.77,0:01:28.61,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:00:02.27,0:00:04.98,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:05.90,0:00:08.57,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:09.48,0:00:12.20,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:19.08,0:00:21.91,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:00:21.91,0:00:28.17,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:00:28.17,0:00:34.05,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:00:34.05,0:00:40.64,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:00:40.64,0:00:44.64,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:00:44.64,0:00:49.15,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:00:49.15,0:00:54.74,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:00:54.74,0:00:56.28,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:00:56.28,0:00:57.49,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:00:57.49,0:01:00.99,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:01:00.99,0:01:10.88,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:01:10.88,0:01:11.71,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:11.71,0:01:15.51,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:01:15.51,0:01:19.51,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:01:19.51,0:01:25.77,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:01:25.77,0:01:28.61,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.02,0:00:06.02,Default,,0,0,0,,
Dialogue: 0,0:22:38.42,0:22:44.46,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.46,0:22:50.47,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.47,0:22:56.52,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.52,0:23:01.15,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.77,0:23:07.44,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.78,0:23:14.87,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.87,0:23:20.92,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:20.92,0:23:25.38,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.67,0:23:33.01,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.01,0:23:39.06,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.06,0:23:45.36,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.42,0:22:44.46,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.46,0:22:50.47,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.47,0:22:56.52,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.52,0:23:01.15,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.77,0:23:07.44,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.78,0:23:14.87,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.87,0:23:20.92,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:20.92,0:23:25.38,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.67,0:23:33.01,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.01,0:23:39.06,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.06,0:23:45.36,OPED,,0,0,0,,Bu hırslı gençlik sahada!
