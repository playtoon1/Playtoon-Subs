Dialogue: 0,0:00:00.00,0:00:03.50,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:00.21,0:00:03.36,Default - i,,0,0,0,,Ulusal Ortaokul Futbol Turnuvası'nın yarı finalindeyiz.
Dialogue: 0,0:00:03.36,0:00:03.98,Default,,0,0,0,,İşte!
Dialogue: 0,0:00:03.98,0:00:08.28,Default - i,,0,0,0,,Nankatsu ve Furano arasındaki ikinci yarı final maçında 10 dakikadan az kaldı!
Dialogue: 0,0:00:03.98,0:00:06.48,Default-TOP,,0,0,0,,Furano! Furano!
Dialogue: 0,0:00:06.48,0:00:09.73,Default-TOP,,0,0,0,,Yaşasın, yaşasın, Nankatsu!
Dialogue: 0,0:00:08.28,0:00:11.54,Default - i,,0,0,0,,Üst üste üçüncü kez finallere ulaşan ilk takım,
Dialogue: 0,0:00:11.54,0:00:13.45,Default - i,,0,0,0,,Toho Akademi, bu maçı yakından izlerken,
Dialogue: 0,0:00:13.45,0:00:16.70,Default - i,,0,0,0,,iki takım arasındaki sert mücadele devam ediyor.
Dialogue: 0,0:00:16.70,0:00:17.95,Default,,0,0,0,,Pekala! Hadi yapalım!  
Dialogue: 0,0:00:17.95,0:00:21.25,Default - i,,0,0,0,,Geride kaldıktan sonra Furano yeniden toparlandı,
Dialogue: 0,0:00:21.25,0:00:24.47,Default - i,,0,0,0,,ve maçın hızını yavaşça kontrol altına aldı!
Dialogue: 0,0:00:24.47,0:00:25.71,Default,,0,0,0,,Direnin millet!
Dialogue: 0,0:00:25.71,0:00:26.95,Default,,0,0,0,,Bir gol atacağız!
Dialogue: 0,0:00:26.95,0:00:28.46,Default,,0,0,0,,Skoru eşitleyeceğiz!
Dialogue: 0,0:00:28.46,0:00:31.84,Default - i,,0,0,0,,Her iki takım da bu oyuna kalplerini ve ruhlarını koyuyor!
Dialogue: 0,0:00:32.30,0:00:35.34,Default - i,,0,0,0,,Ve oyunda hiç faul olmadı, adil bir maç oldu.
Dialogue: 0,0:00:35.99,0:00:39.50,Default - i,,0,0,0,,Nankatsu ve Furano arasındaki enerjik maç, gerçekten yarı finale layık,
Dialogue: 0,0:00:39.50,0:00:42.50,Default - i,,0,0,0,,mükemmel mücadele ruhuna sahip birinci sınıf bir oyundur.
Dialogue: 0,0:00:43.06,0:00:45.70,Default,,0,0,0,,Savaş, Furano!
Dialogue: 0,0:00:48.77,0:00:51.81,Default - i,,0,0,0,,Tanrım, sana yalvarıyorum. 
Dialogue: 0,0:00:51.81,0:00:53.57,Default - i,,0,0,0,,Kazanmalarına izin ver!
Dialogue: 0,0:00:53.57,0:01:08.57,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \Nİnstagram: AnimeSeverlerrr
Dialogue: 0,0:02:24.04,0:02:29.54,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}45. BÖLÜM: \NHAVAALANINDA GÖZYAŞLARI
Dialogue: 0,0:02:24.26,0:02:27.46,Default-TOP,,0,0,0,,{\i1}Furano, Nankatsu'nun kalesine şiddetli saldırılarını sürdürüyor!{\i0}
Dialogue: 0,0:02:27.46,0:02:30.46,Default-TOP,,0,0,0,,{\i1}Bir gol atmak için Furano ne yapacak?{\i0}
Dialogue: 0,0:02:30.46,0:02:32.38,Default - i,,0,0,0,,Wakamatsu-kun ileri koşuyor.
Dialogue: 0,0:02:33.96,0:02:35.71,Default - i,,0,0,0,,Acaba şut mu çekecek?
Dialogue: 0,0:02:36.66,0:02:39.05,Default - i,,0,0,0,,Hayır, Nankatsu onu engelledi! 
Dialogue: 0,0:02:39.05,0:02:41.39,Default - i,,0,0,0,,Kaleye ulaşmasına izin vermiyorlar.
Dialogue: 0,0:02:41.39,0:02:43.61,Default,,0,0,0,,İyi millet!
Dialogue: 0,0:02:43.61,0:02:46.60,Default - i,,0,0,0,,Nankatsu daha önce "Tsubasa'nın tek kişilik takımı" olarak adlandırılmıştı,
Dialogue: 0,0:02:46.60,0:02:49.77,Default - i,,0,0,0,,ama bu gerçekten doğru değil.
Dialogue: 0,0:02:49.77,0:02:52.92,Default - i,,0,0,0,,Şu anda normalde olduğu gibi bütün gücünü kullanamasa da,
Dialogue: 0,0:02:52.92,0:02:58.11,Default - i,,0,0,0,,Takım bunu telafi ediyor, birbirlerine yardım ediyorlar ve harika bir oyun sergiliyorlar.
Dialogue: 0,0:02:58.69,0:03:04.62,Default - i,,0,0,0,, Ve onların kaptanı olarak, Tsubasa bu koşullarda acısını bastırıyor ve elinden gelenin en iyisini yapıyor. 
Dialogue: 0,0:02:58.69,0:03:01.97,Default-TOP,,0,0,0,,Iwami, verkaç! O zaman Nagano'ya pas at!
Dialogue: 0,0:03:05.31,0:03:06.65,Default - i,,0,0,0,,Açıkça söyleyebilirim. 
Dialogue: 0,0:03:06.65,0:03:09.87,Default - i,,0,0,0,,Nankatsu, Japonya'daki en iyi takım.
Dialogue: 0,0:03:09.87,0:03:12.68,Default - i,,0,0,0,,Furano topu bir kez daha çaldı!
Dialogue: 0,0:03:12.68,0:03:13.58,Default,,0,0,0,,İyi çalım!
Dialogue: 0,0:03:13.58,0:03:17.09,Default - i,,0,0,0,,Bir gol atmak ve oyunu eşitlemek\N için gösterdikleri kararlılığın kanıtı.
Dialogue: 0,0:03:17.09,0:03:18.68,Default,,0,0,0,,Bunu yapabilirsin! Savaşmaya devam et!
Dialogue: 0,0:03:18.68,0:03:20.40,Default - i,,0,0,0,,İyi şanslar millet.
Dialogue: 0,0:03:20.40,0:03:24.96,Default - i,,0,0,0,,Biz kuzey topraklarından bir takımız; sık sık, sıcaklığa karşı güçsüz olduğumuzu
Dialogue: 0,0:03:24.96,0:03:27.56,Default - i,,0,0,0,,veya yarışta yerimiz olmadığını söylediler.
Dialogue: 0,0:03:27.56,0:03:29.02,Default - i,,0,0,0,,Ama... şuna bir bak.
Dialogue: 0,0:03:29.02,0:03:33.77,Default - i,,0,0,0,,Her geçen gün bu sıcaklığa rağmen turnuva boyunca kazandık.
Dialogue: 0,0:03:33.77,0:03:37.07,Default - i,,0,0,0,,Sadece bir bakın!\N Buraya kadar şampiyon Nankatsu'yu kovaladılar!
Dialogue: 0,0:03:37.07,0:03:38.57,Default,,0,0,0,,Tamamdır! Gidelim!
Dialogue: 0,0:03:38.57,0:03:40.19,Default,,0,0,0,,Kesinlikle bir şansımız olacak!
Dialogue: 0,0:03:40.19,0:03:41.95,Default,,0,0,0,,Pes etmeyin, saldırmaya devam edin!
Dialogue: 0,0:03:41.95,0:03:44.83,Default - i,,0,0,0,,Matsuyama dışında hiçbir oyuncu karşı koyamıyor...
Dialogue: 0,0:03:44.83,0:03:46.95,Default - i,,0,0,0,,Yine de denerlerse yapabilirler.
Dialogue: 0,0:03:46.95,0:03:50.02,Default - i,,0,0,0,,Kazanmanızı istiyorum.
Dialogue: 0,0:03:50.02,0:03:50.58,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:03:50.95,0:03:52.60,Default - i,,0,0,0,,Furano topu kaleye doğru attı!
Dialogue: 0,0:03:52.60,0:03:53.29,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:54.29,0:03:55.71,Default - i,,0,0,0,,Morisaki onu uzaklaştırıyor!
Dialogue: 0,0:03:55.71,0:03:57.55,Default - i,,0,0,0,,Furano bir daha gol atamadı!
Dialogue: 0,0:03:57.55,0:03:58.81,Default,,0,0,0,,Tamam, işte başlıyoruz!
Dialogue: 0,0:03:58.81,0:04:00.26,Default,,0,0,0,,Bu sefer saldıracağız!
Dialogue: 0,0:04:00.26,0:04:01.01,Default,,0,0,0,,Tamam!
Dialogue: 0,0:04:01.01,0:04:04.84,Default - i,,0,0,0,,Nankatsu, uzun bir süre sonra nihayet bir saldırı yapma şansı yakaladı!
Dialogue: 0,0:04:04.84,0:04:06.01,Default,,0,0,0,,Geri dönün millet!
Dialogue: 0,0:04:06.01,0:04:07.76,Default,,0,0,0,,Hemen geri dönmeliyiz!
Dialogue: 0,0:04:07.76,0:04:09.81,Default - i,,0,0,0,,Nankatsu saldırıyor...
Dialogue: 0,0:04:09.81,0:04:13.19,Default - i,,0,0,0,,Şimdi bir tane daha atarlarsa, oyun burda biter.
Dialogue: 0,0:04:13.19,0:04:16.27,Default - i,,0,0,0,,Izawa kime pas gönderecek?
Dialogue: 0,0:04:16.27,0:04:17.90,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:04:17.90,0:04:20.49,Default - i,,0,0,0,,Ahh, Izawa-kun doğrudan şut atıyor!
Dialogue: 0,0:04:20.49,0:04:21.78,Default,,0,0,0,,Sanki izin veririm!
Dialogue: 0,0:04:22.49,0:04:24.81,Default - i,,0,0,0,,Kaleci Kato-kun zamanında tepki veriyor!
Dialogue: 0,0:04:24.81,0:04:26.95,Default - i,,0,0,0,,Fakat top Taki-kun'nun tam önüne düştü. 
Dialogue: 0,0:04:28.95,0:04:30.70,Default,,0,0,0,,Bu gol işi bitirecek!
Dialogue: 0,0:04:32.92,0:04:34.62,Default - i,,0,0,0,,Furano bunu da engelledi! 
Dialogue: 0,0:04:34.62,0:04:35.75,Default,,0,0,0,,Millet!
Dialogue: 0,0:04:35.75,0:04:38.25,Default - i,,0,0,0,,Şimdi top kalenin önüne düşüyor! 
Dialogue: 0,0:04:38.25,0:04:39.96,Default,,0,0,0,,Ben hallederim!
Dialogue: 0,0:04:39.96,0:04:42.30,Default - i,,0,0,0,,Kisugi'den kayan bir şut! 
Dialogue: 0,0:04:42.30,0:04:43.64,Default - i,,0,0,0,,Ama hayır, girmeyecek!
Dialogue: 0,0:04:43.64,0:04:44.55,Default - i,,0,0,0,,Furano saptırıyor!
Dialogue: 0,0:04:44.55,0:04:48.01,Default - i,,0,0,0,,Matsuyama-kun bu mükemmel hamle için Tsubasa-kun'u tutmayı bıraktı!
Dialogue: 0,0:04:48.01,0:04:48.72,Default,,0,0,0,,Ah!
Dialogue: 0,0:04:48.72,0:04:51.97,Default,,0,0,0,,Fakat uzaklaştırılan top tam Tsubasa-kun'nun önüne düşüyor!
Dialogue: 0,0:04:51.97,0:04:52.73,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:04:55.98,0:04:57.10,Default,,0,0,0,,{\bord0\blur0.6\c&HFFF069&\4a&HFF&}Drive...
Dialogue: 0,0:04:55.98,0:05:01.19,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:04:59.91,0:05:01.19,Default,,0,0,0,,{\bord0\blur0.6\c&H3AFFFD&}Shot!
Dialogue: 0,0:05:08.07,0:05:10.53,Default - i,,0,0,0,,Matsuyama-kun tüm vücudu ile engelliyor!
Dialogue: 0,0:05:10.53,0:05:12.45,Default - i,,0,0,0,,Ama bu gerçekten çok güçlü!
Dialogue: 0,0:05:12.45,0:05:14.41,Default - i,,0,0,0,,Doğrudan kaleye gidiyor! 
Dialogue: 0,0:05:14.41,0:05:15.46,Default,,0,0,0,,Matsuyama-kun! 
Dialogue: 0,0:05:15.46,0:05:16.75,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:05:17.55,0:05:22.05,Default,,0,0,0,,Kale önünde herkes Matsuyama-kun'u tutmaya geldi!
Dialogue: 0,0:05:22.56,0:05:23.51,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:05:23.51,0:05:26.38,Default,,0,0,0,,Drive Shot durduruldu! 
Dialogue: 0,0:05:23.51,0:05:26.38,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:05:30.29,0:05:31.19,Default,,0,0,0,,Millet...
Dialogue: 0,0:05:31.19,0:05:32.45,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:05:32.45,0:05:37.19,Default - i,,0,0,0,,Furano onbiri bir oldu ve \NTsubasa-kun'nun Drive Shot'unu engelledi!
Dialogue: 0,0:05:32.45,0:05:37.19,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:05:37.19,0:05:38.36,Default,,0,0,0,,Başardınız!
Dialogue: 0,0:05:38.36,0:05:41.69,Default,,0,0,0,,Gördün mü? Bu Furano'nun gerçek takım çalışması!
Dialogue: 0,0:05:41.69,0:05:42.54,Default,,0,0,0,,Lanet olsun...
Dialogue: 0,0:05:42.54,0:05:46.90,Default,,0,0,0,,Tsubasa bütün gücünü o Drive Shot'a koydu ve henüz...
Dialogue: 0,0:05:42.54,0:05:46.90,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:05:46.90,0:05:48.28,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:05:48.28,0:05:49.79,Default,,0,0,0,,Kahretsin Tsubasa...
Dialogue: 0,0:05:49.79,0:05:53.79,Default,,0,0,0,,Vücudunu en çok zorlayan şey olmasına\N rağmen Drive Shot'u kullanmak zorunda kaldı...
Dialogue: 0,0:05:49.79,0:05:53.79,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:05:53.79,0:05:56.05,Default,,0,0,0,,Millet! Yavaşlamayı göze alamayız!
Dialogue: 0,0:05:56.05,0:05:56.97,Default,,0,0,0,,Vaktimiz yok!
Dialogue: 0,0:05:56.97,0:05:57.92,Default,,0,0,0,,Şimdi saldıralım!
Dialogue: 0,0:05:57.92,0:06:00.34,Default,,0,0,0,,Şimdi gol sırası bizde!
Dialogue: 0,0:06:00.34,0:06:01.04,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:01.04,0:06:03.88,Default - i,,0,0,0,,Furano'dan bir başka Çığ Saldırısı!
Dialogue: 0,0:06:03.88,0:06:07.26,Default - i,,0,0,0,,Kalan süre zarfında, bu son saldırı olabilir.
Dialogue: 0,0:06:07.26,0:06:12.42,Default - i,,0,0,0,,ABD'ye gitmemden bağımsız olarak... \NSadece kazandıklarını görmek istiyorum!
Dialogue: 0,0:06:12.42,0:06:14.86,Default - i,,0,0,0,,Matsuyama-kun ve herkes buraya gelmek için çok çalıştı. 
Dialogue: 0,0:06:14.86,0:06:16.27,Default - i,,0,0,0,,Kazanmalarını istiyorum!
Dialogue: 0,0:06:16.27,0:06:17.81,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:06:19.73,0:06:22.27,Default - i,,0,0,0,,Tsubasa, bu son hesaplaşma!
Dialogue: 0,0:06:22.27,0:06:23.73,Default - i,,0,0,0,,Kesinlikle geçeceğim!
Dialogue: 0,0:06:23.73,0:06:25.28,Default - i,,0,0,0,,Ben... {\alpha&HFF&}kaybetmeyeceğim!
Dialogue: 0,0:06:25.28,0:06:25.99,Default - i,,0,0,0,,Ben... kaybetmeyeceğim!
Dialogue: 0,0:06:26.99,0:06:29.26,Default - i,,0,0,0,,Çok az zaman kaldı!
Dialogue: 0,0:06:29.26,0:06:32.49,Default - i,,0,0,0,,Tekrar şiddetli bir şekilde 10 numaraya karşı 10 numara oldu!
Dialogue: 0,0:06:36.75,0:06:38.50,Default,,0,0,0,,İyi şanslar Tsubasa!
Dialogue: 0,0:06:38.50,0:06:40.25,Default,,0,0,0,,Yar geç, Matsuyama!
Dialogue: 0,0:06:40.25,0:06:42.50,Default-TOP,,0,0,0,,Matsuyama!
Dialogue: 0,0:06:42.50,0:06:51.26,Default-TOP,,0,0,0,,Tsubasa!
Dialogue: 0,0:06:42.99,0:06:46.49,Default - i,,0,0,0,,Stadyum Matsuyama-kun ve Tsubasa-kun için alkışlarla dolu!
Dialogue: 0,0:06:46.49,0:06:49.31,Default - i,,0,0,0,,Sonunda kim galip çıkacak?
Dialogue: 0,0:06:49.31,0:06:51.26,Default - i,,0,0,0,,İki taraf da kazançlı değil!
Dialogue: 0,0:07:01.06,0:07:02.64,Default - i,,0,0,0,,Topu benden almana izin vermeyeceğim! 
Dialogue: 0,0:07:02.64,0:07:04.40,Default - i,,0,0,0,,Kontrolümü seni geçmek için kullanacağım!
Dialogue: 0,0:07:04.40,0:07:05.90,Default - i,,0,0,0,,Geçmene izin veririm sanki!
Dialogue: 0,0:07:05.90,0:07:07.35,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:07:07.35,0:07:08.97,Default,,0,0,0,,Kaptanımıza inanalım.
Dialogue: 0,0:07:08.97,0:07:10.91,Default,,0,0,0,,Kalenin önüne gitmeliyiz!
Dialogue: 0,0:07:10.91,0:07:12.99,Default,,0,0,0,,Tsubasa neredeyse sınırında.
Dialogue: 0,0:07:12.99,0:07:14.65,Default,,0,0,0,,Yardım etmeliyiz!
Dialogue: 0,0:07:14.65,0:07:15.41,Default,,0,0,0,,Evet!
Dialogue: 0,0:07:15.41,0:07:18.41,Default - i,,0,0,0,,Nankatsu Tsubasa-kun’u destekleyecek!
Dialogue: 0,0:07:18.41,0:07:22.71,Default - i,,0,0,0,,Furano topu şimdi kaptırırsa, geride kaleci dışında başka kimsesi yok.
Dialogue: 0,0:07:24.63,0:07:26.96,Default,,0,0,0,,Geçeceğimi söylersem, geçeceğim anlamına gelir!
Dialogue: 0,0:07:28.15,0:07:30.63,Default - i,,0,0,0,,İkisi şiddetle çatıştı!
Dialogue: 0,0:07:31.72,0:07:32.97,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:07:32.97,0:07:35.58,Default - i,,0,0,0,,Ama faul değil!
Dialogue: 0,0:07:35.58,0:07:37.20,Default - i,,0,0,0,,Futbol fiziksel bir spordur!
Dialogue: 0,0:07:37.20,0:07:40.48,Default - i,,0,0,0,,Her zaman böyle bir vuruştan kaçınamazsın.
Dialogue: 0,0:07:40.48,0:07:41.43,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:41.43,0:07:43.48,Default,,0,0,0,,Bu sefer seni durdurmak zorundayız!
Dialogue: 0,0:07:43.91,0:07:44.98,Default,,0,0,0,,İşte başlıyorum!
Dialogue: 0,0:07:46.98,0:07:47.84,Default,,0,0,0,,Ne?
Dialogue: 0,0:07:47.84,0:07:48.57,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:07:48.57,0:07:50.80,Default - i,,0,0,0,,Kisugi-kun ve Taki-kun'u geçti!
Dialogue: 0,0:07:50.80,0:07:55.07,Default - i,,0,0,0,,İşte bu yüzden en iyi kontrole sahip olduğunu\N söylüyorlar; Hokkaido'nun Vahşi Kartalı Hikaru Matsuyama!
Dialogue: 0,0:07:55.07,0:07:56.62,Default,,0,0,0,,Savunacağız!
Dialogue: 0,0:07:57.54,0:08:00.16,Default - i,,0,0,0,,Matsuyama-kun şut çekmek için pozisyon alıyor.
Dialogue: 0,0:08:00.16,0:08:02.04,Default - i,,0,0,0,,Kuzey Ülkesi Atışı mı atacak?
Dialogue: 0,0:08:02.04,0:08:07.17,Default,,0,0,0,,Tsubasa'nın Drive Shot'unu durdurduğun için \Ngeri ödeme yapmak üzere bu kez atışını engelleyeceğiz.
Dialogue: 0,0:08:02.04,0:08:07.17,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:07.17,0:08:08.17,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:08.17,0:08:10.72,Default - i,,0,0,0,,Matsuyama-kun pasa çevirdi.
Dialogue: 0,0:08:10.72,0:08:13.03,Default - i,,0,0,0,,Son vuruşu arkadaşlarına bıraktı!
Dialogue: 0,0:08:13.03,0:08:13.90,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:08:13.90,0:08:16.26,Default,,0,0,0,,Kaptanın pasının kaleye ulaşmasını sağlayacağız!
Dialogue: 0,0:08:16.26,0:08:17.30,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:08:17.30,0:08:21.72,Default - i,,0,0,0,,Dostluk ve güven konularına bağlıyız. 
Dialogue: 0,0:08:21.72,0:08:23.02,Default - i,,0,0,0,,Size bırakıyorum millet! 
Dialogue: 0,0:08:27.15,0:08:29.41,Default - i,,0,0,0,,İçerde!
Dialogue: 0,0:08:29.41,0:08:30.46,Default - i,,0,0,0,,Beraberlik!
Dialogue: 0,0:08:30.46,0:08:32.70,Default - i,,0,0,0,,Furano'nun ısrarı gerçek \Npotansiyellerine tanık olmamıza izin verdi! 
Dialogue: 0,0:08:34.20,0:08:36.20,Default,,0,0,0,,Başardık millet!
Dialogue: 0,0:08:36.20,0:08:37.45,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:08:37.45,0:08:38.11,Default,,0,0,0,,Başardık!
Dialogue: 0,0:08:38.11,0:08:39.16,Default,,0,0,0,,Yakaladık!
Dialogue: 0,0:08:39.16,0:08:40.20,Default,,0,0,0,,Beraberlik!
Dialogue: 0,0:08:40.20,0:08:42.45,Default,,0,0,0,,Başardık Yoshiko! Oyun berabere!
Dialogue: 0,0:08:42.45,0:08:44.33,Default,,0,0,0,,Çok memnunum millet!
Dialogue: 0,0:08:45.01,0:08:48.90,Default - i,,0,0,0,,Demek sonuna kadar dayanamayacaktın, Tsubasa...
Dialogue: 0,0:08:48.90,0:08:54.18,Default - i,,0,0,0,,Orada Drive Shot atmasaydın, tek gollük arayı koruyabilirdin.
Dialogue: 0,0:08:48.90,0:08:54.18,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:54.18,0:08:58.97,Default - i,,0,0,0,,Ama gol atmayı seçtin... Sahip\N olduklarını savunmak yerine saldırmayı seçtin. 
Dialogue: 0,0:08:58.97,0:09:01.36,Default,,0,0,0,,Lanet olsun! Bizi yakaladılar!
Dialogue: 0,0:09:01.36,0:09:03.25,Default,,0,0,0,,Bir dakikamız bile kalmadı!
Dialogue: 0,0:09:03.25,0:09:04.60,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:09:07.14,0:09:08.61,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:09:08.61,0:09:11.52,Default,,0,0,0,,Oyun daha bitmedi, millet.
Dialogue: 0,0:09:12.86,0:09:13.49,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:09:13.49,0:09:14.49,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:09:14.49,0:09:15.61,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:09:16.05,0:09:18.62,Default - i,,0,0,0,,Bir dakikadan az kaldı. 
Dialogue: 0,0:09:18.62,0:09:20.62,Default - i,,0,0,0,, Birinci ve ikinci yarı; 60 dakika. 
Dialogue: 0,0:09:20.62,0:09:23.85,Default - i,,0,0,0,,Tsubasa, sana karşı kazanamadım.
Dialogue: 0,0:09:23.85,0:09:26.12,Default - i,,0,0,0,,Ama kaybetmedim de.
Dialogue: 0,0:09:26.12,0:09:28.12,Default - i,,0,0,0,,Ayağa kalk, Tsubasa.
Dialogue: 0,0:09:28.12,0:09:30.12,Default - i,,0,0,0,,Penaltı atışlarında yeneceğim.
Dialogue: 0,0:09:34.13,0:09:36.38,Default - i,,0,0,0,,Tsubasa ayağa kalktı!
Dialogue: 0,0:09:36.38,0:09:39.81,Default - i,,0,0,0,,Sol omzunu tutarken ayağa kalktı.
Dialogue: 0,0:09:39.81,0:09:41.51,Default,,0,0,0,,İyi misin Tsubasa?
Dialogue: 0,0:09:41.51,0:09:43.04,Default,,0,0,0,,Kisugi, Taki.
Dialogue: 0,0:09:43.04,0:09:45.64,Default,,0,0,0,,Oyun yeniden başladığında, hemen bana bir pas gönderin.
Dialogue: 0,0:09:45.64,0:09:47.48,Default,,0,0,0,,Sen neden bahsediyorsun Tsubasa?
Dialogue: 0,0:09:47.48,0:09:48.71,Default,,0,0,0,,Şu anki durumunda...
Dialogue: 0,0:09:48.71,0:09:49.60,Default,,0,0,0,,O haklı.
Dialogue: 0,0:09:49.60,0:09:51.28,Default,,0,0,0,,İmkansız, senin için bile...
Dialogue: 0,0:09:51.28,0:09:53.03,Default,,0,0,0,,Sadece Tsubasa'ya pas yollayın.
Dialogue: 0,0:09:55.24,0:09:58.69,Default,,0,0,0,,Tsubasa, kaptanımız, Nankatsu'nun kaptanı. 
Dialogue: 0,0:09:58.69,0:10:01.16,Default,,0,0,0,,Kaptanımızın emirlerine sonuna kadar uymalıyız.
Dialogue: 0,0:10:01.16,0:10:03.20,Default,,0,0,0,,Ishizaki...
Dialogue: 0,0:10:08.24,0:10:10.46,Default,,0,0,0,,Sana güveniyorum Kaptan Tsubasa.
Dialogue: 0,0:10:11.02,0:10:12.59,Default,,0,0,0,,Ishizaki-kun...
Dialogue: 0,0:10:15.09,0:10:17.74,Default,,0,0,0,,Pekala, biz de kaptanımızı takip etmeliyiz.
Dialogue: 0,0:10:17.74,0:10:18.71,Default,,0,0,0,,Evet.
Dialogue: 0,0:10:21.09,0:10:25.58,Default - i,,0,0,0,,Ortaokuldan mezun olduğunda Tsubasa Brezilya'ya gidiyor.
Dialogue: 0,0:10:25.58,0:10:31.11,Default - i,,0,0,0,,Ancak, bugünkü maçı kaybetsek bile, \Nortaokul futbol hayatımdan pişman değilim. 
Dialogue: 0,0:10:31.76,0:10:36.86,Default - i,,0,0,0,,Çünkü bunca zamandır seninle futbol oynuyordum Tsubasa.
Dialogue: 0,0:10:41.74,0:10:47.00,Default-TOP,,0,0,0,,KESİN ZAFER
Dialogue: 0,0:10:42.70,0:10:44.24,Default - i,,0,0,0,,Teşekkür ederim millet.
Dialogue: 0,0:10:44.24,0:10:47.00,Default - i,,0,0,0,,Bu son şansta her şeye bahse gireceğim.
Dialogue: 0,0:10:47.00,0:10:51.50,Default - i,,0,0,0,,Normalde, önde durup, bu küçük\N zaman diliminde bile olsa bize bakacaktı.
Dialogue: 0,0:10:52.16,0:10:55.00,Default - i,,0,0,0,,Alevin çoktan öldü mü, Tsubasa?
Dialogue: 0,0:10:55.67,0:10:56.92,Default - i,,0,0,0,,Oyun devam ediyor.
Dialogue: 0,0:10:57.46,0:10:58.88,Default - i,,0,0,0,,Top Tsubasa-kun'a gönderiliyor.
Dialogue: 0,0:10:58.88,0:11:00.24,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:11:01.01,0:11:03.39,Default,,0,0,0,,Tsubasa, hala bu maça asılıyor musun...?
Dialogue: 0,0:11:03.39,0:11:06.77,Default - i,,0,0,0,,Tsubasa şut çekmek için pozisyon alıyor.
Dialogue: 0,0:11:07.93,0:11:11.89,Default - i,,0,0,0,,Omzum, bacağım; kırılırsa kırılsın!
Dialogue: 0,0:11:11.89,0:11:13.48,Default - i,,0,0,0,,{\ i1} Ama... şut çekeceğim!
Dialogue: 0,0:11:15.48,0:11:17.40,Default,,0,0,0,,Benim Drive Shot'um...
Dialogue: 0,0:11:15.48,0:11:17.40,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:11:18.15,0:11:21.91,Default,,0,0,0,,Kanatlarını geniş gökyüzüne yay!
Dialogue: 0,0:11:23.49,0:11:26.81,Default - i,,0,0,0,,Tsubasa-kun çok uzak mesafeden şut çekti.
Dialogue: 0,0:11:26.81,0:11:29.94,Default - i,,0,0,0,,Matsuyama-kun zıpladı, ama engelleyemedi!
Dialogue: 0,0:11:31.00,0:11:33.40,Default - i,,0,0,0,,Anka kuşu uçuyor! 
Dialogue: 0,0:11:37.34,0:11:42.01,Default - i,,0,0,0,,Top keskin bir çizgi izliyor ve Furano'nun kalesine doğru yoluna devam ediyor.
Dialogue: 0,0:11:44.27,0:11:46.51,Default - i,,0,0,0,,Nankatsu gol atamadı!
Dialogue: 0,0:11:46.51,0:11:48.02,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:11:48.02,0:11:51.73,Default - i,,0,0,0,,Drive Shot, gol olmada yetersiz kaldı!
Dialogue: 0,0:11:48.02,0:11:51.73,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:11:54.98,0:11:56.48,Default,,0,0,0,,Bu...
Dialogue: 0,0:11:58.90,0:11:59.44,Default,,0,0,0,,Nasıl?!
Dialogue: 0,0:12:00.28,0:12:05.53,Default - i,,0,0,0,,Top yere çarptı, sekti ve kaleyi delip geçti!
Dialogue: 0,0:12:06.00,0:12:08.54,Default - i,,0,0,0,,Topun dönüşü delice!
Dialogue: 0,0:12:13.99,0:12:15.34,Default,,0,0,0,,İçerde.
Dialogue: 0,0:12:18.30,0:12:23.30,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:12:25.82,0:12:28.97,Default - i,,0,0,0,,3-2! Ne şok edici bir final!
Dialogue: 0,0:12:28.97,0:12:31.93,Default - i,,0,0,0,,Tsubasa'nın Drive Shot'u anka kuşu gibi uçtu!
Dialogue: 0,0:12:28.97,0:12:31.93,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:12:31.93,0:12:35.59,Default - i,,0,0,0,,En en son dakikaya kadar ölmeyi reddetti!
Dialogue: 0,0:12:35.59,0:12:38.24,Default - i,,0,0,0,,Nankatsu yarınki final maçında yerlerini kazanıyor!
Dialogue: 0,0:12:38.24,0:12:39.94,Default,,0,0,0,,Tsubasa senpai çok havalı! 
Dialogue: 0,0:12:39.94,0:12:41.19,Default,,0,0,0,,Başardık!
Dialogue: 0,0:12:41.19,0:12:42.03,Default,,0,0,0,,Kazandık!
Dialogue: 0,0:12:42.03,0:12:43.82,Default,,0,0,0,,Kazandık, Tsubasa!
Dialogue: 0,0:12:43.82,0:12:46.34,Default - i,,0,0,0,,Mucizeler ortaya çıkaran adam! 
Dialogue: 0,0:12:46.34,0:12:48.84,Default - i,,0,0,0,,Başlangıç düdüğünden sonraki beş saniye içinde,
Dialogue: 0,0:12:48.84,0:12:51.64,Default - i,,0,0,0,,Tsubasa'nın Drive Shot'u onları Furano'dan uzaklaştırdı,
Dialogue: 0,0:12:48.84,0:12:51.64,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:12:51.64,0:12:55.82,Default - i,,0,0,0,,ve finallerde üçüncü kez üst üste yer almayı başardılar!
Dialogue: 0,0:12:55.82,0:12:57.90,Default,,0,0,0,,Ka...Kazandık!
Dialogue: 0,0:12:58.63,0:12:59.54,Default,,0,0,0,,Ah!
Dialogue: 0,0:12:59.54,0:13:00.30,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:02.72,0:13:04.64,Default,,0,0,0,,Neyin var Tsubasa?
Dialogue: 0,0:13:04.64,0:13:07.11,Default,,0,0,0,,Bir galip'in yere düşmesine izin vermeyiz.
Dialogue: 0,0:13:07.11,0:13:08.43,Default,,0,0,0,,Matsuyama-kun...
Dialogue: 0,0:13:08.43,0:13:10.16,Default,,0,0,0,,Gerçekten de, Tsubasa...
Dialogue: 0,0:13:10.16,0:13:14.38,Default,,0,0,0,,Gerçekten sonuna kadar bir \Nsavaştan vazgeçmeyecek bir adamsın.
Dialogue: 0,0:13:14.38,0:13:17.19,Default,,0,0,0,,Bu son Drive Shot bunun kanıtıydı.
Dialogue: 0,0:13:14.38,0:13:17.19,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:13:17.19,0:13:21.48,Default,,0,0,0,,Kaleye geldikten sonra bile ölmedi ve kaleye sıçradı.
Dialogue: 0,0:13:21.48,0:13:23.95,Default,,0,0,0,,Aynen senin gibi.
Dialogue: 0,0:13:25.82,0:13:27.79,Default,,0,0,0,,Şimdi kendine gel.
Dialogue: 0,0:13:27.79,0:13:31.37,Default,,0,0,0,,Yarın hala final maçın var.
Dialogue: 0,0:13:31.37,0:13:33.62,Default,,0,0,0,,Teşekkürler, Matsuyama-kun.
Dialogue: 0,0:13:36.18,0:13:37.36,Default,,0,0,0,,Kaybettik...
Dialogue: 0,0:13:37.36,0:13:39.83,Default,,0,0,0,,Son saniyede kaybettik!
Dialogue: 0,0:13:39.83,0:13:41.13,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:13:41.13,0:13:42.40,Default - i,,0,0,0,,Millet...
Dialogue: 0,0:13:43.29,0:13:44.56,Default,,0,0,0,,Ayağa kalkın millet.
Dialogue: 0,0:13:44.56,0:13:48.26,Default,,0,0,0,,Bizimle birlikte olan stantlardaki\N insanlara son bir kez teşekkür edeceğiz.
Dialogue: 0,0:13:49.08,0:13:50.22,Default,,0,0,0,,Kaptan.
Dialogue: 0,0:13:50.22,0:13:54.22,Default - i,,0,0,0,,Furano'nun çetin mücadele eden ancak sonunda\N kaybeden oyuncuları, hayranlarını selamlayacaklar.
Dialogue: 0,0:13:54.98,0:13:59.48,Default - i,,0,0,0,,Karlı topraklardan savaşçıları canlandırarak bugüne dek gerçekten çok iyi savaştınız.
Dialogue: 0,0:13:59.48,0:14:00.97,Default,,0,0,0,,Millet...
Dialogue: 0,0:14:00.97,0:14:02.32,Default,,0,0,0,,Matsuyama-kun...
Dialogue: 0,0:14:02.32,0:14:04.42,Default,,0,0,0,,Millet, sıraya girin. 
Dialogue: 0,0:14:05.49,0:14:08.07,Default,,0,0,0,,Desteğiniz için çok teşekkür ederiz!
Dialogue: 0,0:14:08.07,0:14:09.83,Default,,0,0,0,,İyi iş çıkardın, Furano!
Dialogue: 0,0:14:09.83,0:14:13.81,Default,,0,0,0,,Yenilmiş olsanız bile, takım çalışmanız Japonya'da en iyisi.
Dialogue: 0,0:14:16.17,0:14:21.59,Default - i,,0,0,0,,Hikaru Matsuyama, kaybına rağmen, adam gibi adamsın!
Dialogue: 0,0:14:22.53,0:14:25.81,Default - i,,0,0,0,,Futbolumuz artık bitti. 
Dialogue: 0,0:14:27.84,0:14:30.71,Default,,0,0,0,,Yoshiko, artık ağlama.
Dialogue: 0,0:14:30.71,0:14:31.99,Default,,0,0,0,,Yoshiko.
Dialogue: 0,0:14:31.99,0:14:33.26,Default,,0,0,0,,Anne.
Dialogue: 0,0:14:33.26,0:14:35.52,Default,,0,0,0,,Başarısızdı, değil mi?
Dialogue: 0,0:14:35.52,0:14:37.52,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:38.24,0:14:39.23,Default,,0,0,0,,Oh!
Dialogue: 0,0:14:41.95,0:14:43.90,Default,,0,0,0,,Matsuyama-kun'nun saç bandı.
Dialogue: 0,0:14:44.84,0:14:46.40,Default,,0,0,0,,Hey, Matsuyama!
Dialogue: 0,0:14:46.40,0:14:48.38,Default,,0,0,0,,Bir şey unuttun.
Dialogue: 0,0:14:48.38,0:14:49.61,Default,,0,0,0,,Ah, teşekkürler.
Dialogue: 0,0:14:50.21,0:14:51.63,Default,,0,0,0,,Minnettarım.
Dialogue: 0,0:14:51.63,0:14:54.28,Default,,0,0,0,,Elinden geleni yap ve yarın Tsubasa'ya yardım et.
Dialogue: 0,0:14:54.28,0:14:55.47,Default,,0,0,0,,Tabii!
Dialogue: 0,0:14:56.79,0:15:01.41,Default,,0,0,0,,Final, Nankatsu ve Toho arasında, tahmin ettiğimiz gibi yapılacak.
Dialogue: 0,0:15:01.41,0:15:02.50,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:03.72,0:15:05.75,Default,,0,0,0,,Tsubasa'nın Drive Shot'u...
Dialogue: 0,0:15:03.72,0:15:05.75,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:15:05.75,0:15:11.14,Default,,0,0,0,,Onun ve Genzo arasındaki savaşı mümkün olan en kısa zamanda Avrupa turunda görmek istiyorum.
Dialogue: 0,0:15:11.14,0:15:14.45,Default,,0,0,0,,Her halükarda seni hastaneme götürmeliyiz.
Dialogue: 0,0:15:14.45,0:15:16.45,Default,,0,0,0,,Arabayı hazırlamanı istiyorum.
Dialogue: 0,0:15:16.45,0:15:17.52,Default,,0,0,0,,Evet tabi.
Dialogue: 0,0:15:17.52,0:15:18.90,Default,,0,0,0,,Tanrım.
Dialogue: 0,0:15:18.90,0:15:21.02,Default,,0,0,0,,Seni uyarmama rağmen yine de çok ileri gittin.
Dialogue: 0,0:15:21.02,0:15:25.49,Default,,0,0,0,,O kadar ileri gitmeseydim kazanamazdım.
Dialogue: 0,0:15:25.49,0:15:27.28,Default,,0,0,0,,Kazanmak istedim.
Dialogue: 0,0:15:27.28,0:15:29.15,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:15:29.15,0:15:31.79,Default,,0,0,0,,Ama senin sayende sensei.
Dialogue: 0,0:15:31.79,0:15:36.16,Default,,0,0,0,,Tedaviniz ve buraya yazdığınız kelimeler sayesinde.
Dialogue: 0,0:15:36.16,0:15:38.46,Default,,0,0,0,,Bu kelimeleri siz mi yazdın sensei?
Dialogue: 0,0:15:38.46,0:15:39.61,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:39.61,0:15:43.35,Default,,0,0,0,,El yazımın gerçekten kötü olduğunu \Nsöyledim ama yine de yapmamı istedi. 
Dialogue: 0,0:15:44.54,0:15:45.79,Default,,0,0,0,,FURANO ORTAOKULU \NHOKKAİDO
Dialogue: 0,0:15:47.21,0:15:50.21,Default - i,,0,0,0,,Menejerimizin kafa bandı çaba sarfetti ve işledi...
Dialogue: 0,0:15:50.91,0:15:54.22,Default - i,,0,0,0,,Üzgünüm, kazanamadım.
Dialogue: 0,0:15:59.91,0:16:01.48,Default - i,,0,0,0,,{\i1}Bu...{\i0}
Dialogue: 0,0:16:02.34,0:16:04.30,Default - i,,0,0,0,,Bu yazıyı buraya dikmiş ve çok küçük...
Dialogue: 0,0:16:04.30,0:16:08.23,Default - i,,0,0,0,,Ve beyaz bir iplikle işlediğinden göze çarpmayacağından bile emindi...
Dialogue: 0,0:16:09.08,0:16:10.57,Default,,0,0,0,,Geçmeme izin verin!
Dialogue: 0,0:16:11.03,0:16:12.07,Default,,0,0,0,,Fujisawa!
Dialogue: 0,0:16:12.81,0:16:19.66,Default - i,,0,0,0,,Fujisawa Yoshiko-san, babasının çalışması \Nnedeniyle ikinci dönemde ABD'ye taşınacak. 
Dialogue: 0,0:16:23.59,0:16:25.17,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:16:25.17,0:16:26.38,Default,,0,0,0,,Machida!
Dialogue: 0,0:16:26.38,0:16:27.45,Default,,0,0,0,,Fujisawa nereye gitti?
Dialogue: 0,0:16:27.45,0:16:29.76,Default,,0,0,0,,Annesiyle gitti; taksiye biniyor. 
Dialogue: 0,0:16:29.76,0:16:30.52,Default,,0,0,0,,Ne–
Dialogue: 0,0:16:30.52,0:16:33.76,Default,,0,0,0,,Yoshiko bugün ABD'ye gidiyor. 
Dialogue: 0,0:16:33.76,0:16:35.03,Default,,0,0,0,,Peki arabaları nerede?!
Dialogue: 0,0:16:35.03,0:16:38.22,Default,,0,0,0,,Matsuyama-kun, Yoshiko'nun hisleri vardı...
Dialogue: 0,0:16:38.22,0:16:41.06,Default - i,,0,0,0,,Sorun nedir? Bana ihtiyacın mı var?
Dialogue: 0,0:16:41.06,0:16:43.31,Default - i,,0,0,0,,E-Elinizden geleni yapın ve bugün de kazanın!
Dialogue: 0,0:16:43.31,0:16:45.63,Default - i,,0,0,0,,Menejer olmak zor olmalı.
Dialogue: 0,0:16:47.00,0:16:48.96,Default - i,,0,0,0,,Lütfen bunun bir kopyasını al. 
Dialogue: 0,0:16:48.96,0:16:50.27,Default - i,,0,0,0,,Tamam.
Dialogue: 0,0:16:50.27,0:16:51.88,Default - i,,0,0,0,,Hadi ama birinci sınıf öğrencisi!
Dialogue: 0,0:16:51.88,0:16:54.66,Default - i,,0,0,0,,Menejerimizin tüm topları kendi\N kendine parlatmasına izin verme. 
Dialogue: 0,0:16:55.55,0:16:57.05,Default - i,,0,0,0,,İşte, bir havlu.
Dialogue: 0,0:16:57.05,0:16:58.58,Default - i,,0,0,0,,Furano, savaş!
Dialogue: 0,0:16:59.04,0:17:00.58,Default,,0,0,0,,Fujisawa...
Dialogue: 0,0:17:05.54,0:17:06.96,Default,,0,0,0,,Bu araba mı?
Dialogue: 0,0:17:06.96,0:17:09.96,Default,,0,0,0,,Yoshiko, artık gözyaşlarını sil.
Dialogue: 0,0:17:13.89,0:17:15.09,Default,,0,0,0,,Fujisawa!
Dialogue: 0,0:17:27.45,0:17:28.68,Default,,0,0,0,,Fujisawa...
Dialogue: 0,0:17:31.73,0:17:33.05,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:17:33.05,0:17:35.09,Default,,0,0,0,,Fujisawa çoktan ayrıldı.
Dialogue: 0,0:17:35.09,0:17:35.96,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:35.96,0:17:37.74,Default,,0,0,0,,Herkese selamlarını gönderdi.
Dialogue: 0,0:17:37.74,0:17:42.07,Default,,0,0,0,,Eğer kazanmış olsaydık, bir gün daha Japonya'da kalırdı...
Dialogue: 0,0:17:42.07,0:17:44.50,Default,,0,0,0,,Yani, Kaptan Fujisawa'yı görmeye mi gitti?
Dialogue: 0,0:17:44.50,0:17:48.83,Default,,0,0,0,,Taksinin arkasından gitti, ancak \Nzamanında yetişmesine imkân yok.
Dialogue: 0,0:17:48.83,0:17:50.25,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:17:50.25,0:17:53.52,Default,,0,0,0,,Aslında, Yoshiko'nun Matsuyama-kun'a karşı her zaman duyguları vardı...
Dialogue: 0,0:17:53.52,0:17:54.82,Default,,0,0,0,,Şaşırmadım.
Dialogue: 0,0:17:55.30,0:17:58.64,Default,,0,0,0,,Aslında her zaman böyle olduğunu varsaydık.
Dialogue: 0,0:17:58.64,0:18:00.80,Default,,0,0,0,,Sadece onu izleyerek söyleyebilirsin.
Dialogue: 0,0:18:00.80,0:18:04.81,Default,,0,0,0,,Ancak kaptanımız, böyle şeyler söz\N konusu olduğunda oldukça kalın kafalı.
Dialogue: 0,0:18:04.81,0:18:09.65,Default,,0,0,0,,Öyleyse bir saniye bekleyin... Kaptan \Nneden şu anda Fujisawa'nın peşinden gitti?
Dialogue: 0,0:18:07.92,0:18:10.69,Default-TOP,,0,0,0,,Ç.N: Ne zaman elbiselerini değiştirdi?!
Dialogue: 0,0:18:09.65,0:18:10.69,Default,,0,0,0,,Şimdi söyledinde...
Dialogue: 0,0:18:10.69,0:18:13.32,Default,,0,0,0,,Başaramazsa faydası olmaz.
Dialogue: 0,0:18:13.32,0:18:16.78,Default,,0,0,0,,Bu yüzden Yoshiko duygularını itiraf etmeden ayrılacak.
Dialogue: 0,0:18:30.83,0:18:32.09,Default,,0,0,0,,Fujisawa!
Dialogue: 0,0:18:32.09,0:18:33.67,Default,,0,0,0,,Matsuyama-kun.
Dialogue: 0,0:18:40.39,0:18:42.68,Default,,0,0,0,,Görünüşe göre yetiştim.
Dialogue: 0,0:18:42.68,0:18:44.35,Default,,0,0,0,,Nasıl?
Dialogue: 0,0:18:44.35,0:18:49.06,Default,,0,0,0,,Taksinin gitmesinden sonra Futbol \NFederasyonu'ndan bir adam beni bıraktı.
Dialogue: 0,0:18:49.06,0:18:52.15,Default,,0,0,0,,Ondan da olabildiğince hızlı sürmesini istedim.
Dialogue: 0,0:18:52.15,0:18:55.82,Default,,0,0,0,,Zamanında yakalamayı unut, yetiştik ve sizi bile geçtik!
Dialogue: 0,0:18:55.82,0:18:57.90,Default,,0,0,0,,Ah, Matsuyama-kun! Yaralanmışsın!
Dialogue: 0,0:18:57.90,0:18:59.07,Default,,0,0,0,,Hah?
Dialogue: 0,0:19:01.53,0:19:03.04,Default,,0,0,0,,Ah, sorun değil, gerçekten.
Dialogue: 0,0:19:03.04,0:19:04.31,Default,,0,0,0,,Ama, mendilin... 
Dialogue: 0,0:19:04.31,0:19:06.83,Default,,0,0,0,,Hayır! Çok fazla kanıyor...
Dialogue: 0,0:19:07.84,0:19:12.21,Default,,0,0,0,,Yaralarımı böyle tedavi ettiğin son zaman olacak.
Dialogue: 0,0:19:12.21,0:19:17.21,Default,,0,0,0,,Her zaman pervasızca oynuyorsun, \Nbu yüzden çok inciniyorsun, Matsuyama-kun.
Dialogue: 0,0:19:18.54,0:19:20.95,Default,,0,0,0,,"Cesurca" demeni tercih ederdim.
Dialogue: 0,0:19:20.95,0:19:23.76,Default,,0,0,0,,İşte, biraz elinle bastır.
Dialogue: 0,0:19:23.76,0:19:25.47,Default,,0,0,0,,Teşekkürler, Menejer.
Dialogue: 0,0:19:28.27,0:19:30.02,Default,,0,0,0,,Sorun nedir?
Dialogue: 0,0:19:30.69,0:19:35.02,Default,,0,0,0,,Çünkü bir anda burada ortaya çıktın.
Dialogue: 0,0:19:35.02,0:19:36.20,Default,,0,0,0,,Bu ne demek oluyor...?
Dialogue: 0,0:19:36.20,0:19:37.76,Default,,0,0,0,,Bu senin hatan.
Dialogue: 0,0:19:37.76,0:19:40.62,Default,,0,0,0,,Sana bağırdım, "Fujisawa!" taksinin ardından koştum,
Dialogue: 0,0:19:40.62,0:19:43.16,Default,,0,0,0,,ama fark etmedin ve sadece uzaklara gittin...
Dialogue: 0,0:19:43.16,0:19:45.91,Default,,0,0,0,,O zaman da dizimi incittim. 
Dialogue: 0,0:19:45.91,0:19:46.88,Default,,0,0,0,,Hey...
Dialogue: 0,0:19:46.88,0:19:47.91,Default,,0,0,0,,Ağlama.
Dialogue: 0,0:19:47.91,0:19:49.29,Default,,0,0,0,,Ama...
Dialogue: 0,0:19:49.29,0:19:51.04,Default,,0,0,0,,Ağlamamanı söylüyorum.
Dialogue: 0,0:19:51.04,0:19:55.65,Default,,0,0,0,,Gözyaşlarını bile silemezsin, mendilin dizimde.
Dialogue: 0,0:19:55.65,0:19:56.59,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:20:01.28,0:20:03.30,Default,,0,0,0,,Kendine iyi bak. Geri döndüğünden emin ol.
Dialogue: 0,0:20:03.30,0:20:04.09,Default,,0,0,0,,Tamam.
Dialogue: 0,0:20:04.71,0:20:06.79,Default,,0,0,0,,Oraya gittiğinde bana e-posta gönder.
Dialogue: 0,0:20:06.79,0:20:08.77,Default,,0,0,0,,Cevap verdiğime emin olacağım.
Dialogue: 0,0:20:08.77,0:20:09.52,Default,,0,0,0,,Tamam.
Dialogue: 0,0:20:10.27,0:20:16.60,Default,,0,0,0,,Ayrıca, bu kafa bandını senden bir hatıra olarak saklayacağım.
Dialogue: 0,0:20:16.60,0:20:17.74,Default,,0,0,0,,Teşekkürler.
Dialogue: 0,0:20:18.36,0:20:19.19,Default,,0,0,0,,Tamam
Dialogue: 0,0:20:27.33,0:20:28.98,Default,,0,0,0,,Kaptan kesinlikle zamanını alıyor...
Dialogue: 0,0:20:28.98,0:20:30.29,Default,,0,0,0,,Ne kadar ileri gittiğini merak ediyorum.
Dialogue: 0,0:20:30.29,0:20:32.80,Default,,0,0,0,,Onları havaalanına kadar kovaladığını söyleme?!
Dialogue: 0,0:20:32.80,0:20:33.83,Default,,0,0,0,,Evet, doğru.
Dialogue: 0,0:20:33.83,0:20:36.15,Default,,0,0,0,,Üzerinde o kadar para yok, biliyorsun!
Dialogue: 0,0:20:36.15,0:20:37.20,Default,,0,0,0,,Koç, efendim.
Dialogue: 0,0:20:37.20,0:20:39.59,Default,,0,0,0,,Genç efendim Matsuyama-sama'dan telefon var.
Dialogue: 0,0:20:39.59,0:20:40.04,Default,,0,0,0,,Hah?
Dialogue: 0,0:20:40.04,0:20:41.30,Default,,0,0,0,,Matsuyama mı dedin?
Dialogue: 0,0:20:42.09,0:20:43.30,Default,,0,0,0,,Çok özür dilerim koç.
Dialogue: 0,0:20:43.71,0:20:46.05,Default,,0,0,0,,Narita Havaalanından dönüş yolundayım.
Dialogue: 0,0:20:46.05,0:20:47.05,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:47.05,0:20:51.33,Default,,0,0,0,,Doğrudan konaklama evine\N bırakılacağım, o yüzden lütfen endişelenme.
Dialogue: 0,0:20:51.33,0:20:52.93,Default,,0,0,0,,Tamam, anladım.
Dialogue: 0,0:20:53.56,0:20:56.56,Default,,0,0,0,,Aferin sana, Yoshiko?
Dialogue: 0,0:20:58.61,0:21:01.96,Default - i,,0,0,0,,Beklediğim gibi, finaller Nankatsu ve Toho arasında olacak.
Dialogue: 0,0:21:01.96,0:21:04.82,Default - i,,0,0,0,,Sonunda, Kojiro Hyuga karşısına Tsubasa Ozora geldi.
Dialogue: 0,0:21:05.48,0:21:07.84,Default - i,,0,0,0,,Ancak, Hyuga'nın durumu beni rahatsız ediyor.
Dialogue: 0,0:21:07.84,0:21:10.33,Default - i,,0,0,0,,Yarınki finalde oynayacak mı?
Dialogue: 0,0:21:10.99,0:21:14.64,Default - i,,0,0,0,,Dürüst olmak gerekirse, Hyuga'nın\N ortaokula girdikten sonraki gelişmesi, 
Dialogue: 0,0:21:14.64,0:21:17.50,Default - i,,0,0,0,,herkesin beklentilerine göre oldukça düşüktü.
Dialogue: 0,0:21:18.13,0:21:23.05,Default - i,,0,0,0,,İlkokul turnuvasında kararsız mücadele ruhu dışında başka hiçbir şey olmayan çocuk,
Dialogue: 0,0:21:23.05,0:21:27.51,Default - i,,0,0,0,,Nankatsu'nun Tsubasa, Misaki ve Wakabayashi ile tek başına mücadele etti... Kojiro Hyuga.
Dialogue: 0,0:21:28.45,0:21:34.94,Default - i,,0,0,0,,Toho Akademi'ye gittikten sonra, aç bir canavarı anımsatan futbol tarzı, ortadan kayboldu.
Dialogue: 0,0:21:34.94,0:21:39.07,Default - i,,0,0,0,,Kalbimin derinliklerinden, Vahşi Kaplanın dönüşünü diliyorum,
Dialogue: 0,0:21:39.07,0:21:40.94,Default - i,,0,0,0,,Japonya futbolu adına.
Dialogue: 0,0:21:41.39,0:21:43.68,Default - i,,0,0,0,,Tsubasa Brezilya’ya gittikten sonra, 
Dialogue: 0,0:21:43.68,0:21:47.20,Default - i,,0,0,0,,Japonya futbolunu bırakabileceğimiz tek kişi 
Dialogue: 0,0:21:47.20,0:21:49.70,Default - i,,0,0,0,,sensin, Hyuga.
Dialogue: 0,0:22:08.76,0:22:12.27,Default,,0,0,0,,Ah, koç, bu sabah bir mektup geldi.
Dialogue: 0,0:22:12.27,0:22:13.60,Default,,0,0,0,,Ah, teşekkürler.
Dialogue: 0,0:22:16.31,0:22:19.31,Default,,0,0,0,,KOZO KİRA
Dialogue: 0,0:22:19.33,0:22:34.83,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:48.82,0:23:58.36,Default,,0,0,0,,46. BÖLÜM: YÜZYILIN BAŞLANGICI
Dialogue: 0,0:23:48.82,0:23:59.00,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:00:55.83,0:00:58.54,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:59.46,0:01:02.13,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:03.04,0:01:05.75,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:12.64,0:01:15.47,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:15.47,0:01:21.73,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:01:21.73,0:01:27.61,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta no ni
Dialogue: 0,0:01:27.61,0:01:34.20,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:01:34.20,0:01:38.20,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:38.20,0:01:42.71,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:42.71,0:01:48.30,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:01:48.30,0:01:49.84,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:01:49.84,0:01:51.05,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:51.05,0:01:54.55,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:01:54.55,0:02:04.44,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:02:04.44,0:02:05.27,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:05.27,0:02:09.07,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:02:09.07,0:02:13.07,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:02:13.07,0:02:19.33,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:02:19.33,0:02:22.16,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:00:55.83,0:00:58.54,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:59.46,0:01:02.13,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:03.04,0:01:05.75,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:12.64,0:01:15.47,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:01:15.47,0:01:21.73,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:01:21.73,0:01:27.61,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:27.61,0:01:34.20,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:34.20,0:01:38.20,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:38.20,0:01:42.71,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:01:42.71,0:01:48.30,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:01:48.30,0:01:49.84,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:01:49.84,0:01:51.05,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:51.05,0:01:54.55,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:01:54.55,0:02:04.44,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:02:04.44,0:02:05.27,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:05.27,0:02:09.07,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:02:09.07,0:02:13.07,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:02:13.07,0:02:19.33,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:19.33,0:02:22.16,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.05,0:22:44.10,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.10,0:22:50.10,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.10,0:22:56.15,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.15,0:23:00.78,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.41,0:23:07.08,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.41,0:23:14.50,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.50,0:23:20.55,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:20.55,0:23:25.01,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.30,0:23:32.64,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:32.64,0:23:38.69,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:38.69,0:23:44.99,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.05,0:22:44.10,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.10,0:22:50.10,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.10,0:22:56.15,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.15,0:23:00.78,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.41,0:23:07.08,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.41,0:23:14.50,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.50,0:23:20.55,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:20.55,0:23:25.01,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.30,0:23:32.64,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:32.64,0:23:38.69,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:38.69,0:23:44.99,OPED,,0,0,0,,Bu hırslı gençlik sahada!
