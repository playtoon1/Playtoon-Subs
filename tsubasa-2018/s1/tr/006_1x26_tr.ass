Dialogue: 0,0:15:23.99,0:15:26.11,Default,,0,0,0,,O turnuva uzasa...
Dialogue: 0,0:15:26.11,0:15:29.53,Default,,0,0,0,,...eminim Nankatsu kazanırdı.
Dialogue: 0,0:15:29.53,0:15:31.42,Default,,0,0,0,,Ne içtin be Ishizaki?{shitting}
Dialogue: 0,0:15:31.42,0:15:35.20,Default,,0,0,0,,Bacağını incittikten sonra\Nsen oynayamazsın bile.
Dialogue: 0,0:15:35.20,0:15:36.96,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:15:36.96,0:15:41.62,Default,,0,0,0,,O maçta Kishida ile ben, Ishizaki'nin\Nyerine girmek için kavga etmiştik.
Dialogue: 0,0:15:41.62,0:15:44.46,Default,,0,0,0,,En son Misaki ortaya çıkmıştı ama.
Dialogue: 0,0:15:44.46,0:15:48.21,Default,,0,0,0,,Tsubasa ve Misaki'nin\Naltın ikilisi o zaman oluştu.{here is your recap!}
Dialogue: 0,0:15:48.21,0:15:51.68,Default,,0,0,0,,Çocuklar, sadece 10 dakika daha\Nelinizden geleni yapmalısınız.
Dialogue: 0,0:15:51.68,0:15:54.47,Default,,0,0,0,,Bu kez de beraberlik olursa\Niki takım da şampiyon olacak.
Dialogue: 0,0:15:54.47,0:15:57.14,Default,,0,0,0,,Bunu kabul edemeyiz Koç.
Dialogue: 0,0:15:57.14,0:15:58.18,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:15:58.18,0:16:01.15,Default,,0,0,0,,İlk yarıda Meiwa'ya kaybettik.
Dialogue: 0,0:16:01.15,0:16:03.69,Default,,0,0,0,,Bu yüzden bu maçı\Nkazanmaktan başka çaremiz yok!
Dialogue: 0,0:16:03.69,0:16:06.69,Default,,0,0,0,,Yoksa kendimize şampiyon diyemeyiz!
Dialogue: 0,0:16:12.86,0:16:14.20,Default,,0,0,0,,Atak yapmaktan başka çaremiz yok.{no shit sherlock}
Dialogue: 0,0:16:14.20,0:16:15.70,Default,,0,0,0,,Ne?
Dialogue: 0,0:16:15.70,0:16:19.19,Default,,0,0,0,,Meiwa'nın futbolu kazanmaya dayanır.
Dialogue: 0,0:16:19.19,0:16:21.34,Default,,0,0,0,,Beraberliği hedeflemeyiz.
Dialogue: 0,0:16:21.34,0:16:23.74,Default,,0,0,0,,Bu yüzden tek seçenek bu.
Dialogue: 0,0:16:23.74,0:16:25.33,Default,,0,0,0,,Değil mi Koç?
Dialogue: 0,0:16:25.33,0:16:28.92,Default,,0,0,0,,Evet. Şampiyon olmanın\Nanlamı bellidir.
Dialogue: 0,0:16:28.92,0:16:32.59,Default,,0,0,0,,Ne olursa olsun Meiwa bunu almalı!
Dialogue: 0,0:16:32.59,0:16:38.16,Default,,0,0,0,,Az önceki yağmuru, herkes dinlensin\Ndiye futbol tanrısı yağdırmış olmalı.{lol} {baito no kamisama beats him!!}
Dialogue: 0,0:16:38.16,0:16:40.39,Default,,0,0,0,,Ben de öyle düşünüyorum.
Dialogue: 0,0:16:41.22,0:16:42.68,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:16:42.68,0:16:49.15,Default,,0,0,0,,Oynamaya devam edersem\Nherkese yük olacak gibi hissediyorum.
Dialogue: 0,0:16:49.15,0:16:52.12,Default,,0,0,0,,Bacağın çok mu acıyor?{it's die-joubu}
Dialogue: 0,0:16:52.12,0:16:54.22,Default,,0,0,0,,Bacağımın ağrısı iyi.
Dialogue: 0,0:16:54.22,0:16:57.41,Default,,0,0,0,,Bacağım kırılsa bu yarıda oynarım.
Dialogue: 0,0:16:57.41,0:17:00.33,Default,,0,0,0,,Ama şu anki oynama\Ntarzımla herkese...
Dialogue: 0,0:17:00.33,0:17:01.91,Default,,0,0,0,,Ne diyorsun?
Dialogue: 0,0:17:01.91,0:17:07.50,Default,,0,0,0,,Sen olmasan az önce Wakashimazu-kun\Nkarşısında ayağıma top almam imkansızdı!
Dialogue: 0,0:17:07.50,0:17:08.38,Default,,0,0,0,,Ama...
Dialogue: 0,0:17:08.38,0:17:15.93,Default,,0,0,0,,Aynen öyle. Wakashimazu'ya karşı Nankatsu'nun\Naltın ikilisi Tsubasa ve Misaki'den başkası gol atamaz.
Dialogue: 0,0:17:15.93,0:17:17.80,Default,,0,0,0,,Bunun için bir şey düşündüm.
Dialogue: 0,0:17:17.80,0:17:20.07,Default,,0,0,0,,İlk yarıda rakibin atak yapmasına izin vereceğiz.
Dialogue: 0,0:17:20.07,0:17:20.85,Default,,0,0,0,,Ne?
Dialogue: 0,0:17:20.85,0:17:23.42,Default,,0,0,0,,İkinizin dinlenmesini istiyorum.
Dialogue: 0,0:17:23.42,0:17:24.86,Default,,0,0,0,,Wakabayashi-kun...
Dialogue: 0,0:17:24.86,0:17:27.73,Default,,0,0,0,,Bu sırada kalan herkes\Ndefans yapacak.
Dialogue: 0,0:17:27.73,0:17:31.73,Default,,0,0,0,,Ne olursa olsun bu yarı\NMeiwa'nın gol atmasını engelleyeceğiz.
Dialogue: 0,0:17:31.73,0:17:34.61,Default,,0,0,0,,Ve ikinci yarıyı Tsubasa ve\NMisaki'ye bırakacağız.
Dialogue: 0,0:17:34.61,0:17:38.49,Default,,0,0,0,,Tamamdır! Meiwa'yı yenmek için\Nbundan başka bir plan düşünemiyorum!
Dialogue: 0,0:17:39.17,0:17:40.78,Default,,0,0,0,,Yapalım şunu Misaki-kun.
Dialogue: 0,0:17:40.78,0:17:43.41,Default,,0,0,0,,Tamam. Son gücümü kullanacağım.
Dialogue: 0,0:17:45.37,0:17:48.87,Default,,0,0,0,,{\i1}Maçın gerçek finaline 10 dakika kaldı.{\i0}
