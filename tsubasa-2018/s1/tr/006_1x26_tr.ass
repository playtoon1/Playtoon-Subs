Dialogue: 0,0:00:00.56,0:00:03.48,Default,,0,0,0,,{\i1}Şu an sıcaklık 35 derece.{\i0}
Dialogue: 0,0:00:03.48,0:00:07.06,Default,,0,0,0,,{\i1}Oyuncular bu terletici\Nsıcaklıkta büyük bir mücadele veriyor.{\i0}
Dialogue: 0,0:00:08.27,0:00:13.07,Default,,0,0,0,,{\i1}Yaralı olduğun için buradan\Nbir şut bile yeter sana!{\i0}
Dialogue: 0,0:00:14.20,0:00:15.70,Default,,0,0,0,,{\i1}T-Tuttu!{\i0}
Dialogue: 0,0:00:15.70,0:00:17.78,Default,,0,0,0,,{\i1}Wakabayashi-kun\Nsıkıca yakalıyor!{\i0}
Dialogue: 0,0:00:17.78,0:00:18.70,Default,,0,0,0,,Ne?!
Dialogue: 0,0:00:19.53,0:00:25.66,Default,,0,0,0,,{\i1}{\i1}Hyuga, bacağım kırılsa bile\Nsenden bir gol daha yemeyeceğim!{\i0}{\i0}
Dialogue: 0,0:00:25.66,0:00:26.83,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:00:27.24,0:00:28.04,Default,,0,0,0,,İşte!
Dialogue: 0,0:00:28.58,0:00:31.27,Default,,0,0,0,,{\i1}Wakabayashi-kun uzağa yolluyor.{\i0}
Dialogue: 0,0:00:31.27,0:00:34.08,Default,,0,0,0,,{\i1}İlk yarı, Hyuga-kun'un\Nuzun şutuyla başladı.{\i0}
Dialogue: 0,0:00:34.08,0:00:38.05,Default,,0,0,0,,{\i1}Aynen öyle! Uzatmalar artık başlıyor!{\i0}
Dialogue: 0,0:02:08.27,0:02:13.15,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}Bölüm 26:\NHayalet Gol
Dialogue: 0,0:02:08.27,0:02:13.15,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs55\pos(1504,1022.333)}Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:02:09.06,0:02:13.44,Default - Top,,0,0,0,,{\i1}Nankatsu kaptanı Ozora Tsubasa-kun,\NMeiwa sahasında top sürüyor.{\i0}
Dialogue: 0,0:02:13.44,0:02:15.19,Default,,0,0,0,,Hadi! Geri alın şunu!
Dialogue: 0,0:02:15.84,0:02:17.78,Default,,0,0,0,,{\i1}Dinle Tsubasa.{\i0}
Dialogue: 0,0:02:17.78,0:02:20.36,Default,,0,0,0,,{\i1}Yaralı sol bacağını bandajla destekleyeceğim.{\i0}
Dialogue: 0,0:02:20.36,0:02:23.07,Default,,0,0,0,,{\i1}Bu sayede çok fazla acı hissetmeyeceksin.{\i0}
Dialogue: 0,0:02:23.07,0:02:25.87,Default,,0,0,0,,{\i1}Bu sayede istediğin gibi koşup vurabileceksin.{\i0}
Dialogue: 0,0:02:26.42,0:02:32.02,Default,,0,0,0,,{\i1}Ama bandaj olduğu için top\Nkontrolün her zamankinden zor olacak.{\i0}
Dialogue: 0,0:02:32.02,0:02:32.92,Default,,0,0,0,,{\t(130,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Tamam.{\i0}
Dialogue: 0,0:02:32.92,0:02:33.67,Default,,0,0,0,,Al!
Dialogue: 0,0:02:35.13,0:02:37.80,Default,,0,0,0,,{\i1}Meiwa'nın kayma ekibi saldırıyor!{\i0}
Dialogue: 0,0:02:39.55,0:02:40.30,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:40.30,0:02:45.22,Default,,0,0,0,,{\i1}Tsubasa-kun az önce yaralanan sol bacağı\Nyerine sağ bacağıyla topu kontrol ediyor!{\i0}
Dialogue: 0,0:02:45.22,0:02:47.14,Default,,0,0,0,,{\i1}Çok yetenekli bir ayak oyunu.{\i0}
Dialogue: 0,0:02:47.14,0:02:48.05,Default,,0,0,0,,Mükemmel!
Dialogue: 0,0:02:48.05,0:02:49.64,Default,,0,0,0,,Harika gidiyorsun Tsubasa-kun!
Dialogue: 0,0:02:50.64,0:02:51.26,Default,,0,0,0,,İşte!
Dialogue: 0,0:02:51.26,0:02:51.87,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:51.87,0:02:53.69,Default,,0,0,0,,{\i1}Tsubasa-kun şut çekiyor.{\i0}
Dialogue: 0,0:02:53.69,0:02:55.52,Default,,0,0,0,,{\i1}Gol atmana izin vermem!{\i0}
Dialogue: 0,0:02:56.82,0:03:01.20,Default,,0,0,0,,{\i1}Bu şuttan ziyade Misaki-kun\Niçin bir pasmış!{\i0}
Dialogue: 0,0:03:01.20,0:03:03.78,Default,,0,0,0,,{\i1}Misaki-kun zıplayarak kafa vuruyor!{\i0}
Dialogue: 0,0:03:03.78,0:03:04.58,Default,,0,0,0,,Başardı!
Dialogue: 0,0:03:04.58,0:03:06.37,Default,,0,0,0,,Yine Meiwa'yı kandırdık!
Dialogue: 0,0:03:07.96,0:03:10.33,Default,,0,0,0,,{\i1}Wakashimazu-kun durduruyor!{\i0}
Dialogue: 0,0:03:10.33,0:03:11.33,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:13.87,0:03:15.46,Default,,0,0,0,,Çok yakındı he.
Dialogue: 0,0:03:16.09,0:03:17.57,Default,,0,0,0,,{\i1}Anladı mı?{\i0}
Dialogue: 0,0:03:18.46,0:03:20.32,Default,,0,0,0,,{\i1}Wakashimazu-kun'dan da bu beklenirdi.{\i0}
Dialogue: 0,0:03:20.32,0:03:23.43,Default,,0,0,0,,{\i1}Aynı hataya bir kez daha düşmüyor.{\i0}
Dialogue: 0,0:03:24.43,0:03:27.70,Default,,0,0,0,,Wakashimazu-kun'du değil mi?
Dialogue: 0,0:03:27.70,0:03:30.56,Default,,0,0,0,,Wakashimazu Ken-kun.
Dialogue: 0,0:03:30.56,0:03:32.31,Default,,0,0,0,,Oldukça iyi.
Dialogue: 0,0:03:32.31,0:03:33.77,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:03:33.77,0:03:35.02,Default,,0,0,0,,Bu kez...
Dialogue: 0,0:03:35.02,0:03:37.11,Default,,0,0,0,,...gol atacağım!
Dialogue: 0,0:03:37.11,0:03:38.02,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:03:43.65,0:03:44.66,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:03:44.66,0:03:46.41,Default,,0,0,0,,Güzeldi Wakabayashi-kun!
Dialogue: 0,0:03:46.41,0:03:48.12,Default,,0,0,0,,Hadi!
Dialogue: 0,0:03:48.12,0:03:52.35,Default,,0,0,0,,Wakashimazu-kun ve Wakabayashi-kun'un\Nikisi de oldukça iyi.
Dialogue: 0,0:03:52.35,0:03:56.63,Default,,0,0,0,,Uzatmalarda ilk golü atan kim olacak?
Dialogue: 0,0:03:56.63,0:04:00.59,Default,,0,0,0,,İkisi de atak yapıyor ama maçın\Ngidişatı defansta bitiyor.
Dialogue: 0,0:04:00.59,0:04:02.51,Default,,0,0,0,,İşte! Kaleye!
Dialogue: 0,0:04:02.51,0:04:03.84,Default,,0,0,0,,{\i1}Tsubasa-kun...{\i0}
Dialogue: 0,0:04:05.13,0:04:06.43,Default,,0,0,0,,{\i1}Misaki-kun!{\i0}
Dialogue: 0,0:04:06.43,0:04:08.71,Default,,0,0,0,,{\i1}Top, Tsubasa-kun'a ulaşıyor!{\i0}
Dialogue: 0,0:04:08.71,0:04:10.93,Default,,0,0,0,,{\i1}Tsubasa-kun zıplayarak vole vuruyor!{\i0}
Dialogue: 0,0:04:24.68,0:04:25.65,Default,,0,0,0,,{\i1}Şuna bakın!{\i0}
Dialogue: 0,0:04:25.65,0:04:29.08,Default,,0,0,0,,{\i1}Wakashimazu-kun harika bir\Nşekilde oynuyor!{\i0}
Dialogue: 0,0:04:29.08,0:04:31.20,Default,,0,0,0,,O da neydi be?!
Dialogue: 0,0:04:31.20,0:04:32.45,Default,,0,0,0,,Lanet olsun.
Dialogue: 0,0:04:34.33,0:04:36.64,Default,,0,0,0,,Şu maçın çekişmesine bakın.
Dialogue: 0,0:04:36.64,0:04:38.70,Default,,0,0,0,,O kadar sıcak ki bayılıp kalacağım.
Dialogue: 0,0:04:38.70,0:04:41.38,Default,,0,0,0,,Herkes harika.\NGerçekten harikalar.
Dialogue: 0,0:04:41.38,0:04:44.05,Default,,0,0,0,,Evet, harika...
Dialogue: 0,0:04:44.05,0:04:47.22,Default,,0,0,0,,{\i1}İki takım da çok yorulmasına\Nrağmen devam ediyor.{\i0}
Dialogue: 0,0:04:47.22,0:04:49.85,Default,,0,0,0,,{\i1}Uzatmalar başladığından beri\Ntopun peşinden koşuyorlar.{\i0}
Dialogue: 0,0:04:53.77,0:04:56.15,Default,,0,0,0,,{\i1}Misaki-kun'a ne oldu?!{\i0}
Dialogue: 0,0:04:56.15,0:04:59.27,Default,,0,0,0,,{\i1}Bacağını tutarak yere çöktü!{\i0}
Dialogue: 0,0:05:00.02,0:05:01.77,Default,,0,0,0,,{\i1}Misaki-kun kıpırdayamıyor!{\i0}
Dialogue: 0,0:05:01.77,0:05:03.36,Default,,0,0,0,,{\i1}Tamamdır, işte fırsat!{\i0}
Dialogue: 0,0:05:03.36,0:05:04.57,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:05:04.57,0:05:06.82,Default,,0,0,0,,{\i1}Lanet olsun. Gelecekseniz gelin.{\i0}
Dialogue: 0,0:05:06.82,0:05:11.53,Default,,0,0,0,,{\i1}Hepiniz etrafımda toplanırsanız\NTsubasa-kun boşta kalır!{\i0}
Dialogue: 0,0:05:11.53,0:05:12.54,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:05:13.29,0:05:16.50,Default,,0,0,0,,{\i1}Misaki-kun tam vaktinde harika\Nbir pas gönderiyor!{\i0}
Dialogue: 0,0:05:20.84,0:05:21.59,Default,,0,0,0,,Misaki!
Dialogue: 0,0:05:24.46,0:05:28.22,Default,,0,0,0,,{\i1}Bana pas vermek uğruna\Nkendi ayağını ortaya koydu!{\i0}
Dialogue: 0,0:05:29.58,0:05:32.14,Default,,0,0,0,,{\i1}Golü atacağım Misaki-kun!{\i0}
Dialogue: 0,0:05:34.31,0:05:36.76,Default,,0,0,0,,{\i1}Tsubasa-kun özel hareketini\Nbugün üçüncü kez yapıyor!{\i0}
Dialogue: 0,0:05:36.76,0:05:38.81,Default,,0,0,0,,{\i1}Röveşata!{\i0}
Dialogue: 0,0:05:38.81,0:05:41.69,Default,,0,0,0,,Al bakalım Wakashimazu!
Dialogue: 0,0:05:41.69,0:05:42.94,Default,,0,0,0,,Hadi!
Dialogue: 0,0:05:44.90,0:05:46.19,Default,,0,0,0,,Durdur!
Dialogue: 0,0:05:46.94,0:05:49.07,Default,,0,0,0,,Ne kadar güçlü şut çektiğin önemsiz!
Dialogue: 0,0:05:49.07,0:05:51.57,Default,,0,0,0,,Uzun şutlar bana işlemez!
Dialogue: 0,0:05:52.62,0:05:53.58,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:54.14,0:06:00.58,Default,,0,0,0,,{\i1}Tsubasa-kun'un şutuna yetişiyor ama\NWakashimazu-kun bunu yakalayamıyor!{\i0}
Dialogue: 0,0:06:04.09,0:06:08.22,Default,,0,0,0,,{\i1}Tsubasa-kun'un röveşatası\Ntopa çok rotasyon verdi...{\i0}
Dialogue: 0,0:06:08.22,0:06:13.74,Default,,0,0,0,,{\i1}...ve Wakashimazu-kun'un zar zor ulaştığı\Ntop sekerek kaleye girdi!{\i0}
Dialogue: 0,0:06:13.74,0:06:18.24,Default,,0,0,0,,{\i1}Ama bu sırada hakem ilk yarıyı\Nbitirecek düdüğü de çaldı!{\i0}
Dialogue: 0,0:06:18.24,0:06:20.52,Default,,0,0,0,,{\i1}Bu gol kabul edilecek mi?{\i0}
Dialogue: 0,0:06:20.52,0:06:21.52,Default,,0,0,0,,Hakem!
Dialogue: 0,0:06:21.52,0:06:23.77,Default,,0,0,0,,Gol mü değil mi?!
Dialogue: 0,0:06:27.49,0:06:28.86,Default,,0,0,0,,Gol yok!
Dialogue: 0,0:06:30.49,0:06:32.11,Default,,0,0,0,,Gol yok mu?!
Dialogue: 0,0:06:35.40,0:06:37.16,Default,,0,0,0,,Ciddi mi bu?!
Dialogue: 0,0:06:37.16,0:06:40.39,Default,,0,0,0,,{\i1}Hakem golü saymadı.{\i0}
Dialogue: 0,0:06:40.39,0:06:43.96,Default,,0,0,0,,{\i1}İlk yarı golsüz bitiyor.{\i0}
Dialogue: 0,0:06:44.64,0:06:46.13,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:06:48.80,0:06:49.76,Default,,0,0,0,,Misaki!
Dialogue: 0,0:06:49.76,0:06:50.52,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:06:50.52,0:06:51.64,Default,,0,0,0,,Misaki!
Dialogue: 0,0:06:51.64,0:06:54.14,Default,,0,0,0,,İyiyim. İkinci yarıda da oynayabilirim.
Dialogue: 0,0:06:54.14,0:06:55.68,Default,,0,0,0,,Tutun.
Dialogue: 0,0:06:57.40,0:06:59.81,Default,,0,0,0,,Özür dilerim. Gol atamadım.
Dialogue: 0,0:06:59.81,0:07:01.81,Default,,0,0,0,,Sorun yok.
Dialogue: 0,0:07:01.81,0:07:03.94,Default,,0,0,0,,Misaki-kun...
Dialogue: 0,0:07:15.64,0:07:18.60,Default,,0,0,0,,5 dakika içerisinde gol atan taraf kazanacak.
Dialogue: 0,0:07:18.60,0:07:19.70,Default,,0,0,0,,Evet.
Dialogue: 0,0:07:19.70,0:07:24.79,Default,,0,0,0,,Kaleciler diğer oyuncular kadar\Nyorulmadığı için her şey tek gole bakacak.
Dialogue: 0,0:07:24.79,0:07:28.57,Default,,0,0,0,,Ama maçı bitirecek gol atılır mı dersin?
Dialogue: 0,0:07:28.57,0:07:29.70,Default,,0,0,0,,Atılır!
Dialogue: 0,0:07:29.70,0:07:34.00,Default,,0,0,0,,İki takımın da 5 dakika oynayacak gücü var.
Dialogue: 0,0:07:34.00,0:07:38.10,Default,,0,0,0,,Bu yüzden tüm umutlarını\Nbu ikinci yarıya bağlayacaklar.
Dialogue: 0,0:07:38.10,0:07:41.85,Default,,0,0,0,,Kimin kazanacağını hiç kestiremiyorum.
Dialogue: 0,0:07:41.85,0:07:42.81,Default,,0,0,0,,Evet.
Dialogue: 0,0:07:42.81,0:07:46.77,Default,,0,0,0,,{\i1}İkinci uzatma yarısı başlamak üzere!{\i0}
Dialogue: 0,0:07:46.77,0:07:48.77,Default,,0,0,0,,Elinden geleni yap Taro.
Dialogue: 0,0:07:48.77,0:07:51.03,Default,,0,0,0,,{\i1}Söz verdin Misaki.{\i0}
Dialogue: 0,0:07:51.03,0:07:56.17,Default,,0,0,0,,{\i1}Oynayamayacak gibi hissettiğinde\Nveya sınırına dayandığında...{\i0}
Dialogue: 0,0:07:56.17,0:07:59.03,Default,,0,0,0,,{\i1}...kendi rızanla sahadan çekileceksin.{\i0}
Dialogue: 0,0:08:03.04,0:08:08.80,Default,,0,0,0,,Tsubasa-kun, birlikte ilk oynadığımız\Nmaçta da uzatma vardı değil mi?
Dialogue: 0,0:08:08.80,0:08:11.42,Default,,0,0,0,,Evet, aynen öyle.
Dialogue: 0,0:08:14.05,0:08:16.71,Default,,0,0,0,,{\i1}Geliyorum Hyuga Kojiro!{\i0}
Dialogue: 0,0:08:19.06,0:08:24.06,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:08:24.98,0:08:28.11,Default,,0,0,0,,{\i1}Uzatmaların ikinci yarısı başlıyor.{\i0}
Dialogue: 0,0:08:28.56,0:08:31.78,Default,,0,0,0,,{\i1}Nankatsu kaptanı Tsubasa-kun,\Nkarşı sahada ilerliyor.{\i0}
Dialogue: 0,0:08:31.78,0:08:33.32,Default,,0,0,0,,Bu kez onu durduracağız!
Dialogue: 0,0:08:33.32,0:08:34.15,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:34.15,0:08:37.12,Default,,0,0,0,,Bu kez Misaki'nin yerini doldurmak\Niçin elimizden geleni yapacağız!
Dialogue: 0,0:08:37.12,0:08:37.91,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:37.91,0:08:42.66,Default,,0,0,0,,{\i1}Büyük kalabalığın bakışları arasında\Nsaat ilerlemeye devam ediyor.{\i0}
Dialogue: 0,0:08:42.66,0:08:48.67,Default,,0,0,0,,{\i1}Nankatsu ve Meiwa arasındaki çekişmeli\Nderbiden gülerek ayrılan taraf kim olacak?{\i0}
Dialogue: 0,0:08:48.67,0:08:51.42,Default,,0,0,0,,{\i1}Kazananı tahmin etmek tamamen imkansız.{\i0}
