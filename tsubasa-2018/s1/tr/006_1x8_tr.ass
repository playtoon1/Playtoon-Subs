Dialogue: 0,0:00:00.56,0:00:03.19,Default,,0,0,0,,Millet, Tsubasa dönmeden ilerleyin!
Dialogue: 0,0:00:03.19,0:00:04.40,Default,,0,0,0,,Bir gol daha!
Dialogue: 0,0:00:04.40,0:00:05.81,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:00:05.81,0:00:07.15,Default,,0,0,0,,Millet geri dönün!
Dialogue: 0,0:00:07.82,0:00:09.03,Default,,0,0,0,,Roller değişti!
Dialogue: 0,0:00:09.03,0:00:11.15,Default,,0,0,0,,Bu sefer Shutetsu karşı atak yapıyor!
Dialogue: 0,0:00:11.15,0:00:12.90,Default,,0,0,0,,Sanki izin veririm de!
Dialogue: 0,0:00:13.57,0:00:14.16,Default,,0,0,0,,Taki!
Dialogue: 0,0:00:15.11,0:00:16.16,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:00:16.16,0:00:17.53,Default,,0,0,0,,İşte bu, ikinci gol geliyor.
Dialogue: 0,0:00:18.24,0:00:18.95,Default,,0,0,0,,Ne?!
Dialogue: 0,0:00:19.45,0:00:22.87,Default,,0,0,0,,Tsubasa-kun, Taki-kun'dan topu alıyor!
Dialogue: 0,0:00:25.58,0:00:26.21,Default,,0,0,0,,Şut çekecek.
Dialogue: 0,0:00:26.21,0:00:27.46,Default,,0,0,0,,Şut çek!
Dialogue: 0,0:00:27.46,0:00:28.09,Default,,0,0,0,,Ne?
Dialogue: 0,0:00:28.50,0:00:30.34,Default,,0,0,0,,Yoksa bu...
Dialogue: 0,0:00:30.34,0:00:34.88,Default,,0,0,0,,Tsubasa-kun kendi sahasından\Nuzun bir şut çekti!
Dialogue: 0,0:00:36.05,0:00:38.72,Default,,0,0,0,,Wakabayashi-kun güzelce yakalıyor!
Dialogue: 0,0:00:40.72,0:00:42.06,Default,,0,0,0,,Çok şaşırtıcıydı!
Dialogue: 0,0:00:42.06,0:00:44.10,Default,,0,0,0,,Oradan şut çekeceğini kim düşünürdü?
Dialogue: 0,0:00:44.10,0:00:46.02,Default,,0,0,0,,Ama gol olmadı.
Dialogue: 0,0:00:46.02,0:00:48.11,Default,,0,0,0,,Panikliyor musun Tsubasa?
Dialogue: 0,0:00:48.11,0:00:49.77,Default,,0,0,0,,Şut çekmeye çok odaklanıyorsun.
Dialogue: 0,0:00:49.77,0:00:52.32,Default,,0,0,0,,Futbol 11 kişiyle oynanır.
Dialogue: 0,0:00:52.32,0:00:54.57,Default,,0,0,0,,Tek başına gol atamazsın.
Dialogue: 0,0:01:08.00,0:01:13.59,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:01:13.59,0:01:18.26,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:01:19.51,0:01:24.18,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:01:25.06,0:01:32.77,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:01:32.77,0:01:38.53,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:01:38.53,0:01:47.29,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:01:47.29,0:01:52.84,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:01:52.84,0:01:58.76,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:01:58.76,0:02:00.43,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:02:00.43,0:02:07.64,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:02:07.64,0:02:10.65,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:02:10.65,0:02:15.07,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:01:08.00,0:01:13.59,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:01:13.59,0:01:18.26,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:01:19.51,0:01:24.18,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:01:25.06,0:01:32.77,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:01:32.77,0:01:38.53,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:01:38.53,0:01:47.29,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:01:47.29,0:01:52.84,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:01:52.84,0:01:58.76,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:01:58.76,0:02:00.43,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:02:00.43,0:02:07.64,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo\N
Dialogue: 0,0:02:07.64,0:02:10.65,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:02:10.65,0:02:15.07,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:02:26.04,0:02:30.25,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs60\fs45\pos(1432,1009)}Bölüm 8:\NNankatsu'nun Altın İkilisinin Doğuşu
Dialogue: 0,0:02:26.04,0:02:30.25,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs60\pos(488,809)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:02:27.25,0:02:28.50,Default,,0,0,0,,{\an8}Kesiyor!
Dialogue: 0,0:02:28.50,0:02:31.63,Default,,0,0,0,,{\an8}Tsubasa-kun gene topu çalıyor!
Dialogue: 0,0:02:31.63,0:02:34.00,Default,,0,0,0,,Nankatsu'daki önemli tek kişi o!{He's the only one who matters at Nankatsu, after all.} {It comes down to him at Nankatsu} {Don't like how the line plays out.}
Dialogue: 0,0:02:34.00,0:02:36.21,Default,,0,0,0,,Tsubasa'dan başka birisini tutmayın!
Dialogue: 0,0:02:40.43,0:02:41.26,Default,,0,0,0,,Ne?{omae ha mou shindeiru, I had to do that}
Dialogue: 0,0:02:41.89,0:02:43.51,Default,,0,0,0,,Güzel pas.
Dialogue: 0,0:02:43.51,0:02:48.52,Default,,0,0,0,,Vay canına! Tsubasa-kun, defansı yemleyerek\Nharika bir pas atıyor!
Dialogue: 0,0:02:48.52,0:02:50.52,Default,,0,0,0,,Millet, işte fırsat!
Dialogue: 0,0:02:50.52,0:02:52.61,Default,,0,0,0,,Roberto ile yaptığımız\Nözel antrenmanı hatırlayın!
Dialogue: 0,0:02:52.61,0:02:53.61,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:53.61,0:02:55.11,Default,,0,0,0,,Sakin ol.
Dialogue: 0,0:02:55.11,0:02:56.61,Default,,0,0,0,,Etrafına iyice bak.
Dialogue: 0,0:02:56.61,0:02:58.53,Default,,0,0,0,,İçeriye at.{I know he says inside kick, but you wouldn't in English}
Dialogue: 0,0:02:59.36,0:03:00.28,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:03:00.28,0:03:00.95,Default,,0,0,0,,Hey!
Dialogue: 0,0:03:02.03,0:03:02.70,Default,,0,0,0,,Hey!
Dialogue: 0,0:03:02.70,0:03:04.03,Default,,0,0,0,,Bir daha.
Dialogue: 0,0:03:04.03,0:03:05.79,Default,,0,0,0,,B-Bunlar...
Dialogue: 0,0:03:05.79,0:03:07.33,Default,,0,0,0,,Nankatsu olmasına rağmen...
Dialogue: 0,0:03:08.33,0:03:10.37,Default,,0,0,0,,Nankatsu ilk kez böyle paslaşıyor.
Dialogue: 0,0:03:10.37,0:03:14.00,Default,,0,0,0,,Tsubasa-kun'un yemlediği\NShutetsu, yetişemiyor!{gotcha} {i can always trust your ears}
Dialogue: 0,0:03:14.00,0:03:15.71,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:03:15.71,0:03:18.63,Default,,0,0,0,,O şutla tüm dikkati\Nüzerine çekmeye mi çalışıyordu?{Did he do that grandstand play on purpose because he aimed this?}
Dialogue: 0,0:03:18.63,0:03:20.01,Default,,0,0,0,,Öyleyse...
Dialogue: 0,0:03:20.01,0:03:21.88,Default,,0,0,0,,...harika bir oyun algısı var!
Dialogue: 0,0:03:21.88,0:03:22.72,Default,,0,0,0,,İşte.
Dialogue: 0,0:03:22.72,0:03:23.84,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:03:23.84,0:03:26.56,Default,,0,0,0,,Tsubasa-kun'un uzun pası\Ndışarı çıkmak üzereydi!
Dialogue: 0,0:03:26.56,0:03:27.47,Default,,0,0,0,,Durdurun!
Dialogue: 0,0:03:27.47,0:03:28.27,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:03:28.27,0:03:31.02,Default,,0,0,0,,Nankatsu harika bir ritim tutturdu!
Dialogue: 0,0:03:31.02,0:03:32.44,Default,,0,0,0,,Git bakalım!
Dialogue: 0,0:03:32.44,0:03:33.73,Default,,0,0,0,,Ishizaki-kun orta açıyor!{Misaki isn't even on the field yet lmao.}
Dialogue: 0,0:03:33.73,0:03:36.40,Default,,0,0,0,,Güzel bir orta!
Dialogue: 0,0:03:39.53,0:03:42.07,Default,,0,0,0,,Wakabayashi-kun yem sebebiyle\Ndengesini kaybediyor!
Dialogue: 0,0:03:42.07,0:03:44.53,Default,,0,0,0,,Orada topa koşan Tsubasa-kun var!
Dialogue: 0,0:03:45.12,0:03:47.16,Default,,0,0,0,,Zıplayarak kafa atıyor!{haha again headshot <3} {nihongo is tricky, tehe pero}
Dialogue: 0,0:03:47.16,0:03:50.29,Default,,0,0,0,,Nankatsu için beraberliği\Nsağlayacak gol mü olacak?
Dialogue: 0,0:03:52.04,0:03:53.67,Default,,0,0,0,,Top tuhaf bir şekilde sekiyor.
Dialogue: 0,0:03:53.67,0:03:56.29,Default,,0,0,0,,Nankatsu oyuna tutunma\Ngolünü atamadı!
Dialogue: 0,0:03:56.29,0:03:59.05,Default,,0,0,0,,Tsubasa! Çok yakındı!
Dialogue: 0,0:03:59.05,0:04:01.63,Default,,0,0,0,,İşte böyle! Böyle devam et!
Dialogue: 0,0:04:01.63,0:04:02.97,Default,,0,0,0,,Yazık oldu.
Dialogue: 0,0:04:02.97,0:04:04.97,Default,,0,0,0,,Çok yakındı.
Dialogue: 0,0:04:04.97,0:04:06.97,Default,,0,0,0,,Millet, harika gidiyoruz.
Dialogue: 0,0:04:06.97,0:04:08.76,Default,,0,0,0,,Böyle devam edelim.
Dialogue: 0,0:04:08.76,0:04:10.22,Default,,0,0,0,,Tamam!
Dialogue: 0,0:04:14.10,0:04:16.06,Default,,0,0,0,,Şans da yeteneği bir parçası.
Dialogue: 0,0:04:16.52,0:04:20.61,Default,,0,0,0,,Tsubasa, üzgünüm ama bu maçı\Nkazanan biz olacağız.
Dialogue: 0,0:04:20.61,0:04:21.49,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:04:21.49,0:04:22.61,Default,,0,0,0,,Kuş kafesi zamanı!{i am putting this here because it bears noting: I 100% super disagree with "birdcage" -- you either capitalize the name, which looks and reads hideously, or you use the proper term, which is just "bird cage." this looks, and reads, baaaaaaaaaaaadly -nxs} {THE CT WIKI BACKS "birdcage" SO FUCK ME I GUESS}{I feel you, this is how thé official names make me feel}
Dialogue: 0,0:04:22.61,0:04:24.45,Default,,0,0,0,,Ne? Kuş kafesi mi?
Dialogue: 0,0:04:24.45,0:04:26.62,Default,,0,0,0,,Yoksa onu mu yapacağız?{more concise sentence structure tbh}
Dialogue: 0,0:04:26.99,0:04:28.33,Default,,0,0,0,,Kuş kafesi mi dedi?
Dialogue: 0,0:04:29.62,0:04:30.91,Default,,0,0,0,,Kuş kafesi mi?
Dialogue: 0,0:04:34.25,0:04:37.00,Default,,0,0,0,,Zaman su gibi akıyor.
Dialogue: 0,0:04:37.00,0:04:42.34,Default,,0,0,0,,Maç öncesinde olayların böyle\Ngelişmesini kim beklerdi ki?
Dialogue: 0,0:04:42.34,0:04:44.18,Default,,0,0,0,,Kaç sefer etti böyle?
Dialogue: 0,0:04:44.18,0:04:46.47,Default,,0,0,0,,Tsubasa-kun yine topu çalmaya gidiyor!
Dialogue: 0,0:04:46.47,0:04:47.43,Default,,0,0,0,,Geliyor!
Dialogue: 0,0:04:47.43,0:04:49.01,Default,,0,0,0,,Gözünüzü ondan ayırmayın.
Dialogue: 0,0:04:49.01,0:04:50.47,Default,,0,0,0,,Hızlıca pas verin.
Dialogue: 0,0:04:50.47,0:04:51.72,Default,,0,0,0,,Tamam.
Dialogue: 0,0:04:52.60,0:04:54.39,Default,,0,0,0,,Tamamdır. İşte.
Dialogue: 0,0:04:55.06,0:04:55.90,Default,,0,0,0,,Olmuyor.
Dialogue: 0,0:04:55.90,0:04:57.44,Default,,0,0,0,,Böyle topu çalamam.
Dialogue: 0,0:04:59.94,0:05:01.90,Default,,0,0,0,,Geliyorum, orta...
Dialogue: 0,0:05:02.90,0:05:05.36,Default,,0,0,0,,Dermişim!
Dialogue: 0,0:05:05.91,0:05:09.12,Default,,0,0,0,,Shutetsu, paslaşarak topu uzak tutuyor.
Dialogue: 0,0:05:09.12,0:05:12.62,Default,,0,0,0,,Atağa çıkma niyetleri yok hiç.
Dialogue: 0,0:05:13.08,0:05:14.79,Default,,0,0,0,,Kuş kafesi...
Dialogue: 0,0:05:14.79,0:05:18.63,Default,,0,0,0,,Bir ilkokul takımının böyle bir\Ntaktik kullanmasını beklemezdim.
Dialogue: 0,0:05:19.21,0:05:21.30,Default,,0,0,0,,Topu kendi sahanda tutarak başlarsın.
Dialogue: 0,0:05:21.30,0:05:24.05,Default,,0,0,0,,Rakibi yemledikçe topu ortaya gönderirsin...
Dialogue: 0,0:05:24.05,0:05:26.05,Default,,0,0,0,,...ve hareket etmelerini engellersin.
Dialogue: 0,0:05:26.05,0:05:29.80,Default,,0,0,0,,Zaman kazanmak için profesyoneller\Ntarafından kullanılan bir taktik.
Dialogue: 0,0:05:31.47,0:05:35.35,Default,,0,0,0,,Böylelikle oyun bitene kadar\Nbir şey yapmanız mümkün değil.
Dialogue: 0,0:05:35.89,0:05:39.48,Default,,0,0,0,,Evet, tıpkı kafese sıkışmış kuşlar gibi.{symbolism is strong, so strong it even got materialized <3}
Dialogue: 0,0:05:41.15,0:05:42.98,Default,,0,0,0,,Korkaklık ediyorsun Shutetsu!
Dialogue: 0,0:05:42.98,0:05:46.65,Default,,0,0,0,,Daha adil mücadele\Netmesini bilmez misin?!
Dialogue: 0,0:05:47.07,0:05:47.86,Default,,0,0,0,,Yine yaptılar!
Dialogue: 0,0:05:47.86,0:05:49.45,Default,,0,0,0,,Yine topu döndürüyorlar.
Dialogue: 0,0:05:49.45,0:05:54.87,Default,,0,0,0,,Shutetsu, ulusal turnuvanın hüküm süren\Ngalibi olabilir ama...
Dialogue: 0,0:05:54.87,0:05:57.25,Default,,0,0,0,,...böyle bir oyun sergilemeleri mümkün mü?
Dialogue: 0,0:05:57.92,0:05:59.54,Default,,0,0,0,,İstediğini söyle.{Say what you want}
Dialogue: 0,0:05:59.54,0:06:01.54,Default,,0,0,0,,Galip olmamızın en büyük sebebi...
Dialogue: 0,0:06:01.54,0:06:03.25,Default,,0,0,0,,...kaybetmeye katlanamamız.
Dialogue: 0,0:06:03.25,0:06:05.26,Default,,0,0,0,,Özellikle sana Ozora Tsubasa.{official materials that translate his name to English state that his name is "Tsubasa Ozora" with one o, idk why but there it is}
Dialogue: 0,0:06:06.92,0:06:08.30,Default,,0,0,0,,Wakabayashi-kun...
Dialogue: 0,0:06:09.14,0:06:11.51,Default,,0,0,0,,Tsubasa! Topu ben geri alırım!
Dialogue: 0,0:06:12.10,0:06:13.76,Default,,0,0,0,,Aldığım gibi sana pas atacağımdan...
Dialogue: 0,0:06:13.76,0:06:15.39,Default,,0,0,0,,...kalenin önüne git!
Dialogue: 0,0:06:15.39,0:06:16.73,Default,,0,0,0,,Başka seçeneğimiz yok!{the proper term is just "have no choice" but this is more like "This is the only chance we have!" not sure if i want to change it all the way to that}
Dialogue: 0,0:06:16.73,0:06:17.52,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:17.52,0:06:19.52,Default,,0,0,0,,Ishizaki'ye karşı mıyız?
Dialogue: 0,0:06:19.52,0:06:21.52,Default,,0,0,0,,Daha iyisi olamazdı.{"it's something to be grateful for", whatever flows here}
Dialogue: 0,0:06:22.77,0:06:24.28,Default,,0,0,0,,Kesinlikle geri alacağım!
Dialogue: 0,0:06:30.24,0:06:32.74,Default,,0,0,0,,Ishizaki-kun topu geri alamıyor!{dont you hate it too when you hit an iron bar inside of a pitch} {CLANG}
Dialogue: 0,0:06:32.74,0:06:35.87,Default,,0,0,0,,Skor 1-0 ve oldukça az bir süre kaldı!
Dialogue: 0,0:06:35.87,0:06:38.00,Default,,0,0,0,,Yine de hep birlikte giderlerse...
Dialogue: 0,0:06:38.00,0:06:39.54,Default,,0,0,0,,...defans zayıflar ve...
Dialogue: 0,0:06:39.54,0:06:42.21,Default,,0,0,0,,...Shutetsu bir gol daha atabilir.{they might let shutetsu have their second goal}
Dialogue: 0,0:06:42.21,0:06:45.34,Default,,0,0,0,,Ishizaki! Sen kaptan değil misin?
Dialogue: 0,0:06:45.34,0:06:47.21,Default,,0,0,0,,Biraz daha dayan!
Dialogue: 0,0:06:47.21,0:06:49.84,Default,,0,0,0,,Evet! Dayanın Nankatsu!
Dialogue: 0,0:06:49.84,0:06:52.89,Default,,0,0,0,,Shutetsu'ya karşı buraya kadar geldiniz!
Dialogue: 0,0:06:52.89,0:06:54.60,Default,,0,0,0,,Biraz daha çabalayın!
Dialogue: 0,0:06:55.85,0:06:58.14,Default,,0,0,0,,Buraya kadar geldiniz de ne demek?{"you came this far" my ass!}
Dialogue: 0,0:06:58.14,0:07:02.19,Default,,0,0,0,,Buraya kadar gelmemiz bizim\Nsayemizde değildi. Onun sayesindeydi.
Dialogue: 0,0:07:02.19,0:07:07.11,Default,,0,0,0,,Buraya kadar gelmemizin sebebi\Nberbat futbol takımımıza katılan Tsubasa.
Dialogue: 0,0:07:07.61,0:07:09.65,Default,,0,0,0,,Nishigaoka'ya karşı kazanmak da...
Dialogue: 0,0:07:09.65,0:07:13.66,Default,,0,0,0,,...Shutetsu'yu yenebileceğimize inanarak\Nsıkı pratik yapmamız da...{guideline said to not use British stuff so I swapped to 'practicing' from 'practising'}
Dialogue: 0,0:07:14.45,0:07:17.95,Default,,0,0,0,,...ve bu maçta buraya kadar\Nsadece bir gol yiyerek gelmemiz de...
Dialogue: 0,0:07:17.95,0:07:20.96,Default,,0,0,0,,...hepsi Tsubasa sayesinde değil mi?
Dialogue: 0,0:07:21.71,0:07:22.92,Default,,0,0,0,,En azından...
Dialogue: 0,0:07:22.92,0:07:26.63,Default,,0,0,0,,En azından topu alıp Tsubasa'ya pas atmalıyım.
Dialogue: 0,0:07:26.63,0:07:30.26,Default,,0,0,0,,Yoksa elimizden hiçbir şey gelmemiş olacak!
Dialogue: 0,0:07:30.26,0:07:33.09,Default,,0,0,0,,Hakem saatine bakıyor!
Dialogue: 0,0:07:33.09,0:07:35.55,Default,,0,0,0,,Süre dolmak üzere!
Dialogue: 0,0:07:35.55,0:07:37.68,Default,,0,0,0,,Lanet olsun, böyle devam edemeyiz!
Dialogue: 0,0:07:37.68,0:07:38.52,Default,,0,0,0,,Ya şimdi ya da asla!{"i'll take this risk" etc. i trust you to find something better}
Dialogue: 0,0:07:38.52,0:07:40.23,Default,,0,0,0,,Gidip kaptanımıza yardım edeceğim.
Dialogue: 0,0:07:41.02,0:07:42.40,Default,,0,0,0,,Ben de!
Dialogue: 0,0:07:42.40,0:07:43.90,Default,,0,0,0,,B-Ben de!{me three :P}
Dialogue: 0,0:07:45.23,0:07:46.32,Default,,0,0,0,,Ne?
Dialogue: 0,0:07:46.32,0:07:48.19,Default,,0,0,0,,Hey, taraf değiştirelim.
Dialogue: 0,0:07:48.19,0:07:49.36,Default,,0,0,0,,T-Tamamdır.
Dialogue: 0,0:07:50.19,0:07:51.65,Default,,0,0,0,,Taraf mı değiştirecekler?
Dialogue: 0,0:07:51.65,0:07:52.74,Default,,0,0,0,,Öyleyse...
Dialogue: 0,0:07:52.74,0:07:53.99,Default,,0,0,0,,Sana bırakıyorum Taki!
Dialogue: 0,0:07:55.12,0:07:57.79,Default,,0,0,0,,Ishizaki-kun ilk kez topun\Natılacağı yeri tahmin etti!
Dialogue: 0,0:07:57.79,0:07:58.79,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:08:03.83,0:08:04.67,Default,,0,0,0,,Ayağım!
Dialogue: 0,0:08:04.67,0:08:07.46,Default,,0,0,0,,Sert bir çarpışma oldu ve top...
Dialogue: 0,0:08:07.46,0:08:10.01,Default,,0,0,0,,Şimdi topu alamazsam başka fırsatım olmayacak!
Dialogue: 0,0:08:11.67,0:08:13.68,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:08:16.39,0:08:19.10,Default,,0,0,0,,Pas, Tsubasa'ya ulaşıyor!{pass for tsubasa got thru?}
Dialogue: 0,0:08:19.10,0:08:20.39,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:08:27.61,0:08:32.45,Default,,0,0,0,,Sonunda... Sonunda Nankatsu,\Nkuş kafesini kırıyor!
Dialogue: 0,0:08:38.62,0:08:40.75,Default,,0,0,0,,Yapabileceğimin en iyisi bu.
Dialogue: 0,0:08:40.75,0:08:41.87,Default,,0,0,0,,Sana güveniyorum!
Dialogue: 0,0:08:42.33,0:08:45.00,Default,,0,0,0,,Ishizaki-kun bu pası atmak için\Nvücudunu ortaya koydu.
Dialogue: 0,0:08:45.00,0:08:46.79,Default,,0,0,0,,Boşa gitmesine izin vermeyeceğim.
Dialogue: 0,0:08:47.21,0:08:48.29,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:08:48.29,0:08:49.50,Default,,0,0,0,,Geliyor musun?
Dialogue: 0,0:08:49.92,0:08:52.76,Default,,0,0,0,,Böylelikle hesaplaşacağız!
Dialogue: 0,0:08:52.76,0:08:53.59,Default,,0,0,0,,Kazanan...
Dialogue: 0,0:08:54.30,0:08:56.34,Default,,0,0,0,,...biz Shutetsu'yuz!
Dialogue: 0,0:08:56.34,0:08:57.51,Default,,0,0,0,,Yap şunu!{Got this in!} {oh god how do i fix this} {i tried -nxs}
Dialogue: 0,0:08:57.51,0:08:59.10,Default,,0,0,0,,Şimdi gol atamazsan...
Dialogue: 0,0:08:59.10,0:09:00.77,Default,,0,0,0,,...seni evlatlıktan reddederim!{lol, u wot dad?}
Dialogue: 0,0:09:00.77,0:09:02.85,Default,,0,0,0,,Ben evlatlıktan reddederim!{}{disturbed family , goal or seppuku, so japan} {so they very specifically refer to themselves as father and mother, and i am willing to bet this is the kind of humor the Ozora family tosses around the house... it kind of explains why Tsubasa's nutty}
Dialogue: 0,0:09:03.77,0:09:06.48,Default,,0,0,0,,Uzatma dakikaları ilerliyor.{in the match}
Dialogue: 0,0:09:06.48,0:09:09.36,Default,,0,0,0,,Nankatsu'nun son şansı olabilir.
Dialogue: 0,0:09:10.98,0:09:12.07,Default,,0,0,0,,Gerçekten mi?
Dialogue: 0,0:09:12.07,0:09:14.65,Default,,0,0,0,,Tsubasa-kun gözlerini kaleye\Ndikti ve tek başına ilerliyor.
Dialogue: 0,0:09:15.07,0:09:15.91,Default,,0,0,0,,Pekala!
Dialogue: 0,0:09:15.91,0:09:17.07,Default,,0,0,0,,Vardım sayılır!
Dialogue: 0,0:09:17.07,0:09:18.62,Default,,0,0,0,,O kadar aceleci olma!
Dialogue: 0,0:09:19.24,0:09:21.04,Default,,0,0,0,,Hala buradayız biz.
Dialogue: 0,0:09:21.04,0:09:23.16,Default,,0,0,0,,Tek başına bizi alt etmene\Nizin vermeyeceğiz!
Dialogue: 0,0:09:23.16,0:09:25.16,Default,,0,0,0,,Seni ezeceğiz!
Dialogue: 0,0:09:25.16,0:09:26.17,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:09:27.42,0:09:31.13,Default,,0,0,0,,Tsubasa-kun, Kisugi'nin kaymasını\Nzıplayarak atlatıyor.
Dialogue: 0,0:09:31.13,0:09:34.72,Default,,0,0,0,,Ne var ki orada dev gibi\NTakasugi-kun var.
Dialogue: 0,0:09:34.72,0:09:35.97,Default,,0,0,0,,- Tsubasa!\N- Dikkat et!
Dialogue: 0,0:09:39.64,0:09:41.39,Default,,0,0,0,,Kimse onu yakalayamıyor!
Dialogue: 0,0:09:42.01,0:09:44.02,Default,,0,0,0,,Şimdi kaleciyle karşı karşıya.
Dialogue: 0,0:09:44.02,0:09:45.14,Default,,0,0,0,,Hayır, daha değil!
Dialogue: 0,0:09:45.14,0:09:47.90,Default,,0,0,0,,Birisi daha var. Orta saha Izawa-kun!
Dialogue: 0,0:09:48.31,0:09:49.40,Default,,0,0,0,,Geçirmeyeceğim!
Dialogue: 0,0:09:49.40,0:09:50.90,Default,,0,0,0,,Ne tarafa gidecek?
Dialogue: 0,0:09:52.36,0:09:53.61,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:53.61,0:09:57.03,Default,,0,0,0,,S-Sonunda herkesi geçmeyi başardı!
Dialogue: 0,0:09:57.03,0:09:58.66,Default,,0,0,0,,Ozora Tsubasa...
Dialogue: 0,0:09:58.66,0:10:00.16,Default,,0,0,0,,Ne çocuk ama.
Dialogue: 0,0:10:00.16,0:10:03.12,Default,,0,0,0,,Ne yaparsak yapalım onu durduramayız!{say in chorus for maximum effect}
Dialogue: 0,0:10:03.12,0:10:04.33,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:10:04.33,0:10:06.54,Default,,0,0,0,,Daha da yaklaş.
Dialogue: 0,0:10:07.21,0:10:09.83,Default,,0,0,0,,Tsubasa-kun şut çekmeye hazırlanıyor.
Dialogue: 0,0:10:09.83,0:10:12.80,Default,,0,0,0,,Neden ceza sahasından\Nşut çekmiyorsun Tsubasa?
Dialogue: 0,0:10:12.80,0:10:14.05,Default,,0,0,0,,Bu...
Dialogue: 0,0:10:14.05,0:10:15.80,Default,,0,0,0,,Ceza sahasının dışından\Nşut çekmeyi planlıyor.
Dialogue: 0,0:10:16.76,0:10:19.93,Default,,0,0,0,,Tsubasa-kun'un uzun şutu\Ntakımının kaderini taşıyor!{more dramatic: his long shot is carrying Nankatsu's destiny}
Dialogue: 0,0:10:19.93,0:10:21.43,Default,,0,0,0,,Yine aynı yere mi?
Dialogue: 0,0:10:22.76,0:10:23.76,Default,,0,0,0,,İşe yaramaz!{mudamudamudamuda, tsubasa says oraoraoraora, wwrryyyyyyy!}
Dialogue: 0,0:10:23.76,0:10:27.44,Default,,0,0,0,,Ceza sahasının dışından çekilen\Nbir şutu kesinlikle durdururum!
Dialogue: 0,0:10:27.81,0:10:29.90,Default,,0,0,0,,Wakabayashi-kun harika karşılık veriyor!
Dialogue: 0,0:10:29.90,0:10:31.94,Default,,0,0,0,,Ama top hala oyunda!
Dialogue: 0,0:10:31.94,0:10:33.34,Default,,0,0,0,,- Gir!\N- Girme!
Dialogue: 0,0:10:33.98,0:10:36.07,Default,,0,0,0,,Top direğe çarpıyor!{the top post of the goal is the crossbar}
Dialogue: 0,0:10:36.36,0:10:37.32,Default,,0,0,0,,Başardım!
Dialogue: 0,0:10:37.32,0:10:39.82,Default,,0,0,0,,Nankatsu beraberliği sağlayamıyor!
Dialogue: 0,0:10:41.70,0:10:44.08,Default,,0,0,0,,T-Tsubasa...
Dialogue: 0,0:10:44.08,0:10:45.33,Default,,0,0,0,,Uçuyor!{or he jumped his name is tsubasa, for wing I'd say he flies <3}
Dialogue: 0,0:10:45.33,0:10:47.33,Default,,0,0,0,,B-Bu...
Dialogue: 0,0:10:52.08,0:10:54.34,Default,,0,0,0,,Röveşata!
Dialogue: 0,0:11:01.01,0:11:04.35,Default,,0,0,0,,B-Beraberlik golü!
Dialogue: 0,0:11:05.72,0:11:07.31,Default,,0,0,0,,Başardım.
Dialogue: 0,0:11:07.31,0:11:10.06,Default,,0,0,0,,Başardım!
Dialogue: 0,0:11:11.31,0:11:12.31,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:11:13.40,0:11:15.32,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:11:17.82,0:11:20.24,Default,,0,0,0,,O-Olamaz...
Dialogue: 0,0:11:23.91,0:11:24.83,Default,,0,0,0,,İşte.
Dialogue: 0,0:11:24.83,0:11:27.50,Default,,0,0,0,,Maçın bittiğini bildiren düdük.
Dialogue: 0,0:11:27.50,0:11:29.83,Default,,0,0,0,,40 dakikada hiçbir takım galip gelemedi.
Dialogue: 0,0:11:30.25,0:11:33.33,Default,,0,0,0,,5 dakikalık bir aradan sonra...
Dialogue: 0,0:11:33.33,0:11:36.59,Default,,0,0,0,,...5 dakikalık 2 uzatma oynanacak.{football terminology, save me neo} {extra time's correct}
Dialogue: 0,0:11:38.96,0:11:41.22,Default,,0,0,0,,Millet, iyi iş çıkardınız.
Dialogue: 0,0:11:41.22,0:11:43.05,Default,,0,0,0,,Yine de Tsubasa...
Dialogue: 0,0:11:43.05,0:11:44.47,Default,,0,0,0,,...çok şaşırdım!
Dialogue: 0,0:11:44.47,0:11:46.47,Default,,0,0,0,,İlk karşılaşmamızda gösterdiğim numara olan...
Dialogue: 0,0:11:46.89,0:11:48.56,Default,,0,0,0,,...direkten seken topa röveşatayı...{the overhead kick after hitting the ball to the post.}
Dialogue: 0,0:11:49.23,0:11:50.43,Default,,0,0,0,,...tesadüf bile olsa...
Dialogue: 0,0:11:50.43,0:11:52.81,Default,,0,0,0,,...gerçek bir maçta kullanmanı beklemezdim.
Dialogue: 0,0:11:53.35,0:11:58.69,Default,,0,0,0,,Ama çok pratik yaptığım için top\Ndireğe çarptığı gibi zıplayabildim.
Dialogue: 0,0:11:58.69,0:12:01.20,Default,,0,0,0,,Çok havalısın Tsubasa.
Dialogue: 0,0:12:01.20,0:12:02.99,Default,,0,0,0,,Uzatma demek...
Dialogue: 0,0:12:02.99,0:12:04.62,Default,,0,0,0,,Durum fena.
Dialogue: 0,0:12:04.62,0:12:06.24,Default,,0,0,0,,Bu arada Ishizaki-kun...
Dialogue: 0,0:12:06.83,0:12:08.74,Default,,0,0,0,,Ayağın iyi mi?
Dialogue: 0,0:12:08.74,0:12:09.66,Default,,0,0,0,,Ne diyorsun be?
Dialogue: 0,0:12:09.66,0:12:11.12,Default,,0,0,0,,Önemli bir şey yok.
Dialogue: 0,0:12:11.12,0:12:13.04,Default,,0,0,0,,Bak nasıl da iyi duruyorum.
Dialogue: 0,0:12:13.04,0:12:15.04,Default,,0,0,0,,Bak, böyle bile yapa--{self-rekt?}
Dialogue: 0,0:12:19.09,0:12:20.42,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:12:22.76,0:12:25.72,Default,,0,0,0,,Ishizaki-kun, böyle oynayamazsın.
Dialogue: 0,0:12:25.72,0:12:26.47,Default,,0,0,0,,Aptal!
Dialogue: 0,0:12:26.47,0:12:28.01,Default,,0,0,0,,Böyle bir yaralanma--
Dialogue: 0,0:12:28.81,0:12:29.89,Default,,0,0,0,,İmkansız.
Dialogue: 0,0:12:32.98,0:12:34.44,Default,,0,0,0,,Sen de kimsin be?!
Dialogue: 0,0:12:35.90,0:12:37.73,Default,,0,0,0,,Ben Misaki Taro.{referred to as Misaki Taro in official stuff; again, this my edit pass, once discussion is done in Discord we can decide one way or another, but I would use the "official" name every time}
Dialogue: 0,0:12:41.19,0:12:43.61,Default,,0,0,0,,K-Kaptan...
Dialogue: 0,0:12:49.91,0:12:51.29,Default,,0,0,0,,{\pos(960,409)}Bitti.
Dialogue: 0,0:12:52.54,0:12:55.10,Default,,0,0,0,,{\fs60\pos(1576,793)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:12:55.13,0:13:00.09,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:13:05.09,0:13:06.97,Default,,0,0,0,,Düşündüğüm gibi burkulmuş.
Dialogue: 0,0:13:06.97,0:13:09.31,Default,,0,0,0,,En az 3 gün şişlik geçmeyecek.{he says "the swelling won't go down for three days" exactly}
Dialogue: 0,0:13:09.31,0:13:12.27,Default,,0,0,0,,Nereden biliyorsun ki bunu?!
Dialogue: 0,0:13:12.27,0:13:16.85,Default,,0,0,0,,Babam iş için çok yolculuk\Nyaptığından trendeyken okudum.{help me in this, aibou}
Dialogue: 0,0:13:16.85,0:13:21.40,Default,,0,0,0,,Son zamanlarda okuduğum bir kitap, futbolda\Nilk yardım tekniklerinden bahsediyordu.
Dialogue: 0,0:13:21.40,0:13:22.65,Default,,0,0,0,,Futbol mu?
Dialogue: 0,0:13:22.65,0:13:23.57,Default,,0,0,0,,Evet.
Dialogue: 0,0:13:23.57,0:13:28.78,Default,,0,0,0,,Ama şimdi ne yapacağız?\NSadece 11 oyuncumuz var.
Dialogue: 0,0:13:28.78,0:13:31.45,Default,,0,0,0,,Ne?! Ishizaki yaralandı mı?!
Dialogue: 0,0:13:31.45,0:13:34.04,Default,,0,0,0,,Evet. Yerine geçebilecek kimse var mı?
Dialogue: 0,0:13:34.04,0:13:36.71,Default,,0,0,0,,Futbol oynayabilen birisi var mı?
Dialogue: 0,0:13:36.71,0:13:38.21,Default,,0,0,0,,Futbol mu?{<3 no need to watch for fixing this <3}
Dialogue: 0,0:13:38.21,0:13:39.46,Default,,0,0,0,,Hayatta olmaz.
Dialogue: 0,0:13:39.46,0:13:41.21,Default,,0,0,0,,İmkansız.
Dialogue: 0,0:13:41.21,0:13:43.63,Default,,0,0,0,,Öyleyse ben...
Dialogue: 0,0:13:43.63,0:13:44.72,Default,,0,0,0,,Anego?!{did we use lady?}{we didn't, she's Boss}
Dialogue: 0,0:13:44.72,0:13:48.89,Default,,0,0,0,,Çünkü o zaman Tsubasa-kun\Nile oynamış olurum.
Dialogue: 0,0:13:48.89,0:13:49.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:13:49.85,0:13:54.06,Default,,0,0,0,,Öyleyse Urabe Hanji-sama\Nolarak ben giderim!{we talked about going with the western name order during the past week, so...}
Dialogue: 0,0:13:54.06,0:13:57.73,Default,,0,0,0,,Hayır. Ben giderim.\NSenden daha çok işe yararım.
Dialogue: 0,0:13:57.73,0:14:00.65,Default,,0,0,0,,Durun bakalım. Bu, Nankatsu ve\NShutetsu arasındaki bir maç.
Dialogue: 0,0:14:00.65,0:14:02.15,Default,,0,0,0,,Başka okuldan kişiler--
Dialogue: 0,0:14:02.15,0:14:03.03,Default,,0,0,0,,Ben gideceğim.
Dialogue: 0,0:14:03.03,0:14:04.03,Default,,0,0,0,,Ben!
Dialogue: 0,0:14:06.82,0:14:08.78,Default,,0,0,0,,Kaptan! Nereye gidiyorsun?
Dialogue: 0,0:14:08.78,0:14:10.16,Default,,0,0,0,,Demiştim.
Dialogue: 0,0:14:10.17,0:14:15.79,Default,,0,0,0,,Bu maç, Tsubasa'nın bana gol atıp\Natamayacağını gösteren bir mücadeleydi.
Dialogue: 0,0:14:16.46,0:14:19.92,Default,,0,0,0,,Ben ise bu mücadeleyi kaybettim.
Dialogue: 0,0:14:19.92,0:14:23.34,Default,,0,0,0,,Bu yüzden uzatmada sadece\Nsiz oynayabilirsiniz.
Dialogue: 0,0:14:23.34,0:14:24.80,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:14:24.80,0:14:26.55,Default,,0,0,0,,Bekle Wakabayashi.
Dialogue: 0,0:14:37.77,0:14:39.06,Default,,0,0,0,,Mikami-san.
Dialogue: 0,0:14:39.06,0:14:40.77,Default,,0,0,0,,Şımarma Genzo!{Angrey Daddy, is it daddy? papaue}
Dialogue: 0,0:14:40.77,0:14:44.07,Default,,0,0,0,,Bir gol yedin diye kaçıyor musun?
Dialogue: 0,0:14:44.07,0:14:46.03,Default,,0,0,0,,Kendinden utanmalısın.{Spell check, aibou yup, omawanu no ka, = omowanai no ka, all good, I meant on embarassed!} {English generally "assigns" blame rather than asking whether you feel embarrassed; the whole idea of "shame on you"}
Dialogue: 0,0:14:47.03,0:14:50.11,Default,,0,0,0,,Sana böyle koçluk yapmadım ben!
Dialogue: 0,0:14:50.11,0:14:54.04,Default,,0,0,0,,Şu andan itibaren sana\Nkoçluk yapmayı bırakıyorum Genzo.{fak; the original is stilted but i'm trying to come up w/something that is still true to the t/l}
Dialogue: 0,0:14:56.79,0:15:01.71,Default,,0,0,0,,Wakabayashi. Seni kaptan yapan bendim.
Dialogue: 0,0:15:01.71,0:15:05.96,Default,,0,0,0,,Ama sana güvenen ve\Nburaya kadar seni destekleyen onlar.
Dialogue: 0,0:15:06.71,0:15:10.72,Default,,0,0,0,,Onlara şimdi arkanı mı döneceksin?
Dialogue: 0,0:15:15.72,0:15:18.31,Default,,0,0,0,,Hesaplaşma vakti! Kazanan kişi maçta oynar!
Dialogue: 0,0:15:18.31,0:15:19.81,Default,,0,0,0,,Darılmaca yok.
Dialogue: 0,0:15:19.81,0:15:22.73,Default,,0,0,0,,Her şeyinle gel ama sonra ağlama!
Dialogue: 0,0:15:24.23,0:15:25.86,Default,,0,0,0,,Ah şu ikili...
Dialogue: 0,0:15:25.86,0:15:28.69,Default,,0,0,0,,Baksana, ben girsem olur mu?
Dialogue: 0,0:15:28.69,0:15:32.62,Default,,0,0,0,,Ne? Aptallaşma.\NSen de Nankatsu'dan değilsin ki.
Dialogue: 0,0:15:32.62,0:15:34.66,Default,,0,0,0,,Ben de Nankatsu'danım.
Dialogue: 0,0:15:35.49,0:15:37.45,Default,,0,0,0,,Bugün transfer oldum.
Dialogue: 0,0:15:42.79,0:15:43.96,Default,,0,0,0,,Sen...
Dialogue: 0,0:15:43.96,0:15:47.00,Default,,0,0,0,,Yaralanan kişi yerine gireceğim. Misaki Taro.
Dialogue: 0,0:15:47.00,0:15:48.21,Default,,0,0,0,,Saçmalama be!
Dialogue: 0,0:15:48.21,0:15:49.30,Default,,0,0,0,,Oynayacak kişi...
Dialogue: 0,0:15:49.30,0:15:50.63,Default,,0,0,0,,...biziz!
Dialogue: 0,0:15:56.18,0:15:57.31,Default,,0,0,0,,Yetenekli.
Dialogue: 0,0:15:57.31,0:15:59.14,Default,,0,0,0,,B-Bu...
Dialogue: 0,0:16:03.69,0:16:06.27,Default,,0,0,0,,Biraz büyük ama idare et artık.
Dialogue: 0,0:16:06.27,0:16:09.19,Default,,0,0,0,,Tamamdır. İyi geçinelim Tsubasa-kun.
Dialogue: 0,0:16:09.61,0:16:12.20,Default,,0,0,0,,Evet. İyi geçinelim Misaki-kun.
Dialogue: 0,0:16:19.91,0:16:23.54,Default,,0,0,0,,Mücadelede Tsubasa'ya kaybettim.{its goood and all buut I think we should add the match part too, but again it might be unnecessary}{i think it's unnecessary}
Dialogue: 0,0:16:25.33,0:16:30.42,Default,,0,0,0,,Ama öncelikli olarak\NShutetsu'nun kaptanıyım ben.
Dialogue: 0,0:16:33.05,0:16:35.85,Default,,0,0,0,,Bu maçı kesinlikle kazanacağız!
Dialogue: 0,0:16:35.85,0:16:37.81,Default,,0,0,0,,Kaptan!{chorus}
Dialogue: 0,0:16:38.35,0:16:39.93,Default,,0,0,0,,Evet.
Dialogue: 0,0:16:40.98,0:16:43.94,Default,,0,0,0,,Uzatmaların başlama vakti geldi.{isn't this too many "time"s? How about "Extra time starts!"? You can never have too many 'time's} {TIME} {IT'S TIME FOR EXTRA TIME TO BEGIN THIS TIME AND POINT IN TIME. TIME!} {(time)}{i'm insane send help}{not this time, buddy}
Dialogue: 0,0:16:43.94,0:16:48.15,Default,,0,0,0,,Tamam, gidelim! Şu andan\Nitibaren Shutetsu'nun gerçek futbolu başlamıştır!
Dialogue: 0,0:16:48.15,0:16:49.19,Default,,0,0,0,,Evet!
Dialogue: 0,0:16:49.19,0:16:52.90,Default,,0,0,0,,Tamam, 10 dakika daha!\NHer şeyinizi ortaya koyun!
Dialogue: 0,0:16:52.90,0:16:54.20,Default,,0,0,0,,Evet!{chorus ends here}
Dialogue: 0,0:16:54.20,0:16:57.12,Default,,0,0,0,,Benim yerim size emanet çocuklar!{Might need edit tho}
Dialogue: 0,0:17:00.49,0:17:03.12,Default,,0,0,0,,Senden de bunu beklerdim Genzo.{"that's how i expect you to act" / "now you're acting properly"}
Dialogue: 0,0:17:03.96,0:17:08.25,Default,,0,0,0,,İlk yarı başlıyor. İlk vuruşu Nankatsu yapacak.
Dialogue: 0,0:17:08.25,0:17:12.38,Default,,0,0,0,,Ne? Tanımadığımız başka birisi\Ndaha gelmiş.{There's another guy I haven't seen before there.}
Dialogue: 0,0:17:12.38,0:17:13.51,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:14.51,0:17:18.01,Default,,0,0,0,,Duyabiliyor musun?\NÇok fazla tezahürat var.
Dialogue: 0,0:17:18.01,0:17:19.72,Default,,0,0,0,,Bugün birlikte kazanalım.
Dialogue: 0,0:17:21.56,0:17:24.31,Default,,0,0,0,,Baksana, sıradaki kasaba\Nnasıl olacak acaba?
Dialogue: 0,0:17:25.52,0:17:29.65,Default,,0,0,0,,Anlıyorum. Tsubasa-kun ve ben aynıyız.
Dialogue: 0,0:17:29.65,0:17:32.61,Default,,0,0,0,,Tsubasa-kun, bir isteğim var.
Dialogue: 0,0:17:33.69,0:17:35.20,Default,,0,0,0,,Düdük çaldığı gibi...
Dialogue: 0,0:17:35.20,0:17:37.70,Default,,0,0,0,,...hızlıca topu bana verip koş.
Dialogue: 0,0:17:37.70,0:17:39.95,Default,,0,0,0,,İstediğin yere ilerle.
Dialogue: 0,0:17:39.95,0:17:41.33,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:17:44.46,0:17:45.79,Default,,0,0,0,,Topu alacağım!
Dialogue: 0,0:17:51.46,0:17:53.46,Default,,0,0,0,,Bu da kim?
Dialogue: 0,0:17:58.89,0:17:59.97,Default,,0,0,0,,Kimin...
Dialogue: 0,0:17:59.97,0:18:00.97,Default,,0,0,0,,...nesi?
Dialogue: 0,0:18:04.64,0:18:07.14,Default,,0,0,0,,İnanılmaz! Ayağıma servis!
Dialogue: 0,0:18:07.14,0:18:12.32,Default,,0,0,0,,Derin pas! İyi bir düşünceyle\Nçok nazik bir pas yolladı.{What a kind passing, thoughtful about receiver.} {god how do you begin to translate/edit that into something that makes sense and is "normal" sounding to English speakers}
Dialogue: 0,0:18:12.32,0:18:13.82,Default,,0,0,0,,Seni...
Dialogue: 0,0:18:20.03,0:18:21.83,Default,,0,0,0,,Harikasın Misaki-kun.
Dialogue: 0,0:18:21.83,0:18:25.79,Default,,0,0,0,,Ne düşündüğümü gözlerimden anlıyorsun.
Dialogue: 0,0:18:25.79,0:18:28.54,Default,,0,0,0,,Tsubasa-kun, sen de öyle.
Dialogue: 0,0:18:28.54,0:18:34.55,Default,,0,0,0,,11 numaralı Misaki Taro-kun, daha bugün\NNankatsu'ya transfer olmuş.
Dialogue: 0,0:18:34.55,0:18:36.92,Default,,0,0,0,,Ellerinde hala öyle birisi varmış.
Dialogue: 0,0:18:36.92,0:18:38.72,Default,,0,0,0,,Ne oldu? Sorun yok.
Dialogue: 0,0:18:38.72,0:18:39.55,Default,,0,0,0,,Ne?
Dialogue: 0,0:18:39.55,0:18:43.81,Default,,0,0,0,,Şu anki Genzo gol yemez.
Dialogue: 0,0:18:43.81,0:18:47.06,Default,,0,0,0,,Şu ana kadar sadece Tsubasa'ya\Ndikkat eden Genzo...
Dialogue: 0,0:18:47.06,0:18:51.56,Default,,0,0,0,,...artık kaptan olarak tüm takımıyla\Nbirlikte kazanmayı hedefliyor.
Dialogue: 0,0:18:51.98,0:18:56.24,Default,,0,0,0,,Şu an sahadaki herkesin\Nhareketlerini izleyen Genzo...
Dialogue: 0,0:18:56.24,0:18:59.82,Default,,0,0,0,,...sanki avucunun içindeymiş gibi\Nhepsinin yerini biliyor.
Dialogue: 0,0:18:59.82,0:19:01.66,Default,,0,0,0,,Artık dikkati dağınık olmadığından...
Dialogue: 0,0:19:01.66,0:19:04.29,Default,,0,0,0,,...her şuta tepki verebilir.
Dialogue: 0,0:19:10.12,0:19:13.59,Default,,0,0,0,,Misaki Taro, sen de oldukça yeteneklisin.
Dialogue: 0,0:19:14.09,0:19:18.51,Default,,0,0,0,,Bu maç seni çok geliştirdi Genzo.
Dialogue: 0,0:19:18.51,0:19:20.76,Default,,0,0,0,,Gerçekten özel birisin.
Dialogue: 0,0:19:20.76,0:19:22.76,Default,,0,0,0,,Başardık Koç!
Dialogue: 0,0:19:22.76,0:19:25.01,Default,,0,0,0,,Uzatmalarda hakim oynuyoruz.
Dialogue: 0,0:19:25.64,0:19:26.89,Default,,0,0,0,,Tsubasa ve Misaki.
Dialogue: 0,0:19:26.89,0:19:30.77,Default,,0,0,0,,Bu ikili olduktan sonra Nankatsu asla kaybetmez.
Dialogue: 0,0:19:30.77,0:19:33.15,Default,,0,0,0,,Bunun olacağını bilseydim...
Dialogue: 0,0:19:33.15,0:19:35.90,Default,,0,0,0,,...seni daha önce yaralardım.
Dialogue: 0,0:19:37.19,0:19:39.53,Default,,0,0,0,,Acımasızlık ediyorsun Koç.
Dialogue: 0,0:19:40.57,0:19:45.45,Default,,0,0,0,,Uzatmaların ilk yarısını bitiren düdük!
Dialogue: 0,0:19:46.91,0:19:49.25,Default,,0,0,0,,Genzo, iyi liderlik ediyorsun.
Dialogue: 0,0:19:49.25,0:19:50.87,Default,,0,0,0,,Mikami-san!
Dialogue: 0,0:19:50.87,0:19:52.50,Default,,0,0,0,,Millet, elinizden geleni yapın.
Dialogue: 0,0:19:52.50,0:19:54.34,Default,,0,0,0,,Sadece birazcık daha.
Dialogue: 0,0:19:54.34,0:19:57.55,Default,,0,0,0,,Onlar da aynı şekilde zorlanıyor.\NSon 5 dakika.
Dialogue: 0,0:19:57.55,0:20:00.05,Default,,0,0,0,,Tüm gücünüzü ortaya koyun.
Dialogue: 0,0:20:00.05,0:20:01.26,Default,,0,0,0,,Tamam!{chorus}
Dialogue: 0,0:20:01.26,0:20:04.51,Default,,0,0,0,,Artık dönüşü yok, son 5 dakikamız var.
Dialogue: 0,0:20:04.89,0:20:08.14,Default,,0,0,0,,Millet, her şeyinizi ortaya koyup pişmanlık\Nduymayacağınız bir mücadele sergileyin!
Dialogue: 0,0:20:08.14,0:20:09.18,Default,,0,0,0,,Tamam!{chorus end, not here}
Dialogue: 0,0:20:09.56,0:20:11.94,Default,,0,0,0,,Aynen öyle. Son 5 dakika.
Dialogue: 0,0:20:11.94,0:20:14.19,Default,,0,0,0,,Her şeyimizle mücadele edeceğiz!{chorus end}
Dialogue: 0,0:20:16.65,0:20:20.24,Default,,0,0,0,,İkinci yarı sadece 5 dakika!
Dialogue: 0,0:20:20.24,0:20:24.12,Default,,0,0,0,,Shutetsu'nun top vuruşuyla\Nikinci yarı başlıyor.
Dialogue: 0,0:20:24.12,0:20:25.78,Default,,0,0,0,,Koş Taki! Ani hücum!
Dialogue: 0,0:20:26.49,0:20:28.54,Default,,0,0,0,,Shutetsu hızlıca atağa çıkıyor!
Dialogue: 0,0:20:28.54,0:20:32.04,Default,,0,0,0,,Oyun kurucu Izawa-kun şimşek gibi\Nbir uzun pas yolluyor!
Dialogue: 0,0:20:33.17,0:20:34.04,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:34.58,0:20:38.05,Default,,0,0,0,,Kanat oyuncusu Taki-kun,\Nkendine has şekliyle top sürüyor!{Taki is actually more of a winger} {exactly, lead winger / winger would be more suitable here. they use taki as a winger and sometimes isnside forward or like a second striker}
Dialogue: 0,0:20:38.05,0:20:41.92,Default,,0,0,0,,Ne? Topu orta sahadaki\NIzawa-kun'a geri gönderdi.
Dialogue: 0,0:20:41.92,0:20:43.51,Default,,0,0,0,,Şut mu çekecek?
Dialogue: 0,0:20:44.14,0:20:46.26,Default,,0,0,0,,Hayır, topu defansın üzerinden aşırttı.
Dialogue: 0,0:20:46.26,0:20:50.27,Default,,0,0,0,,Topu almak için Kisugi-kun\Ndavranıyor ve voleyi yapıştırıyor!
Dialogue: 0,0:20:51.35,0:20:54.40,Default,,0,0,0,,Seken top kornere gidiyor!{is that a term for going out of bounds?}
Dialogue: 0,0:20:57.11,0:20:59.36,Default,,0,0,0,,Uzatmalardaki ilk korner vuruşu.
Dialogue: 0,0:20:59.36,0:21:01.03,Default,,0,0,0,,Shutetsu için bir fırsat.
Dialogue: 0,0:21:01.03,0:21:02.78,Default,,0,0,0,,Millet, dikkatli olun!
Dialogue: 0,0:21:02.78,0:21:05.87,Default,,0,0,0,,Shutetsu'nun duran topuna karşı\Ndikkatli olmalısınız!
Dialogue: 0,0:21:10.91,0:21:12.04,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:21:12.04,0:21:13.41,Default,,0,0,0,,Yolla Taki!{Come on} {the best way to put it is "here, Taki!"}
Dialogue: 0,0:21:13.41,0:21:17.95,Default,,0,0,0,,Ne?! Kaleci Wakabayashi-kun,\Natağa katılmaya geldi!
Dialogue: 0,0:21:18.92,0:21:22.09,Default,,0,0,0,,Wakabayashi-kun'a orta geldi!
Dialogue: 0,0:21:24.63,0:21:25.59,Default,,0,0,0,,Vurdu!
Dialogue: 0,0:21:25.59,0:21:29.39,Default,,0,0,0,,Her oyuncudan daha güçlü bir vuruş!
Dialogue: 0,0:21:31.14,0:21:34.10,Default,,0,0,0,,Wakabayashi-kun, güzel şut!
Dialogue: 0,0:21:34.77,0:21:36.10,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:21:36.10,0:21:39.11,Default,,0,0,0,,2-1! Shutetsu öne geçti!
Dialogue: 0,0:21:39.11,0:21:43.61,Default,,0,0,0,,Maçın kazananı bu golle belli oldu!{A score you might even say decisive for the victory!}
Dialogue: 0,0:21:43.61,0:21:47.07,Default,,0,0,0,,Kaptan. Kalan zamanda kuş kafesi uygularsak...
Dialogue: 0,0:21:47.07,0:21:49.49,Default,,0,0,0,,Kuş kafesini çok mu seviyorsunuz?
Dialogue: 0,0:21:50.37,0:21:54.71,Default,,0,0,0,,Yeter artık. Kaçmak için bir strateji o.
Dialogue: 0,0:21:54.71,0:21:56.12,Default,,0,0,0,,Bu golü korumak yerine...
Dialogue: 0,0:21:56.12,0:21:59.63,Default,,0,0,0,,...bir tane daha atıp\Nzaferi garantilemeyelim mi?
Dialogue: 0,0:21:59.63,0:22:01.00,Default,,0,0,0,,Kaptan!{chorus again!}
Dialogue: 0,0:22:01.00,0:22:05.34,Default,,0,0,0,,İnanılmaz. Gerçekten de\NWakabayashi-kun inanılmaz.
Dialogue: 0,0:22:05.34,0:22:09.43,Default,,0,0,0,,Ama maç hala bitmedi. Şimdi bizim sıramız.
Dialogue: 0,0:22:09.43,0:22:10.51,Default,,0,0,0,,Evet!{chorus ends again}
Dialogue: 0,0:22:11.18,0:22:15.06,Default,,0,0,0,,Ben girdiğim için\Nkaybettiklerini söyletmeyeceğim.
Dialogue: 0,0:22:15.73,0:22:18.65,Default,,0,0,0,,Tamamdır! Karşı atak vakti!
Dialogue: 0,0:22:20.54,0:22:25.32,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
