Comment: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,PART A:
Comment: 0,0:12:53.12,0:12:55.12,Default,,0,0,0,,PART B:
Dialogue: 0,0:00:01.43,0:00:02.54,Default,,0,0,0,,Menejer!
Dialogue: 0,0:00:02.54,0:00:04.97,Default,,0,0,0,,Lütfen şu konuştuğumuz şeyi getirebilir misiniz?
Dialogue: 0,0:00:04.97,0:00:05.98,Default,,0,0,0,,Evet.
Dialogue: 0,0:00:05.98,0:00:08.95,Default,,0,0,0,,Tanıdık bir tat. Karımın gurur duyduğu,
Dialogue: 0,0:00:08.95,0:00:11.91,Default,,0,0,0,,süt ve balla yaptığı dayanıklılık içeceği.
Dialogue: 0,0:00:11.91,0:00:14.41,Default,,0,0,0,,İçtiğinizden emin olun! Maça götürün!
Dialogue: 0,0:00:14.41,0:00:15.37,Default,,0,0,0,,Evet!
Dialogue: 0,0:00:15.37,0:00:17.47,Default,,0,0,0,,Bu gerçekten bizi maçtan önce harekete geçiriyor.
Dialogue: 0,0:00:17.47,0:00:19.46,Default,,0,0,0,,Bu içecek olmadan yapamazdık koç!
Dialogue: 0,0:00:20.04,0:00:21.12,Default,,0,0,0,,Gerçekten öyle mi düşünüyorsun?
Dialogue: 0,0:00:21.12,0:00:22.92,Default,,0,0,0,,Buyur Matsuyama-kun.
Dialogue: 0,0:00:22.92,0:00:24.08,Default,,0,0,0,,Ah teşekkür ederim!
Dialogue: 0,0:00:26.71,0:00:33.05,Default,,0,0,0,,Bu arada, bu bizimle ilgileneceğin son turnuva. Değil mi, Fujisawa?
Dialogue: 0,0:00:34.16,0:00:35.05,Default,,0,0,0,,Evet...
Dialogue: 0,0:00:37.56,0:00:40.31,Default,,0,0,0,,{\i1}Adamım, soğuk.{\i0}
Dialogue: 0,0:00:40.31,0:00:42.56,Default,,0,0,0,,{\i1}Kalın kıyafetler giymişken kar yağdığında, terlemeye{\i0}
Dialogue: 0,0:00:42.56,0:00:44.73,Default,,0,0,0,,{\i1}ve daha soğuk hissetmeye başlarsın.{\i0}
Dialogue: 0,0:00:44.73,0:00:47.56,Default,,0,0,0,,{\i1}İşte Matsuyama-kun, Oda-kun. Bunları alın.{\i0}
Dialogue: 0,0:00:48.23,0:00:50.26,Default,,0,0,0,,{\i1}Terinizi bununla silin.{\i0}
Dialogue: 0,0:00:50.26,0:00:51.53,Default,,0,0,0,,{\i1} Teşekkürler.{\i0}
Dialogue: 0,0:00:53.28,0:00:54.61,Default,,0,0,0,,{\i1} Sıcak! {\i0}
Dialogue: 0,0:00:54.61,0:00:57.62,Default,,0,0,0,,{\i1}Yoshiko onları sizin için ocağın önünde ısıtmıştı.{\i0}
Dialogue: 0,0:00:57.62,0:01:00.33,Default,,0,0,0,,{\i1}Öyle mi? Çok düşüncelisin.{\i0}
Dialogue: 0,0:01:05.06,0:01:12.22,Default,,0,0,0,,{\i1}Yoshiko Fujisawa, babasının işi \Nnedeniyle ikinci dönemde Amerikaya taşınacak.{\i0}
Dialogue: 0,0:01:16.85,0:01:19.10,Default,,0,0,0,,Transferinden önceki son anın olarak,
Dialogue: 0,0:01:19.10,0:01:22.55,Default,,0,0,0,,nasıl ulusal şampiyon olduğumuzu göstereceğim.
Dialogue: 0,0:01:22.55,0:01:23.60,Default,,0,0,0,,Evet.
Dialogue: 0,0:01:26.14,0:01:27.70,Default,,0,0,0,,Hadi, bana biraz ver!
Dialogue: 0,0:01:27.70,0:01:29.11,Default,,0,0,0,,Ah, üzgünüm.
Dialogue: 0,0:01:29.11,0:01:33.90,Default,,0,0,0,,Sıcaklık nedeniyle oyunda dayanıklılığınızı harcamayın.
Dialogue: 0,0:01:33.90,0:01:37.41,Default,,0,0,0,,Ne de olsa böyle boğucu havalara alışık değiliz.
Dialogue: 0,0:01:37.41,0:01:39.46,Default,,0,0,0,,Her şey yoluna girecek koç.
Dialogue: 0,0:01:39.46,0:01:41.44,Default,,0,0,0,,Şimdiye kadar kimse yıpranmadı ve
Dialogue: 0,0:01:41.44,0:01:43.41,Default,,0,0,0,,herkes kendi rekorlarını geliştiriyor.
Dialogue: 0,0:01:43.41,0:01:44.69,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:01:44.69,0:01:47.12,Default,,0,0,0,,Ayrıca, güzel eşinizin bizim için yaptığı
Dialogue: 0,0:01:47.12,0:01:49.52,Default,,0,0,0,,bu dayanıklılık içeceği de var.
Dialogue: 0,0:01:49.52,0:01:50.67,Default,,0,0,0,,Seni küçük...
Dialogue: 0,0:01:52.30,0:01:54.63,Default,,0,0,0,,Ama millet, ne kadar çok kazanırsak ve
Dialogue: 0,0:01:54.63,0:01:56.97,Default,,0,0,0,,ilerlersek, rakiplerimiz o kadar güçlü olacak.
Dialogue: 0,0:01:56.97,0:01:58.26,Default,,0,0,0,,Gardınızı düşürmeyin.
Dialogue: 0,0:01:58.76,0:02:01.04,Default,,0,0,0,,Bugünkü rakibiniz Minamiuwa, dengeli bir 
Dialogue: 0,0:02:01.04,0:02:03.31,Default,,0,0,0,,hücuma ve savunmaya sahip iyi bir takım.
Dialogue: 0,0:02:04.06,0:02:09.06,Default,,0,0,0,,{\fad(500,500)\pos(490.667,894)}FW, TAKEI
Dialogue: 0,0:02:04.06,0:02:09.06,Default,,0,0,0,,{\fad(500,500)\pos(1416,894)}KAPTAN, ISHIDA
Dialogue: 0,0:02:03.31,0:02:06.62,Default-TOP,,0,0,0,,Kaptanları Ishida'nın tekniğine ve orta sahadaki
Dialogue: 0,0:02:06.62,0:02:09.94,Default-TOP,,0,0,0,,Takei'nin güçlü kafa vuruşlarına özellikle dikkat edin.
Dialogue: 0,0:02:09.94,0:02:11.36,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:11.36,0:02:14.58,Default,,0,0,0,,Tamamdır! Kazanırsak, Nankatsu'ya karşı oynayacağız.
Dialogue: 0,0:02:14.58,0:02:17.77,Default,,0,0,0,,Oraya gitmek için Minamiuwa'yı tamamen parçalamalıyız!
Dialogue: 0,0:02:17.77,0:02:18.70,Default,,0,0,0,,Evet!
Dialogue: 0,0:02:19.57,0:02:20.98,Default,,0,0,0,,{\i1}Yoshiko...{\i0}
Dialogue: 0,0:02:20.98,0:02:23.83,Default,,0,0,0,,{\i1}Matsuyama'ya açılıp onu sevdiğini söylemeyecek misin?{\i0}
Dialogue: 0,0:02:23.83,0:02:27.14,Default,,0,0,0,,{\i1}Bugün yapamazsan, o zaman...{\i0}
Dialogue: 0,0:02:29.00,0:02:44.00,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \N{\c&HB1351A&}İnstagram: AnimeSeverlerrr
Dialogue: 0,0:03:59.76,0:04:05.51,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}40. BÖLÜM: \NFURANO SAVAŞIYOR
Dialogue: 0,0:04:00.96,0:04:04.74,Default-TOP,,0,0,0,,{\i1}Ulusal Ortaokul Futbol Turnuvası çeyrek finallerinin ikinci maçı.{\i0}
Dialogue: 0,0:04:04.74,0:04:08.51,Default-TOP,,0,0,0,,{\i1}Toho Akademi ile Chubu MS arasındaki maç bitmek üzere.{\i0}
Dialogue: 0,0:04:08.51,0:04:11.18,Default,,0,0,0,,{\i1}Toho, birinci sınıf oyuncuları Sawada'yı {\i0}
Dialogue: 0,0:04:11.18,0:04:13.85,Default,,0,0,0,,{\i1}bugünde hücumun merkezi yapıyor.{\i0}
Dialogue: 0,0:04:13.85,0:04:15.61,Default,,0,0,0,,{\i1}Gerçekten hızlı bir gelişme döneminde!{\i0}
Dialogue: 0,0:04:15.61,0:04:18.24,Default,,0,0,0,,{\i1}Toho zaferlerini toparlarken, Sawada-kun{\i0}
Dialogue: 0,0:04:18.24,0:04:20.86,Default,,0,0,0,,{\i1}becerilerini geliştirmeye devam ediyor.{\i0}
Dialogue: 0,0:04:20.86,0:04:21.44,Default,,0,0,0,,Al hadi!
Dialogue: 0,0:04:21.44,0:04:22.78,Default,,0,0,0,,Tamam!
Dialogue: 0,0:04:22.78,0:04:27.29,Default,,0,0,0,,{\i1}Orta forvet Sorimachi, bankta \Noturan Hyuga'nın rolünü üstlendi.{\i0}
Dialogue: 0,0:04:27.29,0:04:29.37,Default,,0,0,0,,{\i1}Sawada ile tamamen uyumlu.{\i0}
Dialogue: 0,0:04:31.64,0:04:33.52,Default,,0,0,0,,{\i1}Mükemmel!{\i0}
Dialogue: 0,0:04:33.52,0:04:35.50,Default,,0,0,0,,{\i1}Sorimachi, azalan dakikalarda \Nölüm darbesi gibi üçüncü bir gol attı!{\i0}
Dialogue: 0,0:04:35.50,0:04:37.25,Default-TOP,,0,0,0,,FURANO ORTAOKULU \N HOKKAİDO
Dialogue: 0,0:04:35.50,0:04:39.75,Default,,0,0,0,,{\i1}Hyuga olmasa bile, Toho'nun \Nsaldırgan gücü kesinlikle azalmıyor!{\i0}
Dialogue: 0,0:04:39.75,0:04:41.27,Default,,0,0,0,,{\i1}Sorun ne, Hyuga?{\i0}
Dialogue: 0,0:04:41.27,0:04:44.18,Default,,0,0,0,,{\i1}Bankta oturuyorsun... Neden dışarı çıkıp oynamıyorsun?{\i0}
Dialogue: 0,0:04:45.28,0:04:47.26,Default,,0,0,0,,{\i1}Ama Chubu pes etmiyor!{\i0}
Dialogue: 0,0:04:47.26,0:04:49.26,Default,,0,0,0,,{\i1}Toho'nun kalesine saldırmaya devam ediyorlar.{\i0}
Dialogue: 0,0:04:49.26,0:04:51.98,Default,,0,0,0,,{\i1}Ancak Toho'nun bu adamı var.{\i0}
Dialogue: 0,0:04:51.98,0:04:54.92,Default,,0,0,0,,{\i1}Temiz bir sayfası olan adam, Ken Wakashimazu!{\i0} 
Dialogue: 0,0:04:54.92,0:04:57.37,Default,,0,0,0,,{\i1}Bu turnuvada henüz kimse ona gol atamadı.{\i0}
Dialogue: 0,0:04:57.37,0:04:59.19,Default,,0,0,0,,{\i1}Aynı zamanda yedek kaptan.{\i0}
Dialogue: 0,0:04:59.19,0:05:00.78,Default,,0,0,0,,{\i1}Gel bakalım...!{\i0}
Dialogue: 0,0:05:01.59,0:05:03.90,Default,,0,0,0,,{\i1}Kalenin önünde top havalanıyor.{\i0}
Dialogue: 0,0:05:05.62,0:05:06.32,Default,,0,0,0,,Ne?
Dialogue: 0,0:05:06.32,0:05:08.99,Default,,0,0,0,,{\i1}Wakashimazu kolayca yakalıyor.{\i0}
Dialogue: 0,0:05:08.99,0:05:09.78,Default,,0,0,0,,Faydası yok.
Dialogue: 0,0:05:09.78,0:05:11.78,Default,,0,0,0,,Onu havada da yenemeyiz.
Dialogue: 0,0:05:13.03,0:05:14.79,Default,,0,0,0,,{\i1}Oyun bitti!{\i0}
Dialogue: 0,0:05:14.79,0:05:16.55,Default,,0,0,0,,{\i1}Başardık! Kazandık!{\i0}
Dialogue: 0,0:05:16.55,0:05:17.75,Default,,0,0,0,,{\i1}En iyi dört içindeyiz!{\i0}
Dialogue: 0,0:05:17.75,0:05:19.45,Default,,0,0,0,,{\i1}3-0!{\i0}
Dialogue: 0,0:05:19.45,0:05:21.38,Default,,0,0,0,,{\i1}Toho Akademi kazandı!{\i0}
Dialogue: 0,0:05:21.38,0:05:25.09,Default,,0,0,0,,{\i1}Ve Wakashimazu dördüncü \Noyunu boyunca temiz bir sayfasını koruyor!{\i0}
Dialogue: 0,0:05:25.09,0:05:27.84,Default,,0,0,0,,Başardık!
Dialogue: 0,0:05:27.84,0:05:30.68,Default,,0,0,0,,{\i1}Finallere kadar bir oyun daha var.{\i0}
Dialogue: 0,0:05:31.24,0:05:33.44,Default,,0,0,0,,{\i1}Toho'daki her oyuncu Hyuga'nın yokluğunu{\i0}
Dialogue: 0,0:05:33.44,0:05:35.56,Default,,0,0,0,,{\i1}telafi etmek için elinden geleni yapıyor.{\i0}
Dialogue: 0,0:05:35.56,0:05:38.75,Default,,0,0,0,,{\i1}Becerilerini geliştirmeye devam ediyorlar.{\i0}
Dialogue: 0,0:05:38.75,0:05:43.37,Default,,0,0,0,,{\i1}Güçlenmiş Hyuga'yı eklerlersek ne tür bir takım olacaklar?{\i0}
Dialogue: 0,0:05:44.87,0:05:47.82,Default,,0,0,0,,{\i1}Korkunç ve güçlü bir takım olduklarından eminler.{\i0}
Dialogue: 0,0:05:50.41,0:05:53.30,Default,,0,0,0,,Tamamdır! Sırada biz varız!
Dialogue: 0,0:05:53.30,0:05:54.54,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:56.52,0:05:58.58,Default,,0,0,0,,Matsuyama-kun, bir saniye bekle.
Dialogue: 0,0:05:59.38,0:06:00.32,Default,,0,0,0,,Noldu?
Dialogue: 0,0:06:02.10,0:06:03.09,Default,,0,0,0,,Yoshiko...
Dialogue: 0,0:06:05.34,0:06:07.84,Default,,0,0,0,,Sorun nedir? Bana ihtiyacın mı var?
Dialogue: 0,0:06:09.21,0:06:10.92,Default,,0,0,0,,Hadi, Yoshiko!
Dialogue: 0,0:06:10.92,0:06:11.85,Default,,0,0,0,,Evet.
Dialogue: 0,0:06:12.78,0:06:14.70,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:06:14.70,0:06:16.10,Default,,0,0,0,,Ne yapıyorsun?
Dialogue: 0,0:06:16.10,0:06:17.22,Default,,0,0,0,,Acele et!
Dialogue: 0,0:06:17.22,0:06:19.10,Default,,0,0,0,,Tamam geliyorum!
Dialogue: 0,0:06:19.70,0:06:21.36,Default,,0,0,0,,Hey, ne oldu?
Dialogue: 0,0:06:24.26,0:06:27.11,Default,,0,0,0,,E-Elinizden geleni yapın ve bugün de kazanın!
Dialogue: 0,0:06:27.11,0:06:29.36,Default,,0,0,0,,T-Tamam...
Dialogue: 0,0:06:29.36,0:06:30.62,Default,,0,0,0,,Hepsi bu mu?
Dialogue: 0,0:06:31.97,0:06:32.91,Default,,0,0,0,,Evet.
Dialogue: 0,0:06:33.83,0:06:35.45,Default,,0,0,0,,Tabii ki kazanacağım.
Dialogue: 0,0:06:37.08,0:06:39.08,Default,,0,0,0,,{\i1}Bu da neydi?{\i0}
Dialogue: 0,0:06:39.08,0:06:40.73,Default,,0,0,0,,Tamam! İşte gidiyoruz millet!
Dialogue: 0,0:06:40.73,0:06:42.05,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:43.49,0:06:45.09,Default,,0,0,0,,Ah, sen...
Dialogue: 0,0:06:45.53,0:06:47.94,Default,,0,0,0,,{\i1}Bu benim için sorun değil.{\i0}
Dialogue: 0,0:06:49.06,0:06:52.45,Default,,0,0,0,,{\i1}Sonuçta, Matsuyama-kun şu anda{\i0}
Dialogue: 0,0:06:52.45,0:06:55.85,Default,,0,0,0,,{\i1}bu maçı nasıl kazanacağını düşünüyor.{\i0}
Dialogue: 0,0:06:58.35,0:06:59.56,Default,,0,0,0,,Gidelim Furano!
Dialogue: 0,0:06:59.56,0:07:01.28,Default,,0,0,0,,Savaş, Furano!
Dialogue: 0,0:07:01.28,0:07:02.98,Default,,0,0,0,,Evet! Evet! Evet!
Dialogue: 0,0:07:02.98,0:07:05.98,Default,,0,0,0,,{\i1}Her zamanki gibi yüksek sesle bağırıyorlar.{\i0}
Dialogue: 0,0:07:05.98,0:07:07.98,Default,,0,0,0,,{\i1}Furano Eleven, Hokkaido'yu temsil ediyor!{\i0}
Dialogue: 0,0:07:07.98,0:07:11.61,Default,,0,0,0,,İyi şanslar, iyi şanslar Furano!
Dialogue: 0,0:07:11.61,0:07:16.49,Default,,0,0,0,,{\i1}Rakipleri, Ehime'den Minamiuwa\N MS, sessizce onları bekliyor.{\i0}
Dialogue: 0,0:07:16.49,0:07:18.23,Default,,0,0,0,,{\i1}Her şey iyi.{\i0}
Dialogue: 0,0:07:18.23,0:07:20.01,Default,,0,0,0,,{\i1}Furano'yu yeneceğiz ve en iyi dört arasında olacağız.{\i0}
Dialogue: 0,0:07:20.01,0:07:23.58,Default,,0,0,0,,{\i1}Sonra da önceki şampiyon Nankatsu'ya karşı oynayacağız.{\i0}
Dialogue: 0,0:07:23.58,0:07:27.36,Default,,0,0,0,,{\i1}Bu, yarı finallerde üçüncü çeyrek final maçı.{\i0}
Dialogue: 0,0:07:27.36,0:07:29.47,Default,,0,0,0,,{\i1}Furano MS vs. Minamiuwa MS.{\i0}
Dialogue: 0,0:07:29.47,0:07:31.01,Default,,0,0,0,,{\i1}Oyun başlıyor!{\i0}
Dialogue: 0,0:07:32.13,0:07:34.47,Default,,0,0,0,,{\i1}İlk önce Furano topu aldı.{\i0}
Dialogue: 0,0:07:34.47,0:07:37.12,Default,,0,0,0,,Tamamdır. Bugün de ilk golü atacağız.
Dialogue: 0,0:07:37.12,0:07:37.77,Default,,0,0,0,,Evet!
Dialogue: 0,0:07:37.77,0:07:39.39,Default,,0,0,0,,Hadi Matsuyama!
Dialogue: 0,0:07:39.39,0:07:43.13,Default,,0,0,0,,{\i1}Minamiuwa'nın kaptanı İshida onu kontrol etmeye gidiyor!{\i0}
Dialogue: 0,0:07:43.13,0:07:45.65,Default,,0,0,0,,{\i1}Kaptanlar arasında bire bir mücadele mi var?{\i0}
Dialogue: 0,0:07:45.65,0:07:46.90,Default,,0,0,0,,İşte, Wakamatsu!
Dialogue: 0,0:07:48.86,0:07:50.95,Default,,0,0,0,,Bana karşı çıkmaktan korkuyor musun?
Dialogue: 0,0:07:50.95,0:07:53.50,Default,,0,0,0,,Senden korktuğum falan yok.
Dialogue: 0,0:07:53.50,0:07:56.16,Default,,0,0,0,,Ama futbol bir takım sporudur. Bu kadar.
Dialogue: 0,0:07:56.62,0:07:58.62,Default,,0,0,0,,Bundan emin misin?
Dialogue: 0,0:07:59.20,0:08:02.12,Default,,0,0,0,,Arkadaşlarına güvendiğini söylersen daha iyi olur,
Dialogue: 0,0:08:02.12,0:08:04.31,Default,,0,0,0,,ama bu aslında topu kontrol etme
Dialogue: 0,0:08:04.31,0:08:06.50,Default,,0,0,0,,becerilerine güvenmediğin anlamına gelmiyor mu?
Dialogue: 0,0:08:07.30,0:08:10.17,Default,,0,0,0,,{\i1}Minamiuwa bu sefer usta bir pas veriyor.{\i0}
Dialogue: 0,0:08:10.17,0:08:11.67,Default,,0,0,0,,Tamam, hadi!
Dialogue: 0,0:08:11.67,0:08:14.47,Default,,0,0,0,,{\i1}Bir dakika geciktirmeden topu \Nkaptanları Ishida'ya gönderiyorlar.{\i0}
Dialogue: 0,0:08:15.22,0:08:16.72,Default,,0,0,0,,Tek seferde yapacağım!
Dialogue: 0,0:08:16.72,0:08:17.93,Default,,0,0,0,,Herkes geri çekilsin!
Dialogue: 0,0:08:17.93,0:08:22.44,Default,,0,0,0,,{\i1}Ishida tekniği ile tanınır ve solo top sürme ile saldırır.{\i0}
Dialogue: 0,0:08:22.44,0:08:25.19,Default,,0,0,0,,{\i1}Furano onu Matsuyama'nın emri \Naltında markaja almaya gidiyor.{\i0}
Dialogue: 0,0:08:25.19,0:08:27.98,Default,,0,0,0,,{\i1}Ancak, Minamiuwa hemen etraflarını sarar.{\i0}
Dialogue: 0,0:08:27.98,0:08:29.36,Default,,0,0,0,,Ishida!
Dialogue: 0,0:08:31.25,0:08:33.51,Default,,0,0,0,,{\i1}Ishida ortayı kırar!{\i0}
Dialogue: 0,0:08:33.51,0:08:36.07,Default,,0,0,0,,{\i1}Furano topu paslayacağını düşündü, geçmesine izin verdi!{\i0}
Dialogue: 0,0:08:36.07,0:08:37.99,Default,,0,0,0,,{\i1}Lanet olsun! Bize yukarıdan bakıyor!{\i0}
Dialogue: 0,0:08:39.03,0:08:39.74,Default,,0,0,0,,Git!
Dialogue: 0,0:08:39.74,0:08:42.25,Default,,0,0,0,,{\i1}Ancak, Ishida, kaleyi kısa hedefledi.{\i0}
Dialogue: 0,0:08:43.01,0:08:46.50,Default,,0,0,0,,{\i1}Matsuyama'nın mücadelesinden \Nkaçmak için umutsuz bir taktik mi?{\i0}
Dialogue: 0,0:08:46.50,0:08:47.97,Default,,0,0,0,,{\i1}Topu sadece havaya mı attı?{\i0}
Dialogue: 0,0:08:47.97,0:08:48.92,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:50.76,0:08:51.73,Default,,0,0,0,,İşte gidiyorum!
Dialogue: 0,0:08:51.73,0:08:54.15,Default,,0,0,0,,{\i1}Bir oyuncu kenardan koşuyor!{\i0}
Dialogue: 0,0:08:54.15,0:08:56.76,Default,,0,0,0,,{\i1}Bu Minamiuwa'nın orta forveti, Takei!{\i0}
Dialogue: 0,0:08:56.76,0:08:58.51,Default,,0,0,0,,İyi! Devam et, Takei!
Dialogue: 0,0:08:58.51,0:08:59.14,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:59.98,0:09:01.51,Default,,0,0,0,,{\i1}Takei zıplıyor!{\i0}
Dialogue: 0,0:09:01.51,0:09:04.10,Default,,0,0,0,,{\i1}Onunla kaleci arasındaki havada bir düello.{\i0}
Dialogue: 0,0:09:07.24,0:09:08.59,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:09:08.59,0:09:10.34,Default,,0,0,0,,{\i1}Minamiuwa skoru açıyor.{\i0}
Dialogue: 0,0:09:10.34,0:09:11.86,Default,,0,0,0,,{\i1}Takei düelloyu kazandı!{\i0}
Dialogue: 0,0:09:12.78,0:09:14.45,Default,,0,0,0,,Furano'nun önüne mi geçtiler?
Dialogue: 0,0:09:14.45,0:09:16.20,Default,,0,0,0,,Başardın Takei!
Dialogue: 0,0:09:16.20,0:09:17.05,Default,,0,0,0,,Öyle.
Dialogue: 0,0:09:17.05,0:09:19.66,Default,,0,0,0,,Şampiyonluğa rakip olmak\N benim için hiçbir şey ifade etmiyor!
Dialogue: 0,0:09:19.66,0:09:22.31,Default,,0,0,0,,{\i1}Bu beklenmeyen bir gelişme!{\i0}
Dialogue: 0,0:09:22.31,0:09:26.71,Default,,0,0,0,,{\i1}Turnuvada ilk kez Furano ilk golü bıraktı.{\i0}
Dialogue: 0,0:09:26.71,0:09:28.46,Default,,0,0,0,,Matsuyama-kun...
Dialogue: 0,0:09:28.46,0:09:31.88,Default,,0,0,0,,{\i1}Zayıf takım olarak görülmesine \Nrağmen, Minamiuwa girişimi başlattı!{\i0}
Dialogue: 0,0:09:31.88,0:09:36.38,Default,,0,0,0,,{\i1}Furano bundan sonra nasıl ayağa kalkacak?{\i0}
Dialogue: 0,0:09:36.38,0:09:39.01,Default,,0,0,0,,{\i1}Lütfen kazan, Matsuyama-kun. Lütfen... {\i0}
Dialogue: 0,0:09:41.47,0:09:44.34,Default,,0,0,0,,{\i1}Furano kendini toparlar ve saldırır.{\i0}
Dialogue: 0,0:09:45.60,0:09:46.73,Default,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:09:49.56,0:09:50.30,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:09:50.30,0:09:52.19,Default,,0,0,0,,{\i1}Minamiuwa pasları tekrar kesti.{\i0}
Dialogue: 0,0:09:52.19,0:09:54.04,Default,,0,0,0,,Bir kez daha! Bir tane atalım!
Dialogue: 0,0:09:54.04,0:09:56.15,Default,,0,0,0,,{\i1}Bu ilk gol morallerini artırdı mı?{\i0}
Dialogue: 0,0:09:56.15,0:09:58.15,Default,,0,0,0,,{\i1}Minamiuwa'nın güzel hareketleri var.{\i0}
Dialogue: 0,0:09:58.15,0:10:00.66,Default,,0,0,0,,Millet! İlk golü kaybettik diye panik yapmayın.
Dialogue: 0,0:10:00.66,0:10:03.24,Default,,0,0,0,,Sakin olun ve onlara eğitimimizin sonuçlarını gösterin!
Dialogue: 0,0:10:03.24,0:10:04.37,Default,,0,0,0,,Evet!
Dialogue: 0,0:10:04.95,0:10:06.33,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:06.33,0:10:07.78,Default,,0,0,0,,{\i1}Furano'nun ruh halinin Matsuyama'nın sözlerinden{\i0}
Dialogue: 0,0:10:07.78,0:10:09.22,Default,,0,0,0,,{\i1}sonra değişip değişmediğini merak ediyorum.{\i0}
Dialogue: 0,0:10:09.22,0:10:11.06,Default,,0,0,0,,{\i1}Bu sefer pası kestiler.{\i0}
Dialogue: 0,0:10:11.06,0:10:12.25,Default,,0,0,0,,Senin için kaptan!
Dialogue: 0,0:10:12.25,0:10:13.55,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:13.55,0:10:16.64,Default,,0,0,0,,{\i1}Şu anda paslarımızı tamamen okuyorlar.{\i0}
Dialogue: 0,0:10:16.64,0:10:17.34,Default,,0,0,0,,{\i1}Eğer öyleyse... {\i0}
Dialogue: 0,0:10:19.55,0:10:20.40,Default,,0,0,0,,{\i1}O zaman kendim yaparım!{\i0}
Dialogue: 0,0:10:20.40,0:10:22.40,Default,,0,0,0,,{\i1}Matsuyama, rakip kaleye hızla koşuyor!{\i0}
Dialogue: 0,0:10:22.40,0:10:24.81,Default,,0,0,0,,{\i1}Akıcı top sürme yeteneklerini gösteriyor!{\i0}
Dialogue: 0,0:10:24.81,0:10:27.14,Default,,0,0,0,,Saçmalık! Pas vermedi!
Dialogue: 0,0:10:27.14,0:10:29.65,Default,,0,0,0,,{\i1}Matsuyama devam edecek ve şut atacak mı?{\i0}
Dialogue: 0,0:10:30.23,0:10:31.60,Default,,0,0,0,,Bu senin için Matsuyama.
Dialogue: 0,0:10:31.60,0:10:33.67,Default,,0,0,0,,Çok kötü, bunu yapmaya çalışacağını biliyordum!
Dialogue: 0,0:10:33.67,0:10:35.40,Default,,0,0,0,,Şut çekmene izin vermeyeceğim!
Dialogue: 0,0:10:36.61,0:10:40.61,Default,,0,0,0,,{\i1}Şut çekeceğini düşündüğümüzde, Matsuyama pas verdi!{\i0}
Dialogue: 0,0:10:40.61,0:10:41.45,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:41.45,0:10:43.12,Default,,0,0,0,,Oda! Yardım edin!
Dialogue: 0,0:10:43.54,0:10:45.66,Default,,0,0,0,,{\i1}Top boştaki Odaya gidiyor!{\i0}
Dialogue: 0,0:10:45.66,0:10:47.38,Default,,0,0,0,,Tamam! Ben hallederim!
Dialogue: 0,0:10:47.38,0:10:49.58,Default,,0,0,0,,{\i1}Oda nişan alıyor ve vuruyor!{\i0}
Dialogue: 0,0:10:50.25,0:10:52.53,Default,,0,0,0,,{\i1}Iskalıyor!{\i0}
Dialogue: 0,0:10:53.21,0:10:54.55,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:54.55,0:10:56.42,Default,,0,0,0,,Şanslıydım.
Dialogue: 0,0:10:57.36,0:10:58.65,Default,,0,0,0,,Aldırma! Aldırma!
Dialogue: 0,0:10:58.65,0:11:01.48,Default,,0,0,0,,Merak etme. Olur böyle şeyler.
Dialogue: 0,0:11:01.48,0:11:02.93,Default,,0,0,0,,Ü-Üzgünüm.
Dialogue: 0,0:11:03.86,0:11:05.93,Default,,0,0,0,,{\i1}Görünüşe göre talih bizim tarafımızda.{\i0}
Dialogue: 0,0:11:09.19,0:11:10.98,Default,,0,0,0,,Tamam, başka bir gol için gidelim!
Dialogue: 0,0:11:11.42,0:11:13.03,Default,,0,0,0,,{\i1}Minamiuwa için bir şans.{\i0}
Dialogue: 0,0:11:13.03,0:11:15.77,Default,,0,0,0,,{\i1}Ishida topu kaleye doğru gönderdi.{\i0}
Dialogue: 0,0:11:15.77,0:11:17.65,Default,,0,0,0,,Gerçekten aynı numaraya düşeceğimizi mi düşünüyorsun?
Dialogue: 0,0:11:17.65,0:11:18.82,Default,,0,0,0,,Furano'yu...
Dialogue: 0,0:11:18.82,0:11:19.99,Default,,0,0,0,,Hafife alma!
Dialogue: 0,0:11:22.03,0:11:24.66,Default,,0,0,0,,{\i1}Bu sefer, tüm savunmacılar saldırıyı durduruyor.{\i0}
Dialogue: 0,0:11:26.66,0:11:28.15,Default,,0,0,0,,Güzel savunma!
Dialogue: 0,0:11:28.15,0:11:30.33,Default,,0,0,0,,{\i1}Furano bu sefer kalelerini koruyor.{\i0}
Dialogue: 0,0:11:30.33,0:11:33.33,Default,,0,0,0,,Hehh. Bu oldukça tehlikeliydi.
Dialogue: 0,0:11:33.33,0:11:35.48,Default,,0,0,0,,Furano beklenmedik bir şekilde zor anlar yaşıyor.
Dialogue: 0,0:11:35.48,0:11:37.24,Default,,0,0,0,,Minamiuwa, hah...
Dialogue: 0,0:11:37.24,0:11:39.72,Default,,0,0,0,,"Kara at" dedikleri şey bu olmalı...
Dialogue: 0,0:11:40.10,0:11:41.24,Default,,0,0,0,,{\i1}Doğru. {\i0}
Dialogue: 0,0:11:41.24,0:11:43.45,Default,,0,0,0,,{\i1}Bizim de dikkatli olmamız gerekiyor.{\i0}
Dialogue: 0,0:11:47.22,0:11:48.35,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:11:48.94,0:11:51.44,Default,,0,0,0,,{\i1}İlk yarı burada bitiyor.{\i0}
Dialogue: 0,0:11:51.44,0:11:53.35,Default,,0,0,0,,{\i1}Ne diye oyalanıyorsun?{\i0}
Dialogue: 0,0:11:53.35,0:11:54.87,Default,,0,0,0,,{\i1}1-0!{\i0}
Dialogue: 0,0:11:54.87,0:11:57.36,Default,,0,0,0,,{\i1}Minamiuwa tek golle liderliği ile sona erdi.{\i0}
Dialogue: 0,0:11:57.36,0:12:00.61,Default,,0,0,0,,Hadi gidelim. Biz de ısınmaya başlamalıyız.
Dialogue: 0,0:12:00.61,0:12:01.52,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:01.52,0:12:04.37,Default,,0,0,0,,Karanlık bir ata karşı mücadele etmek istemiyoruz.
Dialogue: 0,0:12:04.37,0:12:07.40,Default,,0,0,0,,Oh hayır! Bu gidişle kaybedeceğiz...
Dialogue: 0,0:12:07.40,0:12:08.02,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:08.02,0:12:09.50,Default,,0,0,0,,Ne demek "evet"?!
Dialogue: 0,0:12:09.50,0:12:15.30,Default,,0,0,0,,Yoshiko, kaybedersek, \NMatsuyama'yı sonsuza dek terk edeceksin!
Dialogue: 0,0:12:16.54,0:12:18.53,Default,,0,0,0,,{\i1}Anladın mı, Yoshiko?{\i0}
Dialogue: 0,0:12:18.53,0:12:21.97,Default,,0,0,0,,{\i1}Baban Amerikada bizi bekliyor.{\i0}
Dialogue: 0,0:12:21.97,0:12:26.77,Default,,0,0,0,,{\i1}Üzgünüm. İlk dönem sona erdikten\N hemen sonra ona katılacaktık, ama—{\i0}
Dialogue: 0,0:12:26.77,0:12:30.25,Default,,0,0,0,,{\i1}Şimdiye kadar bir menejer olarak çok çalıştın, bu yüzden{\i0}
Dialogue: 0,0:12:30.25,0:12:33.73,Default,,0,0,0,,{\i1}son maça kadar onları izlemek istediğini anlıyorum, ama...{\i0}
Dialogue: 0,0:12:33.73,0:12:37.06,Default,,0,0,0,,{\i1}Kaybedersek hemen ayrılacağım.{\i0}
Dialogue: 0,0:12:37.06,0:12:38.80,Default,,0,0,0,,{\i1}Sanırım bu iyi olacak.{\i0}
Dialogue: 0,0:12:38.80,0:12:39.73,Default,,0,0,0,,{\i1}Evet.{\i0}
Dialogue: 0,0:12:41.00,0:12:43.07,Default,,0,0,0,,Matsuyama-kun...
Dialogue: 0,0:12:44.35,0:12:53.12,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:12:53.12,0:12:55.58,Default-TOP,,0,0,0,,MINAMIUWA ORTAOKULU \N EHIME
Dialogue: 0,0:12:54.37,0:12:55.58,Default,,0,0,0,,Tamam millet.
Dialogue: 0,0:12:55.58,0:12:58.09,Default,,0,0,0,,İlk yarıda mükemmel iş çıkardınız.
Dialogue: 0,0:12:58.09,0:13:00.35,Default,,0,0,0,,Hava çok daha sıcak olacak.
Dialogue: 0,0:13:00.35,0:13:02.29,Default,,0,0,0,,Rakibimiz tükenecek.
Dialogue: 0,0:13:02.29,0:13:04.20,Default,,0,0,0,,Plana sadık kalın. Zayıflık göstermeyin!
Dialogue: 0,0:13:04.20,0:13:05.09,Default,,0,0,0,,Evet efendim!
Dialogue: 0,0:13:05.09,0:13:08.14,Default,,0,0,0,,İkinci yarıda bir tane daha gol atıp kazanacağız.
Dialogue: 0,0:13:08.14,0:13:09.10,Default,,0,0,0,,Evet.
Dialogue: 0,0:13:09.10,0:13:10.85,Default-TOP,,0,0,0,,FURANO ORTAOKULU\N HOKKAIDO
Dialogue: 0,0:13:10.85,0:13:13.31,Default,,0,0,0,,Üzgünüm, benim yüzümden.
Dialogue: 0,0:13:13.31,0:13:14.65,Default,,0,0,0,,Eğer onu atsaydım...
Dialogue: 0,0:13:14.65,0:13:16.97,Default,,0,0,0,,Endişe etme, Oda.
Dialogue: 0,0:13:16.97,0:13:17.90,Default,,0,0,0,,Evet.
Dialogue: 0,0:13:17.90,0:13:19.44,Default,,0,0,0,,Sadece ikinci yarıda sıkı çalış.
Dialogue: 0,0:13:19.44,0:13:20.61,Default,,0,0,0,,Tamam.
Dialogue: 0,0:13:20.61,0:13:22.13,Default,,0,0,0,,Hala 30 dakika var.
Dialogue: 0,0:13:22.13,0:13:23.32,Default,,0,0,0,,Sakin olalım ve devam edelim.
Dialogue: 0,0:13:23.32,0:13:25.36,Default,,0,0,0,,Yediğimiz gol hakkında hiçbir şey yapamayız.
Dialogue: 0,0:13:25.36,0:13:27.32,Default,,0,0,0,,İlk önce, skoru eşitlemek zorundayız.
Dialogue: 0,0:13:27.32,0:13:29.80,Default,,0,0,0,,Bunu yaparsak, ritmimizi belirleyebilir ve kazanabiliriz.
Dialogue: 0,0:13:29.80,0:13:31.67,Default,,0,0,0,,Kendinize güvenin, millet!
Dialogue: 0,0:13:31.67,0:13:32.58,Default,,0,0,0,,Evet efendim!
Dialogue: 0,0:13:33.26,0:13:34.38,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:13:34.38,0:13:38.67,Default,,0,0,0,,{\i1}Eğer bu noktada mücadele ediyorsak,\N şampiyon olmamıza imkan yok.{\i0}
Dialogue: 0,0:13:38.67,0:13:39.62,Default,,0,0,0,,Kaybetme!
Dialogue: 0,0:13:39.62,0:13:43.67,Default,,0,0,0,,{\i1}Güneş şimdi daha da parlıyor \Nve hava yaklaşık 36°C derece.{\i0}
Dialogue: 0,0:13:43.67,0:13:47.22,Default,,0,0,0,,{\i1}Aynı zamanda sıcağa karşı bir mücadele olacak.{\i0}
Dialogue: 0,0:13:47.22,0:13:49.72,Default,,0,0,0,,{\i1}İkinci yarı sonunda başlıyor.{\i0}
Dialogue: 0,0:13:49.72,0:13:52.38,Default,,0,0,0,,{\i1}Sana inanıyorum Matsuyama-kun.{\i0}
Dialogue: 0,0:13:52.38,0:13:53.64,Default,,0,0,0,,{\i1}Sana inanıyorum.{\i0}
Dialogue: 0,0:13:55.68,0:13:57.93,Default,,0,0,0,,{\i1}Minamiuwa hırçın bir şekilde saldırıyor! {\i0}
Dialogue: 0,0:13:57.93,0:13:59.46,Default,,0,0,0,,{\i1}İkinci bir golü hedefliyorlar. {\i0}
Dialogue: 0,0:13:59.46,0:14:00.70,Default,,0,0,0,,İşte başlıyoruz!
Dialogue: 0,0:14:00.70,0:14:03.15,Default,,0,0,0,,Başka bir gol atacağız ve bu maçı bitireceğiz.
Dialogue: 0,0:14:03.15,0:14:04.28,Default,,0,0,0,,Aklını kaybetme!
Dialogue: 0,0:14:04.28,0:14:06.36,Default,,0,0,0,,Ne olursa olsun, ikinci gole izin vermeyeceğiz!
Dialogue: 0,0:14:09.82,0:14:12.51,Default,,0,0,0,,{\i1}Minamiuwa gerçekten iyi bir takım.{\i0}
Dialogue: 0,0:14:12.51,0:14:16.33,Default,,0,0,0,,{\i1}Bu oyunu şu ana kadar 1-0'da tutabilmeleri tesadüf değil.{\i0}
Dialogue: 0,0:14:16.33,0:14:18.04,Default,,0,0,0,,{\i1}Öyle tabii.{\i0}
Dialogue: 0,0:14:18.04,0:14:22.33,Default,,0,0,0,,{\i1}Minamiuwa koçluk kariyerimdeki en güçlü takım.{\i0}
Dialogue: 0,0:14:22.33,0:14:25.33,Default,,0,0,0,,{\i1}Shikoku'nun zirvesine geldiler ve şimdi {\i0}
Dialogue: 0,0:14:25.33,0:14:28.34,Default,,0,0,0,,{\i1}bu takım Ulusal Turnuvaya hakim olacak.{\i0}
Dialogue: 0,0:14:29.14,0:14:31.35,Default,,0,0,0,,{\i1}Minamiuwa'dan kusursuz bir saldırı!{\i0}
Dialogue: 0,0:14:31.35,0:14:34.22,Default,,0,0,0,,{\i1}Öte yandan, bu sıcağa alışık olmayan Hokkaido'nun{\i0}
Dialogue: 0,0:14:34.22,0:14:36.89,Default,,0,0,0,,{\i1} Furano'ları dayanıklılıklarını yitirmeye mi başladı?{\i0}
Dialogue: 0,0:14:36.89,0:14:38.13,Default,,0,0,0,,{\i1}Elinizden geleni yapın!{\i0}
Dialogue: 0,0:14:38.13,0:14:39.90,Default,,0,0,0,,{\i1}Dişinizi sıkın millet!{\i0}
Dialogue: 0,0:14:42.15,0:14:44.12,Default,,0,0,0,,{\i1}Sorun nedir Matsuyama?{\i0}
Dialogue: 0,0:14:44.12,0:14:46.44,Default,,0,0,0,,{\i1}Bana geri ödemeyecek miydin?{\i0}
Dialogue: 0,0:14:46.44,0:14:47.64,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:14:47.64,0:14:49.70,Default,,0,0,0,,{\i1}İkinci gölü yersek her şey biter.{\i0}
Dialogue: 0,0:14:49.70,0:14:52.41,Default,,0,0,0,,{\i1}Bunu en çok bilen biziz!{\i0}
Dialogue: 0,0:14:53.42,0:14:54.41,Default,,0,0,0,,{\i1}Topu aldı!{\i0}
Dialogue: 0,0:14:54.41,0:14:57.02,Default,,0,0,0,,{\i1}Takımın kilit taşı, Furano'nun kaptanı Matsuyama!{\i0}
Dialogue: 0,0:14:57.02,0:14:58.71,Default,,0,0,0,,{\i1}Sonunda topu çalmayı başardı!{\i0}
Dialogue: 0,0:15:00.21,0:15:02.47,Default,,0,0,0,,{\i1}Topu tek başına getiriyor!{\i0}
Dialogue: 0,0:15:02.47,0:15:05.92,Default,,0,0,0,,{\i1}Bu turnuvada en iyi top kontrolü \Nolan oyuncu olarak adlandırılıyor.{\i0}
Dialogue: 0,0:15:05.92,0:15:07.38,Default,,0,0,0,,Kaneda!
Dialogue: 0,0:15:07.38,0:15:09.76,Default,,0,0,0,,{\i1}Pasıda ikinci en iyisi!{\i0}
Dialogue: 0,0:15:09.76,0:15:12.76,Default,,0,0,0,,{\i1}Gerçekten, Furano'nun Komutanı, Hikaru Matsuyama!{\i0}
Dialogue: 0,0:15:12.76,0:15:13.97,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:15:14.38,0:15:15.39,Default,,0,0,0,,Güzel pas!
Dialogue: 0,0:15:15.39,0:15:16.42,Default,,0,0,0,,Paslarını okuyun!
Dialogue: 0,0:15:16.42,0:15:17.47,Default,,0,0,0,,Onları durdurmamız gerek!
Dialogue: 0,0:15:19.18,0:15:20.23,Default,,0,0,0,,Al hadi!
Dialogue: 0,0:15:20.23,0:15:24.36,Default,,0,0,0,,{\i1}Genellikle kısa paslarla oynayan Furano'dan nadir uzun bir pas.{\i0}
Dialogue: 0,0:15:25.32,0:15:26.47,Default,,0,0,0,,Kötü, geri dönün!
Dialogue: 0,0:15:26.47,0:15:27.99,Default,,0,0,0,,Kalenin önünü kapatın!
Dialogue: 0,0:15:27.99,0:15:30.03,Default,,0,0,0,,Sizden önce bir orta göndereceğim!
Dialogue: 0,0:15:30.03,0:15:31.78,Default,,0,0,0,,{\i1}Mükemmel bir orta! {\i0}
Dialogue: 0,0:15:31.78,0:15:33.16,Default,,0,0,0,,{\i1}Top Oda'ya gidiyor!\N{\i0}
Dialogue: 0,0:15:33.16,0:15:34.28,Default,,0,0,0,,Bu sefer...!
Dialogue: 0,0:15:36.24,0:15:39.50,Default,,0,0,0,,{\i1}Kaleciye doğru!{\i0}
Dialogue: 0,0:15:39.50,0:15:41.32,Default,,0,0,0,,{\i1}Zor bir şey.{\i0}
Dialogue: 0,0:15:41.32,0:15:43.70,Default,,0,0,0,,{\i1}Oda, başka bir gol şansını kaçırdı.{\i0}
Dialogue: 0,0:15:43.70,0:15:45.17,Default,,0,0,0,,{\i1}Şimdi iki oldu. {\i0}
Dialogue: 0,0:15:45.17,0:15:46.52,Default,,0,0,0,,Oda...
Dialogue: 0,0:15:46.52,0:15:49.01,Default,,0,0,0,,Tamam, geç olmadan gönder!
Dialogue: 0,0:15:49.01,0:15:50.92,Default,,0,0,0,,Matsuyama geri dönemez!
Dialogue: 0,0:15:51.50,0:15:54.18,Default,,0,0,0,,{\i1}Minamiuwa'dan karşı saldırı! {\i0}
Dialogue: 0,0:15:54.18,0:15:55.55,Default,,0,0,0,,Millet, size güveniyorum!
Dialogue: 0,0:15:55.55,0:15:56.98,Default,,0,0,0,,{\i1} Tanrım, sana yalvarıyorum.{\i0}
Dialogue: 0,0:15:56.98,0:15:58.77,Default,,0,0,0,,{\i1}Kazanmalarına izin ver.{\i0}
Dialogue: 0,0:15:58.77,0:16:03.48,Default,,0,0,0,,{\i1}Yoshiko ve Matsuyama'nın böyle ayrı kalması çok acımasızca.{\i0}
Dialogue: 0,0:16:06.76,0:16:08.94,Default,,0,0,0,,{\i1}Takei tutuluyor. {\i0}
Dialogue: 0,0:16:08.94,0:16:10.24,Default,,0,0,0,,O zaman...
Dialogue: 0,0:16:10.24,0:16:11.45,Default,,0,0,0,,Şut zamanı!
Dialogue: 0,0:16:11.93,0:16:14.53,Default,,0,0,0,,{\i1}Ishida aniden uzun bir şut attı.{\i0}
Dialogue: 0,0:16:16.92,0:16:18.47,Default,,0,0,0,,{\i1}Yakaladı! {\i0}
Dialogue: 0,0:16:18.47,0:16:20.12,Default,,0,0,0,,{\i1} Kaleci harika bir oyun çıkarıyor! {\i0}
Dialogue: 0,0:16:20.12,0:16:22.12,Default,,0,0,0,,{\i1}Kato-kun'dan olağanüstü bir kurtarış.{\i0}
Dialogue: 0,0:16:22.87,0:16:24.08,Default,,0,0,0,,Hadi, Kato!
Dialogue: 0,0:16:24.08,0:16:26.51,Default,,0,0,0,,Onlara böyle bir mücadele\N göstermeyi bırakmanın zamanı geldi!
Dialogue: 0,0:16:26.51,0:16:29.38,Default,,0,0,0,,Gerçekten Furano'nun böyle bir takıma\N kaybedebileceğini düşünüyor musunuz?!
Dialogue: 0,0:16:29.97,0:16:31.01,Default,,0,0,0,,Kaptan...!
Dialogue: 0,0:16:31.01,0:16:32.38,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:16:32.38,0:16:33.38,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:16:33.38,0:16:36.43,Default,,0,0,0,,{\i1}Kalesini mükemmel bir şekilde koruyan Kato-kun,{\i0}
Dialogue: 0,0:16:36.43,0:16:38.43,Default,,0,0,0,,{\i1}kaptanı Matsuyama'ya uzun bir pas gönderiyor.{\i0}
Dialogue: 0,0:16:39.77,0:16:40.60,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:16:41.39,0:16:43.69,Default,,0,0,0,,{\i1}Furano onları yakalayıp liderliği ele geçirebilir mi?!{\i0}
Dialogue: 0,0:16:43.69,0:16:46.15,Default,,0,0,0,,{\i1}Maçta sadece on dakika kaldı.{\i0}
Dialogue: 0,0:16:46.15,0:16:48.14,Default,,0,0,0,,Kaptanın liderliğini takip edin, millet!
Dialogue: 0,0:16:48.14,0:16:49.41,Default,,0,0,0,,Aynen kaptanın söylediği gibi!
Dialogue: 0,0:16:49.41,0:16:52.53,Default,,0,0,0,,Bu adamlara karşı kaybedecek miyiz?!
Dialogue: 0,0:16:52.53,0:16:53.51,Default,,0,0,0,,O haklı!
Dialogue: 0,0:16:53.51,0:16:56.53,Default,,0,0,0,,Kaybetmeyi göze alamayız!
Dialogue: 0,0:16:56.53,0:16:58.53,Default,,0,0,0,,Kaptanın liderliğini takip edin!
Dialogue: 0,0:16:59.81,0:17:01.06,Default,,0,0,0,,{\i1}B-Bu...{\i0}
Dialogue: 0,0:17:01.06,0:17:03.04,Default,,0,0,0,,{\i1}Furano tüm oyuncularıyla saldırıyor!{\i0}
Dialogue: 0,0:17:03.04,0:17:05.29,Default,,0,0,0,,{\i1}Hepsi koşuyor, gölü hedefliyorlar!{\i0}
Dialogue: 0,0:17:05.29,0:17:07.54,Default,,0,0,0,,Çok fazla inanıyorlar.
Dialogue: 0,0:17:07.54,0:17:10.33,Default,,0,0,0,,{\i1}Her şeyden önce Furano'nun ekip\N çalışmasını gerçekten görebilirsiniz...{\i0}
Dialogue: 0,0:17:10.33,0:17:13.09,Default,,0,0,0,,{\i1}Herkes Matsuyama'dan tek bir emir ile birleşiyor.{\i0}
Dialogue: 0,0:17:13.09,0:17:14.59,Default,,0,0,0,,Matsuyama...
Dialogue: 0,0:17:14.59,0:17:16.01,Default,,0,0,0,,Panik yapmayın millet!
Dialogue: 0,0:17:16.01,0:17:17.24,Default,,0,0,0,,Hala 10 dakikamız var!
Dialogue: 0,0:17:17.24,0:17:21.60,Default,,0,0,0,,Paslarını okumaya devam \Nedersek, Furano bize karşı gol atamaz!
Dialogue: 0,0:17:21.60,0:17:23.06,Default,,0,0,0,,E-Evet...
Dialogue: 0,0:17:25.27,0:17:26.94,Default,,0,0,0,,Matsuyama-kun...
Dialogue: 0,0:17:26.94,0:17:27.94,Default,,0,0,0,,{\i1}Lanet olsun...{\i0}
Dialogue: 0,0:17:27.94,0:17:30.77,Default,,0,0,0,,{\i1}Böyle adamlara kaybedemem!{\i0}
Dialogue: 0,0:17:31.22,0:17:32.90,Default,,0,0,0,,{\i1}Hey, futbol kulübü! {\i0}
Dialogue: 0,0:17:33.90,0:17:37.28,Default,,0,0,0,,{\i1}Zamanınız doldu. Spor salonunu kullanma sırası bizde.{\i0}
Dialogue: 0,0:17:37.28,0:17:38.66,Default,,0,0,0,,{\i1}Tamam!{\i0}
Dialogue: 0,0:17:38.66,0:17:42.08,Default,,0,0,0,,{\i1}Tamam! Sadece önünü temizleyeceğiz ve çalışmaya devam edeceğiz.{\i0}
Dialogue: 0,0:17:42.08,0:17:42.95,Default,,0,0,0,,{\i1}Evet!{\i0}
Dialogue: 0,0:17:42.95,0:17:43.66,Default,,0,0,0,,{\i1}İşte!{\i0}
Dialogue: 0,0:17:45.83,0:17:47.44,Default,,0,0,0,,{\i1}Lanet olsun...{\i0}
Dialogue: 0,0:17:47.44,0:17:50.13,Default,,0,0,0,,{\i1}Bu şekilde pratik yapamayız.{\i0}
Dialogue: 0,0:17:55.04,0:17:56.84,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:17:56.84,0:18:06.56,Default,,0,0,0,,{\i1}Dünyada yalın yerde, yıl\N boyunca oynayanlara kaybedemeyiz!{\i0}
Dialogue: 0,0:18:14.96,0:18:18.99,Default,,0,0,0,,{\i1}Matsuyama uzun, uzun bir atıştan önce bile pas vermiyor!{\i0}
Dialogue: 0,0:18:18.99,0:18:20.24,Default,,0,0,0,,Ne?!
Dialogue: 0,0:18:20.24,0:18:22.03,Default,,0,0,0,,Kaptanımızın özel şutu!
Dialogue: 0,0:18:22.03,0:18:24.70,Default,,0,0,0,,{\i1}Yerde sürünüyor gibi görünen keskin bir atış!{\i0}
Dialogue: 0,0:18:24.70,0:18:29.29,Default,,0,0,0,,{\i1}Şimdiye kadar pasları okuyan \NMinamiuwa tamamen kandırılıyor!{\i0}
Dialogue: 0,0:18:32.00,0:18:33.43,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:18:33.43,0:18:36.34,Default,,0,0,0,,{\i1}Matsuyama'nın tüm gücüyle uzun bir şut!{\i0}
Dialogue: 0,0:18:36.34,0:18:39.24,Default,,0,0,0,,{\i1}Furano nihayet skoru eşitledi!{\i0}
Dialogue: 0,0:18:39.24,0:18:43.85,Default,,0,0,0,,{\i1}Sizden farklı olarak, bu koşullarda bile\N çalışmaya devam etmek zorunda kaldık.{\i0}
Dialogue: 0,0:18:43.85,0:18:47.10,Default,,0,0,0,,Size karda çalışan bizlerin kararlılığını göstereceğiz!
Dialogue: 0,0:18:47.78,0:18:51.85,Default,,0,0,0,,{\i1}Zorlu zeminde eğitim yoluyla inşa edilen\N güçle şut atabileceği türden bir atış.{\i0}
Dialogue: 0,0:18:51.85,0:18:53.90,Default,,0,0,0,,{\i1}Buna Kuzey Ülkesi Atışı derim!{\i0}
Dialogue: 0,0:18:53.90,0:18:55.47,Default,,0,0,0,,Başardın Kaptan!
Dialogue: 0,0:18:55.47,0:18:56.40,Default,,0,0,0,,Yakaladık!
Dialogue: 0,0:18:56.40,0:18:58.40,Default,,0,0,0,,Başardık, Yoshiko! Yakaladık!
Dialogue: 0,0:18:58.40,0:18:59.40,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:59.40,0:19:02.17,Default,,0,0,0,,Harika bir şuttu.
Dialogue: 0,0:19:02.17,0:19:05.58,Default,,0,0,0,,{\i1}Matsuyama bu tür bir mücadele ruhunu saklıyor...{\i0}
Dialogue: 0,0:19:06.16,0:19:09.58,Default,,0,0,0,,{\i1}Yine de, yerde sürünen bu uzun atış...{\i0}
Dialogue: 0,0:19:09.58,0:19:11.48,Default,,0,0,0,,{\i1}Çok güçlü.{\i0}
Dialogue: 0,0:19:11.50,0:19:13.92,Default,,0,0,0,,Böyle bir atışı yapabilir çünkü alt bedenini
Dialogue: 0,0:19:13.92,0:19:16.34,Default,,0,0,0,,karlı topraklarda güçlendiriyor, değil mi?
Dialogue: 0,0:19:16.34,0:19:18.35,Default,,0,0,0,,Evet. Ve diğerleri başarılı bir şekilde pas
Dialogue: 0,0:19:18.35,0:19:20.35,Default,,0,0,0,,almak için kendilerini konumlandırdılar,
Dialogue: 0,0:19:20.35,0:19:22.93,Default,,0,0,0,,savunmanın sadece\N Matsuyama'ya odaklanmasını zorluyor.
Dialogue: 0,0:19:22.93,0:19:25.93,Default,,0,0,0,,Sanki Onbir oyuncu ile bu eşitlik golünü atmışlar gibi.
Dialogue: 0,0:19:27.10,0:19:30.10,Default,,0,0,0,,{\i1}Hala başka bir gole ihtiyacın var, Matsuyama. {\i0}
Dialogue: 0,0:19:30.10,0:19:33.31,Default,,0,0,0,,{\i1}Furano, oyunu eşitledikten sonra gelgit sürüyor.{\i0}
Dialogue: 0,0:19:33.77,0:19:35.98,Default,,0,0,0,,{\i1}Pası kestiler!{\i0}
Dialogue: 0,0:19:35.98,0:19:36.98,Default,,0,0,0,,Dikkat edin!
Dialogue: 0,0:19:36.98,0:19:38.74,Default,,0,0,0,,Matsuyama pastan daha fazlasını yapabilir!
Dialogue: 0,0:19:38.74,0:19:41.03,Default,,0,0,0,,Ayrıca top sürüp uzun atış yapabilir!
Dialogue: 0,0:19:42.11,0:19:43.81,Default,,0,0,0,,Diğerleri sadece topu paslayabilir!
Dialogue: 0,0:19:43.81,0:19:45.12,Default,,0,0,0,,Pas yönlerini okuyun!
Dialogue: 0,0:19:45.56,0:19:47.42,Default,,0,0,0,,{\i1}Kaneda-kun top sürme ile devam ediyor.{\i0}
Dialogue: 0,0:19:47.42,0:19:48.12,Default,,0,0,0,,Ne?
Dialogue: 0,0:19:48.12,0:19:52.08,Default,,0,0,0,,{\i1}Bu futbol temellerini birleştiren \Ntam bir saldırı, sürme ve paslaşma.{\i0}
Dialogue: 0,0:19:52.08,0:19:53.33,Default,,0,0,0,,Millet...
Dialogue: 0,0:19:53.33,0:19:57.71,Default,,0,0,0,,Furano'nun adamları bitkin\N görünüyordu, ama görünüşe göre gayet iyiler.
Dialogue: 0,0:19:57.71,0:20:00.22,Default,,0,0,0,,Hayır. Artık hepsi yorgunlukla savaşıyor.
Dialogue: 0,0:20:00.22,0:20:03.84,Default,,0,0,0,,Ve Matsuyama, herkesi bir arada tutan kişi.
Dialogue: 0,0:20:03.84,0:20:05.89,Default,,0,0,0,,Millet, savaşmaya devam edin!
Dialogue: 0,0:20:06.85,0:20:08.94,Default,,0,0,0,,{\i1}Top, Minamiuwa'nın kalesinin hemen önünde {\i0}
Dialogue: 0,0:20:08.94,0:20:11.02,Default,,0,0,0,,{\i1}bir kez daha Matsuyama'ya gidiyor!{\i0}
Dialogue: 0,0:20:11.02,0:20:12.98,Default,,0,0,0,,Tekrar atmana izin vermeyeceğim!
Dialogue: 0,0:20:12.98,0:20:17.11,Default,,0,0,0,,Ishida, seni dilediğin gibi şahsen ele alacağım!
Dialogue: 0,0:20:17.93,0:20:19.30,Default,,0,0,0,,{\i1}Ahh Matsuyama-kun{\i0}
Dialogue: 0,0:20:19.30,0:20:22.45,Default,,0,0,0,,{\i1}Ishida'yı tek başına geçmeyi planlıyor!{\i0}
Dialogue: 0,0:20:22.45,0:20:23.91,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:20:23.91,0:20:25.66,Default,,0,0,0,,Beni geçebileceğini mi düşünüyorsun?
Dialogue: 0,0:20:25.66,0:20:26.66,Default,,0,0,0,,Yaparım!
Dialogue: 0,0:20:28.22,0:20:29.80,Default,,0,0,0,,{\i1}Onu geçti! {\i0}
Dialogue: 0,0:20:29.80,0:20:33.33,Default,,0,0,0,,{\i1}Matsuyama, kaptanlar arasındaki bu savaşı açıkça kazanıyor! {\i0}
Dialogue: 0,0:20:34.14,0:20:37.84,Default,,0,0,0,,Ishida'yı geçti... Top tekniği açısından kaybetti...
Dialogue: 0,0:20:37.84,0:20:40.30,Default,,0,0,0,,{\i1}Matsuyama'yı kalenin önünde durduracak kimse yok!{\i0}
Dialogue: 0,0:20:40.30,0:20:41.78,Default,,0,0,0,,{\i1}Bu büyük bir şans! {\i0}
Dialogue: 0,0:20:41.78,0:20:42.38,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:20:42.38,0:20:43.09,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:44.24,0:20:44.97,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:20:44.97,0:20:47.20,Default,,0,0,0,,Bu senin, Oda!
Dialogue: 0,0:20:47.20,0:20:49.81,Default,,0,0,0,,Furano'nun orta forveti sensin!
Dialogue: 0,0:20:49.81,0:20:51.41,Default,,0,0,0,,O haklı. Sadece vur, Oda!
Dialogue: 0,0:20:51.41,0:20:53.31,Default,,0,0,0,,Antrenman sırasında her zaman yaptığın gibi yap!
Dialogue: 0,0:20:53.31,0:20:54.76,Default,,0,0,0,,{\i1}Kaptan...{\i0}
Dialogue: 0,0:20:54.76,0:20:56.19,Default,,0,0,0,,{\i1}Millet...{\i0}
Dialogue: 0,0:20:56.19,0:20:58.54,Default,,0,0,0,,{\i1}Bugün iki kere sizi başarısızlığa uğratsam da, siz...{\i0}
Dialogue: 0,0:20:59.47,0:21:00.67,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:21:00.67,0:21:03.03,Default,,0,0,0,,{\i1}Eğer gol atamazsam kendime erkek diyemem!{\i0}
Dialogue: 0,0:21:03.03,0:21:04.65,Default,,0,0,0,,Git!
Dialogue: 0,0:21:07.62,0:21:08.66,Default,,0,0,0,,{\i1}İçerde!{\i0}
Dialogue: 0,0:21:08.66,0:21:11.58,Default,,0,0,0,,{\i1}Üçüncü denemesi ve bu sefer görkemli bir{\i0}
Dialogue: 0,0:21:11.58,0:21:14.50,Default,,0,0,0,,{\i1}şekilde bu şansı dönüştürmesini sağlıyor!{\i0}
Dialogue: 0,0:21:14.50,0:21:16.53,Default,,0,0,0,,B-Başardım!
Dialogue: 0,0:21:16.53,0:21:17.75,Default,,0,0,0,,{\i1}Furano skorları döndürüyor.{\i0}
Dialogue: 0,0:21:18.35,0:21:20.40,Default,,0,0,0,,{\i1}Liderler, 2-1!{\i0}
Dialogue: 0,0:21:20.40,0:21:22.26,Default,,0,0,0,,{\i1}Her şey yolunda.{\i0}
Dialogue: 0,0:21:22.26,0:21:23.57,Default,,0,0,0,,Lanet olsun...
Dialogue: 0,0:21:23.57,0:21:25.18,Default,,0,0,0,,Önümüzdeler!
Dialogue: 0,0:21:27.06,0:21:30.44,Default,,0,0,0,,{\i1}Son düdük çaldı ve maç bitti!{\i0}
Dialogue: 0,0:21:30.44,0:21:33.27,Default,,0,0,0,,{\i1}Minamiuwa sonunda güçsüz kalıyor ve Furano bu geri{\i0}
Dialogue: 0,0:21:33.27,0:21:36.10,Default,,0,0,0,,{\i1}dönüş ile galibiyetiyle en iyi dört arasında yerini alıyor!{\i0}
Dialogue: 0,0:21:36.10,0:21:37.48,Default,,0,0,0,,Kazandık!
Dialogue: 0,0:21:37.48,0:21:39.84,Default,,0,0,0,,Tamamdır! Sıradaki Nankatsu!
Dialogue: 0,0:21:39.84,0:21:41.73,Default,,0,0,0,,Ve Toho'yu finalde yakalayacağız!
Dialogue: 0,0:21:41.73,0:21:44.24,Default,,0,0,0,,{\i1}Yani kazandın, Matsuyama...{\i0}
Dialogue: 0,0:21:44.24,0:21:46.99,Default,,0,0,0,,İnatçı Furano'dan beklendiği gibi.
Dialogue: 0,0:21:46.99,0:21:48.94,Default,,0,0,0,,{\i1}Bu son gol...{\i0}
Dialogue: 0,0:21:48.94,0:21:52.00,Default,,0,0,0,,{\i1}Matsuyama bunu kolayca kendisi yapabilirdi.{\i0}
Dialogue: 0,0:21:52.00,0:21:56.34,Default,,0,0,0,,{\i1}Ama, kasıtlı olarak bugün kötü\N formda olan Oda'ya bir pas gönderdi.{\i0}
Dialogue: 0,0:21:56.34,0:21:57.80,Default,,0,0,0,,{\i1}Matsuyama-kun...{\i0}
Dialogue: 0,0:21:57.80,0:22:01.63,Default,,0,0,0,,{\i1}Takım arkadaşlarına olan inancın çok derin, değil mi?{\i0}
Dialogue: 0,0:22:01.63,0:22:04.25,Default,,0,0,0,,Biz kazandık! Kazandık Yoshiko!
Dialogue: 0,0:22:04.25,0:22:06.38,Default,,0,0,0,,Evet... Çok sevindim!
Dialogue: 0,0:22:06.38,0:22:08.13,Default,,0,0,0,,Menajer!
Dialogue: 0,0:22:08.13,0:22:10.13,Default,,0,0,0,,Bugün de kazandık!
Dialogue: 0,0:22:10.13,0:22:11.70,Default,,0,0,0,,Matsuyama-kun...
Dialogue: 0,0:22:13.95,0:22:15.26,Default,,0,0,0,,{\i1}Fujisawa...{\i0}
Dialogue: 0,0:22:15.26,0:22:18.57,Default,,0,0,0,,{\i1}Bizimle olan son anın dilediğin şey olacak.{\i0}
Dialogue: 0,0:22:20.15,0:22:35.15,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:50.15,0:24:01.00,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:23:50.15,0:24:00.72,Default,,0,0,0,,41. BÖLÜM: KORKUNÇ KARANLIK ATI
Dialogue: 0,0:02:31.25,0:02:33.96,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:34.88,0:02:37.55,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:38.46,0:02:41.18,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:48.06,0:02:50.89,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:02:50.89,0:02:57.15,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:02:57.15,0:03:03.03,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta no ni
Dialogue: 0,0:03:03.03,0:03:09.62,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:03:09.62,0:03:13.62,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:03:13.62,0:03:18.13,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:03:18.13,0:03:23.68,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:03:23.68,0:03:25.26,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:03:25.26,0:03:26.47,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:03:26.47,0:03:29.97,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:03:29.97,0:03:39.86,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:03:39.86,0:03:40.69,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:03:40.69,0:03:44.49,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:03:44.49,0:03:48.49,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:03:48.49,0:03:54.75,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:03:54.75,0:03:57.54,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:02:31.25,0:02:33.96,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:34.88,0:02:37.55,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:38.46,0:02:41.18,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:48.06,0:02:50.89,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum. {I keep lying to myself}
Dialogue: 0,0:02:50.89,0:02:57.15,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile {burning with loneliness}
Dialogue: 0,0:02:57.15,0:03:03.03,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:03:03.03,0:03:09.62,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:03:09.62,0:03:13.62,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:03:13.62,0:03:18.13,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:03:18.13,0:03:23.68,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:03:23.68,0:03:25.26,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:03:25.26,0:03:26.47,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:03:26.47,0:03:29.97,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:03:29.97,0:03:39.86,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:03:39.86,0:03:40.69,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:03:40.69,0:03:44.49,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:03:44.49,0:03:48.49,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:03:48.49,0:03:54.75,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:03:54.75,0:03:57.54,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.87,0:22:44.92,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.92,0:22:50.93,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.93,0:22:56.98,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.98,0:23:01.61,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:03.23,0:23:07.90,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:09.24,0:23:15.33,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:15.33,0:23:21.37,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.37,0:23:25.84,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:27.13,0:23:33.47,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.47,0:23:39.52,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.52,0:23:45.82,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.87,0:22:44.92,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.92,0:22:50.93,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.93,0:22:56.98,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.98,0:23:01.61,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.23,0:23:07.90,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:09.24,0:23:15.33,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:15.33,0:23:21.37,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.37,0:23:25.84,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:27.13,0:23:33.47,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.47,0:23:39.52,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.52,0:23:45.82,OPED,,0,0,0,,Bu hırslı gençlik sahada!
