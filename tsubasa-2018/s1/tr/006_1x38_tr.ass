Comment: 0,0:22:20.02,0:23:49.99,Default,,0,0,0,,ED
Dialogue: 0,0:00:00.32,0:00:02.14,Default,,0,0,0,,Kazuo, şimdi!
Dialogue: 0,0:00:02.14,0:00:02.77,Default,,0,0,0,,Tamam!
Dialogue: 0,0:00:06.73,0:00:08.23,Default,,0,0,0,,Geliyorum, Masao!
Dialogue: 0,0:00:09.15,0:00:10.82,Default,,0,0,0,,Tamam!
Dialogue: 0,0:00:10.82,0:00:12.82,Default,,0,0,0,,{\i1}Bu...!{\i0}
Dialogue: 0,0:00:13.74,0:00:21.58,Default,,0,0,0,,Bu bizim yeni hava futbolu hareketimiz, Gökyüzü fırtınası!
Dialogue: 0,0:00:21.58,0:00:33.02,Default,,0,0,0,,{\i1}Aman Allah'ım!Tachibana İkizleri bacaklarını kenetledi ve havaya zıpladı!{\i0} {I know recoil is not the perfect word?}
Dialogue: 0,0:00:36.55,0:00:39.51,Default,,0,0,0,,Hadi!
Dialogue: 0,0:00:39.51,0:00:40.84,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:00:40.84,0:00:41.52,Default,,0,0,0,,Evet!
Dialogue: 0,0:00:41.52,0:00:43.83,Default,,0,0,0,,Gol!
Dialogue: 0,0:00:43.83,0:00:48.28,Default,,0,0,0,,{\i1}Tachibana İkizler'den insana aklını kaçırtacak bir hareket...{\i0}
Dialogue: 0,0:00:48.28,0:00:50.02,Default,,0,0,0,,Bu...! {aint legal1!!1!}
Dialogue: 0,0:00:50.02,0:01:05.99,AnimeSeverler,,0,0,0,,'{\b0}Anime{\b1} Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr  \NÇevirmen; Brook ( {\c&HD67C65&}Soul King {\c})
Dialogue: 0,0:00:50.02,0:02:19.99,Default,,0,0,0,,{copy-paste time is over. time for AI AI AI}
Dialogue: 0,0:02:20.41,0:02:25.91,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}Bölüm 38: \NTAKE THEM DOWN! TACHIBANA İkizler
Dialogue: 0,0:02:21.37,0:02:22.87,Default-TOP,,0,0,0,,{\i1}2-1!{\i0}
Dialogue: 0,0:02:22.87,0:02:27.12,Default-TOP,,0,0,0,,{\i1}Hanawa MS inanılmaz bir teknikle farkı bire indirdi.{\i0}
Dialogue: 0,0:02:28.27,0:02:31.46,Default,,0,0,0,,Gördünüz mü? Bu bizim Gökyüzü Fırtınası hareketimiz!
Dialogue: 0,0:02:31.46,0:02:35.13,Default,,0,0,0,,İşte ikizlerin gücü! Görebileceğiniz en iyi şut bu!
Dialogue: 0,0:02:35.13,0:02:38.93,Default,,0,0,0,,Lanet olsun. Haklılar. Tekniklerini baya geliştirmişler.
Dialogue: 0,0:02:38.93,0:02:41.27,Default,,0,0,0,,Bu hareket gelişmiş hali değil; yep yeni bir hareket. {lol, i cheated a bit with FR subs but that's fitting actually for that tongue-twister}
Dialogue: 0,0:02:41.27,0:02:47.14,Default,,0,0,0,,Masao da Kazuo da o günden beri bu şutu yapabilmek için uğraşıyorlar.
Dialogue: 0,0:02:52.86,0:02:54.88,Default,,0,0,0,,{\i1}Başardık, değil mi Masao?{\i0}
Dialogue: 0,0:02:54.88,0:02:56.85,Default,,0,0,0,,Bir kere yapabilmek yetmez.
Dialogue: 0,0:02:56.85,0:02:58.37,Default,,0,0,0,,Hadi bir daha yapalım!
Dialogue: 0,0:02:58.37,0:03:00.32,Default,,0,0,0,,Ciddi misin? Ama bacaklarımız....
Dialogue: 0,0:03:01.74,0:03:05.20,Default,,0,0,0,,Bu sefer ben altta olucam sen atlayacaksın.
Dialogue: 0,0:03:05.20,0:03:06.83,Default,,0,0,0,,Tamam o zaman...
Dialogue: 0,0:03:06.83,0:03:08.83,Default,,0,0,0,,Yeter bu kadar beyler.
Dialogue: 0,0:03:08.83,0:03:10.50,Default,,0,0,0,,Yarın devam edersiniz.
Dialogue: 0,0:03:10.50,0:03:15.94,Default,,0,0,0,,Olmaz! Her seferinde yapamazsak başardık sayılmaz.
Dialogue: 0,0:03:15.94,0:03:19.17,Default,,0,0,0,,Haklı! Eğer yapmazsak kazanamayız.
Dialogue: 0,0:03:19.60,0:03:20.44,Default,,0,0,0,,Hadi!
Dialogue: 0,0:03:20.44,0:03:21.17,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:21.95,0:03:24.85,Default,,0,0,0,,Ne kadar çalıştıklarını biz biliyoruz.
Dialogue: 0,0:03:29.96,0:03:35.12,Default,,0,0,0,,Yapabileceğimiz tek şey, Skylab Kasırgası için tüm gücümüzle tam destek sağlamak.
Dialogue: 0,0:03:35.12,0:03:36.32,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:39.99,0:03:42.35,Default,,0,0,0,,Harika bir hareketti be!
Dialogue: 0,0:03:42.35,0:03:45.45,Default,,0,0,0,,Sanki hiç açık noktası yok gibiydi.
Dialogue: 0,0:03:45.45,0:03:48.51,Default,,0,0,0,,Demek Tachibana İkizleri'nin yeni hareketi bu...
Dialogue: 0,0:03:48.51,0:03:51.06,Default,,0,0,0,,Buna süpriz bir atak diyemezsin.
Dialogue: 0,0:03:51.06,0:03:54.10,Default,,0,0,0,,Evet. Bu hareketle başarısız atak yapmaları olanaksız.
Dialogue: 0,0:03:54.10,0:03:54.75,Default,,0,0,0,,Evet.
Dialogue: 0,0:03:54.75,0:03:57.13,Default,,0,0,0,,{\i1}Ne yapıcaksın, Tsubasa?{\i0}
Dialogue: 0,0:04:03.29,0:04:05.39,Default,,0,0,0,,{\i1}Hyuga...{\i0}
Dialogue: 0,0:04:05.39,0:04:08.18,Default,,0,0,0,,Gökyüzü Fırtınası, he...
Dialogue: 0,0:04:09.27,0:04:11.02,Default,,0,0,0,,Hey, yakalayabildin mi?
Dialogue: 0,0:04:11.02,0:04:15.36,Default,,0,0,0,,Evet, böyle inanılmaz bir şeyi daha önce hiç görmemiştim.
Dialogue: 0,0:04:15.36,0:04:20.86,Default,,0,0,0,,Önceki tekniklerinde dönüp kaleden zıplıyorlardı.
Dialogue: 0,0:04:20.86,0:04:23.53,Default,,0,0,0,,O pozisyondan şut çekmek zor oluyordu.
Dialogue: 0,0:04:23.53,0:04:27.82,Default,,0,0,0,,Bu yüzden diğerine pas atıp üçgen şeklinde paslaşma yapıyorlardı.
Dialogue: 0,0:04:28.41,0:04:34.88,Default,,0,0,0,,Ama bu yeni teknikte zıplamanın gücünü direkt olarak kullanabiliyorlar.
Dialogue: 0,0:04:34.88,0:04:39.84,Default,,0,0,0,,{\t(4149,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Bunu öyle kale direğine vurma gibi basit bir hareketle durduramazsın.
Dialogue: 0,0:04:40.00,0:04:42.22,Default,,0,0,0,,Maç oldukça ilgi çekici bir hal aldı.
Dialogue: 0,0:04:42.22,0:04:44.26,Default,,0,0,0,,Nankatsu nasıl bir tepki vericek?
Dialogue: 0,0:04:44.89,0:04:48.26,Default,,0,0,0,,Tsubasa nasıl bir oyun izleyecek?
Dialogue: 0,0:04:48.81,0:04:50.69,Default,,0,0,0,,Şimdi, sakin olalım.
Dialogue: 0,0:04:50.69,0:04:55.42,Default,,0,0,0,,Hadi ama, sadece inanılmaz bir şut gösterdiler.
Dialogue: 0,0:04:55.42,0:05:00.85,Default,,0,0,0,,Gerçekten inanılmaz bir vuruştu ama kalenin önüne gelmedikçe bu şutu atamazlar.
Dialogue: 0,0:05:00.85,0:05:01.78,Default,,0,0,0,,Oh!
Dialogue: 0,0:05:01.78,0:05:03.15,Default,,0,0,0,,Tabi ya!
Dialogue: 0,0:05:03.15,0:05:08.78,Default,,0,0,0,,Yani oyunun gidişatını kontrol edip onları buraya sokmamalıyız.
Dialogue: 0,0:05:08.78,0:05:10.34,Default,,0,0,0,,Sonra da saldıracağız!
Dialogue: 0,0:05:10.34,0:05:12.41,Default,,0,0,0,,Hadi maça Hanawa'nın alanında devam edelim.
Dialogue: 0,0:05:12.41,0:05:15.25,Default,,0,0,0,,En iyi defans saldırıdır.
Dialogue: 0,0:05:15.25,0:05:16.69,Default,,0,0,0,,Evet.
Dialogue: 0,0:05:16.69,0:05:18.88,Default,,0,0,0,,Pekala! Maça devam beyler! Odaklanın!
Dialogue: 0,0:05:18.88,0:05:20.55,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:22.53,0:05:24.55,Default,,0,0,0,,{\i1}Kaybetme Tsubasa.{\i0}
Dialogue: 0,0:05:24.55,0:05:27.72,Default,,0,0,0,,{\i1}Seni yenen kişi ben olacağım!{\i0}
Dialogue: 0,0:05:30.72,0:05:34.60,Default,,0,0,0,,{\i1}Myoko MS top sürüp güzel bir şut atıyor!{\i0}
Dialogue: 0,0:05:35.53,0:05:38.85,Default,,0,0,0,,{\i1}Wakashimazu tekrar kurtarıyor!{\i0}
Dialogue: 0,0:05:38.85,0:05:39.95,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:05:39.95,0:05:41.52,Default,,0,0,0,,Helal, Wakashimazu!
Dialogue: 0,0:05:42.32,0:05:46.70,Default,,0,0,0,,{\i1}Hyuga yokken Toho'nun mihenk taşı Wakashimazu oluyor!{\i0} {AWAKEN MY MASTERS} {goddamn since when is he beautiful}
Dialogue: 0,0:05:46.70,0:05:49.45,Default,,0,0,0,,{\i1}Hyuga burada olmasa bile yeterince iyiyiz.{\i0}
Dialogue: 0,0:05:50.00,0:05:51.66,Default,,0,0,0,,{\i1}Formunun zirvesinde.{\i0}
Dialogue: 0,0:05:51.66,0:05:56.08,Default,,0,0,0,,{\i1}Defansı sayesinde Wakashimazu rakiplerine hiçbir gol şansı vermiyor.{\i0}
Dialogue: 0,0:05:56.08,0:05:59.83,Default,,0,0,0,,{\i1}Kaptınımızınki gibi bizim de tek hedefimiz Nankatsu.{\i0}
Dialogue: 0,0:05:59.83,0:06:02.34,Default,,0,0,0,,{\i1}Nankatsu'yla karşılaşana kadar gol yemeyeceğim!{\i0}
Dialogue: 0,0:06:03.38,0:06:07.22,Default,,0,0,0,,{\i1}\NHyuga bu turnuvada onun ismini kazandı.{\i0} {or "make history" or something, because "kiroku" both meand record and "record" as in written record. like he'd have some officially recorded great feats it is to break records here imho, leaving his mark would be a sure-fire thingy?}
Dialogue: 0,0:06:07.22,0:06:13.32,Default,,0,0,0,,{\i1}Hyuga 3 yıl ardı ardına gol kralı olacağından emindi.{\i0}
Dialogue: 0,0:06:13.32,0:06:18.02,Default,,0,0,0,,{\i1}Sadece Nankatsu'yu yenmek için hepsinden vazgeçti.{\i0} {as I said, Alex and Kocaman here @mhin...}
Dialogue: 0,0:06:19.05,0:06:25.30,Default,,0,0,0,,{\t(5501,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Bu yüzden finallere kadar kaybedemeyiz!{\i0}
Dialogue: 0,0:06:26.58,0:06:28.61,Default,,0,0,0,,{\i1}Hanawa topu kazanıyor!{\i0}
Dialogue: 0,0:06:28.61,0:06:34.08,Default,,0,0,0,,{\i1}Tachibana İkizlerin attığı golden sonra maçın atmosferi tamamen değişmiş durumda!{\i0}
Dialogue: 0,0:06:34.08,0:06:39.25,Default,,0,0,0,,{\i1}Hanawa ilk yarı bitmeden skoru eşitleyebilecek mi?{\i0}
Dialogue: 0,0:06:40.01,0:06:41.89,Default,,0,0,0,,Aimoto, hadi skoru eşitleyelim.
Dialogue: 0,0:06:41.89,0:06:42.97,Default,,0,0,0,,Kaleye gönder!
Dialogue: 0,0:06:42.97,0:06:43.75,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:43.75,0:06:45.13,Default,,0,0,0,,Çabuk tut onu!
Dialogue: 0,0:06:45.13,0:06:46.51,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:48.74,0:06:50.09,Default,,0,0,0,,Nankatsu'dan beklendiği gibi
Dialogue: 0,0:06:50.09,0:06:52.28,Default,,0,0,0,,nasıl defans yapılacağını gayet iyi biliyorlar.
Dialogue: 0,0:06:52.28,0:06:54.60,Default,,0,0,0,,Gol atmalarına o kadar kolay izin vermeyecekler.
Dialogue: 0,0:06:57.10,0:06:58.39,Default,,0,0,0,,Bana yolla!
Dialogue: 0,0:07:00.85,0:07:02.10,Default,,0,0,0,,Ben tutuyorum!
Dialogue: 0,0:07:02.10,0:07:03.61,Default,,0,0,0,,{O FUCK}
Dialogue: 0,0:07:04.84,0:07:07.86,Default,,0,0,0,,{\i1}Aimoto pas atıcakmış gibi yapıp rakibini çalımladı!{\i0}
Dialogue: 0,0:07:07.86,0:07:08.74,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:07:08.74,0:07:09.69,Default,,0,0,0,,Pekala!
Dialogue: 0,0:07:09.69,0:07:10.57,Default,,0,0,0,,Hadi!
Dialogue: 0,0:07:10.57,0:07:11.82,Default,,0,0,0,,Şerefsiz seni!
Dialogue: 0,0:07:12.58,0:07:14.87,Default,,0,0,0,,{\i1}Ishizaki yetişemedi!{\i0}
Dialogue: 0,0:07:14.87,0:07:17.08,Default,,0,0,0,,Top tekrar kalenin önünde havaya dikildi.
Dialogue: 0,0:07:17.08,0:07:21.54,Default,,0,0,0,,Şimdi Tachibaba ikizlerinin yeni hareketinin zamanı!
Dialogue: 0,0:07:21.54,0:07:24.59,Default,,0,0,0,,Lanet olsun! Yine topu getirdiler!
Dialogue: 0,0:07:28.55,0:07:29.72,Default,,0,0,0,,Ne yapmalıyım?
Dialogue: 0,0:07:29.72,0:07:31.22,Default,,0,0,0,,Geliyorum, Masao!
Dialogue: 0,0:07:32.13,0:07:35.97,Default,,0,0,0,,Yine Gökyüzü Fırtınası harketini mi yapıcaklar?
Dialogue: 0,0:07:35.97,0:07:37.52,Default,,0,0,0,,Ne yapmalıyım?
Dialogue: 0,0:07:39.87,0:07:41.64,Default,,0,0,0,,Tamam, işte bu.
Dialogue: 0,0:07:42.60,0:07:46.77,Default,,0,0,0,,{\i1}Tsubasa kale direğini kullanarak zıplıyor!{\i0}
Dialogue: 0,0:07:46.77,0:07:47.52,Default,,0,0,0,,Uçuyor!
Dialogue: 0,0:07:47.52,0:07:49.78,Default,,0,0,0,,Gökyüzü Fırtınasını durdurabilecek mi?
Dialogue: 0,0:07:53.06,0:07:56.08,Default,,0,0,0,,Ne? Beklenmedik bir şekilde Kazuo zıplamadı!
Dialogue: 0,0:07:56.08,0:07:56.92,Default,,0,0,0,,Ne?
Dialogue: 0,0:07:56.92,0:07:57.83,Default,,0,0,0,,Şaka mı bu?
Dialogue: 0,0:07:59.45,0:08:02.16,Default,,0,0,0,,{\i1}Tsubasa topu uzaklaştırdı.{\i0}
Dialogue: 0,0:08:03.07,0:08:05.38,Default,,0,0,0,,İlk yarının bitiş düdüğü çalıyor.
Dialogue: 0,0:08:06.63,0:08:08.26,Default,,0,0,0,,İşte bizim Tsubasa'mız be!
Dialogue: 0,0:08:08.26,0:08:10.59,Default,,0,0,0,,Bu şekilde Gökyüzü Fırtınasını durdurabiliriz!
Dialogue: 0,0:08:11.18,0:08:17.00,Default,,0,0,0,,Bilmiyor olabilirsin ama Tsubasa bu şekilde \Nzıplayarak bizim hareketimizi durduramazsın.
Dialogue: 0,0:08:17.00,0:08:19.68,Default,,0,0,0,,İkinci yarı görürsün.
Dialogue: 0,0:08:19.68,0:08:22.69,Default,,0,0,0,,{\i1}Tachibana İkizler...{\i0}
Dialogue: 0,0:08:23.13,0:08:25.18,Default,,0,0,0,,Üzgünüm Kazuo, Masao.
Dialogue: 0,0:08:25.18,0:08:27.01,Default,,0,0,0,,Biraz alçaktı top.
Dialogue: 0,0:08:27.01,0:08:27.80,Default,,0,0,0,,Evet.
Dialogue: 0,0:08:27.80,0:08:31.32,Default,,0,0,0,,Neyse bu vuruş bacaklarımızı zaten oldukça zorluyor.
Dialogue: 0,0:08:31.32,0:08:33.00,Default,,0,0,0,,Bunu öyle pervasızca kullanamayız.
Dialogue: 0,0:08:33.00,0:08:35.87,Default,,0,0,0,,Gol olacağından emin olduğumuz zaman kullanacağız.
Dialogue: 0,0:08:35.87,0:08:37.87,Default,,0,0,0,,Tsubasa inanılmaz!
Dialogue: 0,0:08:37.87,0:08:40.95,Default,,0,0,0,,Tekniklerini kendine has bir yöntmele kurtardı!
Dialogue: 0,0:08:40.95,0:08:45.16,Default,,0,0,0,,Ancak, Tachibana Twins'in hava futboluna karşı çok rahat edemezsiniz.\N
Dialogue: 0,0:08:45.16,0:08:47.32,Default,,0,0,0,,Bu sefer öyle böyle kurtarduk,ama...
Dialogue: 0,0:08:47.32,0:08:48.65,Default,,0,0,0,,İyi olacak!
Dialogue: 0,0:08:48.65,0:08:51.61,Default,,0,0,0,,Tsubasa başarıcaktır!
Dialogue: 0,0:08:51.61,0:08:54.12,Default,,0,0,0,,"Başarıcaktır"? Ahi hadi ama...
Dialogue: 0,0:08:54.12,0:08:56.00,Default,,0,0,0,,Haklısın, Kumi.
Dialogue: 0,0:08:56.64,0:09:01.64,Default,,0,0,0,,Rakipleri ne kadar iyi olursa olsun Tsubasa daha iyi olucak.
Dialogue: 0,0:09:01.64,0:09:03.39,Default,,0,0,0,,NANKATSU ORTAOKULU \NSHIZUOKA TEMSİLCİSİ
Dialogue: 0,0:09:03.39,0:09:06.90,Default,,0,0,0,,Ne?! Bu zıplamayla onları durduramaz mıyız?
Dialogue: 0,0:09:06.90,0:09:11.29,Default,,0,0,0,,Aynen öyle. Daha yukarı zıplamayı hedefliyorlar.
Dialogue: 0,0:09:11.29,0:09:14.26,Default,,0,0,0,,Çok yukarı dikemedikleri için yapmadılar.
Dialogue: 0,0:09:14.26,0:09:15.97,Default,,0,0,0,,Lanet olsun! Nasıl olur?
Dialogue: 0,0:09:15.97,0:09:18.03,Default,,0,0,0,,Bu biraz problem olucak.
Dialogue: 0,0:09:18.03,0:09:23.54,Default,,0,0,0,,Ama zıplamadıkları ana göre demekki bu hareket bacaklarını oldukça zorluyor.
Dialogue: 0,0:09:23.54,0:09:25.86,Default,,0,0,0,,Yani bu hareketi sürekli yapamazlar.
Dialogue: 0,0:09:25.86,0:09:27.79,Default,,0,0,0,,Oh, anlıyorum.
Dialogue: 0,0:09:27.79,0:09:32.75,Default,,0,0,0,,Şimdilik rakibimiz bizi ezmesini engelleyip kendi futbolumuza odaklanmalıyız.
Dialogue: 0,0:09:32.75,0:09:33.70,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:33.70,0:09:35.80,Default,,0,0,0,,Pekala, bizi bekle ikinci yarı!
Dialogue: 0,0:09:35.80,0:09:38.30,Default,,0,0,0,,Hadi yapalım şu işi!
Dialogue: 0,0:09:38.30,0:09:40.55,Default,,0,0,0,,HANAWA ORTAOKULU \NAKITA TEMSİLCİSİ
Dialogue: 0,0:09:39.09,0:09:40.55,Default-TOP,,0,0,0,,İyi gidiyorsunuz, beyler!
Dialogue: 0,0:09:40.55,0:09:42.93,Default,,0,0,0,,Böyle devam edip, maçı çevirin beyler!
Dialogue: 0,0:09:42.93,0:09:43.90,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:43.90,0:09:46.56,Default,,0,0,0,,İkinci yarıda Daimaru'nun sırası.
Dialogue: 0,0:09:48.14,0:09:50.12,Default,,0,0,0,,Sana güveniyoruz, Daimaru!
Dialogue: 0,0:09:51.36,0:09:52.40,Default,,0,0,0,,Tamam.
Dialogue: 0,0:09:52.93,0:09:53.86,Default,,0,0,0,,Pekala!
Dialogue: 0,0:09:53.86,0:09:57.86,Default,,0,0,0,,Nankatsu'yu yenmek için elinizden gelen her şeyi yapın!
Dialogue: 0,0:09:58.65,0:10:02.28,Default,,0,0,0,,Hanawa Ortaokulu'nda bir oyunca değişimi oldu.
Dialogue: 0,0:10:02.28,0:10:06.79,Default,,0,0,0,,{\i1}#3 Takeda yerine #12 Daimaru oyuna giriyor.{\i0}
Dialogue: 0,0:10:06.79,0:10:08.58,Default,,0,0,0,,İşte giriyor! Daimaru!
Dialogue: 0,0:10:08.58,0:10:10.29,Default,,0,0,0,,Sana güveniyoruz!
Dialogue: 0,0:10:13.55,0:10:15.73,Default,,0,0,0,,İriymiş. {for you}
Dialogue: 0,0:10:15.73,0:10:16.76,Default,,0,0,0,,Evet.
Dialogue: 0,0:10:18.22,0:10:21.89,Default,,0,0,0,,Şimdi Hanawa'nın santra vuruşuyla ikinci yarı başlıyor.
Dialogue: 0,0:10:26.77,0:10:27.96,Default,,0,0,0,,Kesin şu topun önünü!
Dialogue: 0,0:10:27.96,0:10:29.60,Default,,0,0,0,,Atak yapmalarına izin vermeyin!
Dialogue: 0,0:10:29.60,0:10:30.52,Default,,0,0,0,,Evet!
Dialogue: 0,0:10:31.93,0:10:32.69,Default,,0,0,0,,Daimaru!
Dialogue: 0,0:10:35.41,0:10:38.90,Default,,0,0,0,,Top maça yeni girmiş olan Daimaru'da.
Dialogue: 0,0:10:39.78,0:10:40.99,Default,,0,0,0,,İşte geliyor!
Dialogue: 0,0:10:44.00,0:10:46.37,Default,,0,0,0,,{\i1}Daimaru Topu yukarı dikiyor!{\i0}
Dialogue: 0,0:10:46.37,0:10:48.58,Default,,0,0,0,,{\i1}Top Nankatsu'nun kalesine doğru gidiyor!{\i0}
Dialogue: 0,0:10:48.58,0:10:49.83,Default,,0,0,0,,Bu çok saçma!
Dialogue: 0,0:10:49.83,0:10:51.46,Default,,0,0,0,,Nasıl güçlü bir vuruş öyle! {mai boi hyuga's is better}
Dialogue: 0,0:10:51.46,0:10:55.80,Default,,0,0,0,,Oyuna girme sebebim topa vurabilme gücüm!
Dialogue: 0,0:10:57.55,0:10:59.58,Default,,0,0,0,,Bu sefer yapcağız, Kazuo!
Dialogue: 0,0:10:59.58,0:11:00.58,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:00.58,0:11:04.29,Default,,0,0,0,,{\i1}Nankatsu maç başlar başlamaz baskı görüyor.{\i0}
Dialogue: 0,0:11:05.68,0:11:07.23,Default,,0,0,0,,{\i1}Sadece zıplayacağım. {\i0}
Dialogue: 0,0:11:07.23,0:11:08.73,Default,,0,0,0,,Zıplamaktan başka seçeneğim yok!
Dialogue: 0,0:11:10.23,0:11:11.28,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:11.28,0:11:12.23,Default,,0,0,0,,İşe yaramaz.
Dialogue: 0,0:11:13.73,0:11:18.49,Default,,0,0,0,,{\i1}Tsubasa, bizi zıplayarak durduramayacağını sana göstereceğim.{\i0}
Dialogue: 0,0:11:18.49,0:11:23.78,Default,,0,0,0,,Bu sefer Kazuo yere atlıyor.
Dialogue: 0,0:11:27.54,0:11:30.66,Default,,0,0,0,,Hadi! Yeni tekniğimiz...
Dialogue: 0,0:11:30.66,0:11:35.04,Default,,0,0,0,,Gökyüzü Fırtınası!
Dialogue: 0,0:11:35.04,0:11:38.05,Default,,0,0,0,,{\i1}İşte Gökyüzü fırtınası!{\i0}
Dialogue: 0,0:11:43.80,0:11:44.72,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:11:45.97,0:11:46.97,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:46.97,0:11:48.22,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:48.22,0:11:48.97,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:49.98,0:11:51.09,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:51.09,0:11:53.33,Default,,0,0,0,,Benim adım kanat anlamına geliyor.
Dialogue: 0,0:11:53.33,0:11:55.19,Default,,0,0,0,,Tek başıma o kadar yükseğe zıplayabilirim!
Dialogue: 0,0:11:56.12,0:11:59.49,Default,,0,0,0,,{\i1}Tsubasa zıplamak için bu sefer kalenin üst direğini klullanıyor,!{\i0}
Dialogue: 0,0:12:04.49,0:12:05.49,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:11:59.53,0:12:01.53,Default,,0,0,0,,{TWINS}
Dialogue: 0,0:12:12.46,0:12:13.46,Default,,0,0,0,,Oh...!
Dialogue: 0,0:12:13.46,0:12:14.21,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:17.54,0:12:20.57,Default,,0,0,0,,{\ i1} Havada zor bir çarpışma! {\ i0}
Dialogue: 0,0:12:22.65,0:12:25.55,Default,,0,0,0,,İkizlerin Gökyüzü Fırtınası tekniği engellendi!
Dialogue: 0,0:12:25.55,0:12:26.56,Default,,0,0,0,,Başardı!
Dialogue: 0,0:12:26.56,0:12:27.30,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:12:27.30,0:12:28.31,Default,,0,0,0,,Masao!
Dialogue: 0,0:12:28.31,0:12:30.02,Default,,0,0,0,,İşte Tsubasa be!
Dialogue: 0,0:12:30.02,0:12:30.93,Default,,0,0,0,,Harika!
Dialogue: 0,0:12:30.93,0:12:33.81,Default,,0,0,0,,Çok havalısın, Tsubasa!
Dialogue: 0,0:12:34.34,0:12:37.36,Default,,0,0,0,,{\i1}Woah. Dengelerini kaybettiler!{\i0} {like me and my bank account, we too have no balance}
Dialogue: 0,0:12:37.36,0:12:38.14,Default,,0,0,0,,Masao!
Dialogue: 0,0:12:38.14,0:12:38.86,Default,,0,0,0,,Bu iyi değil!
Dialogue: 0,0:12:40.28,0:12:41.69,Default,,0,0,0,,Bu yükseklikten, kafası...
Dialogue: 0,0:12:43.94,0:12:46.57,Default,,0,0,0,,Başları üstüne düştüler!
Dialogue: 0,0:12:46.57,0:12:47.32,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:12:47.32,0:12:48.49,Default,,0,0,0,,Tsubasa...!
Dialogue: 0,0:12:49.99,0:12:50.83,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:12:50.83,0:12:51.45,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:12:51.45,0:12:52.43,Default,,0,0,0,,Masao!
Dialogue: 0,0:12:52.43,0:12:54.43,Default,,0,0,0,,{touji!}
Dialogue: 0,0:12:52.43,0:12:54.53,Default,,0,0,0,,Çok kötü düştüler.
Dialogue: 0,0:12:54.53,0:12:56.38,Default,,0,0,0,,Maç durduruldu.
Dialogue: 0,0:12:56.38,0:12:58.43,Default,,0,0,0,,Yaralandın mı?
Dialogue: 0,0:12:58.43,0:12:59.69,Default,,0,0,0,,Hey, Tsubasa!
Dialogue: 0,0:13:00.46,0:13:02.38,Default,,0,0,0,,Omzun... {That's what you get for trying to be a hero son}
Dialogue: 0,0:13:02.38,0:13:07.14,Default,,0,0,0,,Görünüşe göre en çok hasarı Tsubasa aldı.
Dialogue: 0,0:13:07.14,0:13:09.40,Default,,0,0,0,,İyi misin, Masao? {I mean, there was a spare Masao, Tsubasa, you didnt need to}{a ticket to hell}
Dialogue: 0,0:13:09.40,0:13:12.17,Default,,0,0,0,,Tsubasa beni kapattı, ve...
Dialogue: 0,0:13:12.64,0:13:13.87,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:13.87,0:13:15.13,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:16.34,0:13:18.40,Default,,0,0,0,,{Kurosaki-kun! Oh boy}
Dialogue: 0,0:13:16.38,0:13:18.40,Default,,0,0,0,,Beyler, iyi misiniz?
Dialogue: 0,0:13:18.40,0:13:20.65,Default,,0,0,0,,Evet!
Dialogue: 0,0:13:21.29,0:13:22.82,Default,,0,0,0,,Ben... {\alpha&HFF&}fine.
Dialogue: 0,0:13:22.82,0:13:24.65,Default,,0,0,0,,Ben... İyiyim.
Dialogue: 0,0:13:25.65,0:13:26.57,Default,,0,0,0,,Bu iyi değil.
Dialogue: 0,0:13:26.57,0:13:28.32,Default,,0,0,0,,Omzun çıkmış olabilir.
Dialogue: 0,0:13:29.04,0:13:31.56,Default,,0,0,0,,Hemen revire gitmelisin.
Dialogue: 0,0:13:31.56,0:13:33.80,Default,,0,0,0,,Böyle küçük bir şey beni engellemez...
Dialogue: 0,0:13:33.80,0:13:35.54,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:37.25,0:13:39.00,Default,,0,0,0,,Ben iyiyim... {daijoubuuuu, he can play unless his arm is ripped off}
Dialogue: 0,0:13:39.00,0:13:41.38,Default,,0,0,0,,Oyuna devam edeceğim.
Dialogue: 0,0:13:41.38,0:13:43.88,Default,,0,0,0,,Kesinlikle devam edeceğim!
Dialogue: 0,0:13:43.88,0:13:44.97,Default,,0,0,0,,Evlat... {hello to the kratos reis}
Dialogue: 0,0:13:44.97,0:13:47.17,Default,,0,0,0,,Tsubasa, bu imkansız.
Dialogue: 0,0:13:47.17,0:13:48.89,Default,,0,0,0,,Yüzün de solgunlaşıyor.
Dialogue: 0,0:13:48.89,0:13:50.59,Default,,0,0,0,,Tedavi olup tekrar gelin.
Dialogue: 0,0:13:50.59,0:13:53.21,Default,,0,0,0,,Evet, o zamana kadar biz tutarız.
Dialogue: 0,0:13:53.21,0:13:54.78,Default,,0,0,0,,Olmaz.
Dialogue: 0,0:13:54.78,0:13:56.52,Default,,0,0,0,,Haklılar.
Dialogue: 0,0:13:56.52,0:13:58.58,Default,,0,0,0,,Hemen revire git.
Dialogue: 0,0:13:58.58,0:14:00.29,Default,,0,0,0,,Bu bir emirdir.
Dialogue: 0,0:14:01.19,0:14:04.19,Default,,0,0,0,,Eğer reddedersen seni oyundan çıkartırım.
Dialogue: 0,0:14:06.01,0:14:07.26,Default,,0,0,0,,Tamam, öyle olsun.
Dialogue: 0,0:14:07.26,0:14:08.45,Default,,0,0,0,,Anlaşıldı... {lol all your bravado <3}
Dialogue: 0,0:14:08.45,0:14:10.12,Default,,0,0,0,,Üzgünüm beyler.
Dialogue: 0,0:14:10.12,0:14:11.61,Default,,0,0,0,,Siz fark etmeden geri dönmüş olacağım.
Dialogue: 0,0:14:11.61,0:14:15.08,Default,,0,0,0,,Birazdan dönerim.
Dialogue: 0,0:14:15.08,0:14:16.96,Default,,0,0,0,,Güven bize!
Dialogue: 0,0:14:19.90,0:14:23.59,Default,,0,0,0,,Görünüşe göre Tsubasa sakatlığı sebebiyle oyundan çıkıyor.
Dialogue: 0,0:14:23.59,0:14:24.82,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:24.82,0:14:30.83,Default,,0,0,0,,Nankatsu golü engelledi ama bunun \Niçin büyük bir bedel ödemiş olabilirler.
Dialogue: 0,0:14:30.83,0:14:33.25,Default,,0,0,0,,{\ i1} Futbol zalim bir spordur. {\ i0} {oh, ben sadece biliyordum}\N
Dialogue: 0,0:14:30.83,0:14:33.25,Default,,0,0,0,,{非常, and not 非情}
Dialogue: 0,0:14:33.25,0:14:36.99,Default,,0,0,0,,Tedavi olurken maç devam edicek.
Dialogue: 0,0:14:36.99,0:14:38.70,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:14:38.70,0:14:39.81,Default,,0,0,0,,Sanae!
Dialogue: 0,0:14:39.81,0:14:42.02,Default,,0,0,0,,Nankatsu tehlikede.
Dialogue: 0,0:14:42.42,0:14:43.77,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:14:43.77,0:14:45.69,Default,,0,0,0,,Bu bir felaket...
Dialogue: 0,0:14:45.69,0:14:48.51,Default,,0,0,0,,Nankatsu köşeye sıkıştı.
Dialogue: 0,0:14:48.51,0:14:54.37,Default,,0,0,0,,Ağır yaralanmışsa turnuvanın devamında oynayamayabilir.
Dialogue: 0,0:14:56.70,0:15:01.00,Default,,0,0,0,,Hanawa korner vuruşu kullanıcak.
Dialogue: 0,0:15:01.00,0:15:03.66,Default,,0,0,0,,Kesinlikle teniklerini kullanacaklar.
Dialogue: 0,0:15:03.66,0:15:04.99,Default,,0,0,0,,Orası kesin.
Dialogue: 0,0:15:04.99,0:15:06.64,Default,,0,0,0,,Taki ve ben onları engelleyeceğiz.
Dialogue: 0,0:15:06.64,0:15:08.26,Default,,0,0,0,,Evet, hadi onlara gösterelim!
Dialogue: 0,0:15:08.26,0:15:09.20,Default,,0,0,0,,Pekala, beyler!
Dialogue: 0,0:15:09.20,0:15:13.09,Default,,0,0,0,,Dinleyin, Tsubasa dönene kadar, ne olursa olsun gol atmalarına izin vermeyeceğiz!
Dialogue: 0,0:15:13.09,0:15:13.68,Default,,0,0,0,,Tamam!
Dialogue: 0,0:15:13.68,0:15:17.96,Default,,0,0,0,,Tsubasa seni kurtarmak için sakatlanmış olabilir, ama dinle...
Dialogue: 0,0:15:17.96,0:15:19.89,Default,,0,0,0,,Geride durmayacağız.
Dialogue: 0,0:15:19.89,0:15:22.01,Default,,0,0,0,,Savaşmanın kuralı bu.
Dialogue: 0,0:15:22.01,0:15:23.69,Default,,0,0,0,,Biliyorum, Kazuo.
Dialogue: 0,0:15:24.16,0:15:28.36,Default,,0,0,0,,Hadi bir daha yapalım Gökyüzü Fırtınası'nı!
Dialogue: 0,0:15:32.91,0:15:35.33,Default,,0,0,0,,REVİR {lol what are those sounds?} {they just re-set his shoulder that shit HURTS}
Dialogue: 0,0:15:35.33,0:15:36.56,Default,,0,0,0,,Ne?
Dialogue: 0,0:15:36.56,0:15:37.93,Default,,0,0,0,,Ne oluyor içerde?
Dialogue: 0,0:15:39.07,0:15:41.87,Default,,0,0,0,,{\i1}Oh! Bu...!{\i0}
Dialogue: 0,0:15:43.29,0:15:44.22,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:44.22,0:15:45.71,Default,,0,0,0,,Buna izin veriliyor mu?
Dialogue: 0,0:15:47.09,0:15:50.41,Default,,0,0,0,,{\i1}Nankatsu çok cesu bir strateji uyguluyor!{\i0}
Dialogue: 0,0:15:50.41,0:15:53.47,Default,,0,0,0,,{\i1}Kisugi ve Taki kalenin üstünde bekliyorlar.{\i0}
Dialogue: 0,0:15:53.47,0:15:56.93,Default,,0,0,0,,Gökyüzü Fırtınası'nı engellemek için güzel bir taktik.
Dialogue: 0,0:15:56.93,0:15:59.16,Default,,0,0,0,,Tsubasa'nın bize verdiği taktik...
Dialogue: 0,0:15:59.16,0:16:01.45,Default,,0,0,0,,Onun yatpığını yapamayız
Dialogue: 0,0:16:01.45,0:16:04.03,Default,,0,0,0,,ama önceden tırmanabiliriz!
Dialogue: 0,0:16:04.03,0:16:07.07,Default,,0,0,0,,Gökyüzü Fırtnasını engelleyeceğiz.
Dialogue: 0,0:16:08.08,0:16:09.06,Default,,0,0,0,,İlginç!
Dialogue: 0,0:16:09.06,0:16:10.88,Default,,0,0,0,,İstersen zıpla!
Dialogue: 0,0:16:11.53,0:16:13.28,Default,,0,0,0,,Hadi, Daimaru!
Dialogue: 0,0:16:13.28,0:16:13.95,Default,,0,0,0,,Tabiki!
Dialogue: 0,0:16:13.95,0:16:17.12,Default,,0,0,0,,{\i1}Şimdi Masao yerde!{\i0}
Dialogue: 0,0:16:17.12,0:16:19.30,Default,,0,0,0,,Pekala! Kisugi, Taki!
Dialogue: 0,0:16:19.30,0:16:21.64,Default,,0,0,0,,Tüm gücünüzle zıplayın ve onları durdurun!
Dialogue: 0,0:16:21.64,0:16:22.58,Default,,0,0,0,,Tamam!
Dialogue: 0,0:16:22.58,0:16:23.71,Default,,0,0,0,,İşte geliyor!
Dialogue: 0,0:16:24.14,0:16:26.46,Default,,0,0,0,,Bu sefer alçak bir top atıyor!
Dialogue: 0,0:16:26.46,0:16:27.59,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:27.59,0:16:28.84,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:16:30.63,0:16:33.88,Default,,0,0,0,,Gökyüzü Fırtınası sadece yükseğe zıplamaktan ibaret değil!
Dialogue: 0,0:16:33.88,0:16:36.64,Default,,0,0,0,,Her şartta zıplarız!
Dialogue: 0,0:16:39.31,0:16:45.02,Default,,0,0,0,,Hadi Alçak Uçuş Gökyüzü Fırtınası!
Dialogue: 0,0:16:45.43,0:16:48.52,Default,,0,0,0,,{\i1}Kazuo ardınan hafifçe zıplıyor.
Dialogue: 0,0:16:48.52,0:16:49.76,Default,,0,0,0,,Hafifçe mi?
Dialogue: 0,0:16:49.76,0:16:50.65,Default,,0,0,0,,Onu durduracağız!
Dialogue: 0,0:16:55.11,0:16:58.02,Default,,0,0,0,,Top ağlarda! Hanawa ikinci yarıda iknici golünü buluyor!
Dialogue: 0,0:16:58.02,0:17:01.54,Default,,0,0,0,,İkinci yarının 7. dakikasında skoru eşitlediler!
Dialogue: 0,0:17:02.43,0:17:04.05,Default,,0,0,0,,İşte bu! Berabere!
Dialogue: 0,0:17:04.05,0:17:05.67,Default,,0,0,0,,Sonunda!
Dialogue: 0,0:17:05.67,0:17:08.17,Default,,0,0,0,,Güzel şut, Masao, Kazuo!
Dialogue: 0,0:17:08.17,0:17:10.29,Default,,0,0,0,,The Skylab Hurricane engellenemez!
Dialogue: 0,0:17:10.29,0:17:12.14,Default,,0,0,0,,Harika, bu maçı alabiliriz.
Dialogue: 0,0:17:12.14,0:17:15.26,Default,,0,0,0,,Bu şekilde devam edersek Nankatsu'yu yenebiliriz!
Dialogue: 0,0:17:15.26,0:17:17.62,Default,,0,0,0,,Pekala! Hadi maçı çevirelim!
Dialogue: 0,0:17:17.62,0:17:19.26,Default,,0,0,0,,Bu iyi değil.
Dialogue: 0,0:17:19.26,0:17:21.56,Default,,0,0,0,,Eğer her açıdan zıplayabiliyorlarsa,
Dialogue: 0,0:17:21.56,0:17:23.48,Default,,0,0,0,,onları durdurmaya çalışmamız anlamsız!
Dialogue: 0,0:17:23.48,0:17:25.73,Default,,0,0,0,,REVİR
Dialogue: 0,0:17:27.52,0:17:30.04,Default,,0,0,0,,Sanırım çığlıklarını duydunuz.
Dialogue: 0,0:17:30.04,0:17:33.20,Default,,0,0,0,,Sadece biraz zorladım. Endişelencek bir şey yok.
Dialogue: 0,0:17:35.56,0:17:39.37,Default,,0,0,0,,Doktor, maça devam edebilecek mi?
Dialogue: 0,0:17:39.37,0:17:40.06,Default,,0,0,0,,Huh?
Dialogue: 0,0:17:40.06,0:17:41.29,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:41.29,0:17:45.20,Default,,0,0,0,,Bu tedavi onu oyuna döndürür.
Dialogue: 0,0:17:45.20,0:17:49.92,Default,,0,0,0,,Nankatsu, sonuçta Tsubasa Ozora'nın etrafında kurulan bir ekip.\N
Dialogue: 0,0:17:49.92,0:17:54.81,Default,,0,0,0,,Kaptan olmadan bu turnuvayı kazanamazlar.
Dialogue: 0,0:17:54.81,0:17:56.13,Default,,0,0,0,,Öyle değil mi kaptan?
Dialogue: 0,0:17:56.72,0:17:57.30,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:57.30,0:17:58.39,Default,,0,0,0,,Oh...
Dialogue: 0,0:17:59.31,0:18:05.39,Default,,0,0,0,,Bandajlayacağım ama elinden\N geldiğince hareket ettirmemelisin.
Dialogue: 0,0:18:05.39,0:18:09.45,Default,,0,0,0,,Ayrıca bir daha o kadar yükseğe zıplamamalısın.
Dialogue: 0,0:18:09.45,0:18:10.15,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:10.15,0:18:14.42,Default,,0,0,0,,Omzun aynı şekilde bir daha çıkarsa
Dialogue: 0,0:18:14.42,0:18:17.49,Default,,0,0,0,,maçın kalanında oynayamazsın.
Dialogue: 0,0:18:17.49,0:18:21.14,Default,,0,0,0,,Oraya geri çıkmana izin vermem.
Dialogue: 0,0:18:21.14,0:18:22.24,Default,,0,0,0,,Bunu aklında tut tamam mı?
Dialogue: 0,0:18:22.24,0:18:23.41,Default,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:18:24.72,0:18:26.26,Default,,0,0,0,,Çok teşekkürler.
Dialogue: 0,0:18:28.25,0:18:29.01,Default,,0,0,0,,Hm?
Dialogue: 0,0:18:31.81,0:18:33.88,Default,,0,0,0,,Yapabildiğinin en iyisini yap, Tsubasa. {w-what did she do?}
Dialogue: 0,0:18:34.28,0:18:35.59,Default,,0,0,0,,Tabiki de.
Dialogue: 0,0:18:39.06,0:18:39.59,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:18:39.94,0:18:40.85,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:18:40.85,0:18:42.10,Default,,0,0,0,,Oyun nasıl?
Dialogue: 0,0:18:42.84,0:18:43.92,Default,,0,0,0,,Berabere demek.
Dialogue: 0,0:18:43.92,0:18:45.52,Default,,0,0,0,,Tutamadılar oyunu.
Dialogue: 0,0:18:45.52,0:18:49.02,Default,,0,0,0,,Gökyüzü Fırtınası her açıdan yapılabiliyor.
Dialogue: 0,0:18:49.02,0:18:51.23,Default,,0,0,0,,Ne? Her açıdan mı?
Dialogue: 0,0:18:51.23,0:18:52.08,Default,,0,0,0,,Sende!
Dialogue: 0,0:18:52.08,0:18:52.86,Default,,0,0,0,,Yakaladım!
Dialogue: 0,0:18:52.86,0:18:54.51,Default,,0,0,0,,Topu bir anda aldılar!
Dialogue: 0,0:18:54.51,0:18:55.23,Default,,0,0,0,,Durdurun onları!
Dialogue: 0,0:18:55.23,0:18:57.32,Default,,0,0,0,,Hadi maçı hemen çevirelim!
Dialogue: 0,0:19:00.95,0:19:02.16,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:02.16,0:19:06.91,Default,,0,0,0,,Tsubasa tedavisi bitti ve oyuna girmek için hazır bekliyor.
Dialogue: 0,0:19:07.38,0:19:09.85,Default,,0,0,0,,Beyler, oyuna odaklanın!
Dialogue: 0,0:19:09.85,0:19:12.04,Default,,0,0,0,,Ben de sizinle savaşacağım!
Dialogue: 0,0:19:12.04,0:19:12.93,Default,,0,0,0,,Lanet olsun.
Dialogue: 0,0:19:12.93,0:19:14.80,Default,,0,0,0,,Demek oynamaya devam edebilecek.
Dialogue: 0,0:19:14.80,0:19:15.95,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:15.95,0:19:18.32,Default,,0,0,0,,Başka şekilde zevki olmazdı.
Dialogue: 0,0:19:18.32,0:19:19.17,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:19.17,0:19:22.62,Default,,0,0,0,,Eğer oyun durmazsa Tsubasa oyuna giremez.
Dialogue: 0,0:19:22.62,0:19:24.68,Default,,0,0,0,,O oyuna girmeden öne geçmeliyiz.
Dialogue: 0,0:19:24.68,0:19:27.93,Default,,0,0,0,,Ve tabiki de bunu Gökyüzü Fırtınası ile yapacağız!
Dialogue: 0,0:19:27.93,0:19:29.21,Default,,0,0,0,,Yine geliyorlar.
Dialogue: 0,0:19:29.21,0:19:31.48,Default,,0,0,0,,Topu dikmelerine izin vermeyin!
Dialogue: 0,0:19:31.48,0:19:32.44,Default,,0,0,0,,Evet!
Dialogue: 0,0:19:32.44,0:19:35.48,Default,,0,0,0,,{\i1}Nankatsu Daimaru'yu markajlamaya gidiyor!{\i0} {his name is fat circle.}
Dialogue: 0,0:19:35.89,0:19:36.61,Default,,0,0,0,,İşte.
Dialogue: 0,0:19:38.32,0:19:39.15,Default,,0,0,0,,Geliyor!
Dialogue: 0,0:19:39.66,0:19:41.95,Default,,0,0,0,,{\i1}Bu sefer topu Aimoto dikti!{\i0}
Dialogue: 0,0:19:41.95,0:19:42.91,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:19:46.87,0:19:48.45,Default,,0,0,0,,Geliyorum Masao! {it should have been madao}{https://www.youtube.com/watch?v=7pCEvIklfIs <3 Madao best gril https://youtu.be/x28cp3UOpTk}{DANBOORUUUU RUU RUU RUU RUUU. delectable taste forsooth}
Dialogue: 0,0:19:49.29,0:19:52.46,Default,,0,0,0,,{\ i1} Nankatsu için umutsuz bir durum! {\ i0}
Dialogue: 0,0:19:52.46,0:19:53.42,Default,,0,0,0,,Beyler!
Dialogue: 0,0:19:54.80,0:19:57.17,Default,,0,0,0,,Hadi, Gökyüzü...!
Dialogue: 0,0:19:57.17,0:19:57.96,Default,,0,0,0,,Başardılar!
Dialogue: 0,0:19:57.96,0:19:59.17,Default,,0,0,0,,Maç dönüyor!
Dialogue: 0,0:20:00.22,0:20:01.72,Default,,0,0,0,,Ah!
Dialogue: 0,0:20:01.72,0:20:03.72,Default,,0,0,0,,{Kazuo, you should have lose weight boi}
Dialogue: 0,0:20:03.09,0:20:03.98,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:03.98,0:20:05.35,Default,,0,0,0,,Zıplayamadılar!
Dialogue: 0,0:20:05.35,0:20:06.39,Default,,0,0,0,,Kırıldı!
Dialogue: 0,0:20:06.39,0:20:10.00,Default,,0,0,0,,Tachibana İkizler Gökyüzü Fırtınası\N hareketini yapamadılar.
Dialogue: 0,0:20:10.00,0:20:10.81,Default,,0,0,0,,Masao!
Dialogue: 0,0:20:10.81,0:20:11.52,Default,,0,0,0,,Kazuo!
Dialogue: 0,0:20:11.52,0:20:13.13,Default,,0,0,0,,Buraya kadarmış demek?
Dialogue: 0,0:20:13.13,0:20:14.20,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:20:14.20,0:20:16.61,Default,,0,0,0,,Görünüşe göre ikisininde ayağı kilitlenmiş durumda.
Dialogue: 0,0:20:16.61,0:20:18.61,Default,,0,0,0,,Öyle böyle kurtulduk bundan da.
Dialogue: 0,0:20:18.61,0:20:19.56,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:19.56,0:20:24.32,Default,,0,0,0,,Demek Tsubasa'nın hareket hakkında dediği doğruymuş.
Dialogue: 0,0:20:25.69,0:20:27.00,Default,,0,0,0,,İşte geliyor!
Dialogue: 0,0:20:27.00,0:20:31.66,Default,,0,0,0,,{\i1}Nankatsu'nun kaptanı Tsubasa küçük bir aradan sonra hemen döndü.
Dialogue: 0,0:20:31.66,0:20:33.66,Default,,0,0,0,,İyi şanslar, Tsubasa!
Dialogue: 0,0:20:33.66,0:20:35.31,Default,,0,0,0,,Tsubasa, sana güveniyoruz!
Dialogue: 0,0:20:35.31,0:20:37.88,Default,,0,0,0,,Seni bekliyoruz, Tsubasa!
Dialogue: 0,0:20:37.88,0:20:40.67,Default,,0,0,0,,Demek döndün, Tsubasa.{\i0}
Dialogue: 0,0:20:40.67,0:20:41.58,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:41.58,0:20:43.12,Default,,0,0,0,,Omzun iyi mi?
Dialogue: 0,0:20:43.12,0:20:44.43,Default,,0,0,0,,Evet, gayet iyi.
Dialogue: 0,0:20:44.43,0:20:46.22,Default,,0,0,0,,Üzgünüm, Tsubasa.
Dialogue: 0,0:20:46.22,0:20:47.82,Default,,0,0,0,,Başarısız olduk. Maç berabere.
Dialogue: 0,0:20:47.82,0:20:49.56,Default,,0,0,0,,Sadece berabere oldu.
Dialogue: 0,0:20:49.56,0:20:51.09,Default,,0,0,0,,Endişelenmeyin beyler, endişelenmeyin!
Dialogue: 0,0:20:51.09,0:20:52.18,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:20:52.18,0:20:55.57,Default,,0,0,0,,Eğer bize yetiştilerse tek yapmamız \Ngereken tekrar öne geçmek.
Dialogue: 0,0:20:55.57,0:20:59.32,Default,,0,0,0,,Hadi ilk yarıda gösterdiğimiz baskıyı tekrar gösterelim!
Dialogue: 0,0:20:59.32,0:21:00.82,Default,,0,0,0,,Evet!
Dialogue: 0,0:21:00.82,0:21:04.27,Default,,0,0,0,,Bacaklar iyileşene kadar defans yapmalıyız galiba.
Dialogue: 0,0:21:04.27,0:21:08.88,Default,,0,0,0,,Bu maç Gökyüzü Fırtınası'nı ancak bir kez daha kullanabiliriz.
Dialogue: 0,0:21:08.88,0:21:11.86,Default,,0,0,0,,O zamana kadar Nankatsu'nun ataklarını engellemeliyiz.
Dialogue: 0,0:21:11.86,0:21:12.83,Default,,0,0,0,,Evet!
Dialogue: 0,0:21:12.83,0:21:16.33,Default,,0,0,0,,Maç Nankatsu'nun out kullanışıyla devam edecek!
Dialogue: 0,0:21:16.33,0:21:21.59,Default,,0,0,0,,Geri 11 oyuncuya tamamlanan Nankatsu nasıl bir oyun sergileyecek?
Dialogue: 0,0:21:22.57,0:21:23.26,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:21:23.26,0:21:24.42,Default,,0,0,0,,Sana güveniyorum!
Dialogue: 0,0:21:25.50,0:21:30.43,Default,,0,0,0,,Kaleye öylece gidemiyorum. Omzumdan dolayı fiziksel müdaheleden kaçınmam lazım.
Dialogue: 0,0:21:30.43,0:21:33.89,Default,,0,0,0,,O zaman oyun kurucu olarak devam edeyim.
Dialogue: 0,0:21:33.89,0:21:36.65,Default,,0,0,0,,Gol atmayıp attırayım.
Dialogue: 0,0:21:37.40,0:21:41.98,Default,,0,0,0,,Tachibana ikizler Taki ve Kisugi'ye bire bir markaj yapıyor.
Dialogue: 0,0:21:41.98,0:21:44.49,Default,,0,0,0,,İkizler defansif kalmayı yeğlediler.
Dialogue: 0,0:21:44.49,0:21:47.86,Default,,0,0,0,,Diğerleride orta sahanın biraz gerisinde bekliyorlar.
Dialogue: 0,0:21:47.86,0:21:52.70,Default,,0,0,0,,{\ i1} Tachibana Twins'in bacakları iyileşene kadar bu skoru korumayı mı planlıyorlar? {\ i0}
Dialogue: 0,0:21:52.70,0:21:54.47,Default,,0,0,0,,Hey, maça odaklan!
Dialogue: 0,0:21:54.47,0:21:55.71,Default,,0,0,0,,İşte benim şansım!
Dialogue: 0,0:21:55.71,0:21:57.17,Default,,0,0,0,,Tsubasa, geliyor!
Dialogue: 0,0:21:57.17,0:21:59.23,Default,,0,0,0,,Kaleye gidemem.
Dialogue: 0,0:21:59.23,0:22:01.07,Default,,0,0,0,,{\i1}Kisugi veya Taki'yi de kullanamam.
Dialogue: 0,0:22:01.07,0:22:04.17,Default,,0,0,0,,O zaman bunun sadece bir yolu var.
Dialogue: 0,0:22:05.06,0:22:05.97,Default,,0,0,0,,Ne?!
Dialogue: 0,0:22:13.29,0:22:17.22,Default,,0,0,0,,Tek yolu ölü yaprak vuruşu!
Dialogue: 0,0:22:18.00,0:22:19.44,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.99,0:23:59.99,Default,,0,0,0,,GELECEK BÖLÜM 39: \NNANKATSU VS. HANAWA - SONUÇ!
Dialogue: 0,0:23:49.99,0:23:59.99,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:00:52.29,0:00:55.00,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:55.91,0:00:58.58,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:59.50,0:01:02.21,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:09.09,0:01:11.93,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:11.93,0:01:18.19,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:01:18.19,0:01:24.07,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta na no ni
Dialogue: 0,0:01:24.07,0:01:30.66,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:01:30.66,0:01:34.66,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:34.66,0:01:39.17,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:39.17,0:01:44.71,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:01:44.71,0:01:46.30,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:01:46.30,0:01:47.51,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:47.51,0:01:51.01,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:01:51.01,0:02:00.90,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:02:00.90,0:02:01.73,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:01.73,0:02:05.53,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:02:05.53,0:02:09.53,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:02:09.53,0:02:15.79,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:02:15.79,0:02:18.58,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:00:52.29,0:00:55.00,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:55.91,0:00:58.58,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:59.50,0:01:02.21,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:09.09,0:01:11.93,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum. {I keep lying to myself}
Dialogue: 0,0:01:11.93,0:01:18.19,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile {burning with loneliness}
Dialogue: 0,0:01:18.19,0:01:24.07,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:24.07,0:01:30.66,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:30.66,0:01:34.66,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:34.66,0:01:39.17,OPED,,0,0,0,,Sesinin özlemi{i hate how weak I am \N yearning for your voice}
Dialogue: 0,0:01:39.17,0:01:44.71,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:01:44.71,0:01:46.30,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:01:46.30,0:01:47.51,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:47.51,0:01:51.01,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:01:51.01,0:02:00.90,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:02:00.90,0:02:01.73,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:01.73,0:02:05.53,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:02:05.53,0:02:09.53,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:09.53,0:02:15.79,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:02:15.79,0:02:18.58,OPED,,0,0,0,,Bir an için bile!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.75,0:22:44.80,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.80,0:22:50.80,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.80,0:22:56.85,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.85,0:23:01.48,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:03.11,0:23:07.78,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:09.11,0:23:15.20,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:15.20,0:23:21.25,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.25,0:23:25.71,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:27.01,0:23:33.35,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.35,0:23:39.39,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.39,0:23:45.69,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.75,0:22:44.80,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.80,0:22:50.80,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.80,0:22:56.85,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.85,0:23:01.48,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.11,0:23:07.78,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:09.11,0:23:15.20,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:15.20,0:23:21.25,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.25,0:23:25.71,OPED,,0,0,0,,Bir gün, bir şimşek vuruşunu yapacağım!
Dialogue: 0,0:23:27.01,0:23:33.35,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.35,0:23:39.39,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.39,0:23:45.69,OPED,,0,0,0,,Bu hırslı gençlik sahada!
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
