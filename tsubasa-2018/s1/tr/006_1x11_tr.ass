Dialogue: 0,0:03:33.88,0:03:39.77,Default - Top,,0,0,0,,Shizuoka bölge elemeleri yarı finalinin 2. oyununda\NNankatsu FC ile Shimada İlkokulu karşı karşıya.
Dialogue: 0,0:03:39.77,0:03:43.94,Default,,0,0,0,,Herkesin gözü elemeleri kazanma\Nnoktasında Nankatsu FC'de.
Dialogue: 0,0:03:44.39,0:03:48.01,Default,,0,0,0,,Merkez forvet Ozora Tsubasa-kun'un\Nbaşı çektiği ataklar sayesinde...
Dialogue: 0,0:03:48.01,0:03:53.08,Default,,0,0,0,,...ortalama olarak her maç 9 gol\Nattılar ve turnuvanın lider gücüler.
Dialogue: 0,0:03:53.08,0:03:59.38,Default,,0,0,0,,Ayrıca dahi kaleci Wakabayashi-kun da\Narka arkaya 6 maç boyunca hiç gol yemedi.
Dialogue: 0,0:03:59.38,0:04:03.38,Default,,0,0,0,,Ne var ki bacağındaki yaralanma sebebiyle\NWakabayashi-kun bu maça çıkmayacak.
Dialogue: 0,0:04:03.38,0:04:08.26,Default,,0,0,0,,Bu maçta Nankatsu kalesini, 12 numara\NMorisaki Yuzo-kun koruyacak.
Dialogue: 0,0:04:08.26,0:04:11.10,Default,,0,0,0,,Öte yandan Shimada İlkokulu Futbol Kulübü...
Dialogue: 0,0:04:11.10,0:04:15.56,Default,,0,0,0,,...azim ve takım oyunuyla\Nburaya kadar gelmiş bir takım.
Dialogue: 0,0:04:15.56,0:04:19.33,Default,,0,0,0,,Yarı finallerin ilk maçı\NWakabayashi-kun ile kıyaslanan...
Dialogue: 0,0:04:19.33,0:04:24.07,Default,,0,0,0,,...dahi kaleci Kawakami-kun'un olduğu\Nünlü Shimizu FC tarafından kazanıldı.
Dialogue: 0,0:04:24.07,0:04:29.66,Default,,0,0,0,,Finallere gidecek galip Nankatsu mu\NShimada İlkokulu mu olacak?
Dialogue: 0,0:04:29.66,0:04:32.51,Default,,0,0,0,,Ne? Demek bunlar Nankatsu ha?
Dialogue: 0,0:04:32.51,0:04:35.05,Default,,0,0,0,,Herkes futbolda çok yetenekli duruyor.
Dialogue: 0,0:04:35.05,0:04:36.75,Default,,0,0,0,,İyi geçinelim lütfen!
Dialogue: 0,0:04:36.75,0:04:38.37,Default,,0,0,0,,Nazik davranalım!
Dialogue: 0,0:04:38.37,0:04:40.30,Default,,0,0,0,,B-Bunların neyi var?
Dialogue: 0,0:04:40.30,0:04:41.88,Default,,0,0,0,,Tuhaf bir ruh halleri var.
Dialogue: 0,0:04:44.13,0:04:45.42,Default,,0,0,0,,Hey!
Dialogue: 0,0:04:48.18,0:04:49.43,Default,,0,0,0,,Seni...
Dialogue: 0,0:04:50.64,0:04:53.12,Default,,0,0,0,,Ne? Çok da güçlü değiller gibi.
Dialogue: 0,0:04:53.12,0:04:54.72,Default,,0,0,0,,Hey, Izawa!
Dialogue: 0,0:04:56.10,0:04:57.73,Default,,0,0,0,,Ne yapıyor bunlar?
Dialogue: 0,0:04:57.73,0:04:59.55,Default,,0,0,0,,Atak yapmayacaklar mı?
Dialogue: 0,0:04:59.55,0:05:01.69,Default,,0,0,0,,Topu almaya çalışmıyorlar.
Dialogue: 0,0:05:02.52,0:05:04.36,Default,,0,0,0,,Bugün kolayca kazanacak gibiyiz.
Dialogue: 0,0:05:05.28,0:05:06.28,Default,,0,0,0,,Al bakalım Tsubasa!
Dialogue: 0,0:05:06.28,0:05:09.20,Default,,0,0,0,,Nankatsu'dan Izawa-kun\Nileri hatta uzun bir pas yolluyor!
Dialogue: 0,0:05:09.20,0:05:10.32,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:05:11.09,0:05:12.44,Default,,0,0,0,,Kesti!
Dialogue: 0,0:05:12.44,0:05:14.99,Default,,0,0,0,,Izawa-kun'un uzun pası yerine varamıyor.
Dialogue: 0,0:05:14.99,0:05:16.75,Default,,0,0,0,,Güzel kestin Fujisawa.
Dialogue: 0,0:05:16.75,0:05:18.05,Default,,0,0,0,,O-Olamaz.
Dialogue: 0,0:05:18.05,0:05:19.75,Default,,0,0,0,,Çok belli değil mi?
Dialogue: 0,0:05:19.75,0:05:20.92,Default,,0,0,0,,İşte!
Dialogue: 0,0:05:20.92,0:05:22.41,Default,,0,0,0,,Topu alan Fujisawa-kun...
Dialogue: 0,0:05:22.41,0:05:23.79,Default,,0,0,0,,{\an8}Eyvah! Geri dönün!
Dialogue: 0,0:05:22.41,0:05:25.42,Default,,0,0,0,,...ön taraflardaki takım arkadaşına\Nuzun bir pas gönderiyor.
Dialogue: 0,0:05:25.42,0:05:28.17,Default,,0,0,0,,Top, Shimada İlkokulu kaptanı\NNagasaki-kun'a ulaşıyor.
Dialogue: 0,0:05:28.17,0:05:29.05,Default,,0,0,0,,Lanet olsun!{Poop was cute :) poop is unko, kuso is shit}
Dialogue: 0,0:05:29.05,0:05:32.76,Default,,0,0,0,,Nankatsu defansı daha\Ntoparlanamadan yakalanıyor.
Dialogue: 0,0:05:32.76,0:05:34.89,Default,,0,0,0,,Ne yapıyorsun Morisaki?!
Dialogue: 0,0:05:34.89,0:05:37.02,Default,,0,0,0,,Defansın ilk çizgisini tutmalıydın!
Dialogue: 0,0:05:37.02,0:05:38.31,Default,,0,0,0,,E-Evet.
Dialogue: 0,0:05:38.31,0:05:40.72,Default,,0,0,0,,Ya hep ya hiç!
Dialogue: 0,0:05:40.72,0:05:41.40,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:41.40,0:05:45.19,Default,,0,0,0,,Nagasaki-kun beklenmedik bir şekilde\Nuzun bir şut çekiyor!
Dialogue: 0,0:05:45.19,0:05:46.23,Default,,0,0,0,,Kaleci uzanamıyor!
Dialogue: 0,0:05:48.82,0:05:50.20,Default,,0,0,0,,G-Girdi.
Dialogue: 0,0:05:50.56,0:05:54.33,Default,,0,0,0,,Shimada nasıl bir açıklık yakaladı?!\Nİnanamıyorum!
Dialogue: 0,0:05:54.33,0:05:56.33,Default,,0,0,0,,Başardım! Şaka gibi!
Dialogue: 0,0:05:56.33,0:05:59.08,Default,,0,0,0,,Nankatsu'ya karşı gol atabildik.
Dialogue: 0,0:05:59.08,0:06:01.78,Default,,0,0,0,,Lan! Ne yapıyorsun kaleci?!
Dialogue: 0,0:06:01.78,0:06:04.56,Default,,0,0,0,,O zayıf şutu durdurman gerekiyordu!
Dialogue: 0,0:06:04.56,0:06:05.71,Default,,0,0,0,,Anego!
Dialogue: 0,0:06:05.71,0:06:08.28,Default,,0,0,0,,Uzun bir pas sonrası gelen\Nhızlı bir karşı atak sonrası...
Dialogue: 0,0:06:08.28,0:06:11.13,Default,,0,0,0,,...ceza sahası dışından gelen\Nuzun bir şut ağları buluyor.
Dialogue: 0,0:06:11.13,0:06:16.87,Default,,0,0,0,,6 maçlık Nankatsu'nun gol yememe\Nserisi sona erdi!
Dialogue: 0,0:06:16.87,0:06:18.93,Default,,0,0,0,,Nankatsu çok da iyi değilmiş.
Dialogue: 0,0:06:21.35,0:06:22.73,Default,,0,0,0,,Özür dilerim.
Dialogue: 0,0:06:22.73,0:06:25.13,Default,,0,0,0,,Gözün yılmasın Morisaki.{god, why does this line feel like relationship advice?}
Dialogue: 0,0:06:25.13,0:06:28.31,Default,,0,0,0,,Her maç ortalama 9 gol attık biz.
Dialogue: 0,0:06:28.31,0:06:30.78,Default,,0,0,0,,Sen daha farkına bile\Nvaramadan toparlarız.
Dialogue: 0,0:06:30.78,0:06:31.86,Default,,0,0,0,,Millet...
Dialogue: 0,0:06:31.86,0:06:35.05,Default,,0,0,0,,Nankatsu böyle bir yerde\Nkaybeder mi sandın?
Dialogue: 0,0:06:35.05,0:06:36.99,Default,,0,0,0,,Kendimizi toparlayıp bastıralım!
Dialogue: 0,0:06:37.70,0:06:40.21,Default,,0,0,0,,Shizuoka bölgesi yarı finalleri.
Dialogue: 0,0:06:40.21,0:06:43.25,Default,,0,0,0,,Nankatsu FC ile Shimada İlkokulu karşı karşıya.
Dialogue: 0,0:06:43.25,0:06:50.05,Default,,0,0,0,,Kimse bu maçın bu duruma\Ngeleceğini tahmin edemezdi.
Dialogue: 0,0:06:50.64,0:06:52.55,Default,,0,0,0,,Yağmur yağacak gibi.
Dialogue: 0,0:06:52.47,0:06:56.22,Default,,0,0,0,,# Saitama Bölgesi Yarı Finalleri #
Dialogue: 0,0:06:54.36,0:06:56.30,Default,,0,0,0,,{\an8}İlk yarı bitiyor.
Dialogue: 0,0:06:56.30,0:07:00.31,Default,,0,0,0,,Nanbu FC üç golle lider durumda.
Dialogue: 0,0:07:00.31,0:07:02.39,Default,,0,0,0,,İşte bu, harika gidiyoruz.
Dialogue: 0,0:07:02.39,0:07:03.46,Default,,0,0,0,,Bizde bu maç.{ok but what is the rambling exactly real ambiguous, but}
Dialogue: 0,0:07:03.46,0:07:04.70,Default,,0,0,0,,İmkansız.
Dialogue: 0,0:07:04.70,0:07:08.29,Default,,0,0,0,,Hyuga-san yokken ulusallara gitmek...
Dialogue: 0,0:07:09.22,0:07:10.78,Default,,0,0,0,,Bu kadar mı çapınız?
Dialogue: 0,0:07:11.40,0:07:12.71,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:07:12.71,0:07:13.91,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:07:13.91,0:07:17.16,Default,,0,0,0,,Kendi futbol tarzınızla kazanmayacak mıydınız?
Dialogue: 0,0:07:17.16,0:07:18.38,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:07:18.38,0:07:22.01,Default,,0,0,0,,Lütfen öyle şeyler deme ve maçta oyna.
Dialogue: 0,0:07:22.01,0:07:23.12,Default,,0,0,0,,Lütfen!
Dialogue: 0,0:07:23.12,0:07:24.83,Default,,0,0,0,,Lütfen!
Dialogue: 0,0:07:24.83,0:07:26.21,Default,,0,0,0,,Pekala.
Dialogue: 0,0:07:26.21,0:07:29.80,Default,,0,0,0,,Ama sadece benim futbol\Ntarzımla oynarsanız öyle.
Dialogue: 0,0:07:30.48,0:07:33.30,Default,,0,0,0,,Ne? Hyuga-san'ın futbolu mu?
Dialogue: 0,0:07:33.30,0:07:34.68,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:07:34.68,0:07:36.97,Default,,0,0,0,,Benim futbolum yenilgiyi\Nkabul etmeyen futboldur!
Dialogue: 0,0:07:37.54,0:07:39.97,Default,,0,0,0,,Kazanmak için her şeyi yapmaya\Nhazır olan futbol!
Dialogue: 0,0:07:39.97,0:07:43.20,Default,,0,0,0,,İkinci yarının başlama vakti geldi.
Dialogue: 0,0:07:43.20,0:07:45.98,Default,,0,0,0,,Meiwa FC oyuncu değişikliği yapıyor.
Dialogue: 0,0:07:46.74,0:07:51.32,Default,,0,0,0,,13 Nakamoto-kun yerine\N10 numara Hyuga-kun giriyor.
Dialogue: 0,0:07:51.32,0:07:53.61,Default,,0,0,0,,Ne? Hyuga mı giriyor?
Dialogue: 0,0:07:53.61,0:07:56.36,Default,,0,0,0,,Şimdiye kadar hiçbir maçta\Noynamamışken neden şimdi?{because they're losing, you dumbass}
Dialogue: 0,0:07:56.85,0:08:01.87,Default,,0,0,0,,14 numara Koyama-kun yerine\N15 numara Sawada-kun giriyor.{same team is implied and i wanna save time}
Dialogue: 0,0:08:01.87,0:08:04.71,Default,,0,0,0,,Sonunda Hyuga-san ile birlikte oynayabileceğim.
Dialogue: 0,0:08:04.71,0:08:07.91,Default,,0,0,0,,Kaptan! Takeshi hala 4. sınıf.
Dialogue: 0,0:08:07.91,0:08:10.02,Default,,0,0,0,,Neden bu maçta?
Dialogue: 0,0:08:10.02,0:08:12.25,Default,,0,0,0,,İkinciyi yarıyı izleyip kendiniz bulun.{i needed to give Kojiro a little bit of a badass boost here}
Dialogue: 0,0:08:12.25,0:08:14.72,Default,,0,0,0,,Takeshi benim değerli partnerim.{he definitely bullies him.}
Dialogue: 0,0:08:15.70,0:08:17.04,Default,,0,0,0,,Gidelim Takeshi!
Dialogue: 0,0:08:17.04,0:08:18.08,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:18.08,0:08:22.88,Default,,0,0,0,,Saitama bölgesi temsilcilerini belirleyecek yarı\Nfinalde Meiwa FC ile Nanbu FC arasındaki maçın...
Dialogue: 0,0:08:22.88,0:08:26.14,Default,,0,0,0,,...ikinci yarısının top vuruşu yapılmak üzere!{this is a mere matter of me fitting more meaning where there is more time to fit it}
Dialogue: 0,0:08:29.00,0:08:30.36,Default,,0,0,0,,Kisugi-kun şut çekiyor!
Dialogue: 0,0:08:31.27,0:08:33.70,Default,,0,0,0,,Ama top direkten sekiyor.
Dialogue: 0,0:08:33.70,0:08:36.61,Default,,0,0,0,,Nankatsu'nun ilk yarıdaki 10. şutu bu.
Dialogue: 0,0:08:36.61,0:08:37.90,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:08:37.90,0:08:41.55,Default,,0,0,0,,Kisugi, neden kale önünde duran\NTsubasa'ya pas vermedin?!
Dialogue: 0,0:08:41.55,0:08:44.00,Default,,0,0,0,,Ne olacak ki?! Şut çekme şansım vardı!
Dialogue: 0,0:08:44.00,0:08:46.16,Default,,0,0,0,,Skora bakıp söylesene bir daha!
Dialogue: 0,0:08:46.16,0:08:49.45,Default,,0,0,0,,Bir golle kaybediyoruz!
Dialogue: 0,0:08:50.91,0:08:55.74,Default,,0,0,0,,Top hakimiyetine ve şut\Nsayısına bakılırsa üstün taraf biziz ama...
Dialogue: 0,0:08:55.74,0:08:58.05,Default,,0,0,0,,...nedense hala bir gol bile atamadık.
Dialogue: 0,0:08:58.05,0:09:01.72,Default,,0,0,0,,Ne yapıyor bunlar böyle?!{listen, you gave this line exactly half a second to display, so use something shorter lol}
Dialogue: 0,0:09:03.76,0:09:07.48,Default,,0,0,0,,Shimada İlkokulu yine uzun bir pasla\Nkarşı atağa çıkıyor!
Dialogue: 0,0:09:07.48,0:09:09.81,Default,,0,0,0,,Ama Kishida-kun topu kesiyor!
Dialogue: 0,0:09:12.83,0:09:13.65,Default,,0,0,0,,Tutun şunu!
Dialogue: 0,0:09:13.65,0:09:15.78,Default,,0,0,0,,Tamamdır, bu sefer golü atacağız!
Dialogue: 0,0:09:15.78,0:09:17.24,Default,,0,0,0,,Herkes tutsun şunu!
Dialogue: 0,0:09:17.24,0:09:19.03,Default,,0,0,0,,Tamam!
Dialogue: 0,0:09:19.03,0:09:23.12,Default,,0,0,0,,Nankatsu'nun korkunç ataklarına karşı\NShimada İlkokulu defansta!
Dialogue: 0,0:09:23.12,0:09:25.79,Default,,0,0,0,,Defans tüm gücüyle geri püskürtüyor!
Dialogue: 0,0:09:25.79,0:09:27.83,Default,,0,0,0,,Kisugi-kun'a pas atıyor.
Dialogue: 0,0:09:27.83,0:09:29.89,Default,,0,0,0,,Başka bir uzaktan şut!
Dialogue: 0,0:09:29.89,0:09:32.84,Default,,0,0,0,,Ama top kaleci tarafından yakalandı.
Dialogue: 0,0:09:32.84,0:09:35.20,Default,,0,0,0,,Nankatsu için yolun sonu mu bu?
Dialogue: 0,0:09:35.20,0:09:38.78,Default,,0,0,0,,Shimada İlkokulu'nun defansını aşamıyorlar\Nve bir gol bile atamadılar!
Dialogue: 0,0:09:38.78,0:09:41.01,Default,,0,0,0,,Neden Tsubasa'ya pas vermiyorlar?!
Dialogue: 0,0:09:42.34,0:09:44.76,Default,,0,0,0,,İlk yarı sona eriyor!
Dialogue: 0,0:09:45.42,0:09:47.53,Default,,0,0,0,,Shizuoka bölgesi yarı finallerinin\N2. maçında...
Dialogue: 0,0:09:47.53,0:09:51.65,Default,,0,0,0,,...Shimada İlkokulu'nun 1-0\Nüstünlüğüyle ilk yarı bitiyor.
Dialogue: 0,0:09:51.65,0:09:56.40,Default,,0,0,0,,Turnuvanın favorisi Nankatsu FC\Nilk yarıyı golsüz bitirdi!
Dialogue: 0,0:09:58.13,0:10:00.36,Default,,0,0,0,,Ne yapıyorsunuz böyle?
Dialogue: 0,0:10:00.36,0:10:03.42,Default,,0,0,0,,Atak temponuz hiç yok.
Dialogue: 0,0:10:03.42,0:10:05.62,Default,,0,0,0,,Neden Tsubasa'ya ayak uydurmuyorsunuz?
Dialogue: 0,0:10:05.62,0:10:09.28,Default,,0,0,0,,Paslaşarak onları kolayca\Ngeçebildiğimiz için...
Dialogue: 0,0:10:09.28,0:10:12.37,Default,,0,0,0,,Defansı geçince şutumuzu çekiyoruz.
Dialogue: 0,0:10:13.70,0:10:18.88,Default,,0,0,0,,Nasıl hissettiğinizi anlıyorum ama\Nbu takımdaki en güçlü kişi Tsubasa.
Dialogue: 0,0:10:19.41,0:10:22.12,Default,,0,0,0,,Daha etkili paslaşın ve\NTsubasa'ya ayak uydurun.
Dialogue: 0,0:10:22.12,0:10:22.83,Default,,0,0,0,,Anladınız mı?
Dialogue: 0,0:10:22.83,0:10:23.68,Default,,0,0,0,,Evet!
Dialogue: 0,0:10:23.68,0:10:26.47,Default,,0,0,0,,Koç, ikinci yarıda girmeli miyim?
Dialogue: 0,0:10:26.47,0:10:27.36,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:27.36,0:10:29.58,Default,,0,0,0,,Hayır, böyle devam edeceğiz.
Dialogue: 0,0:10:29.58,0:10:31.24,Default,,0,0,0,,Sana güveniyoruz Tsubasa.
Dialogue: 0,0:10:31.24,0:10:32.04,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:36.52,0:10:38.44,Default,,0,0,0,,Yağmur yağıyor.
Dialogue: 0,0:10:39.64,0:10:42.20,Default,,0,0,0,,Kaç kez böyle bir sahneye\Ntanık olduk?
Dialogue: 0,0:10:42.20,0:10:46.86,Default,,0,0,0,,Yine rakipleri birbiri ardına geçiyor\Nve topu çizgiye kadar getiriyor.
Dialogue: 0,0:10:46.86,0:10:51.71,Default,,0,0,0,,15 numara Sawada Takeshi-kun\Nbu turnuvada oynayan en genç oyuncu!
Dialogue: 0,0:10:51.71,0:10:54.21,Default,,0,0,0,,Takeshi bu kadar iyi miydi?
Dialogue: 0,0:10:57.80,0:10:59.04,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:10:59.04,0:11:01.80,Default,,0,0,0,,Sawada-kun kale çizgisinin önündeki\NHyuga-kun'a orta açıyor!
Dialogue: 0,0:11:02.41,0:11:03.13,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:11:03.13,0:11:05.64,Default,,0,0,0,,İkinci yarıda giren bu ikili sayesinde...
Dialogue: 0,0:11:05.64,0:11:08.97,Default,,0,0,0,,...Meiwa FC 3 gol atıp rakibe yetişti.
Dialogue: 0,0:11:08.97,0:11:10.97,Default,,0,0,0,,Hyuga! Hyuga'yı tutun!
Dialogue: 0,0:11:10.97,0:11:13.39,Default,,0,0,0,,Daha fazla gol atmanıza izin veremeyiz!
Dialogue: 0,0:11:15.60,0:11:16.90,Default,,0,0,0,,Buraya kadar!{blocks hyuga's path. So maybe "we got you"?}
Dialogue: 0,0:11:18.87,0:11:20.28,Default,,0,0,0,,Hyuga-kun şut çekiyor!
Dialogue: 0,0:11:24.09,0:11:26.14,Default,,0,0,0,,Maç bitiyor.
Dialogue: 0,0:11:26.14,0:11:27.71,Default,,0,0,0,,4-3!{screen says otherwise}
Dialogue: 0,0:11:27.71,0:11:32.29,Default,,0,0,0,,Büyük bir geri dönüş ile Saitama bölgesinin\Nfinaline katılacak takım Meiwa FC oluyor!
Dialogue: 0,0:11:32.77,0:11:35.64,Default,,0,0,0,,Ne korkunç bir forvet böyle!
Dialogue: 0,0:11:35.64,0:11:40.91,Default,,0,0,0,,İkinci yarıda gelip 4 gol atarak\Ntakımını liderliğe taşıdı bu oğlan.
Dialogue: 0,0:11:40.91,0:11:43.05,Default,,0,0,0,,Onun adı Hyuga Kojiro-kun!
Dialogue: 0,0:11:46.88,0:11:48.93,Default,,0,0,0,,Misaki-kun topu çalıyor!{and your hearts}
Dialogue: 0,0:11:48.93,0:11:53.23,Default,,0,0,0,,Nankatsu FC'nin atakları 2. yarıda yavaşladı!
Dialogue: 0,0:11:53.23,0:11:54.69,Default,,0,0,0,,Hey, Misaki!
Dialogue: 0,0:11:57.61,0:12:02.36,Default,,0,0,0,,Yağmur yüzünden mi bilmem ama\Noyuncular daha kötü oynuyor gibi görünüyor.
Dialogue: 0,0:12:03.00,0:12:06.61,Default,,0,0,0,,Şans yüzümüze gülüyor gibi.
Dialogue: 0,0:12:09.49,0:12:11.41,Default,,0,0,0,,Neyiniz var millet?
Dialogue: 0,0:12:11.41,0:12:14.19,Default,,0,0,0,,Shimada İlkokulu'nun maçları hep\Nberaberliğe yakın bitmiş.
Dialogue: 0,0:12:14.19,0:12:18.33,Default,,0,0,0,,Bizi durdurabilecek kadar\Ngüçlüler mi gerçekten?
Dialogue: 0,0:12:18.33,0:12:22.17,Default,,0,0,0,,Koç, bir kez daha Shimada İlkokulu'nun\Nverilerine bakabilir miyim lütfen?{wakabayashi says pretty pls}
Dialogue: 0,0:12:22.17,0:12:23.12,Default,,0,0,0,,Elbette.
Dialogue: 0,0:12:25.29,0:12:26.93,Default,,0,0,0,,B-Bu...
Dialogue: 0,0:12:26.93,0:12:28.67,Default,,0,0,0,,Nankatsu'dan da bu beklenirdi!
Dialogue: 0,0:12:28.67,0:12:32.01,Default,,0,0,0,,Islak zeminde bile pasları\Nhedefini buluyor.
Dialogue: 0,0:12:32.01,0:12:33.06,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:12:34.06,0:12:37.56,Default,,0,0,0,,Ne?! Top su birikintisine denk geldi!
Dialogue: 0,0:12:39.59,0:12:41.50,Default,,0,0,0,,Tüm maçlarının yakın skorla\Nbittiği doğru ama...
Dialogue: 0,0:12:41.50,0:12:45.36,Default,,0,0,0,,...Shimada İlkokulu da bizim gibi\Nşimdiye kadar hiç gol yememiş.
Dialogue: 0,0:12:45.36,0:12:47.07,Default,,0,0,0,,Ne dedin?
Dialogue: 0,0:12:47.07,0:12:50.78,Default,,0,0,0,,Her maçta rakiplerinin birkaç\Nşut çekmesine izin vermişler.
Dialogue: 0,0:12:50.78,0:12:53.65,Default,,0,0,0,,O zaman bile tüm takım\Nkaleyi korumuş.
Dialogue: 0,0:12:53.65,0:12:58.04,Default,,0,0,0,,Topu alınca kumar oynayarak\Nkarşı atak için uzun pas atmışlar.
Dialogue: 0,0:12:58.63,0:13:01.71,Default,,0,0,0,,Şimdiye kadar böyle kazanarak gelmişler.
Dialogue: 0,0:13:01.71,0:13:03.75,Default,,0,0,0,,Yani Shimada İlkokulu...
Dialogue: 0,0:13:03.75,0:13:07.26,Default,,0,0,0,,Evet. Tamamen defansa dayalı bir takım.
Dialogue: 0,0:13:07.80,0:13:09.80,Default,,0,0,0,,Shimada İlkokulu uzun bir pasla\Nkarşı atağa çıkıyor!
Dialogue: 0,0:13:09.80,0:13:11.80,Default,,0,0,0,,Millet hemen geri dönün!{surprise butt...}
Dialogue: 0,0:13:13.90,0:13:15.35,Default,,0,0,0,,Boşta ve vuruyor!{got rekt That's what she saidlol, was unexpected}
Dialogue: 0,0:13:18.07,0:13:21.36,Default,,0,0,0,,Gol! Shimada İlkokulu 2. golünü atıyor!{we call such keepers as "buckets", no? Mhin senpai}
Dialogue: 0,0:13:23.09,0:13:24.61,Default,,0,0,0,,İkinci golümüzü attık.
Dialogue: 0,0:13:24.61,0:13:26.28,Default,,0,0,0,,Rüya değil bu, değil mi?{you wish, young padawans}
Dialogue: 0,0:13:26.28,0:13:29.78,Default,,0,0,0,,İşte böyle. Bizim futbol tarzımız bu işte.
Dialogue: 0,0:13:30.47,0:13:33.84,Default,,0,0,0,,Baştan beri hiç güzel forvetimiz yoktu.
Dialogue: 0,0:13:33.84,0:13:36.04,Default,,0,0,0,,Gol atamayan bir takımdık.
Dialogue: 0,0:13:36.42,0:13:39.04,Default,,0,0,0,,İşte bu noktada kafa yormaya başladılar.
Dialogue: 0,0:13:39.04,0:13:43.54,Default,,0,0,0,,"Gol atamıyorsak onların da\Ngol atmasını engellemeliyiz."
Dialogue: 0,0:13:43.54,0:13:46.67,Default,,0,0,0,,Pasif ya da isteksiz bir oyun\Ntarzı olarak bilinebilir ama...
Dialogue: 0,0:13:46.67,0:13:49.74,Default,,0,0,0,,...çabaları ve iyi takım çalışmaları ile...
Dialogue: 0,0:13:49.74,0:13:53.98,Default,,0,0,0,,...bu çocuklar yavaş yavaş\Nyeteneklerini geliştirdi.
Dialogue: 0,0:13:53.98,0:13:59.58,Default,,0,0,0,,Şimdi de Shimada İlkokulu'nun\Nfutbolu parlamak üzere.
Dialogue: 0,0:13:59.58,0:14:01.81,Default,,0,0,0,,Harika, bu maçı kazanabiliriz.{not}
Dialogue: 0,0:14:02.41,0:14:04.32,Default,,0,0,0,,Ne beklenmedik olaylar!
Dialogue: 0,0:14:04.80,0:14:10.36,Default,,0,0,0,,İkinci yarının 10. dakikasındayız ve\Nfavori olan Nankatsu 2 gol geride!
Dialogue: 0,0:14:13.49,0:14:15.89,Default,,0,0,0,,Hayatta kaybetmem!
Dialogue: 0,0:14:19.21,0:14:24.17,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:14:25.01,0:14:28.67,Default,,0,0,0,,Yarı finallerin ikinci maçında\N15 dakikadan az bir süre kaldı.
Dialogue: 0,0:14:29.30,0:14:35.60,Default,,0,0,0,,Turnuva favorisi Nankatsu FC, Shimada İlkokulu'nun\Ngüçlü defansı karşısında zorluk yaşıyor.
Dialogue: 0,0:14:35.60,0:14:36.78,Default,,0,0,0,,Koç!
Dialogue: 0,0:14:36.78,0:14:37.72,Default,,0,0,0,,Beni sok!
Dialogue: 0,0:14:37.72,0:14:43.10,Default,,0,0,0,,Shimada İlkokulu'nun karşı saldırılarını\Ndurdururum ve atağa odaklanabiliriz. Ben...
Dialogue: 0,0:14:43.10,0:14:45.19,Default,,0,0,0,,Hayır, seni sokamam.
Dialogue: 0,0:14:45.19,0:14:49.88,Default,,0,0,0,,Wakabayashi, amacımız ulusallara\Nkatılmak değil.
Dialogue: 0,0:14:49.88,0:14:51.95,Default,,0,0,0,,Ulusalları kazanmak.
Dialogue: 0,0:14:51.95,0:14:54.49,Default,,0,0,0,,Böyle bir zorluğun üstesinden gelemezsek...
Dialogue: 0,0:14:54.49,0:14:59.12,Default,,0,0,0,,...zorluğun zirve yapacağı\Nulusallarda hiç tutunamayız.
Dialogue: 0,0:14:59.12,0:15:02.25,Default,,0,0,0,,Bu yüzden şimdi burada\Nkaybetmek en iyisi olur!
Dialogue: 0,0:15:02.25,0:15:03.75,Default,,0,0,0,,Koç...
Dialogue: 0,0:15:03.75,0:15:06.62,Default,,0,0,0,,Shimada İlkokulu'ndan herkes\Nkalenin önünde toplandı...
Dialogue: 0,0:15:06.62,0:15:08.92,Default,,0,0,0,,...ve defansı sağlamlaştırdı.
Dialogue: 0,0:15:08.92,0:15:12.12,Default,,0,0,0,,Roberto, Tsubasa kaybetmeyecek değil mi?
Dialogue: 0,0:15:12.12,0:15:16.71,Default,,0,0,0,,Hayır, Tsubasa'nın tek başına\Ngücünün yeteceği bir şey mi bu bilmiyorum.
Dialogue: 0,0:15:16.71,0:15:17.43,Default,,0,0,0,,Ne?
Dialogue: 0,0:15:17.43,0:15:21.03,Default,,0,0,0,,Paslaşarak Shimada İlkokulu'nun\Ndefansını aşmaya çalışmak...
Dialogue: 0,0:15:21.03,0:15:23.72,Default,,0,0,0,,Nankatsu'nun taktiğinde hata yok.
Dialogue: 0,0:15:23.72,0:15:26.52,Default,,0,0,0,,Ne var ki asıl sorun bu yağmur.
Dialogue: 0,0:15:27.48,0:15:31.39,Default,,0,0,0,,Normalde topu kontrol etmekte\Ndaha iyi olan Nankatsu...{eh, not sure about this one}
Dialogue: 0,0:15:31.39,0:15:34.53,Default,,0,0,0,,...bu yağmur yüzünden paslaşma\Nhızını kaybediyor ve top alamıyor.
Dialogue: 0,0:15:34.98,0:15:38.36,Default,,0,0,0,,Elbette yeteneklerinde pek bir fark yok ama.
Dialogue: 0,0:15:38.36,0:15:41.08,Default,,0,0,0,,Bu gidişle ilk golü atan Shimada İlkokulu...
Dialogue: 0,0:15:41.08,0:15:42.63,Default,,0,0,0,,...elinde büyük bir avantaj bulunduracak.
Dialogue: 0,0:15:43.58,0:15:46.67,Default,,0,0,0,,Ayrıca Tsubasa'yı tutan\Nbirisi var sürekli.
Dialogue: 0,0:15:47.20,0:15:47.79,Default,,0,0,0,,Bu yüzden...
Dialogue: 0,0:15:50.95,0:15:53.06,Default,,0,0,0,,Tsubasa-kun pas almasıyla bir açık yaratıp...
Dialogue: 0,0:15:53.06,0:15:55.47,Default,,0,0,0,,...zor bir pozisyondan şut çekiyor!
Dialogue: 0,0:15:55.99,0:15:58.36,Default,,0,0,0,,Ama direkt kalecinin üstüne gidiyor!
Dialogue: 0,0:15:58.36,0:16:00.22,Default,,0,0,0,,Ne?! Kaleciden sekti!
Dialogue: 0,0:16:00.22,0:16:02.98,Default,,0,0,0,,Top yağmur yüzünden kayıyor!
Dialogue: 0,0:16:03.60,0:16:05.31,Default,,0,0,0,,Shimada İlkokulu kurtarıyor!
Dialogue: 0,0:16:05.31,0:16:07.56,Default,,0,0,0,,Bu tehlikeli topu dışarı çıkarıyorlar!
Dialogue: 0,0:16:07.56,0:16:09.29,Default,,0,0,0,,Nankatsu gol atamıyor!
Dialogue: 0,0:16:09.29,0:16:10.54,Default,,0,0,0,,Aferin Uesugi!
Dialogue: 0,0:16:10.54,0:16:11.44,Default,,0,0,0,,Güzel kurtardın.
Dialogue: 0,0:16:11.44,0:16:13.94,Default,,0,0,0,,Tsubasa'ya topu atsak bile gol atamıyoruz.{context here; who is talking}{shuutetsu kids, in despair quartet weaklings}{quartet is tsubasa fanboys now, kyaa- tsubasa-sama}
Dialogue: 0,0:16:13.94,0:16:16.70,Default,,0,0,0,,Nankatsu bu maçı kaybedecek.{so who is talking here, cheeky opponent kid, in the stands watching the match}{smug shimizu kid, he doesn't know what will happen to him in the final}
Dialogue: 0,0:16:18.12,0:16:20.33,Default,,0,0,0,,Top Nankatsu tarafında.
Dialogue: 0,0:16:20.33,0:16:23.70,Default,,0,0,0,,Nankatsu topu almaya çalışsa bile\Nyağmur yüzünden hareketleri yavaşladı.
Dialogue: 0,0:16:23.70,0:16:26.20,Default,,0,0,0,,8 dakikadan az bir süre kaldı.
Dialogue: 0,0:16:26.20,0:16:27.12,Default,,0,0,0,,Kaybedecekler mi?
Dialogue: 0,0:16:27.12,0:16:28.92,Default,,0,0,0,,Nankatsu kayıp mı edecek?
Dialogue: 0,0:16:30.36,0:16:31.38,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:16:31.94,0:16:34.30,Default,,0,0,0,,Hayatta kaybetmem!{nerd rage intensifies}
Dialogue: 0,0:16:37.09,0:16:39.12,Default,,0,0,0,,Tsubasa-kun'un mücadeleci ruhu uyanıyor!
Dialogue: 0,0:16:39.12,0:16:41.32,Default,,0,0,0,,Topu alıp koşmaya başladı!
Dialogue: 0,0:16:41.32,0:16:42.57,Default,,0,0,0,,Durdurun şunu!
Dialogue: 0,0:16:42.57,0:16:43.97,Default,,0,0,0,,Onu durdurmamız gerek.
Dialogue: 0,0:16:45.73,0:16:48.31,Default,,0,0,0,,Tamamdır millet.\NTop bendeyken ilerleyin.
Dialogue: 0,0:16:51.32,0:16:52.61,Default,,0,0,0,,Tamam, buraya!
Dialogue: 0,0:16:52.61,0:16:53.61,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:16:53.61,0:16:54.57,Default,,0,0,0,,Al!
Dialogue: 0,0:16:55.16,0:16:56.07,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:56.07,0:16:58.03,Default,,0,0,0,,Tamamdır, biz de devam edelim.
Dialogue: 0,0:16:58.03,0:16:58.70,Default,,0,0,0,,Evet!
Dialogue: 0,0:16:58.70,0:17:03.11,Default,,0,0,0,,Nankatsu, havadan paslaşıp ıslak\Ntopraktan sakınarak topu taşıyor.
Dialogue: 0,0:17:03.11,0:17:04.70,Default,,0,0,0,,Ne harika bir takım oyunu!
Dialogue: 0,0:17:04.70,0:17:07.33,Default,,0,0,0,,İşte bu! İşte bizim Tsubasa!
Dialogue: 0,0:17:07.86,0:17:10.84,Default,,0,0,0,,Senin rolün sadece şut çekip\Ngol atmak değil.
Dialogue: 0,0:17:10.84,0:17:14.34,Default,,0,0,0,,Oyun kurup oyunu yönlendirebilirsin de!
Dialogue: 0,0:17:14.34,0:17:19.09,Default,,0,0,0,,Wakabayashi yokken senden başka\Nkimse bu oyunu yönetemez!
Dialogue: 0,0:17:19.09,0:17:23.10,Default,,0,0,0,,Tsubasa-kun'un liderliğinde Shimada'nın\Nkalesinde bir açıklık oluşuyor!
Dialogue: 0,0:17:23.60,0:17:24.72,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:17:29.56,0:17:32.37,Default,,0,0,0,,Tsubasa-kun sağ ayağıyla topu alıyor...
Dialogue: 0,0:17:32.37,0:17:34.94,Default,,0,0,0,,...ve bedeniyle dönerek şut çekiyor!
Dialogue: 0,0:17:35.70,0:17:36.84,Default,,0,0,0,,Gol!
Dialogue: 0,0:17:36.84,0:17:41.01,Default,,0,0,0,,Tsubasa-kun, Misaki-kun'un harika ortasını\Nharika bir voleyle gole çeviriyor!
Dialogue: 0,0:17:41.01,0:17:42.95,Default,,0,0,0,,Nankatsu ilk golünü attı!
Dialogue: 0,0:17:42.95,0:17:44.76,Default,,0,0,0,,Harikaydın Tsubasa-kun!
Dialogue: 0,0:17:44.76,0:17:45.68,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:17:45.68,0:17:47.54,Default,,0,0,0,,Başardın. Bir gol daha kaldı.
Dialogue: 0,0:17:47.54,0:17:48.03,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:48.03,0:17:51.67,Default,,0,0,0,,Shimada İlkokulu'nun 6. maçlık\Ngol yememe serisi sona eriyor.
Dialogue: 0,0:17:51.67,0:17:53.46,Default,,0,0,0,,Millet, sorun yok, sorun yok.
Dialogue: 0,0:17:53.46,0:17:56.12,Default,,0,0,0,,Nankatsu beraberlik golünü\Nbulabilecek mi acaba?
Dialogue: 0,0:17:56.12,0:17:58.47,Default,,0,0,0,,Yoksa Shimada İlkokulu\Nönde olmayı sürdürecek mi?
Dialogue: 0,0:17:58.47,0:18:00.97,Default,,0,0,0,,Sadece 5 dakika kaldı.
Dialogue: 0,0:18:00.97,0:18:02.72,Default,,0,0,0,,Al Tsubasa!
Dialogue: 0,0:18:03.88,0:18:05.77,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:18:07.10,0:18:08.48,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:18:08.48,0:18:11.23,Default,,0,0,0,,Misaki-kun kale önüne uzun bir pas yolluyor.
Dialogue: 0,0:18:11.23,0:18:12.70,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:18:12.70,0:18:14.23,Default,,0,0,0,,Yağmurlu havada bir hava topu mücadelesi!
Dialogue: 0,0:18:14.23,0:18:16.53,Default,,0,0,0,,Nankatsu'dan Izawa-kun topu alıyor!
Dialogue: 0,0:18:16.53,0:18:18.53,Default,,0,0,0,,Orada topa koşan Tsubasa-kun var!
Dialogue: 0,0:18:18.53,0:18:20.11,Default,,0,0,0,,Zıplayarak kafa vuruşu!
Dialogue: 0,0:18:21.01,0:18:22.00,Default,,0,0,0,,Gol!
Dialogue: 0,0:18:22.00,0:18:27.04,Default,,0,0,0,,Nankatsu, beraberliği sağlayacak golü\Nsadece 2 dakika kalmışken yakalıyor!
Dialogue: 0,0:18:27.04,0:18:28.79,Default,,0,0,0,,Başardın Tsubasa-kun!
Dialogue: 0,0:18:32.76,0:18:35.07,Default,,0,0,0,,Nankatsu gerçekten çok güçlü.
Dialogue: 0,0:18:35.07,0:18:36.00,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:36.00,0:18:39.09,Default,,0,0,0,,Demek gerçek güçleri bu.
Dialogue: 0,0:18:39.09,0:18:40.40,Default,,0,0,0,,Ne yapacağız millet?
Dialogue: 0,0:18:40.40,0:18:42.66,Default,,0,0,0,,Defans yapmaya devam mı etmeliyiz?
Dialogue: 0,0:18:42.66,0:18:44.89,Default,,0,0,0,,Başka seçeneğimiz var mı ki?
Dialogue: 0,0:18:44.89,0:18:48.94,Default,,0,0,0,,Ama Nankatsu'nun güçlü ataklarını\Nböyle durdurabilir miyiz ki?
Dialogue: 0,0:18:48.94,0:18:52.14,Default,,0,0,0,,Maç berabere bitse bile uzatmalar var.
Dialogue: 0,0:18:53.86,0:18:56.11,Default,,0,0,0,,Çocuklar, atak yapmaya ne dersiniz?
Dialogue: 0,0:18:56.11,0:18:56.77,Default,,0,0,0,,Ne?
Dialogue: 0,0:18:56.77,0:19:00.04,Default,,0,0,0,,Bizim güçlü noktamız takım\Nçalışması yapmamız.
Dialogue: 0,0:19:00.04,0:19:01.72,Default,,0,0,0,,Bireysel olarak iyi olmasak da...
Dialogue: 0,0:19:01.72,0:19:04.03,Default,,0,0,0,,...hep birlikte hareket edince\Niyi sonuçlar almıyor muyuz?
Dialogue: 0,0:19:04.03,0:19:06.30,Default,,0,0,0,,Şimdi gücümüzü birleştirme...
Dialogue: 0,0:19:06.30,0:19:08.04,Default,,0,0,0,,...ve Nankatsu'ya gol atmayı\Nhedefleme vakti!
Dialogue: 0,0:19:08.04,0:19:11.83,Default,,0,0,0,,Şu ana kadar yaptığımız antrenmanlar\Nve de koçumuz için yapmalıyız bunu!{wow, such a nice kid}
Dialogue: 0,0:19:11.83,0:19:14.58,Default,,0,0,0,,Hep birlikte bir gol atacağız!
Dialogue: 0,0:19:14.58,0:19:15.97,Default,,0,0,0,,Evet!
Dialogue: 0,0:19:17.04,0:19:21.21,Default,,0,0,0,,Şimdiye kadar kararlı\Nbir şekilde savunma yapmış Shimada İlkokulu...
Dialogue: 0,0:19:21.21,0:19:23.38,Default,,0,0,0,,...Nankatsu'ya atak yapmaya başladı!
Dialogue: 0,0:19:23.78,0:19:24.80,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:24.80,0:19:28.06,Default,,0,0,0,,Bu sürpriz saldırı,\NNankatsu'yu hazırlıksız mı yakalayacak?{Has Nankatsu lost their composure against this surprise attack?}
Dialogue: 0,0:19:28.06,0:19:31.31,Default,,0,0,0,,Shimada harika bir şekilde\Npaslaşarak rakibiyle oynuyor!{what? hongou? probably honrou talked so much on the phone that I can't hear, lol they got "brazlian hobo'ed"}{oh, honrou alright}
Dialogue: 0,0:19:31.31,0:19:32.80,Default,,0,0,0,,Aptal mısınız?! Sakin olun!
Dialogue: 0,0:19:32.80,0:19:34.69,Default,,0,0,0,,Herkes bir kişiyi tutsun!
Dialogue: 0,0:19:34.69,0:19:35.59,Default,,0,0,0,,Seni!
Dialogue: 0,0:19:36.69,0:19:37.52,Default,,0,0,0,,Daha değil!
Dialogue: 0,0:19:37.52,0:19:40.40,Default,,0,0,0,,Ama top Shimada İlkokulu'nda kalıyor!
Dialogue: 0,0:19:40.40,0:19:43.15,Default,,0,0,0,,Shimada İlkokulu harika bir\Ntakım çalışması sergiliyor!
Dialogue: 0,0:19:43.15,0:19:45.66,Default,,0,0,0,,Nankatsu'nun toparlanmasına izin vermiyorlar.
Dialogue: 0,0:19:45.66,0:19:47.91,Default,,0,0,0,,Millet, her şeyimizle atak yapalım.
Dialogue: 0,0:19:47.91,0:19:49.41,Default,,0,0,0,,Evet!
Dialogue: 0,0:19:49.41,0:19:51.15,Default,,0,0,0,,Ne güzel bir takım.
Dialogue: 0,0:19:51.15,0:19:53.91,Default,,0,0,0,,Evet. Gönüllerince oynuyorlar.
Dialogue: 0,0:19:53.91,0:19:56.42,Default,,0,0,0,,Tamamdır! Ben de kaybetmeyeceğim!
Dialogue: 0,0:19:57.06,0:19:58.92,Default,,0,0,0,,Tsubasa-kun topu alıyor!
Dialogue: 0,0:19:59.38,0:20:01.51,Default,,0,0,0,,Ne var ki Shimada İlkokulu\Nhala peşini bırakmıyor topun.
Dialogue: 0,0:20:01.51,0:20:02.17,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:20:02.74,0:20:03.79,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:20:03.79,0:20:06.18,Default,,0,0,0,,O topu pür dikkat koruyun!
Dialogue: 0,0:20:06.69,0:20:09.72,Default,,0,0,0,,Oynadığınız futbol takım\Noyununa dayalı.
Dialogue: 0,0:20:09.72,0:20:13.73,Default,,0,0,0,,Birbirinizle yardımlaşıyorsunuz\Nve topu kaleye taşıyorsunuz.
Dialogue: 0,0:20:15.81,0:20:16.81,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:20:16.81,0:20:19.32,Default,,0,0,0,,Kale önüne bir orta geliyor!
Dialogue: 0,0:20:19.32,0:20:21.19,Default,,0,0,0,,Uesugi-kun boşta!
Dialogue: 0,0:20:25.20,0:20:28.57,Default,,0,0,0,,Kaleci Morisaki-kun kurtarıyor!
Dialogue: 0,0:20:29.48,0:20:30.91,Default,,0,0,0,,Harika bir kurtarış!
Dialogue: 0,0:20:31.49,0:20:32.50,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:20:33.03,0:20:35.00,Default,,0,0,0,,Kalemizi korudum Wakabayashi-san!
Dialogue: 0,0:20:35.00,0:20:37.84,Default,,0,0,0,,Morisaki-kun ileriye doğru topu atıyor!
Dialogue: 0,0:20:37.84,0:20:39.59,Default,,0,0,0,,Şimdi Nankatsu'nun karşı atak fırsatı.
Dialogue: 0,0:20:39.59,0:20:40.35,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:20:40.35,0:20:41.25,Default,,0,0,0,,Herkes geri dönsün!
Dialogue: 0,0:20:41.25,0:20:43.15,Default,,0,0,0,,Topu alan kişi Tsubasa-kun!
Dialogue: 0,0:20:43.15,0:20:43.71,Default,,0,0,0,,İşte bu.
Dialogue: 0,0:20:43.71,0:20:47.64,Default,,0,0,0,,Tsubasa-kun inanılmaz bir hızda topu\Nsürüyor. Shimada İlkokulu yetişemiyor!
Dialogue: 0,0:20:48.51,0:20:50.76,Default,,0,0,0,,Tsubasa-kun kaleci ile karşı karşıya!
Dialogue: 0,0:20:52.79,0:20:54.27,Default,,0,0,0,,Gol!
Dialogue: 0,0:20:58.30,0:21:00.57,Default,,0,0,0,,Maçı bitiren düdük çalıyor!
Dialogue: 0,0:21:02.55,0:21:04.69,Default,,0,0,0,,Nankatsu geriden gelip kazandı.
Dialogue: 0,0:21:04.69,0:21:08.20,Default,,0,0,0,,Shimada İlkokulu çok kararlıydı\Nama güçleri bitirmeye yetmedi.
Dialogue: 0,0:21:08.67,0:21:12.40,Default,,0,0,0,,Zor kazanılmış zafer sonrası\NNankatsu on biri sevinç çığlıkları atıyor!
Dialogue: 0,0:21:12.40,0:21:14.95,Default,,0,0,0,,Shizuoka Bölgesi Turnuva finallerine ilerliyorlar.
Dialogue: 0,0:21:15.57,0:21:18.80,Default,,0,0,0,,Ve bu son golle\NNankatsu'dan Ozora Tsubasa-kun...
Dialogue: 0,0:21:18.80,0:21:21.46,Default,,0,0,0,,...arka arkaya 6 kez hat trick\Nyapmış oldu!
Dialogue: 0,0:21:22.73,0:21:23.71,Default,,0,0,0,,İşte bu.
Dialogue: 0,0:21:31.86,0:21:34.72,Default,,0,0,0,,Elinize sağlık çocuklar.
Dialogue: 0,0:21:35.20,0:21:37.56,Default,,0,0,0,,Hadi gidip sıraya geçelim.
Dialogue: 0,0:21:37.56,0:21:41.46,Default,,0,0,0,,Nankatsu gibi bir rakibe karşı\Ntüm gücümüzü ortaya koyarak oynadık.
Dialogue: 0,0:21:41.46,0:21:43.93,Default,,0,0,0,,Başımızı dik tutabiliriz.
Dialogue: 0,0:21:43.93,0:21:44.73,Default,,0,0,0,,Evet.
Dialogue: 0,0:21:45.63,0:21:47.74,Default,,0,0,0,,Çok teşekkürler!
Dialogue: 0,0:21:49.61,0:21:51.23,Default,,0,0,0,,Finalde iyi şanslar.
Dialogue: 0,0:21:51.78,0:21:53.59,Default,,0,0,0,,Yine oynayalım.
Dialogue: 0,0:21:53.59,0:21:54.24,Default,,0,0,0,,Evet.
Dialogue: 0,0:21:54.24,0:21:57.90,Default,,0,0,0,,Bizim yerimize ulusallara gidin.
Dialogue: 0,0:21:57.90,0:21:59.37,Default,,0,0,0,,Elbette.
Dialogue: 0,0:22:00.15,0:22:04.00,Default,,0,0,0,,Shimada İlkokulu Futbol Kulübü,\Nharika bir takım oyununa sahip.
Dialogue: 0,0:22:04.00,0:22:08.84,Default,,0,0,0,,Nankatsu'da neyin eksik olduğunu\Nsonunda anlamış gibiyim.
Dialogue: 0,0:22:08.84,0:22:12.08,Default,,0,0,0,,Tsubasa-kun, sonunda finallere\Nçıkacağız şimdi.
Dialogue: 0,0:22:12.08,0:22:13.10,Default,,0,0,0,,Evet.
Dialogue: 0,0:22:13.43,0:22:16.60,Default,,0,0,0,,Tamamdır, hep birlikte kazanalım!
Dialogue: 0,0:22:16.60,0:22:18.78,Default,,0,0,0,,Evet!
Dialogue: 0,0:22:19.47,0:22:21.31,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
