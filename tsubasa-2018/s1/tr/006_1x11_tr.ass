Dialogue: 0,0:00:01.35,0:00:03.49,Default,,0,0,0,,Yeni bir rakip ortaya çıktı!
Dialogue: 0,0:00:03.49,0:00:05.60,Default,,0,0,0,,Adı Hyuga Kojiro.
Dialogue: 0,0:00:05.60,0:00:08.76,Default,,0,0,0,,Nankatsu FC'nin antrenmanında\Nbirden ortaya çıkıp...
Dialogue: 0,0:00:08.76,0:00:12.07,Default,,0,0,0,,...ne kadar güçlü olduğunu\NTsubasa'lara göstermişti.
Dialogue: 0,0:00:12.07,0:00:15.65,Default,,0,0,0,,Saitama temsilcisi Meiwa FC'de\Nyer almasına rağmen...
Dialogue: 0,0:00:15.65,0:00:18.76,Default,,0,0,0,,...sert oyun tarzı sebebiyle\Ntakım arkadaşlarıyla arası açılmıştı.
Dialogue: 0,0:00:18.76,0:00:21.58,Default,,0,0,0,,Sonuç olarak da elemeler sırasında\Ntakımını bir başına bırakmıştı.
Dialogue: 0,0:00:21.58,0:00:25.45,Default,,0,0,0,,Öte yandan Nankatsu, Wakabayashi'nin\Nbacağının incindiğini öğrenmişti.
Dialogue: 0,0:00:25.45,0:00:30.17,Default,,0,0,0,,Endişe ve gerginlikle birlikte\Nbölgesel elemelere başlamışlardı.
Dialogue: 0,0:00:30.71,0:00:33.88,Default,,0,0,0,,Tsubasa'nın çabaları sayesinde\Nharika bir zafer kazanmışlardı.
Dialogue: 0,0:00:33.88,0:00:39.50,Default,,0,0,0,,Nankatsu FC, bu zaferinin ardından\Nmaçları kolayca kazanmaya devam ediyordu.
Dialogue: 0,0:00:41.67,0:00:47.73,Default,,0,0,0,,Şimdi de Shizuoka Bölgesi Genç Futbol\NLigi için yarı final maçı zamanı.
Dialogue: 0,0:00:47.73,0:00:53.73,Default,,0,0,0,,İkinci yarı final, Nankatsu FC ile\NShimada FC arasındaki maç başlamak üzere.{please use Nankatsu FC ty}
Dialogue: 0,0:00:53.73,0:00:57.19,Default,,0,0,0,,Hora! Hora! Nankatsu!{style guide says single exclamation marks; the pauses call for exclamation marks and not commas; if you are using commas, please use lowercase afterwards as uppercase is for the beginning of sentences and names}
Dialogue: 0,0:00:57.19,0:01:00.36,Default,,0,0,0,,Bastır! Bastır! Shimada!
Dialogue: 0,0:01:00.36,0:01:03.37,Default,,0,0,0,,Ne? Wakabayashi maçta\Noynamayacak mı?!
Dialogue: 0,0:01:03.37,0:01:05.62,Default,,0,0,0,,Bu da ne demek Koç?!
Dialogue: 0,0:01:05.62,0:01:09.62,Default,,0,0,0,,Wakabayashi'nin bacağı hala\Niyileşmemiş gibi görünüyor.
Dialogue: 0,0:01:09.62,0:01:10.79,Default,,0,0,0,,Ne?!
Dialogue: 0,0:01:10.79,0:01:17.09,Default,,0,0,0,,Endişelenmeyin. Yarınki maça kadar bacağımın\Niyileştiğinden emin olmak istiyorum sadece.
Dialogue: 0,0:01:17.09,0:01:19.42,Default,,0,0,0,,Shimada İlkokulu'nun forveti yok.
Dialogue: 0,0:01:19.42,0:01:23.80,Default,,0,0,0,,Endişelenecek özel bir oyuncuları\Nolmadığı için Wakabayashi olmadan oynayabiliriz.{:p <3 with love From Touji with love *sings*}
Dialogue: 0,0:01:23.80,0:01:27.06,Default,,0,0,0,,Finalde işi bana bırakabilirsiniz ama...
Dialogue: 0,0:01:27.92,0:01:32.43,Default,,0,0,0,,...bugünlük Nankatsu kalesini\NMorisaki'ye bırakıyorum.
Dialogue: 0,0:01:32.43,0:01:34.48,Default,,0,0,0,,Tamam. Elimden geleni yapacağım.
Dialogue: 0,0:01:34.48,0:01:36.04,Default,,0,0,0,,Tamamdır, anladım.
Dialogue: 0,0:01:36.04,0:01:40.49,Default,,0,0,0,,Wakabayashi olmasa bile\Ngüçlü bir takım olduğumuzu gösterelim!
Dialogue: 0,0:01:40.49,0:01:42.36,Default,,0,0,0,,Evet.
Dialogue: 0,0:01:42.36,0:01:45.12,Default,,0,0,0,,Millet, buraya kadar dişinizle\Ntırnağınızla geldiniz.
Dialogue: 0,0:01:45.12,0:01:48.03,Default,,0,0,0,,Ama bugünkü rakibiniz Nankatsu.
Dialogue: 0,0:01:48.03,0:01:49.62,Default,,0,0,0,,Güçlü bir rakip.
Dialogue: 0,0:01:49.62,0:01:50.80,Default,,0,0,0,,Evet!
Dialogue: 0,0:01:50.80,0:01:53.75,Default,,0,0,0,,Ama daha başlamadan\Npes etmeye lüzum yok.
Dialogue: 0,0:01:53.75,0:01:59.52,Default,,0,0,0,,Bugüne kadar Nankatsu'nun her oyununa\Nteker teker çalıştık.
Dialogue: 0,0:01:59.52,0:02:00.38,Default,,0,0,0,,Evet!
Dialogue: 0,0:02:00.38,0:02:02.70,Default,,0,0,0,,Millet, her şeyimizi ortaya\Nkoyarak mücadele edelim!
Dialogue: 0,0:02:15.11,0:02:20.70,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:02:20.70,0:02:25.37,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:02:26.62,0:02:31.29,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:02:32.17,0:02:39.88,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:02:39.88,0:02:45.64,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:02:45.64,0:02:54.40,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:02:54.40,0:02:59.95,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:02:59.95,0:03:05.87,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:03:05.87,0:03:07.54,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:03:07.54,0:03:14.75,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:03:14.75,0:03:17.76,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:03:17.76,0:03:22.18,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:02:15.11,0:02:20.70,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:02:20.70,0:02:25.37,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:02:26.62,0:02:31.29,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:02:32.17,0:02:39.88,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:02:39.88,0:02:45.64,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:02:45.64,0:02:54.40,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:02:54.40,0:02:59.95,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:02:59.95,0:03:05.87,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:03:05.87,0:03:07.54,Opening Romaji,,0,0,0,,Run & Run!
