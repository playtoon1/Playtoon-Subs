Dialogue: 0,0:00:00.75,0:00:02.93,Default,,0,0,0,,{\i1}Kaptan Tsubasa'da önceki bölüm.{\i1}{\i0}
Dialogue: 0,0:00:02.93,0:00:09.82,Default,,0,0,0,,{\i1}11'e tek avantaj verilmiş maçta Tsubasa sağlam\Ntop kontrolleriyle rakip takımla oynadı.{\i0}
Dialogue: 0,0:00:09.82,0:00:15.54,Default,,0,0,0,,{\i1}Sonrasında birden ortaya çıkan Brezilya milli\Ntakımının eski forverti Robert Hongo'nun...{\i0}
Dialogue: 0,0:00:15.54,0:00:20.50,Default,,0,0,0,,{\i1}...açtığı ortayı gole çeviren Tsubasa,\NWakabayashi'ye karşı mutlak bir zafer aldı.{\i0}
Dialogue: 0,0:00:20.50,0:00:21.50,Default,,0,0,0,,{\i1}Kaybettim.{\i0}
Dialogue: 0,0:00:21.50,0:00:24.79,Default,,0,0,0,,{\i1}Bu cüceye kaybettim.{\i0}{\i1}
Dialogue: 0,0:00:24.79,0:00:26.08,Default,,0,0,0,,Maç!
Dialogue: 0,0:00:26.08,0:00:27.42,Default,,0,0,0,,Maç yapacağız be!
Dialogue: 0,0:00:27.85,0:00:32.24,Default,,0,0,0,,{\i1}Meselelerini okullar arasındaki\Nturnuva gününe bırakmaya karar vermişlerdi.{\i0}
Dialogue: 0,0:00:32.24,0:00:38.44,Default,,0,0,0,,{\i1}Bu ana kadar her şeyi izleyen Roberto\Nise onlara koçluk yapmayı teklif etti.{\i0}
Dialogue: 0,0:00:38.44,0:00:44.27,Default,,0,0,0,,{\i1}Sonrasında yeteneklerini kanıtlamak\Niçin rövaşata vuruş yapmıştı.{\i0}
Dialogue: 0,0:00:45.65,0:00:46.69,Default,,0,0,0,,İşte!
Dialogue: 0,0:00:46.69,0:00:51.97,Default,,0,0,0,,{\i1}{\i1}Hareketimi daha yeni gördü\Nama hemen deniyor.{\i0}{\i0}
Dialogue: 0,0:00:51.97,0:00:56.95,Default,,0,0,0,,{\i1}{\i1}Gördüğü tüm teknikleri\Nyapmayı kafasına koymuş birisi.{\i0}{\i0}
Dialogue: 0,0:00:56.95,0:00:58.58,Default,,0,0,0,,Git!
Dialogue: 0,0:00:59.45,0:01:00.74,Default,,0,0,0,,{\i1}Pratiğin sonunda...{\i0}
Dialogue: 0,0:01:00.74,0:01:04.22,Default,,0,0,0,,{\i1}...rövaşata vuruş yapmayı\Nbaşaran Tsubasa...{\i0}
Dialogue: 0,0:01:04.22,0:01:09.90,Default,,0,0,0,,{\i1}...yeni arkadaşıyla birlikte\NWakabayashi ile yüzleşmeye hazırdı.{\i0}
Dialogue: 0,0:01:26.24,0:01:27.72,Default,,0,0,0,,Rövaşata!
Dialogue: 0,0:01:27.72,0:01:28.48,Default,,0,0,0,,Tsubasa…
Dialogue: 0,0:01:31.87,0:01:36.30,Default,,0,0,0,,Ne? Ne oldu anne?\NNeden kafanda çarşaf var?
Dialogue: 0,0:01:39.13,0:01:41.99,Default,,0,0,0,,Neden ki acaba?
Dialogue: 0,0:01:42.52,0:01:48.09,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:01:53.98,0:01:59.57,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:01:59.57,0:02:04.24,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:02:05.49,0:02:10.16,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:02:11.04,0:02:18.75,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:02:18.75,0:02:24.51,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:02:24.51,0:02:33.27,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:02:33.27,0:02:38.82,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:02:38.82,0:02:44.74,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:02:44.74,0:02:46.41,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:02:46.41,0:02:53.62,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:02:53.62,0:02:56.63,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:02:56.63,0:03:01.05,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:01:53.98,0:01:59.57,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:01:59.57,0:02:04.24,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:02:05.49,0:02:10.16,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:02:11.04,0:02:18.75,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:02:18.75,0:02:24.51,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:02:24.51,0:02:33.27,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:02:33.27,0:02:38.82,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:02:38.82,0:02:44.74,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:02:44.74,0:02:46.41,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:02:46.41,0:02:53.62,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo\N
Dialogue: 0,0:02:53.62,0:02:56.63,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:02:56.63,0:03:01.05,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:03:15.80,0:03:20.14,Default,,0,0,0,,Hep geç kalkıyorsun. Bu gidişle\Niyice tembelleşeceksin.
Dialogue: 0,0:03:20.14,0:03:21.95,Default,,0,0,0,,Hiç de bile...
Dialogue: 0,0:03:24.80,0:03:29.39,Default,,0,0,0,,Git de yüzünü yıka.\NBahar tatili bugün bitecek.
Dialogue: 0,0:03:29.86,0:03:31.43,Default,,0,0,0,,Yarın okula gideceksin.
Dialogue: 0,0:03:32.43,0:03:33.90,Default,,0,0,0,,Doğru ya, okul!
Dialogue: 0,0:03:33.90,0:03:35.95,Default,,0,0,0,,Nasıl gitti anne?
Dialogue: 0,0:03:35.95,0:03:39.44,Default,,0,0,0,,Formaliteler biraz zor oldu yani.
Dialogue: 0,0:03:39.90,0:03:45.04,Default,,0,0,0,,Shutetsu İlkokulu'na gitmeyi düşünüyordun\Nama birden Nankatsu İlkokulu'na gidesin tuttu.
Dialogue: 0,0:03:46.13,0:03:48.45,Default,,0,0,0,,Nankatsu İlkokulu'na gitmezsem olmaz ki.
Dialogue: 0,0:03:48.45,0:03:51.66,Default,,0,0,0,,{\i1}Meydan okumanı okullar arası\Nturnuvada kabul edeceğim!{\i0}
Dialogue: 0,0:03:51.66,0:03:57.55,Default,,0,0,0,,{\i1}Ama sen takımdayken Shutetsu'ya karşı\Nkesinlikle iyi bir gösteri ortaya koyarız!{\i0}
Dialogue: 0,0:03:57.55,0:03:59.05,Default,,0,0,0,,{\i1}Söz verdim sonuçta.{\i0}
Dialogue: 0,0:03:59.84,0:04:01.02,Default,,0,0,0,,Anne.
Dialogue: 0,0:04:01.02,0:04:01.84,Default,,0,0,0,,Efendim?
Dialogue: 0,0:04:02.35,0:04:05.37,Default,,0,0,0,,Bu şehre iyi ki taşınmışız.
Dialogue: 0,0:04:05.37,0:04:10.89,Default,,0,0,0,,Öyle mi? O zaman seni\Ntanışmak istediğim birisi var Tsubasa.
Dialogue: 0,0:04:11.85,0:04:13.27,Default,,0,0,0,,Buyur, gel içeri.
Dialogue: 0,0:04:17.48,0:04:19.15,Default,,0,0,0,,Roberto Hongo!
Dialogue: 0,0:04:19.15,0:04:20.82,Default,,0,0,0,,Selam. Günaydın.
Dialogue: 0,0:04:20.82,0:04:23.68,Default,,0,0,0,,Neden? Neden? Neden? Neden?
Dialogue: 0,0:04:23.68,0:04:25.32,Default,,0,0,0,,Al Tsubasa.
Dialogue: 0,0:04:25.32,0:04:26.90,Default,,0,0,0,,Babandan.
Dialogue: 0,0:04:28.54,0:04:30.33,Default,,0,0,0,,Roberto yanında getirdi.
Dialogue: 0,0:04:30.33,0:04:32.05,Default,,0,0,0,,Babamdan mı?
Dialogue: 0,0:04:36.19,0:04:37.26,Default,,0,0,0,,{\i1}Sevgili Tsubasa,{\i0}
Dialogue: 0,0:04:38.01,0:04:42.88,Default,,0,0,0,,{\i1}Roberto Hongo-san,\NBrezilya milli takımında...{\i0}
Dialogue: 0,0:04:42.89,0:04:46.47,Default,,0,0,0,,{\i1}...forvette oynamış harika\Nbir profesyonel futbolcu.{\i0}
Dialogue: 0,0:04:46.47,0:04:50.63,Default,,0,0,0,,{\i1}Çeşitli sebeplerle Japonya'ya\Ngelmeye karar vermişti.{\i0}
Dialogue: 0,0:04:51.35,0:04:54.35,Default,,0,0,0,,{\i1}Ben de bizim evde yaşamasını istedim.{\i0}
Dialogue: 0,0:04:55.49,0:05:00.99,Default,,0,0,0,,{\i1}Tsubasa, Roberto-san'a\Nsenden de bahsettim.{\i0}
Dialogue: 0,0:05:00.99,0:05:04.91,Default,,0,0,0,,{\i1}Yapabiliyorken gönlünce futbolu öğren.{\i0}
Dialogue: 0,0:05:06.18,0:05:08.45,Default,,0,0,0,,{\i1}Yakında eve döneceğim.{\i0}
Dialogue: 0,0:05:08.45,0:05:13.66,Default,,0,0,0,,Harika! Roberto Hongo\Nbizimle yaşayacak! Harika!
Dialogue: 0,0:05:14.40,0:05:15.04,Default,,0,0,0,,Ne?
Dialogue: 0,0:05:15.04,0:05:17.06,Default,,0,0,0,,Ama ne zaman geldin ki?
Dialogue: 0,0:05:22.03,0:05:24.83,Default,,0,0,0,,Annen beni hırsız sanmış.
Dialogue: 0,0:05:24.83,0:05:25.94,Default,,0,0,0,,Ne?
Dialogue: 0,0:05:25.94,0:05:28.34,Default,,0,0,0,,Birden su fırlattı üstüme.
Dialogue: 0,0:05:28.34,0:05:31.42,Default,,0,0,0,,Ama sabahın 2'sinde geldi.
Dialogue: 0,0:05:31.42,0:05:32.60,Default,,0,0,0,,2 mi?!
Dialogue: 0,0:05:32.60,0:05:36.60,Default,,0,0,0,,Keşke sen de hemen mektubu\Ngösterseydin Roberto.
Dialogue: 0,0:05:36.60,0:05:37.43,Default,,0,0,0,,Of yani...
Dialogue: 0,0:05:38.11,0:05:39.11,Default,,0,0,0,,Üzgünüm.
Dialogue: 0,0:05:40.57,0:05:42.24,Default,,0,0,0,,Öğleden sonra pratik yapacak mısın?
Dialogue: 0,0:05:42.24,0:05:43.28,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:43.28,0:05:46.61,Default,,0,0,0,,Bugün Ishizaki-kun, futbol\Ntakımıyla tanıştıracak beni.
Dialogue: 0,0:05:46.61,0:05:48.11,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:05:48.11,0:05:51.58,Default,,0,0,0,,Pekala. Öyleyse benden\Nbir hediye alacaksınız.
Dialogue: 0,0:05:51.58,0:05:53.66,Default,,0,0,0,,Ne? Hediye mi?
Dialogue: 0,0:05:57.11,0:05:59.58,Default,,0,0,0,,Wakabayashi'nin kaybetmesi mümkün değil.
Dialogue: 0,0:05:59.58,0:06:01.60,Default,,0,0,0,,Hayatta inanmam.
Dialogue: 0,0:06:01.60,0:06:05.93,Default,,0,0,0,,Shutetsu takımının bir oyuncuya\Nkarşı kaybetmesi olur mu hiç?
Dialogue: 0,0:06:05.93,0:06:08.72,Default,,0,0,0,,B takımına karşı da olsa yine de\Nulusalları kazanmış bir takım.
Dialogue: 0,0:06:08.72,0:06:10.30,Default,,0,0,0,,Gerçek diyorum be!
Dialogue: 0,0:06:10.93,0:06:13.43,Default,,0,0,0,,Gerçekten harika bir oyuncu!
Dialogue: 0,0:06:13.43,0:06:16.00,Default,,0,0,0,,Gittiği her yere de top sürüyor!
Dialogue: 0,0:06:16.00,0:06:19.03,Default,,0,0,0,,Yoksa ondan mı bahsediyorsun?
Dialogue: 0,0:06:25.26,0:06:28.11,Default,,0,0,0,,Hey, Tsubasa!
Dialogue: 0,0:06:28.11,0:06:29.03,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:06:30.78,0:06:33.33,Default,,0,0,0,,Tsubasa, seni bekliyorduk!
Dialogue: 0,0:06:35.84,0:06:36.58,Default,,0,0,0,,İşte!
Dialogue: 0,0:06:43.40,0:06:44.73,Default,,0,0,0,,Sağlam hareket.
Dialogue: 0,0:06:44.73,0:06:45.77,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:06:45.77,0:06:46.59,Default,,0,0,0,,Ne?
Dialogue: 0,0:06:46.59,0:06:47.47,Default,,0,0,0,,İşte.
Dialogue: 0,0:06:47.47,0:06:49.23,Default,,0,0,0,,Bende.
Dialogue: 0,0:06:53.22,0:06:54.81,Default,,0,0,0,,Her şey yolunda mı?
Dialogue: 0,0:06:55.79,0:06:57.87,Default,,0,0,0,,Yolunda, yolunda.
Dialogue: 0,0:06:57.87,0:06:59.73,Default,,0,0,0,,Ne? Roberto nerede?
Dialogue: 0,0:06:59.73,0:07:01.19,Default,,0,0,0,,Bir şey yapması gerekiyormuş.
Dialogue: 0,0:07:02.70,0:07:04.44,Default,,0,0,0,,Herkes futbol kulübünden mi?
Dialogue: 0,0:07:07.39,0:07:09.58,Default,,0,0,0,,Hepsi iyi gibi duruyor olabilir ama{\alpha&HFF&} değiller.
Dialogue: 0,0:07:09.58,0:07:10.61,Default,,0,0,0,,Hepsi iyi gibi duruyor olabilir ama değiller.
Dialogue: 0,0:07:11.24,0:07:14.14,Default,,0,0,0,,Bunu sen mi diyorsun Ishizaki?!
Dialogue: 0,0:07:14.14,0:07:16.10,Default,,0,0,0,,Az önce kontrol bile edemedin!
Dialogue: 0,0:07:16.10,0:07:18.62,Default,,0,0,0,,Ne olmuş yani?! Açın şimdi kulaklarınızı!
Dialogue: 0,0:07:18.62,0:07:23.50,Default,,0,0,0,,O, futbol sahasını geri alan\NOzora Tsubasa!
Dialogue: 0,0:07:23.50,0:07:24.63,Default,,0,0,0,,Memnun oldum.
Dialogue: 0,0:07:24.63,0:07:26.01,Default,,0,0,0,,Memnun oldum.
Dialogue: 0,0:07:26.01,0:07:29.34,Default,,0,0,0,,Burayı geri aldığın için\Ngerçekten çok teşekkürler.
Dialogue: 0,0:07:29.34,0:07:33.37,Default,,0,0,0,,Wakabayashi'nin gol yediğini\Ngörmek isterdim.
Dialogue: 0,0:07:33.37,0:07:35.90,Default,,0,0,0,,Ben de görmek isterdim.
Dialogue: 0,0:07:35.90,0:07:36.79,Default,,0,0,0,,Bu arada...
Dialogue: 0,0:07:37.82,0:07:41.44,Default,,0,0,0,,...takımımıza katılacak mısın?
Dialogue: 0,0:07:43.83,0:07:45.35,Default,,0,0,0,,Katılacağım.
Dialogue: 0,0:07:45.35,0:07:49.49,Default,,0,0,0,,Nankatsu'ya transfer oldum.\NBeraber futbol oynayacağız!
Dialogue: 0,0:07:51.49,0:07:52.50,Default,,0,0,0,,Yaşasın!
Dialogue: 0,0:07:52.50,0:07:54.34,Default,,0,0,0,,Futbolda çok iyisin sen.
Dialogue: 0,0:07:54.34,0:07:56.59,Default,,0,0,0,,Az önceki vuruşun beni çok etkiledi.
Dialogue: 0,0:07:56.59,0:07:58.59,Default,,0,0,0,,Demiştim değil mi? Değil mi?
Dialogue: 0,0:07:58.59,0:08:02.94,Default,,0,0,0,,Ayrıca Brezilyalı eski bir futbolcu\Nbize koçluk yapacak!
Dialogue: 0,0:08:03.54,0:08:05.00,Default,,0,0,0,,Harika değil mi?!
Dialogue: 0,0:08:05.00,0:08:08.25,Default,,0,0,0,,Yeni Nankatsu takımının\Nantrenmanları başlasın!
Dialogue: 0,0:08:08.25,0:08:10.01,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:14.60,0:08:16.07,Default,,0,0,0,,{\i0}Genzo.{\i1}
Dialogue: 0,0:08:16.07,0:08:18.43,Default,,0,0,0,,{\i1}Yaraların iyi mi?{\i0}
Dialogue: 0,0:08:18.43,0:08:21.05,Default,,0,0,0,,{\i1}Bugün dinlenmen gerek.{\i0}
Dialogue: 0,0:08:23.00,0:08:25.02,Default,,0,0,0,,{\i1}Kaybettim.{\i0}
Dialogue: 0,0:08:25.76,0:08:27.29,Default,,0,0,0,,{\i1}Ozora Tsubasa'ya karşı.{\i0}
Dialogue: 0,0:08:30.24,0:08:36.95,Default,,0,0,0,,{\i1}Belki de ulusal turnuvada gol yememiş\Nolmam burnumu kaldırmıştır.{\i0}
Dialogue: 0,0:08:37.43,0:08:38.91,Default,,0,0,0,,{\i1}Bu kadar kafana takma.{\i0}
Dialogue: 0,0:08:38.91,0:08:40.72,Default,,0,0,0,,{\i1}Mümkün mü sanki bu?!{\i0}
Dialogue: 0,0:08:42.31,0:08:44.94,Default,,0,0,0,,{\i1}Şutlarını durduramazsam...{\i0}
Dialogue: 0,0:08:44.94,0:08:47.80,Default,,0,0,0,,{\i1}...geçen sene şampiyon\Nolmam hiçbir şey ifade etmez.{\i0}
Dialogue: 0,0:08:56.67,0:09:00.06,Default,,0,0,0,,Koşma ile başlayalım.\NSonrasında paslaşırız.
Dialogue: 0,0:09:00.06,0:09:01.77,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:09:07.73,0:09:10.65,Default,,0,0,0,,Tsubasa, paslaşmada\Nbenimle çift olur musun?
Dialogue: 0,0:09:10.65,0:09:11.33,Default,,0,0,0,,Evet.
Dialogue: 0,0:09:28.50,0:09:29.86,Default,,0,0,0,,Baksana Tsubasa.
Dialogue: 0,0:09:30.85,0:09:34.84,Default,,0,0,0,,Dün aklıma takılınca gidip araştırdım da...
Dialogue: 0,0:09:34.84,0:09:37.05,Default,,0,0,0,,...futbolda çok iyi olmana rağmen...
Dialogue: 0,0:09:37.05,0:09:40.39,Default,,0,0,0,,...ulusal futbol turnuvasına\Nhiç katılmamışsın.
Dialogue: 0,0:09:40.39,0:09:43.03,Default,,0,0,0,,Eski okulunun futbol kulübü yok muydu?
Dialogue: 0,0:09:44.25,0:09:46.14,Default,,0,0,0,,Vardı ama...
Dialogue: 0,0:09:46.64,0:09:48.55,Default,,0,0,0,,...o kadar da iyi değildiler.
Dialogue: 0,0:09:48.55,0:09:50.15,Default,,0,0,0,,Sen varken bile mi?!
Dialogue: 0,0:09:51.65,0:09:54.65,Default,,0,0,0,,Kimse futbolu sevmiyordu.
Dialogue: 0,0:09:54.65,0:09:57.20,Default,,0,0,0,,Bazılarının tek umursadığı şut çekmekti.
Dialogue: 0,0:09:57.72,0:10:00.84,Default,,0,0,0,,Pratikleri de çok ağır bulduklarından ayrıldılar.
Dialogue: 0,0:10:00.84,0:10:02.87,Default,,0,0,0,,Öyleleri her yerde var.
Dialogue: 0,0:10:02.87,0:10:05.14,Default,,0,0,0,,Herkes forvet olmak istiyor.
Dialogue: 0,0:10:05.14,0:10:07.32,Default,,0,0,0,,Ama herkes gol atamaz ki.
Dialogue: 0,0:10:07.32,0:10:09.71,Default,,0,0,0,,Bunu da sıkıcı buluyorlar.
Dialogue: 0,0:10:09.71,0:10:12.89,Default,,0,0,0,,Bu yüzden pratik yapmıyor muyuz ama?
Dialogue: 0,0:10:13.91,0:10:14.96,Default,,0,0,0,,Sonuçta...
Dialogue: 0,0:10:14.96,0:10:19.15,Default,,0,0,0,,...buradaki hepimiz\Nfutbolu seviyoruz değil mi?
Dialogue: 0,0:10:19.15,0:10:20.84,Default,,0,0,0,,Evet, aynen öyle.
Dialogue: 0,0:10:20.84,0:10:22.85,Default,,0,0,0,,Seviyoruz tabii.
Dialogue: 0,0:10:22.85,0:10:27.46,Default,,0,0,0,,Yoksa her sene Shutetsu tarafından\Nyenilmeye katlanmazdık değil mi?
Dialogue: 0,0:10:30.15,0:10:31.77,Default,,0,0,0,,Birisi geliyor.
Dialogue: 0,0:10:37.87,0:10:39.49,Default,,0,0,0,,Ne diye buradasınız?!
Dialogue: 0,0:10:45.97,0:10:51.06,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:10:54.60,0:10:56.05,Default,,0,0,0,,Selam Ishizaki.
Dialogue: 0,0:10:56.05,0:10:57.53,Default,,0,0,0,,Urabe!
Dialogue: 0,0:10:58.22,0:10:59.48,Default,,0,0,0,,Hangi takım bu?
Dialogue: 0,0:10:59.55,0:11:01.72,Default,,0,0,0,,Nishigaoka İlkokulu'nun futbol takımı.
Dialogue: 0,0:11:02.39,0:11:04.03,Default,,0,0,0,,Komşu şehrin okulu.
Dialogue: 0,0:11:04.23,0:11:06.11,Default,,0,0,0,,Oldukça güçlü bir takımlar.
Dialogue: 0,0:11:06.75,0:11:08.87,Default,,0,0,0,,Söz verdiğimiz gibi geldik.
Dialogue: 0,0:11:09.15,0:11:11.00,Default,,0,0,0,,Ne sözünden bahsediyorsun?
Dialogue: 0,0:11:11.36,0:11:13.03,Default,,0,0,0,,Asıl sen neyden bahsediyorsun?
Dialogue: 0,0:11:13.20,0:11:16.42,Default,,0,0,0,,Pratik maçı yapmayı\Nsöyleyen sendin!
Dialogue: 0,0:11:16.60,0:11:17.39,Default,,0,0,0,,Ha?!
Dialogue: 0,0:11:20.11,0:11:20.91,Default,,0,0,0,,Roberto!
Dialogue: 0,0:11:21.60,0:11:23.39,Default,,0,0,0,,Aslında söyleyen bendim.
Dialogue: 0,0:11:24.08,0:11:27.03,Default,,0,0,0,,Sonunda geldin koç!\NÇok geç kaldın!
Dialogue: 0,0:11:28.79,0:11:31.11,Default,,0,0,0,,- Ne? Roberto Hongo mu?\N- Evet.
Dialogue: 0,0:11:31.79,0:11:33.72,Default,,0,0,0,,Ama içki içiyor bu...
Dialogue: 0,0:11:33.87,0:11:35.51,Default,,0,0,0,,Gerçekten o mu?
Dialogue: 0,0:11:35.79,0:11:37.87,Default,,0,0,0,,O tabii! Bilmiyor musunuz?
Dialogue: 0,0:11:38.03,0:11:41.75,Default,,0,0,0,,Harika bir oyuncunun\NJaponya'ya geldiği söyleniyordu haberlerde!{this doesn't make sense?}
Dialogue: 0,0:11:41.91,0:11:42.95,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:11:43.47,0:11:46.95,Default,,0,0,0,,İyi mi bu? Daha öğle olmasına\Nrağmen alkol alıyor.
Dialogue: 0,0:11:47.20,0:11:49.08,Default,,0,0,0,,Bildiğiniz sarhoşlara benzemez o!
Dialogue: 0,0:11:49.23,0:11:50.87,Default,,0,0,0,,Gerçekten harika birisidir.
Dialogue: 0,0:11:51.75,0:11:54.72,Default,,0,0,0,,Sabah bahsettiğin hediye olayı bu muydu?
Dialogue: 0,0:11:54.87,0:11:55.32,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:55.51,0:11:57.75,Default,,0,0,0,,Ne berbat bir futbol takımı bu.
Dialogue: 0,0:11:57.91,0:11:58.91,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:59.08,0:12:01.51,Default,,0,0,0,,Koçunuz bir ayyaş.
Dialogue: 0,0:12:01.67,0:12:02.72,Default,,0,0,0,,Roberto--
Dialogue: 0,0:12:08.20,0:12:10.27,Default,,0,0,0,,Hayır, gerçekten iyidir.
Dialogue: 0,0:12:10.63,0:12:13.42,Default,,0,0,0,,Oynadığı zamanlardan biraz\Nfarklı gözüküyor gerçi.
Dialogue: 0,0:12:13.60,0:12:14.55,Default,,0,0,0,,Kafa mı buluyorsun?
Dialogue: 0,0:12:15.08,0:12:18.51,Default,,0,0,0,,Tüm gözler üzerindeydi ama\Nbirden ortadan kayboldu.
Dialogue: 0,0:12:18.67,0:12:20.11,Default,,0,0,0,,Millet, size güveniyorum!
Dialogue: 0,0:12:21.42,0:12:22.84,Default,,0,0,0,,Alkol yüzünden mi acaba?
Dialogue: 0,0:12:23.00,0:12:23.91,Default,,0,0,0,,Olabilir.
Dialogue: 0,0:12:25.79,0:12:28.00,Default,,0,0,0,,Bayağı acayip bir koç seçmişsiniz.
Dialogue: 0,0:12:28.95,0:12:31.36,Default,,0,0,0,,Shutetsu'ya karşı...
Dialogue: 0,0:12:31.51,0:12:33.67,Default,,0,0,0,,...30-0 kaybetmenize şaşmamalı!
Dialogue: 0,0:12:35.20,0:12:36.51,Default,,0,0,0,,30-0 mı?!
Dialogue: 0,0:12:39.27,0:12:42.51,Default,,0,0,0,,Shutetsu'yu alt etmeyi hedefliyorsak...
Dialogue: 0,0:12:42.67,0:12:45.39,Default,,0,0,0,,...bizim de böyle bir fark açmamız lazım.
Dialogue: 0,0:12:46.32,0:12:47.11,Default,,0,0,0,,İyi dedin.
Dialogue: 0,0:12:47.27,0:12:51.08,Default,,0,0,0,,Şu çocuk...\NAklına eseni söylüyor!
Dialogue: 0,0:12:51.23,0:12:52.91,Default,,0,0,0,,30-0 gerçek mi?
Dialogue: 0,0:12:53.08,0:12:54.63,Default,,0,0,0,,Şey... Evet.
Dialogue: 0,0:12:54.87,0:12:58.67,Default,,0,0,0,,Tsubasa! Onları paketlemen\Nkonusunda sana güveniyorum!
Dialogue: 0,0:12:58.84,0:12:59.36,Default,,0,0,0,,Tamam.
Dialogue: 0,0:12:59.95,0:13:01.47,Default,,0,0,0,,Öyleyse başlayalım.
Dialogue: 0,0:13:01.63,0:13:03.67,Default,,0,0,0,,Acele etmezsek hava kararacak.
Dialogue: 0,0:13:03.84,0:13:06.42,Default,,0,0,0,,Ne diyorsun be?!\NDaha öğlen, aptal!
Dialogue: 0,0:13:16.08,0:13:19.27,Default,,0,0,0,,Belki de koç gibi davranmam gerekiyordur.
Dialogue: 0,0:13:19.42,0:13:21.84,Default,,0,0,0,,Öyleyse önce şu alkolle başla!
Dialogue: 0,0:13:22.51,0:13:24.20,Default,,0,0,0,,Burada yasak!
Dialogue: 0,0:13:25.72,0:13:26.51,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:13:27.91,0:13:31.27,Default,,0,0,0,,Çöpe atman gerekiyor be onu!
Dialogue: 0,0:13:31.42,0:13:34.23,Default,,0,0,0,,Yeni aldığım için israf olmaz mı?
Dialogue: 0,0:13:35.87,0:13:37.87,Default,,0,0,0,,Saha dışında da harika bir şey değil zaten!{i'm not so sure about this}
Dialogue: 0,0:13:38.03,0:13:39.03,Default,,0,0,0,,Sakin, sakin.
Dialogue: 0,0:13:39.42,0:13:42.27,Default,,0,0,0,,Bu arada millet, kaptanınız kim?
Dialogue: 0,0:13:42.87,0:13:44.72,Default,,0,0,0,,Benim.
Dialogue: 0,0:13:44.87,0:13:46.32,Default,,0,0,0,,Ne? Öyle mi?
Dialogue: 0,0:13:46.47,0:13:47.63,Default,,0,0,0,,Daha karar vermemiştik.
Dialogue: 0,0:13:47.79,0:13:50.95,Default,,0,0,0,,Ne diyorsunuz be?!\NHep bendim zaten!
Dialogue: 0,0:13:51.23,0:13:55.47,Default,,0,0,0,,Öyleyse Ishizaki, sesini yükselterek\Nherkese rehberlik et.
Dialogue: 0,0:13:55.63,0:13:56.95,Default,,0,0,0,,Tamamdır, anladım!
Dialogue: 0,0:13:57.36,0:13:58.87,Default,,0,0,0,,Hep yapıyorsun zaten.
Dialogue: 0,0:13:59.03,0:14:00.72,Default,,0,0,0,,Tek dediğin koşun ama.
Dialogue: 0,0:14:00.87,0:14:01.91,Default,,0,0,0,,Ne olmuş yani?
Dialogue: 0,0:14:02.27,0:14:03.47,Default,,0,0,0,,Bu da iyi.
Dialogue: 0,0:14:03.79,0:14:04.91,Default,,0,0,0,,Kaptanın sesini duymak...
Dialogue: 0,0:14:05.27,0:14:06.67,Default,,0,0,0,,...herkese güç verir.
Dialogue: 0,0:14:06.87,0:14:07.63,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:07.79,0:14:10.20,Default,,0,0,0,,Roberto, başka tavsiyen var mı?
Dialogue: 0,0:14:11.36,0:14:12.75,Default,,0,0,0,,Düşüneyim...
Dialogue: 0,0:14:14.11,0:14:15.11,Default,,0,0,0,,Yok sanırım ya.
Dialogue: 0,0:14:16.27,0:14:18.91,Default,,0,0,0,,İlk olarak herkesin seviyesini göreyim.
Dialogue: 0,0:14:19.23,0:14:21.11,Default,,0,0,0,,Bu maç bunun için harika.
Dialogue: 0,0:14:22.11,0:14:24.60,Default,,0,0,0,,Hangi pozisyonda oynayacağınıza\Nkarar vereceğim.
Dialogue: 0,0:14:25.11,0:14:27.36,Default,,0,0,0,,Tüm gücünüzle oynayın.
Dialogue: 0,0:14:27.60,0:14:28.47,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:30.63,0:14:31.36,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:14:31.51,0:14:32.91,Default,,0,0,0,,Ne oldu Roberto?
Dialogue: 0,0:14:33.39,0:14:34.32,Default,,0,0,0,,Unutma.
Dialogue: 0,0:14:35.11,0:14:36.60,Default,,0,0,0,,Top senin arkadaşın.
Dialogue: 0,0:14:40.27,0:14:41.91,Default,,0,0,0,,Sizinle oynamak için...
Dialogue: 0,0:14:42.47,0:14:43.72,Default,,0,0,0,,...top bekliyor.
Dialogue: 0,0:14:47.11,0:14:48.55,Default,,0,0,0,,Pekala, gidin bakalım!
Dialogue: 0,0:14:49.51,0:14:50.51,Default,,0,0,0,,Baş üstüne!
Dialogue: 0,0:15:04.63,0:15:06.75,Default,,0,0,0,,Hakem bey, size güveniyorum.
Dialogue: 0,0:15:07.00,0:15:08.23,Default,,0,0,0,,Teşekkürler.
Dialogue: 0,0:15:15.15,0:15:19.55,Default,,0,0,0,,Öyleyse Nishigaoka ve Nankatsu\Narasındaki dostluk maçı başlıyor.
Dialogue: 0,0:15:20.23,0:15:21.36,Default,,0,0,0,,Her yarı 20 dakika.
Dialogue: 0,0:15:21.79,0:15:23.84,Default,,0,0,0,,Nishigaoka başlayacak.
Dialogue: 0,0:15:31.08,0:15:34.20,Default,,0,0,0,,{\i1}O da kim? Nankatsu'da böyle\Nbirisi olduğunu bilmiyordum.{\i0}
Dialogue: 0,0:15:35.11,0:15:38.42,Default,,0,0,0,,{\i1}Neyse artık.\NNe fark edecek ki zaten?{\i0} {he's no match for us?}
Dialogue: 0,0:15:39.27,0:15:43.72,Default,,0,0,0,,Pekala, 30 gol atmakla başlayalım!
Dialogue: 0,0:15:43.74,0:15:44.60,Default,,0,0,0,,Tamam!
Dialogue: 0,0:15:44.60,0:15:46.00,Default,,0,0,0,,Dalga geçiyor!
Dialogue: 0,0:15:48.87,0:15:49.75,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:51.67,0:15:52.60,Default,,0,0,0,,Güzel pas!
Dialogue: 0,0:15:53.60,0:15:55.08,Default,,0,0,0,,Ne oldu? Ne oldu?
Dialogue: 0,0:16:00.11,0:16:01.87,Default,,0,0,0,,Millet, durdurun şunları!
Dialogue: 0,0:16:12.51,0:16:13.36,Default,,0,0,0,,Urabe!
Dialogue: 0,0:16:18.84,0:16:20.20,Default,,0,0,0,,Ne güzel top çalıyorsunuz.
Dialogue: 0,0:16:20.79,0:16:23.15,Default,,0,0,0,,Nishigaoka kaptanı...
Dialogue: 0,0:16:23.32,0:16:26.27,Default,,0,0,0,,...ben Urabe Hanji-sama'yı durduramazsınız!
Dialogue: 0,0:16:29.39,0:16:30.23,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:31.03,0:16:31.91,Default,,0,0,0,,- Ne?!\N- Yok artık!
Dialogue: 0,0:16:32.27,0:16:33.72,Default,,0,0,0,,Aferin Tsubasa!
Dialogue: 0,0:16:33.95,0:16:35.00,Default,,0,0,0,,Harika!
Dialogue: 0,0:16:37.67,0:16:38.72,Default,,0,0,0,,Gidin!
Dialogue: 0,0:16:42.20,0:16:44.55,Default,,0,0,0,,Tsubasa, ne yapıyorsun?!
Dialogue: 0,0:16:44.79,0:16:46.84,Default,,0,0,0,,Orası bizim kalemiz!
Dialogue: 0,0:16:47.36,0:16:48.55,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:56.55,0:16:57.39,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:17:04.59,0:17:05.23,Default,,0,0,0,,Şut çekeceğim!
Dialogue: 0,0:17:20.23,0:17:22.00,Default,,0,0,0,,- Girdi.\N- Cidden mi?
Dialogue: 0,0:17:26.07,0:17:27.75,Default,,0,0,0,,Başardın Tsubasa!
Dialogue: 0,0:17:27.92,0:17:29.75,Default,,0,0,0,,İlk kez böyle bir şey görüyorum!
Dialogue: 0,0:17:29.92,0:17:32.27,Default,,0,0,0,,Ne yapıştırdı be!
Dialogue: 0,0:17:33.64,0:17:34.86,Default,,0,0,0,,Başardık millet.
Dialogue: 0,0:17:35.10,0:17:37.55,Default,,0,0,0,,Harika! O kadar uzaktan vurdu!
Dialogue: 0,0:17:37.72,0:17:39.35,Default,,0,0,0,,Başardık, başardık, başardık!
Dialogue: 0,0:17:40.47,0:17:42.07,Default,,0,0,0,,Neyin nesi bu?
Dialogue: 0,0:17:42.79,0:17:43.59,Default,,0,0,0,,Öyle birisi...
Dialogue: 0,0:17:44.27,0:17:45.86,Default,,0,0,0,,...Nankatsu'da oynuyor muydu ki?{there was a guy like him at Nankatsu?} {I thought he meant like "was there a guy like him at Nankatsu?"}
Dialogue: 0,0:17:48.86,0:17:50.55,Default,,0,0,0,,Hadi, karşılıklarını verelim!{or let's fight back}
Dialogue: 0,0:17:56.00,0:18:00.83,Default,,0,0,0,,# NANKATSU : 2\NNISHIGAOKA : 0 #
Dialogue: 0,0:18:02.75,0:18:05.16,Default,,0,0,0,,İki golden sonra bile çevirebiliriz!
Dialogue: 0,0:18:06.23,0:18:07.43,Default,,0,0,0,,Gene mi sen?!
Dialogue: 0,0:18:15.10,0:18:15.64,Default,,0,0,0,,Bana mı?!
Dialogue: 0,0:18:17.10,0:18:18.40,Default,,0,0,0,,Üzgünüm!
Dialogue: 0,0:18:18.55,0:18:19.79,Default,,0,0,0,,Onun adı ne?
Dialogue: 0,0:18:20.40,0:18:21.47,Default,,0,0,0,,Iwami!
Dialogue: 0,0:18:28.31,0:18:29.16,Default,,0,0,0,,Gel!
Dialogue: 0,0:18:29.31,0:18:30.16,Default,,0,0,0,,Iwami-kun!
Dialogue: 0,0:18:32.83,0:18:34.07,Default,,0,0,0,,Başardım.
Dialogue: 0,0:18:34.51,0:18:37.03,Default,,0,0,0,,Evet. Sakin olursan sorun olmaz.
Dialogue: 0,0:18:40.43,0:18:41.10,Default,,0,0,0,,Iwami-kun!
Dialogue: 0,0:18:41.86,0:18:42.75,Default,,0,0,0,,Buraya!
Dialogue: 0,0:18:44.68,0:18:45.79,Default,,0,0,0,,Atamazsın!
Dialogue: 0,0:18:50.35,0:18:50.83,Default,,0,0,0,,Ne?!
Dialogue: 0,0:18:52.40,0:18:53.68,Default,,0,0,0,,İşte böyle!
Dialogue: 0,0:18:54.72,0:18:56.86,Default,,0,0,0,,Önü açık!
Dialogue: 0,0:18:57.31,0:18:58.68,Default,,0,0,0,,Herkes gözünü dört açsın!
Dialogue: 0,0:19:04.64,0:19:05.59,Default,,0,0,0,,Hayda...
Dialogue: 0,0:19:05.75,0:19:07.55,Default,,0,0,0,,Ishizaki-kun, çok yakındı.
Dialogue: 0,0:19:07.72,0:19:08.72,Default,,0,0,0,,Sanırım öyle.
Dialogue: 0,0:19:09.20,0:19:11.16,Default,,0,0,0,,Millet, böyle devam!
Dialogue: 0,0:19:11.31,0:19:12.75,Default,,0,0,0,,Beni takip edin!
Dialogue: 0,0:19:12.92,0:19:15.72,Default,,0,0,0,,Tsubasa-kun'u takip edelim mi diyorsun yani?
Dialogue: 0,0:19:16.03,0:19:18.51,Default,,0,0,0,,Kes be!\NBu kadar takılmanın lüzumu yok!{fussy}
Dialogue: 0,0:19:33.20,0:19:34.40,Default,,0,0,0,,{\i1}Ne çocuk ama.{\i0}
Dialogue: 0,0:19:35.35,0:19:36.64,Default,,0,0,0,,{\i1}Ozora Tsubasa...{\i0}
Dialogue: 0,0:19:38.16,0:19:40.59,Default,,0,0,0,,{\i1}Tüm oyunu tek başına kuruyor.{\i0}
Dialogue: 0,0:19:42.20,0:19:43.27,Default,,0,0,0,,{\i1}Nankatsu'dakiler...{\i0}
Dialogue: 0,0:19:43.92,0:19:46.23,Default,,0,0,0,,{\i1}...şu ana kadar hiç böyle oynamamıştı.{\i0}
Dialogue: 0,0:19:47.68,0:19:50.03,Default,,0,0,0,,# NANKATSU : 4\NNISHIGAOKA : 2 #
Dialogue: 0,0:19:50.20,0:19:53.51,Default,,0,0,0,,Onu... Sadece onu tutun yeter!
Dialogue: 0,0:19:54.03,0:19:56.00,Default,,0,0,0,,Diğerlerini boş verin!
Dialogue: 0,0:19:57.95,0:19:59.51,Default,,0,0,0,,Her şeyinizle tutun!
Dialogue: 0,0:19:59.72,0:20:02.75,Default,,0,0,0,,Ozora Tsubasa'nın topu almasına izin vermeyin!
Dialogue: 0,0:20:02.92,0:20:03.55,Default,,0,0,0,,Tamam!
Dialogue: 0,0:20:07.92,0:20:09.80,Default,,0,0,0,,- Geçemezsin!\N- Gel bakalım!
Dialogue: 0,0:20:11.68,0:20:13.03,Default,,0,0,0,,Pas ver Tsubasa!
Dialogue: 0,0:20:16.10,0:20:16.75,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:21.75,0:20:22.59,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:22.95,0:20:24.03,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:20:28.64,0:20:29.83,Default,,0,0,0,,Orta!
Dialogue: 0,0:20:30.00,0:20:31.07,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:31.27,0:20:32.64,Default,,0,0,0,,Ne?! Bana mı?!
Dialogue: 0,0:20:32.79,0:20:34.20,Default,,0,0,0,,Ishizaki, at şunu!
Dialogue: 0,0:20:34.35,0:20:35.07,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:20:49.23,0:20:50.20,Default,,0,0,0,,Attı!
Dialogue: 0,0:20:50.35,0:20:51.00,Default,,0,0,0,,Yaşasın!
Dialogue: 0,0:20:54.55,0:20:55.75,Default,,0,0,0,,Saçmalık...
Dialogue: 0,0:21:01.59,0:21:03.59,Default,,0,0,0,,Acıttı.
Dialogue: 0,0:21:08.07,0:21:10.20,Default,,0,0,0,,B-Ben...
Dialogue: 0,0:21:10.83,0:21:11.72,Default,,0,0,0,,...gol attım.
Dialogue: 0,0:21:12.55,0:21:14.23,Default,,0,0,0,,Gol attım.
Dialogue: 0,0:21:18.10,0:21:19.31,Default,,0,0,0,,Maç bitti!
Dialogue: 0,0:21:19.47,0:21:22.00,Default,,0,0,0,,# NANKATSU : 5\NNISHIGAOKA : 2 #
Dialogue: 0,0:21:22.35,0:21:24.23,Default,,0,0,0,,Kazandık!
Dialogue: 0,0:21:24.79,0:21:27.31,Default,,0,0,0,,Yaşasın! Kazandık!
Dialogue: 0,0:21:27.47,0:21:29.20,Default,,0,0,0,,Çok mutluyum!
Dialogue: 0,0:21:29.86,0:21:33.00,Default,,0,0,0,,Tsubasa! Hepsi senin sayende!
Dialogue: 0,0:21:33.35,0:21:36.27,Default,,0,0,0,,Son golü sen attın ama Ishizaki-kun.
Dialogue: 0,0:21:36.68,0:21:37.27,Default,,0,0,0,,Ayrıca...
Dialogue: 0,0:21:37.72,0:21:39.27,Default,,0,0,0,,...hep birlikte çabaladık.
Dialogue: 0,0:21:45.83,0:21:48.00,Default,,0,0,0,,Nankatsu'ya kaybettik.
Dialogue: 0,0:21:49.31,0:21:50.75,Default,,0,0,0,,Ozora Tsubasa...
Dialogue: 0,0:21:51.40,0:21:53.40,Default,,0,0,0,,Hepsi senin yüzünden.
Dialogue: 0,0:21:56.72,0:22:00.10,Default,,0,0,0,,{\i1}Tsubasa, okullar arası turnuvada\Nkarşılaşmak için sabırsızlanıyorum.{\i0}
Dialogue: 0,0:22:03.03,0:22:05.75,Default,,0,0,0,,{\i1}Hepsinin eksiklerini iyice anladım.{\i0}
Dialogue: 0,0:22:06.40,0:22:08.07,Default,,0,0,0,,{\i1}Ne yapmam gerektiğini biliyorum.{\i0}
Dialogue: 0,0:22:09.16,0:22:10.31,Default,,0,0,0,,{\i1}Ama en önemlisi...{\i0}
Dialogue: 0,0:22:10.83,0:22:12.47,Default,,0,0,0,,{\i1}...hepiniz başlıyorsunuz...{\i0}
Dialogue: 0,0:22:14.07,0:22:15.72,Default,,0,0,0,,{\i1}...topla arkadaş olmaya.{\i0}
Dialogue: 0,0:22:17.32,0:22:20.24,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
