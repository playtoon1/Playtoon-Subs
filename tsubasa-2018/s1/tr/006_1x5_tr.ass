Dialogue: 0,0:00:01.33,0:00:03.04,Default,,0,0,0,,{\i1}Kaptan Tsubasa'da önceki bölüm.{\i1}{\i0}
Dialogue: 0,0:00:03.77,0:00:05.87,Default,,0,0,0,,{\i1}Nankatsu İlkokulu futbol\Nkulübündeki Tsubasa'lar...{\i0}
Dialogue: 0,0:00:06.16,0:00:09.10,Default,,0,0,0,,{\i1}...Roberto koçluğu altında\Nözel bir antrenmana başladılar.{\i0}
Dialogue: 0,0:00:10.28,0:00:14.27,Default,,0,0,0,,{\i1}Okullar arası turnuvayı kazanmak\Niçin topla arkadaş olmalısınız.{\i0}
Dialogue: 0,0:00:14.75,0:00:16.60,Default,,0,0,0,,{\i1}OkuOkula giderken de yemek yerken de...{\i0}
Dialogue: 0,0:00:16.76,0:00:19.76,Default,,0,0,0,,{\i1}...futbol topuyla birlikte olun hep.{\i0}
Dialogue: 0,0:00:21.41,0:00:23.64,Default,,0,0,0,,{\i1}Böylelikle Wakabayashi'ye karşı\Nkazanmak için...{\i0}
Dialogue: 0,0:00:23.92,0:00:26.87,Default,,0,0,0,,{\i1}...Tsubasa ve arkadaşları bugün de\Nsıkı bir pratik yapıyordu.{\i0}
Dialogue: 0,0:00:28.46,0:00:30.46,Default,,0,0,0,,Buraya! Buraya at!
Dialogue: 0,0:00:30.46,0:00:31.32,Default,,0,0,0,,Pas ver!
Dialogue: 0,0:00:31.48,0:00:32.81,Default,,0,0,0,,Pas versene!
Dialogue: 0,0:00:34.56,0:00:35.32,Default,,0,0,0,,Misaki!
Dialogue: 0,0:00:37.21,0:00:38.21,Default,,0,0,0,,Geçirmem!
Dialogue: 0,0:00:43.64,0:00:44.75,Default,,0,0,0,,Güzel Misagi!
Dialogue: 0,0:00:47.81,0:00:48.75,Default,,0,0,0,,Pekala.
Dialogue: 0,0:00:50.09,0:00:50.72,Default,,0,0,0,,Tarou!
Dialogue: 0,0:00:51.92,0:00:53.57,Default,,0,0,0,,Boyamayı bitirdim.
Dialogue: 0,0:00:54.15,0:00:55.42,Default,,0,0,0,,Gitme vakti geldi.
Dialogue: 0,0:00:57.21,0:00:58.64,Default,,0,0,0,,Gerçekten gidecek misin?
Dialogue: 0,0:00:59.03,0:01:01.35,Default,,0,0,0,,Geleli daha 1 ay olmuştu.
Dialogue: 0,0:01:01.57,0:01:04.87,Default,,0,0,0,,Okullar arası turnuvaya kadar\Nburada kalamaz mısın?
Dialogue: 0,0:01:05.35,0:01:08.35,Default,,0,0,0,,Sen olursan kazanırız eminim.
Dialogue: 0,0:01:08.79,0:01:11.64,Default,,0,0,0,,Elimden bir şey gelmiyor.\NBabamın işi böyle.
Dialogue: 0,0:01:11.79,0:01:12.84,Default,,0,0,0,,Hadi ama...
Dialogue: 0,0:01:13.23,0:01:13.95,Default,,0,0,0,,Tarou!
Dialogue: 0,0:01:16.07,0:01:17.87,Default,,0,0,0,,Öyleyse kendinize iyi bakın millet.
Dialogue: 0,0:01:19.95,0:01:21.65,Default,,0,0,0,,Sen de kendine iyi bak!
Dialogue: 0,0:01:21.95,0:01:23.01,Default,,0,0,0,,- Görüşürüz!\N- Ziyarete gel!
Dialogue: 0,0:01:24.07,0:01:25.64,Default,,0,0,0,,Misaki Tarou...
Dialogue: 0,0:01:25.92,0:01:27.43,Default,,0,0,0,,Zavallı çocuk.
Dialogue: 0,0:01:27.95,0:01:30.60,Default,,0,0,0,,Babası ülkeyi dolaşan bir ressam olduğundan...
Dialogue: 0,0:01:31.40,0:01:35.35,Default,,0,0,0,,...daha ilkokulda olmasına rağmen\N30'dan fazla okul değiştirdiğini söyledi.
Dialogue: 0,0:01:35.95,0:01:39.01,Default,,0,0,0,,Böyle giderse hiç yakın arkadaş edinemez.
Dialogue: 0,0:01:53.00,0:01:58.59,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:01:58.59,0:02:03.26,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:02:04.51,0:02:09.18,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:02:10.06,0:02:17.77,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:02:17.77,0:02:23.53,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:02:23.53,0:02:32.29,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:02:32.29,0:02:37.84,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:02:37.84,0:02:43.76,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:02:43.76,0:02:45.43,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:02:45.43,0:02:52.64,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:02:52.64,0:02:55.65,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:02:55.65,0:03:00.07,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:01:53.00,0:01:58.59,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:01:58.59,0:02:03.26,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:02:04.51,0:02:09.18,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:02:10.06,0:02:17.77,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:02:17.77,0:02:23.53,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:02:23.53,0:02:32.29,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:02:32.29,0:02:37.84,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:02:37.84,0:02:43.76,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:02:43.76,0:02:45.43,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:02:45.43,0:02:52.64,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo\N
Dialogue: 0,0:02:52.64,0:02:55.65,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:02:55.65,0:03:00.07,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:03:11.71,0:03:13.03,Default,,0,0,0,,{\pos(1552,928.999)}Sabahın Körü 5:17
Dialogue: 0,0:03:14.22,0:03:14.84,Default,,0,0,0,,Sen...
Dialogue: 0,0:03:17.15,0:03:20.22,Default,,0,0,0,,{\fs67.5\pos(1392,1035.501)}5. Bölüm: Okullar Arası Turnuva Yolu\NÇeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:03:20.68,0:03:21.87,Default,,0,0,0,,Hadi, hadi. Ne oldu?
Dialogue: 0,0:03:23.08,0:03:25.11,Default,,0,0,0,,Bu topu bile benden alamıyorsan...
Dialogue: 0,0:03:25.43,0:03:27.56,Default,,0,0,0,,...turnuvada Shutetsu'ya karşı\Nhiç kazanamazsın.
Dialogue: 0,0:03:33.43,0:03:34.52,Default,,0,0,0,,Ne oldu? Ne oldu?
Dialogue: 0,0:03:36.15,0:03:38.36,Default,,0,0,0,,- Hadi. Bir daha.\N- Tamam!
Dialogue: 0,0:03:47.63,0:03:49.94,Default,,0,0,0,,# Ozora #
Dialogue: 0,0:03:51.56,0:03:53.56,Default,,0,0,0,,Anne! Ben geldim!
Dialogue: 0,0:03:54.22,0:03:56.84,Default,,0,0,0,,Hoş geldin. Kahvaltı hazır.
Dialogue: 0,0:03:57.00,0:03:57.59,Default,,0,0,0,,Tamam.
Dialogue: 0,0:03:59.63,0:04:00.80,Default,,0,0,0,,Günaydın.
Dialogue: 0,0:04:00.94,0:04:02.22,Default,,0,0,0,,Günaydın Roberto.
Dialogue: 0,0:04:02.71,0:04:06.19,Default,,0,0,0,,Sabahın köründe onunla\Nuğraşman gerektiği için kusura bakma.
Dialogue: 0,0:04:06.52,0:04:07.03,Default,,0,0,0,,Sorun değil.
Dialogue: 0,0:04:07.80,0:04:09.71,Default,,0,0,0,,Gerçekten de konu futbol olunca...
Dialogue: 0,0:04:09.87,0:04:11.71,Default,,0,0,0,,...gözü başka hiçbir şey görmüyor.
Dialogue: 0,0:04:12.11,0:04:13.75,Default,,0,0,0,,Ona imkansız demesi de imkansız.
Dialogue: 0,0:04:14.15,0:04:14.87,Default,,0,0,0,,Hayır.
Dialogue: 0,0:04:15.19,0:04:18.39,Default,,0,0,0,,Aslında sabah antrenmanlarını\Nöneren bendim.
Dialogue: 0,0:04:19.60,0:04:20.68,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:04:21.11,0:04:22.47,Default,,0,0,0,,Öyleyse sorun yok ama...
Dialogue: 0,0:04:24.00,0:04:26.00,Default,,0,0,0,,Gözlerim konusunda\Nendişelenmeniz gerekmiyor.
Dialogue: 0,0:04:26.00,0:04:27.07,Default,,0,0,0,,Ne?
Dialogue: 0,0:04:27.07,0:04:29.51,Default,,0,0,0,,Tıbbi raporumu gördünüz değil mi?
Dialogue: 0,0:04:30.75,0:04:33.83,Default,,0,0,0,,Özür dilerim. Kendime engel olamadım.
Dialogue: 0,0:04:34.27,0:04:35.87,Default,,0,0,0,,# Tıbbı Tanı Raporu\NBay Roberto Hongo'ya #
Dialogue: 0,0:04:39.07,0:04:41.23,Default,,0,0,0,,Japonya'ya gelmemin asıl sebebi...
Dialogue: 0,0:04:41.68,0:04:45.80,Default,,0,0,0,,...Kaptan Ozora'nın bana tavsiye\Nettiği bir göz uzmanının bulunmasıydı.
Dialogue: 0,0:04:46.92,0:04:48.80,Default,,0,0,0,,Sonuçları biliyorsun.
Dialogue: 0,0:04:49.23,0:04:51.23,Default,,0,0,0,,Bir daha futbol sahasına çıkamayacağım.
Dialogue: 0,0:04:53.07,0:04:55.92,Default,,0,0,0,,Brezilya'yı emekliye ayrılma\Nniyetimden haberdar ettim.
Dialogue: 0,0:04:57.23,0:05:00.23,Default,,0,0,0,,Ama sadece koç olmak konusunda\Nhiçbir çekincem yok.
Dialogue: 0,0:05:01.27,0:05:04.72,Default,,0,0,0,,Ayrıca şu an Tsubasa'ya bir şeyler\Nöğretmek çok keyif veriyor.
Dialogue: 0,0:05:05.39,0:05:08.36,Default,,0,0,0,,Tsubasa gerçekten dikkate değer.
Dialogue: 0,0:05:09.07,0:05:11.16,Default,,0,0,0,,Ne kadar öğretirsem o kadar iyiye gidiyor.
Dialogue: 0,0:05:11.60,0:05:15.07,Default,,0,0,0,,Onu eğitmeye devam edersem\Ngözlerimi unuturum bile.
Dialogue: 0,0:05:16.16,0:05:17.23,Default,,0,0,0,,Roberto...
Dialogue: 0,0:05:18.68,0:05:20.56,Default,,0,0,0,,Kendime çok yükleniyor değilim.
Dialogue: 0,0:05:23.60,0:05:25.04,Default,,0,0,0,,Ben gidiyorum!
Dialogue: 0,0:05:33.92,0:05:35.11,Default,,0,0,0,,Özür dilerim.
Dialogue: 0,0:05:44.27,0:05:46.51,Default,,0,0,0,,O taraftan değil be!
Dialogue: 0,0:05:47.04,0:05:48.72,Default,,0,0,0,,Haberler büyük! Haberler büyük!
Dialogue: 0,0:05:49.31,0:05:52.72,Default,,0,0,0,,Hemen herkese söylemeliyim!
Dialogue: 0,0:06:01.27,0:06:02.00,Default,,0,0,0,,Pekala.
Dialogue: 0,0:06:27.39,0:06:29.00,Default,,0,0,0,,Of...
Dialogue: 0,0:06:33.36,0:06:36.00,Default,,0,0,0,,Öyleyse ilk derse başlıyoruz.
Dialogue: 0,0:06:36.92,0:06:38.68,Default,,0,0,0,,Önceki dersimizde...
Dialogue: 0,0:06:38.83,0:06:40.94,Default,,0,0,0,,...herkes kütüphaneden\Nsevdiği bir kitabı seçmişti.
Dialogue: 0,0:06:41.72,0:06:43.04,Default,,0,0,0,,Ne var ki bazılarınız...
Dialogue: 0,0:06:43.87,0:06:46.31,Default,,0,0,0,,{\i1}Manabu'nun geç kalacağı belliydi.{\i0}
Dialogue: 0,0:06:46.47,0:06:48.87,Default,,0,0,0,,{\i1}Top sürmekte berbat.{\i0}
Dialogue: 0,0:06:50.83,0:06:53.31,Default,,0,0,0,,Ishizaki-kun! Tsubasa-kun!\NÖnemli haberlerim var!
Dialogue: 0,0:06:59.75,0:07:01.60,Default,,0,0,0,,Of şu çocuk...
Dialogue: 0,0:07:04.60,0:07:06.72,Default,,0,0,0,,Shutetsu İlkokulu antrenman\Nmaçı mı yapacakmış?!
Dialogue: 0,0:07:06.87,0:07:08.11,Default,,0,0,0,,Kesinlikle.
Dialogue: 0,0:07:08.56,0:07:12.27,Default,,0,0,0,,Dün eve dönerken Mizukoshi\Nİlkokulu'nun oradan gittim.
Dialogue: 0,0:07:12.83,0:07:16.16,Default,,0,0,0,,Mizukoshi İlkokulu'nun futbol\Nkulübündekiler konuşurken duydum.
Dialogue: 0,0:07:16.56,0:07:19.68,Default,,0,0,0,,Bugün okuldan sonra\NShutetsu ile antrenman maçı yapacaklarmış.
Dialogue: 0,0:07:20.75,0:07:23.54,Default,,0,0,0,,Yani ta Mizukoshi İlkokulu'nun\Noraya kadar gittin mi?
Dialogue: 0,0:07:23.54,0:07:25.23,Default,,0,0,0,,Şehrin öteki tarafında orası.
Dialogue: 0,0:07:25.56,0:07:26.92,Default,,0,0,0,,Elimden bir şey gelmiyordu ki.
Dialogue: 0,0:07:27.31,0:07:29.92,Default,,0,0,0,,Top dediklerimi hiç dinlemiyordu.
Dialogue: 0,0:07:30.51,0:07:34.27,Default,,0,0,0,,Ama bu sayede antrenman\Nmaçı olduğunu öğrenebildim işte.
Dialogue: 0,0:07:35.63,0:07:37.23,Default,,0,0,0,,Gidip izleyelim Tsubasa.
Dialogue: 0,0:07:37.39,0:07:40.19,Default,,0,0,0,,Okullar arası turnuva yaklaştığı\Niçin güzel olmaz mı?
Dialogue: 0,0:07:40.51,0:07:41.16,Default,,0,0,0,,Evet.
Dialogue: 0,0:07:41.60,0:07:45.31,Default,,0,0,0,,{\pos(964,929)}# Özel Shutetsu İlkokulu #
Dialogue: 0,0:07:45.47,0:07:47.80,Default,,0,0,0,,{\pos(956,937)}# Shutetsu Futbol Sahası #
Dialogue: 0,0:07:50.04,0:07:52.11,Default,,0,0,0,,Demek Shutetsu'nun sahası bu.
Dialogue: 0,0:07:58.19,0:08:02.00,Default,,0,0,0,,Bu beklenirdi zaten.\NŞu sahanın güzelliğine bakın.
Dialogue: 0,0:08:02.60,0:08:04.43,Default,,0,0,0,,- Hadi!\N- Bastırın!
Dialogue: 0,0:08:04.87,0:08:06.31,Default,,0,0,0,,Hadi Kurata!
Dialogue: 0,0:08:09.04,0:08:10.43,Default,,0,0,0,,Başlamışlar bile.
Dialogue: 0,0:08:11.36,0:08:14.00,Default,,0,0,0,,Ne? Kaleci Wakabayashi-kun değil mi?
Dialogue: 0,0:08:14.16,0:08:14.83,Default,,0,0,0,,Ne?
Dialogue: 0,0:08:15.80,0:08:16.72,Default,,0,0,0,,Gerçekten de öyle.
Dialogue: 0,0:08:17.68,0:08:20.39,Default,,0,0,0,,Wakabayashi bu maçta oynamayacak.
Dialogue: 0,0:08:21.72,0:08:22.63,Default,,0,0,0,,Urabe!
Dialogue: 0,0:08:22.80,0:08:25.60,Default,,0,0,0,,Anlıyorum. Nishigaoka İlkokulu da\Nmaçı izlemeye gelmiş.
Dialogue: 0,0:08:25.87,0:08:28.27,Default,,0,0,0,,Neden Wakabayashi'nin\Noynamayacağını biliyor musun?
Dialogue: 0,0:08:29.68,0:08:33.72,Default,,0,0,0,,Okula bile gelmeyip her gün evde\Nsıkı bir antrenman yaptığını duydum.
Dialogue: 0,0:08:33.87,0:08:34.75,Default,,0,0,0,,Sıkı antrenman mı?!
Dialogue: 0,0:08:35.15,0:08:38.67,Default,,0,0,0,,Sizden gol yemek çok koymuş anlaşılan.
Dialogue: 0,0:08:39.63,0:08:44.15,Default,,0,0,0,,Gerçi Wakabayashi olmasa bile\NMizukoshi gibi ezikleri kolayca yeneceklerdir.
Dialogue: 0,0:08:46.60,0:08:49.00,Default,,0,0,0,,Daha ilk yarı olmasına rağmen\Nskor 3-0 olmuş!
Dialogue: 0,0:08:49.51,0:08:52.08,Default,,0,0,0,,Mizukoshi bu kadar güçsüz\Nbir takım değildi.
Dialogue: 0,0:08:52.36,0:08:55.32,Default,,0,0,0,,Shutetsu cidden acayip güçlü ya.
Dialogue: 0,0:08:55.63,0:08:57.60,Default,,0,0,0,,Hadi Mizukoshi İlkokulu!
Dialogue: 0,0:08:57.95,0:08:59.55,Default,,0,0,0,,Elinizden geleni yapın!
Dialogue: 0,0:09:04.75,0:09:05.55,Default,,0,0,0,,İşte bu, aldı!
Dialogue: 0,0:09:05.72,0:09:07.95,Default,,0,0,0,,Önü açık! Yardır oradan!
Dialogue: 0,0:09:09.95,0:09:10.75,Default,,0,0,0,,{\i1}Aldım!{\i0}
Dialogue: 0,0:09:22.03,0:09:23.27,Default,,0,0,0,,{\pos(464,977)}Takasugi Shingo.
Dialogue: 0,0:09:23.79,0:09:27.55,Default,,0,0,0,,{\pos(464,977)}Wakabayashi ile birlikte\NShutetsu kalesini\Nkoruyan ana defans.
Dialogue: 0,0:09:29.75,0:09:31.55,Default,,0,0,0,,Uzun pas geliyor!
Dialogue: 0,0:09:32.03,0:09:33.15,Default,,0,0,0,,Güzel pas!
Dialogue: 0,0:09:35.27,0:09:39.47,Default,,0,0,0,,Oyun yapıcı. Orta saha Izawa Mamoru.
Dialogue: 0,0:09:40.15,0:09:40.91,Default,,0,0,0,,Geri alacağım!
Dialogue: 0,0:09:45.39,0:09:46.75,Default,,0,0,0,,Koş Taki!
Dialogue: 0,0:09:50.00,0:09:53.95,Default,,0,0,0,,{\pos(1420,977)}Kanattan koşan kişi\NShutetsu'nun forveti Taki Hajime.
Dialogue: 0,0:09:58.27,0:10:00.00,Default,,0,0,0,,Kisugi, sana bırakıyorum!
Dialogue: 0,0:10:00.60,0:10:02.20,Default,,0,0,0,,Pekala, bana bırak!
Dialogue: 0,0:10:04.87,0:10:09.20,Default,,0,0,0,,Ve o da ana forvet, Kisugi Teppei.
Dialogue: 0,0:10:12.36,0:10:13.42,Default,,0,0,0,,# Shutetsu: 4\NMizukoshi: 0 #
Dialogue: 0,0:10:14.00,0:10:16.42,Default,,0,0,0,,Onlara Shutetsu Dörtlüsü diyorlar!
Dialogue: 0,0:10:16.75,0:10:18.42,Default - Copy,,0,0,0,,{\pos(952,1053)}Shutetsu Dörtlüsü
Dialogue: 0,0:10:18.60,0:10:22.67,Default,,0,0,0,,Shutetsu'nun ulusalları kazanması\Nsadece Wakabayashi sayesinde olmadı.
Dialogue: 0,0:10:23.00,0:10:24.47,Default,,0,0,0,,Onlar da vardı.
Dialogue: 0,0:10:25.11,0:10:28.51,Default,,0,0,0,,Lanet olsun! Shutetsu bu sene de çok güçlü!
Dialogue: 0,0:10:28.67,0:10:30.39,Default,,0,0,0,,Göz açıp kapayıncaya dek\N4 gol attılar.
Dialogue: 0,0:10:30.75,0:10:32.95,Default,,0,0,0,,Onlara karşı kazanmak imkansız.
Dialogue: 0,0:10:33.47,0:10:37.11,Default,,0,0,0,,Shutetsu İlkokulu harika!\NYenmeye değecekler!
Dialogue: 0,0:10:37.11,0:10:38.67,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:38.67,0:10:39.87,Default,,0,0,0,,Tsubasa?!
Dialogue: 0,0:10:46.52,0:10:51.14,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:11:13.08,0:11:13.63,Default,,0,0,0,,Sıradaki!
Dialogue: 0,0:11:17.39,0:11:18.03,Default,,0,0,0,,Sıradaki!
Dialogue: 0,0:11:19.79,0:11:20.42,Default,,0,0,0,,Sıradaki!
Dialogue: 0,0:11:22.42,0:11:24.39,Default,,0,0,0,,Sıradaki! Böyle devam edin!
Dialogue: 0,0:11:29.36,0:11:30.42,Default,,0,0,0,,Yavaşsın, yavaş!
Dialogue: 0,0:11:37.32,0:11:38.00,Default,,0,0,0,,Gelin!
Dialogue: 0,0:11:46.87,0:11:49.95,Default,,0,0,0,,{\i1}Tsubasa onların yenmeye değer\Nolduğunu söyledi.{\i0}
Dialogue: 0,0:11:50.32,0:11:52.23,Default,,0,0,0,,{\i1}Onları yensek mutlu olurdum ama...{\i0}
Dialogue: 0,0:11:52.51,0:11:54.47,Default,,0,0,0,,{\i1}...bize de öyle baskı kurarlarsa...{\i0}
Dialogue: 0,0:12:01.63,0:12:02.87,Default,,0,0,0,,{\i1}Koş Taki!{\i0}
Dialogue: 0,0:12:03.51,0:12:05.08,Default,,0,0,0,,{\i1}Kisugi, sana bırakıyorum!{\i0}
Dialogue: 0,0:12:10.32,0:12:13.84,Default,,0,0,0,,{\i1}Hem Wakabayashi de hala\Nbir çeşit antrenman yapıyormuş.{\i0}
Dialogue: 0,0:12:14.87,0:12:15.55,Default,,0,0,0,,{\i1}Ama...{\i0}
Dialogue: 0,0:12:16.60,0:12:17.55,Default,,0,0,0,,{\i1}Ona meydan okuyacağım!{\i0}
Dialogue: 0,0:12:27.36,0:12:28.32,Default,,0,0,0,,{\i1}Daha değil!{\i0}
Dialogue: 0,0:12:35.42,0:12:37.11,Default,,0,0,0,,{\i1}Git!{\i0}
Dialogue: 0,0:12:40.08,0:12:41.84,Default,,0,0,0,,{\i1}Bizim de sıkı çalışmamız gerek.{\i0}
Dialogue: 0,0:12:42.32,0:12:45.84,Default,,0,0,0,,{\i1}Burada vazgeçersek eski\Nhallerimize geri dönmüş olacağız.{\i0}
Dialogue: 0,0:12:46.23,0:12:47.11,Default,,0,0,0,,{\i1}Pekala...{\i0}
Dialogue: 0,0:12:57.60,0:12:59.67,Default,,0,0,0,,Hadi, hadi! Ne oldu? Ne oldu?
Dialogue: 0,0:13:02.75,0:13:04.36,Default,,0,0,0,,Oldukça iyisin.
Dialogue: 0,0:13:05.39,0:13:06.11,Default,,0,0,0,,Hadi, hadi.
Dialogue: 0,0:13:10.03,0:13:10.79,Default,,0,0,0,,Başardım!
Dialogue: 0,0:13:13.47,0:13:13.95,Default,,0,0,0,,Nasıldı?
Dialogue: 0,0:13:14.55,0:13:17.32,Default,,0,0,0,,Oldukça iyi kararlar verdin Tsubasa.
Dialogue: 0,0:13:17.91,0:13:21.72,Default,,0,0,0,,Pekala, şimdi farklı falsolu\Nvuruş çalışması yapalım.
Dialogue: 0,0:13:21.87,0:13:23.42,Default,,0,0,0,,Tsubasa! Koç!
Dialogue: 0,0:13:27.11,0:13:30.15,Default,,0,0,0,,Bu hiç adil Koç!\NSadece Tsubasa'yı eğitiyorsun!
Dialogue: 0,0:13:30.51,0:13:32.60,Default,,0,0,0,,Dün çok mızmızlandık ama...
Dialogue: 0,0:13:32.75,0:13:35.87,Default,,0,0,0,,...biz de Shutetsu'ya karşı\Nkazanmayı çok istiyoruz!
Dialogue: 0,0:13:36.03,0:13:37.39,Default,,0,0,0,,Bizi de eğit!
Dialogue: 0,0:13:37.87,0:13:39.36,Default,,0,0,0,,Biz de her gün geleceğiz!
Dialogue: 0,0:13:39.67,0:13:40.42,Default,,0,0,0,,Millet...
Dialogue: 0,0:13:42.67,0:13:43.39,Default,,0,0,0,,Pekala!
Dialogue: 0,0:13:43.84,0:13:45.11,Default,,0,0,0,,Herkes yerini alsın.
Dialogue: 0,0:13:46.11,0:13:47.88,Default,,0,0,0,,Turnuvaya kadar özel\Nantrenman yapacaksınız.
Dialogue: 0,0:13:47.91,0:13:49.51,Default,,0,0,0,,Tamam!
Dialogue: 0,0:13:56.75,0:13:57.47,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:59.15,0:14:03.70,Default,,0,0,0,,Bacağına çok güç veriyorsun.\NSadece vuracağın zaman güç ver.
Dialogue: 0,0:14:03.75,0:14:04.39,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:05.15,0:14:06.34,Default,,0,0,0,,Tamam...
Dialogue: 0,0:14:08.23,0:14:08.91,Default,,0,0,0,,Aldım.
Dialogue: 0,0:14:10.11,0:14:12.63,Default,,0,0,0,,Topu aldıktan sonra\Ndüşünürsen geç kalırsın Oda!
Dialogue: 0,0:14:12.87,0:14:13.36,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:14.15,0:14:18.63,Default,,0,0,0,,Ayağını sıkıca yerleştir,\Nsonra döndürürken ileri doğru da it.
Dialogue: 0,0:14:20.20,0:14:22.55,Default,,0,0,0,,Sıkıca yerleştir, döndürerek it.
Dialogue: 0,0:14:23.36,0:14:26.03,Default,,0,0,0,,Ellerinle yaptığının aynısı. Dene bir.
Dialogue: 0,0:14:26.20,0:14:27.15,Default,,0,0,0,,Tamam.
Dialogue: 0,0:14:27.32,0:14:31.00,Default,,0,0,0,,Sıkıca yerleştir, kaşıklarmış gibi...
Dialogue: 0,0:14:33.39,0:14:35.79,Default,,0,0,0,,Pes etmeden denemeye devam et.
Dialogue: 0,0:14:36.20,0:14:36.79,Default,,0,0,0,,Tamam.
Dialogue: 0,0:14:39.60,0:14:40.47,Default,,0,0,0,,Iwami!
Dialogue: 0,0:14:42.15,0:14:43.36,Default,,0,0,0,,Daha çok etrafına bak!
Dialogue: 0,0:14:48.11,0:14:49.63,Default,,0,0,0,,- Daha hızlı!\N- Tamam!
Dialogue: 0,0:14:50.36,0:14:50.87,Default,,0,0,0,,Sıradaki!
Dialogue: 0,0:14:54.79,0:14:55.42,Default,,0,0,0,,Sıradaki!
Dialogue: 0,0:15:11.36,0:15:14.32,Default,,0,0,0,,Sıkıca yerleştir, kaşıklarmış gibi...
Dialogue: 0,0:15:15.87,0:15:16.72,Default,,0,0,0,,Anladım!
Dialogue: 0,0:15:25.63,0:15:26.39,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:49.95,0:15:51.23,Default,,0,0,0,,Büyük gün yarın.
Dialogue: 0,0:15:54.60,0:15:55.91,Default,,0,0,0,,Harika hissettiriyor!
Dialogue: 0,0:16:02.87,0:16:03.42,Default,,0,0,0,,Pekala.
Dialogue: 0,0:16:03.84,0:16:05.11,Default,,0,0,0,,Sıkıca yerleştir...
Dialogue: 0,0:16:05.75,0:16:07.72,Default,,0,0,0,,...ve ellerinle kaldırır gibi...
Dialogue: 0,0:16:16.15,0:16:17.79,Default,,0,0,0,,Başardım!
Dialogue: 0,0:16:21.79,0:16:22.67,Default,,0,0,0,,Günaydın!
Dialogue: 0,0:16:25.51,0:16:27.36,Default,,0,0,0,,Manabu bile gecikmiyor artık.
Dialogue: 0,0:16:27.67,0:16:30.03,Default,,0,0,0,,Herkes rahatça yetişiyor artık.
Dialogue: 0,0:16:30.42,0:16:33.95,Default,,0,0,0,,Koçun yaptırdığı pratikler sayesinde.
Dialogue: 0,0:16:34.39,0:16:36.42,Default,,0,0,0,,Yarın kesinlikle kazanalım.
Dialogue: 0,0:16:36.84,0:16:39.23,Default,,0,0,0,,Futbol kulübündekiler çok gaza gelmiş.
Dialogue: 0,0:16:39.47,0:16:41.91,Default,,0,0,0,,Hep denemeden vazgeçerlerdi.
Dialogue: 0,0:16:42.08,0:16:44.63,Default,,0,0,0,,Bu sene kazanacaklarını söylüyorlar.
Dialogue: 0,0:16:45.00,0:16:47.87,Default,,0,0,0,,Topu göremeyecekleri vakte\Nkadar antrenman yaptıklarını duydum.
Dialogue: 0,0:16:49.47,0:16:52.55,Default,,0,0,0,,Yine de okula gelirken\Ntop sürmek ne işe yarayacak ki?
Dialogue: 0,0:16:52.95,0:16:54.39,Default,,0,0,0,,Anca şov yapıyorlar.
Dialogue: 0,0:16:54.55,0:16:55.47,Default,,0,0,0,,- Lan!\N- Acıdı!
Dialogue: 0,0:16:56.23,0:16:59.08,Default,,0,0,0,,Futbol kulübüyle dalga geçeni affetmem!
Dialogue: 0,0:16:59.27,0:17:00.95,Default,,0,0,0,,Amigo takımının Anego'su!
Dialogue: 0,0:17:05.64,0:17:07.95,Default,,0,0,0,,Bugün de çok havalı!
Dialogue: 0,0:17:10.47,0:17:13.83,Default,,0,0,0,,Yarın okullar arası turnuva günü!\NSonuna kadar antrenman yapacağız!
Dialogue: 0,0:17:14.00,0:17:15.00,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:15.55,0:17:17.35,Default,,0,0,0,,Tüm gücünüzle millet!
Dialogue: 0,0:17:17.55,0:17:19.86,Default,,0,0,0,,O berbat futbol kulübü bile\Ngaza gelmiş durumda!
Dialogue: 0,0:17:20.03,0:17:22.40,Default,,0,0,0,,Bu sene ne pahasına olursa olsun kazanacağız!
Dialogue: 0,0:17:22.92,0:17:24.00,Default,,0,0,0,,Müdürüm.
Dialogue: 0,0:17:24.43,0:17:27.00,Default,,0,0,0,,Öğrenciler hiç olmadığı kadar hevesli.
Dialogue: 0,0:17:28.68,0:17:29.68,Default,,0,0,0,,Hora!
Dialogue: 0,0:17:29.83,0:17:32.92,Default,,0,0,0,,{\i1}Nankatsu amigo takımı bile\Nhoralamayı kesmiyor.{\i0}
Dialogue: 0,0:17:33.07,0:17:34.51,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:34.68,0:17:35.47,Default,,0,0,0,,Ne?!
Dialogue: 0,0:17:35.92,0:17:38.72,Default,,0,0,0,,Anego, yetti artık şu Tsubasa!
Dialogue: 0,0:17:38.92,0:17:41.16,Default,,0,0,0,,Diğer kulüplere de tezahürat yapmalıyız.
Dialogue: 0,0:17:41.59,0:17:42.68,Default,,0,0,0,,Kes be!
Dialogue: 0,0:17:42.92,0:17:44.64,Default,,0,0,0,,Amigo takımı kaptanına karşı mı geliyorsunuz?!
Dialogue: 0,0:17:45.07,0:17:46.00,Default,,0,0,0,,İşe yaramayacak.
Dialogue: 0,0:17:46.27,0:17:47.95,Default,,0,0,0,,Siz de yapın.
Dialogue: 0,0:17:48.83,0:17:49.75,Default,,0,0,0,,Çabuk!
Dialogue: 0,0:17:50.10,0:17:53.86,Default,,0,0,0,,Hora! Hora! Tsubasa!
Dialogue: 0,0:17:54.03,0:17:55.27,Default,,0,0,0,,Daha yüksek sesle!
Dialogue: 0,0:17:55.43,0:17:59.16,Default,,0,0,0,,Hora! Hora! Tsubasa!
Dialogue: 0,0:18:05.23,0:18:07.51,Default,,0,0,0,,Ne? Tsubasa kaleci mi olacak?
Dialogue: 0,0:18:08.07,0:18:09.23,Default,,0,0,0,,Dinle Tsubasa.
Dialogue: 0,0:18:09.68,0:18:12.31,Default,,0,0,0,,Bu okullar arası turnuva\Nöncesi son dersim.
Dialogue: 0,0:18:13.43,0:18:14.47,Default,,0,0,0,,Geliyorum Tsubasa!
Dialogue: 0,0:18:16.75,0:18:17.95,Default,,0,0,0,,Koç mu vuracak?
Dialogue: 0,0:18:24.72,0:18:25.83,Default,,0,0,0,,Çok hızlı.
Dialogue: 0,0:18:26.03,0:18:28.00,Default,,0,0,0,,Bunu durdurması imkansız ki...
Dialogue: 0,0:18:28.27,0:18:31.31,Default,,0,0,0,,Ne oldu Tsubasa?\NEn azından tepki vermeyi dene.
Dialogue: 0,0:18:33.07,0:18:33.75,Default,,0,0,0,,Bir daha!
Dialogue: 0,0:18:37.00,0:18:37.75,Default,,0,0,0,,Bir daha!
Dialogue: 0,0:18:39.40,0:18:42.40,Default,,0,0,0,,Tsubasa topa dokunamıyor bile.
Dialogue: 0,0:18:42.95,0:18:46.07,Default,,0,0,0,,Harika birisi tarafından eğitiliyoruz.
Dialogue: 0,0:18:46.68,0:18:47.47,Default,,0,0,0,,{\i1}İnanılmaz.{\i0}
Dialogue: 0,0:18:47.83,0:18:50.64,Default,,0,0,0,,{\i1}Bunlar gerçek bir profesyonelin şutları.{\i0}
Dialogue: 0,0:18:59.07,0:19:02.31,Default,,0,0,0,,Gerçekten de o şutları durdurması imkansız.
Dialogue: 0,0:19:04.95,0:19:05.75,Default,,0,0,0,,{\i1}Anladım.{\i0}
Dialogue: 0,0:19:06.35,0:19:07.92,Default,,0,0,0,,{\i1}Bu antrenmanın amacını anladım.{\i0}
Dialogue: 0,0:19:09.75,0:19:10.72,Default,,0,0,0,,Bir daha ister misin?
Dialogue: 0,0:19:12.72,0:19:13.31,Default,,0,0,0,,Olur!
Dialogue: 0,0:19:15.00,0:19:17.31,Default,,0,0,0,,{\b1}# 26. Shutetsu İlkokulu- Nankatsu İlkokulu\NOkullar Arası Turnuvası #{\b0}
Dialogue: 0,0:19:17.35,0:19:19.40,Default,,0,0,0,,Çok teşekkür ederiz!
Dialogue: 0,0:19:22.40,0:19:24.43,Default,,0,0,0,,Kaptan bugün de yok.
Dialogue: 0,0:19:24.68,0:19:26.92,Default,,0,0,0,,İyi mi acaba? Maç yarın.
Dialogue: 0,0:19:27.35,0:19:31.68,Default,,0,0,0,,Ne oldu? 30-0 yendiğimiz\NNankatsu'ya karşı olacağız.
Dialogue: 0,0:19:32.07,0:19:35.07,Default,,0,0,0,,Kaptan'a gol atan\NOzora Tsubasa olsa bile...
Dialogue: 0,0:19:35.23,0:19:37.00,Default,,0,0,0,,...tek kişiyi tuttuğumuz zaman maçı alırız.
Dialogue: 0,0:19:37.20,0:19:39.55,Default,,0,0,0,,Bence de öyle, sonra da kazanacağız işte.
Dialogue: 0,0:19:41.95,0:19:43.86,Default,,0,0,0,,Pekala, herkesin ellerine sağlık.
Dialogue: 0,0:19:44.20,0:19:45.79,Default,,0,0,0,,Yarın büyük gün.
Dialogue: 0,0:19:46.47,0:19:48.03,Default,,0,0,0,,Çok çaba sarf ettiniz.
Dialogue: 0,0:19:48.43,0:19:50.07,Default,,0,0,0,,Bugün eve gidip dinlenin.
Dialogue: 0,0:19:50.23,0:19:51.07,Default,,0,0,0,,Tamam!
Dialogue: 0,0:19:53.20,0:19:55.55,Default,,0,0,0,,- Yarın için sabırsızlanıyorum.\N- Aynen.
Dialogue: 0,0:19:55.95,0:19:57.79,Default,,0,0,0,,Gidip kroket yiyelim.
Dialogue: 0,0:19:57.95,0:19:58.75,Default,,0,0,0,,Güzel olur ha.
Dialogue: 0,0:19:59.16,0:20:01.68,Default,,0,0,0,,Bugün ayağımın dışıyla vurmayı başardım.
Dialogue: 0,0:20:01.83,0:20:02.59,Default,,0,0,0,,Harika!
Dialogue: 0,0:20:04.00,0:20:06.16,Default,,0,0,0,,{\i1}Buraya kadar gelmeyi başardık.{\i0}
Dialogue: 0,0:20:07.07,0:20:10.31,Default,,0,0,0,,{\i1}Hepsi Tsubasa sayesinde.{\i0}
Dialogue: 0,0:20:14.16,0:20:15.92,Default,,0,0,0,,Anlamış gibi görünüyorsun.
Dialogue: 0,0:20:16.20,0:20:16.86,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:17.03,0:20:19.68,Default,,0,0,0,,Neden seni kaleci yaptığımı.
Dialogue: 0,0:20:19.86,0:20:20.83,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:21.75,0:20:25.23,Default,,0,0,0,,Hangi şutların kaleci tarafından\Ntutulmasının zor olduğunu öğrendim.
Dialogue: 0,0:20:25.79,0:20:30.10,Default,,0,0,0,,Kaleci için bazı şutlar\Ndiğerlerine göre daha zor görülür.
Dialogue: 0,0:20:30.75,0:20:33.10,Default,,0,0,0,,Gerçi hiçbirini tutamadım ben.
Dialogue: 0,0:20:35.07,0:20:35.79,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:20:36.23,0:20:40.00,Default,,0,0,0,,İyi anlamışsın ama futbolun\Nözü gol atmaktır.
Dialogue: 0,0:20:40.51,0:20:43.23,Default,,0,0,0,,Yarın da o golü atacak kişi...
Dialogue: 0,0:20:43.83,0:20:45.64,Default,,0,0,0,,...sen olacaksın Tsubasa.
Dialogue: 0,0:20:45.92,0:20:48.40,Default,,0,0,0,,Evet, yarın kesinlikle atacağım.
Dialogue: 0,0:20:48.79,0:20:49.92,Default,,0,0,0,,Harika.
Dialogue: 0,0:20:50.40,0:20:53.55,Default,,0,0,0,,Antrenmanlarının sonucunu\NWakabayashi'ye göster.
Dialogue: 0,0:20:53.83,0:20:54.47,Default,,0,0,0,,Tamam!
Dialogue: 0,0:20:55.03,0:20:57.64,Default,,0,0,0,,Pekala... Yarın kazanacağız!
Dialogue: 0,0:21:29.47,0:21:31.31,Default,,0,0,0,,{\i1}O çocuk da kim?{\i0}
Dialogue: 0,0:21:32.83,0:21:34.79,Default,,0,0,0,,Çok iyi top sürüyor.
Dialogue: 0,0:21:40.51,0:21:41.68,Default,,0,0,0,,Bir kez daha!
Dialogue: 0,0:21:41.95,0:21:43.10,Default,,0,0,0,,Geliyor Genzo!
Dialogue: 0,0:21:47.64,0:21:51.27,Default,,0,0,0,,Genzo, antrenmanlarının sonucunu göster bana!
Dialogue: 0,0:22:03.59,0:22:04.95,Default,,0,0,0,,İşte bu, harika!
Dialogue: 0,0:22:06.27,0:22:07.47,Default,,0,0,0,,İnanamıyorum.
