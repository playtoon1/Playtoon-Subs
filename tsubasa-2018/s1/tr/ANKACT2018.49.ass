Dialogue: 0,0:01:30.07,0:01:34.57,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}49. BÖLÜM: \NKAPLAN VE TSUBASA'NIN ATEŞLİ RUHU
Dialogue: 0,0:01:29.98,0:01:32.40,Default-TOP,,0,0,0,,Bir ağrı kesici enjeksiyonu daha mı?!
Dialogue: 0,0:01:29.98,0:01:32.40,Default-TOP,,0,0,0,,REVİR
Dialogue: 0,0:01:32.40,0:01:33.90,Default-TOP,,0,0,0,,Aptalsın!
Dialogue: 0,0:01:34.69,0:01:37.05,Default,,0,0,0,,Doktor, lütfen, yalvarıyorum!
Dialogue: 0,0:01:37.05,0:01:39.41,Default,,0,0,0,,Bu durumda, Nankatsu kaybedecek.
Dialogue: 0,0:01:39.41,0:01:41.49,Default,,0,0,0,,Neden bu kadar inatçı olmaya devam ediyorsun?
Dialogue: 0,0:01:41.49,0:01:43.33,Default,,0,0,0,,Şimdiye kadar yeterince şey yaptın, değil mi?
Dialogue: 0,0:01:43.33,0:01:46.76,Default,,0,0,0,,İkinci sırada, sonuçta oldukça iyi bir sonuç.
Dialogue: 0,0:01:46.76,0:01:49.33,Default,,0,0,0,,Durup gelecekteki futbol kariyerini düşünürsen,
Dialogue: 0,0:01:49.33,0:01:52.65,Default,,0,0,0,,bir ortaokul turnuvası oldukça önemsizdir.
Dialogue: 0,0:01:52.65,0:01:55.11,Default,,0,0,0,,Kendini bu maçta çok zorlarsan,
Dialogue: 0,0:01:55.11,0:01:57.59,Default,,0,0,0,,ve tekrar futbol oynayamazsan...
Dialogue: 0,0:01:57.59,0:01:59.85,Default,,0,0,0,,Daha sonra pişman olmaz mısın?
Dialogue: 0,0:02:01.12,0:02:02.11,Default,,0,0,0,,Hayal...
Dialogue: 0,0:02:03.01,0:02:03.97,Default,,0,0,0,,Bu benim hayalim.
Dialogue: 0,0:02:04.98,0:02:08.77,Default,,0,0,0,,Sizin için önemsiz görünebilir, ama bu benim hayalim.
Dialogue: 0,0:02:08.77,0:02:11.50,Default,,0,0,0,,Nankatsu'daki arkadaşlarımla bu turnuvada,
Dialogue: 0,0:02:11.50,0:02:14.23,Default,,0,0,0,,3.şampiyonluğu elde etmeye yemin ettim.
Dialogue: 0,0:02:14.23,0:02:16.74,Default,,0,0,0,,Bu {\i1}bizim{\i0} hayalimiz!
Dialogue: 0,0:02:17.43,0:02:18.98,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:02:18.98,0:02:22.99,Default,,0,0,0,,Bunu başaramazsam, Japonya'da kalmamın sebebi neydi?
Dialogue: 0,0:02:23.44,0:02:25.50,Default,,0,0,0,,Brezilya'ya gidemeyişimi telafi etmek için,
Dialogue: 0,0:02:26.08,0:02:29.12,Default,,0,0,0,,tüm bu zaman boyunca benimle birlikte oynayan arkadaşlarımla,
Dialogue: 0,0:02:29.12,0:02:31.42,Default,,0,0,0,,arka arkaya üç zafer kazanmaya karar verdim.
Dialogue: 0,0:02:31.42,0:02:34.92,Default,,0,0,0,,Tek bir hedefi gerçeğe dönüştürmek için çok çalıştım.
Dialogue: 0,0:02:34.92,0:02:37.97,Default - i,,0,0,0,,Hyuga-kun'a başka bir pas atıldı.
Dialogue: 0,0:02:37.97,0:02:39.72,Default,,0,0,0,,Ye bunu, Nankatsu!
Dialogue: 0,0:02:39.72,0:02:43.51,Default - i,,0,0,0,,İşte burada! Bugün Hyuga-kun'nun altıncı Tiger Shot'u!
Dialogue: 0,0:02:39.72,0:02:43.51,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:02:43.51,0:02:47.52,Default,,0,0,0,,Tsubasa burada olmadığı için daha fazla gol yiyemeyiz!
Dialogue: 0,0:02:47.52,0:02:49.16,Default,,0,0,0,,Tiger Shot düz gidiyor!
Dialogue: 0,0:02:47.52,0:02:49.16,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:02:49.16,0:02:51.27,Default,,0,0,0,,Sadece karşı koy, bir şekilde işe yaraması gerekiyor!
Dialogue: 0,0:02:55.40,0:02:56.15,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:02:56.15,0:02:59.24,Default - i,,0,0,0,,Ah, top Ishizaki-kun'nun bağırsağına saplandı!
Dialogue: 0,0:03:02.12,0:03:06.41,Default - i,,0,0,0,,Duraklamadan, Hyuga-kun başka bir Tiger Shot için hazırlandı!
Dialogue: 0,0:03:02.12,0:03:06.41,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:03:10.12,0:03:13.13,Default - i,,0,0,0,,Bu seferde, Takasugi-kun göğsü ile engelledi!
Dialogue: 0,0:03:15.75,0:03:17.11,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:03:18.97,0:03:22.34,Default,,0,0,0,,Üçüncü kez çekeceğim...!
Dialogue: 0,0:03:23.05,0:03:23.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:23.85,0:03:27.10,Default - i,,0,0,0,,Bu düdük ilk yarının sonunu işaret ediyor!
Dialogue: 0,0:03:27.10,0:03:30.60,Default - i,,0,0,0,,Nankatsu, Toho'nun Vahşi Kaplanını tutmayı başardı!
Dialogue: 0,0:03:30.60,0:03:32.35,Default,,0,0,0,,Kurtulduk...
Dialogue: 0,0:03:32.35,0:03:34.14,Default - i,,0,0,0,,İlk yarıdaki skor 3-2.
Dialogue: 0,0:03:34.14,0:03:36.86,Default - i,,0,0,0,,Bu yarı Toho'nun bir gol üstünlüğüyle sonuçlandı.
Dialogue: 0,0:03:36.86,0:03:40.36,Default,,0,0,0,,Lanet olsun! Bir saniyemiz daha olsaydı, ikiye ulaşırdık!
Dialogue: 0,0:03:41.50,0:03:43.11,Default,,0,0,0,,Siz ikiniz iyi misiniz?
Dialogue: 0,0:03:43.11,0:03:44.12,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:44.12,0:03:47.37,Default,,0,0,0,,İyi dövüş! Ishizaki! Takasugi!
Dialogue: 0,0:03:47.37,0:03:50.51,Default - i,,0,0,0,,İkinci yarıda geri ödeyeceğim, Nankatsu!
Dialogue: 0,0:03:51.89,0:03:55.00,Default - i,,0,0,0,,Güneş benim müttefikim olacak!
Dialogue: 0,0:03:55.00,0:03:57.28,Default - i,,0,0,0,,Bu sıcakta çok oynadıktan sonra yorulacaklar.
Dialogue: 0,0:03:57.28,0:03:59.88,Default - i,,0,0,0,,Yorgunluk ikinci yarıda onları yakalayacak.
Dialogue: 0,0:03:59.88,0:04:02.40,Default - i,,0,0,0,,Bana gelince, Okinawa'nın
Dialogue: 0,0:04:02.40,0:04:05.10,Default - i,,0,0,0,,kavurucu güneşi altında özel bir eğitim aldım.
Dialogue: 0,0:04:05.10,0:04:07.73,Default - i,,0,0,0,,İkinci yarının sonuna kadar onları toz haline getireceğim!
Dialogue: 0,0:04:07.73,0:04:09.33,Default - i,,0,0,0,,10 gol atacağım ve herkese,
Dialogue: 0,0:04:09.33,0:04:13.90,Default - i,,0,0,0,,Tsubasa burada olsa bile kazanacağımı göstereceğim!
Dialogue: 0,0:04:15.59,0:04:16.94,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:04:16.94,0:04:18.88,Default,,0,0,0,,İyi misin, Tsubasa-kun?
Dialogue: 0,0:04:18.88,0:04:21.07,Default,,0,0,0,,İyiyim. Peki ya maç?
Dialogue: 0,0:04:21.07,0:04:22.96,Default,,0,0,0,,Hala 3-2.
Dialogue: 0,0:04:22.96,0:04:24.96,Default,,0,0,0,,Hyuga-san'nın Tiger Shot'unu durdurmak için,
Dialogue: 0,0:04:24.96,0:04:28.83,Default,,0,0,0,,Ishizaki-senpai ve Takasugi-senpai vücutlarını kullandılar.
Dialogue: 0,0:04:28.83,0:04:31.61,Default,,0,0,0,,Düşündüğüm kadar büyük bir şey değildi.
Dialogue: 0,0:04:28.83,0:04:34.21,Default-TOP,,0,0,0,,REVİR
Dialogue: 0,0:04:31.61,0:04:34.21,Default,,0,0,0,,Demek onları tek bir golde tuttunuz, değil mi?
Dialogue: 0,0:04:34.21,0:04:36.84,Default,,0,0,0,,Peki, ikinci yarıda oynayabilecek misin?
Dialogue: 0,0:04:36.84,0:04:41.55,Default,,0,0,0,,Evet. Yeniden bantlandı ve ağrı kesici vuruldu.
Dialogue: 0,0:04:41.55,0:04:44.30,Default,,0,0,0,,30 dakika daha tam güçle savaşabilirim!
Dialogue: 0,0:04:44.30,0:04:45.86,Default,,0,0,0,,Gerçekten mi, Tsubasa?
Dialogue: 0,0:04:45.86,0:04:46.70,Default,,0,0,0,,Harika!
Dialogue: 0,0:04:46.70,0:04:47.88,Default,,0,0,0,,Ancak,
Dialogue: 0,0:04:48.30,0:04:51.07,Default,,0,0,0,,tekrar yere yıkılacak olursan,
Dialogue: 0,0:04:51.07,0:04:54.19,Default,,0,0,0,,bu olduğunda, sahadaki zamanın bitecek, Tsubasa.
Dialogue: 0,0:04:54.79,0:04:56.73,Default,,0,0,0,,Tamam. Anladım.
Dialogue: 0,0:04:56.73,0:04:58.70,Default,,0,0,0,,Tamam! Hadi yapalım!
Dialogue: 0,0:04:58.70,0:05:01.22,Default,,0,0,0,,Japonya'nın şampiyonları olarak,
Dialogue: 0,0:05:01.22,0:05:03.74,Default,,0,0,0,,3. zaferi kazanma hayalimiz henüz kaybolmadı!
Dialogue: 0,0:05:03.74,0:05:05.41,Default,,0,0,0,,Bizi izle, Toho!
Dialogue: 0,0:05:05.41,0:05:07.62,Default,,0,0,0,,Önümüzdeki yarıda kesinlikle tersine çevireceğiz!
Dialogue: 0,0:05:07.62,0:05:09.20,Default,,0,0,0,,EVET!
Dialogue: 0,0:05:09.20,0:05:10.87,Default,,0,0,0,,TOHO AKADEMİ - TOKYO
Dialogue: 0,0:05:10.87,0:05:13.55,Default,,0,0,0,,Wakashimazu, iyi misin?
Dialogue: 0,0:05:14.25,0:05:17.45,Default,,0,0,0,,Ben iyiyim Kaptan. Endişelenmene gerek yok.
Dialogue: 0,0:05:17.45,0:05:20.88,Default,,0,0,0,,Ne olursa olsun, Toho'nun \Nkalesini korumaya devam edeceğim.
Dialogue: 0,0:05:21.31,0:05:24.13,Default - i,,0,0,0,,Ne olursa olsun... Yemin ederim!
Dialogue: 0,0:05:30.36,0:05:31.70,Default - i,,0,0,0,,Baba,
Dialogue: 0,0:05:31.70,0:05:34.27,Default - i,,0,0,0,,cevabım değişmeyecek.
Dialogue: 0,0:05:34.27,0:05:38.77,Default-TOP,,0,0,0,,WAKADORYU KARATE DOJO
Dialogue: 0,0:05:34.27,0:05:38.77,Default - i,,0,0,0,,Dojo veya Wakadoryu okulunu devralmak gibi bir niyetim yok.
Dialogue: 0,0:05:38.77,0:05:40.64,Default - i,,0,0,0,,Hayalin hakkında her şeyi biliyorum.
Dialogue: 0,0:05:40.64,0:05:44.03,Default - i,,0,0,0,,Ama son iki yıldır başaramadın.
Dialogue: 0,0:05:44.42,0:05:46.25,Default - i,,0,0,0,,Bir düşün Ken.
Dialogue: 0,0:05:46.25,0:05:50.01,Default - i,,0,0,0,,Karateye futboldan daha uygunsun.
Dialogue: 0,0:05:50.01,0:05:51.30,Default - i,,0,0,0,,Anladım.
Dialogue: 0,0:05:52.54,0:05:56.28,Default - i,,0,0,0,,Bu kadar ısrar edersen, bir sonraki turnuvada şampiyon olamazsam,
Dialogue: 0,0:05:56.28,0:05:57.29,Default - i,,0,0,0,,futboldan vazgeçeceğim!
Dialogue: 0,0:05:57.90,0:06:00.92,Default - i,,0,0,0,,Umarım sözünden geri dönmezsin, Ken.
Dialogue: 0,0:06:00.92,0:06:01.91,Default - i,,0,0,0,,Söz veriyorum.
Dialogue: 0,0:06:01.91,0:06:04.10,Default - i,,0,0,0,,Ama biz, Toho kesinlikle kazanacağız.
Dialogue: 0,0:06:04.10,0:06:05.96,Default - i,,0,0,0,,Galip olacagız.
Dialogue: 0,0:06:05.96,0:06:09.89,Default - i,,0,0,0,,Ve o andan itibaren, kaleci olmaya ve futbol oynamaya devam edeceğim!
Dialogue: 0,0:06:15.41,0:06:17.14,Default,,0,0,0,,İyi iş millet!
Dialogue: 0,0:06:17.14,0:06:19.33,Default,,0,0,0,,Tsubasa iki gol atsa bile,
Dialogue: 0,0:06:19.33,0:06:21.53,Default,,0,0,0,,oyun tamamen bizim hızımızda gidiyor.
Dialogue: 0,0:06:21.53,0:06:24.83,Default,,0,0,0,,İkinci yarıda da topu Hyuga'ya göndermeye devam edin!
Dialogue: 0,0:06:24.83,0:06:25.32,Default,,0,0,0,,Ne—
Dialogue: 0,0:06:25.32,0:06:28.45,Default,,0,0,0,,Bunu yaparsanız, maçı kesinlikle kazanacağız!
Dialogue: 0,0:06:28.45,0:06:29.82,Default,,0,0,0,,Koç!
Dialogue: 0,0:06:29.82,0:06:32.66,Default - i,,0,0,0,,Koçumuz Hyuga-san'ı kabul etti!
Dialogue: 0,0:06:32.66,0:06:34.90,Default,,0,0,0,,Tamam! İkinci yarıda vahşileşelim!
Dialogue: 0,0:06:34.90,0:06:37.16,Default,,0,0,0,,"Toho'nun Birinci Zafer"ini gerçekleştirelim!
Dialogue: 0,0:06:37.16,0:06:38.36,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:39.97,0:06:43.92,Default - i,,0,0,0,,Toho gerçekten şu an bir oldu.
Dialogue: 0,0:06:47.42,0:06:49.76,Default,,0,0,0,,Sen Musashi Ortaokulundan Misugi-kun'sun değil mi?
Dialogue: 0,0:06:50.47,0:06:54.69,Default,,0,0,0,,Ben Ulusal Japon Futbol Federasyonu'ndan Katagiri.
Dialogue: 0,0:06:54.69,0:06:57.99,Default,,0,0,0,,Bu turnuvadan sonra, Avrupa turnesi için,
Dialogue: 0,0:06:57.99,0:07:01.29,Default,,0,0,0,,seçme bir takım kurulacağını zaten bildiğinize inanıyorum.
Dialogue: 0,0:07:01.29,0:07:02.03,Default,,0,0,0,,Evet biliyorum.
Dialogue: 0,0:07:02.03,0:07:05.65,Default,,0,0,0,,Seçme takımın eğitim kampına katılmanı istiyorum.
Dialogue: 0,0:07:05.65,0:07:07.11,Default,,0,0,0,,Ne? Ben mi?
Dialogue: 0,0:07:07.11,0:07:10.08,Default,,0,0,0,,Ancak, oyuncu olarak değil, koç olarak!
Dialogue: 0,0:07:10.08,0:07:10.98,Default,,0,0,0,,Koç mu...?!
Dialogue: 0,0:07:10.98,0:07:14.16,Default,,0,0,0,,İnanılmaz derecede yetenekli bir \Noyuncu olduğunuzu kabul ediyorum.
Dialogue: 0,0:07:14.16,0:07:16.16,Default,,0,0,0,,Ancak, kalp rahatsızlığınız var.
Dialogue: 0,0:07:18.87,0:07:23.17,Default,,0,0,0,,Buna rağmen, sadece futbol anlayışınız inanılmaz değil,
Dialogue: 0,0:07:23.17,0:07:26.28,Default,,0,0,0,,aynı zamanda etrafınızdakileri \Nsakince gözlemlemekte de ustasınız.
Dialogue: 0,0:07:26.28,0:07:30.21,Default,,0,0,0,,Kampa koç olarak katılmanı, her\N oyuncunun güçlü yanlarını arttırmasına,
Dialogue: 0,0:07:30.21,0:07:32.78,Default,,0,0,0,,ve eksikliklerini yenmelerine yardım etmeni istiyorum.
Dialogue: 0,0:07:32.78,0:07:36.35,Default,,0,0,0,,Koçluk... Bunu gerçekten yapabilir miyim?
Dialogue: 0,0:07:36.35,0:07:37.93,Default,,0,0,0,,Lütfen düşün.
Dialogue: 0,0:07:44.95,0:07:46.15,Default - i,,0,0,0,,Tsubasa-kun burada!
Dialogue: 0,0:07:46.15,0:07:49.03,Default - i,,0,0,0,,İkinci yarıda oynamak için sahaya çıktı ve iyi görünüyor!
Dialogue: 0,0:07:49.03,0:07:52.03,Default - i,,0,0,0,,Yani sonuçta oynayacaksın, Tsubasa.
Dialogue: 0,0:07:52.03,0:07:54.45,Default,,0,0,0,,Şimdi oynamaya değecek!
Dialogue: 0,0:07:54.45,0:07:55.62,Default,,0,0,0,,Haklısın!
Dialogue: 0,0:07:55.62,0:07:57.24,Default,,0,0,0,,Millet...
Dialogue: 0,0:07:57.24,0:07:59.24,Default,,0,0,0,,WAKADORYU KARATE DOJO
Dialogue: 0,0:07:59.24,0:08:01.91,Default - i,,0,0,0,,Her iki takım da pozisyonlarını alıyor.
Dialogue: 0,0:08:02.36,0:08:03.50,Default - i,,0,0,0,,Ken...
Dialogue: 0,0:08:03.50,0:08:05.86,Default - i,,0,0,0,,İlk yarıda, Tsubasa-kun'nun Drive Shot'u ve
Dialogue: 0,0:08:03.50,0:08:05.86,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:05.86,0:08:08.25,Default - i,,0,0,0,,Hyuga-kun'nun Tiger Shot'u arasındaki bir gösteriydi.
Dialogue: 0,0:08:05.86,0:08:08.25,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:08:08.25,0:08:11.38,Default - i,,0,0,0,,İkinci yarıda bizi hangi gelişmeler bekliyor?
Dialogue: 0,0:08:11.38,0:08:14.01,Default - i,,0,0,0,,Gel bakalım! İkinci yarının 30 dakikası!
Dialogue: 0,0:08:14.01,0:08:16.14,Default - i,,0,0,0,,Benim son ortaokul maçım.
Dialogue: 0,0:08:16.14,0:08:20.14,Default - i,,0,0,0,,Önümüzdeki 30 dakika içinde, hayalimizi gerçekleştireceğim!
Dialogue: 0,0:08:21.06,0:08:23.14,Default - i,,0,0,0,,İkinci yarı başlıyor!
Dialogue: 0,0:08:23.14,0:08:25.73,Default,,0,0,0,,Git! Toho'nun Kayan Takımı!
Dialogue: 0,0:08:25.73,0:08:27.21,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:27.21,0:08:30.23,Default - i,,0,0,0,,Toho, başlangıçta Nankatsu'yu pükürtmeye çalışıyor!
Dialogue: 0,0:08:32.03,0:08:33.66,Default - i,,0,0,0,,Tsubasa-kun onları ustaca atlattı!
Dialogue: 0,0:08:33.66,0:08:34.95,Default,,0,0,0,,Ye bunu, Tsubasa!
Dialogue: 0,0:08:35.37,0:08:37.08,Default - i,,0,0,0,,Bu sefer Hyuga-kun saldırıyor!
Dialogue: 0,0:08:37.08,0:08:38.74,Default - i,,0,0,0,,Vahşi Kaplan, dişlerini çıkarıyor!
Dialogue: 0,0:08:39.66,0:08:42.87,Default - i,,0,0,0,,Ancak, önce Şahin kanatlarını gökyüzüne açıyor!
Dialogue: 0,0:08:42.87,0:08:44.13,Default - i,,0,0,0,,Ne?!
Dialogue: 0,0:08:44.13,0:08:47.17,Default - i,,0,0,0,,Yaralı olman gerekiyordu. \NNasıl bu kadar yükseğe zıplayabiliyorsun?
Dialogue: 0,0:08:49.92,0:08:51.83,Default,,0,0,0,,Tamam! Haydi gidelim millet!
Dialogue: 0,0:08:51.83,0:08:52.59,Default,,0,0,0,,Tamam
Dialogue: 0,0:08:52.59,0:08:56.17,Default - i,,0,0,0,,Nankatsu'nun Kaptanı Ozora Tsubasa-kun, kazandığı ivme ile saldırmaya başladı!
Dialogue: 0,0:08:56.17,0:08:57.68,Default - i,,0,0,0,,Oyuna tamamen geri döndü!
Dialogue: 0,0:08:57.68,0:08:59.68,Default,,0,0,0,,Git! Yaklaştık!
Dialogue: 0,0:09:00.93,0:09:03.18,Default,,0,0,0,,Hızlı bir şekilde saldırmana izin vermeyeceğim!
Dialogue: 0,0:09:03.77,0:09:04.39,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:09:04.39,0:09:07.50,Default - i,,0,0,0,,Tsubasa-kun, Nankatsu'nun Gümüş ikilisi,
Dialogue: 0,0:09:07.50,0:09:10.78,Default - i,,0,0,0,,zar zor yenilen Kisugi-kun ve Taki-kun'a pas gönderdi!
Dialogue: 0,0:09:11.38,0:09:12.11,Default,,0,0,0,,Kötü!
Dialogue: 0,0:09:12.11,0:09:13.11,Default,,0,0,0,,Gelin!
Dialogue: 0,0:09:13.11,0:09:15.89,Default - i,,0,0,0,,Tsubasa saatli bir bomba.
Dialogue: 0,0:09:15.89,0:09:17.78,Default - i,,0,0,0,,Ne zaman patlayacağı belli değil!
Dialogue: 0,0:09:17.78,0:09:20.79,Default - i,,0,0,0,,Tsubasa hala iyi hissediyorken, skor yapmalıyız!
Dialogue: 0,0:09:21.29,0:09:23.16,Default - i,,0,0,0,,Kisugi-kun bir kafa vuruşu için gidiyor!
Dialogue: 0,0:09:24.14,0:09:24.66,Default,,0,0,0,,Taki!
Dialogue: 0,0:09:24.66,0:09:26.83,Default - i,,0,0,0,,Hayır, bir şut değil!
Dialogue: 0,0:09:26.83,0:09:28.84,Default - i,,0,0,0,,Wakashimazu-kun tamamen kandırıldı!
Dialogue: 0,0:09:28.84,0:09:29.84,Default,,0,0,0,,Tamam, işte git!
Dialogue: 0,0:09:30.27,0:09:34.07,Default - i,,0,0,0,,Nankatsu'nun Gümüş ikilisi doğrudan bu pası çift kafa vuruşuna çeviriyor!
Dialogue: 0,0:09:34.07,0:09:35.84,Default - i,,0,0,0,,Bu bir 3D Saldırı!
Dialogue: 0,0:09:35.84,0:09:36.88,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:09:36.88,0:09:38.34,Default,,0,0,0,,En sonunda! Yakaladık!
Dialogue: 0,0:09:39.22,0:09:40.13,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:09:40.13,0:09:42.26,Default - i,,0,0,0,,Yine de, Wakashimazu-kun peşinden gidiyor!
Dialogue: 0,0:09:42.26,0:09:44.52,Default - i,,0,0,0,,Ama yumruğu ulaşamıyor!
Dialogue: 0,0:09:46.02,0:09:47.77,Default,,0,0,0,,Ken! Parmaklarını kullan!
Dialogue: 0,0:09:52.72,0:09:54.15,Default - i,,0,0,0,,Durdurdu!
Dialogue: 0,0:09:54.15,0:09:55.03,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:55.03,0:09:57.45,Default - i,,0,0,0,,Kolunu olabildiğince uzattı, parmaklarını açtı,
Dialogue: 0,0:09:57.45,0:09:59.87,Default - i,,0,0,0,,ve topu zorlukla uzaklaştırmayı başardı!
Dialogue: 0,0:09:59.87,0:10:01.95,Default - i,,0,0,0,,Bu karate bıçak el tekniği!
Dialogue: 0,0:10:01.95,0:10:03.77,Default - i,,0,0,0,,Wakashimazu-kun'dan mükemmel bir oyun!
Dialogue: 0,0:10:03.77,0:10:04.54,Default,,0,0,0,,Ken!
Dialogue: 0,0:10:04.54,0:10:06.50,Default - i,,0,0,0,,Nankatsu gol atamadı!
Dialogue: 0,0:10:06.50,0:10:08.21,Default,,0,0,0,,Güzel kurtarış, Wakashimazu!
Dialogue: 0,0:10:08.21,0:10:09.43,Default,,0,0,0,,K-Kahretsin!
Dialogue: 0,0:10:09.43,0:10:11.13,Default,,0,0,0,,Çok yakındık!
Dialogue: 0,0:10:11.13,0:10:12.55,Default,,0,0,0,,Ama hala köşe vuruşumuz var!
Dialogue: 0,0:10:13.48,0:10:14.96,Default - i,,0,0,0,,Kısa bir köşe vuruşu!
Dialogue: 0,0:10:15.55,0:10:16.72,Default,,0,0,0,,Acele edin! Geri dönün!
Dialogue: 0,0:10:16.72,0:10:18.38,Default - i,,0,0,0,,Tsubasa-kun da öne çıkıyor!
Dialogue: 0,0:10:18.73,0:10:19.30,Default,,0,0,0,,Taki!
Dialogue: 0,0:10:20.74,0:10:21.43,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:10:21.43,0:10:24.06,Default - i,,0,0,0,,Taki-kun ceza sahasına çapraz gönderiyor!
Dialogue: 0,0:10:24.81,0:10:27.27,Default - i,,0,0,0,,Ancak top saptırıldı!
Dialogue: 0,0:10:27.27,0:10:28.81,Default,,0,0,0,,İyi savunma!
Dialogue: 0,0:10:31.18,0:10:35.07,Default - i,,0,0,0,,Tsubasa-kun ters yönde zıplamak için kale direğini kullanıyor!
Dialogue: 0,0:10:35.45,0:10:35.99,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:37.92,0:10:40.52,Default - i,,0,0,0,,Topu karşı tarafa gönderdi!
Dialogue: 0,0:10:40.52,0:10:42.57,Default - i,,0,0,0,,Wakashimazu-kun bir kez daha pozisyon dışında.
Dialogue: 0,0:10:42.57,0:10:43.33,Default,,0,0,0,,Hallederim!
Dialogue: 0,0:10:45.34,0:10:48.04,Default - i,,0,0,0,,İşte Izawa-kun'nun damga hamlesi, Beş Metre Kafa Vuruşu!
Dialogue: 0,0:10:48.04,0:10:49.33,Default,,0,0,0,,Tamam! Beraberlik!
Dialogue: 0,0:10:49.33,0:10:50.25,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:10:50.25,0:10:51.29,Default,,0,0,0,,Ken!
Dialogue: 0,0:10:55.74,0:10:56.93,Default - i,,0,0,0,,Durdurdu!
Dialogue: 0,0:10:56.93,0:10:59.72,Default - i,,0,0,0,,Bu Wakashimazu-kun'un özel Üçgen Tekme Savunması!
Dialogue: 0,0:10:59.72,0:11:00.43,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:02.43,0:11:04.76,Default - i,,0,0,0,,Nankatsu, Toho'nun kalesine tekrar tekrar saldırıyor,
Dialogue: 0,0:11:04.76,0:11:08.10,Default - i,,0,0,0,,ama Wakashimazu-kun girişimlerini tamamen durduruyor!
Dialogue: 0,0:11:08.10,0:11:12.19,Default - i,,0,0,0,,İkinci yarının başlamasından hemen\N sonra şiddetli mücadeleleri devam ediyor!
Dialogue: 0,0:11:12.19,0:11:15.44,Default,,0,0,0,,Başkasına karşı, ikinci golü çoktan atmışlardı.
Dialogue: 0,0:11:15.44,0:11:19.07,Default,,0,0,0,,Turnuvadaki 1 numaralı kaleci \NWakashimazu'dan beklediği gibi, bilirsin.
Dialogue: 0,0:11:19.64,0:11:22.66,Default - i,,0,0,0,,İyi oynadı, Nankatsu ve Tsubasa.
Dialogue: 0,0:11:22.66,0:11:27.66,Default - i,,0,0,0,,Ancak, Tsubasa tekrar ayağa kalkarsa, benim için daha iyi olur.
Dialogue: 0,0:11:27.66,0:11:30.41,Default - i,,0,0,0,,Sadece bir kez daha yenmeye değer olduğu anlamına gelir.
Dialogue: 0,0:11:31.62,0:11:34.38,Default - i,,0,0,0,,Nankatsu'nun fırsatı hala var.
Dialogue: 0,0:11:36.08,0:11:36.92,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:11:36.92,0:11:38.63,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:11:38.63,0:11:41.81,Default,,0,0,0,,Kaptan, sen forvetsin. Savunmana gerek yok!
Dialogue: 0,0:11:41.81,0:11:44.01,Default,,0,0,0,,O haklı. Burayı savunacağız.
Dialogue: 0,0:11:44.01,0:11:46.37,Default,,0,0,0,,Bize güvenmiyor musun?
Dialogue: 0,0:11:46.37,0:11:47.50,Default,,0,0,0,,Öyle değil.
Dialogue: 0,0:11:47.50,0:11:48.47,Default,,0,0,0,,O zaman neden?
Dialogue: 0,0:11:48.47,0:11:50.44,Default,,0,0,0,,Forvet olduğum doğru.
Dialogue: 0,0:11:50.44,0:11:53.44,Default,,0,0,0,,Ama ondan önce Toho üyesiyim.
Dialogue: 0,0:11:53.44,0:11:56.52,Default,,0,0,0,,Nankatsu şu an saldırı için hız kazandı.
Dialogue: 0,0:11:56.52,0:12:00.65,Default,,0,0,0,,Ve şimdi, savunmamızın ana direği olan \NWakashimazu'nun yaralı bir sol kolu var.
Dialogue: 0,0:12:00.65,0:12:03.56,Default,,0,0,0,,Bu durumda, forvet ya da \Nsavunma oyuncusu olmak önemsizdir.
Dialogue: 0,0:12:03.56,0:12:05.42,Default,,0,0,0,,Savunmama izin verin!
Dialogue: 0,0:12:05.42,0:12:07.58,Default,,0,0,0,,Hep birlikte savunalım!
Dialogue: 0,0:12:07.58,0:12:08.70,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:12:08.70,0:12:10.33,Default,,0,0,0,,Anlıyorum Kaptan!
Dialogue: 0,0:12:11.74,0:12:12.83,Default,,0,0,0,,Takım çalışması.
Dialogue: 0,0:12:13.51,0:12:19.05,Default,,0,0,0,,Şu an Toho'dan, Furano'da gördüğüm takım çalışmasını hissediyorum.
Dialogue: 0,0:12:19.05,0:12:20.84,Default,,0,0,0,,Takım çalışması hissi mi?
Dialogue: 0,0:12:20.84,0:12:23.06,Default,,0,0,0,,Evet, soluk, ama orada.
Dialogue: 0,0:12:23.06,0:12:26.00,Default,,0,0,0,,Bana göre Toho birleşmiş görünüyor.
Dialogue: 0,0:12:26.60,0:12:28.18,Default - i,,0,0,0,,Hyuga-kun...
Dialogue: 0,0:12:28.18,0:12:30.51,Default - i,,0,0,0,,Her nasılsa, Hyuga-kun ona karşı savaştığım,
Dialogue: 0,0:12:30.51,0:12:32.85,Default - i,,0,0,0,,zamanlarla karşılaştırdığımda daha iyi görünüyor.
Dialogue: 0,0:12:33.42,0:12:36.23,Default - i,,0,0,0,,Sadece silahı, Tiger Shot ile ilgili değil.
Dialogue: 0,0:12:33.42,0:12:36.23,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:12:36.23,0:12:40.36,Default - i,,0,0,0,,O ve onun düşünce tarzıyla ilgili başka bir şey var...
Dialogue: 0,0:12:40.75,0:12:42.36,Default,,0,0,0,,Kaybetmeyeceğim Tsubasa.
Dialogue: 0,0:12:49.70,0:12:54.71,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:12:57.92,0:13:00.42,Default - i,,0,0,0,,Nankatsu'nun büyük bir şansı var.
Dialogue: 0,0:13:00.42,0:13:03.09,Default - i,,0,0,0,,Köşe vuruşunu gole çevirecekler mi?
Dialogue: 0,0:13:03.09,0:13:04.05,Default,,0,0,0,,İşte başlıyoruz!
Dialogue: 0,0:13:04.05,0:13:06.97,Default - i,,0,0,0,,Taki-kun doğrudan kalenin önüne topu gönderiyor!
Dialogue: 0,0:13:09.18,0:13:13.48,Default - i,,0,0,0,,Oraya yetişmeden önce, Hyuga-kun zıplar ve topu uzaklaştırır!
Dialogue: 0,0:13:14.73,0:13:15.55,Default,,0,0,0,,Gidin!
Dialogue: 0,0:13:15.55,0:13:17.33,Default,,0,0,0,,Şimdi saldırı sırası bizde!
Dialogue: 0,0:13:17.33,0:13:19.61,Default,,0,0,0,,Top için koşun, millet!
Dialogue: 0,0:13:19.61,0:13:20.65,Default,,0,0,0,,Tamam!
Dialogue: 0,0:13:20.65,0:13:23.65,Default - i,,0,0,0,,Oyun değişti ve şimdi Toho saldırıyor!
Dialogue: 0,0:13:23.65,0:13:25.35,Default,,0,0,0,,Onlara kaybetmeyin, geri dönün!
Dialogue: 0,0:13:25.35,0:13:26.82,Default - i,,0,0,0,,Nankatsu birlikte geri dönüyor!
Dialogue: 0,0:13:27.99,0:13:29.62,Default - i,,0,0,0,,Nakazato-kun topu tutuyor.
Dialogue: 0,0:13:29.62,0:13:31.37,Default - i,,0,0,0,,Sorimachi-kun da alıyor!
Dialogue: 0,0:13:31.87,0:13:33.33,Default - i,,0,0,0,,Toho için hızlı bir fırsat.
Dialogue: 0,0:13:33.33,0:13:35.12,Default - i,,0,0,0,,Hyuga-kun'a gönderecek mi?
Dialogue: 0,0:13:35.60,0:13:38.04,Default - i,,0,0,0,,Fakat Tsubasa-kun onu şiddetle tutuyor!
Dialogue: 0,0:13:38.04,0:13:39.05,Default - i,,0,0,0,,Nasıl?
Dialogue: 0,0:13:39.05,0:13:40.80,Default - i,,0,0,0,,Nasıl tam güçte oynayabilirsin?
Dialogue: 0,0:13:40.80,0:13:42.96,Default - i,,0,0,0,,İlk yarıda çok yaralandın!
Dialogue: 0,0:13:42.96,0:13:46.09,Default - i,,0,0,0,,Kesinlikle kaybetmeyi göze alamam!
Dialogue: 0,0:13:46.09,0:13:49.60,Default - i,,0,0,0,,Hem Tsubasa-kun hem de Hyuga-kun vazgeçmeyi reddediyor!
Dialogue: 0,0:13:49.60,0:13:52.99,Default - i,,0,0,0,,Görünüşte tamamen iyileşmiş gibi,
Dialogue: 0,0:13:52.99,0:13:55.85,Default - i,,0,0,0,,ancak ilaç sayesinde acıyı hissetmiyor.
Dialogue: 0,0:13:55.85,0:13:59.61,Default - i,,0,0,0,,Gerçekte, her oynamasında, yaptığı her hareketde,
Dialogue: 0,0:13:59.61,0:14:03.36,Default - i,,0,0,0,,hissetmese bile, sakatlığını biraz daha kötüleştiriyor.
Dialogue: 0,0:14:03.77,0:14:04.36,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:14:04.36,0:14:06.15,Default,,0,0,0,,Kaptana gönderemiyorum.
Dialogue: 0,0:14:06.15,0:14:07.39,Default,,0,0,0,,Umurumda değil Sorimachi!
Dialogue: 0,0:14:07.39,0:14:08.49,Default,,0,0,0,,Gönder bana!
Dialogue: 0,0:14:08.49,0:14:09.37,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:14:09.85,0:14:10.49,Default,,0,0,0,,İşte!
Dialogue: 0,0:14:10.49,0:14:12.49,Default - i,,0,0,0,,Sorimachi-kun, Hyuga-kun'a gönderiyor.
Dialogue: 0,0:14:12.98,0:14:14.04,Default - i,,0,0,0,,Yüksekte bir top!
Dialogue: 0,0:14:15.45,0:14:17.00,Default - i,,0,0,0,,Havada bir karşılaşma!
Dialogue: 0,0:14:17.95,0:14:19.46,Default - i,,0,0,0,,Eşitler!
Dialogue: 0,0:14:19.46,0:14:21.84,Default - i,,0,0,0,,Tsubasa, bu kadar yükseğe atlayabiliyorsun...
Dialogue: 0,0:14:22.88,0:14:23.50,Default,,0,0,0,,Al onu!
Dialogue: 0,0:14:23.93,0:14:26.51,Default - i,,0,0,0,,Ishizaki-kun topu uzaklaştırıyor!
Dialogue: 0,0:14:26.51,0:14:28.89,Default - i,,0,0,0,,İkinci yarıda Nankatsu iyi savunuyor!
Dialogue: 0,0:14:28.89,0:14:31.48,Default,,0,0,0,,Tsubasa sahanın her noktasını kapsıyor.
Dialogue: 0,0:14:31.48,0:14:32.05,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:32.05,0:14:34.81,Default,,0,0,0,,Tsubasa gerçekten Nankatsu'nun kilit taşı, bilirsin.
Dialogue: 0,0:14:35.96,0:14:38.81,Default - i,,0,0,0,,Vücudunun sınırı ne?
Dialogue: 0,0:14:38.81,0:14:42.31,Default - i,,0,0,0,,Gücünü bile göremiyorum, Tsubasa Ozora!
Dialogue: 0,0:14:42.31,0:14:45.19,Default - i,,0,0,0,,Ancak, bugün seni yeneceğim!
Dialogue: 0,0:14:45.60,0:14:50.20,Default - i,,0,0,0,,Tsubasa-kun gerçekten acı çekiyor olmalısın, ama elinden geleni yap.
Dialogue: 0,0:14:50.20,0:14:52.58,Default - i,,0,0,0,,Her iki tarafta yoğun değişiklikler var.
Dialogue: 0,0:14:52.58,0:14:54.79,Default - i,,0,0,0,,Nankatsu'nun saldırı sırası!
Dialogue: 0,0:14:55.75,0:14:58.87,Default - i,,0,0,0,,Hyuga-kun, Tsubasa-kun'u tutuyor!
Dialogue: 0,0:15:00.92,0:15:02.42,Default - i,,0,0,0,,Izawa-kun, Iwami-kun'a pas attı.
Dialogue: 0,0:15:03.01,0:15:05.17,Default - i,,0,0,0,,Sawada-kun pasını okuyor!
Dialogue: 0,0:15:05.63,0:15:06.17,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:06.17,0:15:08.30,Default - i,,0,0,0,,Toho yine topu aldı.
Dialogue: 0,0:15:08.30,0:15:11.80,Default - i,,0,0,0,,Çok fazla öne çıkmayabilir ama \NSawada gerçekten Toho'nun kilit oyuncusu.
Dialogue: 0,0:15:11.80,0:15:16.18,Default - i,,0,0,0,,Onun çabasıyla başlayan Toho saldırıları en korkutucu olanları.
Dialogue: 0,0:15:16.18,0:15:19.23,Default - i,,0,0,0,,Maçta Hyuga-san'a topu olabildiğince çok göndereceğim.
Dialogue: 0,0:15:19.63,0:15:24.40,Default - i,,0,0,0,,Bu sadece koçumuzun emri değil, Toho onbirinin iradesi!
Dialogue: 0,0:15:24.68,0:15:26.01,Default,,0,0,0,,Kaptan Hyuga!
Dialogue: 0,0:15:26.01,0:15:28.78,Default - i,,0,0,0,,Toho topu bir kez daha Hyuga-kun'a yolladı!
Dialogue: 0,0:15:28.78,0:15:32.07,Default - i,,0,0,0,,Ama Tsubasa-kun onu tutuyor!
Dialogue: 0,0:15:32.07,0:15:33.43,Default - i,,0,0,0,,Kaybedemem!
Dialogue: 0,0:15:33.43,0:15:36.03,Default - i,,0,0,0,,Topu bana göndermeye devam eden,
Dialogue: 0,0:15:36.03,0:15:38.62,Default - i,,0,0,0,,herkesin iyiliği için asla kaybedemem!
Dialogue: 0,0:15:39.87,0:15:42.75,Default - i,,0,0,0,,Her ikisi de bir kez daha top için zıplıyor!
Dialogue: 0,0:15:42.75,0:15:44.71,Default,,0,0,0,,Bu sefer kazan, abi!
Dialogue: 0,0:15:45.13,0:15:47.30,Default - i,,0,0,0,,Bir kez daha, savaşları berabere gibi görünüyor!
Dialogue: 0,0:15:47.30,0:15:48.05,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:15:48.05,0:15:48.80,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:51.73,0:15:52.76,Default - i,,0,0,0,,Hayır, öyle değil!
Dialogue: 0,0:15:54.22,0:15:55.05,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:55.05,0:15:56.26,Default,,0,0,0,,Yakaladım!
Dialogue: 0,0:15:56.68,0:15:57.35,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:15:58.14,0:16:01.10,Default,,0,0,0,,{\bord0\blur0.6\c&H00FFFF&}Ti{\c&H00F7FF&}g{\c&H00E9FF&}er {\c&H00D8FF&}S{\c&H00CBFF&}ho{\c&H00BFFF&}t{\c&H00AEFF&}!
Dialogue: 0,0:15:58.14,0:16:01.10,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:02.14,0:16:06.61,Default - i,,0,0,0,,Amanın! Tiger Shot, Tsubasa-kun'nun sol omzunu sıyırıyor!
Dialogue: 0,0:16:02.14,0:16:06.61,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:06.61,0:16:08.48,Default - i,,0,0,0,,Doğrudan kaleye uçuyor!
Dialogue: 0,0:16:08.48,0:16:11.70,Default - i,,0,0,0,,Ancak Morisaki sağlam bir kurtarış yapıyor!
Dialogue: 0,0:16:15.20,0:16:15.82,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:15.82,0:16:16.70,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:16:16.70,0:16:17.49,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:17.49,0:16:18.95,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:18.95,0:16:20.12,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:20.12,0:16:21.91,Default - i,,0,0,0,,Tsubasa-kun iyi mi?
Dialogue: 0,0:16:21.91,0:16:24.04,Default - i,,0,0,0,,Omzu zaten yaralıydı.
Dialogue: 0,0:16:24.04,0:16:27.59,Default - i,,0,0,0,,Dahası, Tiger Shot yakınından geçti.
Dialogue: 0,0:16:24.04,0:16:27.59,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:27.59,0:16:30.99,Default - i,,0,0,0,,Tiger Shot, direğe çarptığında topu patlatacak kadar güçlü.
Dialogue: 0,0:16:27.59,0:16:30.99,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:30.99,0:16:33.81,Default - i,,0,0,0,,Eğer gücü bu kadar zayıflamışsa, o zaman...
Dialogue: 0,0:16:33.81,0:16:36.51,Default - i,,0,0,0,,Tsubasa'nın omzu enerjisinin çoğunu doğrudan aldı.
Dialogue: 0,0:16:36.51,0:16:38.34,Default - i,,0,0,0,,Bu sefer sahada bayılırsam...
Dialogue: 0,0:16:38.34,0:16:42.31,Default - i,,0,0,0,,Doktor beni maçtan geri çekecek.
Dialogue: 0,0:16:44.90,0:16:47.73,Default - i,,0,0,0,,Tsubasa-kun hızla ayağa kalkıyor.
Dialogue: 0,0:16:50.11,0:16:51.69,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:16:52.49,0:16:53.78,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:16:53.78,0:16:55.45,Default,,0,0,0,,Evet, tabii.
Dialogue: 0,0:16:55.45,0:16:57.32,Default - i,,0,0,0,,Tsubasa...
Dialogue: 0,0:16:57.32,0:16:59.32,Default,,0,0,0,,İyi misin, Tsubasa?
Dialogue: 0,0:16:59.32,0:17:00.60,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:02.82,0:17:05.04,Default,,0,0,0,,Bizim hayalimiz...
Dialogue: 0,0:17:05.04,0:17:08.61,Default,,0,0,0,,Ülkede 3.şampiyonluğu alma.
Dialogue: 0,0:17:08.61,0:17:09.80,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:17:12.84,0:17:14.96,Default,,0,0,0,,Haydi gidelim millet.
Dialogue: 0,0:17:17.30,0:17:18.93,Default,,0,0,0,,Tamam, bu sefer saldırıyoruz millet!
Dialogue: 0,0:17:18.93,0:17:20.93,Default,,0,0,0,,Hayalimize doğru gidiyoruz!
Dialogue: 0,0:17:20.93,0:17:23.56,Default - i,,0,0,0,,Şimdi Nankatsu'nun saldırısı!
Dialogue: 0,0:17:23.56,0:17:25.14,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:17:25.14,0:17:29.25,Default - i,,0,0,0,,Tsubasa, aptallığın ne kadar ileri gidiyor?
Dialogue: 0,0:17:29.25,0:17:31.65,Default - i,,0,0,0,,Futbol söz konusu olduğunda ne kadar aptalsın?
Dialogue: 0,0:17:31.65,0:17:33.15,Default,,0,0,0,,Kahretsin, Tsubasa!
Dialogue: 0,0:17:33.15,0:17:35.15,Default,,0,0,0,,Ne olursa olsun geri durmayacağım!
Dialogue: 0,0:17:35.15,0:17:36.86,Default,,0,0,0,,Sana merhamet etmeyeceğim!
Dialogue: 0,0:17:36.86,0:17:38.60,Default,,0,0,0,,Seni ezeceğim!
Dialogue: 0,0:17:38.60,0:17:40.55,Default,,0,0,0,,Bir kez daha yolumda durursan,
Dialogue: 0,0:17:40.55,0:17:43.03,Default,,0,0,0,,Tiger Shot'umu yüzüne yemeni sağlayacağım!
Dialogue: 0,0:17:40.55,0:17:43.03,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:17:43.03,0:17:45.75,Default,,0,0,0,,Elbette! Başka bir şekilde olamazdı, Hyuga-kun!
Dialogue: 0,0:17:45.75,0:17:46.79,Default,,0,0,0,,Hah!
Dialogue: 0,0:17:46.79,0:17:47.88,Default,,0,0,0,,Durdurun millet!
Dialogue: 0,0:17:47.88,0:17:49.88,Default,,0,0,0,,Topu kaleye atmasına izin vermeyin!
Dialogue: 0,0:17:50.41,0:17:51.05,Default,,0,0,0,,Izawa!
Dialogue: 0,0:17:52.01,0:17:55.47,Default - i,,0,0,0,,Evet, üç kez ülke şampiyonu olmak bizim hayalimiz!
Dialogue: 0,0:17:55.47,0:17:58.80,Default - i,,0,0,0,,Hadi bu rüyayı birlikte gerçek yapalım Tsubasa.
Dialogue: 0,0:17:58.80,0:17:59.68,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:17:59.68,0:18:02.01,Default,,0,0,0,,Tekrar birinci yıl öğrencisine kaybedemem!
Dialogue: 0,0:18:03.35,0:18:06.35,Default - i,,0,0,0,,Izawa-kun ileri top sürüyormuş gibi yaptı\N ancak bunun yerine geri pas gönderiyor.
Dialogue: 0,0:18:07.56,0:18:09.48,Default - i,,0,0,0,,Hayallerimizi gerçeğe dönüştüreceğiz!
Dialogue: 0,0:18:09.48,0:18:10.19,Default,,0,0,0,,Al hadi!
Dialogue: 0,0:18:12.51,0:18:15.24,Default - i,,0,0,0,,Nankatsu'dan mükemmel bir kombinasyon oyunu!
Dialogue: 0,0:18:15.24,0:18:18.84,Default - i,,0,0,0,,Üçüncü yılımızın son resmi oyunu!
Dialogue: 0,0:18:18.84,0:18:19.37,Default,,0,0,0,,İşte!
Dialogue: 0,0:18:19.37,0:18:22.98,Default - i,,0,0,0,,Üç yıl yenilmez olarak mezun olacağız!
Dialogue: 0,0:18:22.98,0:18:24.87,Default - i,,0,0,0,,Top Taki-kun'a gönderiliyor!
Dialogue: 0,0:18:24.87,0:18:27.64,Default - i,,0,0,0,,Üç yıldır benimle birlikte savaşmış olan herkes,
Dialogue: 0,0:18:27.64,0:18:30.21,Default - i,,0,0,0,,bu final maçını kazanıp anlamlı kılalım!
Dialogue: 0,0:18:30.21,0:18:32.17,Default - i,,0,0,0,,"Ülkede 3 kez şampiyon."
Dialogue: 0,0:18:32.17,0:18:35.21,Default,,0,0,0,,Hayallerimizi gerçeğe dönüştürelim!
Dialogue: 0,0:18:36.75,0:18:38.93,Default - i,,0,0,0,,Taki-kun ceza alanına çapraz gönderiyor!
Dialogue: 0,0:18:40.42,0:18:42.72,Default - i,,0,0,0,,Nagano-kun topu kafası ile uzaklaştırdı.
Dialogue: 0,0:18:42.72,0:18:44.60,Default - i,,0,0,0,,Nankatsu bir bütün haline geldi!
Dialogue: 0,0:18:44.60,0:18:45.90,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:18:45.90,0:18:49.06,Default - i,,0,0,0,,Kisugi-kun kayan bir vuruşla sona erdiriyor!
Dialogue: 0,0:18:49.06,0:18:49.69,Default,,0,0,0,,Ah!
Dialogue: 0,0:18:50.19,0:18:51.56,Default,,0,0,0,,Harika, içeride!
Dialogue: 0,0:18:52.85,0:18:54.14,Default - i,,0,0,0,,Engelledi!
Dialogue: 0,0:18:54.14,0:18:56.80,Default - i,,0,0,0,,Nankatsu'nun şiddetli saldırısı bile, turnuvanın
Dialogue: 0,0:18:56.80,0:18:59.11,Default - i,,0,0,0,,1. kalecisi Wakashimazu-kun'a karşı gol atamadı.
Dialogue: 0,0:18:59.11,0:19:00.76,Default - i,,0,0,0,,Sanki gol atmanıza izin veririm de!
Dialogue: 0,0:19:00.76,0:19:03.03,Default - i,,0,0,0,,Toho'nun kalesini koruyacağım!
Dialogue: 0,0:19:03.03,0:19:04.70,Default,,0,0,0,,Güzel, Wakashimazu!
Dialogue: 0,0:19:04.70,0:19:07.58,Default,,0,0,0,,Kahretsin, mükemmel bir saldırıydı!
Dialogue: 0,0:19:07.58,0:19:09.58,Default,,0,0,0,,Top hala oyunda!
Dialogue: 0,0:19:10.46,0:19:12.21,Default,,0,0,0,,Bu kısmı bana bırak!
Dialogue: 0,0:19:12.21,0:19:13.96,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:19:13.96,0:19:17.08,Default - i,,0,0,0,,Üzgünüm millet, ama bu futbol dehası,
Dialogue: 0,0:19:17.08,0:19:20.84,Default - i,,0,0,0,,Tsubasa Ozora ile en uzun süredir arkadaş olan benim!
Dialogue: 0,0:19:21.35,0:19:25.81,Default - i,,0,0,0,,{\t(3941,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Nankatsu'ya taşındığından beri onunla takılıyordum!{\i0}
Dialogue: 0,0:19:26.58,0:19:29.44,Default - i,,0,0,0,,Tsubasa, yine beraber kazanalım!
Dialogue: 0,0:19:29.44,0:19:31.94,Default,,0,0,0,,Senin gibi birinin bana gol atmasına izin verir miyim?!
Dialogue: 0,0:19:31.94,0:19:34.92,Default - i,,0,0,0,,Ishizaki-kun'un atlama kafa vuruşu etkisiz!
Dialogue: 0,0:19:34.92,0:19:36.82,Default - i,,0,0,0,,Hyuga-kun'dan geçilmez bir blok!
Dialogue: 0,0:19:36.82,0:19:37.69,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:19:37.69,0:19:39.19,Default,,0,0,0,,Güzel, Hyuga-san!
Dialogue: 0,0:19:40.79,0:19:44.37,Default - i,,0,0,0,,Ishizaki-kun döndü, topu aldı ve üstten geri bir pas attı!
Dialogue: 0,0:19:44.37,0:19:45.20,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:46.95,0:19:47.70,Default,,0,0,0,,Ahh acıdı!
Dialogue: 0,0:19:47.70,0:19:50.00,Default - i,,0,0,0,,Ishizaki-kun ve herkes...
Dialogue: 0,0:19:51.65,0:19:53.43,Default - i,,0,0,0,,Tsubasa-kun zıpladı!
Dialogue: 0,0:19:58.16,0:19:59.28,Default - i,,0,0,0,,İçerde!
Dialogue: 0,0:19:59.28,0:20:01.59,Default - i,,0,0,0,,Tsubasa-kun'dan bir hava dalışı!
Dialogue: 0,0:20:03.27,0:20:04.60,Default,,0,0,0,,İçerde!
Dialogue: 0,0:20:05.27,0:20:07.10,Default,,0,0,0,,Berabere!
Dialogue: 0,0:20:07.10,0:20:08.60,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:20:08.60,0:20:09.56,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:09.56,0:20:10.60,Default,,0,0,0,,Güzel şut!
Dialogue: 0,0:20:11.03,0:20:12.83,Default - i,,0,0,0,,Nankatsu'dan harika takım oyunu!
Dialogue: 0,0:20:12.83,0:20:16.36,Default - i,,0,0,0,,Saldırıyı bitiren Nankatsu'nun\N Kaptanı Ozora Tsubasa-kun oldu!
Dialogue: 0,0:20:17.09,0:20:20.86,Default - i,,0,0,0,,Doğrudan kaleye giden umutsuz bir hava dalışı!
Dialogue: 0,0:20:20.86,0:20:23.65,Default - i,,0,0,0,,İkinci yarıda 10 dakika oldu ve şampiyon Nankatsu,
Dialogue: 0,0:20:23.65,0:20:26.87,Default - i,,0,0,0,,sonunda 3-3 skorla maçı yakaladı!
Dialogue: 0,0:20:26.87,0:20:28.57,Default,,0,0,0,,Nankatsu'nun gizli gücü.
Dialogue: 0,0:20:28.57,0:20:30.33,Default,,0,0,0,,Tsubasa'nın gizli gücü.
Dialogue: 0,0:20:30.33,0:20:33.21,Default,,0,0,0,,Harika takım oyunu, Nankatsu.
Dialogue: 0,0:20:33.21,0:20:36.60,Default,,0,0,0,,Hırpalanmış ve yaralanmış olmasına rağmen,
Dialogue: 0,0:20:36.60,0:20:41.13,Default,,0,0,0,,Tsubasa gitti ve sonunda puan aldı!
Dialogue: 0,0:20:41.13,0:20:43.01,Default,,0,0,0,,Berabere, Senpai!
Dialogue: 0,0:20:43.56,0:20:44.58,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:45.43,0:20:46.89,Default,,0,0,0,,Şükürler olsun.
Dialogue: 0,0:20:46.89,0:20:48.89,Default,,0,0,0,,Senpai...
Dialogue: 0,0:20:48.89,0:20:51.89,Default,,0,0,0,,Tsubasa, sen bir çocuksun.
Dialogue: 0,0:20:51.89,0:20:54.81,Default,,0,0,0,,Mama-san, başardı!
Dialogue: 0,0:20:54.81,0:20:57.31,Default - i,,0,0,0,,Her ne kadar avantaja sahip olsalar da,
Dialogue: 0,0:20:57.31,0:21:00.63,Default - i,,0,0,0,,Toho Akademi şimdi bir beraberlik puanı ile yakalandı.
Dialogue: 0,0:21:00.63,0:21:04.57,Default - i,,0,0,0,,Maçta 20 dakika kaldı ve şimdi başa dönüyorlar.
Dialogue: 0,0:21:04.57,0:21:05.91,Default,,0,0,0,,Abi...
Dialogue: 0,0:21:05.91,0:21:07.12,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:21:07.12,0:21:08.45,Default,,0,0,0,,Millet...
Dialogue: 0,0:21:08.45,0:21:11.70,Default - i,,0,0,0,,Gördüğünüz gibi Tsubasa-kun'un vücudu sakatlıklarla dolu.
Dialogue: 0,0:21:11.70,0:21:16.35,Default - i,,0,0,0,,Diğer taraftan, Hyuga-kun turnuvadaki ilk maçında oynuyor,
Dialogue: 0,0:21:16.35,0:21:19.09,Default - i,,0,0,0,,ve bu final maçını en iyi durumunda oynuyor.
Dialogue: 0,0:21:19.09,0:21:23.36,Default - i,,0,0,0,,Skor berabere olmasına rağmen \NToho'nun avantajı olduğunu söyleyebiliriz.
Dialogue: 0,0:21:24.54,0:21:27.39,Default,,0,0,0,,Millet, şut çekerken doğru köşeyi hedefleyelim.
Dialogue: 0,0:21:27.39,0:21:28.31,Default,,0,0,0,,Hah?
Dialogue: 0,0:21:28.31,0:21:31.46,Default,,0,0,0,,Wakashimazu-kun'un sol kolu yaralandı gibi görünüyor.
Dialogue: 0,0:21:31.46,0:21:32.89,Default,,0,0,0,,Gerçekten mi, Tsubasa?
Dialogue: 0,0:21:33.73,0:21:37.65,Default,,0,0,0,,Bu yüzden normalde yakaladığı\N topu yumruklayarak kaleyi korudu.
Dialogue: 0,0:21:37.65,0:21:40.65,Default,,0,0,0,,Tsubasa, sen...
Dialogue: 0,0:21:40.65,0:21:44.07,Default,,0,0,0,,Oyun sırasında gerçekten sakince bunu mu gözlemledin?
Dialogue: 0,0:21:44.07,0:21:48.24,Default,,0,0,0,,Sadece, yaralanmalara aşina oldum.
Dialogue: 0,0:21:48.24,0:21:49.78,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:21:50.37,0:21:52.37,Default - i,,0,0,0,,Bu şekilde incinmeye devam edersem,
Dialogue: 0,0:21:52.37,0:21:56.92,Default - i,,0,0,0,,Roberto gibi profesyonel bir futbolcu olamayabilirim.
Dialogue: 0,0:21:57.36,0:21:58.42,Default - i,,0,0,0,,Yine de...
Dialogue: 0,0:21:58.42,0:22:00.92,Default - i,,0,0,0,,Bu maçı kesinlikle kazanacağım.
Dialogue: 0,0:22:00.92,0:22:02.48,Default - i,,0,0,0,,Kaybedemem.
Dialogue: 0,0:22:02.48,0:22:04.33,Default - i,,0,0,0,,Roberto'ya göstereceğim.
Dialogue: 0,0:22:04.33,0:22:07.44,Default - i,,0,0,0,,Ona rekorumu, Japonya'da bıraktığım işareti göstereceğim;
Dialogue: 0,0:22:07.44,0:22:10.76,Default - i,,0,0,0,,ülkede üst üste üç kez şampiyonluk hükmünü!
Dialogue: 0,0:22:11.24,0:22:15.01,Default - i,,0,0,0,,Sonra bu sakatlıklardan kurtulacağım ve futbol evi Brezilya'ya gideceğim.
Dialogue: 0,0:22:15.01,0:22:18.28,Default - i,,0,0,0,,Ülkene meydan okuyacağım Roberto!
Dialogue: 0,0:22:19.75,0:22:35.00,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.61,0:23:59.46,Default,,0,0,0,,50. BÖLÜM: İNATÇI BİR SAVAŞ
Dialogue: 0,0:23:49.61,0:23:59.61,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:00:02.23,0:00:04.94,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:05.86,0:00:08.53,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:09.44,0:00:12.15,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:19.04,0:00:21.87,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:00:21.87,0:00:28.13,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzuketa
Dialogue: 0,0:00:28.13,0:00:34.01,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitte ita no ni
Dialogue: 0,0:00:34.01,0:00:40.60,OPED-TOP,,0,0,0,,kokoro made uchinomesareta kono yoru ni
Dialogue: 0,0:00:40.60,0:00:44.60,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:00:44.60,0:00:49.11,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:00:49.11,0:00:54.70,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:00:54.70,0:00:56.24,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:00:56.24,0:00:57.45,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:00:57.45,0:01:00.95,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:01:00.95,0:01:10.84,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:01:10.84,0:01:11.67,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:11.67,0:01:15.47,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:01:15.47,0:01:19.47,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:01:19.47,0:01:25.73,OPED-TOP,,0,0,0,,kono ai mou ichibyou taritomo
Dialogue: 0,0:01:25.73,0:01:28.56,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:00:02.23,0:00:04.94,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:05.86,0:00:08.53,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:09.44,0:00:12.15,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:19.04,0:00:21.87,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:00:21.87,0:00:28.13,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:00:28.13,0:00:34.01,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:00:34.01,0:00:40.60,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:00:40.60,0:00:44.60,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:00:44.60,0:00:49.11,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:00:49.11,0:00:54.70,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:00:54.70,0:00:56.24,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:00:56.24,0:00:57.45,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:00:57.45,0:01:00.95,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:01:00.95,0:01:10.84,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:01:10.84,0:01:11.67,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:11.67,0:01:15.47,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:01:15.47,0:01:19.47,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:01:19.47,0:01:25.73,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:01:25.73,0:01:28.56,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.46,0:22:44.51,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.51,0:22:50.51,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.51,0:22:56.56,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.56,0:23:01.19,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.82,0:23:07.49,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.82,0:23:14.91,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.91,0:23:20.96,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:20.96,0:23:25.42,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.72,0:23:33.06,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.06,0:23:39.10,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.10,0:23:45.40,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.46,0:22:44.51,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.51,0:22:50.51,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.51,0:22:56.56,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.56,0:23:01.19,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.82,0:23:07.49,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.82,0:23:14.91,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.91,0:23:20.96,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:20.96,0:23:25.42,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.72,0:23:33.06,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.06,0:23:39.10,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.10,0:23:45.40,OPED,,0,0,0,,Bu hırslı gençlik sahada!
