Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:00.00,0:00:04.73,Default - i,,0,0,0,,Nankatsu ile Toho Akademi arasındaki \N Ulusal Ortaokul Futbol Turnuvası final maçı,
Dialogue: 0,0:00:04.73,0:00:07.23,Default - i,,0,0,0,,ve maç en başa döndü!
Dialogue: 0,0:00:08.22,0:00:09.69,Default - i,,0,0,0,,Bu benim sorumluluğum...
Dialogue: 0,0:00:12.12,0:00:13.78,Default - i,,0,0,0,,Savunma çağrısı bile yapamadım.
Dialogue: 0,0:00:13.78,0:00:16.70,Default - i,,0,0,0,,Ve Tsubasa'nın gol atmasını sağladım!
Dialogue: 0,0:00:16.70,0:00:19.33,Default,,0,0,0,,Bu gol benim yüzümden oldu!
Dialogue: 0,0:00:20.91,0:00:25.25,Default,,0,0,0,,Kendim alacağım ve Tiger Shot'umla geri ödeyeceğim!
Dialogue: 0,0:00:20.91,0:00:25.25,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:00:25.25,0:00:26.01,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:00:26.01,0:00:26.75,Default,,0,0,0,,Durdurun onu!
Dialogue: 0,0:00:28.34,0:00:30.05,Default - i,,0,0,0,,Izawa-kun onu durduramıyor!
Dialogue: 0,0:00:30.05,0:00:31.15,Default - i,,0,0,0,,Başaracağım!
Dialogue: 0,0:00:31.15,0:00:33.59,Default - i,,0,0,0,,Yoluma çıkmanıza izin vermeyeceğim!
Dialogue: 0,0:00:33.59,0:00:35.05,Default,,0,0,0,,Onu durduracağım!
Dialogue: 0,0:00:37.41,0:00:39.85,Default - i,,0,0,0,,Bu sefer, Hyuga-kun havaya uçtu!
Dialogue: 0,0:00:42.43,0:00:44.94,Default - i,,0,0,0,,Takasugi-kun'a faul düdüğü çaldı.
Dialogue: 0,0:00:44.94,0:00:46.69,Default,,0,0,0,,Kahretsin, bir adım daha ve...
Dialogue: 0,0:00:48.08,0:00:52.19,Default,,0,0,0,,Bir adım daha atsam topa vururdum ve sen kasten faul yaptın!
Dialogue: 0,0:00:52.19,0:00:53.26,Default,,0,0,0,,Ne?!
Dialogue: 0,0:00:53.26,0:00:53.95,Default,,0,0,0,,Bırak beni!
Dialogue: 0,0:00:53.95,0:00:54.97,Default,,0,0,0,,Seni varya...
Dialogue: 0,0:00:54.97,0:00:55.95,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:00:55.95,0:00:57.20,Default,,0,0,0,,Yapmayın!
Dialogue: 0,0:00:57.20,0:01:00.87,Default - i,,0,0,0,,Fiziksel oyundan sonra öfke alevleniyor!
Dialogue: 0,0:01:00.87,0:01:02.20,Default - i,,0,0,0,,Bu iyi değil.
Dialogue: 0,0:01:03.77,0:01:06.88,Default - i,,0,0,0,,Bir kart gösterilecek gibi görünüyor.
Dialogue: 0,0:01:06.88,0:01:10.12,Default - i,,0,0,0,,Kırmızı kart olursa, oyuncu derhal çıkarılacak...!
Dialogue: 0,0:01:11.50,0:01:31.50,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \N{\c&HB1351A&}İnstagram: AnimeSeverlerrr
Dialogue: 0,0:02:41.80,0:02:46.81,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}50. BÖLÜM: \NİNATÇI BİR SAVAŞ
Dialogue: 0,0:02:46.93,0:02:49.77,Default - i,,0,0,0,,Sarı kart!
Dialogue: 0,0:02:49.77,0:02:53.52,Default - i,,0,0,0,,Fiziksel oynayan, Hyuga-kun ve Takasugi-kun için de bir uyarı!
Dialogue: 0,0:02:53.52,0:02:55.20,Default,,0,0,0,,Sarı Kart...
Dialogue: 0,0:02:55.20,0:02:57.28,Default,,0,0,0,,Bir tane dahası oyundan çıkarılmak demek.
Dialogue: 0,0:02:57.28,0:03:01.28,Default,,0,0,0,,Heyecanınızı anlayabiliyorum, ama bu bir futbol maçı.
Dialogue: 0,0:03:01.28,0:03:04.48,Default,,0,0,0,,Siz ikiniz bu tür hareketlerden kaçınmalısınız.
Dialogue: 0,0:03:04.48,0:03:05.49,Default,,0,0,0,,Tamam.
Dialogue: 0,0:03:05.49,0:03:06.68,Default,,0,0,0,,Üzgünüm.
Dialogue: 0,0:03:07.50,0:03:08.97,Default,,0,0,0,,Bunun için üzgünüm.
Dialogue: 0,0:03:08.97,0:03:10.46,Default,,0,0,0,,A-Ah.
Dialogue: 0,0:03:13.04,0:03:16.47,Default,,0,0,0,,Berabere olmamız senin suçun değil.
Dialogue: 0,0:03:16.47,0:03:20.30,Default,,0,0,0,,Birinin sorumluluğu üstlenmesi gerekiyorsa, hepimiz suçluyuz.
Dialogue: 0,0:03:20.30,0:03:22.90,Default,,0,0,0,,Kendini sorumlu hissetmene gerek yok, Hyuga-san.
Dialogue: 0,0:03:22.90,0:03:24.35,Default,,0,0,0,,Burada hepimiz bir takımız.
Dialogue: 0,0:03:24.77,0:03:26.01,Default,,0,0,0,,Takeshi.
Dialogue: 0,0:03:26.01,0:03:28.59,Default,,0,0,0,,Ama yine de, duygularına yenildin,
Dialogue: 0,0:03:28.59,0:03:31.18,Default,,0,0,0,,ve Nankatsu'ya tek başına saldırdın...
Dialogue: 0,0:03:31.18,0:03:34.96,Default,,0,0,0,,Hala o tarafının olduğunu görünce sevindik Hyuga-san.
Dialogue: 0,0:03:36.32,0:03:37.68,Default,,0,0,0,,Millet...
Dialogue: 0,0:03:38.31,0:03:39.54,Default,,0,0,0,,Kötü bir alışkanlığım.
Dialogue: 0,0:03:39.54,0:03:40.95,Default,,0,0,0,,Çok çabuk parlarım.
Dialogue: 0,0:03:42.02,0:03:45.69,Default,,0,0,0,,Doğru. Toho Akademi'nin kombine gücü ile,
Dialogue: 0,0:03:45.69,0:03:49.35,Default,,0,0,0,,dördüncü gölümüzü ve liderliği geri alalım!
Dialogue: 0,0:03:49.35,0:03:50.21,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:53.16,0:03:54.46,Default - i,,0,0,0,,Çok mutluyum.
Dialogue: 0,0:03:54.46,0:03:57.40,Default - i,,0,0,0,,Bunca zaman onlarla futbol oynayabildiğim için...
Dialogue: 0,0:03:57.40,0:03:59.92,Default - i,,0,0,0,,Gerçekten mutluyum!
Dialogue: 0,0:04:00.47,0:04:04.93,Default - i,,0,0,0,,Görünüşe göre Hyuga-kun serbest \Nvuruşu kullanacak ve oyuna devam edecek.
Dialogue: 0,0:04:04.93,0:04:07.64,Default - i,,0,0,0,,Doğrudan gol için deneyecek mi?
Dialogue: 0,0:04:07.64,0:04:10.07,Default,,0,0,0,,Dinleyin! Bundan kaçınmayı bile düşünmeyin!
Dialogue: 0,0:04:10.07,0:04:11.02,Default,,0,0,0,,Biliyoruz.
Dialogue: 0,0:04:14.55,0:04:16.45,Default - i,,0,0,0,,Bir şut değil!
Dialogue: 0,0:04:16.45,0:04:18.90,Default - i,,0,0,0,,Toho'nun önemli golcüsü Sorimachi-kun'a bir pas!
Dialogue: 0,0:04:23.11,0:04:23.86,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:04:24.37,0:04:25.53,Default,,0,0,0,,İyi, Tsubasa!
Dialogue: 0,0:04:25.53,0:04:26.70,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:04:27.66,0:04:29.83,Default,,0,0,0,,Pekala! Tsubasa'nın hatırına hadi atak yapalım!
Dialogue: 0,0:04:30.91,0:04:34.17,Default - i,,0,0,0,,Wakashimazu'nun sol kolu gerçekten incindiyse,
Dialogue: 0,0:04:34.17,0:04:36.54,Default - i,,0,0,0,,o zaman kalenin sağ köşesi onun zayıflığı!
Dialogue: 0,0:04:36.54,0:04:38.96,Default - i,,0,0,0,,Seni bir kez daha deneyeyim!
Dialogue: 0,0:04:39.96,0:04:40.76,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:04:41.72,0:04:44.53,Default - i,,0,0,0,,Sağ tarafa doğru gitti ve dışarı çıktı.
Dialogue: 0,0:04:44.53,0:04:46.03,Default,,0,0,0,,Hiç şüphe yok.
Dialogue: 0,0:04:46.03,0:04:50.61,Default,,0,0,0,,Evet, sağ köşeye şut çeksen bile, sağ eliyle kurtarmaya çalıştı.
Dialogue: 0,0:04:51.14,0:04:54.34,Default,,0,0,0,,Wakashimazu'nun incindiğini fark etmiş gibiler.
Dialogue: 0,0:04:54.34,0:04:54.98,Default,,0,0,0,,Ne?
Dialogue: 0,0:04:54.98,0:04:57.68,Default,,0,0,0,,Toho şimdiye kadar Wakashimazu sayesinde 
Dialogue: 0,0:04:57.68,0:05:00.31,Default,,0,0,0,,kazanmayı başardı ve oyunda kaldı.
Dialogue: 0,0:05:00.31,0:05:04.03,Default,,0,0,0,,Dinleyin! Şimdi de Wakashimazu'nun\N savunmadaki payına yardım edeceğiz!
Dialogue: 0,0:05:05.80,0:05:08.20,Default - i,,0,0,0,,Şimdi Toho'nun hücumu başladı!
Dialogue: 0,0:05:08.20,0:05:10.36,Default,,0,0,0,,Tamamdır! Git ve al, Toho!
Dialogue: 0,0:05:12.66,0:05:14.07,Default - i,,0,0,0,,Hyuga-kun.
Dialogue: 0,0:05:14.07,0:05:14.91,Default - i,,0,0,0,,Tsubasa.
Dialogue: 0,0:05:15.46,0:05:18.64,Default - i,,0,0,0,,İncinmene rağmen, gözlerinde hala hayat var.
Dialogue: 0,0:05:18.64,0:05:21.30,Default - i,,0,0,0,,Gözlerin böyle olduğu sürece, merhamet edemem!
Dialogue: 0,0:05:21.30,0:05:23.17,Default - i,,0,0,0,,Tüm gücümle seninle savaşacağım!
Dialogue: 0,0:05:24.81,0:05:28.72,Default - i,,0,0,0,,Tsubasa-kun refleksle topa uzandı, ama havaya uçtu!
Dialogue: 0,0:05:28.72,0:05:29.47,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:05:30.22,0:05:31.18,Default,,0,0,0,,Sorimachi!
Dialogue: 0,0:05:31.18,0:05:31.68,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:05:31.68,0:05:34.97,Default - i,,0,0,0,,Hyuga-kun ve Sorimachi-kun arasında güzel verkaç pası.
Dialogue: 0,0:05:34.97,0:05:36.39,Default,,0,0,0,,Hyuga yine takım oyunu oynuyor!
Dialogue: 0,0:05:37.44,0:05:38.40,Default,,0,0,0,,Pekala!
Dialogue: 0,0:05:39.59,0:05:40.36,Default,,0,0,0,,Durdurun!
Dialogue: 0,0:05:40.36,0:05:41.77,Default,,0,0,0,,Tiger Shot düz uçuyor!
Dialogue: 0,0:05:40.36,0:05:41.77,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:05:41.77,0:05:45.15,Default,,0,0,0,,Güçlü olabilir, ancak önüne geçersek, durdurabiliriz!
Dialogue: 0,0:05:45.15,0:05:51.72,Default,,0,0,0,,Nankatsu, sadece sizi yenmek için yarattığım Tiger Shot!
Dialogue: 0,0:05:51.72,0:05:52.91,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:05:45.15,0:05:51.72,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:05:53.92,0:05:58.42,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:05:53.92,0:05:58.42,Default - i,,0,0,0,,Hyuga'nın Tiger Shot'u, önüne cesurca atlayan üç savunmacıyı savurdu!
Dialogue: 0,0:05:59.50,0:06:01.17,Default - i,,0,0,0,,Ama yakaladı!
Dialogue: 0,0:06:01.17,0:06:02.09,Default,,0,0,0,,Ne?!
Dialogue: 0,0:06:02.58,0:06:07.49,Default - i,,0,0,0,,Morisaki-kun bloklama etkisiyle\N zayıflamış Tiger Shot'u dalarak yakaladı!
Dialogue: 0,0:06:02.58,0:06:07.49,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:06:03.84,0:06:05.06,Default-TOP,,0,0,0,,Aferin!
Dialogue: 0,0:06:05.06,0:06:06.59,Default-TOP,,0,0,0,,Bu yüzden Nankatsu şampiyon!
Dialogue: 0,0:06:07.49,0:06:09.09,Default,,0,0,0,,Güzel yakalayış Morisaki!
Dialogue: 0,0:06:09.09,0:06:12.35,Default,,0,0,0,,Tiger Shot'umu durdurdular...
Dialogue: 0,0:06:09.09,0:06:12.35,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:06:13.20,0:06:14.32,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:06:15.25,0:06:16.47,Default,,0,0,0,,Gönder!
Dialogue: 0,0:06:16.47,0:06:17.60,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:06:17.60,0:06:19.31,Default,,0,0,0,,Tamam, al hadi!
Dialogue: 0,0:06:20.40,0:06:22.24,Default - i,,0,0,0,,Şimdi Tsubasa-kun topu aldı!
Dialogue: 0,0:06:22.24,0:06:23.85,Default - i,,0,0,0,,Nankatsu'dan bir karşı saldırı!
Dialogue: 0,0:06:23.85,0:06:24.53,Default,,0,0,0,,Bu kötü!
Dialogue: 0,0:06:24.53,0:06:25.24,Default,,0,0,0,,Geri dönün!
Dialogue: 0,0:06:25.24,0:06:29.91,Default - i,,0,0,0,,Hyuga-kun'nun Tiger Shot'u olduğu gibi, benim de Drive Shot'um var.
Dialogue: 0,0:06:25.24,0:06:29.91,Default-TOP,,0,0,0,,{\fs65}Tiger Shot: Kaplan Vuruşu Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:31.71,0:06:33.76,Default - i,,0,0,0,,Ama... bu doğru gelmiyor.
Dialogue: 0,0:06:33.76,0:06:35.89,Default - i,,0,0,0,,Omzum şiddetle yanıyor,
Dialogue: 0,0:06:35.89,0:06:40.83,Default - i,,0,0,0,,ve sol bacağım bir süredir uyuşmuş durumda.
Dialogue: 0,0:06:40.83,0:06:41.83,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:06:42.40,0:06:44.09,Default - i,,0,0,0,,Yine de şut çekmem gerekiyor!
Dialogue: 0,0:06:44.66,0:06:46.34,Default - i,,0,0,0,,Şut çekmem gerek!
Dialogue: 0,0:06:46.34,0:06:49.80,Default - i,,0,0,0,,Tsubasa-kun, Drive Shot mu çekecek?!
Dialogue: 0,0:06:46.34,0:06:49.80,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:50.80,0:06:53.18,Default - i,,0,0,0,,Sawada-kun topu alıyor!
Dialogue: 0,0:06:53.18,0:06:54.14,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:07:00.30,0:07:01.35,Default - i,,0,0,0,,Tsubasa-san...
Dialogue: 0,0:07:02.73,0:07:05.36,Default - i,,0,0,0,,Bu korkutucu gözler...
Dialogue: 0,0:07:05.36,0:07:08.08,Default - i,,0,0,0,,Bakışı Hyuga-san'nınkinden bile daha keskin.
Dialogue: 0,0:07:08.08,0:07:11.36,Default - i,,0,0,0,,Bunlar gerçek bir savaşçının gözleri mi?
Dialogue: 0,0:07:13.13,0:07:14.41,Default - i,,0,0,0,,Skor hala berabere!
Dialogue: 0,0:07:14.96,0:07:16.95,Default - i,,0,0,0,,Başka bir gol atana kadar durmayacağım!
Dialogue: 0,0:07:16.95,0:07:18.83,Default,,0,0,0,,Kaptanımızdan beklendiği gibi!
Dialogue: 0,0:07:18.83,0:07:20.52,Default,,0,0,0,,Tamamdır, hadi Tsubasa'yı destekleyelim!
Dialogue: 0,0:07:20.52,0:07:21.58,Default,,0,0,0,,Saldırın!
Dialogue: 0,0:07:21.58,0:07:22.71,Default,,0,0,0,,Millet!
Dialogue: 0,0:07:22.71,0:07:23.21,Default,,0,0,0,,Alın!
Dialogue: 0,0:07:23.65,0:07:25.36,Default - i,,0,0,0,,Şimdi Nankatsu saldırmaya başladı!
Dialogue: 0,0:07:25.36,0:07:27.21,Default - i,,0,0,0,,Maçta 14 dakika kaldı!
Dialogue: 0,0:07:27.21,0:07:28.27,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:07:28.27,0:07:30.17,Default,,0,0,0,,Wakashimazu'nun sol kolu yaralandı!
Dialogue: 0,0:07:30.17,0:07:31.97,Default,,0,0,0,,Bu zayıflığı kullanın!
Dialogue: 0,0:07:31.97,0:07:33.39,Default,,0,0,0,,K-Kahretsin...
Dialogue: 0,0:07:33.39,0:07:36.25,Default,,0,0,0,,Toho'nun savunma gücünün gerçek boyutunu gösterelim!
Dialogue: 0,0:07:36.25,0:07:37.85,Default,,0,0,0,,Dördüncü bir gol atmanıza izin vermeyeceğiz!
Dialogue: 0,0:07:39.60,0:07:42.48,Default - i,,0,0,0,,Kaleye yakın olup ilerlemeye devam edemediğimizde,
Dialogue: 0,0:07:42.48,0:07:45.36,Default - i,,0,0,0,,her zaman topu bir defa geri göndeririz.
Dialogue: 0,0:07:45.36,0:07:47.46,Default - i,,0,0,0,,Evet, Nankatsu'nun oyun planı her zaman 
Dialogue: 0,0:07:47.46,0:07:49.57,Default - i,,0,0,0,,oyun kurucumuz Tsubasa'ya geri göndermektir.
Dialogue: 0,0:07:49.57,0:07:52.20,Default - i,,0,0,0,,Şu anda yaralandığını biliyoruz.
Dialogue: 0,0:07:52.20,0:07:54.28,Default - i,,0,0,0,,Buna rağmen topu sana göndereceğiz.
Dialogue: 0,0:07:55.08,0:07:58.83,Default - i,,0,0,0,,Toho, kale önünde savunmasını \Ngüçlendirdi ve Tsubasa-kun'u tutmayı bıraktı!
Dialogue: 0,0:07:58.83,0:07:59.83,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:59.83,0:08:00.71,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:08:00.71,0:08:02.06,Default - i,,0,0,0,,Drive Shot zamanı!
Dialogue: 0,0:08:00.71,0:08:02.06,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:02.06,0:08:05.04,Default - i,,0,0,0,,Şimdi sağ köşeyi hedeflersem, kesin gol atabilirim!
Dialogue: 0,0:08:05.04,0:08:07.84,Default - i,,0,0,0,,Tsubasa bu atış için hazırlık gücünü toplar!
Dialogue: 0,0:08:08.42,0:08:10.84,Default - i,,0,0,0,,Zaferin gökkuşağını boyayabilir mi?
Dialogue: 0,0:08:10.84,0:08:12.62,Default,,0,0,0,,İstersen gel Tsubasa!
Dialogue: 0,0:08:12.62,0:08:14.34,Default,,0,0,0,,Yalnız sağ elimle duracağım!
Dialogue: 0,0:08:16.15,0:08:18.49,Default,,0,0,0,,{\bord0\blur0.6\c&H00FFFF&}Ti{\c&H00F7FF&}g{\c&H00E9FF&}er {\c&H00D8FF&}S{\c&H00CBFF&}ho{\c&H00BFFF&}t{\c&H00AEFF&}! {aka tiger c*ckblockku!}
Dialogue: 0,0:08:16.15,0:08:18.49,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:08:18.49,0:08:20.68,Default - i,,0,0,0,,Yandan bir rüzgâr esiyor gibi esiyor!
Dialogue: 0,0:08:22.73,0:08:25.06,Default - i,,0,0,0,,Vurulmadan topu uzaklaştırıyor!
Dialogue: 0,0:08:25.06,0:08:28.82,Default - i,,0,0,0,,Hyuga-kun, Tiger Shot ile Drive Shot'u mağlup etti!
Dialogue: 0,0:08:25.06,0:08:28.82,Default-TOP,,0,0,0,,{\fs65}Tiger Shot: Kaplan Vuruşu Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:28.82,0:08:31.82,Default,,0,0,0,,Ne olursa olsun, dördüncü golü vermeyeceğim!
Dialogue: 0,0:08:33.33,0:08:34.53,Default,,0,0,0,,Hyuga-kun...
Dialogue: 0,0:08:34.53,0:08:37.84,Default - i,,0,0,0,,Stadyum bu büyük savaşın gösterisiyle suskun kaldı!
Dialogue: 0,0:08:37.84,0:08:41.41,Default - i,,0,0,0,,Bu önemli final maçında 13 dakika kaldı!
Dialogue: 0,0:08:44.44,0:08:49.44,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:08:49.42,0:08:52.42,Default - i,,0,0,0,,Maç Nankatsu takımının atışı ile devam ediyor.
Dialogue: 0,0:08:52.42,0:08:54.17,Default,,0,0,0,,Kaybetmeyeceğiz!
Dialogue: 0,0:08:54.17,0:08:56.26,Default,,0,0,0,,Evet, kaybedemeyiz!
Dialogue: 0,0:08:56.26,0:08:57.10,Default,,0,0,0,,İşte!
Dialogue: 0,0:08:59.39,0:09:00.99,Default,,0,0,0,,Karşı saldırı zamanı!
Dialogue: 0,0:09:00.99,0:09:02.93,Default,,0,0,0,,Evet, kaybedemeyiz!
Dialogue: 0,0:09:02.93,0:09:07.23,Default - i,,0,0,0,,Hyuga-kun'nun oyunu kaplanların dövüş ruhuna ilham mı verdi?
Dialogue: 0,0:09:09.62,0:09:11.85,Default - i,,0,0,0,,Top başarıyla Sorimachi-kun'a ulaştı!
Dialogue: 0,0:09:11.85,0:09:13.92,Default - i,,0,0,0,,Şut çekme şansı var!
Dialogue: 0,0:09:13.92,0:09:16.24,Default - i,,0,0,0,,Ancak, Sorimachi-kun şut atmıyor!
Dialogue: 0,0:09:16.24,0:09:18.12,Default,,0,0,0,,Lütfen şut çek, Kaptan!
Dialogue: 0,0:09:19.49,0:09:23.25,Default,,0,0,0,,Haklı! Bu yüzden sahaya döndün, kaptan!
Dialogue: 0,0:09:23.25,0:09:25.95,Default,,0,0,0,,Toho Akademi'yi zafere götüren son galibiyet
Dialogue: 0,0:09:25.95,0:09:28.59,Default,,0,0,0,,golünü atmak senin işin, Hyuga-san!
Dialogue: 0,0:09:28.59,0:09:29.79,Default - i,,0,0,0,,Millet...
Dialogue: 0,0:09:30.63,0:09:33.88,Default - i,,0,0,0,,Top kalenin önünde tutulmayan Hyuga-kun'a gidiyor!
Dialogue: 0,0:09:33.88,0:09:35.51,Default,,0,0,0,,Devam et, Kojiro!
Dialogue: 0,0:09:36.01,0:09:37.77,Default - i,,0,0,0,,Skor yapacağım millet!
Dialogue: 0,0:09:37.77,0:09:40.35,Default - i,,0,0,0,,Hyuga-kun'nun Tiger Shot'u!
Dialogue: 0,0:09:37.77,0:09:40.35,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:09:41.01,0:09:42.27,Default,,0,0,0,,Tamamdır, başardık!
Dialogue: 0,0:09:44.52,0:09:45.32,Default - i,,0,0,0,,Durduracağım.
Dialogue: 0,0:09:45.32,0:09:47.31,Default - i,,0,0,0,,Bunu durdurabilecek tek kişi benim!
Dialogue: 0,0:09:47.31,0:09:48.23,Default,,0,0,0,,Çok umursamaz!
Dialogue: 0,0:09:48.23,0:09:51.15,Default,,0,0,0,,Hyuga'nın Tiger Shot'unu bu yakınlıktan yerse,
Dialogue: 0,0:09:48.23,0:09:51.15,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:09:51.15,0:09:54.61,Default,,0,0,0,,bu defa futbol oynamaya devam etmesinin imkanı yok!
Dialogue: 0,0:09:55.17,0:09:57.70,Default,,0,0,0,,Çok tehlikeli! Yapma, Tsubasa-kun!
Dialogue: 0,0:09:57.70,0:09:59.37,Default,,0,0,0,,Hyuga-kun, lütfen şut çekme! 
Dialogue: 0,0:10:00.37,0:10:01.12,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:01.12,0:10:02.63,Default - i,,0,0,0,,Kendini durdurdu!
Dialogue: 0,0:10:02.63,0:10:04.75,Default - i,,0,0,0,,Hyuga-kun şut çekmiyor!
Dialogue: 0,0:10:04.75,0:10:07.95,Default - i,,0,0,0,,Tsubasa, bu bir merhamet eylemi değil!
Dialogue: 0,0:10:07.95,0:10:11.45,Default - i,,0,0,0,,Durmamın tek sebebi, herkesin pasının,
Dialogue: 0,0:10:11.45,0:10:14.71,Default - i,,0,0,0,,kesin bir gol olmasını sağlamaktı!
Dialogue: 0,0:10:14.71,0:10:17.22,Default - i,,0,0,0,,Hyuga-kun'dan sakin bir karar!
Dialogue: 0,0:10:17.22,0:10:19.22,Default - i,,0,0,0,,Tiger Shot bir kez daha ateşlendi!
Dialogue: 0,0:10:17.22,0:10:19.22,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:10:23.44,0:10:24.14,Default - i,,0,0,0,,Ne?!
Dialogue: 0,0:10:24.14,0:10:26.94,Default - i,,0,0,0,,Tsubasa-kun tarafından gizlenirken, Ishizaki-kun geride kaldı ve atladı!
Dialogue: 0,0:10:26.94,0:10:30.01,Default - i,,0,0,0,,Hyuga-kun farkında değildi!
Dialogue: 0,0:10:30.01,0:10:30.93,Default - i,,0,0,0,,Kahretsin!
Dialogue: 0,0:10:30.93,0:10:33.32,Default - i,,0,0,0,,Tsubasa yüzünden onu göremedim...
Dialogue: 0,0:10:33.32,0:10:35.99,Default,,0,0,0,,Acıdıııı...
Dialogue: 0,0:10:35.99,0:10:37.16,Default,,0,0,0,,Başardın!
Dialogue: 0,0:10:37.16,0:10:39.99,Default,,0,0,0,,Güzel Kafa Bloğu, Ishizaki!
Dialogue: 0,0:10:39.99,0:10:43.49,Default,,0,0,0,,Lanet olsun acıtıyor!
Dialogue: 0,0:10:42.29,0:10:43.49,Default-TOP,,0,0,0,,Ishizaki-kun...
Dialogue: 0,0:10:46.22,0:10:48.41,Default,,0,0,0,,Onun önüne atlamamış olsaydın,
Dialogue: 0,0:10:48.41,0:10:50.00,Default,,0,0,0,,engellememe imkân yoktu.
Dialogue: 0,0:10:50.92,0:10:54.93,Default,,0,0,0,,Bu da seninle benim aramda bir kombinasyon oyunu, Tsubasa.
Dialogue: 0,0:10:54.93,0:10:55.96,Default,,0,0,0,,Ishizaki-kun...
Dialogue: 0,0:10:55.96,0:10:58.86,Default,,0,0,0,,Misaki ile Altın ikilisini kaybettin,
Dialogue: 0,0:10:58.86,0:11:01.83,Default,,0,0,0,,ama buna altınla çakıl taşı arasındaki ikili diyebiliriz.
Dialogue: 0,0:11:01.83,0:11:03.70,Default,,0,0,0,,Bu doğru değil, Ishizaki.
Dialogue: 0,0:11:03.70,0:11:04.35,Default,,0,0,0,,Hah?
Dialogue: 0,0:11:04.35,0:11:07.63,Default,,0,0,0,,Bu oyun Nankatsu'nun sahip olduğu en iyi altın ikiliydi.
Dialogue: 0,0:11:07.63,0:11:11.13,Default,,0,0,0,,Tsubasa ve Ishizaki olduğunda, \Ndüzensiz ikili olarak adlandırmalıyız.
Dialogue: 0,0:11:12.36,0:11:14.91,Default,,0,0,0,,Pekala, köşe vuruşunu da engelleyelim.
Dialogue: 0,0:11:14.91,0:11:17.20,Default,,0,0,0,,Nankatsu olarak bu sefer birlikte gidelim! 
Dialogue: 0,0:11:17.20,0:11:17.86,Default,,0,0,0,,Tamam!
Dialogue: 0,0:11:18.33,0:11:19.42,Default,,0,0,0,,Millet...
Dialogue: 0,0:11:20.86,0:11:22.35,Default,,0,0,0,,Kalkabilir misin?
Dialogue: 0,0:11:22.35,0:11:23.22,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:25.70,0:11:28.12,Default - i,,0,0,0,,Teşekkürler Ishizaki-kun.
Dialogue: 0,0:11:28.76,0:11:34.13,Default - i,,0,0,0,,{\t(4641,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Nankatsu şehrine taşındığımda\N edindiğim ilk arkadaş oldun, Ishizaki-kun.
Dialogue: 0,0:11:34.92,0:11:38.32,Default - i,,0,0,0,,Toho yetenek avcılarının teklifini reddetmemin,
Dialogue: 0,0:11:38.32,0:11:41.88,Default - i,,0,0,0,,nedenlerinden biri Ishizaki-kun, Nankatsu'da kalmandı.
Dialogue: 0,0:11:42.54,0:11:45.56,Default - i,,0,0,0,,Maç Toho'nun köşe vuruşu ile devam edecek,
Dialogue: 0,0:11:45.56,0:11:48.56,Default - i,,0,0,0,,ancak Hyuga-kun tamamen tutuluyor.
Dialogue: 0,0:11:48.56,0:11:49.85,Default,,0,0,0,,Imai-san!
Dialogue: 0,0:11:49.85,0:11:51.56,Default,,0,0,0,,Bana ver!
Dialogue: 0,0:11:51.56,0:11:52.76,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:11:53.52,0:11:55.91,Default - i,,0,0,0,,Top Sawada-kun'a gidiyor!
Dialogue: 0,0:11:55.91,0:11:57.42,Default - i,,0,0,0,,Kısa bir köşe vuruşuydu.
Dialogue: 0,0:11:57.42,0:11:58.23,Default,,0,0,0,,İşte!
Dialogue: 0,0:11:58.82,0:11:59.61,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:00.78,0:12:01.45,Default - i,,0,0,0,,Bu...
Dialogue: 0,0:12:01.45,0:12:03.95,Default - i,,0,0,0,,Kaleci Wakashimazu-kun geliyor!
Dialogue: 0,0:12:04.16,0:12:07.28,Default - i,,0,0,0,,Sol kolumu kullanamasam bile, hala şut çekebilirim!
Dialogue: 0,0:12:07.28,0:12:11.00,Default - i,,0,0,0,,Herkesin savunmayla yükümlü \Nolmasına izin verdiğim için yapacağım.
Dialogue: 0,0:12:11.00,0:12:12.79,Default,,0,0,0,,Al bunu Nankatsu!
Dialogue: 0,0:12:13.54,0:12:14.63,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:12:15.17,0:12:17.50,Default - i,,0,0,0,,Takasugi-kun engelledi!
Dialogue: 0,0:12:18.92,0:12:21.30,Default - i,,0,0,0,,Top kalenin önünde yükseliyor!
Dialogue: 0,0:12:21.30,0:12:22.63,Default,,0,0,0,,Neden her zaman ben...?
Dialogue: 0,0:12:22.63,0:12:24.18,Default,,0,0,0,,Güzel, benim!
Dialogue: 0,0:12:24.18,0:12:25.14,Default,,0,0,0,,Bana bırakın!
Dialogue: 0,0:12:25.57,0:12:27.93,Default - i,,0,0,0,,Izawa-kun savaşı kazandı!
Dialogue: 0,0:12:30.07,0:12:32.08,Default - i,,0,0,0,,Tsubasa-kun topu uzaklaştırıyor ve takımını rahatlatıyor.
Dialogue: 0,0:12:32.08,0:12:33.56,Default - i,,0,0,0,,Nankatsu krizden kurtuldu!
Dialogue: 0,0:12:33.56,0:12:35.77,Default,,0,0,0,,Hırpalanmış bedenine rağmen harika bir iş çıkardın.
Dialogue: 0,0:12:36.64,0:12:37.44,Default,,0,0,0,,Bu!
Dialogue: 0,0:12:38.45,0:12:40.21,Default,,0,0,0,,Topu uzaklaştırmadı.
Dialogue: 0,0:12:40.21,0:12:41.19,Default,,0,0,0,,Bir şut çekti.
Dialogue: 0,0:12:41.19,0:12:42.57,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:12:42.57,0:12:46.32,Default - i,,0,0,0,,Kalecileri Wakashimazu-kun, saldırıya katılmaya başladığı için,
Dialogue: 0,0:12:46.32,0:12:48.33,Default - i,,0,0,0,,Toho'nun hedefi tamamen açık kaldı!
Dialogue: 0,0:12:50.20,0:12:53.71,Default - i,,0,0,0,,Top kaleye doğru zıplayarak ilerliyor!
Dialogue: 0,0:12:54.13,0:12:56.58,Default,,0,0,0,,Kimsenin bana gol atmasına izin vermeyeceğim!
Dialogue: 0,0:13:05.06,0:13:06.34,Default,,0,0,0,,İşte!
Dialogue: 0,0:13:07.58,0:13:10.49,Default - i,,0,0,0,,Eğer Tsubasa her zamanki halinde olsaydı,
Dialogue: 0,0:13:10.49,0:13:11.85,Default - i,,0,0,0,,yetişmemin imkanı yoktu.
Dialogue: 0,0:13:14.81,0:13:17.80,Default - i,,0,0,0,,Kahretsin, böyle Hyuga-san'a topu vermek imkansız.
Dialogue: 0,0:13:17.80,0:13:19.40,Default,,0,0,0,,Bana aldırma!
Dialogue: 0,0:13:19.40,0:13:21.46,Default,,0,0,0,,Beni ne kadar çok tutarlarsa,
Dialogue: 0,0:13:21.46,0:13:24.09,Default,,0,0,0,,sana o kadar fazla boşluk veriyorlar!
Dialogue: 0,0:13:24.09,0:13:26.04,Default,,0,0,0,,Son golü almak zorunda değilim!
Dialogue: 0,0:13:26.04,0:13:28.41,Default,,0,0,0,,Sadece kazanmayı düşünün, başka bir şey değil!
Dialogue: 0,0:13:28.41,0:13:29.97,Default,,0,0,0,,Hyuga-san.
Dialogue: 0,0:13:29.97,0:13:30.66,Default,,0,0,0,,Pekala!
Dialogue: 0,0:13:31.04,0:13:32.16,Default,,0,0,0,,Gidiyorum!
Dialogue: 0,0:13:34.96,0:13:35.96,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:13:35.96,0:13:37.21,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:13:37.21,0:13:38.83,Default,,0,0,0,,Yanlış olan ne, Misugi?
Dialogue: 0,0:13:38.83,0:13:41.50,Default,,0,0,0,,Tsubasa bir süredir bir adım bile hareket etmedi.
Dialogue: 0,0:13:42.63,0:13:44.01,Default - i,,0,0,0,,İyi değil.
Dialogue: 0,0:13:44.01,0:13:46.46,Default - i,,0,0,0,,Ayakta zar zor durabiliyorum.
Dialogue: 0,0:13:46.46,0:13:47.93,Default - i,,0,0,0,,Vücudum...
Dialogue: 0,0:13:47.93,0:13:50.10,Default - i,,0,0,0,,Hareket etmiyor.
Dialogue: 0,0:13:50.10,0:13:52.68,Default - i,,0,0,0,,Üzgünüm. Üzgünüm millet.
Dialogue: 0,0:13:52.68,0:13:53.97,Default,,0,0,0,,Koç!
Dialogue: 0,0:13:54.87,0:13:56.69,Default,,0,0,0,,Doktor Kamijo!
Dialogue: 0,0:13:56.69,0:14:00.02,Default - i,,0,0,0,,Nankatsu son anlarda oyuncu değişimine mi hazırlanıyor?
Dialogue: 0,0:14:01.02,0:14:03.98,Default - i,,0,0,0,,Kaptanları Tsubasa-kun'u mu değiştirecekler?
Dialogue: 0,0:14:04.65,0:14:05.95,Default - i,,0,0,0,,Ne dedin?
Dialogue: 0,0:14:05.95,0:14:07.53,Default - i,,0,0,0,,Tsubasa'nın yerine mi geçeceğini söylüyorsun?
Dialogue: 0,0:14:08.23,0:14:10.00,Default - i,,0,0,0,,10 numara...
Dialogue: 0,0:14:10.00,0:14:11.28,Default - i,,0,0,0,,Değiştirildim...
Dialogue: 0,0:14:11.98,0:14:15.91,Default - i,,0,0,0,,Tsubasa, 10 Brezilya'da asın numarasıdır.
Dialogue: 0,0:14:15.91,0:14:18.33,Default - i,,0,0,0,,Bu herkesin olmaya çalıştığı bir sayı.
Dialogue: 0,0:14:19.49,0:14:21.30,Default - i,,0,0,0,,Roberto...
Dialogue: 0,0:14:21.30,0:14:22.94,Default - i,,0,0,0,,Ama elden bir şey gelmiyor.
Dialogue: 0,0:14:22.94,0:14:26.30,Default - i,,0,0,0,,Yani, vücudum hareket etmiyor.
Dialogue: 0,0:14:26.73,0:14:27.80,Default,,0,0,0,,Bir şans!
Dialogue: 0,0:14:27.80,0:14:31.11,Default - i,,0,0,0,,Bir anlık dikkat dağılmasından \Nyararlanıyor ve topu Hyuga-kun'a iletiyor!
Dialogue: 0,0:14:31.11,0:14:32.47,Default,,0,0,0,,K-Kahretsin!
Dialogue: 0,0:14:33.42,0:14:35.06,Default - i,,0,0,0,,3 dakika kaldı!
Dialogue: 0,0:14:35.06,0:14:38.86,Default - i,,0,0,0,,Hyuga-kun Toho'nun ilk şampiyonluğu için,
Dialogue: 0,0:14:38.86,0:14:42.57,Default - i,,0,0,0,,zafer için, Tiger Shot, atmak üzere!
Dialogue: 0,0:14:38.86,0:14:42.57,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:14:42.57,0:14:45.19,Default - i,,0,0,0,,Hyuga-kun şut çekecek.
Dialogue: 0,0:14:45.19,0:14:47.83,Default - i,,0,0,0,,Hayır, hareket edemiyorum.
Dialogue: 0,0:14:47.83,0:14:51.12,Default - i,,0,0,0,,Artık oraya gidip durduramıyorum.
Dialogue: 0,0:14:51.71,0:14:52.84,Default - i,,0,0,0,,Kaybedeceğim.
Dialogue: 0,0:14:53.74,0:14:55.12,Default - i,,0,0,0,,Kaybedecek miyim?
Dialogue: 0,0:14:56.29,0:14:57.87,Default - i,,0,0,0,,Yine de bununla bitecek.
Dialogue: 0,0:14:58.48,0:15:00.62,Default - i,,0,0,0,,Sonunda rahat olabilirim.
Dialogue: 0,0:15:00.62,0:15:03.51,Default - i,,0,0,0,,Eminim herkes anlar.
Dialogue: 0,0:15:03.51,0:15:05.73,Default - i,,0,0,0,,Elimden geleni yaptım.
Dialogue: 0,0:15:05.73,0:15:08.39,Default - i,,0,0,0,,3. şampiyonluğu alamasam bile...
Dialogue: 0,0:15:08.39,0:15:11.09,Default - i,,0,0,0,,Gerçekleştirmek için başka hayellerim var.
Dialogue: 0,0:15:11.09,0:15:13.44,Default - i,,0,0,0,,Brezilya'ya gidip profesyonel olacağım.
Dialogue: 0,0:15:13.44,0:15:16.04,Default - i,,0,0,0,,O zaman Japonya'yı dünyada bir numara yapacağım.
Dialogue: 0,0:15:16.04,0:15:18.93,Default - i,,0,0,0,,Onlarla karşılaştırıldığında, bu turnuva çok...
Dialogue: 0,0:15:20.44,0:15:24.84,Default - i,,0,0,0,,Ama... O zaman neden şimdiye kadar savaştım,
Dialogue: 0,0:15:24.84,0:15:26.36,Default - i,,0,0,0,,vücudumu bu şekilde kötüye kullandım...?
Dialogue: 0,0:15:29.61,0:15:30.95,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:32.95,0:15:35.43,Default,,0,0,0,,Gerçekten senin için iyi mi?!
Dialogue: 0,0:15:35.43,0:15:37.70,Default,,0,0,0,,Şimdi benzinin tükenme zamanı mı, Tsubasa?!
Dialogue: 0,0:15:38.15,0:15:39.33,Default,,0,0,0,,Hyuga-kun...
Dialogue: 0,0:15:40.66,0:15:42.25,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:15:43.47,0:15:45.09,Default,,0,0,0,,Tsubasa, dikkat et!
Dialogue: 0,0:15:45.09,0:15:45.75,Default,,0,0,0,,Kaç!
Dialogue: 0,0:15:50.91,0:15:54.09,Default - i,,0,0,0,,Buna rağmen Tsubasa-kun düşmedi!
Dialogue: 0,0:15:55.14,0:15:58.46,Default - i,,0,0,0,,Tsubasa, gerçekten senin için bittiyse,
Dialogue: 0,0:15:58.46,0:16:01.77,Default - i,,0,0,0,,tabutuna çivileri kendim çakacağım!
Dialogue: 0,0:16:01.77,0:16:02.77,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:16:03.63,0:16:04.53,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:04.53,0:16:07.11,Default - i,,0,0,0,,Anlık hızlı bir atlamayla kaçıyor!
Dialogue: 0,0:16:07.11,0:16:08.36,Default - i,,0,0,0,,Tsubasa-kun havada!
Dialogue: 0,0:16:10.19,0:16:12.20,Default,,0,0,0,,Tsubasa yeniden dirildi.
Dialogue: 0,0:16:12.20,0:16:13.70,Default,,0,0,0,,İmkansız!
Dialogue: 0,0:16:13.70,0:16:15.70,Default,,0,0,0,,Başka bir mucize gerçekleşti.
Dialogue: 0,0:16:16.11,0:16:19.67,Default - i,,0,0,0,,Doğrudan bir Tiger Shot yemiş olmasına \Nrağmen, sanki Tsubasa-kun yeniden dirildi!
Dialogue: 0,0:16:16.11,0:16:19.67,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:19.67,0:16:21.21,Default - i,,0,0,0,,O gerçekten bir anka kuşu!
Dialogue: 0,0:16:21.21,0:16:23.47,Default,,0,0,0,,Güzel, Tsubasa'nın öncülüğünü takip edin!
Dialogue: 0,0:16:23.47,0:16:24.29,Default,,0,0,0,,Tamam!
Dialogue: 0,0:16:25.25,0:16:28.62,Default - i,,0,0,0,,Tsubasa, gücün kuruyana kadar koş,
Dialogue: 0,0:16:28.62,0:16:31.45,Default - i,,0,0,0,,hayaline doğru, içindeki tüm güç ile,
Dialogue: 0,0:16:31.45,0:16:35.39,Default - i,,0,0,0,,bedeninin sınırına ulaşana kadar koş!
Dialogue: 0,0:16:35.39,0:16:36.95,Default - i,,0,0,0,,Koş, Tsubasa!
Dialogue: 0,0:16:36.95,0:16:38.60,Default - i,,0,0,0,,Tsubasa koş!
Dialogue: 0,0:16:38.60,0:16:41.35,Default - i,,0,0,0,,Tsubasa henüz ölmedi.
Dialogue: 0,0:16:41.35,0:16:43.77,Default,,0,0,0,,Bu bizim son savaşımız, Tsubasa!
Dialogue: 0,0:16:51.83,0:16:53.24,Default,,0,0,0,,Tsubasa senpai!
Dialogue: 0,0:16:56.29,0:16:58.62,Default - i,,0,0,0,,Tsubasa-kun şut çekmeye hazırlanıyor!
Dialogue: 0,0:16:58.62,0:17:01.12,Default - i,,0,0,0,,Ancak Hyuga-kun etrafından dolanmayı başarıyor!
Dialogue: 0,0:17:01.12,0:17:02.96,Default - i,,0,0,0,,Gol atmana izin vermeyeceğim!
Dialogue: 0,0:17:02.96,0:17:05.37,Default - i,,0,0,0,,Tsubasa-kun ve Hyuga-kun arasında bire bir savaş.
Dialogue: 0,0:17:05.37,0:17:08.96,Default - i,,0,0,0,,Zamanlamayı kaçırıp Drive Shot ile geri göndermeli miyim?
Dialogue: 0,0:17:05.37,0:17:08.96,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:08.96,0:17:12.59,Default - i,,0,0,0,,Sana karşı kazanana kadar buna zafer demeyeceğim!
Dialogue: 0,0:17:12.59,0:17:13.64,Default - i,,0,0,0,,Haklı.
Dialogue: 0,0:17:13.64,0:17:16.39,Default - i,,0,0,0,,Şimdi kaçarsam gerçek bir zafer değil!
Dialogue: 0,0:17:17.79,0:17:19.70,Default - i,,0,0,0,,Topa aynı anda vuruyorlar!
Dialogue: 0,0:17:19.70,0:17:21.68,Default - i,,0,0,0,,Aynı güçler arasında bir mücadele!
Dialogue: 0,0:17:22.68,0:17:23.49,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:23.49,0:17:24.18,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:17:24.18,0:17:26.65,Default,,0,0,0,,Top bir santim bile hareket etmedi!
Dialogue: 0,0:17:30.86,0:17:35.45,Default,,0,0,0,,Git, hayallerimizi taşı ve zaferin gökkuşağını boya!
Dialogue: 0,0:17:36.45,0:17:39.16,Default,,0,0,0,,{\bord0\blur0.6\c&HFFF069&\4a&HFF&}Drive Shot!
Dialogue: 0,0:17:36.45,0:17:43.20,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:39.16,0:17:43.20,Default - i,,0,0,0,,Tsubasa-kun'nun Drive Shot'u masmavi gökyüzüne uçuyor!
Dialogue: 0,0:17:44.14,0:17:45.35,Default - i,,0,0,0,,Kaybedeceğim...
Dialogue: 0,0:17:46.23,0:17:48.29,Default - i,,0,0,0,,Yine mi kaybedeceğim?!
Dialogue: 0,0:17:49.53,0:17:50.50,Default,,0,0,0,,Durduracağım.
Dialogue: 0,0:17:50.50,0:17:52.13,Default,,0,0,0,,Kesinlikle yapacağım!
Dialogue: 0,0:17:53.96,0:17:56.01,Default,,0,0,0,,Karate Vuruş Savunması!
Dialogue: 0,0:17:58.43,0:18:00.31,Default - i,,0,0,0,,Engelledi!
Dialogue: 0,0:18:00.31,0:18:03.77,Default - i,,0,0,0,,Wakashimazu-kun, Drive Shot'u uzaklaştırarak, dönmesini önler!
Dialogue: 0,0:18:00.31,0:18:03.77,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:18:08.62,0:18:09.52,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:18:10.97,0:18:12.97,Default - i,,0,0,0,,Beni yakaladı…
Dialogue: 0,0:18:12.97,0:18:15.61,Default - i,,0,0,0,,Aferin, Wakashimazu-kun…
Dialogue: 0,0:18:16.40,0:18:17.38,Default,,0,0,0,,Topu uzaklaştırın!
Dialogue: 0,0:18:17.38,0:18:18.74,Default,,0,0,0,,Saldırmaya devam edin!
Dialogue: 0,0:18:19.41,0:18:20.91,Default - i,,0,0,0,,Toho uzaklaştırıyor!
Dialogue: 0,0:18:21.45,0:18:23.95,Default - i,,0,0,0,,Top Tsubasa'ya geri döndü!
Dialogue: 0,0:18:24.67,0:18:25.78,Default - i,,0,0,0,,Top...
Dialogue: 0,0:18:25.78,0:18:28.42,Default - i,,0,0,0,,Arkadaşım bana geri dönüyor!
Dialogue: 0,0:18:28.42,0:18:30.15,Default - i,,0,0,0,,Şut çekmeliyim!
Dialogue: 0,0:18:30.15,0:18:31.37,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:18:32.17,0:18:33.50,Default - i,,0,0,0,,Şut çekeceğim!
Dialogue: 0,0:18:34.34,0:18:37.26,Default - i,,0,0,0,,Tsubasa-kun Drive Shot’unu atacak!
Dialogue: 0,0:18:34.34,0:18:37.26,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:18:40.29,0:18:41.26,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:18:41.26,0:18:45.27,Default - i,,0,0,0,,Drive Shot'un yardımı ile buradan gol atacağım!
Dialogue: 0,0:18:41.26,0:18:45.27,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:18:45.98,0:18:49.10,Default,,0,0,0,,{\bord0\blur0.6\c&H00FFFF&}Ti{\c&H00F7FF&}g{\c&H00E9FF&}er {\c&H00D8FF&}S{\c&H00CBFF&}ho{\c&H00BFFF&}t{\c&H00AEFF&}!
Dialogue: 0,0:18:45.98,0:18:49.10,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:18:49.10,0:18:51.26,Default - i,,0,0,0,,Hyuga-kun şutunu geri gönderdi!
Dialogue: 0,0:18:51.26,0:18:52.36,Default,,0,0,0,,Git!
Dialogue: 0,0:18:52.36,0:18:53.82,Default,,0,0,0,,Bu kesinlikle bir şans!
Dialogue: 0,0:18:53.82,0:18:55.04,Default,,0,0,0,,Gol atmayı hedefliyor!
Dialogue: 0,0:18:55.04,0:18:58.32,Default,,0,0,0,,Delilik! Rakibin hedefi neredeyse 90 metre uzaklıkta!
Dialogue: 0,0:18:59.49,0:19:00.86,Default,,0,0,0,,B-Bu...!
Dialogue: 0,0:19:00.86,0:19:04.87,Default,,0,0,0,,{\bord0\blur0.6\c&H1FE6F3&\}İş{\c&H00FF00&}te {\c&HFFFF00&}s{\c&HE95737&}on {\c&HFF00FF&}ş{\c&H3233EB&}u{\c&H049EF6&}t!
Dialogue: 0,0:19:04.87,0:19:08.58,Default - i,,0,0,0,,Tsubasa-kun, Zıplayan Şutu ile topu geri döndü!
Dialogue: 0,0:19:08.58,0:19:09.54,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:09.54,0:19:13.04,Default - i,,0,0,0,,Püskürtülmüş Tiger Shot ve Drive Shot'un 
Dialogue: 0,0:19:09.54,0:19:13.04,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu\NDrive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:19:13.04,0:19:16.55,Default - i,,0,0,0,,gökkuşağı doğrudan Toho'nun kalesine gidiyor!
Dialogue: 0,0:19:22.11,0:19:22.80,Default,,0,0,0,,Ken!
Dialogue: 0,0:19:24.81,0:19:25.93,Default - i,,0,0,0,,Gol attım!
Dialogue: 0,0:19:25.93,0:19:27.16,Default - i,,0,0,0,,Durdurmalıyım! 
Dialogue: 0,0:19:27.16,0:19:31.77,Default - i,,0,0,0,,Tsubasa ve Nankatsu'ya kaybetmeyi reddediyorum!
Dialogue: 0,0:19:32.79,0:19:33.80,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:19:33.80,0:19:34.98,Default - i,,0,0,0,,Durdurdu!
Dialogue: 0,0:19:34.98,0:19:36.40,Default - i,,0,0,0,,Başka bir kurtarış!
Dialogue: 0,0:19:36.40,0:19:37.40,Default,,0,0,0,,Kojiro!
Dialogue: 0,0:19:37.40,0:19:38.57,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:19:38.57,0:19:39.53,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:19:39.53,0:19:41.28,Default,,0,0,0,,Wakashimazu-san!
Dialogue: 0,0:19:42.05,0:19:44.83,Default - i,,0,0,0,,Wakashimazu-kun çizgiye yakın durdu!
Dialogue: 0,0:19:44.83,0:19:47.33,Default - i,,0,0,0,,Nankatsu başarısız oldu!
Dialogue: 0,0:19:48.25,0:19:49.90,Default - i,,0,0,0,,Çok güçlü!
Dialogue: 0,0:19:49.90,0:19:51.86,Default - i,,0,0,0,,Senden beklendiği gibi Hyuga-kun...
Dialogue: 0,0:19:52.75,0:19:55.46,Default - i,,0,0,0,,İkinci yarının sonunu işaret eden düdük çalıyor!
Dialogue: 0,0:19:55.46,0:19:57.46,Default - i,,0,0,0,,İki taraf da bir sonuca varamadı!
Dialogue: 0,0:19:57.46,0:19:59.97,Default - i,,0,0,0,,Maç uzatmayla devam edecek.
Dialogue: 0,0:19:59.97,0:20:01.22,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:01.22,0:20:02.42,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:02.42,0:20:03.88,Default,,0,0,0,,Neyin var Tsubasa?!
Dialogue: 0,0:20:03.88,0:20:05.22,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:20:06.43,0:20:10.06,Default,,0,0,0,,Şimdi millet, uzatma zamanı.
Dialogue: 0,0:20:11.23,0:20:12.53,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:12.53,0:20:16.40,Default,,0,0,0,,Maalesef oynamana izin veremem.
Dialogue: 0,0:20:16.40,0:20:18.60,Default,,0,0,0,,Doktorun dediği gibi.
Dialogue: 0,0:20:18.60,0:20:21.24,Default,,0,0,0,,Şu ana kadar gerçekten çok iyi iş çıkardın.
Dialogue: 0,0:20:21.24,0:20:25.66,Default,,0,0,0,,Gerisini diğerlerine bırakıp bacağın ve omzunu tedavi etmeye odaklan.
Dialogue: 0,0:20:25.66,0:20:28.91,Default,,0,0,0,,Doktor, bayılmadım.
Dialogue: 0,0:20:29.78,0:20:34.38,Default,,0,0,0,,Gücümün yetmediğini \Ndüşündüğüm an, Hyuga-kun beni uyandırdı.
Dialogue: 0,0:20:34.38,0:20:38.96,Default,,0,0,0,,{\t(4108,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Vücudum o zaman sınırına ulaşmamıştı.
Dialogue: 0,0:20:39.00,0:20:44.51,Default,,0,0,0,,Bunu bana fark ettiren Hyuga-kun'nun hatırı için savaşmalıyım.
Dialogue: 0,0:20:44.51,0:20:45.78,Default,,0,0,0,,Haklı!
Dialogue: 0,0:20:45.78,0:20:47.98,Default,,0,0,0,,Oynayamayan bir oyuncunun birbiri ardına 
Dialogue: 0,0:20:47.98,0:20:50.21,Default,,0,0,0,,bu tür vuruşlar yapabileceğini düşünüyor musunuz?
Dialogue: 0,0:20:50.21,0:20:54.21,Default,,0,0,0,,Hareket edemediğinde Tsubasa'yı oyundan çıkarmanız gerekiyordu.
Dialogue: 0,0:20:54.21,0:20:55.02,Default,,0,0,0,,Sizler...
Dialogue: 0,0:20:55.48,0:20:59.70,Default,,0,0,0,,Hayalimizdeki 3. şampiyonluğu sonuna kadar hedefleyelim!
Dialogue: 0,0:20:59.70,0:21:00.53,Default,,0,0,0,,Evet..
Dialogue: 0,0:21:09.45,0:21:11.00,Default,,0,0,0,,Menejer...
Dialogue: 0,0:21:11.00,0:21:12.29,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:21:14.96,0:21:17.51,Default,,0,0,0,,Tsubasa-kun, bundan sonra da, 
Dialogue: 0,0:21:17.51,0:21:20.05,Default,,0,0,0,,uzatmalarda elinden geleni yap.
Dialogue: 0,0:21:24.30,0:21:25.05,Default,,0,0,0,,İşte.
Dialogue: 0,0:21:26.80,0:21:28.34,Default,,0,0,0,,Teşekkürler.
Dialogue: 0,0:21:38.25,0:21:39.48,Default,,0,0,0,,Ah?
Dialogue: 0,0:21:41.22,0:21:43.25,Default,,0,0,0,,Neyin var Kumi-chan?
Dialogue: 0,0:21:43.25,0:21:46.86,Default,,0,0,0,,Nedenini bilmiyorum ama... Gözyaşlarım akmaya başladı.
Dialogue: 0,0:21:46.86,0:21:49.39,Default,,0,0,0,,İkinci yarıda bir kez bile gol atamadınız ha?
Dialogue: 0,0:21:49.39,0:21:51.60,Default,,0,0,0,,Yine de, şu ana kadar iyi bir oyun oldu.
Dialogue: 0,0:21:51.60,0:21:54.37,Default,,0,0,0,,Sonunda gerçekten iyi savundunuz!
Dialogue: 0,0:21:54.37,0:21:57.81,Default,,0,0,0,,Wakashimazu, uzatmada da sana güveneceğim.
Dialogue: 0,0:21:57.81,0:21:59.13,Default,,0,0,0,,Evet, lütfen bana güvenin!
Dialogue: 0,0:21:59.13,0:22:02.11,Default,,0,0,0,,20 dakikalık uzatma, belirleyici bir mücadele olacak!
Dialogue: 0,0:22:02.11,0:22:03.09,Default,,0,0,0,,Evet!
Dialogue: 0,0:22:04.34,0:22:06.09,Default-TOP,,0,0,0,,UZATMALAR
Dialogue: 0,0:22:03.09,0:22:05.79,Default - i,,0,0,0,,10 dakikalık iki yarıdan oluşan uzatmalar,
Dialogue: 0,0:22:05.79,0:22:08.43,Default - i,,0,0,0,,büyük izleyicinin önünde başlayacak!
Dialogue: 0,0:22:09.31,0:22:12.62,Default - i,,0,0,0,,Uzatmalar Nankatsu'nun başlama vuruşuyla başlayacak!
Dialogue: 0,0:22:19.46,0:22:34.46,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.49,0:23:59.48,ST_BAS_GAUCHE,,0,0,0,,51. BÖLÜM: \NMUCİZE DRIVE SHOT!
Dialogue: 0,0:23:49.49,0:24:00.00,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:01:13.76,0:01:16.47,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:17.39,0:01:20.06,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:20.97,0:01:23.68,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:30.57,0:01:33.40,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:33.40,0:01:39.66,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzuketa
Dialogue: 0,0:01:39.66,0:01:45.54,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitte ita no ni
Dialogue: 0,0:01:45.54,0:01:52.13,OPED-TOP,,0,0,0,,kokoro made uchinomesareta kono yoru ni
Dialogue: 0,0:01:52.13,0:01:56.13,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:56.13,0:02:00.64,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:02:00.64,0:02:06.23,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:02:06.23,0:02:07.77,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:02:07.77,0:02:08.98,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:08.98,0:02:12.48,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:02:12.48,0:02:22.37,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:02:22.37,0:02:23.20,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:23.20,0:02:27.00,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:02:27.00,0:02:31.00,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:02:31.00,0:02:37.26,OPED-TOP,,0,0,0,,kono ai mou ichibyou taritomo
Dialogue: 0,0:02:37.26,0:02:40.09,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:01:13.76,0:01:16.47,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:17.39,0:01:20.06,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:20.97,0:01:23.68,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:30.57,0:01:33.40,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:01:33.40,0:01:39.66,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:01:39.66,0:01:45.54,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:45.54,0:01:52.13,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:52.13,0:01:56.13,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:56.13,0:02:00.64,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:02:00.64,0:02:06.23,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:02:06.23,0:02:07.77,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:02:07.77,0:02:08.98,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:08.98,0:02:12.48,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:02:12.48,0:02:22.37,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:02:22.37,0:02:23.20,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:23.20,0:02:27.00,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:02:27.00,0:02:31.00,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:02:31.00,0:02:37.26,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:37.26,0:02:40.09,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.16,0:22:44.21,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.21,0:22:50.21,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.21,0:22:56.26,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.26,0:23:00.89,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.52,0:23:07.19,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.52,0:23:14.61,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.61,0:23:20.66,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:20.66,0:23:25.12,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.42,0:23:32.76,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:32.76,0:23:38.80,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:38.80,0:23:45.10,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.16,0:22:44.21,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.21,0:22:50.21,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.21,0:22:56.26,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.26,0:23:00.89,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.52,0:23:07.19,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.52,0:23:14.61,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.61,0:23:20.66,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:20.66,0:23:25.12,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.42,0:23:32.76,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:32.76,0:23:38.80,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:38.80,0:23:45.10,OPED,,0,0,0,,Bu hırslı gençlik sahada!
