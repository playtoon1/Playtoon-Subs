Dialogue: 0,0:18:47.91,0:18:50.44,Default,,0,0,0,,{\i1}Nankatsu ilk yarıda ikinci golünü atıyor!{\i0}
Dialogue: 0,0:18:52.19,0:18:53.77,Default,,0,0,0,,Güzel şut, Kisugi!
Dialogue: 0,0:18:53.77,0:18:54.26,Default,,0,0,0,,Başardın!
Dialogue: 0,0:18:54.26,0:18:55.05,Default,,0,0,0,,Başardık!
Dialogue: 0,0:18:55.05,0:18:56.69,Default,,0,0,0,,Şimdi iki farkla öndeyiz!
Dialogue: 0,0:18:56.69,0:18:57.89,Default,,0,0,0,,Ha...
