Dialogue: 0,0:12:39.48,0:12:41.69,Default,,0,0,0,,{\i1}Morisaki kalede.{\i0}
Dialogue: 0,0:12:41.69,0:12:46.73,Default,,0,0,0,,{\i1}Nakazato, Oda, Takasugi ve Ishizaki defansta.{\i0}
Dialogue: 0,0:12:46.73,0:12:52.10,Default,,0,0,0,,{\i1}Iwami, Izawa ve katpanları Tsubasa Ozora orta sahada.{\i0}
Dialogue: 0,0:12:52.10,0:12:55.46,Default,,0,0,0,,{\i1}Nagano, Kisugi ve Taki forvette.{\i0}
Dialogue: 0,0:13:01.97,0:13:04.34,Default,,0,0,0,,{\i1}Maç Nankatsu'nun santrasıyla başlıyor!{\i0}
Dialogue: 0,0:13:04.34,0:13:05.95,Default,,0,0,0,,Sana güveniyoruz Tsubasa!
Dialogue: 0,0:13:05.95,0:13:06.59,Default,,0,0,0,,Tabiki de!
Dialogue: 0,0:13:06.59,0:13:10.40,Default,,0,0,0,,{\i1}Tsubasa ikinci maçta kendini çok göstermedi,{\i0}
Dialogue: 0,0:13:10.40,0:13:13.77,Default,,0,0,0,,{\i1}ama oyun kurucu olarak bu maç için çok önemli.{\i0}
Dialogue: 0,0:13:13.77,0:13:16.08,Default,,0,0,0,,Başka şekilde zevkli olmazdı!
Dialogue: 0,0:13:16.08,0:13:17.40,Default,,0,0,0,,Hadi Tsubasa'yı halledelim!
Dialogue: 0,0:13:18.33,0:13:20.69,Default,,0,0,0,,{\i1}Demek şimdiden geliyorsunuz ,ha, Tachibana İkizler?{\i0}
Dialogue: 0,0:13:20.69,0:13:29.70,Default,,0,0,0,,Üç yıl önce Nankatsu'nun altın ikilisi, Tsubasa ve Misaki olarak ataklarımızı engellediniz.
Dialogue: 0,0:13:30.46,0:13:33.70,Default,,0,0,0,,{\t(2769,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Ama Nankatsu'nun Misaki'si artık yok.
Dialogue: 0,0:13:33.79,0:13:38.16,Default,,0,0,0,,Başka bir deyişle, şimdi, en güçlü ikili biziz!
Dialogue: 0,0:13:38.16,0:13:39.45,Default,,0,0,0,,Hadi gidelim Tsubasa!
Dialogue: 0,0:13:39.45,0:13:43.01,Default,,0,0,0,,Bizi tek başına durduramazsın!
Dialogue: 0,0:13:43.61,0:13:46.13,Default,,0,0,0,,{\i1}Haklısın, artık Misaki yok.{\i0}
Dialogue: 0,0:13:46.13,0:13:48.64,Default,,0,0,0,,{le poltergeist misaki in the sky}
Dialogue: 0,0:13:46.68,0:13:49.97,Default,,0,0,0,,{\i1}Misaki olmasa bile hala...{\i0}
Dialogue: 0,0:13:50.71,0:13:54.48,Default,,0,0,0,,{\i1}Tsubasa top sürmek yerine pas atıyor!{\i0}
Dialogue: 0,0:13:54.48,0:13:55.18,Default,,0,0,0,,Ne?!
Dialogue: 0,0:13:56.14,0:13:59.94,Default,,0,0,0,,{\i1}Hala arkadaşlarım var!{\i0}
Dialogue: 0,0:14:00.45,0:14:02.02,Default,,0,0,0,,Hadi beyler!
Dialogue: 0,0:14:02.02,0:14:03.24,Default,,0,0,0,,Hadi!
Dialogue: 0,0:14:03.24,0:14:06.41,Default,,0,0,0,,{\i1}Nankatsu Hawada'nın sahasına ilerliyor!{\i0}
Dialogue: 0,0:14:06.41,0:14:07.42,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:08.95,0:14:09.70,Default,,0,0,0,,Iwami!
Dialogue: 0,0:14:09.70,0:14:10.91,Default,,0,0,0,,Izawa!
Dialogue: 0,0:14:10.91,0:14:15.70,Default,,0,0,0,,{\i1}Top Nankatsu'nun orta sahasına Tsubasayla önderlik eden Izawa'ya gidiyor.
Dialogue: 0,0:14:15.70,0:14:16.21,Default,,0,0,0,,Sende!
Dialogue: 0,0:14:16.21,0:14:18.33,Default,,0,0,0,,{\i1}Izawa topu hızlıca kanatlara atıyor.{\i0}
Dialogue: 0,0:14:18.33,0:14:21.43,Default,,0,0,0,,{\i1}Taki her zamanki gibi orada bekliyor.{\i0} {rei ni yotte rei no gotoku? sending you a pic for that}{otanoshimi}
Dialogue: 0,0:14:21.43,0:14:23.59,Default,,0,0,0,,{\i1}Kendi hareketini yapıcak mı?{\i0}
Dialogue: 0,0:14:23.59,0:14:25.84,Default,,0,0,0,,{\i1}Hayır, içeri giriyor!{\i0} {le cut inside man}
Dialogue: 0,0:14:26.22,0:14:27.30,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:14:28.76,0:14:29.43,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:29.43,0:14:33.05,Default,,0,0,0,,{\i1}Hanawa'nın defansı onu durdurmaya çalışıyor, ama Taki topu Kisugi'ye veriyor!{\i0}
Dialogue: 0,0:14:33.05,0:14:34.52,Default,,0,0,0,,Çok güzeldi!
Dialogue: 0,0:14:35.40,0:14:38.52,Default,,0,0,0,,{\i1}Kisugi hız kesmeden top sürüyor.{\i0}
Dialogue: 0,0:14:38.52,0:14:39.27,Default,,0,0,0,,{\an8}{background voices} Hey!
Dialogue: 0,0:14:39.27,0:14:41.69,Default,,0,0,0,,{\an8}{background voices} Ne yapıyorsunuz?! Peşlerinden gidin!
Dialogue: 0,0:14:39.25,0:14:41.69,Default,,0,0,0,,{\i1}Hanawa'nın defans şaştı kaldı!{\i0}
Dialogue: 0,0:14:42.42,0:14:43.15,Default,,0,0,0,,İşte!
Dialogue: 0,0:14:43.15,0:14:45.03,Default,,0,0,0,,{\i1}Kisugi orta açıyor.{\i0}
Dialogue: 0,0:14:45.42,0:14:47.74,Default,,0,0,0,,{\i1}Tsubasa topun gidiş yoluna koşuyor.{\i0}
Dialogue: 0,0:14:47.74,0:14:50.87,Default,,0,0,0,,Aptallar! Tsubasa'yı markajsız bırakmayın!
Dialogue: 0,0:14:50.87,0:14:51.45,Default,,0,0,0,,Taki!
Dialogue: 0,0:14:51.45,0:14:54.45,Default,,0,0,0,,{\i1}Tsubasa kalenin önüne güzel bir pas atıyor!{\i0}
Dialogue: 0,0:14:52.79,0:14:54.45,Default,,0,0,0,,{\an8}Güzel pas!
Dialogue: 0,0:14:54.45,0:14:56.95,Default,,0,0,0,,{\i1}Taki ceza sahası içinde!{\i0}
Dialogue: 0,0:14:56.95,0:14:58.25,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:15:02.17,0:15:04.06,Default,,0,0,0,,{\i1}Top ağlarda!{\i0}
Dialogue: 0,0:15:04.06,0:15:05.27,Default,,0,0,0,,Başardım!
Dialogue: 0,0:15:05.27,0:15:07.55,Default,,0,0,0,,{\i1}Nankatsu inanılmaz bir takım oyunu gösteriyor!{\i0}
Dialogue: 0,0:15:07.55,0:15:10.05,Default,,0,0,0,,{\i1}Maç başladıktan hemen bir dakika sonra...{\i0}
Dialogue: 0,0:15:10.05,0:15:14.01,Default,,0,0,0,,{\i1}Hanawa'nın açılmasından yararlanan \Ninanılmaz bir gol attılar!{\i0}
Dialogue: 0,0:15:14.01,0:15:15.60,Default,,0,0,0,,Başardık!
Dialogue: 0,0:15:15.60,0:15:18.18,Default,,0,0,0,,{\i1}Güzel, iyi gidiyorsunuz çocuklar.
Dialogue: 0,0:15:18.18,0:15:19.94,Default,,0,0,0,,Harikasın, Taki!
Dialogue: 0,0:15:19.94,0:15:21.48,Default,,0,0,0,,Harikasın, Taki!
Dialogue: 0,0:15:19.94,0:15:21.48,Default,,0,0,0,,{Doing awesome, Touji!}{<3}{Nawwww <3}
Dialogue: 0,0:15:22.37,0:15:24.10,Default,,0,0,0,,Olamaz...
Dialogue: 0,0:15:24.10,0:15:25.65,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:15:25.65,0:15:29.34,Default,,0,0,0,,Pekala, sıra bizim hava futbolumuzda!
Dialogue: 0,0:15:29.34,0:15:30.46,Default,,0,0,0,,Hadi gidelim, Kazuo!
Dialogue: 0,0:15:30.46,0:15:31.41,Default,,0,0,0,,Evet!
Dialogue: 0,0:15:34.33,0:15:35.08,Default,,0,0,0,,Masao!
Dialogue: 0,0:15:35.48,0:15:36.24,Default,,0,0,0,,Bende!
Dialogue: 0,0:15:36.24,0:15:37.74,Default,,0,0,0,,Gel benle, Masao!
Dialogue: 0,0:15:37.74,0:15:40.31,Default,,0,0,0,,Atak sırası Hanawa'da.
Dialogue: 0,0:15:40.31,0:15:43.00,Default,,0,0,0,,{\i1}Tachibana ikizleri topla beraber ilerliyorlar.{\i0}
Dialogue: 0,0:15:43.00,0:15:45.79,Default,,0,0,0,,Takasugi, Ishizaki! İkisini markajlayın!
Dialogue: 0,0:15:45.79,0:15:46.63,Default,,0,0,0,,Tabiki de!
Dialogue: 0,0:15:46.63,0:15:48.46,Default,,0,0,0,,Planladığınız gibi olmayacak.
Dialogue: 0,0:15:48.46,0:15:49.46,Default,,0,0,0,,Siz başlamadan önce...
Dialogue: 0,0:15:49.46,0:15:51.84,Default,,0,0,0,,Hava futbolumuz başladı!
Dialogue: 0,0:15:51.84,0:15:57.14,Default,,0,0,0,,{\i1}Masao Tachibana kalenin önünde topu havaya attı.{\i0}
Dialogue: 0,0:15:57.14,0:16:01.14,Default,,0,0,0,,{\i1}Tachibana İkizleri'nin hava futbolu hareketi!{\i0}
Dialogue: 0,0:16:01.14,0:16:03.65,Default,,0,0,0,,Geliyor! O zamanki şutları... {that trauma}
Dialogue: 0,0:16:06.48,0:16:08.03,Default,,0,0,0,,Geliyorum Masao!
Dialogue: 0,0:16:08.03,0:16:11.03,Default,,0,0,0,,Hadi maçın skorunu eşitleyelim!
Dialogue: 0,0:16:11.03,0:16:12.45,Default,,0,0,0,,İzin vermeyeceğim!
Dialogue: 0,0:16:12.45,0:16:15.73,Default,,0,0,0,,Hareketimizin işe yaramayacağını mı söylüyorsun?!
Dialogue: 0,0:16:15.73,0:16:16.57,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:16.57,0:16:20.75,Default,,0,0,0,,Yapabildiklerimizi gördükten sonra böyle bir şey nasıl diyebiliyorsun?
Dialogue: 0,0:16:20.75,0:16:23.12,Default,,0,0,0,,İşe yaramaz dedim!
Dialogue: 0,0:16:24.37,0:16:27.00,Default,,0,0,0,,{\i1}Kazuo Tachibana dengesini kaybetti!{\i0} {the most epic "stop him on his track" move} {THIS IS NANKATSU!!!!!!!!!}
Dialogue: 0,0:16:27.00,0:16:28.84,Default,,0,0,0,,{\i1}İstediği gibi zıplayamadı!{\i0}
Dialogue: 0,0:16:30.38,0:16:36.09,Default,,0,0,0,,{\i1}Hanawa'nın hava futbolu darmaduman oldu!{\i0}
Dialogue: 0,0:16:38.20,0:16:40.64,Default,,0,0,0,,Güzeldi! İyi iş Ishizaki!
Dialogue: 0,0:16:40.64,0:16:42.33,Default,,0,0,0,,Harikasın, Ishizaki!
Dialogue: 0,0:16:42.33,0:16:46.36,Default,,0,0,0,,Olmayan beyninle iyi iş çıkardın! Seni zeki çocuk! {sarujie is like a monkey's wisdom, it's no big deal. so I put how you praise your doggo here}
Dialogue: 0,0:16:47.70,0:16:51.90,Default,,0,0,0,,Kendi kaleme attığım o golden beri size boçluydum.
Dialogue: 0,0:16:53.15,0:16:55.30,Default,,0,0,0,,Gördün mü şunu?
Dialogue: 0,0:16:55.30,0:17:01.29,Default,,0,0,0,,Her zaman Ishizaki'ye güvenilemeyeceğini düşündüm, ama bazen doğru zamanda doğru işler yapabiliyor.
Dialogue: 0,0:17:01.29,0:17:03.69,Default,,0,0,0,,Böyle durduracaklarını düşünmezdim.
Dialogue: 0,0:17:03.69,0:17:04.67,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:04.67,0:17:06.87,Default,,0,0,0,,Harika. Bu ritimde devam!
Dialogue: 0,0:17:06.87,0:17:08.17,Default,,0,0,0,,Beyler, hadi bir gol daha atalım!
Dialogue: 0,0:17:08.66,0:17:10.09,Default,,0,0,0,,Hadi gidelim!
Dialogue: 0,0:17:10.09,0:17:11.21,Default,,0,0,0,,İşte geliyor!
Dialogue: 0,0:17:11.78,0:17:14.64,Default,,0,0,0,,{\i1}Bu maçın çok çekişmeli geçmesi bekleniyordu,{\i0}
Dialogue: 0,0:17:14.64,0:17:18.67,Default,,0,0,0,,{\i1}ama her şey Nankatsu'nun kontrolünde gerçekleşiyor.{\i0}
Dialogue: 0,0:17:18.67,0:17:24.15,Default,,0,0,0,,{\i1}Hanawa defansı Nankatsu'nun durmadan yaptığı ataklar yüzünden şaşkına dönmüş durumda.{\i0} {halp seems ok}
Dialogue: 0,0:17:24.15,0:17:25.23,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:17:26.59,0:17:31.23,Default,,0,0,0,,Süpriz bir atak yapsalar bile Hanawa'nın Tachibana İkizleri Nankatsu karşısında pek etkili olmayacak.
Dialogue: 0,0:17:31.23,0:17:36.74,Default,,0,0,0,,Güzel hareketleri var ama hareketlerini engellemek şaşırtıcı derecede kolay.
Dialogue: 0,0:17:36.74,0:17:40.28,Default,,0,0,0,,Bizim kombinasyonumuzun böyle bir zayıflığı yok.
Dialogue: 0,0:17:40.28,0:17:41.49,Default,,0,0,0,,{kekekekek}
Dialogue: 0,0:17:41.93,0:17:45.17,Default,,0,0,0,,{\i1}Nankatsu ikinci bir gol için ilerliyor.{\i0}
Dialogue: 0,0:17:45.17,0:17:46.75,Default,,0,0,0,,Bunu size salıyorum.
Dialogue: 0,0:17:46.75,0:17:50.88,Default,,0,0,0,,Tsubasa dünki pasif halinden uzaktan yakından alakası yok.
Dialogue: 0,0:17:50.88,0:17:54.88,Default,,0,0,0,,Her şartta yeteneğini konuşturuyor.
Dialogue: 0,0:17:54.88,0:17:57.24,Default,,0,0,0,,Tsubasa bugün iyi oynuyor!
Dialogue: 0,0:17:57.24,0:18:01.59,Default,,0,0,0,,İkinci maçta onu dinlendirmek işe yaramış demek ki.
Dialogue: 0,0:18:01.59,0:18:04.02,Default,,0,0,0,,Bu farklı bir takım oyunu galiba.
Dialogue: 0,0:18:05.06,0:18:05.77,Default,,0,0,0,,İşte geliyor!
Dialogue: 0,0:18:05.77,0:18:09.31,Default,,0,0,0,,Top formunun zirvesinde olan Tsubasa'da!
Dialogue: 0,0:18:11.19,0:18:12.48,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:18:13.86,0:18:15.44,Default,,0,0,0,,Çok hızlı!
Dialogue: 0,0:18:15.44,0:18:18.16,Default,,0,0,0,,Tsubasa rakiplerinin arasından sıyrıldı!
Dialogue: 0,0:18:18.16,0:18:19.45,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:18:19.45,0:18:20.57,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:18:20.57,0:18:24.54,Default,,0,0,0,,Defanstan Murazawa tereddüt etmenden onu kovalamaya başladı.
Dialogue: 0,0:18:28.75,0:18:34.19,Default,,0,0,0,,Ama Tsubasa hızlıca pas attı!
Dialogue: 0,0:18:34.19,0:18:35.21,Default,,0,0,0,,Ne?!
Dialogue: 0,0:18:35.21,0:18:38.13,Default,,0,0,0,,Forvetin merkezi Kisugi topu aldı!
Dialogue: 0,0:18:38.13,0:18:43.39,Default,,0,0,0,,{\i1}Ben golcü Teppei Kisugi! Gol atmasam ayıp olurdu!{\i0} {Mr. Inzaghi}
