Comment: 0,0:01:50.00,0:03:19.97,Default,,0,0,0,,BÖLÜM A
Comment: 0,0:12:04.99,0:12:04.99,Default,,0,0,0,,{Part b}
Dialogue: 0,0:00:01.75,0:00:03.77,Default,,0,0,0,,Turnuvanın 3. günündeyiz.
Dialogue: 0,0:00:03.77,0:00:09.67,Default,,0,0,0,,Tüm takımlar ilk maçlarını yaptılar \Nve ikinci maçlarına başladırlar.
Dialogue: 0,0:00:09.67,0:00:10.32,Default,,0,0,0,,Atıyorum!
Dialogue: 0,0:00:10.32,0:00:13.29,Default,,0,0,0,,{\i1}Matsuoka MS Hirado'nun sahasına geçiyor.{\i0}
Dialogue: 0,0:00:13.29,0:00:14.57,Default,,0,0,0,,İzin vermem.
Dialogue: 0,0:00:14.57,0:00:17.08,Default,,0,0,0,,Hiradıdan Jito onları durdurmaya gidiyor.
Dialogue: 0,0:00:17.08,0:00:20.33,Default,,0,0,0,,Kontrolünü kaybetmiş bir kamyon gibi gidiyor.
Dialogue: 0,0:00:20.33,0:00:21.87,Default,,0,0,0,,Sola!
Dialogue: 0,0:00:21.87,0:00:24.92,Default,,0,0,0,,İzin vermem dedim.
Dialogue: 0,0:00:24.92,0:00:26.39,Default,,0,0,0,,Hayır, geçemiyorlar.
Dialogue: 0,0:00:26.39,0:00:28.13,Default,,0,0,0,,{\i1}Jito topu uzaklaştırıyor.
Dialogue: 0,0:00:28.13,0:00:30.88,Default,,0,0,0,,Hirado'nun defansı çok sağlam.
Dialogue: 0,0:00:30.88,0:00:33.88,Default,,0,0,0,,{\i1}Hirado bu turnuvada daha hiç gol yemedi.
Dialogue: 0,0:00:33.88,0:00:35.73,Default,,0,0,0,,Bu daha hiçbir şey.
Dialogue: 0,0:00:35.73,0:00:40.14,Default,,0,0,0,,Nankatsu'yla oynayana kadar gerçek gücümüzü göstermeyeceğiz.
Dialogue: 0,0:00:40.77,0:00:43.52,Default,,0,0,0,,{\i1}Saitama Dünya Stadyumu'unda günün ilk maçı başlıyor.{\i0}
Dialogue: 0,0:00:43.52,0:00:51.11,Default,,0,0,0,,{\i1}İkinci maç Akita'dan Hanawa MS ve Yamanashi'dan Sakimoto MS arasında olucak.{\i0}
Dialogue: 0,0:00:51.11,0:00:53.36,Default,,0,0,0,,Pekala! Top ikizlerde!
Dialogue: 0,0:00:53.36,0:00:56.70,Default,,0,0,0,,Bu sefer bize düzgün bir futbol gösterin.
Dialogue: 0,0:00:57.22,0:00:57.82,Default,,0,0,0,,Kardo!
Dialogue: 0,0:00:58.34,0:00:59.08,Default,,0,0,0,,Pekala!
Dialogue: 0,0:00:59.08,0:01:01.37,Default,,0,0,0,,{\i1}Markajlanmış durumda olan büyük kardeş Masao Tachibana ,{\i0}
Dialogue: 0,0:01:01.37,0:01:04.09,Default,,0,0,0,,{\i1}topu tersteki Kazuo'ya atıyor..{\i0}
Dialogue: 0,0:01:04.09,0:01:05.16,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:01:05.16,0:01:06.96,Default,,0,0,0,,Hayır! Pas ona değilmiş!
Dialogue: 0,0:01:06.96,0:01:09.53,Default,,0,0,0,,{\i1}Pas Ono içinmiş! Kazuo'nun üstünden aşırtarak...{\i0}
Dialogue: 0,0:01:09.53,0:01:10.29,Default,,0,0,0,,Hadi!
Dialogue: 0,0:01:11.37,0:01:12.84,Default,,0,0,0,,Gol!\N
Dialogue: 0,0:01:12.84,0:01:14.42,Default,,0,0,0,,{\i1}Hanawa'nın 2. golü!{\i0}
Dialogue: 0,0:01:14.42,0:01:19.14,Default,,0,0,0,,Hanawa bize bugün ikizlerin gücünü göstermese de,
Dialogue: 0,0:01:19.14,0:01:21.14,Default,,0,0,0,,bu golleriyle maçın sonucu netleşti.
Dialogue: 0,0:01:21.14,0:01:24.20,Default,,0,0,0,,Görünüşe göre hava futbolu sistemlerini sonraya saklıyorlar.
Dialogue: 0,0:01:24.20,0:01:27.40,Default,,0,0,0,,Lanet olsun! Ellerindekileri bize göstermeyecekler ha?
Dialogue: 0,0:01:28.65,0:01:31.90,Default,,0,0,0,,Bir dahaki maç kiminle olucak çok merak ediyorum.
Dialogue: 0,0:01:33.07,0:01:34.53,Default,,0,0,0,,Pekala! Başardık!
Dialogue: 0,0:01:34.53,0:01:36.61,Default,,0,0,0,,Bitiş düdüğü çaldı!
Dialogue: 0,0:01:36.61,0:01:38.10,Default,,0,0,0,,{\i1}Skor 2-0.{\i0}
Dialogue: 0,0:01:38.10,0:01:40.62,Default,,0,0,0,,{\i1}Hanawa üçüncü tura çıkmaya hak kazandı!{\i0}
Dialogue: 0,0:01:40.62,0:01:46.00,Default,,0,0,0,,{\i1}Birdaha ki maçlarını Nankatsu ve Nishikigaoka arasındaki maçın kazananıyla oynayacaklar.{\i0}
Dialogue: 0,0:01:42.10,0:01:46.00,Default,,0,0,0,,{Taipusetto}
Dialogue: 0,0:01:46.44,0:01:48.54,Default,,0,0,0,,Pekala, bu sefer bizim sıramız.
Dialogue: 0,0:01:48.54,0:01:50.00,Default,,0,0,0,,Evet koç!
Dialogue: 0,0:01:50.00,0:03:19.97,Default,,0,0,0,,{AI AI AI}
Dialogue: 0,0:01:50.00,0:02:05.97,AnimeSeverler,,0,0,0,,'{\b0}Anime{\b1} Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr  \NÇevirmen; Brook ( {\c&HD67C65&}Soul King {\c})
Dialogue: 0,0:03:20.38,0:03:25.39,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}BÖLÜM 37: \NSKYLAB HURRICANE!
Dialogue: 0,0:03:20.97,0:03:23.97,Default-TOP,,0,0,0,,{\i1}İki takımın oyuncuları da sahada ki yerlerini alıyor.{\i0}
Dialogue: 0,0:03:23.97,0:03:25.72,Default-TOP,,0,0,0,,{\i1}Bu bugünün ikinci {\i0}
Dialogue: 0,0:03:25.72,0:03:30.98,Default,,0,0,0,,{\i1}Shizuoka'nın temsilcisi Nankatsu ve Kanagawa'nın temsilcisi Nishigaoka arasında olucak.{\i0}
Dialogue: 0,0:03:30.98,0:03:35.07,Default,,0,0,0,,{\i1}{\i1}Bildiğiniz gibi kaptanları Tsubasa'yla{\i0}
Dialogue: 0,0:03:35.07,0:03:40.03,Default,,0,0,0,,{\i1}iki senedir şampiyonluğu kimseye yar etmiyorlar.{\i0}
Dialogue: 0,0:03:40.03,0:03:45.70,Default,,0,0,0,,{\i1}Rakipleri Nishikigaoka, Kochi'nin temsilcisi Ozusan'ı 3-1 yendiler{\i0}
Dialogue: 0,0:03:45.70,0:03:47.45,Default,,0,0,0,,{\i1}ve bir seri yakalamış durumdalar.{\i0}
Dialogue: 0,0:03:47.45,0:03:50.79,Default,,0,0,0,,{\i1}Nishikigaoka Nankatsu'nun tahtını yıkabilir mi?{\i0} {how can i tl oomonogui without sounding like a retard?} {now we can make a reference to another good football anime <3}
Dialogue: 0,0:03:50.79,0:03:54.29,Default,,0,0,0,,Yarınki maç için izleyip çalışın.
Dialogue: 0,0:03:54.29,0:03:55.81,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:55.81,0:03:58.42,Default,,0,0,0,,Bugün de gol atmaya devam et!
Dialogue: 0,0:04:03.53,0:04:05.14,Default,,0,0,0,,{\i1}Tsubasa...{\i0}
Dialogue: 0,0:04:07.73,0:04:09.60,Default,,0,0,0,,Tamam zamanında yetiştik.
Dialogue: 0,0:04:09.60,0:04:11.85,Default,,0,0,0,,{\i1}Maç Nankatsu'nun santra vuruşuyla başlayacak.{\i0}
Dialogue: 0,0:04:11.85,0:04:13.48,Default,,0,0,0,,Pekala, yapalım şu işi!
Dialogue: 0,0:04:15.56,0:04:16.56,Default,,0,0,0,,İşte geliyor!
Dialogue: 0,0:04:19.32,0:04:22.33,Default,,0,0,0,,Tsubasa, bacağın hala yaralı.
Dialogue: 0,0:04:22.33,0:04:24.95,Default,,0,0,0,,Sen bugün dinlenmene bak!
Dialogue: 0,0:04:24.95,0:04:26.32,Default,,0,0,0,,Adamı duydun!
Dialogue: 0,0:04:26.32,0:04:29.18,Default,,0,0,0,,İşler ciddileşirse devreye girersin.
Dialogue: 0,0:04:29.79,0:04:31.12,Default,,0,0,0,,Hadi gidelim, beyler!
Dialogue: 0,0:04:31.12,0:04:32.12,Default,,0,0,0,,Evet!
Dialogue: 0,0:04:33.35,0:04:38.36,Default,,0,0,0,,{\i1}Görünüşe Nankatsu Tsubasa'nın değil \NIzawa'nın oyun kuruculuğuyla saldıracak.
Dialogue: 0,0:04:38.36,0:04:41.38,Default,,0,0,0,,Ne? Tsubasa saldırmıyor mu?
Dialogue: 0,0:04:41.38,0:04:43.51,Default,,0,0,0,,Lanet olsun! Bizi hafife alıyorlar!
Dialogue: 0,0:04:43.51,0:04:47.60,Default,,0,0,0,,Nankatsu'yu Tsubasa'dan ibaret olduğunu düşünerek sen bizi hafife alıyorsun.
Dialogue: 0,0:04:48.66,0:04:52.87,Default,,0,0,0,,{\i1}Izawa birini geçip uzun bir pas atıyor.{\i0}
Dialogue: 0,0:04:52.87,0:04:53.56,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:04:53.56,0:04:55.73,Default,,0,0,0,,{\i1}Nagano topu terse atıyor.{\i0}
Dialogue: 0,0:04:56.52,0:04:58.54,Default,,0,0,0,,{\i1}Top Taki'ye gidiyor.{\i0}
Dialogue: 0,0:04:58.54,0:05:00.85,Default,,0,0,0,,{\i1}Taki yapmayı sevdiği gibi topu sürecek mi?{\i0}
Dialogue: 0,0:05:00.85,0:05:02.28,Default,,0,0,0,,Sende, Izawa!
Dialogue: 0,0:05:02.28,0:05:04.53,Default,,0,0,0,,{\i1}Hayır, topu orta sahaya atıyor!{\i0}
Dialogue: 0,0:05:04.53,0:05:06.11,Default,,0,0,0,,Buna bakın. İşte sonunuz.
Dialogue: 0,0:05:06.11,0:05:07.09,Default,,0,0,0,,Kisugi!
Dialogue: 0,0:05:07.09,0:05:09.74,Default,,0,0,0,,{\i1}Izawa başarılı bir şekilde topu ceza sahasına atıyor!{\i0}
Dialogue: 0,0:05:09.74,0:05:12.87,Default,,0,0,0,,{\i1}Oraya zamanında koşan Kisugi topu yakalıyor!{\i0}
Dialogue: 0,0:05:13.77,0:05:15.11,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:05:15.11,0:05:17.08,Default,,0,0,0,,{\i1}Nankatsu inanılmaz bir gol atıyor!{\i0}
Dialogue: 0,0:05:17.08,0:05:19.06,Default,,0,0,0,,{\an8}Pekala!
Dialogue: 0,0:05:17.61,0:05:21.71,Default,,0,0,0,,{\i1}Taki, Izawa ve Kisugi mükemmel bir kombinasyon oluşturdular.{\i0}
Dialogue: 0,0:05:23.59,0:05:26.19,Default,,0,0,0,,Başardınız! Eski-Shutetsu Üçlüsü!
Dialogue: 0,0:05:26.19,0:05:28.76,Default,,0,0,0,,İyi gidiyorsunuz, Taki! Izawa! Kisugi!
Dialogue: 0,0:05:29.92,0:05:30.81,Default,,0,0,0,,Beyler...
Dialogue: 0,0:05:34.66,0:05:35.52,Default,,0,0,0,,{\i1}Pekala!{\i0}
Dialogue: 0,0:05:35.52,0:05:37.28,Default,,0,0,0,,Geçmene izin vereceğimi mi sanıyorsun?
Dialogue: 0,0:05:37.28,0:05:38.85,Default,,0,0,0,,{\i1}Ishizaki topu uzaklaştırıyor!{\i0}
Dialogue: 0,0:05:39.54,0:05:42.07,Default,,0,0,0,,{\i1}Nankatsu'nun defansı da çok çalışıyor gibi görünüyor.{\i0}
Dialogue: 0,0:05:42.07,0:05:44.41,Default,,0,0,0,,{\i1}Herkes formunda gibi görünüyor.{\i0}
Dialogue: 0,0:05:44.41,0:05:46.82,Default,,0,0,0,,{\i1}Tsubasa için ellerinden geleni yapıyorlar.{\i0}
Dialogue: 0,0:05:46.82,0:05:48.32,Default,,0,0,0,,Tamam, koş!
Dialogue: 0,0:05:50.06,0:05:50.91,Default,,0,0,0,,Geri dönün!
Dialogue: 0,0:05:50.91,0:05:52.58,Default,,0,0,0,,{\i1}Nankatsu bir kez daha saldırıyor!{\i0}
Dialogue: 0,0:05:52.97,0:05:54.83,Default,,0,0,0,,{\i1}Nishikigaoka geri dönmeye çalışıyor!{\i0}
Dialogue: 0,0:05:54.83,0:05:55.96,Default,,0,0,0,,Pekala!
Dialogue: 0,0:05:58.55,0:05:59.99,Default,,0,0,0,,{\i1}Top ağlarda!{\i0} {ok, this shows that you can score without shouting stupid attacks names. izawa is mai boi}
Dialogue: 0,0:05:59.99,0:06:04.38,Default,,0,0,0,,{\i1}İzawa'dan mükemmel bir uzak şut.{\i0}
Dialogue: 0,0:06:04.38,0:06:05.46,Default,,0,0,0,,Başardım!
Dialogue: 0,0:06:05.46,0:06:08.56,Default,,0,0,0,,Lanet olsun!Nankatsu Tsubasa'sız oynuyor!
Dialogue: 0,0:06:08.56,0:06:10.11,Default,,0,0,0,,Ona rağmen oldukça güçlüler.
Dialogue: 0,0:06:10.11,0:06:14.60,Default,,0,0,0,,Tsubasa olmasa bile, kalan tüm oyuncuların hem defans hem de atak gücü var.
Dialogue: 0,0:06:14.60,0:06:17.17,Default,,0,0,0,,Nankatsu beklediğimiz gibi iyi bir takım.
Dialogue: 0,0:06:17.17,0:06:20.35,Default,,0,0,0,,Hiç bir zayıf yön göstermiyor.
Dialogue: 0,0:06:20.35,0:06:22.97,Default,,0,0,0,,Şampiyonluğun favori adayı dendiğinden beri,
Dialogue: 0,0:06:22.97,0:06:25.86,Default,,0,0,0,,tüm gözler üzerimize çevrildi, özellikle Tsubasa'nın.
Dialogue: 0,0:06:25.86,0:06:28.34,Default,,0,0,0,,Gücümüzü saklamanın bir anlamı yok artık.
Dialogue: 0,0:06:28.34,0:06:30.87,Default,,0,0,0,,Hadi ne yapabildiğimizi gösterelim.
Dialogue: 0,0:06:34.96,0:06:39.29,Default,,0,0,0,,Nankatsu'ya baskı yapmak için yeni özel hareketimizi şu ana kadar bir sır olarak saklamış olsak da,
Dialogue: 0,0:06:39.29,0:06:45.42,Default,,0,0,0,,şu an bütün güçlerini gösterip üstümüze baskı yapmaya çalşıyorlar.
Dialogue: 0,0:06:46.36,0:06:47.42,Default,,0,0,0,,Al bunu, Taki!
Dialogue: 0,0:06:47.42,0:06:48.22,Default,,0,0,0,,Tabiki de!
Dialogue: 0,0:06:48.22,0:06:50.59,Default,,0,0,0,,{\i1}Nankatsu saldırdıklarında hiç geri durmuyorlar!{\i0}
Dialogue: 0,0:06:50.59,0:06:52.59,Default,,0,0,0,,{\i1}3. gollerini mi atıcaklar?{\i0}
Dialogue: 0,0:06:52.59,0:06:54.43,Default,,0,0,0,,Ne?
Dialogue: 0,0:06:55.09,0:06:56.31,Default,,0,0,0,,Tsubasa... {he steal your ball and yo wife}
Dialogue: 0,0:06:57.18,0:06:58.10,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:06:58.77,0:07:00.29,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:07:00.29,0:07:03.40,Default,,0,0,0,,{\i1}3. golü atan Nankatsu'dan Tsubasa!{\i0}
Dialogue: 0,0:07:03.40,0:07:04.94,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:07:06.24,0:07:09.47,Default,,0,0,0,,Çok dinlenirsem tembelleşirim. {or rusty}
Dialogue: 0,0:07:09.47,0:07:11.32,Default,,0,0,0,,En azından bu kadarını yapayım.
Dialogue: 0,0:07:11.32,0:07:12.93,Default,,0,0,0,,Çullanın şunun üstüne!
Dialogue: 0,0:07:12.93,0:07:14.95,Default,,0,0,0,,Geride durup dinlenmende bir sıkıntı yok dedik!
Dialogue: 0,0:07:14.95,0:07:17.24,Default,,0,0,0,,Peki, sonuçta kaptan sensin.
Dialogue: 0,0:07:17.24,0:07:19.25,Default,,0,0,0,,İşte bizim Tsubasa!
Dialogue: 0,0:07:19.25,0:07:20.56,Default,,0,0,0,,Çok havalı!
Dialogue: 0,0:07:20.56,0:07:23.33,Default,,0,0,0,,Kumi, sadece Tsubasa'yı izliyorsun değil mi?
Dialogue: 0,0:07:23.33,0:07:25.33,Default,,0,0,0,,{\i1}Tsubasa...{\i0}
Dialogue: 0,0:07:27.25,0:07:29.67,Default,,0,0,0,,{\i1}Maç düdükle beraber bitiyor.{\i0} {ha-hayai}
Dialogue: 0,0:07:29.67,0:07:31.07,Default,,0,0,0,,{\i1}6-0!{\i0} {remember remember 6th of november}{i was a GS supporter and that shit devastated me ;_;}
Dialogue: 0,0:07:31.07,0:07:33.76,Default,,0,0,0,,{\i1}Nankatsu yenilmez şampiyon olarak gücünü gösteriyor.{\i0}
Dialogue: 0,0:07:33.76,0:07:36.46,Default,,0,0,0,,{\i1}Üçüncü tura yükseliyorlar.{\i0} {moe was also good lol}
Dialogue: 0,0:07:36.46,0:07:37.95,Default,,0,0,0,,Gerçekten güçlüler.
Dialogue: 0,0:07:37.95,0:07:40.02,Default,,0,0,0,,Onların dengi değiliz.
Dialogue: 0,0:07:40.02,0:07:43.27,Default,,0,0,0,,Pekala! Sıradaki takım Hanawa!
Dialogue: 0,0:07:43.27,0:07:45.98,Default,,0,0,0,,Sadece bekleyin, Tachibana İkizler!
Dialogue: 0,0:07:45.98,0:07:47.81,Default,,0,0,0,,Gerçekten güçlüsünüz, Nankatsu...
Dialogue: 0,0:07:47.81,0:07:49.74,Default,,0,0,0,,Biz de öyle!
Dialogue: 0,0:07:51.51,0:07:53.57,Default,,0,0,0,,{\i1}Bugün turnuvanın dördüncü günü.{\i0}
Dialogue: 0,0:07:53.57,0:07:59.02,Default,,0,0,0,,{\i1}3. şampiyonluğu hedefleyen Nankatsu Hanawa'yla maç yapacakaları güne uyanıyorlar,{\i0}
Dialogue: 0,0:07:59.02,0:08:02.04,Default,,0,0,0,,{\i1}Azumaichi'den sonraki ikinci büyük rakipleri...{\i0}
Dialogue: 0,0:08:02.53,0:08:04.75,Default,,0,0,0,,Görünüşe göre bugün sıcak bir gün olucak.
Dialogue: 0,0:08:09.94,0:08:11.63,Default,,0,0,0,,Pekala!
Dialogue: 0,0:08:11.63,0:08:19.06,Default,,0,0,0,,Savaş! Savaş!
Dialogue: 0,0:08:25.41,0:08:29.32,Default,,0,0,0,,Ne olursa olsun finallerde oynamanın \Nbir yolunu bulmalıyım.
Dialogue: 0,0:08:29.94,0:08:34.07,Default,,0,0,0,,{\i1}Bu yüzden çocuklar, finallere kadar sakın kaybetmeyin.{\i0}
Dialogue: 0,0:08:34.49,0:08:35.25,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:08:35.25,0:08:36.70,Default,,0,0,0,,Hyuga...
Dialogue: 0,0:08:36.70,0:08:38.99,Default,,0,0,0,,Hey, mola verebileceğinizi size kim söyledi?
Dialogue: 0,0:08:38.99,0:08:41.17,Default,,0,0,0,,Koşmaya devam!
Dialogue: 0,0:08:41.17,0:08:42.60,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:42.60,0:08:51.30,Default,,0,0,0,,Savaş! Savaş!
Dialogue: 0,0:08:52.78,0:08:57.68,Default,,0,0,0,,{\i1}Saitama Dünya Stadyumu maç öncesinde oldukça tutuşmuş durumda.{\i0}
Dialogue: 0,0:08:57.68,0:09:01.85,Default,,0,0,0,,{\i1}Bugünün ilk maçı üçüncü turdaki Nankatsu MS ve Hanawa MS arasında olucak.{\i0}
Dialogue: 0,0:09:01.85,0:09:04.62,Default,,0,0,0,,{\an8}Hadi Hanawa Hadi! {ugh, ganbare is dumb to tl}
Dialogue: 0,0:09:02.54,0:09:07.84,Default,,0,0,0,,{\i1}Sadece bu maç için, Hanawa, Akita'dan tezahürat takımının iki katından fazlasını getirdi.{\i0} {more than double literally}
Dialogue: 0,0:09:07.84,0:09:12.37,Default,,0,0,0,,{\i1}Turnuvanın favorisi Nankatsu'yu\N yenmeyi çok ciddiye alıyorlar.{\i0}
Dialogue: 0,0:09:12.37,0:09:14.61,Default,,0,0,0,,Bu tezahürat.
Dialogue: 0,0:09:14.61,0:09:16.61,Default,,0,0,0,,HANAWA ORTAOKULU\N AKITA TEMSİLCİSİ
Dialogue: 0,0:09:15.75,0:09:16.61,Default-TOP,,0,0,0,,Dinleyin, beyler!
Dialogue: 0,0:09:16.61,0:09:20.37,Default,,0,0,0,,En azından tezahürata karşılık olarak,kazanmadan gelmeyin!
Dialogue: 0,0:09:20.37,0:09:21.37,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:21.37,0:09:23.12,Default,,0,0,0,,NANKATSU ORTAOKULU \N SHIZUOKA TEMSİLCİSİ
Dialogue: 0,0:09:22.10,0:09:25.21,Default-TOP,,0,0,0,,Pekala beyler. Dün ki ritmi unutmayın.
Dialogue: 0,0:09:25.21,0:09:26.91,Default,,0,0,0,,Bugün elinizde ne varsa gösterin!
Dialogue: 0,0:09:26.91,0:09:27.83,Default,,0,0,0,,Tamam koç!
Dialogue: 0,0:09:32.07,0:09:33.88,Default,,0,0,0,,Uzun zaman oldu Tsubasa.
Dialogue: 0,0:09:33.88,0:09:34.73,Default,,0,0,0,,Evet.
Dialogue: 0,0:09:34.73,0:09:36.59,Default,,0,0,0,,İlk okul turnuvasıydı değil m?
Dialogue: 0,0:09:36.59,0:09:39.93,Default,,0,0,0,,Gerçekten uzun zaman oldu. O günden beri bu anı bekiyoruz.{he doesn't actually say it's been that long. but if it makes the dialogue flow, i'm ok}
Dialogue: 0,0:09:39.93,0:09:44.65,Default,,0,0,0,,Dünkinin aksine bugün bütün gücümüzü göstereceğiz.
Dialogue: 0,0:09:44.65,0:09:47.90,Default,,0,0,0,,Üzgünüm ama yıkılmaz zafer seriniz bugün sona eriyor.
Dialogue: 0,0:09:47.90,0:09:50.50,Default,,0,0,0,,Hıh, rüyanızda görürsünüz.
Dialogue: 0,0:09:50.50,0:09:53.90,Default,,0,0,0,,Hava futbolunuz bize işlemez.
Dialogue: 0,0:09:55.06,0:09:57.59,Default,,0,0,0,,Her zamanki gibi hayal dünyasında yaşıyorsun.
Dialogue: 0,0:09:57.59,0:10:00.18,Default,,0,0,0,,Yine kendi kalene atacak mısın Bay Maymun.
Dialogue: 0,0:10:00.18,0:10:01.66,Default,,0,0,0,,Ne dedin sen?
Dialogue: 0,0:10:01.66,0:10:04.87,Default,,0,0,0,,Ben değiştim tamam mı?
Dialogue: 0,0:10:02.30,0:10:04.87,Defaultasfasfafw,,0,0,0,,Hala aynı tartışma mı? {literally, " just how old this topic is"}
Dialogue: 0,0:10:04.87,0:10:08.71,Default,,0,0,0,,{\i1}İki takımda sahaya çıkıyor.{\i0}
Dialogue: 0,0:10:09.72,0:10:12.25,Default,,0,0,0,,{\i1}İzliyiciler coşmuş durumda!{\i0}
Dialogue: 0,0:10:12.25,0:10:13.59,Default,,0,0,0,,Hanawa!
Dialogue: 0,0:10:13.59,0:10:15.76,Default,,0,0,0,,Kazanmak için oynayın, Hanawa!
Dialogue: 0,0:10:15.76,0:10:18.26,Default,,0,0,0,,Size güveniyoruz, Nankatsu!
Dialogue: 0,0:10:23.35,0:10:25.22,Default,,0,0,0,,Fotoğraflar için sana güveniyorum.
Dialogue: 0,0:10:25.22,0:10:28.41,Default,,0,0,0,,Gerçekten ölü yaprak vuruşunu yapabilecek mi?
Dialogue: 0,0:10:28.41,0:10:31.53,Default,,0,0,0,,Bahsettiğimiz Tsubasa olsa bile, hala bir ortaokul öğrencisi.
Dialogue: 0,0:10:31.53,0:10:35.05,Default,,0,0,0,,Üstüne Nishigaoka maçında şut bile çekmedi neredeyse.
Dialogue: 0,0:10:35.05,0:10:36.96,Default,,0,0,0,,Bugün yapacağına eminim.
Dialogue: 0,0:10:36.96,0:10:37.57,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:38.14,0:10:39.82,Default,,0,0,0,,Gazeteci 6. hissi diyelim.
Dialogue: 0,0:10:40.72,0:10:45.90,Default,,0,0,0,,{\i1}Aynı zamanda Bay Coast Stadyumu'nda Toho Akademi ve Gifu'dan Yoko MS{\i0}
Dialogue: 0,0:10:45.90,0:10:50.79,Default,,0,0,0,,{\i1}arasındaki maç başlamak üzere.{\i0}
Dialogue: 0,0:10:51.30,0:10:53.96,Default,,0,0,0,,Hyuga bugün de yedek kulübesinde yok.
Dialogue: 0,0:10:53.96,0:10:57.14,Default,,0,0,0,,Yani onun inanılmaz vuruşunu görmeyeceğiz.
Dialogue: 0,0:10:57.14,0:11:01.21,Default,,0,0,0,,Belki gerçekten de kendini iyi hissetmiyordur, belki yaralıdır.
Dialogue: 0,0:11:01.21,0:11:04.64,Default,,0,0,0,,Onu finallere saklamak istiyorlarsa, bankta tutabilirlerdi.
Dialogue: 0,0:11:04.64,0:11:06.06,Default,,0,0,0,,Eğer durum buysa...
Dialogue: 0,0:11:08.31,0:11:09.60,Default,,0,0,0,,KOJIRO HYUGA SAHADA!! \N SAĞ AYAĞINDAKİ İNANILMAZ PATLAYICI GÜÇ! \N FİNALLERE Mİ SAKLIYOR!? \NSTADDIN DUVARINDAKİ ÇUKURU HYUGA'NIN ŞUTU YAPTI!
Dialogue: 0,0:11:06.06,0:11:08.31,Default,,0,0,0,,Rahatsız ettiğim için üzgünüm, {I can hear toutotsu but the rest?}{i can't hear it either, lol. was meaning to ask about it but forgot because of the fake news. it also sounds sth like -tsubou, but i can't be sure it looked like a name, so maybe we can check on french}{yeah, it also sounds like sth-san, but tahat sounds weird for a name. FR says nothing about it, they tl'd that part as "tell me," sasuga frenchs, boycotting tl too}{kek, it makes sense in context though}
Dialogue: 0,0:11:08.31,0:11:11.60,Default-TOP,,0,0,0,,ama bu uydurma haber değil mi? {FAKE NEWS}
Dialogue: 0,0:11:10.40,0:11:11.60,Default,,0,0,0,,KOJIRO HYUGA SAHADA!! \N SAĞ BACAĞINDAKİ İNANILMAZ PATLAYICI GÜÇ!
Dialogue: 0,0:11:11.60,0:11:14.11,Default,,0,0,0,,Hayır, hepsi tamamen gerçekti.
Dialogue: 0,0:11:15.56,0:11:17.69,Default,,0,0,0,,Kendi gözlerimle gördüm.
Dialogue: 0,0:11:17.69,0:11:21.71,Default,,0,0,0,,Mucizevi bir şuttu.
Dialogue: 0,0:11:21.71,0:11:25.28,Default,,0,0,0,,Normal bir oyuncunun attığı şuttan iki kat daha hızlıydı.
Dialogue: 0,0:11:25.28,0:11:27.46,Default,,0,0,0,,{\i1}Rüya gibi bir atış.{\i0}
Dialogue: 0,0:11:32.91,0:11:37.17,Default,,0,0,0,,{\i1}Bu, Vahşi Kaplan Kojiro Hyuga'nın Kaplan Atışı!{\i0}
Dialogue: 0,0:11:38.80,0:11:42.02,Default,,0,0,0,,Dün 8 gol attınız diye sakın gardınızı düşürmeyin. {it's tough being so good}{keep working don't get lazy just because you just pull a liverpool on them}
Dialogue: 0,0:11:42.02,0:11:43.44,Default,,0,0,0,,Odaklanın.
Dialogue: 0,0:11:43.44,0:11:44.47,Default,,0,0,0,,Tamam koç!
Dialogue: 0,0:11:44.47,0:11:48.14,Default,,0,0,0,,Hyuga olmasa bile finallere kadar kaybetmeyeceğiz.
Dialogue: 0,0:11:48.14,0:11:52.92,Default,,0,0,0,,Ve eğer koç Hyuga'yı finalde oynatmayacağını söylerse
Dialogue: 0,0:11:52.92,0:11:56.88,Default,,0,0,0,,{\i1}maçı boykot edeceğiz!{\i0} {lololololololol}{toho jackets?}{gilets tohoiens}
