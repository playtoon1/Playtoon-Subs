Dialogue: 0,0:12:23.72,0:12:27.72,Default,,0,0,0,,{\i1}Shiota, Aimoto ve Tamai orta sahada.{\i0}
Dialogue: 0,0:12:27.72,0:12:32.37,Default,,0,0,0,,{\i1}Ono ve Tachibana İkizler akrobatik futbollarıyla{\i0}
Dialogue: 0,0:12:32.37,0:12:34.90,Default,,0,0,0,,{\i1}Masao ve Kazuo Tachibana forvette.{\i0}
