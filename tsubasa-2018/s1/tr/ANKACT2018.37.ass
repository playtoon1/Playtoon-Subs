Dialogue: 0,0:02:46.27,0:02:47.48,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:47.48,0:02:50.98,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:02:50.98,0:03:00.87,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:03:00.87,0:03:01.70,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:03:01.70,0:03:05.50,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:03:05.50,0:03:09.50,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:03:09.50,0:03:15.76,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.75,0:22:44.80,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.80,0:22:50.80,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.80,0:22:56.85,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.85,0:23:01.48,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:03.11,0:23:07.78,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:09.11,0:23:15.20,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:15.20,0:23:21.25,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.25,0:23:25.71,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:27.01,0:23:33.35,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.35,0:23:39.39,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.39,0:23:45.69,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.75,0:22:44.80,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.80,0:22:50.80,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.80,0:22:56.85,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.85,0:23:01.48,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.11,0:23:07.78,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:09.11,0:23:15.20,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:15.20,0:23:21.25,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.25,0:23:25.71,OPED,,0,0,0,,Bir gün, bir şimşek vuruşunu yapacağım!
Dialogue: 0,0:23:27.01,0:23:33.35,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.35,0:23:39.39,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.39,0:23:45.69,OPED,,0,0,0,,Bu hırslı gençlik sahada!
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
