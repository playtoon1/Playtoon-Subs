Dialogue: 0,0:00:14.92,0:00:16.37,Default,,0,0,0,,Büyük gün geldi demek.
Dialogue: 0,0:00:16.60,0:00:17.16,Default,,0,0,0,,Evet.
Dialogue: 0,0:00:17.57,0:00:18.64,Default,,0,0,0,,Ben daha sonra gelirim.
Dialogue: 0,0:00:18.92,0:00:21.16,Default,,0,0,0,,Tamam. Koçsun tabii.
Dialogue: 0,0:00:21.80,0:00:22.92,Default,,0,0,0,,Ben gidiyorum.
Dialogue: 0,0:00:26.69,0:00:29.00,Default,,0,0,0,,Dışarı çıktığında hep bunu mu yapar?
Dialogue: 0,0:00:29.19,0:00:30.19,Default,,0,0,0,,Evet.
Dialogue: 0,0:00:30.92,0:00:32.71,Default,,0,0,0,,İyi bir şey mi acaba?
Dialogue: 0,0:00:33.72,0:00:37.94,Default,,0,0,0,,Futbol yeteneklerini geliştirmek için ünlü futbol\Ntakımına sahip
Dialogue: 0,0:00:37.95,0:00:40.32,Default,,0,0,0,,...Shutetsu İlkokulu'na gidecekti değil mi?
Dialogue: 0,0:00:40.72,0:00:43.81,Default,,0,0,0,,Nankatsu'yu kendisi seçtiği için sorun yok.
Dialogue: 0,0:00:44.00,0:00:45.84,Default,,0,0,0,,Hem arkadaş edinmiş gibi de görünüyor.
Dialogue: 0,0:00:46.68,0:00:47.58,Default,,0,0,0,,Üstelik...
Dialogue: 0,0:00:47.58,0:00:49.43,Default,,0,0,0,,...ona sen koçluk yapacaksın.
Dialogue: 0,0:00:49.81,0:00:52.47,Default,,0,0,0,,Babası da bu konuda çok mutlu.
Dialogue: 0,0:01:06.80,0:01:12.39,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:01:06.80,0:01:12.39,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:01:12.39,0:01:17.06,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:01:12.39,0:01:17.06,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:01:18.31,0:01:22.98,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:01:18.31,0:01:22.98,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:01:23.86,0:01:31.57,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:01:23.86,0:01:31.57,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:01:31.57,0:01:37.33,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:01:31.57,0:01:37.33,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:01:37.33,0:01:46.09,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:01:37.33,0:01:46.09,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:01:46.09,0:01:51.64,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:01:46.09,0:01:51.64,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:01:51.64,0:01:57.56,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:01:51.64,0:01:57.56,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:01:57.56,0:01:59.23,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:01:57.56,0:01:59.23,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:01:59.23,0:02:06.44,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:01:59.23,0:02:06.44,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo\N
Dialogue: 0,0:02:06.44,0:02:09.45,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:02:06.44,0:02:09.45,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:02:09.45,0:02:13.87,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:02:09.45,0:02:13.87,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:02:25.36,0:02:29.19,Default,,0,0,0,,{\pos(973.333,691.334)}Bölüm 4: Tsubasa ve Roberto\NÇeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:02:43.19,0:02:47.00,Default,,0,0,0,,# Tıbbi Tanı Belgesi\NBay Roberto Hongo'ya #
Dialogue: 0,0:02:53.75,0:02:54.72,Default,,0,0,0,,{\i1}Baksana Roberto.{\i0}
Dialogue: 0,0:02:55.46,0:02:58.87,Default,,0,0,0,,{\i1}Brezilya milli takımında giydiğin\Nformayı getirdin mi?{\i0}
Dialogue: 0,0:02:58.87,0:02:59.68,Default,,0,0,0,,{\i1}Ne?{\i0}
Dialogue: 0,0:02:59.68,0:03:03.63,Default,,0,0,0,,{\i1}Giydiğin gerçek formayı\Ngörmeyi istiyorum.{\i0}
Dialogue: 0,0:03:05.43,0:03:06.33,Default,,0,0,0,,{\i1}Pekala.{\i0}
Dialogue: 0,0:03:08.94,0:03:10.65,Default,,0,0,0,,{\i1}Vay, harika!{\i0}
Dialogue: 0,0:03:10.80,0:03:12.11,Default,,0,0,0,,{\i1}10 numara!{\i0}
Dialogue: 0,0:03:12.46,0:03:14.84,Default,,0,0,0,,{\i1}Şuna baksana anne!\NGerçek!{\i0}
Dialogue: 0,0:03:15.43,0:03:17.03,Default,,0,0,0,,{\i1}Çok havalı duruyor.{\i0}
Dialogue: 0,0:03:17.75,0:03:19.08,Default,,0,0,0,,{\i1}Bu arada Roberto...{\i0}
Dialogue: 0,0:03:19.46,0:03:21.46,Default,,0,0,0,,{\i1}...bunu yıkamış mıydın?{\i0}
Dialogue: 0,0:03:22.36,0:03:24.00,Default,,0,0,0,,{\i1}Yıkadım tabii.{\i0}
Dialogue: 0,0:03:24.19,0:03:25.11,Default,,0,0,0,,{\i1}Roberto!{\i0}
Dialogue: 0,0:03:26.11,0:03:29.40,Default,,0,0,0,,{\i1}En iyi Japon takımında\Ndünyayı karşıma alacağım.{\i0}
Dialogue: 0,0:03:29.94,0:03:32.19,Default,,0,0,0,,{\i1}Brezilya bile karşımda duramayacak.{\i0}
Dialogue: 0,0:03:32.87,0:03:33.94,Default,,0,0,0,,{\i1}Büyük laflar.{\i0}
Dialogue: 0,0:03:34.75,0:03:37.28,Default,,0,0,0,,{\i1}Bu sözleri unutmayacağım.{\i0}
Dialogue: 0,0:03:37.63,0:03:38.56,Default,,0,0,0,,{\i1}Tamam!{\i0}
Dialogue: 0,0:03:43.87,0:03:45.08,Default,,0,0,0,,Dünya demek.
Dialogue: 0,0:03:45.22,0:03:47.80,Default,,0,0,0,,# Tıbbi Tanı Belgesi\NBay Roberto Hongo'ya #
Dialogue: 0,0:03:54.22,0:03:54.91,Default,,0,0,0,,Günaydın.
Dialogue: 0,0:03:55.08,0:03:58.31,Default,,0,0,0,,Ne?! Futbol kulübü maç mı kazandı?!
Dialogue: 0,0:04:00.87,0:04:02.87,Default,,0,0,0,,Skorlara kendin bakmaya ne dersin?!
Dialogue: 0,0:04:03.80,0:04:04.56,Default,,0,0,0,,Gerçekten öyle!
Dialogue: 0,0:04:04.71,0:04:06.52,Default,,0,0,0,,Nishigaoka İlkokulu'na karşı\N5-2 mi kazandınız?!
Dialogue: 0,0:04:06.68,0:04:07.68,Default,,0,0,0,,Harika!
Dialogue: 0,0:04:07.84,0:04:10.84,Default,,0,0,0,,O berbat futbol kulübünüz\Nnasıl 5 gol attı?
Dialogue: 0,0:04:12.63,0:04:14.68,Default,,0,0,0,,Sorman iyi oldu!
Dialogue: 0,0:04:15.03,0:04:17.27,Default,,0,0,0,,Yeni kulüp üyemiz...
Dialogue: 0,0:04:17.43,0:04:19.75,Default,,0,0,0,,...Ozora Tsubasa kendi başına\N4 tane attı!
Dialogue: 0,0:04:20.27,0:04:22.63,Default,,0,0,0,,Üstelik 5. golü atan da bendim!
Dialogue: 0,0:04:23.75,0:04:27.43,Default,,0,0,0,,Kafa vuruşuyla harika bir gol attım.
Dialogue: 0,0:04:27.60,0:04:30.31,Default,,0,0,0,,Tsubasa-kun'un ortası sayesindeydi gerçi.
Dialogue: 0,0:04:30.87,0:04:33.80,Default,,0,0,0,,Dur bir, dur. O dediğin Tsubasa da kim?
Dialogue: 0,0:04:33.94,0:04:36.39,Default,,0,0,0,,Ne zaman yeni bir üye aldınız ki?
Dialogue: 0,0:04:36.56,0:04:37.51,Default,,0,0,0,,O konuya gelirsek...
Dialogue: 0,0:04:37.87,0:04:41.68,Default,,0,0,0,,...ilkbahar tatilinde kaderin\Nbir cilvesi olarak tanıştık.
Dialogue: 0,0:04:42.11,0:04:44.60,Default,,0,0,0,,Kader mi? Ne diyorsun ya?
Dialogue: 0,0:04:44.75,0:04:47.60,Default,,0,0,0,,Yani Tsubasa denilen kişi olmasa...
Dialogue: 0,0:04:47.75,0:04:49.27,Default,,0,0,0,,...hiç gol atamazdınız.
Dialogue: 0,0:04:50.60,0:04:53.68,Default,,0,0,0,,Bir kişinin dört gol atması\Nhat trickten bile daha iyi.
Dialogue: 0,0:04:53.83,0:04:56.16,Default,,0,0,0,,Shutetsu'da bile öyle birisi yok.
Dialogue: 0,0:04:56.47,0:04:58.87,Default,,0,0,0,,Şaşırtacak şeylerimiz daha bitmedi.
Dialogue: 0,0:04:59.04,0:05:01.38,Default,,0,0,0,,Futbol kulübümüzün yeni bir koçu var.
Dialogue: 0,0:05:01.43,0:05:02.94,Default,,0,0,0,,Evet, aynen öyle.
Dialogue: 0,0:05:03.11,0:05:07.47,Default,,0,0,0,,Koçumuz, Brezilya milli takımının eski\Noyuncusu Roberto Hongo.
Dialogue: 0,0:05:08.19,0:05:09.43,Default,,0,0,0,,Brezilya milli takımı mı?!
Dialogue: 0,0:05:09.80,0:05:13.39,Default,,0,0,0,,Harika değil mi?!\NTsubasa'nın tanıdığı!
Dialogue: 0,0:05:13.56,0:05:16.39,Default,,0,0,0,,Nasıl birisi bu Ozora Tsubasa?
Dialogue: 0,0:05:16.72,0:05:18.19,Default,,0,0,0,,Bakın, Tsubasa.
Dialogue: 0,0:05:23.63,0:05:24.92,Default,,0,0,0,,Tsubasa o mu?
Dialogue: 0,0:05:25.07,0:05:27.31,Default,,0,0,0,,Evet, Ozora Tsubasa.
Dialogue: 0,0:05:27.72,0:05:29.83,Default,,0,0,0,,Neden top sürüyor ki?
Dialogue: 0,0:05:30.23,0:05:33.23,Default,,0,0,0,,İşte böyle birisi.\NEvden buraya kadar top sürmüştür kesin.
Dialogue: 0,0:05:33.39,0:05:34.64,Default,,0,0,0,,Evden buraya kadar mı?!
Dialogue: 0,0:05:34.72,0:05:36.11,Default,,0,0,0,,Hep böyledir.
Dialogue: 0,0:05:36.39,0:05:38.80,Default,,0,0,0,,Nereye gitse top sürerek gider.
Dialogue: 0,0:05:38.80,0:05:40.36,Default,,0,0,0,,Ne?
Dialogue: 0,0:05:40.36,0:05:41.47,Default,,0,0,0,,Çok iyiymiş.
Dialogue: 0,0:05:41.63,0:05:44.72,Default,,0,0,0,,5 gol attığı doğru olmalı.
Dialogue: 0,0:05:45.04,0:05:46.83,Default,,0,0,0,,Bunu yapabilecek birisine benziyor.
Dialogue: 0,0:05:47.16,0:05:48.80,Default,,0,0,0,,Birisini ben attım be.
Dialogue: 0,0:05:48.94,0:05:50.83,Default,,0,0,0,,Sadece 4 gol attı o.
Dialogue: 0,0:05:51.27,0:05:53.60,Default,,0,0,0,,Hey, Tsubasa!
Dialogue: 0,0:05:54.19,0:05:56.23,Default,,0,0,0,,Ishizaki-kun, günaydın!
Dialogue: 0,0:05:58.04,0:06:00.87,Default - Copy,,0,0,0,,{\frz13.8\pos(738.666,94)}6. Sene 1. Sınıf
Dialogue: 0,0:06:01.04,0:06:05.19,Default,,0,0,0,,{\i1}# Ozora Tsubasa #{\i0}
Dialogue: 0,0:06:05.51,0:06:10.39,Default,,0,0,0,,Bugünde itibaren bu sınıfa arkadaşınız\Nolarak katılacak Ozora Tsubasa-kun.
Dialogue: 0,0:06:10.60,0:06:12.68,Default,,0,0,0,,Herkes iyi anlaşsın.
Dialogue: 0,0:06:13.11,0:06:16.27,Default,,0,0,0,,Adım Ozora Tsubasa.\Nİyi geçinelim!
Dialogue: 0,0:06:17.56,0:06:18.83,Default,,0,0,0,,Bu arada...
Dialogue: 0,0:06:19.63,0:06:23.04,Default,,0,0,0,,...o futbol topunu neden getirdin?
Dialogue: 0,0:06:23.60,0:06:24.87,Default,,0,0,0,,Arkadaşım.
Dialogue: 0,0:06:25.31,0:06:27.27,Default,,0,0,0,,Arkadaşın mı?
Dialogue: 0,0:06:27.47,0:06:28.16,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:28.56,0:06:31.87,Default,,0,0,0,,Hocam, Tsubasa futbol kulübüne katıldı.
Dialogue: 0,0:06:32.16,0:06:34.80,Default,,0,0,0,,Bu sene futbol kulübü,\Nöncekinden çok farklı olacak!
Dialogue: 0,0:06:35.04,0:06:36.87,Default,,0,0,0,,Okullar arası turnuva harika olacak!
Dialogue: 0,0:06:37.23,0:06:40.27,Default,,0,0,0,,Amigo kaptanı, tezahüratta sana güveniyoruz.
Dialogue: 0,0:06:40.68,0:06:43.31,Default,,0,0,0,,Gözünü o kadar yükseklere\Ndikmen iyi mi gerçekten?
Dialogue: 0,0:06:43.47,0:06:45.36,Default,,0,0,0,,Harika olan Tsubasa-kun değil mi hem?
Dialogue: 0,0:06:45.51,0:06:48.36,Default,,0,0,0,,Kalan herkes futbol kulübünün\Nişe yaramazları işte.
Dialogue: 0,0:06:48.51,0:06:49.80,Default,,0,0,0,,Hiç de bile.
Dialogue: 0,0:06:51.68,0:06:53.16,Default,,0,0,0,,Ishizaki-kun da herkes de...
Dialogue: 0,0:06:53.31,0:06:56.23,Default,,0,0,0,,...okullara arası turnuvaya kadar\Ntopla daha da arkadaş olup...
Dialogue: 0,0:06:56.47,0:06:59.47,Default,,0,0,0,,...futbolda daha iyi\Nolacaklarını Roberto söyledi.
Dialogue: 0,0:07:00.11,0:07:02.07,Default,,0,0,0,,Yine arkadaş dedi.
Dialogue: 0,0:07:02.23,0:07:03.11,Default,,0,0,0,,Pekala!
Dialogue: 0,0:07:03.60,0:07:07.11,Default,,0,0,0,,Öyleyse okuldan sonra gidip futbol\Nkulübünün antrenmanını izleyelim!
Dialogue: 0,0:07:07.27,0:07:08.04,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:09.39,0:07:10.75,Default,,0,0,0,,Şey...
Dialogue: 0,0:07:11.07,0:07:13.92,Default,,0,0,0,,Giriş töreni de başlamak üzereydi ama.
Dialogue: 0,0:07:15.39,0:07:17.51,Default,,0,0,0,,{\i1}Nankatsu İlkokulu öğrencileri.{\i0}
Dialogue: 0,0:07:17.94,0:07:22.11,Default,,0,0,0,,{\i1}Özellikle spor kulüplerindeki 4. sınıf\Nve üstü sınıftakiler...{\i0}
Dialogue: 0,0:07:22.56,0:07:26.31,Default,,0,0,0,,{\i1}...bugünkü giriş töreninin bitmesini\Nsabırsızlıkla bekliyordu.{\i0}
Dialogue: 0,0:07:27.56,0:07:30.04,Default,,0,0,0,,{\i1}Shutetsu İlkokulu ile yapılacak olan...{\i0}
Dialogue: 0,0:07:30.19,0:07:33.27,Default,,0,0,0,,{\i1}...turnuvaya sıkı hazırlanmaya\Nbugünden itibaren başlayacaklardı.{\i0}
Dialogue: 0,0:07:34.56,0:07:36.63,Default,,0,0,0,,- Aylaklık etmeyin!\N- Tamam!
Dialogue: 0,0:07:37.00,0:07:41.00,Default,,0,0,0,,Bu sene okullar arası turnuvada beyzbol\Nkulübü arka arkaya 3 yıl kazanmış olacak!
Dialogue: 0,0:07:41.16,0:07:42.60,Default,,0,0,0,,Evet!
Dialogue: 0,0:07:43.04,0:07:44.72,Default,,0,0,0,,Biz kendo kulübü...
Dialogue: 0,0:07:45.31,0:07:47.68,Default,,0,0,0,,...geçen seneki utancı temizleyeceğiz!
Dialogue: 0,0:07:48.56,0:07:50.16,Default,,0,0,0,,Pes etmeyin! Koşmaya devam!
Dialogue: 0,0:07:50.56,0:07:53.47,Default,,0,0,0,,Okullar arası turnuvaya az kaldı!\NSalmak yok!
Dialogue: 0,0:07:54.60,0:07:55.83,Default,,0,0,0,,{\i1}Okullar arası turnuva...{\i0}
Dialogue: 0,0:07:56.43,0:08:01.06,Default,,0,0,0,,{\i1}Şehirdeki iki ilkokul\NNankatsu İlkokulu ve Shutetsu İlkokulu'nun....{\i0}
Dialogue: 0,0:08:01.06,0:08:06.36,Default,,0,0,0,,{\i1}...tüm kulüplerinin katıldığı gün boyu\Nsüren bir spor festivalidir.{\i0}
Dialogue: 0,0:08:06.92,0:08:09.11,Default,,0,0,0,,{\i1}26. turnuvaya çok az kalmışken...{\i0}
Dialogue: 0,0:08:09.27,0:08:14.27,Default,,0,0,0,,{\i1}...on ikişer zafer ve bir beraberlik ile\Nmükemmel bir eşitlik söz konusuydu.{\i0}
Dialogue: 0,0:08:09.63,0:08:14.27,Default,,0,0,0,,{\b1\pos(640,493.333)}SHUUTETSU                                  NANKATSU{\b0}
Dialogue: 0,0:08:13.27,0:08:15.00,Default,,0,0,0,,{\b1\pos(645.333,276.667)}On İkişer Zafer Bir Beraberlik
Dialogue: 0,0:08:15.39,0:08:16.39,Default,,0,0,0,,# Nankatsu Kazanacak #
Dialogue: 0,0:08:16.56,0:08:18.87,Default,,0,0,0,,Bir, iki! Bir, iki!
Dialogue: 0,0:08:19.27,0:08:21.83,Default,,0,0,0,,Bu sene sonunda bir dikiş tutturacağız.
Dialogue: 0,0:08:22.04,0:08:24.43,Default,,0,0,0,,Her kulüp de aşırı gaza gelmiş durumda.
Dialogue: 0,0:08:24.60,0:08:25.87,Default,,0,0,0,,Değil mi Anego?
Dialogue: 0,0:08:24.60,0:08:29.04,Default,,0,0,0,,{\an8\i1}ÇN: Anego: Aniki'nin kadın hali.\NAbla, büyük abla tarzı bir anlamı var.{\i0}
Dialogue: 0,0:08:26.92,0:08:29.04,Default,,0,0,0,,Ana sorun futbol kulübü.
Dialogue: 0,0:08:29.43,0:08:32.67,Default,,0,0,0,,Gidelim Anego.\NBakalım Tsubasa ne kadar yetenekliymiş.
Dialogue: 0,0:08:32.91,0:08:35.36,Default,,0,0,0,,Pekala, futbol sahasına gidelim!
Dialogue: 0,0:08:35.51,0:08:36.60,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:41.84,0:08:45.03,Default,,0,0,0,,Of, of.\NRoberto ulu orta bırakmış bunu.
Dialogue: 0,0:08:45.91,0:08:50.55,Default,,0,0,0,,As forvet, 10 numara Roberto Hongo.
Dialogue: 0,0:08:51.42,0:08:54.72,Default,,0,0,0,,Bir Tsubasa değil ama havalı birisi.
Dialogue: 0,0:08:55.09,0:08:57.55,Default,,0,0,0,,Temizlik vardı ya.
Dialogue: 0,0:09:01.60,0:09:02.85,Default,,0,0,0,,Hayır ya.
Dialogue: 0,0:09:05.56,0:09:09.57,Default,sign,0,0,0,,# Tıbbi Tanı Belgesi\NBay Roberto Hongo'ya #
Dialogue: 0,0:09:07.73,0:09:09.57,Default,,0,0,0,,Oftalmoloji mi?
Dialogue: 0,0:09:11.65,0:09:13.19,Default,,0,0,0,,Roberto, özür dilerim.
Dialogue: 0,0:09:21.04,0:09:22.41,Default,,0,0,0,,Bu da ne demek?
Dialogue: 0,0:09:26.58,0:09:28.13,Default,,0,0,0,,Roberto...
Dialogue: 0,0:09:28.13,0:09:29.38,Default,,0,0,0,,Olamaz.
Dialogue: 0,0:09:35.39,0:09:39.12,Default,,0,0,0,,{\pos(304,670)}Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:09:39.12,0:09:44.20,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:09:52.94,0:09:54.78,Default,,0,0,0,,Hava da ne güzel.
Dialogue: 0,0:09:58.53,0:10:00.95,Default,,0,0,0,,{\i1}Sevgili Koç João,{\i0}
Dialogue: 0,0:10:01.95,0:10:03.45,Default,,0,0,0,,{\i1}Gerçekten de işe yaramadı.{\i0}
Dialogue: 0,0:10:04.20,0:10:05.96,Default,,0,0,0,,{\i1}Elimden geleni yaptım...{\i0}
Dialogue: 0,0:10:05.96,0:10:07.79,Default,,0,0,0,,{\i1}...ve Kaptan Ozora'nın tavsiyesiyle...{\i0}
Dialogue: 0,0:10:07.79,0:10:10.42,Default,,0,0,0,,{\i1}...Japonya'ya döndüm sonunda.{\i0}
Dialogue: 0,0:10:11.42,0:10:13.96,Default,,0,0,0,,{\i1}Ama tanıya göre...{\i0}
Dialogue: 0,0:10:13.96,0:10:15.47,Default,,0,0,0,,{\i1}...retina ayrılmam varmış.{\i0}
Dialogue: 0,0:10:16.09,0:10:18.30,Default,,0,0,0,,{\i1}Fark etmede geç kaldığımız bir gerçek.{\i0}
Dialogue: 0,0:10:18.30,0:10:20.72,Default,,0,0,0,,{\i1}Futbol oynamaya devam edersem...{\i0}
Dialogue: 0,0:10:24.10,0:10:27.31,Default,,0,0,0,,{\i1}...maç sırasında alacağım ağır bir darbe...{\i0}
Dialogue: 0,0:10:28.19,0:10:32.11,Default,,0,0,0,,{\i1}...gözlerimi sonsuza dek kör edebilir.{\i0}
Dialogue: 0,0:10:34.69,0:10:37.74,Default,,0,0,0,,{\i1}Lütfen emekliye ayrıldığımı duyurun.{\i0}
Dialogue: 0,0:10:37.74,0:10:40.99,Default,,0,0,0,,{\i1}Bir süre daha Japonya'da kalmayı planlıyorum.{\i0}
Dialogue: 0,0:10:42.24,0:10:46.16,Default,,0,0,0,,Brezilya milli takımından Roberto Hongo,\Nçok şık top sürüyor!
Dialogue: 0,0:10:47.29,0:10:50.58,Default,,0,0,0,,{\i1}Hayır, futbol oynayamaz hale geldim.{\i0}
Dialogue: 0,0:10:51.04,0:10:55.09,Default,,0,0,0,,{\i1}Bu durumda vatanım Japonya'da\Nkalmam en iyisi olabilir.{\i0}
Dialogue: 0,0:10:56.17,0:10:58.09,Default,,0,0,0,,{\i1}Benim için endişelenmeyin.{\i0}
Dialogue: 0,0:10:59.47,0:11:04.14,Default,,0,0,0,,{\i1}Brezilya'dan ayrıldığımdan beri\Nkendimi buna hazırlıyordum.{\i0}
Dialogue: 0,0:11:08.56,0:11:12.40,Default,,0,0,0,,{\i1}Ama eğer bir gün\NBrezilya'ya dönersem...{\i0}
Dialogue: 0,0:11:12.40,0:11:13.36,Default,,0,0,0,,{\i1}...o zaman...{\i0}
Dialogue: 0,0:11:13.86,0:11:16.40,Default,,0,0,0,,{\i1}...yalnız olmayacağımı hissediyorum.{\i0}
Dialogue: 0,0:11:17.90,0:11:21.53,Default,,0,0,0,,{\i1}Vatanım Japonya'da yeni bir kıvılcım buldum.{\i0}
Dialogue: 0,0:11:21.53,0:11:23.74,Default,,0,0,0,,Millet, antrenmana başlayalım.
Dialogue: 0,0:11:23.74,0:11:24.87,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:24.87,0:11:28.29,Default,,0,0,0,,{\i1}Bu kıvılcımın adı Ozora Tsubasa.{\i0}
Dialogue: 0,0:11:29.12,0:11:31.62,Default,,0,0,0,,- Roberto!\N- Koç!
Dialogue: 0,0:11:33.79,0:11:35.21,Default,,0,0,0,,Pekala. Yapalım şunu.
Dialogue: 0,0:11:36.67,0:11:37.88,Default,,0,0,0,,Roberto!
Dialogue: 0,0:11:46.51,0:11:48.89,Default,,0,0,0,,H-Harika...
Dialogue: 0,0:11:50.19,0:11:52.19,Default,,0,0,0,,Güzel şut Roberto.
Dialogue: 0,0:11:52.19,0:11:54.11,Default,,0,0,0,,Güzel bas Tsubasa.
Dialogue: 0,0:11:55.73,0:11:56.94,Default,,0,0,0,,Harika!
Dialogue: 0,0:11:56.94,0:11:59.24,Default,,0,0,0,,Gördünüz mü? Gördünüz mü?\NAz öncekini gördünüz mü?
Dialogue: 0,0:11:59.24,0:12:01.07,Default,,0,0,0,,E-Evet...
Dialogue: 0,0:12:01.07,0:12:02.78,Default,,0,0,0,,Tsubasa da çok harika ama...
Dialogue: 0,0:12:02.78,0:12:06.20,Default,,0,0,0,,...o amca da fena değil.\NAz önceki şutu özellikle.
Dialogue: 0,0:12:06.20,0:12:08.04,Default,,0,0,0,,Koçları o mu?
Dialogue: 0,0:12:08.04,0:12:11.46,Default,,0,0,0,,Ishizaki'nin bahsettiği Brezilyalı oyuncu.
Dialogue: 0,0:12:11.46,0:12:14.17,Default,,0,0,0,,Bilmem ne Hongo demişti.
Dialogue: 0,0:12:14.63,0:12:16.34,Default,,0,0,0,,Roberto Hongo.
Dialogue: 0,0:12:16.34,0:12:19.13,Default,,0,0,0,,Brezilya milli takım\Noyuncusu ile konuşuyorsunuz.
Dialogue: 0,0:12:19.13,0:12:20.88,Default,,0,0,0,,Eski oyuncu gerçi.
Dialogue: 0,0:12:21.34,0:12:22.84,Default,,0,0,0,,Siz kimsiniz?
Dialogue: 0,0:12:22.84,0:12:25.01,Default,,0,0,0,,Nankatsu'nun amigo ekibi.
Dialogue: 0,0:12:26.18,0:12:27.97,Default,,0,0,0,,Ben Nakazawa Sanae.
Dialogue: 0,0:12:27.97,0:12:30.56,Default,,0,0,0,,Nankatsu İlkokulu'nun amigo\Nekibi kaptanıyım.
Dialogue: 0,0:12:30.56,0:12:32.06,Default,,0,0,0,,Herkes Anego der.
Dialogue: 0,0:12:32.06,0:12:34.19,Default,,0,0,0,,Bunu demen gerekmiyordu!
Dialogue: 0,0:12:35.44,0:12:38.69,Default,,0,0,0,,Öyleyse futbol kulübünü\Ndesteklemeye mi geldiniz?
Dialogue: 0,0:12:38.69,0:12:39.65,Default,,0,0,0,,Hayır.
Dialogue: 0,0:12:39.65,0:12:42.86,Default,,0,0,0,,Aslında Ishizaki'den dünkü maçta\NNishigaoka İlkokulu'nu yendiğinizi duydum...
Dialogue: 0,0:12:42.86,0:12:46.62,Default,,0,0,0,,...ve Tsubasa ile sizi\Nmerak ettiğimizden geldik.
Dialogue: 0,0:12:47.62,0:12:52.50,Default,,0,0,0,,Berbat futbol takımımızın büyük\Nbir değişim geçireceğini söyledi Ishizaki.
Dialogue: 0,0:12:52.50,0:12:54.92,Default,,0,0,0,,Nasıl bir değişiklik\Nolduğunu görmeye geldik.
Dialogue: 0,0:12:58.88,0:13:02.63,Default,,0,0,0,,Tamam. Öyleyse önce bir maçla başlayalım.
Dialogue: 0,0:13:02.63,0:13:03.84,Default,,0,0,0,,Maç mı?
Dialogue: 0,0:13:03.84,0:13:07.10,Default,,0,0,0,,Tsubasa için hoş geldin partisi.
Dialogue: 0,0:13:15.48,0:13:18.11,Default,,0,0,0,,Hoş geldin partisi bu mu?
Dialogue: 0,0:13:18.11,0:13:20.57,Default,,0,0,0,,Tsubasa ile tanıştığım zamankinin\Ntam tersi olacak.
Dialogue: 0,0:13:20.57,0:13:23.86,Default,,0,0,0,,Shutetsu B takımı ve\Nonun arasındakinden.
Dialogue: 0,0:13:24.24,0:13:26.49,Default,,0,0,0,,Tsubasa tek başına atak yapacak.
Dialogue: 0,0:13:26.49,0:13:29.87,Default,,0,0,0,,Ishizaki'ler ise paslaşacak\Nve Tsubasa'yı tutacak.
Dialogue: 0,0:13:29.87,0:13:33.04,Default,,0,0,0,,Topu sizden almasına\Nizin vermemelisiniz yani.
Dialogue: 0,0:13:33.41,0:13:35.67,Default,,0,0,0,,Tsubasa topu alırsa şut çekecek.
Dialogue: 0,0:13:35.67,0:13:37.88,Default,,0,0,0,,Zaman sınırı 5 dakika.
Dialogue: 0,0:13:37.88,0:13:40.46,Default,,0,0,0,,Şut gol olursa Tsubasa kazanır.
Dialogue: 0,0:13:40.46,0:13:44.26,Default,,0,0,0,,Gol olmasını 5 dakika\Nengelleyebilirseniz Ishizaki'ler kazanır.
Dialogue: 0,0:13:44.26,0:13:45.38,Default,,0,0,0,,Tamam!
Dialogue: 0,0:13:45.38,0:13:47.47,Default,,0,0,0,,Çok çılgın bir oyun değil mi?
Dialogue: 0,0:13:47.47,0:13:50.26,Default,,0,0,0,,Tsubasa bile olsa\Ntek başına çok zor değil mi?
Dialogue: 0,0:13:50.26,0:13:52.64,Default,,0,0,0,,Kesin sesinizi de izleyin.
Dialogue: 0,0:13:54.64,0:13:57.10,Default,,0,0,0,,Tsubasa-kun'a karşı oynayacağız.
Dialogue: 0,0:13:57.10,0:13:59.27,Default,,0,0,0,,Hemen topu alacaktır.
Dialogue: 0,0:13:59.27,0:14:01.77,Default,,0,0,0,,Ne korkak çıktınız be!
Dialogue: 0,0:14:01.77,0:14:04.15,Default,,0,0,0,,Topu alırsa geri alırsınız.
Dialogue: 0,0:14:04.15,0:14:06.28,Default,,0,0,0,,Tsubasa'ya karşı\Noynamak harika olmayacak mı?
Dialogue: 0,0:14:06.57,0:14:08.57,Default,,0,0,0,,Ishizaki, çok iyimsersin.
Dialogue: 0,0:14:08.57,0:14:12.12,Default,,0,0,0,,Tsubasa'ya karşı biz...\NYapalım şunu!
Dialogue: 0,0:14:12.87,0:14:14.91,Default,,0,0,0,,Tsubasa, gel bakalım!
Dialogue: 0,0:14:14.91,0:14:16.92,Default,,0,0,0,,Geliyorum millet!
Dialogue: 0,0:14:24.88,0:14:26.26,Default,,0,0,0,,Başlayın!
Dialogue: 0,0:14:27.38,0:14:30.64,Default,,0,0,0,,Geliyor! Nagano, Tsubasa'yı markaja al!
Dialogue: 0,0:14:30.64,0:14:31.64,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:35.14,0:14:37.02,Default,,0,0,0,,Özür dilerim Tsubasa.
Dialogue: 0,0:14:37.02,0:14:39.65,Default,,0,0,0,,Gelecek 5 dakika seni markaja alacağız.
Dialogue: 0,0:14:44.11,0:14:45.57,Default,,0,0,0,,Geçti!
Dialogue: 0,0:14:45.57,0:14:47.82,Default,,0,0,0,,Hey, hey! Önü açık!
Dialogue: 0,0:14:47.82,0:14:49.24,Default,,0,0,0,,Oda!
Dialogue: 0,0:14:53.03,0:14:55.04,Default,,0,0,0,,Nakazato!
Dialogue: 0,0:14:57.16,0:14:58.12,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:14:58.12,0:14:59.79,Default,,0,0,0,,Ulan...
Dialogue: 0,0:15:01.75,0:15:03.75,Default,,0,0,0,,Sana bırakıyorum, al şunu!
Dialogue: 0,0:15:03.75,0:15:05.42,Default,,0,0,0,,Bende!
Dialogue: 0,0:15:08.26,0:15:09.63,Default,,0,0,0,,Çok hızlı!
Dialogue: 0,0:15:13.85,0:15:15.81,Default,,0,0,0,,Millet, Tsubasa'yı tutun!
Dialogue: 0,0:15:23.36,0:15:24.57,Default,,0,0,0,,Çok güçlü.
Dialogue: 0,0:15:24.57,0:15:27.32,Default,,0,0,0,,Ishizaki'ler onun dengi değil.
Dialogue: 0,0:15:27.32,0:15:29.74,Default,,0,0,0,,Anego, çok yetenekli bu.
Dialogue: 0,0:15:29.74,0:15:32.57,Default,,0,0,0,,Sanki top bedeninin bir parçası gibi.
Dialogue: 0,0:15:34.58,0:15:36.33,Default,,0,0,0,,Son 3 dakika.
Dialogue: 0,0:15:36.33,0:15:38.29,Default,,0,0,0,,Hala vaktimiz var!
Dialogue: 0,0:15:38.29,0:15:40.54,Default,,0,0,0,,Herkes topu geri almaya!
Dialogue: 0,0:15:40.54,0:15:42.88,Default,,0,0,0,,Roberto'yu hayal kırıklığına uğratamayız!
Dialogue: 0,0:15:42.88,0:15:44.88,Default,,0,0,0,,- Tamam!\N- Tamamdır.
Dialogue: 0,0:15:51.47,0:15:53.34,Default,,0,0,0,,Manabu, hadi.
Dialogue: 0,0:15:53.34,0:15:55.10,Default,,0,0,0,,Son bir dakika.
Dialogue: 0,0:16:01.60,0:16:02.44,Default,,0,0,0,,{\i1}İşte bu.{\i0}
Dialogue: 0,0:16:03.10,0:16:05.19,Default,,0,0,0,,{\i1}Herkesin hareketleri değişti.{\i0}
Dialogue: 0,0:16:05.65,0:16:09.69,Default,,0,0,0,,{\i1}Tsubasa ile antrenman yaparak\Nherkes kısa sürede gelişecek.{\i0}
Dialogue: 0,0:16:10.15,0:16:14.70,Default,,0,0,0,,{\i1}Koç da bunu bildiği için bizi\Nonunla karşı karşıya getirdi.{\i0}
Dialogue: 0,0:16:14.70,0:16:19.08,Default,,0,0,0,,{\i1}İşte böyle, bu gidişle okullar\Narası turnuvada kazanacağız!{\i0}
Dialogue: 0,0:16:27.09,0:16:28.96,Default,,0,0,0,,Git!
Dialogue: 0,0:16:33.55,0:16:35.55,Default,,0,0,0,,Girdi!
Dialogue: 0,0:16:36.30,0:16:37.81,Default,,0,0,0,,Bitti.
Dialogue: 0,0:16:49.94,0:16:52.57,Default,,0,0,0,,Of be... Kaybettik.
Dialogue: 0,0:16:52.57,0:16:55.82,Default,,0,0,0,,Tsubasa-kun gerçekten harika.
Dialogue: 0,0:16:55.82,0:16:59.58,Default,,0,0,0,,Tsubasa, her zaman sağlam\Nşut çekiyorsun.
Dialogue: 0,0:16:59.58,0:17:01.96,Default,,0,0,0,,Çünkü futbolu seviyorum.
Dialogue: 0,0:17:05.54,0:17:07.96,Default,,0,0,0,,Az önce ne oldu Anego?
Dialogue: 0,0:17:07.96,0:17:09.80,Default,,0,0,0,,Dilini mi yuttun?
Dialogue: 0,0:17:09.80,0:17:11.76,Default,,0,0,0,,Anego'yu hiç böyle görmemiştim.
Dialogue: 0,0:17:11.76,0:17:13.51,Default,,0,0,0,,Anego? Hey!
Dialogue: 0,0:17:14.84,0:17:16.09,Default,,0,0,0,,O...
Dialogue: 0,0:17:17.89,0:17:19.76,Default,,0,0,0,,...çok havalı!
Dialogue: 0,0:17:21.10,0:17:23.89,Default,,0,0,0,,Anego kıza döndü!
Dialogue: 0,0:17:23.89,0:17:25.65,Default,,0,0,0,,Millet, elinize sağlık.
Dialogue: 0,0:17:26.06,0:17:29.40,Default,,0,0,0,,Tsubasa'yı tutma konusunda iyiydiniz.
Dialogue: 0,0:17:29.40,0:17:32.40,Default,,0,0,0,,Bundan sonra benim\Ndediklerimi yapacaksınız.
Dialogue: 0,0:17:32.40,0:17:34.07,Default,,0,0,0,,- Tamam mı?\N- Tamam!
Dialogue: 0,0:17:42.25,0:17:43.04,Default,,0,0,0,,Vur!
Dialogue: 0,0:17:58.93,0:18:00.72,Default,,0,0,0,,Hiç haber var mı?
Dialogue: 0,0:18:00.72,0:18:03.85,Default,,0,0,0,,Evet, Roberto Hongo koçluğunda...
Dialogue: 0,0:18:03.85,0:18:06.52,Default,,0,0,0,,...ciddi olarak antrenmanlara başlamışlar.
Dialogue: 0,0:18:06.85,0:18:11.52,Default,,0,0,0,,Roberto Hongo altında Ozora Tsubasa'nın\Nne kadar ilerleme kaydedeceğini...
Dialogue: 0,0:18:11.52,0:18:12.94,Default,,0,0,0,,...görmek için sabırsızlanıyorum.
Dialogue: 0,0:18:13.44,0:18:15.99,Default,,0,0,0,,Diğer oyuncuların bir önemi yok.
Dialogue: 0,0:18:17.70,0:18:22.04,Default,,0,0,0,,Nishigaoka'ya karşı sadece\NTsubasa bir şeyler ortaya koydu.
Dialogue: 0,0:18:22.49,0:18:24.41,Default,,0,0,0,,Onları hafife alma.
Dialogue: 0,0:18:25.87,0:18:29.63,Default,,0,0,0,,Yine de bana denk olabilecek\Ntek kişi Tsubasa'dır!
Dialogue: 0,0:18:34.84,0:18:37.76,Default,,0,0,0,,Ne ağır bir antrenman.
Dialogue: 0,0:18:37.76,0:18:41.14,Default,,0,0,0,,Brezilyalı koç bayağı çektiriyor.
Dialogue: 0,0:18:41.14,0:18:43.51,Default,,0,0,0,,İzlemek bile yordu.
Dialogue: 0,0:18:43.51,0:18:45.39,Default,,0,0,0,,Suyum çıktı ya!
Dialogue: 0,0:18:45.39,0:18:47.48,Default,,0,0,0,,Hareket edemiyorum.
Dialogue: 0,0:18:47.48,0:18:50.61,Default,,0,0,0,,Hey! Ne mızmız çıktınız be!
Dialogue: 0,0:18:50.61,0:18:52.57,Default,,0,0,0,,Ne diyorsun be Anego?
Dialogue: 0,0:18:52.57,0:18:54.03,Default,,0,0,0,,Tsubasa-kun'a baksanıza.
Dialogue: 0,0:18:54.03,0:18:56.57,Default,,0,0,0,,Hala capcanlı.
Dialogue: 0,0:18:56.57,0:18:59.53,Default,,0,0,0,,Tsubasa bizden farklı ki!
Dialogue: 0,0:18:59.53,0:19:03.03,Default,,0,0,0,,Herkes size berbat\Nfutbol takımı diyor bu yüzden.
Dialogue: 0,0:19:03.03,0:19:05.29,Default,,0,0,0,,Değiştiğinizi sanmıştım!
Dialogue: 0,0:19:05.29,0:19:08.58,Default,,0,0,0,,Sakin, ol, sakin ol. Değişim zaman ol.
Dialogue: 0,0:19:08.58,0:19:09.79,Default,,0,0,0,,Sabırlı ol.
Dialogue: 0,0:19:09.79,0:19:11.50,Default,,0,0,0,,Sabredemiyorum!
Dialogue: 0,0:19:11.50,0:19:13.71,Default,,0,0,0,,Okullar arası turnuva başlamak üzere!
Dialogue: 0,0:19:13.71,0:19:16.55,Default,,0,0,0,,Haklısın. Başlamak üzere.\NBu yüzden millet...
Dialogue: 0,0:19:16.55,0:19:18.42,Default,,0,0,0,,...okullar arası turnuvayı kazanmak için...
Dialogue: 0,0:19:18.42,0:19:21.34,Default,,0,0,0,,...futbol topuyla arkadaş olmalısınız.
Dialogue: 0,0:19:21.34,0:19:25.22,Default,,0,0,0,,Tsubasa da koç da\Nhep arkadaş diyor.
Dialogue: 0,0:19:25.22,0:19:27.52,Default,,0,0,0,,Topla nasıl arkadaş olacağız?
Dialogue: 0,0:19:27.52,0:19:29.85,Default,,0,0,0,,Hep onunla birlikte olun.
Dialogue: 0,0:19:29.85,0:19:32.73,Default,,0,0,0,,Okula giderken de yemek yerken de...
Dialogue: 0,0:19:32.73,0:19:35.73,Default,,0,0,0,,...futbol topuyla birlikte olun hep.
Dialogue: 0,0:19:36.53,0:19:39.65,Default,,0,0,0,,Yoksa Tsubasa da hep\Nöyle mi yapıyor?
Dialogue: 0,0:19:39.65,0:19:41.03,Default,,0,0,0,,Evet, sayılır.
Dialogue: 0,0:19:41.03,0:19:44.03,Default,,0,0,0,,Yani okula gelene kadar\Ntop mu sürüyorsun?
Dialogue: 0,0:19:44.03,0:19:45.29,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:45.29,0:19:49.04,Default,,0,0,0,,Tsubasa benden öğrenmedi bunu.
Dialogue: 0,0:19:49.04,0:19:51.79,Default,,0,0,0,,Küçüklükten beri yapıyormuş.
Dialogue: 0,0:19:53.00,0:19:55.92,Default,,0,0,0,,Şu andan itibaren ellerinizi kullanamazsınız.
Dialogue: 0,0:19:55.92,0:19:59.34,Default,,0,0,0,,Futbol topu elde taşınacak bir şey değildir.
Dialogue: 0,0:19:59.34,0:20:00.88,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:20:00.88,0:20:05.47,Default,,0,0,0,,Biz de Tsubasa gibi her gittiğimiz\Nyere top sürerek gidemeyiz ki!
Dialogue: 0,0:20:05.85,0:20:07.47,Default,,0,0,0,,Gidebilirsiniz millet.
Dialogue: 0,0:20:07.47,0:20:09.18,Default,,0,0,0,,Evet, gitmelisiniz!
Dialogue: 0,0:20:09.18,0:20:10.85,Default,,0,0,0,,Söylemesi kolay!
Dialogue: 0,0:20:10.85,0:20:12.48,Default,,0,0,0,,Daha iyi olmak istemiyor musun?
Dialogue: 0,0:20:12.48,0:20:15.02,Default,,0,0,0,,Ya kaleciler?
Dialogue: 0,0:20:15.02,0:20:17.98,Default,,0,0,0,,Kaleciler için de öyle ama...
Dialogue: 0,0:20:18.36,0:20:20.24,Default,,0,0,0,,...ellerinizi kullanmanızda sorun yok.
Dialogue: 0,0:20:20.24,0:20:22.78,Default,,0,0,0,,- Yaşasın!\N- Hiç adil değil!
Dialogue: 0,0:20:22.78,0:20:24.91,Default,,0,0,0,,Öyleyse bugünlük bu kadar.
Dialogue: 0,0:20:24.91,0:20:27.54,Default,,0,0,0,,Millet, eve giderken top sürün.
Dialogue: 0,0:20:27.54,0:20:30.66,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:30.66,0:20:32.92,Default,,0,0,0,,Görüşürüz Tsubasa.
Dialogue: 0,0:20:32.92,0:20:35.42,Default,,0,0,0,,Yarın görüşürüz.
Dialogue: 0,0:20:35.42,0:20:37.75,Default,,0,0,0,,Herkes dikkatli olsun.
Dialogue: 0,0:20:37.75,0:20:40.01,Default,,0,0,0,,Tsubasa-kun'un yüzünü kara çıkarmayın.
Dialogue: 0,0:20:40.01,0:20:41.51,Default,,0,0,0,,Kes be!
Dialogue: 0,0:20:42.43,0:20:44.51,Default,,0,0,0,,İyi olacaklar mı bunlar?
Dialogue: 0,0:20:44.51,0:20:46.43,Default,,0,0,0,,Çok kötü durumdalar.
Dialogue: 0,0:20:46.43,0:20:49.18,Default,,0,0,0,,Ama bu sayede gelişecekler.
Dialogue: 0,0:20:50.98,0:20:54.73,Default,,0,0,0,,Okullar arası turnuva için sabırsızlanıyorum!
Dialogue: 0,0:20:57.40,0:21:00.99,Default,,0,0,0,,Açlıktan ölüyorum! Hemen eve dönmeliyim!
Dialogue: 0,0:21:02.74,0:21:05.62,Default,,0,0,0,,Ishizaki ne yapacağım?!
Dialogue: 0,0:21:05.62,0:21:07.45,Default,,0,0,0,,Al işte...
Dialogue: 0,0:21:07.45,0:21:08.24,Default,,0,0,0,,Ne?
Dialogue: 0,0:21:08.24,0:21:11.00,Default,,0,0,0,,Manabu, sen de mi buralarda oturuyordun?
Dialogue: 0,0:21:11.00,0:21:15.00,Default,,0,0,0,,Çünkü arkadaşım beni takmadı.
Dialogue: 0,0:21:15.00,0:21:19.05,Default,,0,0,0,,Eve böyle gidebilir miyiz gerçekten?
Dialogue: 0,0:21:19.05,0:21:21.26,Default,,0,0,0,,Kaleciye hava hoş!
Dialogue: 0,0:21:26.89,0:21:28.43,Default,,0,0,0,,{\i1}Çok iyi.{\i0}
Dialogue: 0,0:21:28.43,0:21:30.68,Default,,0,0,0,,{\i1}Onun yaşındaykenki halim gibi.{\i0}
Dialogue: 0,0:21:31.10,0:21:34.27,Default,,0,0,0,,{\i1}Hayır. Belki de daha iyisi.{\i0}
Dialogue: 0,0:21:36.69,0:21:40.07,Default,,0,0,0,,İşte. Bir kez bile yere değmedi.
Dialogue: 0,0:21:40.07,0:21:42.44,Default,,0,0,0,,Tsubasa, futbolu seviyor musun?
Dialogue: 0,0:21:42.44,0:21:45.15,Default,,0,0,0,,Ne diyorsun? Tabii ki!
Dialogue: 0,0:21:45.57,0:21:49.41,Default,,0,0,0,,Harika! Öyleyse yarından itibaren\Nsaat 5'te antrenmana kalk!
Dialogue: 0,0:21:49.83,0:21:53.75,Default,,0,0,0,,Gerçek Brezilya futbolunun\Nnasıl olduğunu sana öğreteceğim.
Dialogue: 0,0:21:54.37,0:21:55.16,Default,,0,0,0,,Tamam!
Dialogue: 0,0:21:57.92,0:21:59.42,Default,,0,0,0,,{\i1}Sevgili Koç João,{\i0}
Dialogue: 0,0:21:59.42,0:22:03.05,Default,,0,0,0,,{\i1}Şu an bir ışık parçası bulmuş durumdayım.{\i0}
Dialogue: 0,0:22:03.92,0:22:05.97,Default,,0,0,0,,{\i1}Adı Ozora Tsubasa.{\i0}
Dialogue: 0,0:22:06.89,0:22:09.01,Default,,0,0,0,,{\i1}Kendimi ona adayacağım.{\i0}
Dialogue: 0,0:22:09.01,0:22:12.89,Default,,0,0,0,,{\i1}Onu dünyaca ünlü bir oyuncu yapacağım.{\i0}
Dialogue: 0,0:22:13.77,0:22:15.23,Default,,0,0,0,,{\i1}Sahayı bıraksam da...{\i0}
Dialogue: 0,0:22:15.23,0:22:18.23,Default,,0,0,0,,{\i1}...futbol yaşadığım sürece\Nhayatımın bir parçası olacak.{\i0}
Dialogue: 0,0:22:39.10,0:22:44.98,Opening Romaji,,0,0,0,,chotto aremi na eesu ga tooru
Dialogue: 0,0:22:39.10,0:22:44.98,Opening Türkçe,,0,0,0,,sert bakışıyla geçiyor bir yıldız
Dialogue: 0,0:22:44.98,0:22:50.99,Opening Romaji,,0,0,0,,suguremono da to machijuu sawagu
Dialogue: 0,0:22:44.98,0:22:50.99,Opening Türkçe,,0,0,0,,tüm şehir söylüyor harika birisi olduğunu
Dialogue: 0,0:22:50.99,0:22:57.00,Opening Romaji,,0,0,0,,chochou sanba, jiguzagu sanba
Dialogue: 0,0:22:50.99,0:22:57.00,Opening Türkçe,,0,0,0,,kelebek sambası, zikzak samba
Dialogue: 0,0:22:57.00,0:23:03.13,Opening Romaji,,0,0,0,,aitsu no uwasa de chanba mo hashiru
Dialogue: 0,0:22:57.00,0:23:03.13,Opening Türkçe,,0,0,0,,onun hakkındaki söylentiler\Nsambayı bile harekete geçiriyor
Dialogue: 0,0:23:03.13,0:23:09.22,Opening Romaji,,0,0,0,,sore ni tsukete mo oretacha nan darou
Dialogue: 0,0:23:03.13,0:23:09.22,Opening Türkçe,,0,0,0,,onun aksine bizim burada olma sebebimiz
Dialogue: 0,0:23:09.22,0:23:15.31,Opening Romaji,,0,0,0,,booru hitotsu ni kirikiri mai sa
Dialogue: 0,0:23:09.22,0:23:15.31,Opening Türkçe,,0,0,0,,top için delirmek
Dialogue: 0,0:23:15.31,0:23:18.46,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:15.31,0:23:18.46,Opening Türkçe,,0,0,0,,koş koş koş
