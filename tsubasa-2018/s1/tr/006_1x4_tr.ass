Dialogue: 0,0:23:18.46,0:23:21.35,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:21.35,0:23:26.36,Opening Romaji,,0,0,0,,itsuka kimeru ze, inazuma shuuto
Dialogue: 0,0:23:21.35,0:23:26.36,Opening Türkçe,,0,0,0,,bir gün şimşek gibi vuruşum hedefine ulaşacak
Dialogue: 0,0:23:27.82,0:23:33.53,Opening Romaji,,0,0,0,,son toki ore ga suupaa hiiroo sa
Dialogue: 0,0:23:27.82,0:23:33.53,Opening Türkçe,,0,0,0,,o an bir süper kahraman olacağım işte ben
Dialogue: 0,0:23:33.53,0:23:36.45,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:33.53,0:23:36.45,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:36.45,0:23:39.41,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:36.45,0:23:39.41,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:39.41,0:23:45.96,Opening Romaji,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:23:39.41,0:23:45.96,Opening Türkçe,,0,0,0,,alevlen ve ez geç delikanlı
Dialogue: 0,0:23:49.74,0:23:58.87,Default,,0,0,0,,Gelecek 5. Bölümde:\NOkullar Arası Turnuva Yolu
