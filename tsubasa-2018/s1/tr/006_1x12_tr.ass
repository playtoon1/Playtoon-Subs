Dialogue: 0,0:11:30.02,0:11:35.05,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:01.93,0:00:04.39,Default,,0,0,0,,{\i1}Shizuoka bölge yarı finalleri.{\i0}
Dialogue: 0,0:00:04.39,0:00:08.51,Default,,0,0,0,,{\i1}Yaralandığı için Wakabayashi\Nolmadan oynayan Nankatsu FC...{\i0}
Dialogue: 0,0:00:08.51,0:00:13.03,Default,,0,0,0,,{\i1}...güçlü defansıyla bilinen\NShimada FC ile karşı karşıya gelmişti.{\i0}
Dialogue: 0,0:00:13.03,0:00:15.90,Default,,0,0,0,,{\i1}Tsubasa'lar oyunu domine etmesine rağmen...{\i0}
Dialogue: 0,0:00:15.90,0:00:19.95,Default,,0,0,0,,{\i1}...bir açıklık yakalamaları sonucu\NShimada gol atmıştı.{\i0}
Dialogue: 0,0:00:23.50,0:00:28.63,Default,,0,0,0,,{\i1}2. golü de kalelerinde bulduktan sonra\NNankatsu kendini umutsuz bir durumda bulmuştu.{\i0}
Dialogue: 0,0:00:29.67,0:00:32.76,Default,,0,0,0,,{\i1}Ne var ki Tsubasa pes etmedi.{\i0}
Dialogue: 0,0:00:32.76,0:00:36.00,Default,,0,0,0,,{\i1}Mükemmel paslarıyla\Nrakibinin üstesinden geldi...{opponents?}{\i0}{yeah, that works betterr}
Dialogue: 0,0:00:36.00,0:00:38.68,Default,,0,0,0,,{\i1}...ve oyun akışını değiştirecek\Ngolü atabildi.{\i0}
Dialogue: 0,0:00:40.81,0:00:42.88,Default,,0,0,0,,{\i1}Ayrıca kaleci Morisaki'nin çabalarıyla...{\i0}
Dialogue: 0,0:00:42.88,0:00:46.88,Default,,0,0,0,,{\i1}...Nankatsu FC finallere uzanabildi.
Dialogue: 0,0:00:48.69,0:00:56.44,Default,,0,0,0,,{\i1}Bu sırada Meiwa FC de Hyuga Kojiro'nun\Ndönmesiyle finallere ilerlemişti.{\i0}
Dialogue: 0,0:02:30.42,0:02:34.42,Default,,0,0,0,,{\fad(00,00)\pos(416,821)}Bölüm 12\NWakabayashi'yi Ezmek
Dialogue: 0,0:02:30.42,0:02:34.42,Default,,0,0,0,,{\pos(1392,1025)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:02:33.04,0:02:36.05,Default,,0,0,0,,Bastır! Bastır! Shimizu!
Dialogue: 0,0:02:36.05,0:02:39.55,Default,,0,0,0,,Hora! Hora! Nankatsu!
Dialogue: 0,0:02:40.17,0:02:42.72,Default,,0,0,0,,{\i1}Şu tezahüratlara bir bakın.{\i0}
Dialogue: 0,0:02:42.72,0:02:44.45,Default,,0,0,0,,{\i1}Sonunda büyük gün geldi.{\i0}
Dialogue: 0,0:02:44.45,0:02:46.43,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvasına katılacak...{\i0}
Dialogue: 0,0:02:46.43,0:02:49.06,Default,,0,0,0,,{\i1}...Shizuoka bölgesi temsilcisine\Nkarar verecek final maçı.{\i0}
Dialogue: 0,0:02:49.06,0:02:53.00,Default,,0,0,0,,{\i1}Ulusal turnuvaya gitmeye hak kazanacak\Ntakım hangisi olacak?{\i0}
Dialogue: 0,0:02:53.00,0:02:56.79,Default,,0,0,0,,{\i1}Geçen senenin temsilcisi Shutetsu\Noyuncularından oluşan Nankatsu FC mi...{\i0}
Dialogue: 0,0:02:56.79,0:03:02.57,Default,,0,0,0,,{\i1}...yoksa şimdiye kadar rakiplerini\Nkolayca ezip geçen ünlü Shimizu FC mi?{\i0}
Dialogue: 0,0:03:02.57,0:03:04.82,Default,,0,0,0,,Tamamdır, hazırım.
Dialogue: 0,0:03:05.29,0:03:07.08,Default,,0,0,0,,Bacağın iyi mi?
Dialogue: 0,0:03:07.08,0:03:08.50,Default,,0,0,0,,Elbette.
Dialogue: 0,0:03:08.50,0:03:11.41,Default,,0,0,0,,Daha ne kadar yedek kulübesinde\Noturmamı bekliyordun?
Dialogue: 0,0:03:11.41,0:03:16.34,Default,,0,0,0,,Morisaki, dün kalemizi çok güzel\Nkorudun. Teşekkürler.{lel waka, we all know you don't think that}
Dialogue: 0,0:03:16.34,0:03:20.84,Default,,0,0,0,,Bugün Nankatsu'nun kalesini bana bırakın.
Dialogue: 0,0:03:22.11,0:03:26.60,Default,,0,0,0,,Anladınız mı? Planımız Ozora Tsubasa'yı\Nher zaman tutuyor olmak.
Dialogue: 0,0:03:26.60,0:03:29.94,Default,,0,0,0,,Sadece kaleye yaklaşınca değil,\Nher zaman tutun ve...
Dialogue: 0,0:03:29.94,0:03:32.88,Default,,0,0,0,,...şut çekmesini, pas vermesini\Nya da top sürmesini kesinlikle engelleyin!{Tsubasa is that dangerous}
Dialogue: 0,0:03:32.88,0:03:33.94,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:33.94,0:03:36.04,Default,,0,0,0,,Size güveniyorum Nakao, Takada.
Dialogue: 0,0:03:36.04,0:03:37.86,Default,,0,0,0,,- Tamam.\N- Bize bırak.
Dialogue: 0,0:03:43.12,0:03:47.53,Default,,0,0,0,,{\i1}Yaz güneşi altında iki takım da\Nsahaya dizilmişti.{\i0}
Dialogue: 0,0:03:47.53,0:03:50.45,Default,,0,0,0,,{\i1}Shizuoka bölge temsilcisine karar\Nverecek final maçı...{\i0}
Dialogue: 0,0:03:50.45,0:03:54.25,Default,,0,0,0,,{\i1}...Nankatsu FC ile Shimizu FC\Narasında başlamak üzereydi.{\i0}
Dialogue: 0,0:03:54.25,0:03:56.63,Default,,0,0,0,,Yine mi yedeğim ya?{again and forever. sorry ryo}
Dialogue: 0,0:03:56.63,0:04:00.14,Default,,0,0,0,,Hey Tsubasa! Elinden geleni yap!
Dialogue: 0,0:04:00.14,0:04:04.56,Default,,0,0,0,,Anego, daha maç başlamadı bile.\NBiraz sakin ol.{or keep it down a little}
Dialogue: 0,0:04:04.56,0:04:06.04,Default,,0,0,0,,Kes be!
Dialogue: 0,0:04:06.04,0:04:08.46,Default,,0,0,0,,Bugün o önemli final maçı var!
Dialogue: 0,0:04:08.46,0:04:09.84,Default,,0,0,0,,Başka ne zaman tezahürat--
Dialogue: 0,0:04:09.84,0:04:11.42,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:04:12.29,0:04:16.68,Default,,0,0,0,,Ne? Az önce başka birisi\NTsubasa-kun'a tezahürat mı yaptı?
Dialogue: 0,0:04:16.68,0:04:18.15,Default,,0,0,0,,Tabii ki başkaları da olacak.
Dialogue: 0,0:04:18.15,0:04:19.98,Default,,0,0,0,,O kadar kişi var sonuçta.
Dialogue: 0,0:04:19.98,0:04:23.99,Default,,0,0,0,,Tsubasa-kun'a tezahürat yapan\Ntek kişi ben olmalıyım!
Dialogue: 0,0:04:24.41,0:04:27.70,Default,,0,0,0,,{\i1}İki takım da yerlerini aldı.{\i0}
Dialogue: 0,0:04:27.70,0:04:30.74,Default,,0,0,0,,{\i1}Nankatsu FC her zamanki gibi\N4-3-3 oynayacak.{\i0}
Dialogue: 0,0:04:30.74,0:04:35.96,Default,,0,0,0,,{\i1}Ellerindeki büyük kozlar bugüne kadarki\Ntüm maçlarda hat trick yapmış Tsubasa-kun ile...{\i0}
Dialogue: 0,0:04:35.96,0:04:38.31,Default,,0,0,0,,{\i1}...kalecileri Wakabayashi-kun.{\i0}
Dialogue: 0,0:04:38.31,0:04:43.21,Default,,0,0,0,,{\i1}Wakabayashi-kun yarı finallerde yer alamamıştı\Nve oyuna girmeyi bekliyordu.{\i0}
Dialogue: 0,0:04:43.21,0:04:49.67,Default,,0,0,0,,{\i1}Rakip takım Shimizu FC'de ise kaleci\NKawakami-kun savunma konusunda çok sağlam...{\i0}
Dialogue: 0,0:04:49.67,0:04:51.90,Default,,0,0,0,,{\i1}...ve 4-4-2 şeklinde oynayacaklar.{\i0}
Dialogue: 0,0:04:51.90,0:04:54.13,Default,,0,0,0,,{\i1}Nankatsu FC ile yarışır oyuncuları var.{\i0}
Dialogue: 0,0:04:54.13,0:04:56.52,Default,,0,0,0,,{\i1}Finallere kadar söke söke geldiler.{\i0}
Dialogue: 0,0:04:56.52,0:05:00.72,Default - Top,,0,0,0,,{\i1}Her iki takım da bölgesel elemelerde\Noyun başına yaklaşık aynı sayıda gol attı.{\i0}
Dialogue: 0,0:05:00.72,0:05:02.31,Default - Top,,0,0,0,,{\i1}Güçleri de benzer.{\i0}
Dialogue: 0,0:05:02.31,0:05:05.90,Default - Top,,0,0,0,,{\i1}Maçın nasıl gideceğini kestirmek\Nimkansız desek yeridir.{\i0}
Dialogue: 0,0:05:06.37,0:05:09.07,Default,,0,0,0,,Bugün kazanırsak ulusallara gideceğiz.
Dialogue: 0,0:05:09.07,0:05:11.24,Default,,0,0,0,,Gidelim Tsubas-kun.
Dialogue: 0,0:05:11.24,0:05:13.04,Default,,0,0,0,,Evet.
Dialogue: 0,0:05:14.51,0:05:17.71,Default,,0,0,0,,{\i1}Nankatsu'nun top vuruşuyla maç başlıyor.{\i0}
Dialogue: 0,0:05:18.27,0:05:20.46,Default,,0,0,0,,{\i1}Misaki-kun topu alıp koşuyor.{\i0}
Dialogue: 0,0:05:21.29,0:05:22.46,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:05:22.46,0:05:23.71,Default,,0,0,0,,Taki-kun!
Dialogue: 0,0:05:23.71,0:05:27.38,Default,,0,0,0,,{\i1}Misaki-kun rakibini yemleyip\Nharika bir pas atıyor.{\i0}
Dialogue: 0,0:05:27.38,0:05:28.22,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:05:28.22,0:05:31.06,Default,,0,0,0,,{\i1}Nankatsu, Tsubasa-kun'a topu ulaştırabilecek mi?{\i0}
Dialogue: 0,0:05:32.50,0:05:36.02,Default,,0,0,0,,{\i1}Ama Shimizu'dan iki kişi\NTsubasa'yı tamamen markaja almış durumda!{\i0}
Dialogue: 0,0:05:37.27,0:05:38.52,Default,,0,0,0,,Dikkat et Taki!
Dialogue: 0,0:05:38.52,0:05:39.69,Default,,0,0,0,,Alıyorum!
Dialogue: 0,0:05:39.69,0:05:40.64,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:05:40.64,0:05:42.23,Default,,0,0,0,,{\i1}Shimizu FC topu alıyor.{\i0}
Dialogue: 0,0:05:42.23,0:05:43.61,Default,,0,0,0,,Koş Kanda!
Dialogue: 0,0:05:43.61,0:05:46.19,Default,,0,0,0,,{\i1}Topu alan Shimizu hızlı bir karşı atağa çıkıyor.{\i0}{kawatte here means, the ball possesion changed to shimizu}
Dialogue: 0,0:05:46.48,0:05:47.91,Default,,0,0,0,,Hey, buraya!
Dialogue: 0,0:05:47.91,0:05:49.78,Default,,0,0,0,,{\i1}Kanda-kun açık alana doğru koşuyor.{\i0}
Dialogue: 0,0:05:49.78,0:05:50.95,Default,,0,0,0,,Geri dönün!
Dialogue: 0,0:05:51.47,0:05:52.32,Default,,0,0,0,,Kanda!
Dialogue: 0,0:05:52.32,0:05:54.16,Default,,0,0,0,,{\i1}Yanlamasına uzun bir pas!{is this how you say it? should I trust google?} {\i0}{it's good, you did well}
Dialogue: 0,0:05:56.54,0:05:58.16,Default,,0,0,0,,Hayatta izin vermem!{you shall not pass!, pass could be misleading, as if he was trying to pass the ball lelnaruhodo...}
Dialogue: 0,0:05:58.79,0:06:00.96,Default,,0,0,0,,{\i1}Kanda-kun sıyrılıyor.{\i0}
Dialogue: 0,0:06:00.96,0:06:02.48,Default,,0,0,0,,{\i1}Ünlü Shimizu'dan da bu beklenirdi.{\i0}
Dialogue: 0,0:06:02.48,0:06:04.08,Default,,0,0,0,,{\i1}Her oyuncu konumunda harika!{\i0}
Dialogue: 0,0:06:04.08,0:06:06.72,Default,,0,0,0,,{\i1}Peki Kanda-kun, Takasugi-kun'u\Ngeçmeye mi çalışacak?{\i0}
Dialogue: 0,0:06:06.72,0:06:07.51,Default,,0,0,0,,Seni...
Dialogue: 0,0:06:07.51,0:06:11.30,Default,,0,0,0,,{\i1}Kale önünde doğru koşan\NObayashi-kun ve Murakami-kun var!{\i0}
Dialogue: 0,0:06:11.30,0:06:12.32,Default,,0,0,0,,Tutun şunları!
Dialogue: 0,0:06:12.32,0:06:13.32,Default,,0,0,0,,Hayatta izin vermem!
Dialogue: 0,0:06:14.39,0:06:16.89,Default,,0,0,0,,{\i1}Kanda-kun pas veriyor. Obayashi-kun'da.{\i0}
Dialogue: 0,0:06:18.59,0:06:19.69,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:06:19.69,0:06:21.77,Default,,0,0,0,,{\i1}İlk şut Shimizu'dan geliyor.{\i0}
Dialogue: 0,0:06:22.79,0:06:23.77,Default,,0,0,0,,Wakabayashi!
Dialogue: 0,0:06:25.77,0:06:27.74,Default,,0,0,0,,{\i1}Wakabayashi-kun hızla atılıyor!{\i0}
Dialogue: 0,0:06:28.66,0:06:30.86,Default,,0,0,0,,{\i1}Harika kurtardı!{\i0}
Dialogue: 0,0:06:31.72,0:06:33.12,Default,,0,0,0,,Güzel kurtardın.
Dialogue: 0,0:06:34.95,0:06:37.87,Default,,0,0,0,,İşte bu, bacağım iyileşmiş. Tsubasa!
Dialogue: 0,0:06:38.25,0:06:40.12,Default,,0,0,0,,{\i1}Topu uzağa yolluyor.{\i0}
Dialogue: 0,0:06:40.12,0:06:43.04,Default,,0,0,0,,{\i1}Nankatsu'nun baş forveti Tsubasa-kun'a bir pas.{\i0}
Dialogue: 0,0:06:43.76,0:06:46.13,Default,,0,0,0,,{\i1}Ne var ki Tsubasa-kun'u tutan iki kişi var.{\i0}
Dialogue: 0,0:06:47.12,0:06:48.67,Default,,0,0,0,,{\i1}Üçü de aynı anda zıplıyor.{\i0}
Dialogue: 0,0:06:48.67,0:06:54.30,Default,,0,0,0,,{\i1}En yükseğe zıplayan ve topu alan beklenildiği gibi\NNankatsu'dan 10 numara Ozora Tsubasa-kun oluyor!
Dialogue: 0,0:06:56.04,0:06:58.64,Default,,0,0,0,,{\i1}Misaki-kun kısa bir dokunuşla\Ntopu Tsubasa-kun'a iade ediyor.{\i0}
Dialogue: 0,0:06:58.64,0:07:00.66,Default,,0,0,0,,{\i1}Topu alan Tsubasa-kun koşuyor.{\i0}
Dialogue: 0,0:07:02.81,0:07:04.77,Default,,0,0,0,,Hadi Tsubasa-kun!
Dialogue: 0,0:07:06.14,0:07:06.90,Default,,0,0,0,,Hadi!
Dialogue: 0,0:07:06.90,0:07:10.44,Default,,0,0,0,,{\i1}Tsubasa-kun markaja alınmasına\Nrağmen uzun bir şut çekiyor!{\i0}
Dialogue: 0,0:07:12.32,0:07:14.78,Default,,0,0,0,,{\i1}Yine direkten sekiyor.{\i0}{crossbar smh}
Dialogue: 0,0:07:14.78,0:07:16.24,Default,,0,0,0,,Çok yakındı...
Dialogue: 0,0:07:16.24,0:07:17.78,Default,,0,0,0,,B-Bu çocuk...
Dialogue: 0,0:07:17.78,0:07:18.79,Default,,0,0,0,,Harika.
Dialogue: 0,0:07:22.57,0:07:23.67,Default,,0,0,0,,İki kişi yeterli değil.
Dialogue: 0,0:07:23.67,0:07:25.58,Default,,0,0,0,,3 kişi tutun.
Dialogue: 0,0:07:25.58,0:07:28.81,Default,,0,0,0,,Neden orada direk var ki?
Dialogue: 0,0:07:28.81,0:07:30.30,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:07:30.30,0:07:33.63,Default,,0,0,0,,Ne oldu? Az önce onu gol atardın sen!{this kills the anego kyatto faito, hajime!tsubasa won't be interested if there are no balls involved. such a shame.}
Dialogue: 0,0:07:33.63,0:07:35.79,Default,,0,0,0,,O-O kız da kim?
Dialogue: 0,0:07:35.79,0:07:38.89,Default,,0,0,0,,- A-Anego!\N- Bekle lütfen!
Dialogue: 0,0:07:38.89,0:07:43.98,Default,,0,0,0,,Tsubasa-kun! Unuttun mu beni?\NBenim! Yayoi!{it's me, Dio! lol'd more than I should}
Dialogue: 0,0:07:44.34,0:07:46.56,Default,,0,0,0,,Sana tezahürat yapmaya geldim!{tsubasa was drunk on footballs that night, hun, he doesn't remember you}
Dialogue: 0,0:07:50.08,0:07:52.36,Default,,0,0,0,,Baksana sen bir bana!
Dialogue: 0,0:07:52.93,0:07:55.61,Default,,0,0,0,,Senin Tsubasa-kun'la ne tür\Nbir alakan var bakayım?{How do you know Tsubasa?}
Dialogue: 0,0:07:56.49,0:07:58.12,Default,,0,0,0,,Ya senin?{#rekt, she should have said, no u}
Dialogue: 0,0:07:58.12,0:08:03.61,Default,,0,0,0,,Ben Nankatsu Amigo...\NHayır, Tsubasa Amigo Takımı'nın kaptanıyım.{lol wut?thats what we call the worst stalker}{french subs say "fan-club", so i think that'd work better here. shinei is literally "personal guard", but there was no need to be so literal here}
Dialogue: 0,0:08:03.61,0:08:07.52,Default,,0,0,0,,Öyle mi? Ben Tsubasa-kun'un önceki\Nokulundan arkadaşıyım.
Dialogue: 0,0:08:07.52,0:08:09.92,Default,,0,0,0,,Adım Aoba Yayoi. Memnun oldum.
Dialogue: 0,0:08:09.92,0:08:13.07,Default,,0,0,0,,B-Ben de amigo takımındanım. Memnun ol--
Dialogue: 0,0:08:13.07,0:08:14.93,Default,,0,0,0,,Sen karışma bir!
Dialogue: 0,0:08:15.71,0:08:18.68,Default,,0,0,0,,Tsubasa-kun hep harika oynuyor.
Dialogue: 0,0:08:18.68,0:08:20.37,Default,,0,0,0,,Çok hareketli.
Dialogue: 0,0:08:23.55,0:08:28.47,Default,,0,0,0,,Okulda hep tek başına topla oynardı.
Dialogue: 0,0:08:28.47,0:08:32.28,Default,,0,0,0,,Okula gelip her gün futbol topuyla oynardı.
Dialogue: 0,0:08:32.68,0:08:36.28,Default,,0,0,0,,Ama sahadaki en iyi kişi\NTsubasa-kun gerçekten.
Dialogue: 0,0:08:37.23,0:08:41.79,Default,,0,0,0,,Herkes futboldan başka bir şey\Noynamayan Tsubasa-kun'a çok tuhaf bakardı.
Dialogue: 0,0:08:41.79,0:08:44.04,Default,,0,0,0,,{\i1}Aptal mı bu çocuk ya?{\i0}{no u bitch}
Dialogue: 0,0:08:44.04,0:08:49.24,Default,,0,0,0,,Ben Tsubasa-kun'un bu futbol\Narzusuna hayranlık beslerdim.{not sure of this one, being dedicated tp football only}
Dialogue: 0,0:08:49.24,0:08:51.50,Default,,0,0,0,,{\i1}Yayoi, biz gidiyoruz.{\i0}
Dialogue: 0,0:08:53.60,0:09:00.01,Default,,0,0,0,,Yine de ona duygularımı açamadan\NTsubasa-kun transfer oldu.
Dialogue: 0,0:09:01.07,0:09:02.53,Default,,0,0,0,,Tezahürat yapmayacak mısın?
Dialogue: 0,0:09:02.53,0:09:04.70,Default,,0,0,0,,Tsubasa-kun topu aldı.
Dialogue: 0,0:09:04.70,0:09:05.35,Default,,0,0,0,,Ne?
Dialogue: 0,0:09:06.32,0:09:08.35,Default,,0,0,0,,{\i1}Tsubasa-kun pası aldı.{\i0}
Dialogue: 0,0:09:10.57,0:09:13.28,Default,,0,0,0,,{\i1}Bu sefer 3 kişi onu tutuyor.{\i0}
Dialogue: 0,0:09:13.28,0:09:14.53,Default,,0,0,0,,{\i1}Üç mü?{\i0}
Dialogue: 0,0:09:15.52,0:09:17.03,Default,,0,0,0,,{\i1}Üç kişi mi tutacağız?{\i0}
Dialogue: 0,0:09:17.48,0:09:18.47,Default,,0,0,0,,{\i1}Aynen öyle.{\i0}
Dialogue: 0,0:09:18.47,0:09:22.54,Default,,0,0,0,,{\i1}Ama o zaman defans zayıflamaz mı?{\i0}
Dialogue: 0,0:09:22.54,0:09:23.95,Default,,0,0,0,,{\i1}Sorun değil.{\i0}
Dialogue: 0,0:09:23.95,0:09:29.75,Default,,0,0,0,,{\i1}Defansta açık olunca başkaları şut\Nçekse bile ben tutarım.{\i0}
Dialogue: 0,0:09:29.75,0:09:33.14,Default,,0,0,0,,{\i1}Nankatsu'nun elinde sadece o var.{\i0}
Dialogue: 0,0:09:33.14,0:09:38.68,Default,,0,0,0,,{\i1}Yani Tsubasa'yı tutarsak kaybetmeyiz.{\i0}
Dialogue: 0,0:09:39.63,0:09:43.26,Default,,0,0,0,,{\i1}Tusbasa-kun ilk kez 3 kişi tarafından\Nmarkaja alınıyor.{\i0}
Dialogue: 0,0:09:43.26,0:09:45.85,Default,,0,0,0,,{\i1}Ünlü Shimizu'dan üç kişinin tutunca...{\i0}
Dialogue: 0,0:09:45.85,0:09:47.88,Default,,0,0,0,,{\i1}...Tsubasa-kun hareket bile edemiyor.{\i0}
Dialogue: 0,0:09:47.88,0:09:49.56,Default,,0,0,0,,{\i1}Senin için zor olmalı Tsubasa.{\i0}
Dialogue: 0,0:09:49.56,0:09:53.10,Default,,0,0,0,,{\i1}Yeteneklerin fark edildikçe\Nrakiplerin de artıyor.{\i0}
Dialogue: 0,0:09:53.10,0:09:54.86,Default,,0,0,0,,Buraya Tsubasa!
Dialogue: 0,0:09:55.81,0:09:56.32,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:57.36,0:10:00.85,Default,,0,0,0,,Hepiniz Tsubasa'yı tutunca\Nbiz boşta kaldık.
Dialogue: 0,0:10:00.94,0:10:01.78,Default,,0,0,0,,Kisugi!
Dialogue: 0,0:10:02.00,0:10:02.97,Default,,0,0,0,,Aldım.
Dialogue: 0,0:10:02.97,0:10:05.12,Default,,0,0,0,,{\i1}Nankatsu hızlıca paslaşıyor.{\i0}
Dialogue: 0,0:10:05.12,0:10:09.58,Default,,0,0,0,,{\i1}Tsubasa-kun'un oluşturduğu açık sayesinde\Ntop hızlıca kale önündeki Kisugi-kun'a geldi.{\i0}
Dialogue: 0,0:10:09.58,0:10:11.79,Default,,0,0,0,,{\i1}Kimse yokken vuruyor!{\i0}
Dialogue: 0,0:10:12.40,0:10:14.75,Default,,0,0,0,,{\i1}Tuttu!{\i0}
Dialogue: 0,0:10:15.80,0:10:17.51,Default,,0,0,0,,Güzel yakaladın Kaptan!
Dialogue: 0,0:10:18.25,0:10:23.24,Default,,0,0,0,,{\i1}Shimizu'nun kalecisi ve kaptanları\NKawakami-kun zıplayarak harika bir şekilde yakalıyor.{\i0}
Dialogue: 0,0:10:23.24,0:10:28.27,Default,,0,0,0,,Nankatsu'da Wakabayashi varsa\NShimizu'da da Kawakami var.{gosh this guy overestimating himself}{seeing his self-esteem trampled upon by Tsubasa&co will feel even more satisfying}
Dialogue: 0,0:10:30.52,0:10:34.02,Default,,0,0,0,,{\i1}O kaleci hiç fena değil.{\i0}
Dialogue: 0,0:10:34.02,0:10:36.02,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:10:36.02,0:10:40.03,Default,,0,0,0,,Neyse artık. Maç bittikten\Nsonra konuşmamızı tamamlarız.{you have lost, sis}
Dialogue: 0,0:10:40.03,0:10:41.95,Default,,0,0,0,,İleri!
Dialogue: 0,0:10:44.79,0:10:47.37,Default,,0,0,0,,{\i1}Maç büyük bir çekişmeye döndü.{\i0}
Dialogue: 0,0:10:47.37,0:10:48.91,Default,,0,0,0,,{\i1}Güçleri eşit.{\i0}
Dialogue: 0,0:10:48.91,0:10:53.46,Default,,0,0,0,,{\i1}Hiç pes etmiyorlar.\NŞampiyonlar arasında bir gösteri gibi.
Dialogue: 0,0:10:54.20,0:10:55.17,Default,,0,0,0,,Aldım.
Dialogue: 0,0:10:55.17,0:10:58.13,Default,,0,0,0,,{\i1}Shimizu orta mesafeden\Nhızlı bir şut çekiyor.{\i0}
Dialogue: 0,0:10:59.34,0:11:02.18,Default,,0,0,0,,{\i1}Ama Nankatsu'nun gol yemeye niyeti yok.{\i0}
Dialogue: 0,0:11:03.85,0:11:08.31,Default,,0,0,0,,{\i1}Bu maç için hazırlandığı belli olan\NWakabayashi bugün çok formunda.{\i0}
Dialogue: 0,0:11:09.30,0:11:12.02,Default,,0,0,0,,{\i1}Düdük de hemen çaldı sanki.{\i0}
Dialogue: 0,0:11:12.02,0:11:15.02,Default,,0,0,0,,{\i1}20 dakikalık ilk yarı bitti.\NSkor hala 0-0.{\i0}
Dialogue: 0,0:11:17.28,0:11:21.28,Default,,0,0,0,,{\i1}Ben olduğum sürece Nankatsu\Nkalesine top girmez.{\i0}
Dialogue: 0,0:11:21.28,0:11:23.78,Default,,0,0,0,,{\i1}Neden bu kadar abartıyorsun ki?{\i0}
Dialogue: 0,0:11:23.78,0:11:26.32,Default,,0,0,0,,{\i1}Başka seçeneğimiz kalmadı o zaman.{\i0}{is he talking about the famous THAT technique?}
Dialogue: 0,0:11:41.84,0:11:43.72,Default,,0,0,0,,Shimizu'dan da bu beklenirdi.
Dialogue: 0,0:11:43.72,0:11:44.57,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:44.57,0:11:46.18,Default,,0,0,0,,Çok çetin cevizler.
Dialogue: 0,0:11:46.18,0:11:48.48,Default,,0,0,0,,Final maçına yarışır oyuncular değil mi?
Dialogue: 0,0:11:48.48,0:11:49.43,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:49.43,0:11:52.68,Default,,0,0,0,,Size güveniyorum millet. Bir gol.
Dialogue: 0,0:11:52.68,0:11:55.60,Default,,0,0,0,,Bir gol atmamız kazanmamız için yeterli.
Dialogue: 0,0:11:55.60,0:11:56.88,Default,,0,0,0,,Öyle olabilir ama...
Dialogue: 0,0:11:56.88,0:11:59.61,Default,,0,0,0,,...ikinci yarıda da Tsubasa\Nmarkaja alınacaktır muhtemelen.
Dialogue: 0,0:11:59.61,0:12:02.69,Default,,0,0,0,,Yine de kendi gücünüzle golü atın.
Dialogue: 0,0:12:02.69,0:12:03.61,Default,,0,0,0,,Tamam!
Dialogue: 0,0:12:03.61,0:12:06.32,Default,,0,0,0,,Buraya kadar geldik.\NKaybetmemize olanak yok!
Dialogue: 0,0:12:06.32,0:12:07.12,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:07.12,0:12:09.27,Default,,0,0,0,,Ulusallara gidenler biz olacağız.
Dialogue: 0,0:12:09.27,0:12:10.12,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:10.12,0:12:11.76,Default,,0,0,0,,Tamamdır. Kazanalım şunu.
Dialogue: 0,0:12:11.76,0:12:14.10,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:14.10,0:12:17.13,Default,,0,0,0,,İkinci yarıda kesinlikle gol atacağım.
Dialogue: 0,0:12:17.80,0:12:19.05,Default,,0,0,0,,Tsubasa...{thats how wakabayashi met the mother of their kids, now i get it}
Dialogue: 0,0:12:19.63,0:12:21.96,Default,,0,0,0,,Evet, sana güveniyorum Tsubasa.
Dialogue: 0,0:12:21.96,0:12:23.17,Default,,0,0,0,,Tamam.
Dialogue: 0,0:12:25.34,0:12:27.93,Default,,0,0,0,,İkinci yarıda da Tsubasa'yı tutacağız.
Dialogue: 0,0:12:27.93,0:12:31.80,Default,,0,0,0,,Ama gol atamazsak ulusallara gidemeyiz.
Dialogue: 0,0:12:31.80,0:12:35.44,Default,,0,0,0,,Bunun için planımızı yürürlüğe sokacağız.
Dialogue: 0,0:12:36.54,0:12:38.61,Default,,0,0,0,,Wakabayashi'yi ezeceğiz!
Dialogue: 0,0:12:39.34,0:12:42.19,Default,,0,0,0,,Ataklarının odak noktası\NTsubasa'yı tutarsak...
Dialogue: 0,0:12:42.19,0:12:47.36,Default,,0,0,0,,...ve defanslarının ana direği Wakabayashi'yi\Nezersek zafer bizim olur.
Dialogue: 0,0:12:47.36,0:12:51.62,Default,,0,0,0,,Şanslıyız ki Wakabayashi'nin yaralanmasının\Ntamamen iyileşmesine olanak yok.
Dialogue: 0,0:12:51.62,0:12:55.78,Default,,0,0,0,,Tamamdır, gidelim!\NUlusallara gidenler biz olacağız!
Dialogue: 0,0:12:55.78,0:12:56.87,Default,,0,0,0,,Evet!
Dialogue: 0,0:13:00.49,0:13:04.38,Default,,0,0,0,,Doğru ya. Yarı bitince gidip\No kızla konuşacaktım.
Dialogue: 0,0:13:05.10,0:13:07.44,Default,,0,0,0,,O kız çok tatlıydı!
Dialogue: 0,0:13:07.44,0:13:10.48,Default,,0,0,0,,Anego'ya havada karada--{prototype-aibou, version 1.0 - not bad at all}
Dialogue: 0,0:13:10.48,0:13:12.32,Default,,0,0,0,,Duyuyorum.
Dialogue: 0,0:13:12.32,0:13:13.70,Default,,0,0,0,,Onu boş ver de...
Dialogue: 0,0:13:15.08,0:13:16.56,Default,,0,0,0,,Yok.
Dialogue: 0,0:13:16.56,0:13:18.59,Default,,0,0,0,,Nereye gitti ki bu kız?
Dialogue: 0,0:13:18.59,0:13:20.86,Default,,0,0,0,,Nereye gitmiş olabilir ki?
Dialogue: 0,0:13:24.00,0:13:26.47,Default,,0,0,0,,{\i1}İkinci yarı başladı.{\i0}
Dialogue: 0,0:13:29.74,0:13:31.99,Default,,0,0,0,,{\i1}İlk yarı 0-0 bitti.{\i0}
Dialogue: 0,0:13:31.99,0:13:35.12,Default,,0,0,0,,{\i1}İlk golü atan Shimizu mu olacak Nankatsu mu?{\i0}{i notice y'all add a lot of words; we know they'll be the "first ones" so there's no need to add the "ones" lol. just a note -nothingxs}
Dialogue: 0,0:13:35.12,0:13:38.12,Default,,0,0,0,,Bastır! bastır! Shimizu!{Tsubasa gets all the girls, so they have none to cheer them on}
Dialogue: 0,0:13:38.12,0:13:41.63,Default,,0,0,0,,Hora! Hora! Nankatsu!
Dialogue: 0,0:13:42.31,0:13:45.64,Default,,0,0,0,,{\i1}İlk yarının aksine Shimizu\Ndikkatli bir şekilde paslaşıyor.{\i0}
Dialogue: 0,0:13:45.64,0:13:49.14,Default,,0,0,0,,{\i1}Nankatsu'nun defansını aşmaya mı çalışıyorlar?{\i0}
Dialogue: 0,0:13:49.53,0:13:53.91,Default,,0,0,0,,{\i1}Öte yandan ilk yarıdaki gibi\NTsubasa-kun'u tutan üç kişi var.{\i0}
Dialogue: 0,0:13:53.91,0:13:56.02,Default,,0,0,0,,Ne inatçı çıktılar be!
Dialogue: 0,0:13:57.52,0:13:59.94,Default,,0,0,0,,Kishida, biraz sola git.
Dialogue: 0,0:14:00.77,0:14:02.66,Default,,0,0,0,,Tamamdır, yeterli.
Dialogue: 0,0:14:02.66,0:14:05.86,Default,,0,0,0,,{\i1}Nankatsu kalecisi Wakabayashi-kun\Nher zamanki gibi defansa direktif veriyor.{\i0}
Dialogue: 0,0:14:07.96,0:14:09.73,Default,,0,0,0,,Başlayalım mı artık?
Dialogue: 0,0:14:11.58,0:14:15.37,Default,,0,0,0,,{\i1}Birden Shimizu kaleye doğru\Nuzun bir top yolladı.{\i0}
Dialogue: 0,0:14:16.91,0:14:19.83,Default,,0,0,0,,{\i1}Tüm takım da peşinden gidiyor.{\i0}
Dialogue: 0,0:14:19.83,0:14:22.46,Default,,0,0,0,,{\i1}Yüksek top kaleye doğru alçalmaya başladı.{\i0}
Dialogue: 0,0:14:22.46,0:14:23.75,Default,,0,0,0,,Bana bırak!
Dialogue: 0,0:14:23.75,0:14:25.55,Default,,0,0,0,,{\i1}Wakabayashi-kun çıkıyor.{\i0}
Dialogue: 0,0:14:28.13,0:14:30.18,Default,,0,0,0,,{\i1}Tüm Shimizu topa doğru geliyor.{\i0}
Dialogue: 0,0:14:30.43,0:14:34.68,Default,,0,0,0,,{\i1}Wakabayashi-kun zıplıyor!\NNe inanılmaz bir fiziksel yetenek!{\i0}
Dialogue: 0,0:14:34.68,0:14:38.27,Default,,0,0,0,,{\i1}Ama Shimizu hala kaleye koşuyor! Bu...{\i0}
Dialogue: 0,0:14:39.21,0:14:40.52,Default,,0,0,0,,{\i1}Çarptılar!{\i0}
Dialogue: 0,0:14:41.53,0:14:42.02,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:45.48,0:14:47.07,Default,,0,0,0,,{\i1}Faul!{\i0}
Dialogue: 0,0:14:47.07,0:14:48.84,Default,,0,0,0,,Ne oyun ama.
Dialogue: 0,0:14:48.84,0:14:51.07,Default,,0,0,0,,Top yerine kaleciyi hedef aldılar sanki.
Dialogue: 0,0:14:51.07,0:14:55.08,Default,,0,0,0,,Lanet olsun! Bilerek yaptınız değil mi?
Dialogue: 0,0:14:55.08,0:14:56.97,Default,,0,0,0,,Kusura bakma tamam mı?
Dialogue: 0,0:14:56.97,0:15:00.16,Default,,0,0,0,,Ulusallara gitme konusunda çok kararlıyız.{just saying that they are assholes let's let the viewers decide that}
Dialogue: 0,0:15:00.16,0:15:01.92,Default,,0,0,0,,İyi misin?! Wakabayashi!
Dialogue: 0,0:15:01.92,0:15:06.17,Default,,0,0,0,,Elbette. Böyle bir atağa\Nkarşı yıkılmam ben!
Dialogue: 0,0:15:06.17,0:15:07.63,Default,,0,0,0,,Wakabayashi-kun.{that's when he showed him the mother of their kids}
Dialogue: 0,0:15:07.63,0:15:10.00,Default,,0,0,0,,Millet, ilk gol için size güveniyorum!
Dialogue: 0,0:15:10.00,0:15:11.13,Default,,0,0,0,,Tamam!{chorus two?}
Dialogue: 0,0:15:12.19,0:15:15.05,Default,,0,0,0,,Wakabayashi'nin bacağı iyileşmiş sanırım.
Dialogue: 0,0:15:15.05,0:15:18.14,Default,,0,0,0,,{\i1}Nankatsu'nun vuruşuyla oyun tekrar başlayacak.{\i0}
Dialogue: 0,0:15:18.14,0:15:19.24,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:15:23.77,0:15:25.29,Default,,0,0,0,,{\i1}Kötü bir vuruştu.{\i0}
Dialogue: 0,0:15:25.29,0:15:26.79,Default,,0,0,0,,{\i1}Ne oldu Wakabayashi-kun?!{\i0}
Dialogue: 0,0:15:26.79,0:15:28.87,Default,,0,0,0,,{\i1}Ayağa kalkamıyor!{\i0}
Dialogue: 0,0:15:28.87,0:15:31.07,Default,,0,0,0,,Wakabayashi-kun, bacağın yine--
Dialogue: 0,0:15:31.07,0:15:32.59,Default,,0,0,0,,İşte fırsat! Saldırın!{making too much fcuk like typos}
Dialogue: 0,0:15:32.59,0:15:34.91,Default,,0,0,0,,Planın ikinci kısmı başarılı!
Dialogue: 0,0:15:34.91,0:15:37.88,Default,,0,0,0,,Topu alın! Onlar alırsa biteriz!
Dialogue: 0,0:15:38.64,0:15:39.66,Default,,0,0,0,,Lanet olsun!{you just got neutered, Waka! Haha. too much cruelty?}
Dialogue: 0,0:15:41.91,0:15:42.63,Default,,0,0,0,,Kanda!
Dialogue: 0,0:15:42.63,0:15:44.42,Default,,0,0,0,,{\i1}Shimizu topu alıyor!{\i0}
Dialogue: 0,0:15:44.42,0:15:45.29,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:15:45.29,0:15:47.00,Default,,0,0,0,,İlk gol bizimdir!
Dialogue: 0,0:15:47.00,0:15:48.84,Default,,0,0,0,,{\i1}Orta geliyor.{\i0}
Dialogue: 0,0:15:48.84,0:15:49.84,Default,,0,0,0,,Bende!
Dialogue: 0,0:15:50.62,0:15:52.09,Default,,0,0,0,,Böyle bir yaralanma...
Dialogue: 0,0:15:52.54,0:15:55.34,Default,,0,0,0,,{\i1}Wakabayashi-kun yaralı olmasına rağmen zıplıyor!{\i0}
Dialogue: 0,0:15:56.16,0:15:58.18,Default,,0,0,0,,{\i1}Dengesini kaybetti!{\i0}
Dialogue: 0,0:15:58.18,0:16:00.64,Default,,0,0,0,,{\i1}İlk gol Shimizu'nun mu olacak?!{\i0}
Dialogue: 0,0:16:01.44,0:16:04.10,Default,,0,0,0,,{\i1}Hayır, girmiyor!\NMisaki-kun durduruyor!{\i0}
Dialogue: 0,0:16:04.10,0:16:05.61,Default,,0,0,0,,Adamsın Misaki!
Dialogue: 0,0:16:05.61,0:16:08.86,Default,,0,0,0,,{\i1}Ama tehlike geçmedi!\NTop Kato-kun'a gidiyor!{\i0}
Dialogue: 0,0:16:08.86,0:16:11.90,Default,,0,0,0,,Tamamdır, şimdi al bakalım!
Dialogue: 0,0:16:12.38,0:16:14.91,Default,,0,0,0,,{\i1}Wakabayashi-kun hareket edemiyorken\Nşutu çekti!{\i0}
Dialogue: 0,0:16:14.91,0:16:16.16,Default,,0,0,0,,Tutamayacak mı?!
Dialogue: 0,0:16:16.16,0:16:17.28,Default,,0,0,0,,Girdi!
Dialogue: 0,0:16:17.28,0:16:20.37,Default,,0,0,0,,{\i1}Shimizu FC ilk golü atacak mı?!{\i0}
Dialogue: 0,0:16:20.37,0:16:24.21,Default,,0,0,0,,Lanet olsun! Wakabayashi Genzo'yu\Nhafife almayın!{oh, yeah. forgot we're not japanese, lel my job to fix}
Dialogue: 0,0:16:24.75,0:16:29.71,Default,,0,0,0,,{\i1}Yakaladı! Wakabayashi-kun son bir\Nçabayla zıplayıp yakalıyor!{\i0}
