Dialogue: 0,0:13:39.04,0:13:44.05,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:02.02,0:00:05.22,Default,,0,0,0,,Ulusal Genç Futbol Turnuvası finali.
Dialogue: 0,0:00:05.22,0:00:08.85,Default,,0,0,0,,{\i1}Tesadüf eseri final maçı,\Nilk maçı yapanlar arasında oynanacak.{\i0}
Dialogue: 0,0:00:09.58,0:00:11.65,Default,,0,0,0,,Final maçı şimdi başlıyor.
Dialogue: 0,0:00:17.07,0:00:19.65,Default,,0,0,0,,Hyuga-kun Nankatsu sahasında koşuyor.
Dialogue: 0,0:00:19.65,0:00:22.58,Default,,0,0,0,,Tsubasa! Bugün hesabımızı kapatacağım!
Dialogue: 0,0:00:23.07,0:00:25.23,Default,,0,0,0,,Mücadele vakti Hyuga Kojiro!
Dialogue: 0,0:00:25.23,0:00:28.04,Default,,0,0,0,,Onu tutmaya giden kişi\NKaptan Ozora Tsubasa-kun!
Dialogue: 0,0:00:28.04,0:00:29.50,Default,,0,0,0,,Erken bir karşılaşma mı olacak?!
Dialogue: 0,0:00:29.50,0:00:33.05,Default,,0,0,0,,Bunu aldıktan sonra bile mi?!
Dialogue: 0,0:00:33.05,0:00:34.98,Default,,0,0,0,,Hyuga-kun güçlü bir şut çekiyor!
Dialogue: 0,0:00:34.98,0:00:36.97,Default,,0,0,0,,Karnına çarptı!
Dialogue: 0,0:02:09.27,0:02:13.31,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}Bölüm 23:\NDahi Kaleci Geri Döner!
Dialogue: 0,0:02:09.27,0:02:13.31,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs60\pos(1480,1026.333)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:02:11.65,0:02:12.52,Default - Top,,0,0,0,,Tsubasa!
Dialogue: 0,0:02:12.52,0:02:13.52,Default - Top,,0,0,0,,Adi!
Dialogue: 0,0:02:13.52,0:02:15.02,Default,,0,0,0,,Bilerek vurdu!
Dialogue: 0,0:02:19.40,0:02:20.11,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:20.61,0:02:22.74,Default,,0,0,0,,Top, Misaki-kun'a gitti.
Dialogue: 0,0:02:22.74,0:02:25.81,Default,,0,0,0,,Hyuga, kazanan siz olmayacaksınız.
Dialogue: 0,0:02:25.81,0:02:26.99,Default,,0,0,0,,Ben olacağım!
Dialogue: 0,0:02:27.82,0:02:28.99,Default,,0,0,0,,Bu...
Dialogue: 0,0:02:28.99,0:02:30.83,Default,,0,0,0,,Aynen öyle Kojiro.
Dialogue: 0,0:02:30.83,0:02:32.17,Default,,0,0,0,,Misaki...
Dialogue: 0,0:02:32.17,0:02:35.70,Default,,0,0,0,,Meiwa İlkokulu'nda seninle\Nbirlikte çok maç yaptım.
Dialogue: 0,0:02:35.70,0:02:39.44,Default,,0,0,0,,Ama şu an Nankatsu SC'de\Noynuyorum ve rakibinim.
Dialogue: 0,0:02:39.44,0:02:44.85,Default,,0,0,0,,Kesinlikle Tsubasa-kun'la birlikte\Nşampiyonluk flamasını dalgalandıracağız!
Dialogue: 0,0:02:44.85,0:02:45.47,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:45.47,0:02:48.22,Default,,0,0,0,,Tsubasa-kun'a giden uzun bir pas.
Dialogue: 0,0:02:49.07,0:02:50.56,Default,,0,0,0,,Güzeldi Misaki-kun.
Dialogue: 0,0:02:50.56,0:02:53.10,Default,,0,0,0,,Nankatsu'nun altın ikilisinden de\Nbu beklenirdi.
Dialogue: 0,0:02:53.10,0:02:55.78,Default,,0,0,0,,Tsubasa-kun direkt kaleyi hedef alıyor.
Dialogue: 0,0:02:55.78,0:02:58.11,Default,,0,0,0,,Top direkt doksana gidiyor.
Dialogue: 0,0:02:58.68,0:03:00.59,Default,,0,0,0,,Y-Yakaladı!
Dialogue: 0,0:03:00.59,0:03:01.36,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:02.53,0:03:05.58,Default,,0,0,0,,Ve bununla birlikte\Nbir takla atıyor!
Dialogue: 0,0:03:05.58,0:03:06.96,Default,,0,0,0,,Harika bir tutuş!
Dialogue: 0,0:03:06.96,0:03:09.43,Default,,0,0,0,,Kaleci Wakashimazu-kun harika oynadı!
Dialogue: 0,0:03:09.43,0:03:10.87,Default,,0,0,0,,Güzeldi Wakashimazu!
Dialogue: 0,0:03:10.87,0:03:13.04,Default,,0,0,0,,Adamsın Wakashimazu!
Dialogue: 0,0:03:13.04,0:03:15.78,Default,,0,0,0,,Furano'ya karşı olan performansı\Nşans eseri değildi.
Dialogue: 0,0:03:15.78,0:03:19.80,Default,,0,0,0,,Wakashimazu-kun da oldukça\Nyetenekli bir kaleci.
Dialogue: 0,0:03:19.80,0:03:22.33,Default,,0,0,0,,Özür dilerim ama burada olduğum sürece...
Dialogue: 0,0:03:22.33,0:03:26.14,Default,,0,0,0,,...bu maçta bir gol bile\Natmanıza izin veremem.
Dialogue: 0,0:03:26.14,0:03:26.97,Default,,0,0,0,,Ne?
Dialogue: 0,0:03:26.97,0:03:29.56,Default,,0,0,0,,Zafer Meiwa'nındır!
Dialogue: 0,0:03:30.14,0:03:32.69,Default,,0,0,0,,Bu kez Meiwa mı atak yapacak?
Dialogue: 0,0:03:32.69,0:03:34.35,Default,,0,0,0,,Hemen bir tane atacağım.
Dialogue: 0,0:03:34.35,0:03:35.65,Default,,0,0,0,,Bana pas ver!
Dialogue: 0,0:03:35.65,0:03:36.52,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:36.52,0:03:38.02,Default,,0,0,0,,Önce ilk gol...
Dialogue: 0,0:03:38.02,0:03:39.25,Default,,0,0,0,,İzin verir miyim sandın?!
Dialogue: 0,0:03:39.25,0:03:39.86,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:39.86,0:03:42.28,Default,,0,0,0,,Ishizaki-kun harika bir şekilde kesiyor.
Dialogue: 0,0:03:42.28,0:03:43.40,Default,,0,0,0,,Başardım!
Dialogue: 0,0:03:43.40,0:03:45.72,Default,,0,0,0,,Harikaydı Ishizaki! Böyle devam et!
Dialogue: 0,0:03:45.72,0:03:47.24,Default,,0,0,0,,Al bakalım Taki!
Dialogue: 0,0:03:47.24,0:03:48.34,Default,,0,0,0,,Tamam.
Dialogue: 0,0:03:48.34,0:03:50.92,Default,,0,0,0,,Sağ kanattaki Taki-kun'a\Nhızlı bir pas veriyor.
Dialogue: 0,0:03:50.92,0:03:52.36,Default,,0,0,0,,Nankatsu bir kez daha saldırıyor!
Dialogue: 0,0:03:52.36,0:03:54.25,Default,,0,0,0,,Hiç aman vermiyorlar!
Dialogue: 0,0:03:54.25,0:03:56.92,Default,,0,0,0,,Durdurun şunu!\NOrta açmasına izin vermeyin!
Dialogue: 0,0:03:57.98,0:04:01.30,Default,,0,0,0,,Meiwa iki kişinin kayarak\Nmüdahalesi sonucu topu çalıyor!
Dialogue: 0,0:04:03.20,0:04:05.43,Default,,0,0,0,,Ne var ki Misaki-kun topu geri alıyor.
Dialogue: 0,0:04:06.19,0:04:07.97,Default,,0,0,0,,Bugün kesinlikle kaybetmeyeceğim.
Dialogue: 0,0:04:07.97,0:04:11.07,Default,,0,0,0,,Tsubasa-kun kale önüne doğru koşuyor.
Dialogue: 0,0:04:11.07,0:04:11.77,Default,,0,0,0,,Tutun!
Dialogue: 0,0:04:11.77,0:04:15.27,Default,,0,0,0,,Nankatsu bir kez daha altın ikilisi\Naracılığıyla gol atmak istiyor.
Dialogue: 0,0:04:15.27,0:04:16.90,Default,,0,0,0,,Orta!
Dialogue: 0,0:04:18.65,0:04:21.57,Default,,0,0,0,,Hayır, Tsubasa-kun sadece yemmiş.
Dialogue: 0,0:04:22.03,0:04:22.78,Default,,0,0,0,,Bende!
Dialogue: 0,0:04:24.06,0:04:24.92,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:24.92,0:04:28.62,Default,,0,0,0,,Kaleci Wakashimazu-kun topu yakalıyor!
Dialogue: 0,0:04:29.66,0:04:31.87,Default,,0,0,0,,Yine güzel bir kurtarış.
Dialogue: 0,0:04:31.87,0:04:32.44,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:04:32.45,0:04:34.47,Default,,0,0,0,,Tsubasa-kun defansı yemlerken...
Dialogue: 0,0:04:34.47,0:04:38.92,Default,,0,0,0,,...Wakashimazu-kun sakince stratejilerini\Nokuyan tek kişiydi.
Dialogue: 0,0:04:38.92,0:04:41.67,Default,,0,0,0,,Bu kaleci çetin ceviz.
Dialogue: 0,0:04:41.67,0:04:45.17,Default,,0,0,0,,Sadece yakalama yeteneği değil,\Nkarar verme yeteneği de harika.
Dialogue: 0,0:04:45.17,0:04:48.76,Default,,0,0,0,,Sanırım ben 3 numaralı kaleci oluyorum.
Dialogue: 0,0:04:48.76,0:04:51.06,Default,,0,0,0,,Penaltımı durdurabilmesine şaşmamalı.
Dialogue: 0,0:04:51.56,0:04:53.56,Default,,0,0,0,,Nankatsu'nun işi buraya kadar!
Dialogue: 0,0:04:53.56,0:04:56.50,Default,,0,0,0,,Yapalım şunu Kaptan!
Dialogue: 0,0:04:58.99,0:05:00.73,Default,,0,0,0,,Güzel pas Wakashimazu.
Dialogue: 0,0:05:00.73,0:05:03.48,Default,,0,0,0,,Tamamdır, Hyuga-kun aldıysa gol atar.
Dialogue: 0,0:05:03.48,0:05:06.44,Default,,0,0,0,,Durdurun onu!\NHyuga'nun geçmesine sakın izin vermeyin!
Dialogue: 0,0:05:06.44,0:05:08.29,Default,,0,0,0,,Gidelim Nankatsu!
Dialogue: 0,0:05:08.29,0:05:09.91,Default,,0,0,0,,Durdurabiliyorsanız durdurun bakalım!
Dialogue: 0,0:05:09.91,0:05:12.37,Default,,0,0,0,,Tüm gücümü göstereceğim size!
Dialogue: 0,0:05:12.37,0:05:16.12,Default,,0,0,0,,Nankatsu iki oyuncusuyla\Nbirlikte top sürüşünü durdurmayı deniyor.
Dialogue: 0,0:05:16.12,0:05:17.57,Default,,0,0,0,,Sizi...
Dialogue: 0,0:05:20.00,0:05:23.06,Default,,0,0,0,,Hyuga-kun gücüyle yarıyor!
Dialogue: 0,0:05:23.06,0:05:27.17,Default,,0,0,0,,İşte Hyuga-kun'un gücü bu\NNe azimli bir oğlan!
Dialogue: 0,0:05:27.17,0:05:28.34,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:05:28.34,0:05:31.76,Default,,0,0,0,,Hyuga-kun kaleye doğru koşan\NSawada-kun'a pas veriyor.
Dialogue: 0,0:05:32.43,0:05:38.08,Default,,0,0,0,,Nankatsu'da Tsubasa-kun, Misaki-kun ikilisi\Nvarsa Meiwa'da Hyuga-kun, Sawada-kun ikilisi var.
Dialogue: 0,0:05:38.08,0:05:38.94,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:05:38.94,0:05:40.12,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:05:40.12,0:05:41.06,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:05:41.06,0:05:43.40,Default,,0,0,0,,Kale önünde Hyuga-kun pası alıyor!
Dialogue: 0,0:05:43.40,0:05:46.08,Default,,0,0,0,,Al bakalım Nankatsu!
Dialogue: 0,0:05:47.76,0:05:48.78,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:48.78,0:05:49.87,Default,,0,0,0,,Durdurdu!
Dialogue: 0,0:05:49.87,0:05:52.91,Default,,0,0,0,,Kaleci Wakabayashi-kun\Ntopu sıkıca yakalıyor!
Dialogue: 0,0:05:55.33,0:05:58.27,Default,,0,0,0,,Wakabayashi-kun'dan da bu beklenirdi.
Dialogue: 0,0:05:58.27,0:06:03.63,Default,,0,0,0,,Aynen öyle. Meiwa'da Wakashimazu-kun\Nvarsa Nankatsu'da Wakabayashi-kun var.
Dialogue: 0,0:06:03.63,0:06:10.76,Default,,0,0,0,,Şimdiden ulusal seviyedeki yetenekleriyle Wakabayashi\NGenzo-kun'dan Japon futbolu adına çok şey bekleniyor.
Dialogue: 0,0:06:10.76,0:06:14.22,Default,,0,0,0,,Harika bir şekilde zıplayıp kurtardı.
Dialogue: 0,0:06:12.24,0:06:14.22,Default,,0,0,0,,{\an8}İşte böyle Wakabayashi-san!
Dialogue: 0,0:06:14.22,0:06:18.23,Default,,0,0,0,,Wakabayashi Genzo'nun\NKaptan'ı böyle savurması...
Dialogue: 0,0:06:18.23,0:06:22.89,Default,,0,0,0,,Hyuga, sana olan borcumu\Nburada kapatacağım.
Dialogue: 0,0:06:22.89,0:06:24.73,Default,,0,0,0,,Kesinlikle kaybetmeyeceğim!
Dialogue: 0,0:06:24.73,0:06:27.51,Default,,0,0,0,,Lanet olsun! İzle de gör Wakabayashi!
Dialogue: 0,0:06:27.51,0:06:30.11,Default,,0,0,0,,Kesinlikle sana gol atacağım!
Dialogue: 0,0:06:30.11,0:06:32.41,Default,,0,0,0,,Size güveniyorum çocuklar!
Dialogue: 0,0:06:32.41,0:06:35.62,Default,,0,0,0,,İki kaleci de çok iyi değil mi?
Dialogue: 0,0:06:35.62,0:06:39.58,Default,,0,0,0,,Hyuga-kun da Tsubasa-kun da\Nbugün kolayca gol atamayacak.
Dialogue: 0,0:06:39.58,0:06:41.02,Default,,0,0,0,,İyi bari.
Dialogue: 0,0:06:41.02,0:06:41.79,Default,,0,0,0,,Ne?
Dialogue: 0,0:06:41.79,0:06:46.76,Default,,0,0,0,,Toho Akademisi'nin forveti,\Nen iyi kalecilere bile gol atabilen...
Dialogue: 0,0:06:46.76,0:06:49.88,Default,,0,0,0,,...harika bir yıldız forvet olmalı.
Dialogue: 0,0:06:49.88,0:06:51.40,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:06:52.43,0:06:53.80,Default,,0,0,0,,İzin vermeyiz!
Dialogue: 0,0:06:54.84,0:06:56.51,Default,,0,0,0,,Tsubasa-kun çalımlıyor!
Dialogue: 0,0:06:56.51,0:06:59.52,Default,,0,0,0,,Hızlıca Meiwa kalesine doğru koşuyor.
Dialogue: 0,0:06:59.52,0:07:01.58,Default,,0,0,0,,İyi düşün Tsubasa.
Dialogue: 0,0:07:01.58,0:07:04.91,Default,,0,0,0,,O kaleciyi sadece topa\Nvurarak geçemezsin.
Dialogue: 0,0:07:04.91,0:07:07.18,Default,,0,0,0,,Futbolda hayal gücünü kullanman gerekir.
Dialogue: 0,0:07:07.18,0:07:11.28,Default,,0,0,0,,Sahada duran her şeyi ve herkesi\Nkendi menfaatin için kullanmalısın.
Dialogue: 0,0:07:11.28,0:07:13.53,Default,,0,0,0,,Bu kez ilk golü kesinlikle atacağım!
Dialogue: 0,0:07:15.28,0:07:17.87,Default,,0,0,0,,Tsubasa-kun şut pozisyonu alıyor.
Dialogue: 0,0:07:17.87,0:07:20.04,Default,,0,0,0,,Nasıl bir şut çekecek acaba?
Dialogue: 0,0:07:20.04,0:07:22.21,Default,,0,0,0,,Tamamdır, istediğin yerden gel!
Dialogue: 0,0:07:23.55,0:07:25.70,Default,,0,0,0,,Ne?! Topu kaçırıyor!
Dialogue: 0,0:07:25.70,0:07:26.25,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:27.75,0:07:29.74,Default,,0,0,0,,Hayır, bilerek yapmış.
Dialogue: 0,0:07:29.74,0:07:33.94,Default,,0,0,0,,Wakashimazu-kun Tsubasa-kun'un\Naldatmacasına kanıp dengesini kaybediyor.
Dialogue: 0,0:07:33.94,0:07:34.84,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:07:34.84,0:07:36.01,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:07:37.26,0:07:39.43,Default,,0,0,0,,Misaki-kun şut çekiyor!
Dialogue: 0,0:07:40.56,0:07:41.40,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:41.40,0:07:45.27,Default,,0,0,0,,Wakashimazu-kun, dengesini kaybetmesine\Nrağmen ayağıyla topu uzaklaştırıyor!
Dialogue: 0,0:07:45.27,0:07:47.06,Default,,0,0,0,,Güzeldi Wakashimazu!
Dialogue: 0,0:07:47.60,0:07:49.48,Default,,0,0,0,,Meiwa topu takip edemiyor.
Dialogue: 0,0:07:49.48,0:07:52.74,Default,,0,0,0,,Orta açma konusunda\Nuzman Taki-kun'a gidiyor.
Dialogue: 0,0:07:52.74,0:07:53.57,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:07:53.57,0:07:54.61,Default,,0,0,0,,Sana güveniyorum Tsubasa!
Dialogue: 0,0:07:54.61,0:07:55.91,Default,,0,0,0,,Bu kez...
Dialogue: 0,0:07:57.87,0:08:00.24,Default,,0,0,0,,Tsubasa-kun direkt şut çekiyor!
Dialogue: 0,0:08:00.95,0:08:02.71,Default,,0,0,0,,T-Tuttu!
Dialogue: 0,0:08:02.71,0:08:04.71,Default,,0,0,0,,N-Nasıl...
Dialogue: 0,0:08:04.71,0:08:05.46,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:08:07.00,0:08:09.34,Default,,0,0,0,,Nefes kesecek bir oyundu resmen!
Dialogue: 0,0:08:09.34,0:08:10.62,Default,,0,0,0,,Başardı!
Dialogue: 0,0:08:10.62,0:08:15.22,Default,,0,0,0,,Kale direğini kullanarak ters tarafa\Nzıpladı ve mükemmel şekilde yakaladı.
Dialogue: 0,0:08:15.84,0:08:18.62,Default,,0,0,0,,Harika oynayış tarzı\Nherkesin ağzını açık bırakıyor!
Dialogue: 0,0:08:19.46,0:08:21.14,Default,,0,0,0,,Wakashimazu'dan da bu beklenirdi.
Dialogue: 0,0:08:21.14,0:08:24.78,Default,,0,0,0,,Damarlarında karatecilerin kanı akıyor.
Dialogue: 0,0:08:24.78,0:08:30.52,Default,,0,0,0,,Bu keskin refleksleri de ilkokuldan\Nönce öğrendiği karateye borçlu.
Dialogue: 0,0:08:30.52,0:08:36.66,Default,,0,0,0,,Kale direğini kullanma şekli, karatedeki\Nüçlü tekmenin bir uyarlamasıydı.
Dialogue: 0,0:08:41.48,0:08:43.23,Default,,0,0,0,,Wakashimazu Ken...
Dialogue: 0,0:08:43.23,0:08:47.75,Default,,0,0,0,,Bu kaleciyi aşmak için rövaşata\Nvuruş yapmaktan başka çarem yok.
Dialogue: 0,0:08:50.58,0:08:52.20,Default,,0,0,0,,Ozora Tsubasa...
Dialogue: 0,0:08:54.16,0:08:54.92,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:08:55.83,0:08:57.68,Default,,0,0,0,,Bu kez yoluma çıkamayacaksınız!
Dialogue: 0,0:08:57.68,0:08:58.68,Default,,0,0,0,,Gol atacağım!
Dialogue: 0,0:08:59.84,0:09:02.10,Default,,0,0,0,,Wakabayashi-kun zıplayarak yakalıyor!
Dialogue: 0,0:09:02.10,0:09:03.10,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:04.06,0:09:09.99,Default,,0,0,0,,Aynen öyle. Wakabayashi-kun, ceza sahası\Ndışından atılan her şutu tutabilecek...
Dialogue: 0,0:09:09.99,0:09:12.36,Default,,0,0,0,,...dahi bir kaleci.
Dialogue: 0,0:09:13.39,0:09:15.24,Default,,0,0,0,,Gördün mü Hyuga?
Dialogue: 0,0:09:15.24,0:09:18.72,Default,,0,0,0,,Tsubasa bile ceza sahası dışından\Ngol atamadı ona.
Dialogue: 0,0:09:18.72,0:09:21.33,Default,,0,0,0,,Senin için imkansız anlayacağın!
Dialogue: 0,0:09:23.95,0:09:26.71,Default,,0,0,0,,Tsubasa bile mi?
Dialogue: 0,0:09:27.79,0:09:29.50,Default,,0,0,0,,Bunu duymam iyi oldu.
Dialogue: 0,0:09:29.50,0:09:33.67,Default,,0,0,0,,Yani ceza sahası dışından\Ngol atabilirsem...
Dialogue: 0,0:09:33.67,0:09:38.18,Default,,0,0,0,,...Tsubasa'dan iyi olduğumu kanıtlarım.
Dialogue: 0,0:09:38.18,0:09:41.46,Default,,0,0,0,,İlk yarının 10. dakikasındayız ve\NWakashimazu-kun, Wakabayashi-kun...
Dialogue: 0,0:09:41.46,0:09:44.80,Default,,0,0,0,,...çok çabaladığı için skor 0-0.
Dialogue: 0,0:09:44.80,0:09:48.64,Default,,0,0,0,,İlk golü atan takım hangisi olacak?
Dialogue: 0,0:09:48.64,0:09:54.53,Default,,0,0,0,,İlk maçımızdan sonra her birisi\Nyeteneklerini çok geliştirmiş.
Dialogue: 0,0:09:54.53,0:09:57.78,Default,,0,0,0,,Ama kazananlar biz olacağız!
Dialogue: 0,0:10:01.37,0:10:04.39,Default,,0,0,0,,Tsubasa'nın markaja alınması sıradan bir olay.
Dialogue: 0,0:10:04.39,0:10:05.83,Default,,0,0,0,,Öyleyse bana gün doğdu!
Dialogue: 0,0:10:05.83,0:10:10.58,Default,,0,0,0,,Tamamdır! Kisugi Teppei\Nolarak gol atma işini halledeceğim!
Dialogue: 0,0:10:10.58,0:10:11.33,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:10:12.00,0:10:14.55,Default,,0,0,0,,Kale önündeki Tsubasa-kun'a pas geliyor.
Dialogue: 0,0:10:14.55,0:10:17.72,Default,,0,0,0,,Lanet olsun! Tutmamıza rağmen bu...
Dialogue: 0,0:10:17.72,0:10:18.72,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:18.72,0:10:20.59,Default,,0,0,0,,Tsubasa-kun bu kez gol atabilecek mi?
Dialogue: 0,0:10:20.59,0:10:23.54,Default,,0,0,0,,Yoksa kaleci Wakashimazu-kun\Nbir kez daha durduracak mı?
Dialogue: 0,0:10:23.54,0:10:24.60,Default,,0,0,0,,Gel!
Dialogue: 0,0:10:25.20,0:10:29.02,Default,,0,0,0,,Olmaz. Bunu şut çekersem\NWakashimazu-kun'u geçmeyecek.
Dialogue: 0,0:10:29.02,0:10:30.02,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:10:30.02,0:10:31.44,Default,,0,0,0,,Kisugi-kun!
Dialogue: 0,0:10:33.25,0:10:38.65,Default,,0,0,0,,Tsubasa-kun şut çekecek durumda olmasına rağmen\Nbedeninin pozisyonunu değiştirip pas veriyor!
Dialogue: 0,0:10:38.65,0:10:39.57,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:39.57,0:10:42.28,Default,,0,0,0,,Harika bir karar.
Dialogue: 0,0:10:42.28,0:10:44.45,Default,,0,0,0,,Tamamdır, bende bu!
Dialogue: 0,0:10:44.45,0:10:45.45,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:10:45.45,0:10:48.53,Default,,0,0,0,,Nankatsu'nun gizli gücü\NKisugi-kun şut çekiyor!
Dialogue: 0,0:10:50.53,0:10:51.28,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:51.28,0:10:53.46,Default,,0,0,0,,Gol olmuyor!
Dialogue: 0,0:10:53.46,0:10:55.14,Default,,0,0,0,,Nasıl refleksler bunlar böyle?!
Dialogue: 0,0:10:55.14,0:10:57.25,Default,,0,0,0,,Wakashimazu-kun şutu uzaklaştırıyor!
Dialogue: 0,0:10:57.25,0:10:58.88,Default,,0,0,0,,Güzeldi Wakashimazu-san!
Dialogue: 0,0:10:58.88,0:11:00.47,Default,,0,0,0,,Bu bile yeterli değil mi?!
Dialogue: 0,0:11:00.47,0:11:03.47,Default,,0,0,0,,İşte bu! Bu topa rövaşata çekeceğim!
Dialogue: 0,0:11:03.47,0:11:06.97,Default,,0,0,0,,Bu duruş, rövaşata vuruşunun hazırlığı!
Dialogue: 0,0:11:06.97,0:11:09.98,Default,,0,0,0,,Wakashimazu-kun henüz ayağa kalkmadı!
Dialogue: 0,0:11:09.98,0:11:12.40,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:11:12.40,0:11:15.94,Default,,0,0,0,,Havada rövaşata mücadelesi!
Dialogue: 0,0:11:23.30,0:11:30.00,Default,,0,0,0,,Hyuga-kun, Tsubasa-kun'un rövaşatasını\Nkendi rövaşatasıyla harika bir şekilde durdurdu!
Dialogue: 0,0:11:30.00,0:11:30.75,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:11:30.75,0:11:31.21,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:31.21,0:11:33.75,Default,,0,0,0,,Bu topun boşa gitmesine izin veremem.
Dialogue: 0,0:11:33.75,0:11:35.25,Default,,0,0,0,,Golü ben atacağım!
Dialogue: 0,0:11:35.25,0:11:36.92,Default,,0,0,0,,Gel bakalım!
Dialogue: 0,0:11:38.52,0:11:40.17,Default,,0,0,0,,Top...
Dialogue: 0,0:11:41.17,0:11:42.92,Default,,0,0,0,,Şut...
Dialogue: 0,0:11:44.07,0:11:45.42,Default,,0,0,0,,Şut...
Dialogue: 0,0:11:46.58,0:11:47.46,Default,,0,0,0,,...çekmeliyim!
Dialogue: 0,0:11:47.46,0:11:47.89,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:48.64,0:11:50.02,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:11:50.02,0:11:50.89,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:54.05,0:11:59.69,Default,,0,0,0,,Misaki-kun ve Tsubasa-kun\Nbirlikte şut çekiyor!
Dialogue: 0,0:12:02.12,0:12:03.58,Default,,0,0,0,,Ne?
Dialogue: 0,0:12:03.58,0:12:04.45,Default,,0,0,0,,Top...
Dialogue: 0,0:12:12.09,0:12:13.70,Default,,0,0,0,,Gol!
Dialogue: 0,0:12:13.70,0:12:16.88,Default,,0,0,0,,Kaleci Wakashimazu-kun\Nbu şuta karşı tepki veremiyor.
Dialogue: 0,0:12:16.88,0:12:20.38,Default,,0,0,0,,İlk yarının 12. dakikasında\NNankatsu ilk golü atıyor.
Dialogue: 0,0:12:20.38,0:12:23.38,Default,,0,0,0,,- Başardılar!\N- Başardılar! İlk golü attılar!
Dialogue: 0,0:12:23.38,0:12:25.38,Default,,0,0,0,,Girdi...
Dialogue: 0,0:12:25.38,0:12:27.12,Default,,0,0,0,,Başardık Tsubasa-kun!
Dialogue: 0,0:12:27.12,0:12:29.03,Default,,0,0,0,,İlk golümüzü attık!
Dialogue: 0,0:12:29.03,0:12:30.14,Default,,0,0,0,,E-Evet.
Dialogue: 0,0:12:30.14,0:12:34.96,Default,,0,0,0,,Düştüğümde kafamı vurunca\Nşut çekeceğini göremedim.
Dialogue: 0,0:12:34.96,0:12:37.65,Default,,0,0,0,,Ama gerçekten gol attık değil mi?
Dialogue: 0,0:12:37.65,0:12:40.16,Default,,0,0,0,,Başardınız Tsubasa, Misaki!
Dialogue: 0,0:12:40.16,0:12:41.14,Default,,0,0,0,,Millet!
Dialogue: 0,0:12:41.14,0:12:43.44,Default,,0,0,0,,Harika bir şuttu!
Dialogue: 0,0:12:43.44,0:12:46.00,Default,,0,0,0,,Tsubasa-kun ve Misaki-kun\Ntopa birlikte vurduğundan...
Dialogue: 0,0:12:46.00,0:12:47.69,Default,,0,0,0,,...top farklı bir rota izledi...
Dialogue: 0,0:12:47.69,0:12:50.99,Default,,0,0,0,,...ve o kadar hızlı gidiyorken\Ntakip etmesi zor oldu.
Dialogue: 0,0:12:50.99,0:12:53.70,Default,,0,0,0,,Böylesine harika bir savunma\Nortaya koyan Wakashimazu-kun bile...
Dialogue: 0,0:12:53.70,0:12:57.75,Default,,0,0,0,,...bu şutu durdurmayı başaramadı.
Dialogue: 0,0:12:57.75,0:13:00.73,Default,,0,0,0,,Bu şut bir harikaydı.
Dialogue: 0,0:13:00.73,0:13:02.71,Default,,0,0,0,,Tsubasa ve Misaki'den de bu beklenirdi.
Dialogue: 0,0:13:03.24,0:13:05.45,Default,,0,0,0,,Yıllardır futbol izlerim...
Dialogue: 0,0:13:05.45,0:13:08.22,Default,,0,0,0,,...ama ilk kez böyle bir şut görüyorum!
Dialogue: 0,0:13:08.22,0:13:12.01,Default,,0,0,0,,Sonunda başardınız Tsubasa, Misaki.
Dialogue: 0,0:13:12.66,0:13:16.27,Default,,0,0,0,,Lanet olsun! Nasıl o şuta\Ntepki veremedim?
Dialogue: 0,0:13:16.79,0:13:17.98,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:13:17.98,0:13:19.73,Default,,0,0,0,,Wakashimazu-san...
Dialogue: 0,0:13:20.29,0:13:21.44,Default,,0,0,0,,Sorun değil.
Dialogue: 0,0:13:21.44,0:13:24.53,Default,,0,0,0,,O golü unut Wakashimazu.
Dialogue: 0,0:13:24.53,0:13:28.07,Default,,0,0,0,,Bir daha öyle bir şut çekemeyecekler.
Dialogue: 0,0:13:28.07,0:13:30.12,Default,,0,0,0,,Eşek şansıydı.
Dialogue: 0,0:13:30.12,0:13:31.16,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:13:31.16,0:13:35.70,Default,,0,0,0,,O golü kesinlikle geri alacağım.
Dialogue: 0,0:13:45.16,0:13:47.60,Default,,0,0,0,,Yakıcı sıcak altında...
Dialogue: 0,0:13:47.60,0:13:52.85,Default,,0,0,0,,...bir gol gerideyken Meiwa FC,\Nnasıl bir atak sergileyecek?
Dialogue: 0,0:13:52.85,0:13:54.58,Default,,0,0,0,,"Bir tane yersen onu geri öde."
Dialogue: 0,0:13:54.58,0:13:56.39,Default,,0,0,0,,Mücadelenin altın kuralı budur.
Dialogue: 0,0:13:56.39,0:13:58.38,Default,,0,0,0,,Sana güveniyorum Kojiro.
Dialogue: 0,0:13:59.90,0:14:03.94,Default,,0,0,0,,Bu golü ne pahasına\Nolursa olsun koruyacağım.
Dialogue: 0,0:14:04.82,0:14:06.57,Default,,0,0,0,,Geliyorum Nankatsu!
Dialogue: 0,0:14:06.57,0:14:08.84,Default,,0,0,0,,Hyuga-kun şiddetli bir şekilde atağa çıkıyor!
Dialogue: 0,0:14:08.84,0:14:11.34,Default,,0,0,0,,Bir gol yemek mücadeleci\Nruhunu ateşledi mi yoksa?
Dialogue: 0,0:14:11.34,0:14:12.83,Default,,0,0,0,,Harika bir sürüş!
Dialogue: 0,0:14:12.83,0:14:14.36,Default,,0,0,0,,Geçmene izin vermeyiz!
Dialogue: 0,0:14:14.36,0:14:16.50,Default,,0,0,0,,Nankatsu azimle savunmaya çalışıyor!
Dialogue: 0,0:14:17.38,0:14:19.08,Default,,0,0,0,,Çok keskin kayıyor!
Dialogue: 0,0:14:22.55,0:14:26.01,Default,,0,0,0,,Dev gibi gücü ve öngörüsüyle Hyuga-kun geçiyor!
Dialogue: 0,0:14:26.01,0:14:28.17,Default,,0,0,0,,Nankatsu onu durduramıyor!
Dialogue: 0,0:14:28.17,0:14:30.10,Default,,0,0,0,,İşte bu! Hadi Hyuga!
Dialogue: 0,0:14:30.10,0:14:31.93,Default,,0,0,0,,Beraberlik şutunu çekersin!
Dialogue: 0,0:14:31.93,0:14:34.43,Default,,0,0,0,,Kojiro'nun top sürüşü gerçekten de harika.
Dialogue: 0,0:14:34.43,0:14:37.98,Default,,0,0,0,,Meiwa'da oynarken bunu\Nçok sık görürdüm.
Dialogue: 0,0:14:37.98,0:14:40.73,Default,,0,0,0,,Gol attıktan sonraki\Ndakikalar çok önemlidir.
Dialogue: 0,0:14:40.73,0:14:42.52,Default,,0,0,0,,Ne olursa olsun seni durduracağım Kojiro!
Dialogue: 0,0:14:43.85,0:14:46.32,Default,,0,0,0,,Misaki-kun kayarak müdahale ediyor!
Dialogue: 0,0:14:46.82,0:14:50.80,Default,,0,0,0,,Ama Sawada-kun topu tekrar alıyor!
Dialogue: 0,0:14:50.80,0:14:51.53,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:14:53.14,0:14:54.70,Default,,0,0,0,,Büyük bir fırsat bu!
Dialogue: 0,0:14:56.74,0:14:59.58,Default,,0,0,0,,Yine mi uzun bir şut çekecek?
Dialogue: 0,0:14:59.58,0:15:00.80,Default,,0,0,0,,Gol atacağım!
Dialogue: 0,0:15:00.80,0:15:04.36,Default,,0,0,0,,Ceza sahası dışından\Nşut çekip gol atacağım!
Dialogue: 0,0:15:04.36,0:15:05.54,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:15:05.54,0:15:09.17,Default,,0,0,0,,İşte! Hyuga-kun'un mermi gibi şutu!
Dialogue: 0,0:15:09.17,0:15:12.59,Default,,0,0,0,,Top, dehşet verici bir sesle\Nkaleye doğru gidiyor!
Dialogue: 0,0:15:12.59,0:15:13.68,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:15:13.68,0:15:15.47,Default,,0,0,0,,Ne kadar denersen dene aynısı olacak!
Dialogue: 0,0:15:15.47,0:15:17.68,Default,,0,0,0,,Bana işlemez!
Dialogue: 0,0:15:18.42,0:15:19.66,Default,,0,0,0,,Yakaladı!
Dialogue: 0,0:15:19.66,0:15:21.74,Default,,0,0,0,,Harika bir şekilde zıplayıp tutuyor!
Dialogue: 0,0:15:21.74,0:15:24.86,Default,,0,0,0,,Hyuga-kun'un 3. denemesi de boşa çıkıyor.
Dialogue: 0,0:15:25.86,0:15:28.46,Default,,0,0,0,,Wakashimazu-kun kadar\Nhavalı yapmasa da...
Dialogue: 0,0:15:28.46,0:15:31.11,Default,,0,0,0,,...savunması kesinlikle taş gibi.
Dialogue: 0,0:15:31.11,0:15:34.12,Default,,0,0,0,,Nankatsu kalecisi Wakabayashi Genzo-kun.
Dialogue: 0,0:15:34.12,0:15:35.69,Default,,0,0,0,,Aynen öyle Genzo.
Dialogue: 0,0:15:35.69,0:15:40.75,Default,,0,0,0,,Kaleci için en önemlisi taş gibi,\Nhatasız bir oyun tarzıdır.
Dialogue: 0,0:15:40.75,0:15:44.18,Default,,0,0,0,,3 seferdir gole çeviremedim.
Dialogue: 0,0:15:44.18,0:15:45.21,Default,,0,0,0,,Lanet girsin!
Dialogue: 0,0:15:48.10,0:15:51.17,Default,,0,0,0,,Hyuga-kun ceza sahası dışından\Nuzun bir şut çekiyor!
Dialogue: 0,0:15:51.74,0:15:54.72,Default,,0,0,0,,Ama Wakabayashi-kun\Nzıplayarak bunu da tutuyor!
Dialogue: 0,0:15:58.93,0:16:01.02,Default,,0,0,0,,Wakabayashi-san'dan da bu beklenirdi!
Dialogue: 0,0:16:01.02,0:16:05.04,Default,,0,0,0,,Ben olsam tüm o harika\Nşutları gol yerdim.
Dialogue: 0,0:16:05.04,0:16:06.19,Default,,0,0,0,,Evet, evet.
Dialogue: 0,0:16:06.19,0:16:08.94,Default,,0,0,0,,Bacağın iyileşmiş gibi Wakabayashi.
Dialogue: 0,0:16:09.83,0:16:10.98,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:16:10.98,0:16:11.69,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:16:11.69,0:16:15.04,Default,,0,0,0,,Neden ceza sahası dışından\Nvurmaya bu kadar taktın?
Dialogue: 0,0:16:15.78,0:16:17.43,Default,,0,0,0,,Bilerek mi?
Dialogue: 0,0:16:17.43,0:16:18.33,Default,,0,0,0,,Muhtemelen.
Dialogue: 0,0:16:18.33,0:16:25.24,Default,,0,0,0,,Wakabayashi-kun ceza sahası dışından hiç\Ngol yemediği için efsaneleşti.
Dialogue: 0,0:16:25.24,0:16:31.18,Default,,0,0,0,,Hyuga-kun da kendi yeteneğini kanıtlamak\Niçin umutsuzca bu unvanı ezmek istiyor.
Dialogue: 0,0:16:31.18,0:16:35.05,Default,,0,0,0,,Ama bir forvetin düşeceği bir hata bu.
Dialogue: 0,0:16:35.05,0:16:41.79,Default,,0,0,0,,Açıkça söylemek gerekirse bugünkü Hyuga-kun,\NToho Akademisi yıldız forveti olma testini geçemedi.
Dialogue: 0,0:16:43.14,0:16:44.73,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:16:44.73,0:16:48.48,Default,,0,0,0,,{\an8}Hora! Hora! Nankatsu!
Dialogue: 0,0:16:44.73,0:16:49.06,Default,,0,0,0,,İlk yarıda bir dakikadan az bir süre kaldı.
Dialogue: 0,0:16:48.92,0:16:50.55,Default,,0,0,0,,{\an8}Gol at Hyuga!
Dialogue: 0,0:16:50.55,0:16:51.73,Default,,0,0,0,,{\an8}Sadece bir dakika kaldı!
Dialogue: 0,0:16:49.06,0:16:53.90,Default,,0,0,0,,Meiwa ilk yarı bitmeden önce beraberlik\Nsağlamak istediği için sürekli atak yapıyor!
Dialogue: 0,0:16:53.90,0:16:54.65,Default,,0,0,0,,Bana gönder!
Dialogue: 0,0:16:56.24,0:16:57.03,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:16:57.48,0:17:00.28,Default,,0,0,0,,Meiwa son kez topu Hyuga-kun'a gönderiyor.
Dialogue: 0,0:17:00.28,0:17:04.10,Default,,0,0,0,,Bu kez gol atacağım!
Dialogue: 0,0:17:04.10,0:17:07.25,Default,,0,0,0,,Son şut da ceza sahası dışından geliyor.
Dialogue: 0,0:17:08.75,0:17:09.96,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:17:10.88,0:17:12.17,Default,,0,0,0,,Güçlü bir şut!
Dialogue: 0,0:17:12.17,0:17:15.72,Default,,0,0,0,,Wakabayashi-kun bu kez de\Nyakalayabilecek mi?
Dialogue: 0,0:17:15.72,0:17:19.26,Default,,0,0,0,,Şut yolunda başka bir oyuncu da var!
Dialogue: 0,0:17:19.80,0:17:21.66,Default,,0,0,0,,Sawada-kun!
Dialogue: 0,0:17:21.66,0:17:24.56,Default,,0,0,0,,Wakabayashi-kun hazırlıksız yakalanıyor!
Dialogue: 0,0:17:24.56,0:17:25.27,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:17:26.06,0:17:27.02,Default,,0,0,0,,Başardım!
Dialogue: 0,0:17:27.02,0:17:31.40,Default,,0,0,0,,Meiwa ilk yarı bitmeden\Nönce skoru eşitleyecek mi?
Dialogue: 0,0:17:32.65,0:17:34.57,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:17:34.57,0:17:40.27,Default,,0,0,0,,Elini yere koyup bedenini iterek\Ntopu zar zor uzaklaştırmayı başarıyor!
Dialogue: 0,0:17:42.62,0:17:43.84,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:17:43.84,0:17:46.21,Default,,0,0,0,,Hakem yarıyı bitiren düdüğü çalıyor.
Dialogue: 0,0:17:46.21,0:17:51.04,Default,,0,0,0,,Wakabayashi-kun, Nankatsu kalesini\Ngol yemeyerek harika bir biçimde savundu.
Dialogue: 0,0:17:51.04,0:17:55.34,Default,,0,0,0,,Ama bir gol yemesine rağmen\NWakashimazu-kun da harika oynadı.
Dialogue: 0,0:17:55.34,0:17:59.12,Default,,0,0,0,,İlk yarının kaleciler arasında\Ngeçtiğini söylemek abartı olmaz.
Dialogue: 0,0:18:00.34,0:18:02.41,Default,,0,0,0,,Millet, ellerinize sağlık.
Dialogue: 0,0:18:02.41,0:18:03.47,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:03.47,0:18:07.48,Default,,0,0,0,,Tsubasa ve Misaki'nin birlikte\Nçektiği şut harikaydı.
Dialogue: 0,0:18:08.48,0:18:13.61,Default,,0,0,0,,Resmi olarak Misaki'nin asisti\Nve Tsubasa'nın golü sayılmış.
Dialogue: 0,0:18:13.61,0:18:16.17,Default,,0,0,0,,Yani Tsubasa'nın 28 golü var!
Dialogue: 0,0:18:16.17,0:18:20.11,Default,,0,0,0,,Gol krallığında Hyuga'nın\Nbir gol önünde ve en üstte!
Dialogue: 0,0:18:20.11,0:18:21.87,Default,,0,0,0,,Hyuga'ya kaybetme sakın!
Dialogue: 0,0:18:22.42,0:18:26.54,Default,,0,0,0,,Açıkçası en üstte olma konusunda\Ndaha çok istediğim bir şey var.
Dialogue: 0,0:18:28.34,0:18:29.89,Default,,0,0,0,,Şampiyonluk flaması.
Dialogue: 0,0:18:29.89,0:18:35.42,Default,,0,0,0,,Çünkü şimdiye kadar hep birlikte\Nşampiyonluk flamasını kazanmak için çok çalışmadık mı?
Dialogue: 0,0:18:35.42,0:18:39.93,Default,,0,0,0,,Buraya kadar geldik.\NNe olursa olsun kazanalım millet!
Dialogue: 0,0:18:41.80,0:18:43.55,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:18:43.55,0:18:45.29,Default,,0,0,0,,Evet, kesinlikle!
Dialogue: 0,0:18:45.29,0:18:47.55,Default,,0,0,0,,Buraya kadar geldikten sonra\Nkaybetmek istemiyorum!
Dialogue: 0,0:18:47.55,0:18:49.77,Default,,0,0,0,,Meiwa'ya ilk maçtan borçluyuz zaten.
Dialogue: 0,0:18:50.34,0:18:58.40,Default,,0,0,0,,Tsubasa, benim Nankatsu SC'de\Nolduğumdan daha iyi bir kaptansın.
Dialogue: 0,0:18:58.40,0:18:59.90,Default,,0,0,0,,Girmek üzereydi be.
Dialogue: 0,0:19:00.52,0:19:02.76,Default,,0,0,0,,O şut çok yakındı.
Dialogue: 0,0:19:02.76,0:19:03.41,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:03.87,0:19:04.65,Default,,0,0,0,,Takeshi.
Dialogue: 0,0:19:04.65,0:19:05.82,Default,,0,0,0,,Efendim?
Dialogue: 0,0:19:05.82,0:19:07.68,Default,,0,0,0,,Bir daha öyle bir şey yapma.
Dialogue: 0,0:19:09.50,0:19:11.22,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:19:13.15,0:19:14.42,Default,,0,0,0,,Hyuga-san.
Dialogue: 0,0:19:14.42,0:19:18.76,Default,,0,0,0,,Açık konuşacağım. Bugün oynadığın\Nfutbol, Meiwa futbolu değildi.
Dialogue: 0,0:19:18.76,0:19:20.09,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:20.09,0:19:23.74,Default,,0,0,0,,Meiwa futbolu ne olursa olsun\Nkazanmaya dayalı bir futboldur.
Dialogue: 0,0:19:23.74,0:19:28.56,Default,,0,0,0,,Yine de bugünkü Hyuga-san sadece\Nceza sahasından şut çekti durdu.
Dialogue: 0,0:19:28.56,0:19:30.77,Default,,0,0,0,,Kesinlikle Meiwa futbolu değildi!
Dialogue: 0,0:19:33.38,0:19:34.65,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:19:35.22,0:19:36.44,Default,,0,0,0,,Takeshi...
Dialogue: 0,0:19:37.31,0:19:39.69,Default,,0,0,0,,E-Efendim?
Dialogue: 0,0:19:40.83,0:19:43.45,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:19:45.48,0:19:50.24,Default,,0,0,0,,Bugünkü maçta aceleci\Ndavrandığım doğru.
Dialogue: 0,0:19:50.24,0:19:54.68,Default,,0,0,0,,Açıkçası bu maç, Toho\NAkademisi'ne girip girmememi bağlıyor.
Dialogue: 0,0:19:54.68,0:19:55.90,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:55.90,0:19:58.90,Default,,0,0,0,,Futbol konusunda ünlü\NToho Akademisi mi?
Dialogue: 0,0:19:58.90,0:19:59.34,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:00.14,0:20:03.43,Default,,0,0,0,,İlk maçın sonunda beni almak istemişlerdi.
Dialogue: 0,0:20:03.43,0:20:09.94,Default,,0,0,0,,Üniversiteye kadar tüm eğitim\Nmasraflarımın karşılanacağını söylediler.
Dialogue: 0,0:20:09.94,0:20:15.48,Default,,0,0,0,,Babam öldüğünden beri evdeki\Nişler 5 yaşımdan beri bize bakıyor.
Dialogue: 0,0:20:16.22,0:20:18.73,Default,,0,0,0,,Açıkçası çok şaşırmıştım.
Dialogue: 0,0:20:19.40,0:20:23.59,Default,,0,0,0,,Ama bu sırada Ozora Tsubasa'yı da\Nizlediklerini söyledikler.
Dialogue: 0,0:20:23.59,0:20:27.24,Default,,0,0,0,,Yani kısaca bu maçı kazananı\Nseçeceklerini düşünüyorum.
Dialogue: 0,0:20:27.24,0:20:30.98,Default,,0,0,0,,Bu yüzden Tsubasa'dan\Ndaha iyi olduğumu kanıtlamak için...
Dialogue: 0,0:20:30.98,0:20:34.83,Default,,0,0,0,,...ceza sahası dışından\Nşut çekip durdum.
Dialogue: 0,0:20:34.83,0:20:38.09,Default,,0,0,0,,Ama bu bir hataydı.
Dialogue: 0,0:20:38.09,0:20:40.44,Default,,0,0,0,,Aceleci davrandım.
Dialogue: 0,0:20:40.44,0:20:43.19,Default,,0,0,0,,Takeshi söylediğinde fark ettim.
Dialogue: 0,0:20:43.19,0:20:44.47,Default,,0,0,0,,Hyuga-san...
Dialogue: 0,0:20:47.12,0:20:51.34,Default,,0,0,0,,İkinci yarıda ne pahasına olursa\Nolsun Wakabayashi'ye gol atacağım!
Dialogue: 0,0:20:51.34,0:20:54.14,Default,,0,0,0,,Meiwa'nın kazanmaya dayalı futbolu budur!
Dialogue: 0,0:20:54.14,0:20:56.52,Default,,0,0,0,,Durumu tersine çevireceğiz kesinlikle!
Dialogue: 0,0:20:56.52,0:20:57.65,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:20:59.15,0:21:00.45,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:21:00.45,0:21:01.33,Default,,0,0,0,,Aynen öyle!
Dialogue: 0,0:21:01.33,0:21:02.76,Default,,0,0,0,,Yapalım şunu Hyuga-san!
Dialogue: 0,0:21:02.76,0:21:05.58,Default,,0,0,0,,Kazanan Meiwa olacak!
Dialogue: 0,0:21:05.58,0:21:09.66,Default,,0,0,0,,Kimse fark etmeden takım\Nbir bütün oldu.
Dialogue: 0,0:21:09.66,0:21:14.04,Default,,0,0,0,,Takımın bel kemiği Kojiro\Netrafında kenetlenerek...
Dialogue: 0,0:21:14.04,0:21:16.92,Default,,0,0,0,,...tüm 11 oyuncu, bir kişiye dönüştü.
Dialogue: 0,0:21:16.92,0:21:22.42,Default,,0,0,0,,Meiwa FC... Bu takımın şampiyon\Nolmaması için hiçbir sebep yok.
Dialogue: 0,0:21:23.14,0:21:25.63,Default,,0,0,0,,Değil mi millet?
Dialogue: 0,0:21:25.63,0:21:26.68,Default,,0,0,0,,Hadi yapalım şunu!
Dialogue: 0,0:21:26.68,0:21:30.68,Default,,0,0,0,,Devre arası bitti ve iki takımın\Noyuncuları da sahaya çıktı.
Dialogue: 0,0:21:30.68,0:21:33.27,Default,,0,0,0,,Sadece 20 dakika kaldı.
Dialogue: 0,0:21:36.34,0:21:37.90,Default,,0,0,0,,Sadece 20 dakika.
Dialogue: 0,0:21:37.90,0:21:41.90,Default,,0,0,0,,Kazanırsam Brezilya'ya gideceğiz, Roberto.
Dialogue: 0,0:21:43.00,0:21:45.00,Default,,0,0,0,,Anne! Acele et!
Dialogue: 0,0:21:45.00,0:21:48.19,Default,,0,0,0,,Kojiro abimin maçı başladı bile!
Dialogue: 0,0:21:48.19,0:21:49.53,Default,,0,0,0,,Tamam, tamam.
Dialogue: 0,0:21:49.53,0:21:51.96,Default,,0,0,0,,İkinci yarı başlıyor.
Dialogue: 0,0:21:51.96,0:21:53.52,Default,,0,0,0,,Nankatsu bir gol önde.
Dialogue: 0,0:21:53.52,0:21:57.29,Default,,0,0,0,,Böyle devam edip şampiyonluk\Nflamasını elde edebilecekler mi?
Dialogue: 0,0:21:57.29,0:22:01.94,Default,,0,0,0,,Yoksa Meiwa ikinci yarıda durumu\Ntersine çevirip şampiyon mu olacak?
Dialogue: 0,0:22:01.94,0:22:03.90,Default,,0,0,0,,Bakın, abim!
Dialogue: 0,0:22:06.32,0:22:07.72,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:22:09.47,0:22:10.76,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:22:10.76,0:22:14.77,Default,,0,0,0,,İkinci yarıda Meiwa'nın\Ngerçek futbolunu gösterelim!
Dialogue: 0,0:22:14.77,0:22:15.82,Default,,0,0,0,,Evet!
Dialogue: 0,0:22:18.76,0:22:21.32,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:23:50.15,0:24:00.77,Default,,0,0,0,,Gelecek 24. Bölümde:\NSabır, Mutlak Sabır
Dialogue: 0,0:00:51.01,0:00:56.60,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:00:56.60,0:01:01.27,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:01:02.52,0:01:07.19,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:01:08.07,0:01:15.78,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:01:15.78,0:01:21.54,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:01:21.54,0:01:30.30,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:01:30.30,0:01:35.85,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:01:35.85,0:01:41.77,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:01:41.77,0:01:43.44,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:01:43.44,0:01:50.65,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:01:50.65,0:01:53.66,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:01:53.66,0:01:58.08,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:00:51.01,0:00:56.60,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:00:56.60,0:01:01.27,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:01:02.52,0:01:07.19,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:01:08.07,0:01:15.78,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:01:15.78,0:01:21.54,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:01:21.54,0:01:30.30,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:01:30.30,0:01:35.85,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:01:35.85,0:01:41.77,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:01:41.77,0:01:43.44,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:01:43.44,0:01:50.65,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo
Dialogue: 0,0:01:50.65,0:01:53.66,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:01:53.66,0:01:58.08,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Romaji,,0,0,0,,chotto aremi na eesu ga tooru
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Romaji,,0,0,0,,suguremono da to machijuu sawagu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Romaji,,0,0,0,,chochou sanba, jiguzagu sanba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Romaji,,0,0,0,,aitsu no uwasa de chanba mo hashiru
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Romaji,,0,0,0,,sore ni tsukete mo oretacha nan darou
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Romaji,,0,0,0,,booru hitotsu ni kirikiri mai sa
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Romaji,,0,0,0,,itsuka kimeru ze, inazuma shuuto
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Romaji,,0,0,0,,son toki ore ga suupaa hiiroo sa
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Romaji,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Türkçe,,0,0,0,,sert bakışıyla geçiyor bir yıldız
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Türkçe,,0,0,0,,tüm şehir söylüyor harika birisi olduğunu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Türkçe,,0,0,0,,kelebek sambası, zikzak samba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Türkçe,,0,0,0,,onun hakkındaki söylentiler\Nsambayı bile harekete geçiriyor
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Türkçe,,0,0,0,,onun aksine bizim burada olma sebebimiz
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Türkçe,,0,0,0,,top için delirmek
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Türkçe,,0,0,0,,bir gün şimşek gibi vuruşum hedefine ulaşacak
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Türkçe,,0,0,0,,o an bir süper kahraman olacağım işte ben
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Türkçe,,0,0,0,,alevlen ve ez geç delikanlı
