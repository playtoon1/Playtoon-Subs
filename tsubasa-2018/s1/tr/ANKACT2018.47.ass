Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:01.66,0:00:04.63,Default - i,,0,0,0,,İnanılmaz! Harika bir şuttu!
Dialogue: 0,0:00:04.63,0:00:08.48,Default - i,,0,0,0,,Bu bazı medyaların tahminde bulunduğu söylenen süper atış,
Dialogue: 0,0:00:08.48,0:00:09.73,Default - i,,0,0,0,,Tiger Shot olmalı!
Dialogue: 0,0:00:08.48,0:00:09.73,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:00:11.14,0:00:12.40,Default,,0,0,0,,Şanslıydık.
Dialogue: 0,0:00:12.81,0:00:13.77,Default - i,,0,0,0,,Lanet olsun!
Dialogue: 0,0:00:13.77,0:00:18.41,Default - i,,0,0,0,,Tsubasa'nın hareketleri dikkatimi dağıttı ve vuramadım.
Dialogue: 0,0:00:18.41,0:00:20.13,Default,,0,0,0,,Tiger Shot'un gücü hala korkutucu,
Dialogue: 0,0:00:18.41,0:00:20.13,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:00:20.13,0:00:22.21,Default,,0,0,0,,daha önce birkaç kez gördükten sonra bile...
Dialogue: 0,0:00:22.64,0:00:24.39,Default - i,,0,0,0,,Bunu yapabiliriz! Kazanabiliriz!
Dialogue: 0,0:00:24.39,0:00:26.17,Default - i,,0,0,0,,Topu Hyuga-san'a ulaştırdığımız sürece,
Dialogue: 0,0:00:26.17,0:00:27.92,Default - i,,0,0,0,,kazanacağımızdan eminim.
Dialogue: 0,0:00:30.01,0:00:50.01,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \N{\c&HB1351A&}İnstagram: AnimeSeverlerrr
Dialogue: 0,0:02:00.35,0:02:05.35,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}47. BÖLÜM: BİR KEZ DAHA KAÇINILMAZ BİR GÖSTERİ
Dialogue: 0,0:02:00.33,0:02:04.68,Default-TOP,,0,0,0,,{\i1}Nankatsu ve Toho arasındaki son maç bir patlama ile başladı!{\i0}
Dialogue: 0,0:02:04.68,0:02:06.68,Default-TOP,,0,0,0,,{\i1}Şimdi top değiştiriliyor.{\i0}
Dialogue: 0,0:02:07.50,0:02:10.67,Default,,0,0,0,,Topu patlatacak güç ve hız...
Dialogue: 0,0:02:10.67,0:02:12.18,Default,,0,0,0,,Demek bu Tiger Shot.
Dialogue: 0,0:02:10.67,0:02:12.18,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:02:12.18,0:02:15.08,Default,,0,0,0,,Kim Hyuga’nın harika bir şuta sahip olduğunu düşünürdü ki...
Dialogue: 0,0:02:15.08,0:02:16.70,Default,,0,0,0,,Neden bahsediyorsunuz millet?
Dialogue: 0,0:02:17.07,0:02:18.76,Default,,0,0,0,,Biz Tsubasa'ya sahi—
Dialogue: 0,0:02:21.25,0:02:24.04,Default,,0,0,0,,Hayır... Bu final maçında, biz...
Dialogue: 0,0:02:24.04,0:02:26.54,Default,,0,0,0,,Elimizden gelenin en iyisini yapmalıyız!
Dialogue: 0,0:02:26.54,0:02:29.29,Default,,0,0,0,,Eğer ruhlarımız bocalarsa, Toho'yu yenemeyiz!
Dialogue: 0,0:02:30.03,0:02:32.36,Default,,0,0,0,,Evet, Ishizaki haklı!
Dialogue: 0,0:02:32.36,0:02:35.17,Default,,0,0,0,,Haklısın. Elimizden gelenin en iyisini yapmalıyız!
Dialogue: 0,0:02:35.17,0:02:35.88,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:02:35.88,0:02:39.81,Default,,0,0,0,,İlk golü atmalı ve Tsubasa'nın \Nomuzlarından biraz yük almalıyız!
Dialogue: 0,0:02:39.81,0:02:40.68,Default,,0,0,0,,Evet!
Dialogue: 0,0:02:41.23,0:02:42.51,Default - i,,0,0,0,,Millet...
Dialogue: 0,0:02:42.90,0:02:44.77,Default - i,,0,0,0,,İstediğin kadar gel Nankatsu.
Dialogue: 0,0:02:44.77,0:02:47.26,Default - i,,0,0,0,,Hyuga-san'ı ne kadar yakından takip ederseniz edin,
Dialogue: 0,0:02:47.26,0:02:50.23,Default - i,,0,0,0,,sıyrılıp paslarımın ona ulaştığından emin olacağım!
Dialogue: 0,0:02:53.48,0:02:54.94,Default,,0,0,0,,Geliyoruz, Tsubasa!
Dialogue: 0,0:02:56.07,0:02:59.28,Default - i,,0,0,0,,Tiger Shot Tsubasa-kun'nun dövüş ruhunu ateşledi!
Dialogue: 0,0:02:56.07,0:02:59.28,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:02:59.28,0:03:03.03,Default - i,,0,0,0,,Tsubasa-kun, Toho'nun alanına dinç bir şekilde yaklaştı!
Dialogue: 0,0:03:03.95,0:03:05.54,Default - i,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:08.58,0:03:12.41,Default - i,,0,0,0,,İşte bu turnuva sırasında daha da güçlenen, Nankatsu'nun
Dialogue: 0,0:03:12.41,0:03:17.67,Default - i,,0,0,0,,eski Shutetsu Üçlüsü, Izawa-kun, \NTaki-kun ve Kisugi-kun'dan bir saldırı.
Dialogue: 0,0:03:18.36,0:03:19.86,Default,,0,0,0,,Bu son maçta...
Dialogue: 0,0:03:19.86,0:03:21.93,Default,,0,0,0,,Tüm işi Tsubasa'ya yükleyemeyiz.
Dialogue: 0,0:03:21.93,0:03:23.81,Default,,0,0,0,,Bunu yapmak zorundayız!
Dialogue: 0,0:03:23.81,0:03:25.14,Default,,0,0,0,,Gidelim Toho!
Dialogue: 0,0:03:25.14,0:03:30.39,Default - i,,0,0,0,,Lanet olsun! Beklendiği gibi, Tsubasa'nın saldırıları çok akıcı!
Dialogue: 0,0:03:30.39,0:03:32.39,Default,,0,0,0,,Kaptan! Lütfen buraya gelme!
Dialogue: 0,0:03:32.39,0:03:35.15,Default,,0,0,0,,Bu saldırıyı kendimiz durduracağız!
Dialogue: 0,0:03:35.15,0:03:35.77,Default,,0,0,0,,Millet!
Dialogue: 0,0:03:35.77,0:03:37.43,Default - i,,0,0,0,,Nankatsu saldırıyor!
Dialogue: 0,0:03:37.43,0:03:40.40,Default - i,,0,0,0,,Ancak, Toho'nun kalesinin önünde savunması yenilmez!
Dialogue: 0,0:03:40.40,0:03:41.91,Default,,0,0,0,,Sanki şut çekemene izin veririm!
Dialogue: 0,0:03:42.49,0:03:43.49,Default,,0,0,0,,Izawa!
Dialogue: 0,0:03:43.49,0:03:45.99,Default - i,,0,0,0,,Top Izawa-kun'a geri döndü!
Dialogue: 0,0:03:46.95,0:03:47.97,Default,,0,0,0,,Şut çekecek!
Dialogue: 0,0:03:47.97,0:03:49.06,Default,,0,0,0,,Durduracağız!
Dialogue: 0,0:03:49.06,0:03:50.50,Default,,0,0,0,,Bırakın şut çeksin!
Dialogue: 0,0:03:50.50,0:03:53.50,Default,,0,0,0,,O kadar uzaktaysa, bir fark yaratmaz!
Dialogue: 0,0:03:53.50,0:03:54.25,Default,,0,0,0,,Ne—
Dialogue: 0,0:03:54.25,0:03:55.25,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:03:55.25,0:03:57.59,Default,,0,0,0,,Lanet olsun! Beni aptal yerine mi koyuyorsun?
Dialogue: 0,0:03:57.59,0:03:58.17,Default,,0,0,0,,Hadi!
Dialogue: 0,0:03:58.17,0:03:59.17,Default,,0,0,0,,Izawa!
Dialogue: 0,0:03:59.17,0:04:01.09,Default,,0,0,0,,Bırak şut çekeyim!
Dialogue: 0,0:04:01.09,0:04:01.97,Default - i,,0,0,0,,Ishizaki!
Dialogue: 0,0:04:01.97,0:04:04.26,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:04:04.26,0:04:07.54,Default - i,,0,0,0,,Izawa-kun şut çekecek gibi göründü, ama işte Ishizaki-kun'dan bir atış!
Dialogue: 0,0:04:07.54,0:04:10.02,Default,,0,0,0,,Nankatsu'yu küçük görmeye cüret etme!
Dialogue: 0,0:04:10.52,0:04:12.77,Default - i,,0,0,0,,Wakashimazu-kun'nun bir an için dikkati dağıldı!
Dialogue: 0,0:04:13.81,0:04:17.67,Default - i,,0,0,0,,Yine de, Wakashimazu-kun Ishizaki-kun'nun kalenin köşesine
Dialogue: 0,0:04:17.67,0:04:21.53,Default - i,,0,0,0,,doğru attığı şutu mükemmel bir şekilde yakalamayı başarıyor!
Dialogue: 0,0:04:21.53,0:04:23.03,Default,,0,0,0,,İyi iş, Wakashimazu!
Dialogue: 0,0:04:23.03,0:04:23.78,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:04:23.78,0:04:25.37,Default,,0,0,0,,Yakındı, Ishizaki!
Dialogue: 0,0:04:27.26,0:04:31.35,Default - i,,0,0,0,,Sadece Tsubasa değil, Nankatsu'nun geri kalanınada gardımı indiremem...
Dialogue: 0,0:04:31.35,0:04:34.71,Default - i,,0,0,0,,Wakashimazu, sana sahip\N olduğumuz sürece endişelenmiyorum.
Dialogue: 0,0:04:34.71,0:04:36.53,Default - i,,0,0,0,,Şimdi benim sıram.
Dialogue: 0,0:04:36.53,0:04:39.75,Default - i,,0,0,0,,Golümü Tiger Shot ile atacağım!
Dialogue: 0,0:04:36.53,0:04:39.75,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:04:39.75,0:04:43.62,Default - i,,0,0,0,,Başkasına karşı, bu şut gol olurdu.
Dialogue: 0,0:04:43.62,0:04:46.64,Default - i,,0,0,0,,Wakashimazu-kun'nun sıradan bir kaleci olmadığı doğru.
Dialogue: 0,0:04:46.64,0:04:51.35,Default - i,,0,0,0,,Bacağım hala iyi iken, bizi bir Drive Shot ile öne geçirmeliyim...
Dialogue: 0,0:04:46.64,0:04:51.35,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:04:51.35,0:04:57.22,Default - i,,0,0,0,,Hyuga-kun, Tsubasa-kun için gerçekten ebedi bir rakip olabilir.
Dialogue: 0,0:04:57.22,0:05:00.46,Default - i,,0,0,0,,Çünkü, gördüğüm gibi, ona karşı her oynadığında,
Dialogue: 0,0:05:00.46,0:05:02.86,Default - i,,0,0,0,,Tsubasa-kun parlıyor.
Dialogue: 0,0:05:02.86,0:05:03.95,Default,,0,0,0,,İşte!
Dialogue: 0,0:05:03.95,0:05:06.52,Default - i,,0,0,0,,Toho topu orta saha bölgesinde paslaşıyor.
Dialogue: 0,0:05:06.52,0:05:08.45,Default - i,,0,0,0,,Elbette, Tiger Shot ile donanmış, turnuvada
Dialogue: 0,0:05:08.45,0:05:12.62,Default - i,,0,0,0,,oynamaya geri dönen Hyuga'ya götürmeye çalışacaklar.
Dialogue: 0,0:05:12.62,0:05:14.62,Default,,0,0,0,,Hyuga'yı iyice tutun!
Dialogue: 0,0:05:14.62,0:05:15.50,Default,,0,0,0,,Tamam!
Dialogue: 0,0:05:15.50,0:05:19.25,Default - i,,0,0,0,,Top birinci sınıf oyun kurucu Sawada-kun'a gönderildi!
Dialogue: 0,0:05:19.25,0:05:21.67,Default - i,,0,0,0,,Ne olursa olsun, Hyuga-san’a pas atmam gerekiyor!
Dialogue: 0,0:05:22.13,0:05:25.59,Default - i,,0,0,0,,Sawada-kun'u tutmaya gelen, Tsubasa-kun'dan başkası değil!
Dialogue: 0,0:05:25.59,0:05:26.80,Default,,0,0,0,,Tsubasa-san!
Dialogue: 0,0:05:26.80,0:05:29.56,Default - i,,0,0,0,,Hyuga-kun'nun Tiger Shot'unu kullanmasını engellemek için
Dialogue: 0,0:05:26.80,0:05:29.56,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:05:29.56,0:05:31.40,Default - i,,0,0,0,,önce Takeshi'yi durduracağım.
Dialogue: 0,0:05:31.40,0:05:34.73,Default,,0,0,0,,Orta sahada iki kontrol kulesi arasında bir gösteri!
Dialogue: 0,0:05:34.73,0:05:36.31,Default,,0,0,0,,Aynen benim maçımdaki gibi!
Dialogue: 0,0:05:36.31,0:05:40.90,Default - i,,0,0,0,,Futbolda, orta sahayı yöneten, \Nmaçı kendi avantajlarına çevirebilir.
Dialogue: 0,0:05:40.90,0:05:44.19,Default - i,,0,0,0,,Tsubasa-san, bu prensibi takip ederek bu kadar ileri gitti.
Dialogue: 0,0:05:44.19,0:05:45.45,Default,,0,0,0,,Geliyorum Takeshi!
Dialogue: 0,0:05:46.07,0:05:48.45,Default,,0,0,0,,Topu bana gönder, Takeshi!
Dialogue: 0,0:05:48.45,0:05:50.09,Default,,0,0,0,,Koike senpai!
Dialogue: 0,0:05:51.20,0:05:54.79,Default - i,,0,0,0,,Oyun kurucu olarak Tsubasa-san benim idolüm!
Dialogue: 0,0:05:54.79,0:05:55.83,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:05:55.83,0:05:57.54,Default,,0,0,0,,Lütfen,
Dialogue: 0,0:05:57.54,0:05:59.50,Default,,0,0,0,,şimdi ona karşı çıkmama izin ver!
Dialogue: 0,0:05:59.50,0:06:02.25,Default,,0,0,0,,Sawada-kun Tsubasa-kun ile yüzleşiyor!
Dialogue: 0,0:06:02.25,0:06:02.92,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:06:02.92,0:06:07.01,Default - i,,0,0,0,,Izawa-kun kayarak ilerler ve düelloyu kısa keser!
Dialogue: 0,0:06:07.01,0:06:07.84,Default,,0,0,0,,Ne?!
Dialogue: 0,0:06:07.84,0:06:09.34,Default,,0,0,0,,İyi, Izawa!
Dialogue: 0,0:06:09.34,0:06:11.89,Default - i,,0,0,0,,Nankatsu'nun Shutetsu Üçlüsü saldırısı!
Dialogue: 0,0:06:11.89,0:06:13.26,Default - i,,0,0,0,,İzawa-kun ilerlerken
Dialogue: 0,0:06:13.26,0:06:14.39,Default - i,,0,0,0,,sağ tarafında Taki-kun
Dialogue: 0,0:06:14.39,0:06:16.18,Default - i,,0,0,0,,ve solunda Kisugi-kun var.
Dialogue: 0,0:06:16.18,0:06:17.94,Default - i,,0,0,0,,Kime pas gönderecek?
Dialogue: 0,0:06:17.94,0:06:18.72,Default,,0,0,0,,İzin vermeyeceğiz!
Dialogue: 0,0:06:18.72,0:06:19.19,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:21.06,0:06:22.32,Default,,0,0,0,,Izawa, buraya!
Dialogue: 0,0:06:22.75,0:06:23.57,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:06:23.57,0:06:24.64,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:24.64,0:06:26.07,Default - i,,0,0,0,,Izawa-kun topu geri gönderdi!
Dialogue: 0,0:06:26.07,0:06:26.99,Default - i,,0,0,0,,Ve...
Dialogue: 0,0:06:26.99,0:06:29.57,Default - i,,0,0,0,,Top Tsubasa-kun'a ulaşıyor!
Dialogue: 0,0:06:29.57,0:06:31.82,Default - i,,0,0,0,,Bunu herkes için yapacağım!
Dialogue: 0,0:06:31.82,0:06:33.12,Default,,0,0,0,,Tsubasa senpai!
Dialogue: 0,0:06:34.22,0:06:34.99,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:06:35.41,0:06:36.45,Default,,0,0,0,,Git!
Dialogue: 0,0:06:36.84,0:06:38.71,Default,,0,0,0,,{\bord0\blur0.6\c&HFFF069&\4a&HFF&}Drive Shot!
Dialogue: 0,0:06:36.84,0:06:38.71,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:38.71,0:06:39.81,Default - i,,0,0,0,,İşte burada!
Dialogue: 0,0:06:39.81,0:06:43.17,Default - i,,0,0,0,,Bu sefer ki Tsubasa-kun'nun süper atışı, Drive Shot!
Dialogue: 0,0:06:39.81,0:06:43.17,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:43.17,0:06:44.09,Default - i,,0,0,0,,İşte geliyor!
Dialogue: 0,0:06:44.09,0:06:45.30,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:06:50.02,0:06:52.26,Default - i,,0,0,0,,Demek bu Tsubasa'nın Drive Shot'u!
Dialogue: 0,0:06:50.02,0:06:52.26,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:52.26,0:06:54.51,Default - i,,0,0,0,,İlk kez doğrudan göreceğim.
Dialogue: 0,0:06:54.51,0:06:59.27,Default - i,,0,0,0,,Kaleci Wakashimazu-kun, Drive Shot'a karşı harekete geçti.
Dialogue: 0,0:06:54.51,0:06:59.27,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:07:02.03,0:07:03.90,Default - i,,0,0,0,,Ama ulaşamıyor!
Dialogue: 0,0:07:05.87,0:07:08.32,Default - i,,0,0,0,,Kale direğine çarpınca top patlıyor!
Dialogue: 0,0:07:08.32,0:07:11.07,Default - i,,0,0,0,,Bu, Tiger Shot ile tanık olduğumuz şey!
Dialogue: 0,0:07:08.32,0:07:11.07,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:07:11.07,0:07:14.24,Default - i,,0,0,0,,Drive Shot'un arkasındaki güç delice!
Dialogue: 0,0:07:11.07,0:07:17.00,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:07:14.24,0:07:17.00,Default - i,,0,0,0,,Drive Shot'umu istediğim kadar kullanamam. Oysa...
Dialogue: 0,0:07:17.00,0:07:18.77,Default,,0,0,0,,İ-İnanılmaz...
Dialogue: 0,0:07:18.77,0:07:22.33,Default,,0,0,0,,Tsubasa'nın Drive Shot da dikkat edilmesi gereken bir şey.
Dialogue: 0,0:07:18.77,0:07:22.33,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:07:22.33,0:07:25.67,Default - i,,0,0,0,,Hızı kaptanımızın Tiger Shot'uyla aynıydı...
Dialogue: 0,0:07:22.33,0:07:25.67,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:07:25.67,0:07:27.51,Default - i,,0,0,0,,Hedefe uçuyor, sonra düşüyor.
Dialogue: 0,0:07:27.51,0:07:30.43,Default - i,,0,0,0,,Hayır... Sadece düşmüyor.
Dialogue: 0,0:07:30.43,0:07:31.68,Default - i,,0,0,0,,Dalıyor.
Dialogue: 0,0:07:31.68,0:07:33.68,Default - i,,0,0,0,,Sanki top aşağı dalmayı hedefliyor.
Dialogue: 0,0:07:36.50,0:07:39.68,Default - i,,0,0,0,,Her iki takım da baştan sona acımasızca saldırdı ve savundu!
Dialogue: 0,0:07:39.68,0:07:43.70,Default - i,,0,0,0,,Ve bu savaşta, Hyuga-kun'nun Tiger \NShot'uyla ortaokul seviyesini aşan
Dialogue: 0,0:07:39.68,0:07:43.70,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:07:43.70,0:07:47.15,Default - i,,0,0,0,,Tsubasa-kun'nun Drive Shot'u \Narasındaki gösteri oldukça nefes kesici!
Dialogue: 0,0:07:43.70,0:07:47.15,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:07:47.15,0:07:49.53,Default,,0,0,0,,İyi oynadı Toho.
Dialogue: 0,0:07:49.53,0:07:52.03,Default,,0,0,0,,Nankatsu gerçekten dikkate alınması gereken bir güç...
Dialogue: 0,0:07:52.03,0:07:54.52,Default - i,,0,0,0,,İlk yarı da sadece 5 dakika geçti.
Dialogue: 0,0:07:54.52,0:07:57.54,Default - i,,0,0,0,,Her iki takım da şu ana kadar eşit seviyede görünüyor.
Dialogue: 0,0:07:57.54,0:08:00.01,Default,,0,0,0,,Çok yakındı, Tsubasa!
Dialogue: 0,0:08:00.01,0:08:00.54,Default,,0,0,0,,Evet.
Dialogue: 0,0:08:00.54,0:08:02.92,Default,,0,0,0,,İyi misin Wakashimazu?
Dialogue: 0,0:08:02.92,0:08:03.88,Default,,0,0,0,,Millet...
Dialogue: 0,0:08:03.88,0:08:07.23,Default,,0,0,0,,Drive Shot'u durdurmak için bir ipucu bulmuş olabilirim.
Dialogue: 0,0:08:03.88,0:08:07.23,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:07.69,0:08:09.17,Default,,0,0,0,,Wakashimazu-san?!
Dialogue: 0,0:08:09.76,0:08:11.09,Default,,0,0,0,,Wakashimazu...
Dialogue: 0,0:08:12.52,0:08:13.72,Default - i,,0,0,0,,Kaptan!
Dialogue: 0,0:08:13.72,0:08:16.72,Default - i,,0,0,0,,Lütfen benim için bir Tiger Shot daha at!
Dialogue: 0,0:08:13.72,0:08:16.72,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:08:16.72,0:08:20.12,Default - i,,0,0,0,,Finalde Tsubasa'nın Drive Shot'una\N karşı bir önlem olarak işe yarayacak.
Dialogue: 0,0:08:16.72,0:08:20.12,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:20.12,0:08:22.00,Default - i,,0,0,0,,Lütfen!
Dialogue: 0,0:08:22.00,0:08:25.38,Default - i,,0,0,0,,Atışımda hiç dönüş yok, biliyorsun.
Dialogue: 0,0:08:25.38,0:08:28.90,Default - i,,0,0,0,,Ama bence hız ve güç birbirine benziyor.
Dialogue: 0,0:08:30.36,0:08:31.90,Default - i,,0,0,0,,Lütfen!
Dialogue: 0,0:08:32.72,0:08:34.78,Default - i,,0,0,0,,Tamam, anladım!
Dialogue: 0,0:08:41.41,0:08:42.93,Default - i,,0,0,0,,Lanet olsun...
Dialogue: 0,0:08:42.93,0:08:44.33,Default - i,,0,0,0,,Yani sonuçta yapamam...
Dialogue: 0,0:08:44.33,0:08:46.13,Default - i,,0,0,0,,Tamam! Bir kez daha!
Dialogue: 0,0:08:46.13,0:08:47.88,Default - i,,0,0,0,,Geliyorum!
Dialogue: 0,0:08:53.05,0:08:56.26,Default - i,,0,0,0,,{\t(2193,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Hepsi kaptanla olan özel antrenmanım sayesinde...
Dialogue: 0,0:08:56.39,0:08:57.72,Default,,0,0,0,,Onu durduracağım!
Dialogue: 0,0:08:57.72,0:09:02.14,Default,,0,0,0,,Ben, Ken Wakashimazu, Tsubasa \NOzora'nın Drive Shot'unu durduracağım!
Dialogue: 0,0:08:57.72,0:09:02.14,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:09:02.14,0:09:05.34,Default,,0,0,0,,Yani çocuklar, her zaman olduğu gibi, 
Dialogue: 0,0:09:05.34,0:09:06.48,Default,,0,0,0,,oyuna tüm ruhunuzu katın!
Dialogue: 0,0:09:06.48,0:09:07.69,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:08.45,0:09:11.19,Default - i,,0,0,0,,Wakashimazu her zaman çok sakindi.
Dialogue: 0,0:09:11.19,0:09:16.49,Default - i,,0,0,0,,Ben oynamazken, Toho'yu bir araya getirdin.
Dialogue: 0,0:09:16.49,0:09:19.62,Default - i,,0,0,0,,Hayır, sadece Wakashimazu değildi.
Dialogue: 0,0:09:19.62,0:09:21.12,Default - i,,0,0,0,,Kaptan! Lütfen buraya gelme!
Dialogue: 0,0:09:21.64,0:09:23.87,Default - i,,0,0,0,,Bu saldırıyı kendimiz durduracağız!
Dialogue: 0,0:09:23.87,0:09:25.92,Default - i,,0,0,0,,{\t(1529,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Şimdi ona karşı çıkmama izin ver!
Dialogue: 0,0:09:26.54,0:09:29.86,Default - i,,0,0,0,,Hepiniz çok büyüdünüz...!
Dialogue: 0,0:09:30.92,0:09:33.92,Default - i,,0,0,0,,Oyun yeni bir topla devam ediyor.
Dialogue: 0,0:09:34.38,0:09:38.59,Default - i,,0,0,0,,Hyuga-kun Nankatsu'nun kalesinden ayrıldı ve orta sahaya geri döndü.
Dialogue: 0,0:09:38.59,0:09:39.39,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:09:40.10,0:09:41.60,Default - i,,0,0,0,,Koçun dediği gibi.
Dialogue: 0,0:09:41.60,0:09:45.18,Default - i,,0,0,0,,Bencilce ekibimden ayrıldığım için büyük bir sorumluluk taşıyorum.
Dialogue: 0,0:09:45.18,0:09:47.79,Default - i,,0,0,0,,Burada kendi yolunu kazanmaya çalışan herkes için,
Dialogue: 0,0:09:47.79,0:09:51.61,Default - i,,0,0,0,,Ben, Kojiro Hyuga, ilk golü atacağım!
Dialogue: 0,0:09:51.61,0:09:53.52,Default,,0,0,0,,Bana gönder, Wakashimazu!
Dialogue: 0,0:09:53.52,0:09:54.49,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:09:54.49,0:09:55.99,Default,,0,0,0,,Pekala!
Dialogue: 0,0:09:57.24,0:09:58.91,Default - i,,0,0,0,,Top Hyuga-kun'a gidiyor!
Dialogue: 0,0:09:58.91,0:10:01.83,Default - i,,0,0,0,,Orta sahadaki oyun kurucu rolünü üstlenmeye mi niyetli?
Dialogue: 0,0:10:01.83,0:10:02.95,Default,,0,0,0,,Hyuga-san...?
Dialogue: 0,0:10:05.96,0:10:07.26,Default,,0,0,0,,Tutun!
Dialogue: 0,0:10:07.26,0:10:09.96,Default,,0,0,0,,O kadar uzakta bile olsa bir Tiger Shot atabilir!
Dialogue: 0,0:10:07.26,0:10:09.96,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:10:11.03,0:10:13.01,Default,,0,0,0,,Beni burada tutarsanız, kalenizin önü
Dialogue: 0,0:10:13.01,0:10:14.80,Default,,0,0,0,,korunmasız kalacaktır.
Dialogue: 0,0:10:15.67,0:10:17.95,Default,,0,0,0,,Geri çekilin, Ishizaki, Nakazato!
Dialogue: 0,0:10:17.95,0:10:20.22,Default,,0,0,0,,Hyuga'yı orta sahada tutacağız!
Dialogue: 0,0:10:20.22,0:10:21.60,Default,,0,0,0,,T-Tamam!
Dialogue: 0,0:10:22.47,0:10:23.40,Default,,0,0,0,,Şimdi!
Dialogue: 0,0:10:23.40,0:10:25.98,Default - i,,0,0,0,,Tutulmadan önce, Hyuga-kun bir pas gönderiyor!
Dialogue: 0,0:10:25.98,0:10:28.03,Default - i,,0,0,0,,Fakat ön tarafta kimse yok...?
Dialogue: 0,0:10:28.03,0:10:30.30,Default - i,,0,0,0,,Ah! Sawada-kun orada!
Dialogue: 0,0:10:30.30,0:10:33.90,Default - i,,0,0,0,,Orta saha oyuncusu Sawada-kun forvet pozisyonunda koşuyor!
Dialogue: 0,0:10:33.90,0:10:34.94,Default,,0,0,0,,Hyuga...
Dialogue: 0,0:10:34.94,0:10:37.78,Default - i,,0,0,0,,Hyuga-kun ve Sawada-kun yerlerini değiştirdiler.
Dialogue: 0,0:10:37.78,0:10:38.68,Default,,0,0,0,,Bu kötü görünüyor!
Dialogue: 0,0:10:38.68,0:10:39.57,Default,,0,0,0,,Geri çekilin!
Dialogue: 0,0:10:39.57,0:10:43.28,Default - i,,0,0,0,,Orta saha oyuncusu Kojiro Hyuga, ha...
Dialogue: 0,0:10:43.95,0:10:47.71,Default - i,,0,0,0,,Bu uzun atış Tiger Shot da ustalaşması sayesinde,
Dialogue: 0,0:10:43.95,0:10:47.71,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:10:47.71,0:10:50.61,Default - i,,0,0,0,,orta sahadayken bile tutularak diğer
Dialogue: 0,0:10:50.61,0:10:53.54,Default - i,,0,0,0,,oyuncuların serbest kalmasına izin veriyor.
Dialogue: 0,0:10:53.54,0:10:55.67,Default,,0,0,0,,Tamam! Geliyorum!
Dialogue: 0,0:10:56.42,0:11:00.10,Default - i,,0,0,0,,Tsubasa-kun, Sawada-kun'u tutmaya gidiyor!
Dialogue: 0,0:11:01.14,0:11:04.64,Default - i,,0,0,0,,Toho'nun pozisyonlarını değiştirme planını gördü mü?
Dialogue: 0,0:11:04.64,0:11:06.59,Default,,0,0,0,,Harikasın, Tsubasa!
Dialogue: 0,0:11:06.59,0:11:08.14,Default,,0,0,0,,Aferin ,Futbol Çocuğu!
Dialogue: 0,0:11:08.62,0:11:09.69,Default,,0,0,0,,Tsubasa-san...
Dialogue: 0,0:11:11.40,0:11:12.06,Default,,0,0,0,,Şimdi!
Dialogue: 0,0:11:12.52,0:11:15.21,Default - i,,0,0,0,,Sawada-kun ile Toho'nun ikinci forveti Sorimachi-kun
Dialogue: 0,0:11:15.21,0:11:17.90,Default - i,,0,0,0,,arasında mükemmel bir şekilde koordine edilmiş bir oyun!
Dialogue: 0,0:11:17.90,0:11:19.65,Default,,0,0,0,,Tamamdır! Devam et, Sorimachi!
Dialogue: 0,0:11:19.65,0:11:21.45,Default - i,,0,0,0,,Sorimachi-kun şut atıyor!
Dialogue: 0,0:11:23.57,0:11:26.83,Default - i,,0,0,0,,Fakat Morisaki-kun, yana doğru zıplayarak onu uzaklaştırıyor!
Dialogue: 0,0:11:26.83,0:11:28.20,Default,,0,0,0,,İyi, Morisaki!
Dialogue: 0,0:11:28.81,0:11:31.37,Default - i,,0,0,0,,Toho kıl payı puan kazanma şansını kaçırdı!
Dialogue: 0,0:11:31.37,0:11:35.51,Default - i,,0,0,0,,Izawa-kun ve Hyuga-kun topun peşinden koşuyor.
Dialogue: 0,0:11:35.51,0:11:36.09,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:37.26,0:11:38.01,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:11:38.01,0:11:39.38,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:11:39.38,0:11:40.41,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:11:40.41,0:11:42.18,Default - i,,0,0,0,,Top Hyuga'nın!
Dialogue: 0,0:11:42.18,0:11:44.05,Default - i,,0,0,0,,Yan çizgi de ilerliyor.
Dialogue: 0,0:11:44.05,0:11:44.80,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:11:44.80,0:11:45.72,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:11:45.72,0:11:48.28,Default - i,,0,0,0,,Sawada ve Sorimachi kalenin önüne geçti!
Dialogue: 0,0:11:48.28,0:11:50.52,Default - i,,0,0,0,,Topu kime gönderecek?
Dialogue: 0,0:11:54.02,0:11:55.06,Default - i,,0,0,0,,Görebiliyorum!
Dialogue: 0,0:11:55.06,0:11:56.26,Default - i,,0,0,0,,Bunu ye!
Dialogue: 0,0:11:56.26,0:11:59.57,Default - i,,0,0,0,,{\bord0\blur0.6\c&HFFFFDC&\c&H00AEFF&}Ti{\c&H00BFFF&}g{\c&H00CBFF&}e{\c&H00D8FF&}r{\c&H00E9FF&} S{\c&H00F7FF&}h{\c&H00D8FF&}o{\c&H00CBFF&}t{\c&H00AEFF&}!
Dialogue: 0,0:11:56.26,0:11:59.57,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:12:04.52,0:12:06.06,Default - i,,0,0,0,,İçerde!
Dialogue: 0,0:12:06.06,0:12:08.75,Default - i,,0,0,0,,Nankatsu bir kasını bile kıpırdatamadı!
Dialogue: 0,0:12:08.75,0:12:09.50,Default,,0,0,0,,Budur!
Dialogue: 0,0:12:09.50,0:12:12.83,Default - i,,0,0,0,,Hyuga-kun açılı bir şutla doğrudan golü attı!
Dialogue: 0,0:12:12.83,0:12:18.73,Default - i,,0,0,0,,Bugünkü ikinci Tiger Shot ile Toho Akademi skoru açtı!
Dialogue: 0,0:12:12.83,0:12:18.73,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:12:22.76,0:12:27.76,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:12:29.22,0:12:32.27,Default - i,,0,0,0,,Ulusal Ortaokul Futbol turnuvasında büyük finalde,
Dialogue: 0,0:12:32.27,0:12:34.24,Default - i,,0,0,0,,Toho Akademi skoru açtı!
Dialogue: 0,0:12:34.24,0:12:37.19,Default - i,,0,0,0,,Aynı zamanda bu Hyuga-kun'nun turnuvadaki ilk golü!
Dialogue: 0,0:12:37.19,0:12:39.32,Default,,0,0,0,,Başardık! İlk gol bizimdir!
Dialogue: 0,0:12:39.32,0:12:40.86,Default,,0,0,0,,Başardı! Başardı!
Dialogue: 0,0:12:40.86,0:12:43.07,Default,,0,0,0,,Abim başardı!
Dialogue: 0,0:12:44.23,0:12:45.70,Default - i,,0,0,0,,Kojiro...
Dialogue: 0,0:12:45.70,0:12:47.25,Default-TOP,,0,0,0,,Başardık!
Dialogue: 0,0:12:47.25,0:12:49.16,Default-TOP,,0,0,0,,Başardın, Hyuga-san!
Dialogue: 0,0:12:49.78,0:12:51.33,Default,,0,0,0,,Kaptanımızdan beklendiği gibi.
Dialogue: 0,0:12:51.33,0:12:55.08,Default,,0,0,0,,Herhangi bir açıklık olsa bile gol atabilir.
Dialogue: 0,0:12:55.08,0:12:59.34,Default,,0,0,0,,Güçlü bir düz atış, Kojiro Hyuga'nın Tiger Shot'nun özü budur.
Dialogue: 0,0:12:55.08,0:13:04.80,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:12:59.97,0:13:04.80,Default - i,,0,0,0,,Işık kadar hızlı batan bir kaplanın dişi. Tiger Shot...
Dialogue: 0,0:13:06.14,0:13:09.51,Default - i,,0,0,0,,Gerçekten, bu Kojiro için uygun bir hareket.
Dialogue: 0,0:13:10.15,0:13:12.27,Default - i,,0,0,0,,Takımla bir süre oynamamasına rağmen,
Dialogue: 0,0:13:12.80,0:13:15.39,Default - i,,0,0,0,,takım çalışmasına kolayca girebildi.
Dialogue: 0,0:13:15.39,0:13:18.27,Default,,0,0,0,,Millet, bir kere gol attığımız için gardınızı düşürmeyin.
Dialogue: 0,0:13:18.27,0:13:20.05,Default,,0,0,0,,Gerçek maç şimdi başlıyor.
Dialogue: 0,0:13:20.05,0:13:20.90,Default,,0,0,0,,Tamam!
Dialogue: 0,0:13:20.90,0:13:23.09,Default - i,,0,0,0,,Belki de gerekçelerime rağmen,
Dialogue: 0,0:13:23.09,0:13:27.28,Default - i,,0,0,0,,ekibin gerçekten de Kojiro Hyuga'ya ihtiyacı vardı.
Dialogue: 0,0:13:28.52,0:13:30.49,Default,,0,0,0,,Bir adım bile hareket edemedim.
Dialogue: 0,0:13:30.49,0:13:33.75,Default,,0,0,0,,Üzgünüm, bu sadece onun açılmasına izin verdiğim için oldu.
Dialogue: 0,0:13:34.20,0:13:37.46,Default,,0,0,0,,Tiger Shot gerçekten harika bir atış.
Dialogue: 0,0:13:34.20,0:13:37.46,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:13:37.46,0:13:38.38,Default,,0,0,0,,Tsubasa...!
Dialogue: 0,0:13:38.38,0:13:41.38,Default,,0,0,0,,Tekrar kullanmasını önlemek için her şeyi yapmalıyız.
Dialogue: 0,0:13:41.95,0:13:44.04,Default,,0,0,0,,Hyuga-kun'nun serbest kalmasına izin vermeyeceğiz.
Dialogue: 0,0:13:44.04,0:13:47.46,Default,,0,0,0,,Ayrıca, gerektiği gibi, orta saha \Noyuncusu orta sahadayken onu tutmalı,
Dialogue: 0,0:13:47.46,0:13:49.36,Default,,0,0,0,,savunucular ise arkadan tutmalıdır.
Dialogue: 0,0:13:50.39,0:13:53.02,Default,,0,0,0,,Tamam, hadi kendimizi toplayalım ve misilleme yapalım!
Dialogue: 0,0:13:53.02,0:13:53.89,Default,,0,0,0,,TAMAM!
Dialogue: 0,0:13:59.84,0:14:01.65,Default - i,,0,0,0,,Geliyorum, Hyuga-kun.
Dialogue: 0,0:14:01.65,0:14:03.80,Default - i,,0,0,0,,Kendi Drive Shot'umu kullanarak Tiger Shot
Dialogue: 0,0:14:03.80,0:14:05.95,Default - i,,0,0,0,,ile attığın golü geri iade edeceğim.
Dialogue: 0,0:14:01.65,0:14:05.95,Default-TOP,,0,0,0,,{\fs70}Tiger Shot: Kaplan Vuruşu \NDrive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:14:07.20,0:14:09.12,Default - i,,0,0,0,,Maç devam ediyor!
Dialogue: 0,0:14:09.12,0:14:11.59,Default,,0,0,0,,Millet, tezahürat en çok geride kaldığımızda önemlidir!
Dialogue: 0,0:14:11.59,0:14:13.21,Default,,0,0,0,,Hadi yüksek sesle yapalım!
Dialogue: 0,0:14:13.21,0:14:15.68,Default,,0,0,0,,Tamam! Elinden geleni yap, Nankatsu!
Dialogue: 0,0:14:15.68,0:14:19.00,Default,,0,0,0,,Maç şimdi başlıyor! Size güveniyoruz çocuklar!
Dialogue: 0,0:14:19.00,0:14:21.69,Default - i,,0,0,0,,Otomo'lu çocuklar, farklı bir okuldan olmasına rağmen, 
Dialogue: 0,0:14:21.69,0:14:24.13,Default - i,,0,0,0,,baştan beri bizi neşelendiriyorlar...
Dialogue: 0,0:14:24.42,0:14:27.78,Default - i,,0,0,0,,{\t(3114,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Şimdiye kadar yaptığınız her şey için teşekkür ederim.
Dialogue: 0,0:14:27.97,0:14:30.47,Default,,0,0,0,,Biraz göstermeliyiz, sence de değil mi...?
Dialogue: 0,0:14:30.47,0:14:31.22,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:14:31.22,0:14:32.10,Default,,0,0,0,,Al hadi!
Dialogue: 0,0:14:33.26,0:14:35.27,Default,,0,0,0,,Tamamdır, git Ishizaki!
Dialogue: 0,0:14:35.27,0:14:37.77,Default - i,,0,0,0,,Ishizaki-kun topu sürüyor!
Dialogue: 0,0:14:37.77,0:14:39.15,Default,,0,0,0,,Hadi şimdi!
Dialogue: 0,0:14:39.15,0:14:39.77,Default,,0,0,0,,Durdurun onu!
Dialogue: 0,0:14:40.30,0:14:40.77,Default,,0,0,0,,Hehe!
Dialogue: 0,0:14:40.77,0:14:41.96,Default,,0,0,0,,Al hadi!
Dialogue: 0,0:14:41.96,0:14:43.05,Default - i,,0,0,0,,Mükemmel bir hareket!
Dialogue: 0,0:14:43.05,0:14:45.28,Default - i,,0,0,0,,Ishizaki-kun savunucuları geçmeden önce pas atıyor!
Dialogue: 0,0:14:47.22,0:14:49.57,Default - i,,0,0,0,,Fakat orta sahadaki Hyuga-kun engelliyor!
Dialogue: 0,0:14:49.57,0:14:50.32,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:14:50.32,0:14:51.82,Default,,0,0,0,,Geliyorum, Hyuga-kun!
Dialogue: 0,0:14:52.98,0:14:54.19,Default,,0,0,0,,Tamam! Gel, Tsubasa!
Dialogue: 0,0:14:54.19,0:14:55.08,Default,,0,0,0,,Getir!
Dialogue: 0,0:14:55.08,0:15:00.04,Default - i,,0,0,0,,Şimdi her iki kaptan da top için çarpışacak.
Dialogue: 0,0:15:00.04,0:15:01.14,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:01.14,0:15:02.04,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:15:02.04,0:15:04.09,Default,,0,0,0,,Yapma Tsubasa-kun! Ayağın...
Dialogue: 0,0:15:05.09,0:15:09.09,Default - i,,0,0,0,,Ancak Tsubasa-kun düellodan kaçınır!
Dialogue: 0,0:15:09.09,0:15:09.59,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:10.02,0:15:13.60,Default - i,,0,0,0,,İyi. Bacağını önemsiyorsan, doğru karar bu.
Dialogue: 0,0:15:14.56,0:15:17.63,Default,,0,0,0,,Seni korkak! Kaptanımızla olan düellodan kaçındın.
Dialogue: 0,0:15:17.63,0:15:18.72,Default,,0,0,0,,Ne kadar cesaretsizce!
Dialogue: 0,0:15:18.72,0:15:20.69,Default,,0,0,0,,Kendine Nankatsu'nun kaptanı mı diyorsun?!
Dialogue: 0,0:15:20.69,0:15:21.77,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:15:21.77,0:15:24.90,Default,,0,0,0,,Tsubasa! Hadi, saldıralım!
Dialogue: 0,0:15:24.90,0:15:26.65,Default,,0,0,0,,Tamam, anladım.
Dialogue: 0,0:15:26.65,0:15:28.03,Default,,0,0,0,,Tsubasa! 
Dialogue: 0,0:15:28.03,0:15:30.15,Default - i,,0,0,0,,İsterseniz bana bir korkak diyin.
Dialogue: 0,0:15:31.16,0:15:34.83,Default - i,,0,0,0,,Önümdeki savaşa takıntı yapmayı göze alamam ve sakatlığımı kötüleştiremem.
Dialogue: 0,0:15:35.83,0:15:39.08,Default - i,,0,0,0,,Sadece bu maçı kazanmayı düşünüyorum.
Dialogue: 0,0:15:39.08,0:15:41.08,Default - i,,0,0,0,,Tsubasa-kun'nun muhteşem top sürmesi
Dialogue: 0,0:15:41.08,0:15:43.25,Default - i,,0,0,0,,gerçekten yaralı olup olmadığını merak ettiriyor!
Dialogue: 0,0:15:43.94,0:15:47.00,Default - i,,0,0,0,,Tsubasa her zaman güçlü bir meydan okuma ruhuna sahipti.
Dialogue: 0,0:15:47.00,0:15:51.00,Default - i,,0,0,0,,Bu adamın gerçek gücü sadece geriye düştüğünde
Dialogue: 0,0:15:51.00,0:15:54.01,Default - i,,0,0,0,,{\t(6077,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}ve köşeye sıkıştığında ortaya çıkıyor.
Dialogue: 0,0:15:54.05,0:15:57.26,Default - i,,0,0,0,,Düellomuzdan kaçınmasının asıl nedeni, 
Dialogue: 0,0:15:57.26,0:15:59.39,Default - i,,0,0,0,,sadece bu maçı kazanmaya odaklanması.
Dialogue: 0,0:16:00.39,0:16:02.90,Default - i,,0,0,0,,Tsubasa-kun çoktan şut çekecek durumda!
Dialogue: 0,0:16:02.90,0:16:04.77,Default,,0,0,0,,Millet, Tsubasa'yı durdurun!
Dialogue: 0,0:16:04.77,0:16:06.65,Default,,0,0,0,,Şut çekmene izin vermeyeceğim!
Dialogue: 0,0:16:06.65,0:16:07.86,Default,,0,0,0,,Tsubasa, arkanda!
Dialogue: 0,0:16:10.02,0:16:13.59,Default - i,,0,0,0,,Tsubasa-kun, Sawada-kun'nun çalımından kaçmayı başardı!
Dialogue: 0,0:16:13.59,0:16:15.37,Default - i,,0,0,0,,Tekrar şut çekmeye hazır!
Dialogue: 0,0:16:15.37,0:16:17.33,Default,,0,0,0,,Durdurun onu! Önüne bir duvar örün!
Dialogue: 0,0:16:17.33,0:16:19.91,Default,,0,0,0,,Şut çekmesine izin vermeyin!
Dialogue: 0,0:16:19.91,0:16:22.79,Default,,0,0,0,,Git {\bord0\blur0.6\c&HFFF069&\4a&HFF&}Drive Shot!
Dialogue: 0,0:16:19.91,0:16:22.79,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:16:22.79,0:16:25.34,Default,,0,0,0,,Duvarı parçala!
Dialogue: 0,0:16:28.20,0:16:31.72,Default,,0,0,0,,Gerçekten bu kadar yükseğe \Nvurduğunda bir kaleyi hedef alabilir mi?!
Dialogue: 0,0:16:31.72,0:16:35.23,Default,,0,0,0,,Tabii ki; Tiger Shot, hedefi bir bakışta delebilir,
Dialogue: 0,0:16:31.72,0:16:35.23,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:35.23,0:16:39.64,Default,,0,0,0,,Ancak Drive Shot'un başarılı olması için buna ihtiyacı bile yok!
Dialogue: 0,0:16:35.23,0:16:41.39,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:16:39.64,0:16:41.39,Default,,0,0,0,,Gel, Drive Shot!
Dialogue: 0,0:16:41.39,0:16:45.47,Default - i,,0,0,0,,Kaleci Wakashimazu-kun kalenin önünde kalmayı seçti
Dialogue: 0,0:16:45.47,0:16:48.02,Default - i,,0,0,0,,ve hızlı bir şekilde Drive Shot'a tepki veriyor!
Dialogue: 0,0:16:45.47,0:16:48.02,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:16:48.02,0:16:48.82,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:48.82,0:16:51.54,Default - i,,0,0,0,,Genellikle bir kaleci atışı durdurmaya çalıştığında,
Dialogue: 0,0:16:51.54,0:16:54.77,Default - i,,0,0,0,,şutun başarı açısını sınırlamak için ileri doğru hareket eder.
Dialogue: 0,0:16:54.77,0:16:56.74,Default - i,,0,0,0,,Ancak, Drive Shot'a doğru hareket ederseniz,
Dialogue: 0,0:16:54.77,0:16:56.74,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:16:56.74,0:16:59.62,Default - i,,0,0,0,,kolayca başınızın üzerinden uçacak ve düşecek.
Dialogue: 0,0:17:00.37,0:17:03.66,Default - i,,0,0,0,,Drive Shot'u durdurmak için kaleye mümkün olduğunca yakın durun 
Dialogue: 0,0:17:00.37,0:17:03.66,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:04.16,0:17:06.96,Default - i,,0,0,0,,ve topun geldiği yola hızlı bir şekilde tepki verin, 
Dialogue: 0,0:17:06.96,0:17:11.46,Default - i,,0,0,0,,ardından zıplamanızı hızlanmasına göre zamanlayın!
Dialogue: 0,0:17:14.84,0:17:16.52,Default - i,,0,0,0,,Durdurdu!
Dialogue: 0,0:17:16.52,0:17:20.34,Default - i,,0,0,0,,Wakashimazu-kun topu tek eliyle gol çizgisinden önce yakalıyor!
Dialogue: 0,0:17:20.34,0:17:23.23,Default - i,,0,0,0,,Drive Shot yenildi!
Dialogue: 0,0:17:20.34,0:17:23.23,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:23.23,0:17:24.30,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:17:24.30,0:17:25.48,Default,,0,0,0,,Başardın!
Dialogue: 0,0:17:30.02,0:17:30.82,Default - i,,0,0,0,,Ohhh!
Dialogue: 0,0:17:30.90,0:17:32.57,Default - i,,0,0,0,,Ancak bu–
Dialogue: 0,0:17:34.32,0:17:35.78,Default,,0,0,0,,Ne?!
Dialogue: 0,0:17:35.78,0:17:39.72,Default - i,,0,0,0,,Yenilmiş gibiydi, ama Tsubasa-kun'nun
Dialogue: 0,0:17:39.72,0:17:43.66,Default - i,,0,0,0,,Drive Shot'undaki dönüş henüz ölmedi!
Dialogue: 0,0:17:39.72,0:17:43.66,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:43.66,0:17:45.10,Default - i,,0,0,0,,Oyun berabere!
Dialogue: 0,0:17:45.10,0:17:50.17,Default - i,,0,0,0,,Nankatsu, ilk yarının 10. dakikasında oyunu eşitledi!
Dialogue: 0,0:17:50.17,0:17:52.92,Default,,0,0,0,,Başardın, Tsubasa! Berabere!
Dialogue: 0,0:17:52.92,0:17:54.38,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:54.38,0:17:57.43,Default,,0,0,0,,Drive Shot'un gerçekten yenilmez!
Dialogue: 0,0:17:54.38,0:18:02.43,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:57.43,0:18:02.43,Default,,0,0,0,,Engellemeye çalışıp çalışmadıklarını \N önemsemeden şut çekmenize izin veren Drive Shot...
Dialogue: 0,0:18:02.43,0:18:04.95,Default,,0,0,0,,Kaleciyi uçurmaya yetecek kadar güçlü.
Dialogue: 0,0:18:04.95,0:18:06.44,Default,,0,0,0,,Gerçekten harika.
Dialogue: 0,0:18:06.44,0:18:09.30,Default,,0,0,0,,Bir gol geriye düşse bile, çabucak yakalar.
Dialogue: 0,0:18:09.30,0:18:10.69,Default,,0,0,0,,Senden beklendiği gibi Tsubasa, bilirsin! 
Dialogue: 0,0:18:11.14,0:18:15.04,Default,,0,0,0,,Oyun sadece berabere, hepsi bu. Şimdi işleri tersine çevirelim!
Dialogue: 0,0:18:15.04,0:18:15.82,Default,,0,0,0,,TAMAM!
Dialogue: 0,0:18:18.49,0:18:20.72,Default - i,,0,0,0,,Tamda senden beklendiği gibi Wakashimazu-kun.
Dialogue: 0,0:18:20.72,0:18:23.75,Default - i,,0,0,0,,Kahretsin, bu şekilde durdurabileceğimi düşünmüştüm.
Dialogue: 0,0:18:23.75,0:18:25.66,Default,,0,0,0,,Bu gerçekten yakındı, Wakashimazu.
Dialogue: 0,0:18:26.04,0:18:27.29,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:18:27.29,0:18:29.41,Default,,0,0,0,,Ama senin hipotezin doğruydu.
Dialogue: 0,0:18:29.41,0:18:34.30,Default,,0,0,0,,Drive Shot'a tepki veren ve dokunan ilk ve tek kişi sensin.
Dialogue: 0,0:18:29.41,0:18:34.30,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:18:34.30,0:18:36.34,Default,,0,0,0,,Kendine güven ve devam et!
Dialogue: 0,0:18:36.34,0:18:37.51,Default,,0,0,0,,Elbette!
Dialogue: 0,0:18:38.43,0:18:40.34,Default - i,,0,0,0,,Drive Shot...
Dialogue: 0,0:18:38.43,0:18:40.34,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:18:40.34,0:18:43.10,Default - i,,0,0,0,,Bir şekilde durduraca–
Dialogue: 0,0:18:47.78,0:18:49.08,Default - i,,0,0,0,,Yoksa...
Dialogue: 0,0:18:50.65,0:18:54.94,Default - i,,0,0,0,,Wakashimazu, Tsubasa'nın Drive Shot'una tepki verebilir.
Dialogue: 0,0:18:50.65,0:18:54.94,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:18:54.94,0:18:59.05,Default - i,,0,0,0,,Ama şimdiye kadar hiç kimse Tiger Shot'uma tepki veremedi.
Dialogue: 0,0:18:54.94,0:18:59.05,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:18:59.05,0:19:02.95,Default - i,,0,0,0,,Topu alabilirsem, ne zaman olursa olsun, gol atacağım.
Dialogue: 0,0:19:02.95,0:19:06.20,Default - i,,0,0,0,,Maç başladığı yere döndü.
Dialogue: 0,0:19:07.58,0:19:09.33,Default,,0,0,0,,Gidin Hyuga'yı tutun!
Dialogue: 0,0:19:11.25,0:19:12.17,Default,,0,0,0,,Yakaladım!
Dialogue: 0,0:19:13.04,0:19:15.32,Default - i,,0,0,0,,Berabere olduktan sonra, Nankatsu topu çaldı 
Dialogue: 0,0:19:15.32,0:19:17.80,Default - i,,0,0,0,,ve saldırmak için bu gücü kullanıyor!
Dialogue: 0,0:19:18.10,0:19:18.76,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:20.45,0:19:21.01,Default,,0,0,0,,Tamam!
Dialogue: 0,0:19:21.89,0:19:24.98,Default - i,,0,0,0,,Tsubasa-kun şu ana kadar iki Drive Shot çekti,
Dialogue: 0,0:19:21.89,0:19:24.98,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:19:24.98,0:19:26.31,Default - i,,0,0,0,,ve üçüncüye hazırlanıyor!
Dialogue: 0,0:19:26.31,0:19:28.31,Default,,0,0,0,,Sanki tekrar çekmene izin veririz de!
Dialogue: 0,0:19:29.06,0:19:31.90,Default - i,,0,0,0,,Tsubasa-kun, Toho'nun savunucuları sıkıştırınca şut çekemez!
Dialogue: 0,0:19:31.90,0:19:33.40,Default - i,,0,0,0,,Son saniyede bir pas veriyor!
Dialogue: 0,0:19:33.40,0:19:34.90,Default,,0,0,0,,Taki!
Dialogue: 0,0:19:34.90,0:19:36.11,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:36.11,0:19:38.11,Default - i,,0,0,0,,Top kalenin önünde yükseliyor!
Dialogue: 0,0:19:38.11,0:19:38.86,Default,,0,0,0,,Pekala!
Dialogue: 0,0:19:44.62,0:19:49.37,Default - i,,0,0,0,,Tsubasa-kun ve Wakashimazu-kun havada çarpışıyor.
Dialogue: 0,0:19:52.08,0:19:53.08,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:53.08,0:19:54.59,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:19:54.59,0:19:56.63,Default,,0,0,0,,Tsubasa senpai!
Dialogue: 0,0:19:57.63,0:20:00.47,Default - i,,0,0,0,,Wakashimazu'nun hatrı için topu uzaklaştırmam gerek!
Dialogue: 0,0:20:00.47,0:20:03.97,Default - i,,0,0,0,,Tsubasa'nın verdiği şansı kesinlikle kullanacağım!
Dialogue: 0,0:20:03.97,0:20:05.85,Default - i,,0,0,0,,Kisugi-kun şut çekimini zamanında yapıyor!
Dialogue: 0,0:20:08.39,0:20:11.14,Default - i,,0,0,0,,Ama işte Sawada-kun, kaleyi bir kafa vuruşu ile koruyor!
Dialogue: 0,0:20:11.14,0:20:12.85,Default - i,,0,0,0,,Toho krizden uzaklaştı!
Dialogue: 0,0:20:12.85,0:20:13.85,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:13.85,0:20:15.11,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:20:16.76,0:20:18.53,Default,,0,0,0,,İyi misin Tsubasa?
Dialogue: 0,0:20:18.53,0:20:20.78,Default,,0,0,0,,Tsubasa, pervasızcaydı!
Dialogue: 0,0:20:20.78,0:20:22.90,Default,,0,0,0,,Çünkü topu pas attın.
Dialogue: 0,0:20:22.90,0:20:23.91,Default,,0,0,0,,Ne–
Dialogue: 0,0:20:23.91,0:20:26.06,Default,,0,0,0,,Çünkü topu gönderdin...
Dialogue: 0,0:20:26.06,0:20:30.16,Default,,0,0,0,,Arkadaşından gelen bir pastı, \Nbu yüzden umutsuzca skor yapmaya çalıştı.
Dialogue: 0,0:20:31.96,0:20:33.58,Default,,0,0,0,,Ben iyiyim.
Dialogue: 0,0:20:33.58,0:20:35.79,Default,,0,0,0,,Maç daha yeni başladı.
Dialogue: 0,0:20:35.79,0:20:37.69,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:20:37.69,0:20:42.30,Default - i,,0,0,0,,Hem sol omzunda hem de bacağında sakatlıkla oynuyor.
Dialogue: 0,0:20:42.30,0:20:45.30,Default - i,,0,0,0,,Umarız performansı bu çarpışmadan etkilenmeyecektir.
Dialogue: 0,0:20:45.30,0:20:47.30,Default,,0,0,0,,İyi misin Wakashimazu?
Dialogue: 0,0:20:47.30,0:20:48.94,Default,,0,0,0,,Sadece biraz sert çarptım.
Dialogue: 0,0:20:48.94,0:20:50.35,Default,,0,0,0,,Önemli bir şey değil.
Dialogue: 0,0:20:53.19,0:20:55.10,Default,,0,0,0,,Wakashimazu...
Dialogue: 0,0:20:55.50,0:21:01.15,Default - i,,0,0,0,,İlkokuldayken, trafik kazasında omzunu ve bacağını kırdı.
Dialogue: 0,0:21:01.53,0:21:05.53,Default - i,,0,0,0,,Bu nedenle, Ulusal Gençlik Futbol Turnuvasının 
Dialogue: 0,0:21:05.53,0:21:08.66,Default - i,,0,0,0,,yarı finaline kadar takıma katılamadı.
Dialogue: 0,0:21:08.66,0:21:12.66,Default - i,,0,0,0,,Umarım şu anda sakatlık kendini göstermez...
Dialogue: 0,0:21:12.66,0:21:16.50,Default - i,,0,0,0,,Nankatsu için bir korner atışı şansı!
Dialogue: 0,0:21:16.50,0:21:18.25,Default,,0,0,0,,Sana güveniyorum, Taki!
Dialogue: 0,0:21:18.25,0:21:19.00,Default,,0,0,0,,İşte başlıyoruz!
Dialogue: 0,0:21:20.00,0:21:21.26,Default,,0,0,0,,Geri dönüş zamanı!
Dialogue: 0,0:21:21.26,0:21:22.26,Default,,0,0,0,,Bana bırakın!
Dialogue: 0,0:21:24.55,0:21:26.80,Default - i,,0,0,0,,Wakashimazu-kun topu uzaklaştırıyor ve takımını rahatlatıyor!
Dialogue: 0,0:21:26.80,0:21:30.51,Default,,0,0,0,,Wakashimazu normalde bu topu iki eliyle yakalayabilirdi!
Dialogue: 0,0:21:30.51,0:21:32.14,Default,,0,0,0,,Wakashimazu her zamanki gibi değil!
Dialogue: 0,0:21:32.14,0:21:35.39,Default - i,,0,0,0,,Uzaklaşan top Tsubasa-kun'nun önüne düşüyor.
Dialogue: 0,0:21:36.19,0:21:39.39,Default - i,,0,0,0,,Bugün Tsubasa-kun'nun üçüncü Drive Shot'u olacak!
Dialogue: 0,0:21:36.19,0:21:39.39,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:21:39.39,0:21:40.15,Default,,0,0,0,,Ne?!
Dialogue: 0,0:21:47.21,0:21:49.95,Default - i,,0,0,0,,Oh, düşmeyecek!
Dialogue: 0,0:21:49.95,0:21:52.95,Default - i,,0,0,0,,Top kaleye doğru aynen böyle gidiyor.
Dialogue: 0,0:21:52.95,0:21:56.34,Default - i,,0,0,0,,Bu, omuz ve bacağındaki sakatlıklar yüzünden mi oldu?!
Dialogue: 0,0:21:56.34,0:21:57.36,Default - i,,0,0,0,,Başarısız oldu!
Dialogue: 0,0:21:57.36,0:21:59.39,Default - i,,0,0,0,,Drive Shot başarısız oldu! 
Dialogue: 0,0:21:57.36,0:21:59.39,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:22:01.46,0:22:02.96,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:22:02.96,0:22:04.84,Default,,0,0,0,,Şanslıydım.
Dialogue: 0,0:22:04.84,0:22:09.25,Default - i,,0,0,0,,İlk yarının 15. dakikasında, \Nşampiyon olan Nankatsu bir çıkmazda!
Dialogue: 0,0:22:09.25,0:22:13.21,Default - i,,0,0,0,,Tsubasa-kun'nun süper atışı, Drive Shot...
Dialogue: 0,0:22:09.25,0:22:13.21,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:22:13.21,0:22:16.15,Default - i,,0,0,0,,Kullanılamaz hale geldi!
Dialogue: 0,0:22:17.62,0:22:19.81,Default - i,,0,0,0,,Olamaz...
Dialogue: 0,0:22:19.83,0:22:34.83,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.74,0:23:59.59,Default,,0,0,0,,48. BÖLÜM: ŞAMPİYON TOHO!
Dialogue: 0,0:23:49.74,0:24:00.00,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:00:32.26,0:00:34.97,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:35.89,0:00:38.56,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:39.47,0:00:42.18,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:49.07,0:00:51.90,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:00:51.90,0:00:58.16,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzuketa
Dialogue: 0,0:00:58.16,0:01:04.04,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitte ita no ni
Dialogue: 0,0:01:04.04,0:01:10.63,OPED-TOP,,0,0,0,,kokoro made uchinomesareta kono yoru ni
Dialogue: 0,0:01:10.63,0:01:14.63,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:14.63,0:01:19.14,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:19.14,0:01:24.73,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:01:24.73,0:01:26.27,OPED-TOP,,0,0,0,,baka daro?
Dialogue: 0,0:01:26.27,0:01:27.48,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:27.48,0:01:30.98,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:01:30.98,0:01:40.87,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:01:40.87,0:01:41.70,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:41.70,0:01:45.50,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:01:45.50,0:01:49.50,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:01:49.50,0:01:55.76,OPED-TOP,,0,0,0,,kono ai mou ichibyou taritomo
Dialogue: 0,0:01:55.76,0:01:58.59,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:00:32.26,0:00:34.97,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:35.89,0:00:38.56,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:39.47,0:00:42.18,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:49.07,0:00:51.90,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:00:51.90,0:00:58.16,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:00:58.16,0:01:04.04,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:04.04,0:01:10.63,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:10.63,0:01:14.63,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:14.63,0:01:19.14,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:01:19.14,0:01:24.73,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:01:24.73,0:01:26.27,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:01:26.27,0:01:27.48,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:27.48,0:01:30.98,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:01:30.98,0:01:40.87,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:01:40.87,0:01:41.70,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:41.70,0:01:45.50,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:01:45.50,0:01:49.50,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:01:49.50,0:01:55.76,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:01:55.76,0:01:58.59,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.54,0:22:44.59,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.59,0:22:50.59,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.59,0:22:56.64,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.64,0:23:01.27,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.90,0:23:07.57,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.90,0:23:14.99,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.99,0:23:21.04,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.04,0:23:25.50,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.80,0:23:33.14,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.14,0:23:39.18,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.18,0:23:45.48,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.54,0:22:44.59,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.59,0:22:50.59,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.59,0:22:56.64,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.64,0:23:01.27,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.90,0:23:07.57,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.90,0:23:14.99,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.99,0:23:21.04,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.04,0:23:25.50,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.80,0:23:33.14,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.14,0:23:39.18,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.18,0:23:45.48,OPED,,0,0,0,,Bu hırslı gençlik sahada!
