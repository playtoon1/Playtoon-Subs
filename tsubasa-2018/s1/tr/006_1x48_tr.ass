Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:01.12,0:00:02.16,Default - i,,0,0,0,,15 dakika içinde,
Dialogue: 0,0:00:02.66,0:00:04.29,Default - i,,0,0,0,,Nankatsu kötü durumda!
Dialogue: 0,0:00:05.20,0:00:06.54,Default - i,,0,0,0,,Tsubasa-kun'nun süper atışı,
Dialogue: 0,0:00:06.71,0:00:08.64,Default - i,,0,0,0,,Drive Shot şimdiden...
Dialogue: 0,0:00:06.71,0:00:08.64,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:00:09.05,0:00:11.81,Default - i,,0,0,0,,Şimdiden bu maçta kullanılamaz!
Dialogue: 0,0:00:13.51,0:00:14.75,Default - i,,0,0,0,,Olamaz...
Dialogue: 0,0:00:16.14,0:00:17.14,Default,,0,0,0,,Wakashimazu...
Dialogue: 0,0:00:23.39,0:00:24.39,Default,,0,0,0,,Neden kaçtın?
Dialogue: 0,0:00:24.60,0:00:26.10,Default,,0,0,0,,Wakashimazu-san, yoksa...
Dialogue: 0,0:00:26.89,0:00:27.91,Default,,0,0,0,,Üzgünüm.
Dialogue: 0,0:00:28.23,0:00:30.07,Default,,0,0,0,,Eski bir yaralanmam kendini gösterdi.
Dialogue: 0,0:00:32.57,0:00:33.89,Default,,0,0,0,,Ama her şey yoluna girecek!
Dialogue: 0,0:00:34.14,0:00:35.82,Default,,0,0,0,,Ağrı geçici.
Dialogue: 0,0:00:36.53,0:00:38.53,Default,,0,0,0,,Sonuna kadar görevimi yapacağım!
Dialogue: 0,0:00:40.90,0:00:42.67,Default,,0,0,0,,Gerekirse sadece sağ kolum ile
Dialogue: 0,0:00:42.82,0:00:45.75,Default,,0,0,0,,kaleyi koruduğuma emin olacağım!
Dialogue: 0,0:00:46.38,0:00:49.28,Default,,0,0,0,,İçiniz rahat olsun! Bana inanın!
Dialogue: 0,0:00:51.56,0:00:53.10,Default,,0,0,0,,Hadi gidelim millet!
Dialogue: 0,0:00:53.89,0:00:54.84,Default,,0,0,0,,Saldırıyoruz.
Dialogue: 0,0:00:55.14,0:00:57.59,Default,,0,0,0,,Wakashimazu'yu korumak için yapmalıyız!
Dialogue: 0,0:00:58.00,0:01:01.89,Default,,0,0,0,,Toho'nun saldırı için her şeyini vermesinin zamanı geldi!
Dialogue: 0,0:01:02.89,0:01:04.40,Default,,0,0,0,,Evet, Kaptan!
Dialogue: 0,0:01:06.59,0:01:07.53,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:01:08.98,0:01:23.98,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \N{\c&HB1351A&}İnstagram: AnimeSeverlerrr
Dialogue: 0,0:02:39.50,0:02:44.50,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}48. BÖLÜM: ŞAMPİYON TOHO!
Dialogue: 0,0:02:42.40,0:02:43.78,Default,,0,0,0,,Hadi, Toho!
Dialogue: 0,0:02:43.94,0:02:45.65,Default - i,,0,0,0,,Toho karşı saldırıya devam ediyor!
Dialogue: 0,0:02:46.28,0:02:47.15,Default - i,,0,0,0,,Doğru...
Dialogue: 0,0:02:47.37,0:02:50.78,Default - i,,0,0,0,,Hyuga-san olmadan galibiyetler alabilmemizi,
Dialogue: 0,0:02:51.00,0:02:52.87,Default - i,,0,0,0,,Wakashimazu-san'a borçluyuz!
Dialogue: 0,0:02:53.66,0:02:55.71,Default - i,,0,0,0,,Sadece iki gol attık...
Dialogue: 0,0:02:56.09,0:03:00.55,Default - i,,0,0,0,,Wakashimazu ile hiçbir şey \Nolmayacağına dair güvencemiz vardı.
Dialogue: 0,0:03:01.00,0:03:05.31,Default - i,,0,0,0,,Bu yüzden korkmadan saldırabildik!
Dialogue: 0,0:03:05.68,0:03:08.56,Default - i,,0,0,0,,Bu sefer yardım etmek bize kaldı!
Dialogue: 0,0:03:08.93,0:03:12.47,Default - i,,0,0,0,,Saldıracağız ve Wakashimazu'nun yükünü hafifleteceğiz!
Dialogue: 0,0:03:13.02,0:03:16.36,Default,,0,0,0,,Gidelim Nankatsu! Hala gol atacağız!
Dialogue: 0,0:03:17.03,0:03:19.49,Default,,0,0,0,,Canavarın topunu ele geçirdiler!
Dialogue: 0,0:03:19.65,0:03:22.06,Default,,0,0,0,,Bizim tarafımızdaysa Tsubasa yaralandı...
Dialogue: 0,0:03:22.24,0:03:23.06,Default,,0,0,0,,Shimano!
Dialogue: 0,0:03:24.81,0:03:25.37,Default,,0,0,0,,Ne?
Dialogue: 0,0:03:26.33,0:03:27.53,Default - i,,0,0,0,,Bu Tsubasa-kun!
Dialogue: 0,0:03:27.69,0:03:30.62,Default - i,,0,0,0,,Durumuna rağmen, kalenin önünde topu ele geçirdi!
Dialogue: 0,0:03:30.90,0:03:31.62,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:32.16,0:03:33.87,Default - i,,0,0,0,,Drive Shot'u kaçırdım,
Dialogue: 0,0:03:32.16,0:03:33.87,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:03:34.12,0:03:35.84,Default - i,,0,0,0,,ama başka kozlarım var!
Dialogue: 0,0:03:36.21,0:03:38.50,Default,,0,0,0,,Gel Toho! Biz kazanacağız!
Dialogue: 0,0:03:38.80,0:03:40.66,Default,,0,0,0,,Tsubasa'yı desteklemek için oynayalım!
Dialogue: 0,0:03:40.84,0:03:41.37,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:43.21,0:03:43.96,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:03:44.18,0:03:47.09,Default,,0,0,0,,Tsubasa! Saldırmana izin vermeyeceğim!
Dialogue: 0,0:03:47.34,0:03:48.43,Default,,0,0,0,,Ve bu sefer,
Dialogue: 0,0:03:48.96,0:03:50.43,Default,,0,0,0,,yüzleş benimle!
Dialogue: 0,0:03:54.18,0:03:55.02,Default,,0,0,0,,Nasıl?!
Dialogue: 0,0:03:55.02,0:03:55.86,Default,,0,0,0,,Ama o...
Dialogue: 0,0:03:56.02,0:04:00.31,Default,,0,0,0,,Bu hareketi ilkokul ulusal turnuvası sırasında başlattı!
Dialogue: 0,0:04:00.74,0:04:03.28,Default,,0,0,0,,Roberto'nun vuruşu "Field Drift".
Dialogue: 0,0:04:03.94,0:04:04.81,Default - i,,0,0,0,,Hayır!
Dialogue: 0,0:04:05.12,0:04:05.99,Default - i,,0,0,0,,Bu sefer olmaz!
Dialogue: 0,0:04:07.74,0:04:09.24,Default - i,,0,0,0,,Hyuga-kun hareketi karşıladı.
Dialogue: 0,0:04:09.40,0:04:11.33,Default - i,,0,0,0,,Topu geri pas attı!
Dialogue: 0,0:04:13.58,0:04:14.25,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:04:14.46,0:04:16.00,Default,,0,0,0,,Hala gol atacağız!
Dialogue: 0,0:04:20.20,0:04:22.97,Default - i,,0,0,0,,Morisaki-kun topa uzak kaldı!
Dialogue: 0,0:04:23.80,0:04:24.58,Default,,0,0,0,,Ne?
Dialogue: 0,0:04:24.75,0:04:25.58,Default,,0,0,0,,Uzaklaştırın!
Dialogue: 0,0:04:26.93,0:04:28.85,Default - i,,0,0,0,,Takasugi-kun topu uzaklaştırıyor!
Dialogue: 0,0:04:29.00,0:04:31.43,Default - i,,0,0,0,,Nankatsu tehlikeyi ortadan kaldırıyor!
Dialogue: 0,0:04:32.85,0:04:36.43,Default - i,,0,0,0,,Ahhh, Tsubasa-kun ve Hyuga-kun topun peşindeler!
Dialogue: 0,0:04:36.81,0:04:38.98,Default,,0,0,0,,Hadi bu topu da oynayalım!
Dialogue: 0,0:04:39.18,0:04:40.89,Default,,0,0,0,,Yönetmeme izin verin!
Dialogue: 0,0:04:41.52,0:04:44.24,Default - i,,0,0,0,,Hyuga düello yapmak için takıntılı.
Dialogue: 0,0:04:44.64,0:04:49.77,Default - i,,0,0,0,,Ama bu Kojiro Hyuga'nın çekiciliği ve kişiliğinin temeli.
Dialogue: 0,0:04:50.16,0:04:51.49,Default,,0,0,0,,Al onu kaptan!
Dialogue: 0,0:04:51.66,0:04:52.32,Default,,0,0,0,,TAMAM!
Dialogue: 0,0:04:52.62,0:04:54.45,Default - i,,0,0,0,,Toho'ya karşı bir maçta,
Dialogue: 0,0:04:54.75,0:04:56.57,Default - i,,0,0,0,,Hyuga-kun ile yüzleşmek kaçınılmaz!
Dialogue: 0,0:04:57.04,0:04:59.08,Default - i,,0,0,0,,Nankatsu'nun şampiyon olması,
Dialogue: 0,0:05:01.25,0:05:03.75,Default - i,,0,0,0,,bu düellodaki zaferimden geçiyor!
Dialogue: 0,0:05:06.62,0:05:08.88,Default - i,,0,0,0,,Hyuga-kun düelloyu kazandı!
Dialogue: 0,0:05:09.05,0:05:10.18,Default,,0,0,0,,Süper, kaptan!
Dialogue: 0,0:05:10.35,0:05:11.10,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:05:12.26,0:05:14.73,Default - i,,0,0,0,,Tsubasa-kun dengesini kaybetti ve geriye düştü!
Dialogue: 0,0:05:15.23,0:05:16.89,Default,,0,0,0,,Yaralı ayağı onu engelliyor.
Dialogue: 0,0:05:17.06,0:05:19.48,Default,,0,0,0,,Tsubasa bundan çok daha yükseğe zıplıyor!
Dialogue: 0,0:05:21.26,0:05:23.36,Default - i,,0,0,0,,Keşke bacağım iyi olsaydı...
Dialogue: 0,0:05:24.18,0:05:28.44,Default - i,,0,0,0,,Kojiro, Tsubasa'nın yaralandığını biliyor.
Dialogue: 0,0:05:28.99,0:05:32.62,Default - i,,0,0,0,,Ancak Misugi'ye karşı oynadığı \Nmaçtan farklı olarak duygusuz kalıyor.
Dialogue: 0,0:05:33.07,0:05:35.33,Default,,0,0,0,,Tsubasa'nın intikamını alacağız!
Dialogue: 0,0:05:35.33,0:05:35.87,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:36.16,0:05:37.20,Default - i,,0,0,0,,Kazanacağım!
Dialogue: 0,0:05:37.50,0:05:41.00,Default - i,,0,0,0,,Kimse beni yenemez!
Dialogue: 0,0:05:41.33,0:05:44.42,Default - i,,0,0,0,,Şimdi kaybedersem, daha önce yaptığım
Dialogue: 0,0:05:44.58,0:05:46.47,Default - i,,0,0,0,,her şey boşa gidecek!
Dialogue: 0,0:05:46.62,0:05:48.38,Default,,0,0,0,,Al bunu, Hyuga!
Dialogue: 0,0:05:50.00,0:05:52.60,Default - i,,0,0,0,,Hyuga-kun bu mücadeleyi kaçınmadan durdurur!
Dialogue: 0,0:05:52.75,0:05:53.85,Default,,0,0,0,,Hareket etmedi!
Dialogue: 0,0:05:54.01,0:05:56.23,Default,,0,0,0,,Nankatsu'ya karşı tekniğin buydu!
Dialogue: 0,0:05:56.38,0:05:59.68,Default,,0,0,0,,Evet, ama ağırlığım sayesinde başarabiliyorum, bilirsin!
Dialogue: 0,0:05:59.93,0:06:01.56,Default,,0,0,0,,Hyuga orayı geçerse...
Dialogue: 0,0:06:01.73,0:06:03.36,Default,,0,0,0,,Bacakları beton gibi!
Dialogue: 0,0:06:06.18,0:06:07.99,Default - i,,0,0,0,,Kisugi-kun fırlatıldı!
Dialogue: 0,0:06:09.49,0:06:13.79,Default - i,,0,0,0,,Seri dalgalar bile güçlü bacaklarını oynatamadı.
Dialogue: 0,0:06:14.19,0:06:15.57,Default,,0,0,0,,Eğer biri yeterli değilse,
Dialogue: 0,0:06:15.79,0:06:17.16,Default,,0,0,0,,haydi hepimiz gidelim!
Dialogue: 0,0:06:18.00,0:06:19.57,Default,,0,0,0,,Sonuç aynı olacak!
Dialogue: 0,0:06:23.00,0:06:26.05,Default,,0,0,0,,Tiger Shot'umu tadın!
Dialogue: 0,0:06:23.00,0:06:26.05,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:06:29.22,0:06:32.93,Default - i,,0,0,0,,Yıkıcı vuruşuyla dalga duvarını bile kırabilir!
Dialogue: 0,0:06:40.23,0:06:42.39,Default - i,,0,0,0,,Morisaki-kun olduğu yerde kaldı!
Dialogue: 0,0:06:42.89,0:06:44.06,Default - i,,0,0,0,,2'ye 1!
Dialogue: 0,0:06:44.23,0:06:46.14,Default - i,,0,0,0,,Toho liderliği ele geçirdi!
Dialogue: 0,0:06:46.99,0:06:48.14,Default - i,,0,0,0,,Gerçekten muhteşem!
Dialogue: 0,0:06:48.77,0:06:51.56,Default - i,,0,0,0,,Tiger Shot inanılmaz yıkıcı!
Dialogue: 0,0:06:48.77,0:06:51.56,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:06:51.99,0:06:53.06,Default,,0,0,0,,O-Olamaz...
Dialogue: 0,0:06:53.57,0:06:54.52,Default,,0,0,0,,Bu...
Dialogue: 0,0:06:54.69,0:06:56.49,Default,,0,0,0,,Şut durdurulamaz.
Dialogue: 0,0:06:58.91,0:07:00.12,Default - i,,0,0,0,,Gördün mü?
Dialogue: 0,0:07:00.75,0:07:04.45,Default - i,,0,0,0,,Bu, Kojiro'nun Okinawa'da yaptığı yenilmez şut!
Dialogue: 0,0:07:04.83,0:07:06.33,Default - i,,0,0,0,,Tiger Shot!
Dialogue: 0,0:07:04.83,0:07:06.33,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:07:06.95,0:07:08.62,Default,,0,0,0,,Aferin, Hyuga-san!
Dialogue: 0,0:07:08.80,0:07:09.47,Default,,0,0,0,,İyi şut!
Dialogue: 0,0:07:09.83,0:07:10.75,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:07:12.30,0:07:13.60,Default - i,,0,0,0,,Gördün mü Nankatsu?
Dialogue: 0,0:07:13.93,0:07:17.97,Default - i,,0,0,0,,Tiger Shot'a sahip olduğum sürece, asla kaybetmeyeceğim!
Dialogue: 0,0:07:13.93,0:07:17.97,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:07:18.63,0:07:22.23,Default,,0,0,0,,Nankatsu için üçüncü bir şampiyonluk\N hayali ortadan kayboluyor gibi görünüyor.
Dialogue: 0,0:07:22.39,0:07:23.36,Default,,0,0,0,,Mikami-san...
Dialogue: 0,0:07:23.61,0:07:25.76,Default,,0,0,0,,Nankatsu bu maçı kazanamaz.
Dialogue: 0,0:07:27.18,0:07:30.39,Default,,0,0,0,,Ek olarak tuzlu olabilir.
Dialogue: 0,0:07:30.99,0:07:32.77,Default,,0,0,0,,Bir mucize olmadığı sürece,
Dialogue: 0,0:07:33.16,0:07:35.66,Default,,0,0,0,,Nankatsu şampiyon olamayacak.
Dialogue: 0,0:07:36.57,0:07:37.49,Default,,0,0,0,,Gerçekten.
Dialogue: 0,0:07:38.37,0:07:40.32,Default,,0,0,0,,Bir mucize olursa...
Dialogue: 0,0:07:43.79,0:07:45.33,Default,,0,0,0,,Futbol bir gol savaşıdır.
Dialogue: 0,0:07:46.87,0:07:48.55,Default,,0,0,0,,Sırayla gol atacağız.
Dialogue: 0,0:07:48.95,0:07:50.55,Default,,0,0,0,,Bu sporun temeli budur.
Dialogue: 0,0:07:52.22,0:07:55.93,Default,,0,0,0,,Toho'nun bizim en büyük engelimiz olduğu açık.
Dialogue: 0,0:07:56.47,0:07:58.22,Default,,0,0,0,,Hyuga'nın Tiger Shot'u etkileyici.
Dialogue: 0,0:07:56.47,0:07:58.22,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:07:58.72,0:08:01.13,Default,,0,0,0,,Ama sonuna kadar savaşacağım.
Dialogue: 0,0:08:01.31,0:08:02.38,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:08:02.88,0:08:04.56,Default,,0,0,0,,Öyleyse gidelim millet!
Dialogue: 0,0:08:04.89,0:08:07.26,Default,,0,0,0,,Evet, Tsubasa haklı!
Dialogue: 0,0:08:07.43,0:08:09.03,Default,,0,0,0,,Pekala gidelim!
Dialogue: 0,0:08:09.03,0:08:09.48,Default,,0,0,0,,EVET!
Dialogue: 0,0:08:12.56,0:08:14.94,Default - i,,0,0,0,,Kendimi tam olarak ifade edemiyorum.
Dialogue: 0,0:08:15.77,0:08:18.41,Default - i,,0,0,0,,Ama bu kazanmamı engellemeyecek!
Dialogue: 0,0:08:19.57,0:08:21.62,Default,,0,0,0,,Odaklanmaya devam ediyoruz millet!
Dialogue: 0,0:08:22.41,0:08:23.54,Default,,0,0,0,,Bir gol öndeyiz,
Dialogue: 0,0:08:23.82,0:08:26.29,Default,,0,0,0,,ama deneyimle, ne olacağını biliyorum.
Dialogue: 0,0:08:26.75,0:08:28.83,Default,,0,0,0,,Nankatsu savunmaya geçtiğinde,
Dialogue: 0,0:08:29.17,0:08:32.04,Default,,0,0,0,,Tsubasa potansiyelini serbest bıraktı!
Dialogue: 0,0:08:33.54,0:08:36.50,Default,,0,0,0,,Nankatsu şimdi gerçek yüzünü ortaya çıkaracak.
Dialogue: 0,0:08:37.13,0:08:41.67,Default,,0,0,0,,Eğer gevşerseniz, Nankatsu'ya karşı tekrar kaybederiz!
Dialogue: 0,0:08:41.85,0:08:42.60,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:43.05,0:08:44.44,Default,,0,0,0,,Bu şekilde devam edelim!
Dialogue: 0,0:08:44.73,0:08:46.14,Default,,0,0,0,,Anlaşıldı mı?
Dialogue: 0,0:08:46.55,0:08:49.51,Default,,0,0,0,,Skoru eşitlemelerini ve 3. golü atmalarını engelleyeceğiz!!!
Dialogue: 0,0:08:49.98,0:08:52.07,Default,,0,0,0,,Arayı açacağız!
Dialogue: 0,0:08:56.27,0:08:57.40,Default - i,,0,0,0,,Maç devam ediyor!
Dialogue: 0,0:08:57.57,0:08:58.58,Default,,0,0,0,,Tamamdır gidelim!
Dialogue: 0,0:08:58.74,0:09:01.03,Default - i,,0,0,0,,Nankatsu skoru eşitlemeye çalışacak!
Dialogue: 0,0:09:01.95,0:09:04.78,Default - i,,0,0,0,,Fakat Toho çok fazla enerji ile savunuyor!
Dialogue: 0,0:09:06.83,0:09:08.75,Default - i,,0,0,0,,Tsubasa-kun topu kaptı!
Dialogue: 0,0:09:09.00,0:09:11.37,Default - i,,0,0,0,,Hadi, skoru eşitleyeceğiz!
Dialogue: 0,0:09:11.66,0:09:14.00,Default,,0,0,0,,Durumunu halledeceğim!
Dialogue: 0,0:09:14.62,0:09:16.17,Default - i,,0,0,0,,Tsubasa-kun hızla pas verir!
Dialogue: 0,0:09:16.62,0:09:17.54,Default,,0,0,0,,Dikkat et Tsubasa!
Dialogue: 0,0:09:18.97,0:09:20.72,Default - i,,0,0,0,,Tsubasa-kun kaçtı!
Dialogue: 0,0:09:21.05,0:09:21.85,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:09:22.22,0:09:23.76,Default - i,,0,0,0,,Senden beklendiği gibi Hyuga-kun
Dialogue: 0,0:09:23.76,0:09:27.14,Default - i,,0,0,0,,ve Toho tüm enerjilerini bu oyuna veriyorlar!
Dialogue: 0,0:09:27.76,0:09:30.89,Default - i,,0,0,0,,Ama biz 3. şampiyonluğu hayal ediyoruz.
Dialogue: 0,0:09:31.57,0:09:34.52,Default - i,,0,0,0,,Ayrıca yenilmez Brezilya'ya gitmeyi hayal ediyorum!
Dialogue: 0,0:09:35.07,0:09:36.74,Default - i,,0,0,0,,Pes edemem!
Dialogue: 0,0:09:37.20,0:09:39.24,Default,,0,0,0,,Skoru eşitleyemeyeceksiniz, Tsubasa!
Dialogue: 0,0:09:41.49,0:09:44.50,Default - i,,0,0,0,,Ne olursa olsun, bir gol bir goldür!
Dialogue: 0,0:09:45.00,0:09:46.91,Default - i,,0,0,0,,Gol atma sırası bizde!
Dialogue: 0,0:09:48.78,0:09:49.96,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:09:50.28,0:09:52.41,Default - i,,0,0,0,,Tsubasa'ya mükemmel bir pas!
Dialogue: 0,0:09:52.62,0:09:53.79,Default,,0,0,0,,Güzel ortalama!
Dialogue: 0,0:09:53.96,0:09:55.16,Default,,0,0,0,,Git, Tsubasa!
Dialogue: 0,0:09:55.62,0:09:59.00,Default - i,,0,0,0,,Bu uçuşla skor eşitlenecek mi?
Dialogue: 0,0:10:01.17,0:10:03.17,Default - i,,0,0,0,,Hyuga-kun engelliyor!
Dialogue: 0,0:10:08.02,0:10:13.02,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:10:13.98,0:10:15.19,Default - i,,0,0,0,,Engelliyor!
Dialogue: 0,0:10:15.36,0:10:18.74,Default - i,,0,0,0,,Hyuga-kun onu yakalamak için olağanüstü hızda koştu!
Dialogue: 0,0:10:20.02,0:10:24.37,Default - i,,0,0,0,,Okinawa'daki kuvvetlendirilmiş \Nbacakları Tiger Shot'u atmasını sağlıyor,
Dialogue: 0,0:10:24.58,0:10:25.87,Default - i,,0,0,0,,ama sadece bu da değil!
Dialogue: 0,0:10:28.15,0:10:28.50,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:10:29.28,0:10:31.16,Default - i,,0,0,0,,Tsubasa-kun kafa vuruşu yapacak!
Dialogue: 0,0:10:31.37,0:10:32.84,Default,,0,0,0,,Seni durduracağım!
Dialogue: 0,0:10:33.59,0:10:36.12,Default - i,,0,0,0,,Hyuga-kun Tsubasa-kun'dan çok daha yükseğe zıpladı!
Dialogue: 0,0:10:36.29,0:10:37.97,Default - i,,0,0,0,,Yine engelledi!
Dialogue: 0,0:10:39.25,0:10:40.47,Default,,0,0,0,,Gördün mü Tsubasa?
Dialogue: 0,0:10:40.88,0:10:44.10,Default - i,,0,0,0,,Hyuga-kun, Tsubasa-kun'nun atışını önlüyor!
Dialogue: 0,0:10:44.85,0:10:46.45,Default,,0,0,0,,Tsubasa engellendiyse...
Dialogue: 0,0:10:46.45,0:10:47.63,Default,,0,0,0,,Şut atmak bize kaldı!
Dialogue: 0,0:10:47.80,0:10:48.80,Default,,0,0,0,,İşte bu, gelin!
Dialogue: 0,0:10:49.88,0:10:51.30,Default - i,,0,0,0,,Wakashimazu-kun uzaklaştırıyor!
Dialogue: 0,0:10:52.01,0:10:53.57,Default,,0,0,0,,Sawada-kun topu aldı!
Dialogue: 0,0:10:54.01,0:10:55.94,Default,,0,0,0,,Mükemmel! Hadi, Takeshi!
Dialogue: 0,0:10:57.14,0:10:57.94,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:11:00.74,0:11:03.95,Default - i,,0,0,0,,Tsubasa, çok etkileyicisin.
Dialogue: 0,0:11:05.03,0:11:07.50,Default - i,,0,0,0,,Ama bu arada ben.
Dialogue: 0,0:11:09.08,0:11:10.21,Default,,0,0,0,,Omuzu...
Dialogue: 0,0:11:10.62,0:11:15.21,Default - i,,0,0,0,,Sawada Takeshi-kun, küçük teknisyen, top sürerek ilerliyor!
Dialogue: 0,0:11:15.37,0:11:16.12,Default,,0,0,0,,Sorimachi-san!
Dialogue: 0,0:11:16.66,0:11:19.75,Default - i,,0,0,0,,Çapraz pas! Nankatsu şaşırdı!
Dialogue: 0,0:11:19.97,0:11:20.79,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:11:21.67,0:11:23.54,Default - i,,0,0,0,,Oyuncular çarpıştı!
Dialogue: 0,0:11:24.04,0:11:25.38,Default - i,,0,0,0,,Top kaleye doğru gidiyor!
Dialogue: 0,0:11:25.63,0:11:26.63,Default,,0,0,0,,Buna izin vermeyeceğim!
Dialogue: 0,0:11:27.80,0:11:29.30,Default - i,,0,0,0,,Ishizaki-kun uzaklaştırıyor!
Dialogue: 0,0:11:30.19,0:11:30.76,Default,,0,0,0,,Git!
Dialogue: 0,0:11:30.94,0:11:32.26,Default - i,,0,0,0,,Koike-kun uzaktan vuruyor!
Dialogue: 0,0:11:34.55,0:11:36.07,Default - i,,0,0,0,,Takasugi-kun durdurdu!
Dialogue: 0,0:11:36.39,0:11:37.61,Default,,0,0,0,,3. golü...
Dialogue: 0,0:11:37.77,0:11:39.11,Default,,0,0,0,,Atamayacaksınız!
Dialogue: 0,0:11:40.32,0:11:42.90,Default - i,,0,0,0,,Hyuga-kun topu aldı!
Dialogue: 0,0:11:43.07,0:11:44.57,Default,,0,0,0,,Hadi Abi!
Dialogue: 0,0:11:45.99,0:11:47.12,Default,,0,0,0,,Şut çekmesine izin vermeyin!
Dialogue: 0,0:11:48.37,0:11:49.50,Default - i,,0,0,0,,Bir pas!
Dialogue: 0,0:11:49.65,0:11:50.28,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:52.12,0:11:53.08,Default,,0,0,0,,Hadi Takeshi!
Dialogue: 0,0:11:53.37,0:11:55.37,Default - i,,0,0,0,,Tıpkı Tsubasa-san ve Misaki-san'nın olduğu gibi,
Dialogue: 0,0:11:55.53,0:11:57.29,Default - i,,0,0,0,,Hyuga-san ve ben,
Dialogue: 0,0:11:58.09,0:12:00.37,Default,,0,0,0,,Toho'nun Altın İkilisini oluşturuyoruz!
Dialogue: 0,0:12:00.54,0:12:03.17,Default - i,,0,0,0,,Hyuga-kun ve Sawada-kun \Narasında mükemmel bir kombinasyon!
Dialogue: 0,0:12:03.34,0:12:04.88,Default - i,,0,0,0,,Uyumları mükemmel!
Dialogue: 0,0:12:05.29,0:12:06.88,Default,,0,0,0,,İyi pas, Takeshi!
Dialogue: 0,0:12:07.97,0:12:09.60,Default,,0,0,0,,Ve işte 3. gol!
Dialogue: 0,0:12:11.42,0:12:12.13,Default,,0,0,0,,Takeshi'nin pası
Dialogue: 0,0:12:12.88,0:12:13.89,Default,,0,0,0,,belirleyici olacak!
Dialogue: 0,0:12:16.44,0:12:18.39,Default - i,,0,0,0,,Ve bu üçüncü gol!
Dialogue: 0,0:12:18.57,0:12:22.02,Default - i,,0,0,0,,Tsubasa-kun fırladı ve Morisaki-kun boşuna atladı!
Dialogue: 0,0:12:23.20,0:12:24.52,Default - i,,0,0,0,,3'e 1!
Dialogue: 0,0:12:24.70,0:12:30.03,Default - i,,0,0,0,,22. dakikada, Toho Nankatsu'ya üçüncü bir gol attı!
Dialogue: 0,0:12:30.37,0:12:33.71,Default - i,,0,0,0,,Şampiyona karşı büyük bir fark yaratıyorlar!
Dialogue: 0,0:12:35.21,0:12:38.41,Default - i,,0,0,0,,Hyuga-kun çoktan hat trick yaptı!
Dialogue: 0,0:12:35.21,0:12:38.41,Default-TOP,,0,0,0,,Hat trick: bir maçta üç gol atmak.
Dialogue: 0,0:12:41.46,0:12:44.75,Default - i,,0,0,0,,Zafer işareti "V" mi yapıyor?
Dialogue: 0,0:12:45.63,0:12:46.59,Default,,0,0,0,,Tsubasa
Dialogue: 0,0:12:47.10,0:12:48.85,Default,,0,0,0,,ilerlemek için iki golümüz var,
Dialogue: 0,0:12:49.50,0:12:51.51,Default,,0,0,0,,ama yakında 3, sonra 4 olacak
Dialogue: 0,0:12:52.10,0:12:55.35,Default,,0,0,0,,sonra 5, ve hatta çok daha fazlası!
Dialogue: 0,0:12:57.14,0:13:00.23,Default,,0,0,0,,Elinden gelenin en iyisini yapmadığını biliyorum.
Dialogue: 0,0:13:00.69,0:13:03.82,Default,,0,0,0,,Ama seni büyük bir farkla yeneceğim!
Dialogue: 0,0:13:04.20,0:13:07.15,Default,,0,0,0,,Senin ve Nankatsu'nun canına okuyacağım!
Dialogue: 0,0:13:07.57,0:13:11.33,Default,,0,0,0,,Üstte olduğum sürece kimse kaybedeceğimi söyleyemez!
Dialogue: 0,0:13:11.78,0:13:12.78,Default,,0,0,0,,Hyuga-kun...
Dialogue: 0,0:13:13.28,0:13:15.83,Default - i,,0,0,0,,Kojiro gerçek bir kaplan.
Dialogue: 0,0:13:16.03,0:13:19.03,Default - i,,0,0,0,,Gol'e susamış acımasız bir yırtıcı.
Dialogue: 0,0:13:19.21,0:13:21.54,Default - i,,0,0,0,,Kojiro Hyuga, vahşi kaplan!
Dialogue: 0,0:13:21.96,0:13:22.87,Default - i,,0,0,0,,Güçlü.
Dialogue: 0,0:13:23.16,0:13:24.84,Default - i,,0,0,0,,Hyuga-kun çok güçlü.
Dialogue: 0,0:13:25.62,0:13:28.54,Default - i,,0,0,0,,Drive Shot'u kurtarmayı düşünmemeliyim.
Dialogue: 0,0:13:25.62,0:13:28.54,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:13:29.13,0:13:32.26,Default - i,,0,0,0,,Şimdiki Hyuga-kun'u yenmek için,
Dialogue: 0,0:13:32.80,0:13:37.51,Default - i,,0,0,0,,bütün vücudum parçalara ayrılsa bile çok çalışmalıyım!
Dialogue: 0,0:13:37.76,0:13:39.44,Default,,0,0,0,,Kazanamayız...
Dialogue: 0,0:13:40.36,0:13:41.19,Default,,0,0,0,,Harikalar.
Dialogue: 0,0:13:41.19,0:13:42.82,Default,,0,0,0,,Ah yapamayacağız.
Dialogue: 0,0:13:42.98,0:13:45.74,Default,,0,0,0,,Toho Hyuga olmadan maçları geçti.
Dialogue: 0,0:13:46.20,0:13:48.65,Default,,0,0,0,,Ve onunla daha da güçlendi,
Dialogue: 0,0:13:49.20,0:13:51.27,Default,,0,0,0,,Toho mükemmel bir takım oldu.
Dialogue: 0,0:13:51.65,0:13:55.08,Default - i,,0,0,0,,Tiger Shot'u durdurmanın bir yolu yok.
Dialogue: 0,0:13:51.65,0:13:55.08,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:13:55.75,0:13:57.78,Default,,0,0,0,,O atışa karşı hiçbir şey yapamam.
Dialogue: 0,0:13:58.78,0:14:01.34,Default,,0,0,0,,Keşke Wakabayashi-san burada olsaydı...
Dialogue: 0,0:14:02.21,0:14:05.12,Default,,0,0,0,,Motive olmayanlar, sahayı terk ederler.
Dialogue: 0,0:14:06.50,0:14:07.37,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:14:08.22,0:14:09.13,Default,,0,0,0,,Morisaki...
Dialogue: 0,0:14:09.38,0:14:11.60,Default,,0,0,0,,Nankatsu kalecisi, sensin.
Dialogue: 0,0:14:12.17,0:14:14.51,Default,,0,0,0,,Şimdiye kadar kalemizi ayakta tutan,
Dialogue: 0,0:14:14.72,0:14:17.73,Default,,0,0,0,,Genzo Wakabayashi değil, sensin Yuzo Morisaki.
Dialogue: 0,0:14:18.55,0:14:19.51,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:14:20.39,0:14:24.02,Default,,0,0,0,,İki gol geride olduğumuz için mi vazgeçeceksiniz millet?
Dialogue: 0,0:14:24.32,0:14:25.39,Default,,0,0,0,,Hayalimizi unuttunuz mu?
Dialogue: 0,0:14:26.14,0:14:27.82,Default,,0,0,0,,Bizim hayalimiz...?
Dialogue: 0,0:14:28.52,0:14:30.20,Default,,0,0,0,,Üst üste üçüncü şampiyonluk.
Dialogue: 0,0:14:30.52,0:14:33.40,Default,,0,0,0,,Nankatsu ile 3. bir şampiyonluk,
Dialogue: 0,0:14:33.70,0:14:35.28,Default,,0,0,0,,birlikte inşa edilmiş bir hayal,
Dialogue: 0,0:14:35.65,0:14:37.46,Default,,0,0,0,,sadece bizim hayalimiz!
Dialogue: 0,0:14:38.41,0:14:39.53,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:14:42.71,0:14:45.66,Default,,0,0,0,,Tsubasa! Bitti, daha fazla yenilemeyiz!
Dialogue: 0,0:14:46.04,0:14:50.22,Default,,0,0,0,,Hayallerimizden bu kadar kolay vazgeçmek söz konusu değil!
Dialogue: 0,0:14:50.59,0:14:53.29,Default,,0,0,0,,Yaralanmalarına rağmen kendini iyice veriyorsun!
Dialogue: 0,0:14:53.47,0:14:56.26,Default,,0,0,0,,Sonuna kadar oynayalım, Tsubasa!
Dialogue: 0,0:14:56.55,0:14:58.01,Default,,0,0,0,,Kaptan Tsubasa!
Dialogue: 0,0:14:58.35,0:14:59.23,Default,,0,0,0,,Millet...
Dialogue: 0,0:15:00.44,0:15:01.51,Default,,0,0,0,,Pekala gidelim!
Dialogue: 0,0:15:01.80,0:15:02.73,Default,,0,0,0,,EVET!
Dialogue: 0,0:15:02.98,0:15:05.61,Default,,0,0,0,,Birlikte üç gol atın.
Dialogue: 0,0:15:05.82,0:15:07.49,Default,,0,0,0,,Kazan, Nankatsu!
Dialogue: 0,0:15:07.89,0:15:09.32,Default,,0,0,0,,Toplan, Nankatsu!
Dialogue: 0,0:15:09.49,0:15:11.49,Default,,0,0,0,,Hyuga'ya karşı bir olun!
Dialogue: 0,0:15:14.74,0:15:17.20,Default - i,,0,0,0,,Gel Toho! Maç daha bitmedi!
Dialogue: 0,0:15:17.50,0:15:20.46,Default - i,,0,0,0,,Ortaokul hayatımızın sonuncu maçı!
Dialogue: 0,0:15:20.62,0:15:24.09,Default - i,,0,0,0,,Bu maçı kazanmak bizim ortak hayalimiz!
Dialogue: 0,0:15:24.25,0:15:26.46,Default - i,,0,0,0,,Bu hayalden vazgeçmeyeceğiz!
Dialogue: 0,0:15:26.84,0:15:28.37,Default - i,,0,0,0,,Gel, Toho!
Dialogue: 0,0:15:29.62,0:15:31.92,Default,,0,0,0,,Gidin Toho'nun kayan çalım takımı!
Dialogue: 0,0:15:37.22,0:15:37.92,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:38.30,0:15:39.42,Default - i,,0,0,0,,Topu tutacağız!
Dialogue: 0,0:15:39.60,0:15:40.94,Default - i,,0,0,0,,Farkı azaltacağız!
Dialogue: 0,0:15:41.30,0:15:43.51,Default - i,,0,0,0,,Toho'nun kayan çalım takımı başarısız oldu!
Dialogue: 0,0:15:43.69,0:15:46.86,Default - i,,0,0,0,,Bu fark Nankatsu'nun zafer susuzluğunu uyandırdı!
Dialogue: 0,0:15:47.14,0:15:48.14,Default - i,,0,0,0,,Kazanacağım!
Dialogue: 0,0:15:48.32,0:15:48.90,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:48.90,0:15:50.74,Default - i,,0,0,0,,Hyuga-kun Kisugi-kun'dan topu çaldı!
Dialogue: 0,0:15:51.52,0:15:54.27,Default - i,,0,0,0,,Ve santra çizgisinin önünde, şut çekecek,
Dialogue: 0,0:15:54.74,0:15:56.45,Default - i,,0,0,0,,Tiger Shot!
Dialogue: 0,0:15:54.74,0:15:56.45,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:15:56.90,0:15:58.37,Default - i,,0,0,0,,Bu atış dümdüz!
Dialogue: 0,0:15:58.70,0:16:02.50,Default - i,,0,0,0,,Hyuga-kun'nun önünde durursam top bana gelir!
Dialogue: 0,0:16:02.83,0:16:03.83,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:16:04.21,0:16:05.78,Default,,0,0,0,,Bu farkın üçüncü golü!
Dialogue: 0,0:16:06.96,0:16:08.54,Default - i,,0,0,0,,Tiger Shot ateşlendi!
Dialogue: 0,0:16:06.96,0:16:08.54,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:08.91,0:16:10.04,Default,,0,0,0,,Gol alamayacaksın!
Dialogue: 0,0:16:11.00,0:16:13.84,Default - i,,0,0,0,,Tsubasa-kun Tiger Shot'u geri dödürüyor!
Dialogue: 0,0:16:11.00,0:16:13.84,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:14.04,0:16:15.22,Default,,0,0,0,,N-Ne?!
Dialogue: 0,0:16:15.38,0:16:17.35,Default,,0,0,0,,{\bord0\blur0.6\c&HFFF069p&\4a&HFF&}Drive Shot!
Dialogue: 0,0:16:15.38,0:16:17.35,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:16:29.14,0:16:30.52,Default - i,,0,0,0,,İçerde!
Dialogue: 0,0:16:30.69,0:16:33.27,Default - i,,0,0,0,,Bu Drive shot azimle doluydu!
Dialogue: 0,0:16:33.45,0:16:35.20,Default - i,,0,0,0,,Wakashimazu-kun hiçbir şey yapamadı!
Dialogue: 0,0:16:35.52,0:16:36.40,Default - i,,0,0,0,,İçerde...
Dialogue: 0,0:16:37.37,0:16:38.99,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:16:39.15,0:16:40.20,Default,,0,0,0,,Tebrikler, Tsubasa!
Dialogue: 0,0:16:40.62,0:16:41.58,Default,,0,0,0,,Başardın!
Dialogue: 0,0:16:41.58,0:16:42.71,Default,,0,0,0,,Bir golden daha fazlası!
Dialogue: 0,0:16:43.03,0:16:44.62,Default,,0,0,0,,Muhteşem! Çok güçlü!
Dialogue: 0,0:16:44.78,0:16:45.53,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:16:48.50,0:16:50.04,Default - i,,0,0,0,,İnanamıyorum!
Dialogue: 0,0:16:50.21,0:16:51.59,Default,,0,0,0,,Bir mucize oldu.
Dialogue: 0,0:16:52.00,0:16:55.00,Default,,0,0,0,,Evet. Tiger Shot geri döndü...
Dialogue: 0,0:16:52.00,0:16:55.00,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:16:55.17,0:16:58.75,Default,,0,0,0,,Atışa ulaştı ve skor yapmayı başardı.
Dialogue: 0,0:16:59.22,0:17:01.47,Default,,0,0,0,,Şansı 10.000'de birdi, hayır...
Dialogue: 0,0:17:01.63,0:17:03.76,Default,,0,0,0,,Veya daha doğrusu 100.000'de bir.
Dialogue: 0,0:17:04.09,0:17:07.44,Default,,0,0,0,,Tsubasa Ozora da aynısını yaptı.
Dialogue: 0,0:17:08.15,0:17:10.35,Default,,0,0,0,,Gerçekten Futbol Çocuğu!
Dialogue: 0,0:17:11.10,0:17:12.56,Default,,0,0,0,,Muhteşem, Tsubasa!
Dialogue: 0,0:17:12.74,0:17:15.45,Default,,0,0,0,,Yine de Drive Shot'unu kullanamaz mısın?
Dialogue: 0,0:17:12.74,0:17:15.45,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:15.60,0:17:19.11,Default,,0,0,0,,Hyuga-kun'u ve Toho'yu yenmenin tek yolu bu.
Dialogue: 0,0:17:19.66,0:17:21.45,Default,,0,0,0,,Ancak skor olacağını düşünmedim.
Dialogue: 0,0:17:21.86,0:17:24.00,Default,,0,0,0,,Tiger Shot'a karşı koymak istedim.
Dialogue: 0,0:17:21.86,0:17:24.00,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:17:24.46,0:17:27.96,Default,,0,0,0,,Hyuga-kun'u yenmek için tamamen kuşatmak zorundasın!
Dialogue: 0,0:17:28.28,0:17:29.46,Default,,0,0,0,,Şimdi,
Dialogue: 0,0:17:29.78,0:17:32.96,Default,,0,0,0,,parçalara ayrılsam bile her şeyimi vereceğim,
Dialogue: 0,0:17:33.50,0:17:35.22,Default,,0,0,0,,Kojiro Hyuga'yı ezmek için,
Dialogue: 0,0:17:35.50,0:17:37.29,Default,,0,0,0,,ve Toho Akademisini yenmek için!
Dialogue: 0,0:17:37.83,0:17:40.30,Default,,0,0,0,,Hadi çok çalışalım!
Dialogue: 0,0:17:40.30,0:17:41.64,Default,,0,0,0,,3. şampiyonluğu alacağız!
Dialogue: 0,0:17:41.80,0:17:44.05,Default,,0,0,0,,Hayallerimizi gerçeğe dönüştürelim!
Dialogue: 0,0:17:44.68,0:17:46.39,Default - i,,0,0,0,,Bu Tsubasa'nın gücü.
Dialogue: 0,0:17:46.90,0:17:49.40,Default - i,,0,0,0,,Onu yenmemi engelleyen bir güç!
Dialogue: 0,0:17:49.94,0:17:51.23,Default,,0,0,0,,İşte başlıyoruz millet!
Dialogue: 0,0:17:51.56,0:17:52.31,Default,,0,0,0,,Hyuga-san...
Dialogue: 0,0:17:52.69,0:17:54.99,Default,,0,0,0,,Hala bir gol avantajımız var!
Dialogue: 0,0:17:55.49,0:17:58.99,Default,,0,0,0,,Nankatsu'yu yeneceğiz ve ilk şampiyonluğumuzu alacağız!
Dialogue: 0,0:17:59.24,0:18:00.07,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:00.61,0:18:02.95,Default - i,,0,0,0,,Bu atışta hiçbir şey yapamadım.
Dialogue: 0,0:18:03.24,0:18:06.03,Default - i,,0,0,0,,Ama bir daha olmayacak!
Dialogue: 0,0:18:07.53,0:18:13.00,Default - i,,0,0,0,,Tsubasa, Drive Shot'unu Tiger Shot'umla geri göndereceğim!
Dialogue: 0,0:18:07.53,0:18:13.00,Default-TOP,,0,0,0,,{\fs70}Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu\NTiger Shot: Kaplan Vuruşu
Dialogue: 0,0:18:13.21,0:18:13.96,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:18:13.96,0:18:15.04,Default,,0,0,0,,Hyuga'yı durduralım!
Dialogue: 0,0:18:17.63,0:18:18.72,Default,,0,0,0,,Hadi gidelim, Sorimachi!
Dialogue: 0,0:18:19.08,0:18:22.72,Default - i,,0,0,0,,Hyuga, daha önceden, soğukkanlılığını kaybederdin 
Dialogue: 0,0:18:23.00,0:18:24.93,Default - i,,0,0,0,,ve inatla skor yapmaya çalışırdın.
Dialogue: 0,0:18:25.39,0:18:27.05,Default - i,,0,0,0,,Ama artık değil.
Dialogue: 0,0:18:27.55,0:18:30.10,Default - i,,0,0,0,,Hevesin her zaman mevcut,
Dialogue: 0,0:18:30.26,0:18:34.19,Default - i,,0,0,0,,ama şimdi bir oyunu kazanmak için\N doğru seçimleri nasıl yapacağını biliyorsun.
Dialogue: 0,0:18:34.90,0:18:36.85,Default,,0,0,0,,Hyuga iyi oynuyor.
Dialogue: 0,0:18:37.02,0:18:38.06,Default,,0,0,0,,Dediğiniz gibi.
Dialogue: 0,0:18:38.35,0:18:39.27,Default,,0,0,0,,Mikami-san.
Dialogue: 0,0:18:39.81,0:18:41.49,Default,,0,0,0,,Beni merkeze kadar takip edin.
Dialogue: 0,0:18:41.70,0:18:42.45,Default,,0,0,0,,Tamam.
Dialogue: 0,0:18:42.74,0:18:45.07,Default,,0,0,0,,Avrupa turnesi maçı için mi?
Dialogue: 0,0:18:45.36,0:18:47.32,Default,,0,0,0,,Evet, ayrılmak zorundayım.
Dialogue: 0,0:18:48.46,0:18:51.67,Default - i,,0,0,0,,Bu turnuvadan sonra seçim gününün ışığını görecek.
Dialogue: 0,0:18:52.03,0:18:53.83,Default - i,,0,0,0,,Olgunlaşmış Tsubasa Ozora
Dialogue: 0,0:18:54.42,0:18:57.33,Default - i,,0,0,0,,veya Kojiro Hyuga'dan hangisi kaptan olacak?
Dialogue: 0,0:18:58.00,0:18:59.79,Default,,0,0,0,,Savaş, Toho!  Savaş!
Dialogue: 0,0:18:59.97,0:19:02.18,Default,,0,0,0,,Elinden geleni yap, Nankatsu!
Dialogue: 0,0:19:02.50,0:19:03.09,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:19:03.50,0:19:07.30,Default - i,,0,0,0,,Kalenin önünde Toho,\N Hyuga-kun'a mükemmel bir şekilde pas attı!
Dialogue: 0,0:19:07.48,0:19:08.01,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:19:08.84,0:19:10.73,Default - i,,0,0,0,,Tsubasa pası kesiyor!
Dialogue: 0,0:19:11.01,0:19:11.85,Default,,0,0,0,,Ne?
Dialogue: 0,0:19:12.01,0:19:13.35,Default - i,,0,0,0,,Ben kazanacağım Hyuga-kun!
Dialogue: 0,0:19:13.51,0:19:15.90,Default - i,,0,0,0,,Sahip olduğum her şeyi vereceğim!
Dialogue: 0,0:19:17.60,0:19:20.24,Default - i,,0,0,0,,Tsubasa-kun sinsice topu sürüyor!
Dialogue: 0,0:19:21.49,0:19:23.11,Default,,0,0,0,,Hareketin burada bitiyor!
Dialogue: 0,0:19:24.11,0:19:26.82,Default - i,,0,0,0,,Tsubasa-kun üstünden atladı!
Dialogue: 0,0:19:30.50,0:19:31.50,Default,,0,0,0,,Ne?
Dialogue: 0,0:19:32.57,0:19:33.63,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:34.75,0:19:37.04,Default - i,,0,0,0,,Tsubasa-kun birdenbire düştü!
Dialogue: 0,0:19:37.29,0:19:38.75,Default,,0,0,0,,Oyuncular her zaman oynar!
Dialogue: 0,0:19:38.92,0:19:40.25,Default,,0,0,0,,Topu geri alın!
Dialogue: 0,0:19:41.54,0:19:43.68,Default - i,,0,0,0,,Izawa-kun topa uzanıyor!
Dialogue: 0,0:19:43.97,0:19:45.97,Default - i,,0,0,0,,Beraberlik golü olacak mı?
Dialogue: 0,0:19:46.25,0:19:46.97,Default,,0,0,0,,Git!
Dialogue: 0,0:19:47.72,0:19:48.43,Default - i,,0,0,0,,Izawa-kun'nun şutu!
Dialogue: 0,0:19:50.80,0:19:52.48,Default - i,,0,0,0,,Sol kolum hareket etmiyor!
Dialogue: 0,0:19:53.76,0:19:55.81,Default - i,,0,0,0,,Wakashimazu-kun topa yumruk atıyor!
Dialogue: 0,0:19:56.10,0:19:57.81,Default - i,,0,0,0,,Nankatsu’yu gol'den mahrum etti!
Dialogue: 0,0:19:57.98,0:20:00.27,Default,,0,0,0,,Ken! Gerçekten sol kolu zarar gördü!
Dialogue: 0,0:20:00.70,0:20:04.56,Default - i,,0,0,0,,Tsubasa-kun yerde yatıyor! Durumu kötüleşti!
Dialogue: 0,0:20:05.02,0:20:08.28,Default - i,,0,0,0,,Mucizevi Drive Shot'dan dolayı!
Dialogue: 0,0:20:05.02,0:20:08.28,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:20:09.16,0:20:10.25,Default - i,,0,0,0,,Tiger Shot’a katlandı,
Dialogue: 0,0:20:09.16,0:20:10.25,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:20:10.71,0:20:13.11,Default - i,,0,0,0,,ve Drive Shot'u tekrarladı.
Dialogue: 0,0:20:10.71,0:20:13.11,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:20:13.38,0:20:16.33,Default - i,,0,0,0,,Fiziksel olarak daha da zarar gördü!
Dialogue: 0,0:20:16.92,0:20:20.88,Default - i,,0,0,0,,Nankatsu köşe vuruşu kullanacak,\N ancak Tsubasa-kun tedavi edilecek!
Dialogue: 0,0:20:21.38,0:20:23.50,Default,,0,0,0,,Tsubasa-kun, bacağının durumu...
Dialogue: 0,0:20:24.14,0:20:27.00,Default,,0,0,0,,Doktor, bacağım cidden acıyor!
Dialogue: 0,0:20:27.18,0:20:28.00,Default,,0,0,0,,Tabii ki de!
Dialogue: 0,0:20:28.68,0:20:30.39,Default,,0,0,0,,Bandaj yırtılmış!
Dialogue: 0,0:20:30.84,0:20:33.19,Default,,0,0,0,,Çok fazla zorlamamanı söylemiştim!
Dialogue: 0,0:20:33.40,0:20:36.23,Default,,0,0,0,,Ama Doktor, çekingen oynarsam,
Dialogue: 0,0:20:36.51,0:20:38.69,Default,,0,0,0,,Hyuga-kun'u yenemeyeceğim!
Dialogue: 0,0:20:39.27,0:20:42.65,Default,,0,0,0,,Bu oyunu kazanmak için buradayım!
Dialogue: 0,0:20:43.45,0:20:45.95,Default,,0,0,0,,Bu yarı bitti. Revire gidelim.
Dialogue: 0,0:20:48.24,0:20:51.61,Default,,0,0,0,,Dinleyin millet! Tsubasa için yapmalıyız!
Dialogue: 0,0:20:51.91,0:20:53.67,Default,,0,0,0,,Köşe vuruşu şansımız!
Dialogue: 0,0:20:53.82,0:20:54.53,Default,,0,0,0,,Tamam!
Dialogue: 0,0:20:54.86,0:20:56.57,Default - i,,0,0,0,,Henüz farketmediler...
Dialogue: 0,0:20:56.75,0:20:58.96,Default - i,,0,0,0,,Wakashimazu'nun sol kolu sakatlandı!
Dialogue: 0,0:20:59.13,0:21:00.58,Default - i,,0,0,0,,Bu köşe vuruşu...
Dialogue: 0,0:21:00.75,0:21:02.72,Default - i,,0,0,0,,Asla savunmayı bırakmayacağız!
Dialogue: 0,0:21:03.13,0:21:06.25,Default - i,,0,0,0,,Nankatsu, Tsubasa-kun olmadan maça devam edecek!
Dialogue: 0,0:21:08.64,0:21:10.14,Default - i,,0,0,0,,Köşe vuruşu kullanıldı!
Dialogue: 0,0:21:10.30,0:21:11.14,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:21:11.30,0:21:12.34,Default,,0,0,0,,Yapamazsınız!
Dialogue: 0,0:21:13.89,0:21:16.98,Default - i,,0,0,0,,Bu bir tuzak! Top Ishizaki-kun için!
Dialogue: 0,0:21:17.23,0:21:18.19,Default,,0,0,0,,Aldım!
Dialogue: 0,0:21:21.69,0:21:24.15,Default - i,,0,0,0,,Wakashimazu artık topu engellemiyor!
Dialogue: 0,0:21:24.60,0:21:26.20,Default - i,,0,0,0,,Yoksa yaralandı mı?
Dialogue: 0,0:21:26.70,0:21:27.52,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:21:28.02,0:21:29.24,Default - i,,0,0,0,,Takasugi'nin atışı!
Dialogue: 0,0:21:29.91,0:21:30.99,Default - i,,0,0,0,,Imai-kun engelliyor!
Dialogue: 0,0:21:32.36,0:21:34.21,Default - i,,0,0,0,,Top Hyuga'ya geldi!
Dialogue: 0,0:21:34.36,0:21:35.53,Default,,0,0,0,,Geri dönün millet!
Dialogue: 0,0:21:35.92,0:21:37.57,Default - i,,0,0,0,,Toho kaçtı!
Dialogue: 0,0:21:37.75,0:21:39.03,Default - i,,0,0,0,,Saldırı gibi kokuyor!
Dialogue: 0,0:21:39.88,0:21:40.54,Default,,0,0,0,,Ne?
Dialogue: 0,0:21:41.67,0:21:43.00,Default,,0,0,0,,H-Hyuga-san?
Dialogue: 0,0:21:43.67,0:21:45.50,Default,,0,0,0,,Nankatsu Tsubasa olmadan oynuyor...
Dialogue: 0,0:21:45.93,0:21:49.04,Default,,0,0,0,,Bu durumda zafer ilgi çekici olmayacak.
Dialogue: 0,0:21:49.84,0:21:50.75,Default,,0,0,0,,Hyuga...
Dialogue: 0,0:21:51.22,0:21:53.98,Default - i,,0,0,0,, Ancak, mücadele etmeliyim.
Dialogue: 0,0:21:54.23,0:21:58.40,Default - i,,0,0,0,,Bensiz nitelikli takım arkadaşlarım için gerekli!
Dialogue: 0,0:21:59.23,0:22:02.73,Default,,0,0,0,,İleri, millet! Nankatsu'yu küçük düşüreceğiz!
Dialogue: 0,0:22:02.90,0:22:06.99,Default,,0,0,0,,Tsubasa olmadan, Nankatsuya 10 gol atarız!
Dialogue: 0,0:22:07.81,0:22:10.36,Default,,0,0,0,,Tsubasa uzakta olduğu için oynamayın!
Dialogue: 0,0:22:10.52,0:22:12.45,Default,,0,0,0,,Nankatsu'da hiçbir şey sayılmaz.
Dialogue: 0,0:22:12.61,0:22:14.91,Default,,0,0,0,,10'a dayanacağız!
Dialogue: 0,0:22:20.04,0:22:35.04,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.92,0:23:58.89,Default,,0,0,0,,49. BÖLÜM: KAPLAN VE TSUBASA'NIN ATEŞLİ RUHU
Dialogue: 0,0:23:49.92,0:23:59.00,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:01:11.26,0:01:13.97,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:14.89,0:01:17.56,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:18.47,0:01:21.18,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:28.07,0:01:30.90,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:30.90,0:01:37.16,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzuketa
Dialogue: 0,0:01:37.16,0:01:43.04,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitte ita no ni
Dialogue: 0,0:01:43.04,0:01:49.63,OPED-TOP,,0,0,0,,kokoro made uchinomesareta kono yoru ni
Dialogue: 0,0:01:49.63,0:01:53.63,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:53.63,0:01:58.14,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:58.14,0:02:03.73,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:02:03.73,0:02:05.27,OPED-TOP,,0,0,0,,baka daro?
Dialogue: 0,0:02:05.27,0:02:06.48,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:06.48,0:02:09.98,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:02:09.98,0:02:19.87,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:02:19.87,0:02:20.70,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:20.70,0:02:24.50,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:02:24.50,0:02:28.50,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:02:28.50,0:02:34.76,OPED-TOP,,0,0,0,,kono ai mou ichibyou taritomo
Dialogue: 0,0:02:34.76,0:02:37.59,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:01:11.26,0:01:13.97,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:14.89,0:01:17.56,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:18.47,0:01:21.18,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:28.07,0:01:30.90,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:01:30.90,0:01:37.16,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:01:37.16,0:01:43.04,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:43.04,0:01:49.63,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:49.63,0:01:53.63,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:53.63,0:01:58.14,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:01:58.14,0:02:03.73,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:02:03.73,0:02:05.27,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:02:05.27,0:02:06.48,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:06.48,0:02:09.98,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:02:09.98,0:02:19.87,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:02:19.87,0:02:20.70,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:20.70,0:02:24.50,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:02:24.50,0:02:28.50,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:02:28.50,0:02:34.76,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:34.76,0:02:37.59,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.54,0:22:44.59,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.59,0:22:50.59,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.59,0:22:56.64,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.64,0:23:01.27,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.90,0:23:07.57,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.90,0:23:14.99,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.99,0:23:21.04,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.04,0:23:25.50,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.80,0:23:33.14,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.14,0:23:39.18,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.18,0:23:45.48,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.54,0:22:44.59,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.59,0:22:50.59,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.59,0:22:56.64,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.64,0:23:01.27,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.90,0:23:07.57,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.90,0:23:14.99,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.99,0:23:21.04,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.04,0:23:25.50,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.80,0:23:33.14,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.14,0:23:39.18,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.18,0:23:45.48,OPED,,0,0,0,,Bu hırslı gençlik sahada!
