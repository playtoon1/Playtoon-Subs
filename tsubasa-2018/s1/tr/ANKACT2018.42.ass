Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:04.45,0:00:06.90,Default,,0,0,0,,{\i1}İkinci yarı başladığında, Tsubasa önde top sürüyor!{\i0}
Dialogue: 0,0:00:08.73,0:00:09.82,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:00:13.44,0:00:15.57,Default,,0,0,0,,{\i1}Tsubasa, kaleyi gördüğünde şut çek!{\i0}
Dialogue: 0,0:00:16.20,0:00:17.33,Default,,0,0,0,,{\i1}Tamam, Roberto.{\i0}
Dialogue: 0,0:00:17.33,0:00:20.87,Default,,0,0,0,,{\i1}Wakabayashi-kun, Misaki-kun, beni izleyin!{\i0}
Dialogue: 0,0:00:20.87,0:00:23.25,Default,,0,0,0,,{\i1}Bu benim Drive Shot'um!{\i0}
Dialogue: 0,0:00:20.87,0:00:23.25,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:00:24.17,0:00:26.08,Default,,0,0,0,,Çıkar şunu!
Dialogue: 0,0:00:28.00,0:00:43.00,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \Nİnstagram: AnimeSeverlerrr
Dialogue: 0,0:01:58.26,0:02:03.14,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}42. BÖLÜM: \NTSUBASA, ANKA KUŞU
Dialogue: 0,0:01:58.79,0:02:04.68,Default-TOP,,0,0,0,,{\i1}Tsubasa-kun Hirado'nun tarafına girer girmez şut çekmeye hazırlanıyor!{\i0}
Dialogue: 0,0:02:10.26,0:02:11.56,Default,,0,0,0,,Aklını mı kaçırdın, Tsubasa?!
Dialogue: 0,0:02:11.56,0:02:12.54,Default,,0,0,0,,Panikliyor musun?!
Dialogue: 0,0:02:12.54,0:02:14.50,Default,,0,0,0,,Oradan şut çekmek anlamsız.
Dialogue: 0,0:02:14.50,0:02:15.81,Default,,0,0,0,,B-Bu...
Dialogue: 0,0:02:15.81,0:02:17.32,Default,,0,0,0,,Yani şimdi kullanacaksın, Tsubasa...
Dialogue: 0,0:02:17.78,0:02:19.20,Default,,0,0,0,,Hala kusurlu...
Dialogue: 0,0:02:19.96,0:02:21.24,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:02:19.96,0:02:21.24,Default,,0,0,0,,{\bord0\blur0.6\c&HFFF069&\4a&HFF&}Drive {\bord0\blur0.6\c&H3AFFFD&}Shot!
Dialogue: 0,0:02:21.72,0:02:24.54,Default,,0,0,0,,{\i1}Sahip olduğu her şeyle uzun bir şut çekiyor!{\i0}
Dialogue: 0,0:02:26.42,0:02:29.04,Default,,0,0,0,,Hatayama, bu kadar uğraşmana gerek yok, bilirsin.
Dialogue: 0,0:02:29.73,0:02:32.88,Default,,0,0,0,,Kaleyi bulamıyorsa, bir vuruşun\N ne kadar güçlü olduğu önemli değil.
Dialogue: 0,0:02:43.18,0:02:43.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:45.29,0:02:47.35,Default,,0,0,0,,{\i1}Oh... İçerde!{\i0}
Dialogue: 0,0:02:50.80,0:02:51.60,Default,,0,0,0,,İçerde!
Dialogue: 0,0:02:51.60,0:02:52.48,Default,,0,0,0,,Başardın!
Dialogue: 0,0:02:52.48,0:02:53.98,Default,,0,0,0,,Sonunda başardın!
Dialogue: 0,0:02:53.98,0:02:56.24,Default,,0,0,0,,Aferin Tsubasa!
Dialogue: 0,0:02:56.86,0:02:58.01,Default,,0,0,0,,Yaşasın!
Dialogue: 0,0:02:58.01,0:02:59.01,Default,,0,0,0,,Evet!
Dialogue: 0,0:02:59.01,0:03:01.95,Default,,0,0,0,,Sonunda Drive Shot'la gol attın, Tsubasa!
Dialogue: 0,0:02:59.01,0:03:04.20,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:03:02.59,0:03:04.20,Default,,0,0,0,,Drive Shot mu...?
Dialogue: 0,0:03:04.20,0:03:09.26,Default,,0,0,0,,{\i1}Tsubasa'nın şutu kalenin \Ndireğine çarpacak gibi görünüyordu,{\i0}
Dialogue: 0,0:03:09.26,0:03:13.91,Default,,0,0,0,,{\i1}ancak topun keskin dönüşü sayesinde tam içeri daldı!{\i0}
Dialogue: 0,0:03:13.91,0:03:16.42,Default,,0,0,0,,{\i1}Ağı deldi!{\i0}
Dialogue: 0,0:03:11.42,0:03:12.88,Default-TOP,,0,0,0,,Demek sonunda başardın...
Dialogue: 0,0:03:12.88,0:03:13.68,Default-TOP,,0,0,0,,Evet.
Dialogue: 0,0:03:13.68,0:03:15.52,Default-TOP,,0,0,0,,Drive Shot muhteşem!
Dialogue: 0,0:03:15.52,0:03:16.42,Default-TOP,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:16.42,0:03:18.72,Default-TOP,,0,0,0,,Başardı! Başardı!
Dialogue: 0,0:03:18.72,0:03:19.67,Default-TOP,,0,0,0,,Tsubasa...{ok i can't hear what they actually say bc tnarrator-san is too loud}
Dialogue: 0,0:03:16.42,0:03:19.07,Default,,0,0,0,,{\i1}Sonunda bu turnuvada sayısız kez {\i0}
Dialogue: 0,0:03:19.07,0:03:21.75,Default,,0,0,0,,{\i1}denediği Drive Shot'u mükemmelleştirdi.{\i0}
Dialogue: 0,0:03:21.75,0:03:23.34,Default,,0,0,0,,Lanet olsun! Bu sadece bir şanstı, bilirsin!
Dialogue: 0,0:03:23.77,0:03:26.85,Default,,0,0,0,,Böyle bir şut sadece bir şans olabilir, bilirsin...
Dialogue: 0,0:03:26.85,0:03:29.56,Default,,0,0,0,,{\i1}İkinci yarı başlayalı sadece bir dakika oldu.{\i0}
Dialogue: 0,0:03:29.56,0:03:32.56,Default,,0,0,0,,{\i1}Hirado, bu turnuvada ilk kez bir gol yedi.{\i0}
Dialogue: 0,0:03:32.56,0:03:35.13,Default,,0,0,0,,Bu içeri dalma dönüşü muhteşemdi.
Dialogue: 0,0:03:35.13,0:03:36.69,Default,,0,0,0,,Bir top böyle düşebilir mi?
Dialogue: 0,0:03:36.69,0:03:38.69,Default,,0,0,0,,Ben buna sadece düşme demezdim.
Dialogue: 0,0:03:38.69,0:03:39.93,Default,,0,0,0,,Kelimenin tam anlamıyla dalmaktı!
Dialogue: 0,0:03:39.93,0:03:43.32,Default,,0,0,0,,Top hızlıca yüksekten ağ içine saldırdı.
Dialogue: 0,0:03:43.32,0:03:44.32,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:03:47.56,0:03:50.26,Default,,0,0,0,,{\i1}Dalmadan önce avını yakalamak için{\i0}
Dialogue: 0,0:03:50.26,0:03:52.98,Default,,0,0,0,,{\i1}kanatlarını gökyüzüne açan bir kuş gibiydi.{\i0}
Dialogue: 0,0:03:52.98,0:03:55.63,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:03:52.98,0:03:55.63,Default,,0,0,0,,{\i1}Tsubasa Ozora'nın Drive Shot'u işte bu.{\i0}
Dialogue: 0,0:03:56.25,0:04:00.75,Default,,0,0,0,,{\i1}Şimdiye kadar, girişimleri çarptı ya da kaçtı, ancak{\i0}
Dialogue: 0,0:04:00.75,0:04:05.24,Default,,0,0,0,,{\i1}bu sefer her ne pahasına olursa olsun, puan aldı.{\i0}
Dialogue: 0,0:04:05.78,0:04:09.08,Default,,0,0,0,,{\i1}Tüm bu baskıya rağmen, Tsubasa Ozora{\i0}
Dialogue: 0,0:04:09.08,0:04:12.44,Default,,0,0,0,,{\i1}sebat etti ve gerçek becerilerini ortaya çıkardı.{\i0}
Dialogue: 0,0:04:13.62,0:04:16.07,Default,,0,0,0,,{\i1}Ayrıca, omuz yaralanmasının neden olduğu{\i0}
Dialogue: 0,0:04:16.07,0:04:18.57,Default,,0,0,0,,{\i1}engelleri aştı ve bir anka kuşu gibi yeniden doğdu.{\i0}
Dialogue: 0,0:04:18.57,0:04:21.44,Default,,0,0,0,,{\i1}Gerçekten olağanüstü bir adamsın.{\i0}
Dialogue: 0,0:04:21.44,0:04:22.49,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:04:22.49,0:04:24.32,Default,,0,0,0,,Sonunda başardın, Tsubasa!
Dialogue: 0,0:04:24.32,0:04:26.82,Default,,0,0,0,,Harika! Harikasın Tsubasa!
Dialogue: 0,0:04:27.34,0:04:29.08,Default,,0,0,0,,{\i1}Nankatsu topu çaldı.{\i0}
Dialogue: 0,0:04:29.56,0:04:31.43,Default,,0,0,0,,{\i1}Hirado'dan bir gol aldıktan sonra, Nankatsu{\i0}
Dialogue: 0,0:04:31.43,0:04:33.34,Default,,0,0,0,,{\i1}Hirado'nun tarafına saldırmaya devam ediyor.{\i0}
Dialogue: 0,0:04:36.56,0:04:38.92,Default,,0,0,0,,{\i1}Hirado takımından Sano topu bir kez daha yakalıyor.{\i0}
Dialogue: 0,0:04:44.91,0:04:45.96,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:04:45.96,0:04:49.18,Default,,0,0,0,,{\i1}Tsubasa dikkatini dağıtdığı için top çalındı.{\i0}
Dialogue: 0,0:04:50.12,0:04:51.31,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:04:52.16,0:04:54.22,Default,,0,0,0,,{\i1}Ve Tsubasa'ya pas verildi!{\i0}
Dialogue: 0,0:04:54.22,0:04:56.65,Default,,0,0,0,,{\i1}Kombinasyon oyunları \Nmükemmel bir şekilde gerçekleştirildi!{\i0}
Dialogue: 0,0:05:04.82,0:05:07.82,Default,,0,0,0,,{\i1}Tsubasa geri dönüyor ve hemen uzun bir şut çekiyor!{\i0}
Dialogue: 0,0:05:07.82,0:05:08.70,Default,,0,0,0,,Ne!?
Dialogue: 0,0:05:12.57,0:05:14.53,Default,,0,0,0,,{\i1}İçerde!{\i0}
Dialogue: 0,0:05:14.53,0:05:16.42,Default,,0,0,0,,{\i1}Kaleci bir kasını bile hareket ettiremiyor.{\i0}
Dialogue: 0,0:05:17.14,0:05:18.93,Default,,0,0,0,,{\i1}Başka bir Drive Shot!{\i0}
Dialogue: 0,0:05:17.14,0:05:18.93,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:05:18.93,0:05:20.37,Default,,0,0,0,,{\i1}Tsubasa'dan ikinci gol!{\i0}
Dialogue: 0,0:05:20.37,0:05:22.42,Default,,0,0,0,,Güzel vuruş, Tsubasa!
Dialogue: 0,0:05:25.70,0:05:27.47,Default,,0,0,0,,{\i1}Oyunu tersine çevirmek için iki gole daha ihtiyacımız var.{\i0}
Dialogue: 0,0:05:27.92,0:05:29.64,Default,,0,0,0,,{\i1}İkinci yarının 3. dakikasındayız.{\i0}
Dialogue: 0,0:05:29.64,0:05:34.48,Default,,0,0,0,,{\i1}Tsubasa'nın ikinci Drive Shot'u sayesinde, fark bire indi.{\i0}
Dialogue: 0,0:05:29.64,0:05:34.48,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:05:34.48,0:05:37.73,Default,,0,0,0,,{\i1}Tsubasa Ozora ortaokul futbolunun süperstarı!{\i0}
Dialogue: 0,0:05:37.73,0:05:41.46,Default,,0,0,0,,{\i1}Yaralanmalarına rağmen, zafer\N için azimli olduğunu gösteriyor.{\i0}
Dialogue: 0,0:05:41.46,0:05:42.69,Default,,0,0,0,,{\i1} Sadece iki tane daha... {\i0}
Dialogue: 0,0:05:42.69,0:05:45.79,Default,,0,0,0,,{\i1}Omzumu veya bacağımı kalıcı olarak berbat{\i0}
Dialogue: 0,0:05:45.79,0:05:48.91,Default,,0,0,0,,{\i1}etsem bile, kesinlikle bu son iki golü atacağım!{\i0}
Dialogue: 0,0:05:49.46,0:05:51.19,Default,,0,0,0,,{\i1}Bu tanıdığım Tsubasa. {\i0}
Dialogue: 0,0:05:51.19,0:05:53.84,Default,,0,0,0,,{\i1}Böyle harika bir vuruşta ustalaşmak... {\i0}
Dialogue: 0,0:05:53.84,0:05:56.08,Default,,0,0,0,,{\i1}Mükemmel bir uzun şutun tanımı.{\i0}
Dialogue: 0,0:05:56.08,0:05:58.88,Default,,0,0,0,,{\i1}Bu son iki yılda ben kenara çekilirken,{\i0}
Dialogue: 0,0:05:58.88,0:06:02.09,Default,,0,0,0,,{\i1}Tsubasa bu kadarını geliştirmeyi başardı...{\i0}
Dialogue: 0,0:06:02.56,0:06:04.50,Default,,0,0,0,,{\i1}Mutluyum Tsubasa.{\i0}
Dialogue: 0,0:06:04.50,0:06:07.59,Default,,0,0,0,,{\i1}Böyle bir vuruşta ustalaştığını bilmiyordum.{\i0}
Dialogue: 0,0:06:07.59,0:06:13.35,Default,,0,0,0,,{\i1}Ama benim de sağ bacağıma\N uyan kendi süper vuruşum var...{\i0}
Dialogue: 0,0:06:14.03,0:06:17.87,Default,,0,0,0,,Tanrım... Gerçekten de Tsubasa Ozora'nın Drive Shot’nun,
Dialogue: 0,0:06:14.03,0:06:17.87,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:17.87,0:06:21.71,Default,,0,0,0,,Kojiro Hyuga'nın Tiger Shot’na\N karşı geldiğini görmek istiyorum.
Dialogue: 0,0:06:17.87,0:06:21.71,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:06:22.11,0:06:26.55,Default,,0,0,0,,Toho'nun ilk maçı sırasında, banktayken o atışını gördüm.
Dialogue: 0,0:06:26.55,0:06:29.80,Default,,0,0,0,,Bu yüzden "Tiger Shot" olarak adlandırdım.
Dialogue: 0,0:06:26.55,0:06:31.12,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:06:29.80,0:06:31.12,Default,,0,0,0,,Tiger Shot...
Dialogue: 0,0:06:31.12,0:06:33.29,Default,,0,0,0,,İyi bir izlenimi var, değil mi?
Dialogue: 0,0:06:33.29,0:06:35.37,Default,,0,0,0,,Ah, kendimi tanıtmalıyım.
Dialogue: 0,0:06:35.37,0:06:37.87,Default,,0,0,0,,Ben Toto Spordan Tajima.
Dialogue: 0,0:06:37.87,0:06:39.82,Default,,0,0,0,,Tanıştığıma memnun oldum.
Dialogue: 0,0:06:42.38,0:06:44.80,Default,,0,0,0,,TSUBASA OZORA \N DRIVE SHOT TAMAMLANDI!
Dialogue: 0,0:06:43.30,0:06:44.80,Default-TOP,,0,0,0,,Manşetimiz hazır.
Dialogue: 0,0:06:44.80,0:06:49.05,Default,,0,0,0,,Nankatsu kaybederse boşa gidecek, ama...
Dialogue: 0,0:06:49.05,0:06:51.05,Default,,0,0,0,,Kazandığından emin ol Tsubasa-kun!
Dialogue: 0,0:06:53.75,0:06:55.84,Default,,0,0,0,,{\i1}Hirado'nun Nankatsu'ya üstünlüğü bitti!{\i0}
Dialogue: 0,0:06:55.84,0:06:59.48,Default,,0,0,0,,{\i1}Şaşırtıcı bir şekilde, defansları Jito santra çizgisinde duruyor.{\i0}
Dialogue: 0,0:06:59.48,0:07:00.44,Default,,0,0,0,,Geliyorum, bilirsin!
Dialogue: 0,0:07:02.93,0:07:04.30,Default,,0,0,0,,{\i1}Oyun devam ediyor.{\i0}
Dialogue: 0,0:07:04.30,0:07:07.78,Default,,0,0,0,,{\i1}Sano topu Jito'ya bırakıyor\N ve Nankatsu'nun kalesine hızla koşuyor.{\i0}
Dialogue: 0,0:07:07.78,0:07:10.45,Default,,0,0,0,,Onu alacağım!
Dialogue: 0,0:07:10.45,0:07:11.30,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:11.30,0:07:13.28,Default,,0,0,0,,{\i1}Jito oralı bile değil!{\i0}
Dialogue: 0,0:07:13.91,0:07:15.28,Default,,0,0,0,,Kahretsin bu güçle...?!
Dialogue: 0,0:07:15.28,0:07:17.33,Default,,0,0,0,,{\i1}Sano hızla kaleye ilerliyor.{\i0}
Dialogue: 0,0:07:19.54,0:07:21.37,Default,,0,0,0,,{\i1}Sano savunmadan kurtuluyor.{\i0}
Dialogue: 0,0:07:23.31,0:07:24.74,Default,,0,0,0,,{\i1}İşte başlıyoruz, Sano.{\i0}
Dialogue: 0,0:07:24.74,0:07:27.10,Default,,0,0,0,,{\i1}Kombinasyon oyunumuz yenilmez, bilirsin!{\i0}
Dialogue: 0,0:07:27.10,0:07:29.08,Default,,0,0,0,,{\i1}Yediğimiz her golü geri alacağız, bilirsin!{\i0}
Dialogue: 0,0:07:29.08,0:07:31.09,Default,,0,0,0,,{\i1}Jito'nun özel mermi pası.{\i0}
Dialogue: 0,0:07:31.09,0:07:32.64,Default,,0,0,0,,Bildiğin gibi olmayacak!
Dialogue: 0,0:07:33.53,0:07:35.89,Default,,0,0,0,,{\i1}Izawa bütün vücudu ile engelliyor!{\i0}
Dialogue: 0,0:07:35.89,0:07:36.64,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:36.64,0:07:37.68,Default,,0,0,0,,Izawa!
Dialogue: 0,0:07:41.23,0:07:43.45,Default,,0,0,0,,Izawa'nın fedakarlığının boşa gitmesine izin verme!
Dialogue: 0,0:07:43.45,0:07:44.98,Default,,0,0,0,,Bu herifi tutacağız!
Dialogue: 0,0:07:44.98,0:07:47.90,Default,,0,0,0,,Lanet olsun! O zaman kendim yapmam gerekecek, bilirsin!
Dialogue: 0,0:07:50.82,0:07:54.82,Default,,0,0,0,,Morisaki, olduğun yerde kal! Bu seferki de geri dönecek!
Dialogue: 0,0:07:54.82,0:07:55.57,Default,,0,0,0,,Nasıl!?
Dialogue: 0,0:07:55.57,0:07:56.95,Default,,0,0,0,,Anladım Tsubasa!
Dialogue: 0,0:07:56.95,0:07:59.96,Default,,0,0,0,,Hiç açık vermeyin! Sano'yu tutmaya devam edeceğiz!
Dialogue: 0,0:07:59.96,0:08:00.33,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:03.00,0:08:05.58,Default,,0,0,0,,{\i1}Top geriye doğru dönüyor!{\i0}
Dialogue: 0,0:08:05.58,0:08:09.09,Default,,0,0,0,,Kaptanla olan kombinasyonum yenilmez...!
Dialogue: 0,0:08:12.42,0:08:13.50,Default,,0,0,0,,{\i1}Başardı! {\i0}
Dialogue: 0,0:08:13.50,0:08:15.50,Default,,0,0,0,,{\i1}Morisaki sıkıca yakaladı.{\i0}
Dialogue: 0,0:08:16.26,0:08:17.51,Default,,0,0,0,,Güzel, Morisaki!
Dialogue: 0,0:08:17.51,0:08:19.85,Default,,0,0,0,,Kombinasyon oyunumuz...
Dialogue: 0,0:08:19.85,0:08:21.02,Default,,0,0,0,,Gördün mü?
Dialogue: 0,0:08:21.02,0:08:23.60,Default,,0,0,0,,Bizi aynı eski numarayla iki kez kandıramazsın!
Dialogue: 0,0:08:23.60,0:08:26.11,Default,,0,0,0,,{\i1}Nankatsu'nun savunması da güçlendi.{\i0}
Dialogue: 0,0:08:26.11,0:08:27.11,Default,,0,0,0,,İşte!
Dialogue: 0,0:08:27.11,0:08:28.32,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:08:28.75,0:08:32.47,Default,,0,0,0,,{\i1}Top hızlı bir şekilde 10 numara Tsubasa'ya gönderildi.{\i0}
Dialogue: 0,0:08:38.41,0:08:42.25,Default,,0,0,0,,{\i1}Tsubasa hemen başka bir Drive Shot atacak mı?!{\i0}
Dialogue: 0,0:08:38.41,0:08:42.25,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:42.25,0:08:43.79,Default,,0,0,0,,Sana izin vermeyeceğim!
Dialogue: 0,0:08:44.47,0:08:47.46,Default,,0,0,0,,{\i1}Jito, Drive Shot’u engellemeye gidiyor.{\i0}
Dialogue: 0,0:08:44.47,0:08:47.46,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:08:48.67,0:08:51.17,Default,,0,0,0,,{\i1}Git!{\i0}
Dialogue: 0,0:08:53.23,0:08:55.30,Default,,0,0,0,,{\i1}Kan gördüm!{\i0}
Dialogue: 0,0:08:55.30,0:08:57.51,Default,,0,0,0,,{\i1}Top yan çizgiden çıkıyor.{\i0}
Dialogue: 0,0:08:57.51,0:08:58.51,Default,,0,0,0,,Jito!
Dialogue: 0,0:08:59.54,0:09:03.02,Default,,0,0,0,,{\i1}Görünüşe göre Jito Tsubasa'nın atışını doğrudan yüzü ile durdurdu.{\i0}
Dialogue: 0,0:09:04.15,0:09:06.98,Default,,0,0,0,,{\i1}Oyun tedavi görmesi için durduruldu.{\i0}
Dialogue: 0,0:09:08.13,0:09:09.70,Default,,0,0,0,,İyi misin Jito?
Dialogue: 0,0:09:09.70,0:09:10.48,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:09:11.58,0:09:16.98,Default,,0,0,0,,Oyunun ilk yarıda bittiğini sanıyordum, ama siz Nankatsu, bilirsin...
Dialogue: 0,0:09:16.98,0:09:22.38,Default,,0,0,0,,Kavgada her türlü yumruk yiyen \Nbenim, tek bir atışla kaşımı yarmak...
Dialogue: 0,0:09:22.38,0:09:25.96,Default,,0,0,0,,Drive Shot'un oldukça güçlü.
Dialogue: 0,0:09:22.38,0:09:25.96,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:09:25.96,0:09:29.96,Default,,0,0,0,,Tebrikler... Tebrikler, bilirsin,  Tsubasa Ozora!
Dialogue: 0,0:09:30.84,0:09:34.80,Default,,0,0,0,,Ama bunca zamandır bunu umuyordum.
Dialogue: 0,0:09:34.80,0:09:39.47,Default,,0,0,0,,Rakibim ne kadar büyük olursa,\N onları ezmek o kadar anlamlı olur.
Dialogue: 0,0:09:42.13,0:09:44.48,Default,,0,0,0,,Kaptanımızı duydun.
Dialogue: 0,0:09:44.48,0:09:47.40,Default,,0,0,0,,Gerçek maç şimdi başlıyor.
Dialogue: 0,0:09:53.51,0:09:56.61,Default,,0,0,0,,{\i1}Oyun Nankatsu'nun atışıyla devam ediyor.{\i0}
Dialogue: 0,0:09:57.61,0:09:58.45,Default,,0,0,0,,İşte başlıyorum!
Dialogue: 0,0:09:59.08,0:09:59.84,Default,,0,0,0,,Dikkatli olun!
Dialogue: 0,0:09:59.84,0:10:01.95,Default,,0,0,0,,Kalenin önüne gönderecek!
Dialogue: 0,0:10:02.40,0:10:04.70,Default,,0,0,0,,Kafa vuruşu ile gol atacağız!
Dialogue: 0,0:10:04.70,0:10:05.96,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:05.96,0:10:08.09,Default,,0,0,0,,{\i1}Sayıları önemli değil; sadece bir top var!{\i0}
Dialogue: 0,0:10:08.09,0:10:09.83,Default,,0,0,0,,{\i1}Yükseklik savaşını kaybetmeyeceğim, bilirsin!{\i0}
Dialogue: 0,0:10:12.09,0:10:12.75,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:12.75,0:10:13.96,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:13.96,0:10:15.96,Default,,0,0,0,,İşte, Tsubasa!
Dialogue: 0,0:10:15.96,0:10:17.96,Default,,0,0,0,,{\i1}Top Tsubasa'ya gönderildi!{\i0}
Dialogue: 0,0:10:17.96,0:10:21.93,Default,,0,0,0,,{\i1}Kalenin önündeki dört Nankatsu oyuncusu aldatmacaydı!{\i0}
Dialogue: 0,0:10:22.93,0:10:24.14,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:10:26.77,0:10:29.02,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:10:26.77,0:10:29.02,Default,,0,0,0,,Drive Shot'u durdurmadığımız sürece,
Dialogue: 0,0:10:29.02,0:10:31.27,Default,,0,0,0,,bu oyunu kazanma garantimiz yok!
Dialogue: 0,0:10:31.27,0:10:33.52,Default,,0,0,0,,{\i1}Sano Tsubasa'ya koşuyor!{\i0}
Dialogue: 0,0:10:33.52,0:10:37.53,Default,,0,0,0,,{\i1}Ancak Tsubasa'nın odak noktası top ve gol atmak!{\i0}
Dialogue: 0,0:10:37.53,0:10:39.36,Default,,0,0,0,,{\i1}Git!{\i0}
Dialogue: 0,0:10:39.36,0:10:41.12,Default,,0,0,0,,{\bord0\blur0.6\c&HFFF069&\4a&HFF&}Drive {\bord0\blur0.6\c&H3AFFFD&}Shot!
Dialogue: 0,0:10:39.36,0:10:41.12,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:10:43.27,0:10:45.83,Default,,0,0,0,,{\i1}Sano-kun havaya uçuyor!{\i0}
Dialogue: 0,0:10:47.88,0:10:48.83,Default,,0,0,0,,Sano!
Dialogue: 0,0:10:48.83,0:10:50.75,Default,,0,0,0,,{\i1}Top hala oyunda.{\i0}
Dialogue: 0,0:10:50.75,0:10:53.08,Default,,0,0,0,,{\i1}Tsubasa topa doğru koşuyor.{\i0}
Dialogue: 0,0:10:54.34,0:10:57.92,Default,,0,0,0,,{\i1}Yarının başlangıcından bu yana,\N skora karşı yoğun bir takıntısı var.{\i0}
Dialogue: 0,0:10:57.92,0:10:59.26,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:11:00.17,0:11:03.18,Default,,0,0,0,,{\i1}Tsubasa bugünkü beşinci Drive Shot için hazırlanıyor!{\i0}
Dialogue: 0,0:11:00.17,0:11:08.02,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:11:05.39,0:11:08.02,Default,,0,0,0,,Tsubasa! Drive Shot'u daha fazla kullanırsan...
Dialogue: 0,0:11:11.52,0:11:16.53,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:11:16.53,0:11:19.74,Default,,0,0,0,,{\i1}Tsubasa bugünkü beşinci Drive Shot için hazırlanıyor!{\i0}
Dialogue: 0,0:11:16.53,0:11:19.74,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:11:21.67,0:11:24.41,Default,,0,0,0,,{\i1}Jito onu engellemek için acele ediyor!{\i0}
Dialogue: 0,0:11:28.87,0:11:32.96,Default,,0,0,0,,{\i1}Oha! Jito Drive Shot'u doğrudan vücuduyla tutuyor!{\i0}
Dialogue: 0,0:11:28.87,0:11:32.96,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:11:33.79,0:11:36.55,Default,,0,0,0,,{\i1}Ama Jito'nun dev vücudu bile uçuyor!{\i0}
Dialogue: 0,0:11:38.71,0:11:41.15,Default,,0,0,0,,{\i1}Hirado, ısrarla kaleyi koruyor!{\i0}
Dialogue: 0,0:11:41.15,0:11:43.22,Default,,0,0,0,,{\i1}Rakiplerinin bu kadar kolay beraberlik sağlamalarına izin vermeyecekler.{\i0}
Dialogue: 0,0:11:43.22,0:11:46.72,Default,,0,0,0,,{\i1}Ah, Tsubasa bir kez daha topa doğru ilerliyor.{\i0}
Dialogue: 0,0:11:46.72,0:11:48.14,Default,,0,0,0,,{\i1}Henüz değil!{\i0}
Dialogue: 0,0:11:48.14,0:11:50.48,Default,,0,0,0,,{\i1}Drive Shot'um henüz mağlup edilmedi!{\i0}
Dialogue: 0,0:11:48.14,0:12:01.57,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:11:50.48,0:11:54.65,Default,,0,0,0,,{\i1}Roberto'nun öğrettiği Drive Shot yenilmez!{\i0}
Dialogue: 0,0:11:57.01,0:12:01.57,Default,,0,0,0,,{\i1}Altıncı ve üst üste üçüncü, Drive Shot!{\i0}
Dialogue: 0,0:12:01.57,0:12:05.03,Default,,0,0,0,,Lanet olsun, sanki bize yetişmene izin veririm!
Dialogue: 0,0:12:05.54,0:12:08.87,Default,,0,0,0,,{\i1}Jito tekrar savuşturmaya gidiyor!{\i0}
Dialogue: 0,0:12:12.92,0:12:16.17,Default,,0,0,0,,{\i1}Savunması gerçekten mücadele ruhunu gösteriyor!{\i0}
Dialogue: 0,0:12:18.70,0:12:20.81,Default,,0,0,0,,{\i1}Durdu!{\i0}
Dialogue: 0,0:12:22.95,0:12:25.93,Default,,0,0,0,,{\i1}A-Ama... Bu...{\i0}
Dialogue: 0,0:12:29.15,0:12:33.14,Default,,0,0,0,,{\i1}G... Gol! 3-3, oyun berabere!{\i0} 
Dialogue: 0,0:12:33.14,0:12:37.86,Default,,0,0,0,,{\i1}Jito, Drive Shot başarılı bir\N şekilde durdursa da, kale çizgisini aştı.{\i0}
Dialogue: 0,0:12:33.14,0:12:37.86,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:12:39.27,0:12:41.42,Default,,0,0,0,,İyi iş, Tsubasa!
Dialogue: 0,0:12:41.42,0:12:43.28,Default,,0,0,0,,Başardın, Tsubasa-senpai!
Dialogue: 0,0:12:44.04,0:12:45.28,Default,,0,0,0,,Başarısız oldum, bilirsin.
Dialogue: 0,0:12:46.06,0:12:49.06,Default,,0,0,0,,{\i1}Tsubasa üç atışı ile öne geçti ve{\i0}
Dialogue: 0,0:12:49.06,0:12:52.12,Default,,0,0,0,,{\i1} sonunda Jito'yu uçarak göndermeyi başardı.{\i0}
Dialogue: 0,0:12:52.12,0:12:54.70,Default,,0,0,0,,{\i1}Beraberlik golü, skoru 3-3 yaptı.{\i0}
Dialogue: 0,0:12:54.70,0:12:57.58,Default,,0,0,0,,{\i1}Drive Shot'uyla üst üste üç sayı aldı!{\i0}
Dialogue: 0,0:12:54.70,0:12:57.58,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:12:58.50,0:13:00.91,Default,,0,0,0,,Beraberlik, yakaladık.
Dialogue: 0,0:13:00.91,0:13:02.14,Default,,0,0,0,,Sadece bir tane daha kaldı.
Dialogue: 0,0:13:02.14,0:13:03.57,Default,,0,0,0,,Sadece bir gol daha.
Dialogue: 0,0:13:06.05,0:13:06.83,Default,,0,0,0,,{\an8}Tsubasa!
Dialogue: 0,0:13:06.83,0:13:07.47,Default,,0,0,0,,{\an8}Ne–
Dialogue: 0,0:13:08.22,0:13:09.10,Default,,0,0,0,,{\an8}Tsubasa!
Dialogue: 0,0:13:07.20,0:13:10.35,Default,,0,0,0,,{\i1}Altıncı bir Drive Shot'dan sonra kendini bıraktı mı?{\i0}
Dialogue: 0,0:13:07.20,0:13:10.35,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:13:10.35,0:13:13.12,Default,,0,0,0,,{\i1}Tsubasa bir kez daha yerde.{\i0}
Dialogue: 0,0:13:13.12,0:13:14.64,Default,,0,0,0,,Bir gol daha.
Dialogue: 0,0:13:14.64,0:13:16.10,Default,,0,0,0,,Sadece bir tane daha almalıyım.
Dialogue: 0,0:13:16.10,0:13:17.33,Default,,0,0,0,,Lanet olsun.
Dialogue: 0,0:13:17.33,0:13:18.71,Default,,0,0,0,,Skor eşit.
Dialogue: 0,0:13:18.71,0:13:20.61,Default,,0,0,0,,Kaybetmedik, bilirsin!
Dialogue: 0,0:13:20.61,0:13:21.66,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:13:21.66,0:13:22.76,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:25.09,0:13:26.82,Default,,0,0,0,,Yani oyun berabere, ha...?
Dialogue: 0,0:13:26.82,0:13:27.99,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:27.99,0:13:30.44,Default,,0,0,0,,Üzgünüm millet.
Dialogue: 0,0:13:30.44,0:13:32.83,Default,,0,0,0,,Kaptan olarak çok acınacak bir haldeyim, değil mi...?
Dialogue: 0,0:13:33.43,0:13:37.22,Default,,0,0,0,,Acınacak halde durmadan\N yere düşmeye devam ediyorum...
Dialogue: 0,0:13:37.22,0:13:38.87,Default,,0,0,0,,Neden bahsediyorsun, Tsubasa?!
Dialogue: 0,0:13:38.87,0:13:40.33,Default,,0,0,0,,Neden acınası olduğunu söyledin?!
Dialogue: 0,0:13:40.33,0:13:42.09,Default,,0,0,0,,Üç gol attıktan sonra bile...
Dialogue: 0,0:13:42.09,0:13:44.79,Default,,0,0,0,,Hey, Tsubasa, hadi biraz nefes al.
Dialogue: 0,0:13:44.79,0:13:47.51,Default,,0,0,0,,Kesinlikle tekrar puan almalarını durduracağız.
Dialogue: 0,0:13:47.51,0:13:50.55,Default,,0,0,0,,Oyunu döndürmek için hala zamanımız var.
Dialogue: 0,0:13:50.55,0:13:52.51,Default,,0,0,0,,Sen iyileşirken kendimizi zorlayacağız.
Dialogue: 0,0:13:53.21,0:13:54.51,Default,,0,0,0,,Tamam.
Dialogue: 0,0:13:54.51,0:13:56.02,Default,,0,0,0,,Teşekkürler, millet.
Dialogue: 0,0:13:57.68,0:13:59.27,Default,,0,0,0,,Hadi gel, Nankatsu!
Dialogue: 0,0:14:00.13,0:14:01.77,Default,,0,0,0,,Güç gösterisi şimdi başlıyor.
Dialogue: 0,0:14:04.73,0:14:05.78,Default,,0,0,0,,Sano...
Dialogue: 0,0:14:06.29,0:14:09.66,Default,,0,0,0,,Kahretsin, yine de... İki Drive Shot oldu, ha?
Dialogue: 0,0:14:06.29,0:14:09.66,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:14:09.66,0:14:12.83,Default,,0,0,0,,Bu, bir kavgada yediğim tekmelerden daha fazla acıtıyor.
Dialogue: 0,0:14:13.44,0:14:15.47,Default,,0,0,0,,{\i1}Şimdi Hirado liderliğinden vazgeçtiği{\i0}
Dialogue: 0,0:14:15.47,0:14:17.50,Default,,0,0,0,,{\i1}için, bu oyuna nasıl geri dönecekler?{\i0}
Dialogue: 0,0:14:18.02,0:14:20.93,Default,,0,0,0,,{\i1} Maç Hirado'nun vuruşuyla başlıyor.{\i0}
Dialogue: 0,0:14:20.93,0:14:23.25,Default,,0,0,0,,{\i1}Sadece başladığımız yere geri döndük.{\i0}
Dialogue: 0,0:14:24.80,0:14:26.42,Default,,0,0,0,,{\i1}İşte geliyorum Nankatsu!{\i0}
Dialogue: 0,0:14:26.42,0:14:30.47,Default,,0,0,0,,{\i1}Hirado'nun forvetinde, oyunu kazanan golü atacağım!{\i0}
Dialogue: 0,0:14:30.47,0:14:32.03,Default,,0,0,0,,Devam et, Hirado!
Dialogue: 0,0:14:32.03,0:14:32.97,Default,,0,0,0,,Sadece berabere!
Dialogue: 0,0:14:33.90,0:14:36.92,Default,,0,0,0,,{\i1}Kisugi ve Taki kolayca geride kaldı!{\i0}
Dialogue: 0,0:14:36.92,0:14:40.10,Default,,0,0,0,,{\i1}İkinci yarıda hareketleri hala durgun görünüyor.{\i0}
Dialogue: 0,0:14:41.61,0:14:46.57,Default,,0,0,0,,{\i1}Altıncı bir Drive Shot'dan sonra \NTsubasa bile çok yorgun görünüyor.{\i0}
Dialogue: 0,0:14:41.61,0:14:46.57,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:14:47.16,0:14:49.02,Default,,0,0,0,,Daha ileri gitmene izin vermeyeceğim!
Dialogue: 0,0:14:49.02,0:14:51.74,Default,,0,0,0,,{\i1}Bu şartlar altında güvenebilecekleri kişi o mu?{\i0}
Dialogue: 0,0:14:55.88,0:14:59.04,Default,,0,0,0,,{\i1}Hangisi bu yüzleşmeyi kazanacak?{\i0}
Dialogue: 0,0:15:01.03,0:15:01.87,Default,,0,0,0,,Ne–
Dialogue: 0,0:15:01.87,0:15:04.04,Default,,0,0,0,,{\i1}Ishizaki topu çaldı! {\i0}
Dialogue: 0,0:15:06.04,0:15:08.22,Default,,0,0,0,,Depoda hala çok fazla şey var!
Dialogue: 0,0:15:08.22,0:15:09.69,Default,,0,0,0,,Planladığın gibi gitmeyecek!
Dialogue: 0,0:15:09.69,0:15:12.52,Default,,0,0,0,,Sonsuza dek Jito ve Sano'ya güvenmeyi planlamıyoruz!
Dialogue: 0,0:15:12.52,0:15:14.97,Default,,0,0,0,,Biz de Hirado üyesiyiz!
Dialogue: 0,0:15:14.97,0:15:15.89,Default,,0,0,0,,Oha!
Dialogue: 0,0:15:16.98,0:15:18.02,Default,,0,0,0,,Hah?!
Dialogue: 0,0:15:18.02,0:15:19.89,Default,,0,0,0,,{\i1} Ishizaki topu kaybediyor.{\i0}
Dialogue: 0,0:15:19.89,0:15:21.40,Default,,0,0,0,,Millet...
Dialogue: 0,0:15:21.40,0:15:23.75,Default,,0,0,0,,Bu senin sayende, Jito.
Dialogue: 0,0:15:23.75,0:15:24.40,Default,,0,0,0,,Hah?
Dialogue: 0,0:15:24.40,0:15:26.99,Default,,0,0,0,,Ciddiyetle futbol oynamaya başladığın 
Dialogue: 0,0:15:26.99,0:15:29.57,Default,,0,0,0,,için, diğerleri bu kadar iyi yapabildi.
Dialogue: 0,0:15:30.11,0:15:33.82,Default,,0,0,0,,Şimdiye dek, şampiyon Nankatsu’ya meydan okuyabildiler.
Dialogue: 0,0:15:33.82,0:15:37.58,Default,,0,0,0,,Futbol takımı için en az 11 kişi gerekiyor.
Dialogue: 0,0:15:38.45,0:15:41.00,Default,,0,0,0,,Evet... Kesinlikle haklısın.
Dialogue: 0,0:15:41.00,0:15:42.87,Default,,0,0,0,,{\i1}İkinci yarıda zaman tükeniyor.{\i0}
Dialogue: 0,0:15:42.87,0:15:45.50,Default,,0,0,0,,{\i1}Bir sonraki gol bu maçın galibini belirleyecek.{\i0}
Dialogue: 0,0:15:45.50,0:15:47.00,Default,,0,0,0,,Buraya gönder, bilirsin!
Dialogue: 0,0:15:47.58,0:15:49.72,Default,,0,0,0,,{\i1}Jito hızla ön çizgiye ilerliyor!{\i0}
Dialogue: 0,0:15:49.72,0:15:51.26,Default,,0,0,0,,{\i1}Beş dakika kaldı!{\i0}
Dialogue: 0,0:15:51.67,0:15:52.93,Default,,0,0,0,,{\i1}Top Jito'ya gönderildi.{\i0}
Dialogue: 0,0:15:56.25,0:15:57.97,Default,,0,0,0,,{\i1}Ama pas çok yüksek!{\i0}
Dialogue: 0,0:15:57.97,0:15:59.47,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:16:01.81,0:16:05.31,Default,,0,0,0,,{\i1}Sano doğrudan bir tepegöz tekmesi için yükseldi!{\i0}
Dialogue: 0,0:16:05.31,0:16:07.05,Default,,0,0,0,,{\i1}Bu Tsubasa-kun!{\i0}
Dialogue: 0,0:16:07.05,0:16:08.73,Default,,0,0,0,,{\i1}Tsubasa-kun sahip olduğu her şeyle zıpladı!{\i0}
Dialogue: 0,0:16:08.73,0:16:10.19,Default,,0,0,0,,Teşekkürler, Tsubasa!
Dialogue: 0,0:16:10.89,0:16:12.79,Default,,0,0,0,,{\i1}Morisaki bir dalış yakalaması yapıyor!{\i0}
Dialogue: 0,0:16:12.79,0:16:13.82,Default,,0,0,0,,{\i1} Durdular!{\i0}
Dialogue: 0,0:16:13.82,0:16:14.82,Default,,0,0,0,,{\i1} Nankatsu onları durdurdu!{\i0}
Dialogue: 0,0:16:17.12,0:16:18.04,Default,,0,0,0,,Hadi, Morisaki!
Dialogue: 0,0:16:18.04,0:16:18.66,Default,,0,0,0,,Fırlat! 
Dialogue: 0,0:16:19.48,0:16:20.37,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:22.94,0:16:24.67,Default,,0,0,0,,{\i1}Top şimdi Tsubasa'ya ulaşıyor. {\i0}
Dialogue: 0,0:16:24.67,0:16:26.25,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:16:26.25,0:16:27.77,Default,,0,0,0,,Geri dönün!
Dialogue: 0,0:16:27.77,0:16:29.26,Default,,0,0,0,,{\i1}Dört dakika kaldı! {\i0}
Dialogue: 0,0:16:29.26,0:16:30.92,Default,,0,0,0,,{\i1}Nankatsu karşı saldırı yapıyor!{\i0}
Dialogue: 0,0:16:31.31,0:16:32.81,Default,,0,0,0,,Git, Tsubasa!
Dialogue: 0,0:16:32.81,0:16:35.43,Default,,0,0,0,,Sonunda her şey sana bağlı!
Dialogue: 0,0:16:35.95,0:16:37.05,Default,,0,0,0,,{\i1} Bir tane daha! {\i0}
Dialogue: 0,0:16:37.05,0:16:39.19,Default,,0,0,0,,{\i1}Bir atış daha skoru belirleyecek.{\i0}
Dialogue: 0,0:16:39.19,0:16:42.18,Default,,0,0,0,,{\i1}Kaleyi görene kadar koşacağım! {\i0}
Dialogue: 0,0:16:42.18,0:16:46.42,Default,,0,0,0,,{\i1}Tsubasa'nın top sürme hızı sürat koşusu kadar hızlı.{\i0}
Dialogue: 0,0:16:46.42,0:16:51.63,Default,,0,0,0,,{\i1}Ne de olsa futbol oynamak için doğmuş gibi hissediyor!{\i0}
Dialogue: 0,0:16:51.63,0:16:53.75,Default,,0,0,0,,Devam et, Tsubasa!
Dialogue: 0,0:16:53.75,0:16:55.90,Default,,0,0,0,,{\i1}Tsubasa çok, çok hızlı! {\i0}
Dialogue: 0,0:16:55.90,0:16:58.95,Default,,0,0,0,,{\i1}Hirado'da kimse yetişemiyor!{\i0}
Dialogue: 0,0:16:59.38,0:17:01.20,Default,,0,0,0,,{\i1}Görüyorum.{\i0}
Dialogue: 0,0:17:01.20,0:17:02.43,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:17:03.99,0:17:07.17,Default,,0,0,0,,{\i1}Yani tüm yaralanmalarına rağmen, başka{\i0}
Dialogue: 0,0:17:07.17,0:17:10.38,Default,,0,0,0,,{\i1}bir Drive Shot mu atacaksın, Tsubasa Ozora?{\i0}
Dialogue: 0,0:17:07.17,0:17:10.38,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:10.38,0:17:13.97,Default,,0,0,0,,{\i1}Eğer durum buysa, sen tükenene kadar,{\i0}
Dialogue: 0,0:17:13.97,0:17:16.22,Default,,0,0,0,,{\i1}yapabildiğim kadar baş edeceğim,bilirisin!{\i0}
Dialogue: 0,0:17:16.64,0:17:19.64,Default,,0,0,0,,{\i1}Millet, fazlasıyla dinlenmeme izin verdiniz.{\i0}
Dialogue: 0,0:17:19.64,0:17:23.43,Default,,0,0,0,,{\i1}Yani bu sefer kazanan skorunu atacağım!{\i0}
Dialogue: 0,0:17:24.13,0:17:25.85,Default,,0,0,0,,{\i1}Vurmadan önce seni durduracağım!{\i0}
Dialogue: 0,0:17:30.61,0:17:32.78,Default,,0,0,0,,{\i1} Ne hızlı bir vuruş!{\i0}
Dialogue: 0,0:17:34.28,0:17:35.70,Default,,0,0,0,,Gel, Tsubasa!
Dialogue: 0,0:17:39.92,0:17:41.21,Default,,0,0,0,,{\i1}Tsubasa'ya ne oldu?{\i0}
Dialogue: 0,0:17:41.21,0:17:42.77,Default,,0,0,0,,{\i1}Şaşırtıcı!{\i0}
Dialogue: 0,0:17:42.77,0:17:43.46,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:43.46,0:17:44.71,Default,,0,0,0,,Noldu?!
Dialogue: 0,0:17:44.71,0:17:46.98,Default,,0,0,0,,{\i1}İyi değil.{\i0}
Dialogue: 0,0:17:46.98,0:17:49.21,Default,,0,0,0,,{\i1}Güçsüzüm...{\i0}
Dialogue: 0,0:17:49.21,0:17:50.96,Default,,0,0,0,,Demek enerjin tükendi, ha, Tsubasa?!
Dialogue: 0,0:17:54.32,0:17:55.31,Default,,0,0,0,,{\i1}Tsubasa!{\i0}
Dialogue: 0,0:17:55.31,0:17:56.30,Default,,0,0,0,,{\i1}Tsubasa-kun.{\i0}
Dialogue: 0,0:17:56.30,0:17:58.19,Default,,0,0,0,,{\i1}Onlara güven. {\i0}
Dialogue: 0,0:17:58.19,0:17:59.43,Default,,0,0,0,,{\i1}Doğru, Tsubasa.{\i0}
Dialogue: 0,0:17:59.43,0:18:01.85,Default,,0,0,0,,{\i1}Futbol 11 kişiyle oynanmıyor mu?{\i0}
Dialogue: 0,0:18:01.85,0:18:04.14,Default,,0,0,0,,{\i1}Misaki-kun, Wakabayashi-kun...{\i0}
Dialogue: 0,0:18:04.71,0:18:06.41,Default,,0,0,0,,{\i1}Tam olarak dedikleri gibi, Tsubasa.{\i0}
Dialogue: 0,0:18:06.41,0:18:08.94,Default,,0,0,0,,{\i1}Tek başına futbol oynayamazsın.{\i0}
Dialogue: 0,0:18:08.94,0:18:10.09,Default,,0,0,0,,{\i1}Roberto!{\i0}
Dialogue: 0,0:18:14.26,0:18:14.90,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:18:15.80,0:18:17.65,Default,,0,0,0,,{\i1}Size güveniyorum... Kisugi, Taki.{\i0}
Dialogue: 0,0:18:17.65,0:18:20.23,Default,,0,0,0,,Hadi gidelim! Bu bizim son şansımız!
Dialogue: 0,0:18:20.23,0:18:23.20,Default,,0,0,0,,Tsubasa'dan aldığımız bu topu kesin olarak kaleye sokacağız!
Dialogue: 0,0:18:23.20,0:18:25.13,Default,,0,0,0,,Eğer sadece ikisi ise, bu iyi!
Dialogue: 0,0:18:25.13,0:18:26.91,Default,,0,0,0,,Paslarını kolayca kesebiliriz.
Dialogue: 0,0:18:26.91,0:18:29.25,Default,,0,0,0,,Artık bizi aptal yerine koymanıza izin vermeyeceğiz!
Dialogue: 0,0:18:29.25,0:18:30.48,Default,,0,0,0,,Gidelim Kisugi!
Dialogue: 0,0:18:30.48,0:18:31.04,Default,,0,0,0,,Tamam!
Dialogue: 0,0:18:31.04,0:18:33.96,Default,,0,0,0,,{\i1}Kolayca bir dizi harika bir-iki pas attılar.{\i0}
Dialogue: 0,0:18:33.96,0:18:36.38,Default,,0,0,0,,{\i1}Mükemmel senkronizasyon içindeler!{\i0}
Dialogue: 0,0:18:36.38,0:18:37.89,Default,,0,0,0,,Tabii ki!
Dialogue: 0,0:18:37.89,0:18:40.97,Default,,0,0,0,,İlkokuldan beri bir ikili oluşturduk!
Dialogue: 0,0:18:40.97,0:18:44.42,Default,,0,0,0,,Misaki ve Tsubasa'nın Altın İkilisi ile karşılaştırılamayız,
Dialogue: 0,0:18:44.42,0:18:46.98,Default,,0,0,0,,ama kesinlikle çok başarılıyız!
Dialogue: 0,0:18:47.66,0:18:49.93,Default,,0,0,0,,Seni bir kez daha uçuracağım!
Dialogue: 0,0:18:49.93,0:18:51.48,Default,,0,0,0,,Bunun tekrar olmasına izin vermişim gibi!
Dialogue: 0,0:18:52.58,0:18:53.52,Default,,0,0,0,,Ne?! 
Dialogue: 0,0:18:55.28,0:19:01.16,Default,,0,0,0,,Shutetsu'nun eski golcüsü Teppei\N Kisugi, Nankatsu'nun golcüsü oldu!
Dialogue: 0,0:19:03.12,0:19:05.31,Default,,0,0,0,,{\i1}İçerde! Gol!{\i0}
Dialogue: 0,0:19:05.31,0:19:06.76,Default,,0,0,0,,Evet be, Kisugi!
Dialogue: 0,0:19:06.76,0:19:08.08,Default,,0,0,0,,Başardı!
Dialogue: 0,0:19:09.71,0:19:10.83,Default,,0,0,0,,Sonunda.
Dialogue: 0,0:19:10.83,0:19:12.08,Default,,0,0,0,,Nankatsu...
Dialogue: 0,0:19:12.08,0:19:13.69,Default,,0,0,0,,{\i1}Sadece bir dakika kaldı.{\i0}
Dialogue: 0,0:19:13.69,0:19:15.59,Default,,0,0,0,,{\i1}Nankatsu sonunda geri dönüş yaptı.{\i0}
Dialogue: 0,0:19:15.59,0:19:20.05,Default,,0,0,0,,{\i1}Taki ve Kisugi dördüncü golü attı!{\i0}
Dialogue: 0,0:19:20.05,0:19:24.51,Default,,0,0,0,,{\i1}Doğru, futbol 11 kişiyle oynanıyor.{\i0}
Dialogue: 0,0:19:24.51,0:19:26.51,Default,,0,0,0,,{\i1}Arkadaşlarına güvenmelisin.{\i0}
Dialogue: 0,0:19:26.51,0:19:28.56,Default,,0,0,0,,Kisugi, Taki.
Dialogue: 0,0:19:28.56,0:19:30.56,Default,,0,0,0,,Teşekkürler!
Dialogue: 0,0:19:30.56,0:19:32.33,Default,,0,0,0,,Çocuk oyuncağıydı!
Dialogue: 0,0:19:32.33,0:19:35.07,Default,,0,0,0,,Siz de savunma konusunda iyi iş çıkardınız!
Dialogue: 0,0:19:35.07,0:19:37.09,Default,,0,0,0,,O golde payı vardı!
Dialogue: 0,0:19:37.09,0:19:39.31,Default,,0,0,0,,Tsubasa senpai gerçekten harika!
Dialogue: 0,0:19:39.31,0:19:42.65,Default,,0,0,0,,Ah sen... Kisugi ve Taki'yi de neşelendirmeyi unutma!
Dialogue: 0,0:19:42.65,0:19:45.58,Default,,0,0,0,,Bir dakika daha var, savunma yapmalıyız.
Dialogue: 0,0:19:56.34,0:19:58.84,Default,,0,0,0,,Git!
Dialogue: 0,0:20:00.02,0:20:01.68,Default,,0,0,0,,{\i1}Maç burada bitiyor!{\i0}
Dialogue: 0,0:20:01.68,0:20:03.25,Default,,0,0,0,,{\i1} 4-3!{\i0}
Dialogue: 0,0:20:03.25,0:20:05.63,Default,,0,0,0,,{\i1}Nankatsu kılpayı oyunu kazandı!{\i0}
Dialogue: 0,0:20:05.63,0:20:09.30,Default,,0,0,0,,{\i1}Pek çok zorluğa rağmen, üst üste \Nüçüncü yıl en iyi dörtde yerlerini alıyorlar!{\i0}
Dialogue: 0,0:20:09.30,0:20:12.11,Default,,0,0,0,,{\i1}İlk üç ardışık şampiyonadan iki maç oldu.{\i0}
Dialogue: 0,0:20:12.11,0:20:13.06,Default,,0,0,0,,Kazandık!
Dialogue: 0,0:20:13.06,0:20:15.10,Default,,0,0,0,,Sonuçta Nankatsu olacak gibi görünüyor.
Dialogue: 0,0:20:15.10,0:20:15.65,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:16.35,0:20:18.15,Default,,0,0,0,,Yani kazandın, Tsubasa.
Dialogue: 0,0:20:18.15,0:20:20.21,Default,,0,0,0,,Başardın Tsubasa!
Dialogue: 0,0:20:20.21,0:20:23.66,Default,,0,0,0,,Drive Shot'unu mükemmelleştirdiğin gibi kaybedersen çok kötü olurdu.
Dialogue: 0,0:20:20.21,0:20:23.66,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:20:24.32,0:20:26.16,Default,,0,0,0,,Başardın, Tsubasa.
Dialogue: 0,0:20:26.16,0:20:28.64,Default,,0,0,0,,{\i1}Hirado, şampiyon Nankatsu ile ilk kez{\i0}
Dialogue: 0,0:20:28.64,0:20:31.12,Default,,0,0,0,,{\i1} yarışmasına rağmen iyi bir iş çıkardı.{\i0}
Dialogue: 0,0:20:31.61,0:20:35.37,Default,,0,0,0,,{\i1}Bununla birlikte, oyunu eşitleyen Tsubasa'nın Drive Shot'u,{\i0}
Dialogue: 0,0:20:31.61,0:20:35.37,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:20:35.37,0:20:37.48,Default,,0,0,0,,{\i1}oyunun can alıcı noktasıydı.{\i0}
Dialogue: 0,0:20:37.48,0:20:40.97,Default,,0,0,0,,{\i1}Galibiyet Kisugi ile Taki arasındaki\N mükemmel bir kombinasyondan geldi.{\i0}
Dialogue: 0,0:20:40.97,0:20:45.14,Default,,0,0,0,,{\i1}Gerçekten bir takım olarak bir\N araya geldiler ve yarı finale girdiler.{\i0}
Dialogue: 0,0:20:45.73,0:20:48.89,Default,,0,0,0,,Sonuçta, Nankatsu'nun takım\N çalışması onları zafere götürdü.
Dialogue: 0,0:20:49.95,0:20:52.89,Default,,0,0,0,,Şimdi ikimizin de oynayacağı bir oyun daha var, Tsubasa.
Dialogue: 0,0:20:52.89,0:20:54.02,Default,,0,0,0,,Lanet olsun.
Dialogue: 0,0:20:54.02,0:20:54.64,Default,,0,0,0,,Lanet olsun...
Dialogue: 0,0:20:54.64,0:20:56.16,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:20:57.87,0:21:01.03,Default,,0,0,0,,Bu kayıp uzun zaman önceydi, bilirsin...
Dialogue: 0,0:21:01.03,0:21:03.45,Default,,0,0,0,,{\i1}Kaybetmek gerçekten acı veriyor.{\i0}
Dialogue: 0,0:21:03.45,0:21:06.03,Default,,0,0,0,,{\i1}Ancak, garip bir şekilde tazelenmiş hissediyorum, bilirsin.{\i0}
Dialogue: 0,0:21:07.98,0:21:09.24,Default,,0,0,0,,Ayağa kalk, Sano.
Dialogue: 0,0:21:09.24,0:21:10.04,Default,,0,0,0,,Kaptan.
Dialogue: 0,0:21:10.46,0:21:11.63,Default,,0,0,0,,Ağlama.
Dialogue: 0,0:21:11.63,0:21:13.83,Default,,0,0,0,,Daha bir yılın var, bilirsin.
Dialogue: 0,0:21:13.83,0:21:18.20,Default,,0,0,0,,Seneye de buraya geldiğinden emin ol ve bu sefer kazan!
Dialogue: 0,0:21:18.20,0:21:18.92,Default,,0,0,0,,Evet!
Dialogue: 0,0:21:20.71,0:21:22.42,Default,,0,0,0,,{\i1}Tsubasa Ozora...{\i0}
Dialogue: 0,0:21:22.42,0:21:25.84,Default,,0,0,0,,{\i1}Benim için bir yıllık bir yolculuk olacaktı.{\i0}
Dialogue: 0,0:21:25.84,0:21:28.12,Default,,0,0,0,,{\i1}Ama şimdi seni yenene kadar futbol{\i0}
Dialogue: 0,0:21:28.12,0:21:30.43,Default,,0,0,0,,{\i1}oynamayı bırakabileceğimi sanmıyorum.{\i0}
Dialogue: 0,0:21:31.01,0:21:33.50,Default,,0,0,0,,{\i1}Bundan önce, sen sadece bir kavgacıydın...{\i0}
Dialogue: 0,0:21:33.50,0:21:35.69,Default,,0,0,0,,Büyümenle gerçekten gurur duyuyorum Hiroshi-kun.
Dialogue: 0,0:21:40.66,0:21:45.41,Default,,0,0,0,,{\i1}Kazananlar ve ilerleyenler var, ayrıca \Nkaybedenler ve ortadan kaldırılılanlar.{\i0}
Dialogue: 0,0:21:45.41,0:21:50.35,Default,,0,0,0,,{\i1}Ülkenin dört bir yanından gelen 47 takımla düzenlenen bu turnuvada,{\i0}
Dialogue: 0,0:21:50.35,0:21:54.96,Default,,0,0,0,,{\i1}sonunda en iyi dört takım belirlendi.{\i0}
Dialogue: 0,0:21:54.96,0:21:59.88,Default,,0,0,0,,{\i1}Önceki şampiyonlar, Nankatsu\N Ortaokulu, Shizuoka'yı temsil ediyor.{\i0}
Dialogue: 0,0:22:00.59,0:22:03.76,Default,,0,0,0,,{\i1}Hokkaido'yu temsil eden Furano Ortaokulu.{\i0}
Dialogue: 0,0:22:04.29,0:22:07.76,Default,,0,0,0,,{\i1}Saitama Eyaletini temsil eden Meiwa Higashi Ortaokulu.{\i0}
Dialogue: 0,0:22:08.74,0:22:11.76,Default,,0,0,0,,Toho Akademisi, Tokyo'yu temsil ediyor. 
Dialogue: 0,0:22:12.88,0:22:19.52,Default,,0,0,0,,{\i1}Yarın, bu dört takım, büyük final koltuğu için savaşacak.{\i0}
Dialogue: 0,0:22:19.52,0:22:34.52,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:48.98,0:24:08.98,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:23:48.98,0:24:01.98,Default,,0,0,0,,43. BÖLÜM: \NŞİDDETLİ KAPLAN ATEŞİ YAKAR
Dialogue: 0,0:00:30.26,0:00:32.97,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:33.88,0:00:36.55,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:37.47,0:00:40.18,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:47.06,0:00:49.90,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:00:49.90,0:00:56.16,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:00:56.16,0:01:02.04,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta no ni
Dialogue: 0,0:01:02.04,0:01:08.63,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:01:08.63,0:01:12.63,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:12.63,0:01:17.14,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:17.14,0:01:22.72,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:01:22.72,0:01:24.27,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:01:24.27,0:01:25.48,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:25.48,0:01:28.98,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:01:28.98,0:01:38.87,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:01:38.87,0:01:39.70,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:39.70,0:01:43.49,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:01:43.49,0:01:47.50,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:01:47.50,0:01:53.76,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:01:53.76,0:01:56.55,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:00:30.26,0:00:32.97,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:33.88,0:00:36.55,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:37.47,0:00:40.18,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:47.06,0:00:49.90,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum. 
Dialogue: 0,0:00:49.90,0:00:56.16,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:00:56.16,0:01:02.04,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:02.04,0:01:08.63,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:08.63,0:01:12.63,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:12.63,0:01:17.14,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:01:17.14,0:01:22.72,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:01:22.72,0:01:24.27,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:01:24.27,0:01:25.48,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:25.48,0:01:28.98,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:01:28.98,0:01:38.87,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:01:38.87,0:01:39.70,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:39.70,0:01:43.49,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:01:43.49,0:01:47.50,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:01:47.50,0:01:53.76,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:01:53.76,0:01:56.55,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.25,0:22:44.30,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.30,0:22:50.30,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.30,0:22:56.35,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.35,0:23:00.98,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.61,0:23:07.28,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.61,0:23:14.70,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.70,0:23:20.75,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:20.75,0:23:25.21,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.50,0:23:32.84,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:32.84,0:23:38.89,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:38.89,0:23:45.19,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.25,0:22:44.30,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.30,0:22:50.30,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.30,0:22:56.35,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.35,0:23:00.98,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.61,0:23:07.28,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.61,0:23:14.70,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.70,0:23:20.75,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:20.75,0:23:25.21,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.50,0:23:32.84,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:32.84,0:23:38.89,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:38.89,0:23:45.19,OPED,,0,0,0,,Bu hırslı gençlik sahada!
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
