Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:00.92,0:00:03.28,Default - i,,0,0,0,,Şampiyon Nankatsu ve Toho Akademi arasındaki maç,
Dialogue: 0,0:00:03.28,0:00:06.28,Default - i,,0,0,0,,Ulusal Ortaokul Futbol Turnuvasının finallerinde,
Dialogue: 0,0:00:06.28,0:00:09.15,Default - i,,0,0,0,,3-3'lük bir skorla uzatmalara gidiliyor!
Dialogue: 0,0:00:09.15,0:00:12.16,Default - i,,0,0,0,,Uzatmalar, her biri 10 dakikalık iki yarıdan oluşacak.
Dialogue: 0,0:00:12.16,0:00:14.65,Default - i,,0,0,0,,Eğer maç bundan sonra bile bir sonuca ulaşamazsa,
Dialogue: 0,0:00:14.65,0:00:17.28,Default - i,,0,0,0,,her iki takım da kazanan olarak ilan edilecek.
Dialogue: 0,0:00:17.28,0:00:19.88,Default - i,,0,0,0,,Nankatsu'nun Kaptanı Ozora Tsubasa-kun, 
Dialogue: 0,0:00:19.88,0:00:22.65,Default - i,,0,0,0,,vücudundaki yaralanmalara rağmen uzatmalarda oynayacak.
Dialogue: 0,0:00:22.65,0:00:24.79,Default - i,,0,0,0,,Bu yarı Nankatsu'nun vuruşu ile başlayacak.
Dialogue: 0,0:00:24.79,0:00:29.01,Default - i,,0,0,0,,Bu maçta Drive Shot'a çok fazla güvendim.
Dialogue: 0,0:00:24.79,0:00:32.37,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:00:29.01,0:00:32.37,Default - i,,0,0,0,,Sadece Drive Shot'la gol atmayı düşündüm.
Dialogue: 0,0:00:32.37,0:00:36.55,Default - i,,0,0,0,,Hala aşırı derecede Roberto'ya güvendiğimi gösteriyor.
Dialogue: 0,0:00:36.55,0:00:38.39,Default - i,,0,0,0,,Sadece Roberto değil.
Dialogue: 0,0:00:38.39,0:00:45.60,Default - i,,0,0,0,,Misaki-kun, Wakabayashi-kun, \NIshizaki-kun, Nankatsu Onbiri ve Menejer...
Dialogue: 0,0:00:43.64,0:00:44.60,Default-TOP,,0,0,0,,Savaşın!
Dialogue: 0,0:00:44.60,0:00:45.60,Default-TOP,,0,0,0,,Kaybetmeyin!
Dialogue: 0,0:00:45.60,0:00:49.36,Default-TOP,,0,0,0,,Savaş! Savaş! Nankatsu!
Dialogue: 0,0:00:46.45,0:00:49.36,Default - i,,0,0,0,,Yardımları sayesinde bu kadarını yaptım.
Dialogue: 0,0:00:49.36,0:00:51.60,Default - i,,0,0,0,,Ama bundan sonra, yalnız olacağım...
Dialogue: 0,0:00:51.60,0:00:54.35,Default - i,,0,0,0,,Turnuvada 3.şampiyonluğumu tamamladıktan sonra, 
Dialogue: 0,0:00:54.35,0:00:56.74,Default - i,,0,0,0,,Brezilya'ya gittiğimde yalnız olacağım.
Dialogue: 0,0:00:57.20,0:00:58.92,Default - i,,0,0,0,,Teşekkürler millet.
Dialogue: 0,0:00:58.92,0:01:00.87,Default - i,,0,0,0,,Şimdiye kadar ki her şey için teşekkür ederim.
Dialogue: 0,0:01:01.87,0:01:04.91,Default - i,,0,0,0,,Ben, 15 yaşındaki Tsubasa Ozora, Japonya'daki 
Dialogue: 0,0:01:04.91,0:01:07.96,Default - i,,0,0,0,,son golümü atacağım ve yolculuğuma başlayacağım.
Dialogue: 0,0:01:07.96,0:01:22.96,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \N{\c&HB1351A&}İnstagram: AnimeSeverlerrr
Dialogue: 0,0:02:38.26,0:02:43.26,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}51. BÖLÜM: \NMUCİZE DRIVE SHOT!
Dialogue: 0,0:02:38.41,0:02:40.39,Default-TOP,,0,0,0,,{\i1}Uzatmalar başladı!{\i0}
Dialogue: 0,0:02:40.39,0:02:44.10,Default-TOP,,0,0,0,,{\i1}Tsubasa-kun Toho'nun sahasında yalnız başına top sürüyor.{\i0}
Dialogue: 0,0:02:44.10,0:02:46.42,Default,,0,0,0,,Tsubasa hareket edemeyecek kadar yorgun olmalı.
Dialogue: 0,0:02:46.42,0:02:47.85,Default,,0,0,0,,Onu mahvedeceğiz!
Dialogue: 0,0:02:49.73,0:02:50.73,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:50.73,0:02:52.66,Default - i,,0,0,0,,İkisini de bir anda geçti!
Dialogue: 0,0:02:52.66,0:02:55.94,Default - i,,0,0,0,,Tsubasa-san'ın içinde hala güç var.
Dialogue: 0,0:02:55.94,0:02:57.19,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:02:57.19,0:02:59.95,Default - i,,0,0,0,,Tsubasa-kun onlardan önce zıplar ve kaçar!
Dialogue: 0,0:03:00.62,0:03:01.70,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:01.70,0:03:04.67,Default - i,,0,0,0,,Tsubasa, ölümsüz müsün, nesin?!
Dialogue: 0,0:03:04.67,0:03:07.50,Default - i,,0,0,0,,Hala nasıl böyle zıplayabilirsin?!
Dialogue: 0,0:03:07.50,0:03:08.91,Default,,0,0,0,,Tsubasa-san!
Dialogue: 0,0:03:08.91,0:03:10.16,Default,,0,0,0,,Topu alacağım!
Dialogue: 0,0:03:12.64,0:03:16.38,Default - i,,0,0,0,,Tsubasa-kun topu her iki bacağıyla sıkıca bloke etti!
Dialogue: 0,0:03:18.01,0:03:20.13,Default - i,,0,0,0,,Skor yapana kadar geri vermeyeceğim!
Dialogue: 0,0:03:20.13,0:03:21.76,Default - i,,0,0,0,,Asla vermeyeceğim!
Dialogue: 0,0:03:21.76,0:03:24.14,Default,,0,0,0,,Durdurun! Tsubasa'yı durdurun!
Dialogue: 0,0:03:25.53,0:03:27.77,Default - i,,0,0,0,,Kahretsin, yine başladı.
Dialogue: 0,0:03:27.77,0:03:32.85,Default - i,,0,0,0,,Vücudum gerçekten sınırına ulaşıyor gibi görünüyor...
Dialogue: 0,0:03:33.37,0:03:36.81,Default - i,,0,0,0,,Ama... Bunu gole dönüştürmeliyim.
Dialogue: 0,0:03:36.81,0:03:39.28,Default - i,,0,0,0,,Veda golünü atacağım!
Dialogue: 0,0:03:41.85,0:03:44.23,Default - i,,0,0,0,,Harika! Ne harika bir tekniği var!
Dialogue: 0,0:03:44.23,0:03:45.24,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:45.24,0:03:46.28,Default,,0,0,0,,Tsubasa...!
Dialogue: 0,0:03:46.28,0:03:47.58,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:03:48.29,0:03:49.04,Default - i,,0,0,0,,Çok benziyor.
Dialogue: 0,0:03:49.72,0:03:55.33,Default - i,,0,0,0,,Tsubasa Nankatsu Şehrine taşındığında, tek arkadaşı futboldu.
Dialogue: 0,0:03:55.33,0:03:56.54,Default - i,,0,0,0,,Çok benziyor...
Dialogue: 0,0:03:56.54,0:04:02.51,Default - i,,0,0,0,,Tek başına Shutetsu ile arkadaşını geçtiğindeki haline çok benziyor...
Dialogue: 0,0:04:03.12,0:04:05.22,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:04:06.10,0:04:07.76,Default,,0,0,0,,Durduracağız!
Dialogue: 0,0:04:08.75,0:04:11.35,Default - i,,0,0,0,,Tüm yaralanmalarına rağmen, 
Dialogue: 0,0:04:11.35,0:04:14.09,Default - i,,0,0,0,,olağanüstü futbol anlayışı körelmiş değil!
Dialogue: 0,0:04:14.09,0:04:17.64,Default - i,,0,0,0,,Üstün yetenekli çok yönlü bir oyuncu!
Dialogue: 0,0:04:17.64,0:04:21.61,Default - i,,0,0,0,,Futbolun Hovarda Oğlu, Ozora Tsubasa-kun!
Dialogue: 0,0:04:22.36,0:04:26.12,Default - i,,0,0,0,,Sonunda Toho'nun tüm savunucularını geçmeyi başardı.
Dialogue: 0,0:04:28.00,0:04:29.10,Default - i,,0,0,0,,Gol...
Dialogue: 0,0:04:29.10,0:04:30.79,Default - i,,0,0,0,,Gol'ü görebiliyorum.
Dialogue: 0,0:04:30.79,0:04:32.50,Default - i,,0,0,0,,Kesin bu atışı yapacağım!
Dialogue: 0,0:04:34.00,0:04:38.00,Default - i,,0,0,0,,Ancak, Hyuga-kun niyetini görüp geride kaldı!
Dialogue: 0,0:04:38.00,0:04:39.31,Default,,0,0,0,,İşte geldim, Tsubasa!
Dialogue: 0,0:04:39.31,0:04:40.25,Default,,0,0,0,,Getirin onu!
Dialogue: 0,0:04:41.09,0:04:43.83,Default - i,,0,0,0,,Tsubasa-kun şut çekecek mi, yoksa önce Hyuga-kun mu durduracak?
Dialogue: 0,0:04:43.83,0:04:44.80,Default - i,,0,0,0,,Hangisi gerçekleşecek?
Dialogue: 0,0:04:46.42,0:04:49.94,Default,,0,0,0,,Sliding Tiger Shot!
Dialogue: 0,0:04:46.42,0:04:49.94,Default-TOP,,0,0,0,,Sliding Tiger Shot: Kayan Kaplan Vuruşu
Dialogue: 0,0:04:49.94,0:04:52.54,Default - i,,0,0,0,,Hyuga-kun bir anlık daha hızlıydı!
Dialogue: 0,0:04:52.54,0:04:53.98,Default - i,,0,0,0,,Tsubasa-kun topa vuramıyor!
Dialogue: 0,0:04:55.56,0:04:56.35,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:57.28,0:04:58.61,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:05:00.65,0:05:03.30,Default,,0,0,0,,Ishizaki-kun...
Dialogue: 0,0:05:03.30,0:05:04.79,Default,,0,0,0,,Ben...
Dialogue: 0,0:05:04.79,0:05:06.99,Default,,0,0,0,,Biz...
Dialogue: 0,0:05:06.99,0:05:09.51,Default,,0,0,0,,Biz senin arkadaşın değil miyiz,{\alpha&HFF&} TSUBASA?!
Dialogue: 0,0:05:09.51,0:05:11.37,Default,,0,0,0,,Biz senin arkadaşın değil miyiz, TSUBASA?!
Dialogue: 0,0:05:11.37,0:05:12.66,Default,,0,0,0,,Haklı, Tsubasa!
Dialogue: 0,0:05:12.66,0:05:13.93,Default,,0,0,0,,Yalnız değilsin!
Dialogue: 0,0:05:13.93,0:05:15.69,Default,,0,0,0,,Tam arkandayız!
Dialogue: 0,0:05:15.69,0:05:18.42,Default,,0,0,0,,Al, Tsubasa!
Dialogue: 0,0:05:18.42,0:05:19.84,Default - i,,0,0,0,,Ishizaki-kun...
Dialogue: 0,0:05:19.84,0:05:21.13,Default - i,,0,0,0,,Millet...
Dialogue: 0,0:05:21.13,0:05:23.17,Default - i,,0,0,0,,Arkadaşlarım...
Dialogue: 0,0:05:25.68,0:05:29.10,Default - i,,0,0,0,,Ishizaki-kun'un ve herkesin pasını çevireceğim...
Dialogue: 0,0:05:30.30,0:05:31.18,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:05:31.78,0:05:34.04,Default - i,,0,0,0,,Kesinlikle benimle kalacaklar...
Dialogue: 0,0:05:34.04,0:05:35.18,Default - i,,0,0,0,,Arkadaşlarım benimle.
Dialogue: 0,0:05:35.80,0:05:37.40,Default - i,,0,0,0,,Yalnız değilim!
Dialogue: 0,0:05:37.40,0:05:40.82,Default - i,,0,0,0,,Ve Brezilya'ya gittiğimde yalnız olmayacağım!
Dialogue: 0,0:05:40.82,0:05:42.73,Default,,0,0,0,,Sana güveniyoruz, Tsubasa!
Dialogue: 0,0:05:43.69,0:05:47.24,Default - i,,0,0,0,,Beni her zaman arkadan destekliyorlar!
Dialogue: 0,0:05:49.20,0:05:53.45,Default - i,,0,0,0,,Drive Shot için yaptığı hazırlık\N ve pas mükemmel senkronize oluyor!
Dialogue: 0,0:05:49.20,0:05:53.45,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:05:53.45,0:05:54.83,Default,,0,0,0,,Sana meydan okuyorum Tsubasa!
Dialogue: 0,0:05:54.83,0:05:57.87,Default,,0,0,0,,Bacağını her zaman Drive Shot da yaptığı gibi kullanmıyor.
Dialogue: 0,0:05:54.83,0:05:57.87,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:05:57.87,0:06:00.92,Default,,0,0,0,,Bu benim Japonya'daki son şutum!
Dialogue: 0,0:06:02.71,0:06:08.68,Default,,0,0,0,,{\fs85}İşte {\bord0\blur0.6\c&HFFFFDC&\c&HFFFFDC&\}be{\c&HF8FABE&}nim v{\c&HF0F49F&}e{\c&HF8F284&}d{\c&H97FAF8&}a g{\c&H82FAF9&}olü{\c&H3AFFFD&}m!
Dialogue: 0,0:06:08.68,0:06:09.51,Default,,0,0,0,,Durduracağım!
Dialogue: 0,0:06:09.51,0:06:10.89,Default,,0,0,0,,Sadece sağ elimle bile olsa...!
Dialogue: 0,0:06:15.00,0:06:16.35,Default - i,,0,0,0,,S-Sıçrıyor!
Dialogue: 0,0:06:21.90,0:06:24.49,Default - i,,0,0,0,,İ-İçerde!
Dialogue: 0,0:06:24.49,0:06:26.60,Default - i,,0,0,0,,Uzatmaların ilk dakikasında!
Dialogue: 0,0:06:26.60,0:06:30.41,Default - i,,0,0,0,,Tsubasa-kun'un golüyle\N Nankatsu sonunda bir geri dönüş yaptı!
Dialogue: 0,0:06:30.96,0:06:31.92,Default,,0,0,0,,Başardım!
Dialogue: 0,0:06:31.92,0:06:33.83,Default,,0,0,0,,Attım!
Dialogue: 0,0:06:33.83,0:06:34.77,Default,,0,0,0,,Başardın!
Dialogue: 0,0:06:34.77,0:06:36.29,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:06:36.29,0:06:39.12,Default - i,,0,0,0,,Nankatsu onbiri birbirlerine neşeyle sarılıyorlar!
Dialogue: 0,0:06:39.12,0:06:40.68,Default - i,,0,0,0,,Skor 4-3.
Dialogue: 0,0:06:40.68,0:06:44.88,Default - i,,0,0,0,,Nankatsu, bu maçta ilk kez Toho'yu tek golle geçiyor.
Dialogue: 0,0:06:44.88,0:06:47.59,Default - i,,0,0,0,,Gerçekten de harika bir şuttu.
Dialogue: 0,0:06:47.59,0:06:52.47,Default - i,,0,0,0,,Şut yerden sekti ve şiddetli dönüşü onu ters yöne fırlattı.
Dialogue: 0,0:06:52.47,0:06:54.64,Default - i,,0,0,0,,Yan ağı şiddetli deldi!
Dialogue: 0,0:06:54.64,0:06:58.14,Default - i,,0,0,0,,Bu muhtemelen Drive Shot'un farklı bir versiyonuydu.
Dialogue: 0,0:06:54.64,0:06:58.14,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:56.33,0:06:58.14,Default-TOP,,0,0,0,,Tsubasa, sen en iyisisin!
Dialogue: 0,0:06:58.14,0:07:03.13,Default - i,,0,0,0,,Sadece Tsubasa-kun'un yapabileceği bir Miracle Drive Shot!
Dialogue: 0,0:06:58.14,0:07:03.13,Default-TOP,,0,0,0,,Miracle Drive Shot: Mücize İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:07:04.40,0:07:08.13,Default - i,,0,0,0,,Tüm sakatlıklarına rağmen bu maçta 4. golünü attı.
Dialogue: 0,0:07:08.13,0:07:09.72,Default - i,,0,0,0,,Gerçekten harika!
Dialogue: 0,0:07:09.72,0:07:13.78,Default - i,,0,0,0,,Japonya'nın doğurmuş olduğu\Nfutbol dehası, Ozora Tsubasa-kun!
Dialogue: 0,0:07:13.78,0:07:15.35,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:07:15.35,0:07:17.98,Default,,0,0,0,,Sonunda bir gol öndeyiz!
Dialogue: 0,0:07:17.98,0:07:20.79,Default,,0,0,0,,Hayalimize bir adım daha yaklaştık, değil mi?
Dialogue: 0,0:07:20.79,0:07:23.73,Default,,0,0,0,,Hayalimize...
Dialogue: 0,0:07:23.73,0:07:24.50,Default,,0,0,0,,Tsubasa?
Dialogue: 0,0:07:24.50,0:07:26.12,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:07:26.12,0:07:27.05,Default,,0,0,0,,Tsubasa?!
Dialogue: 0,0:07:27.05,0:07:28.18,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:07:28.18,0:07:28.85,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:07:28.85,0:07:29.99,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:07:29.99,0:07:31.30,Default,,0,0,0,,{\t(335,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Tsubasa!!!
Dialogue: 0,0:07:38.16,0:07:40.04,Default,,0,0,0,,Nihayet gözlerini açtın, Tsubasa-kun!
Dialogue: 0,0:07:40.04,0:07:41.06,Default,,0,0,0,,Tsubasa-senpai!
Dialogue: 0,0:07:42.85,0:07:44.31,Default,,0,0,0,,Neredeyim?
Dialogue: 0,0:07:44.31,0:07:45.85,Default,,0,0,0,,Revir.
Dialogue: 0,0:07:46.97,0:07:48.04,Default,,0,0,0,,Peki ya maç?!
Dialogue: 0,0:07:48.04,0:07:48.90,Default,,0,0,0,,Nankatsu nasıl?
Dialogue: 0,0:07:48.90,0:07:50.78,Default,,0,0,0,,Arkadaşlarım nasıl?!
Dialogue: 0,0:07:50.78,0:07:51.73,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:07:51.73,0:07:52.92,Default,,0,0,0,,Senpai!
Dialogue: 0,0:07:52.92,0:07:54.86,Default,,0,0,0,,Bir süre hareketsiz kal!
Dialogue: 0,0:07:54.86,0:07:56.95,Default,,0,0,0,,Hala uzatmalar oynanıyor.
Dialogue: 0,0:07:58.37,0:08:02.37,Default,,0,0,0,,Sonunda bayıldım, değil mi?
Dialogue: 0,0:08:02.76,0:08:03.78,Default,,0,0,0,,Evet.
Dialogue: 0,0:08:03.78,0:08:05.63,Default,,0,0,0,,Ama skor yaptın, senpai.
Dialogue: 0,0:08:05.63,0:08:06.84,Default,,0,0,0,,Geri dönüş golümüz.
Dialogue: 0,0:08:06.84,0:08:10.34,Default,,0,0,0,,Evet, o güzel son gol.
Dialogue: 0,0:08:13.89,0:08:14.84,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:08:14.84,0:08:16.20,Default,,0,0,0,,Git, Toho!
Dialogue: 0,0:08:16.20,0:08:16.85,Default,,0,0,0,,Saldır!
Dialogue: 0,0:08:16.85,0:08:17.97,Default,,0,0,0,,Sorimachi-san!
Dialogue: 0,0:08:21.56,0:08:23.41,Default - i,,0,0,0,,Nankatsu umutsuzca savunuyor!
Dialogue: 0,0:08:23.41,0:08:26.56,Default - i,,0,0,0,,Ancak, Kaptan Ozara Tsubasa-kun sahada değil.
Dialogue: 0,0:08:26.56,0:08:29.28,Default,,0,0,0,,Abi neden saldırmıyorsun?
Dialogue: 0,0:08:29.28,0:08:32.63,Default,,0,0,0,,Eğer şimdi vurursan puan alabilirsin.
Dialogue: 0,0:08:32.63,0:08:33.95,Default - i,,0,0,0,,Kojiro...
Dialogue: 0,0:08:33.95,0:08:34.88,Default,,0,0,0,,Millet...
Dialogue: 0,0:08:34.88,0:08:35.95,Default,,0,0,0,,4-3.
Dialogue: 0,0:08:35.95,0:08:36.70,Default,,0,0,0,,Ah!
Dialogue: 0,0:08:36.70,0:08:40.08,Default,,0,0,0,,Koç, hala uzatmaların ilk yarısı mı?
Dialogue: 0,0:08:40.08,0:08:41.57,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:08:41.57,0:08:43.87,Default,,0,0,0,,Koç! Sahaya geri dönmeme izin ver!
Dialogue: 0,0:08:43.87,0:08:44.73,Default,,0,0,0,,Reddediyorum.
Dialogue: 0,0:08:44.73,0:08:45.79,Default,,0,0,0,,Yapamazsın!
Dialogue: 0,0:08:45.79,0:08:48.34,Default,,0,0,0,,Sakın benim yerime birinin içeri alındığını söyleme.
Dialogue: 0,0:08:48.34,0:08:49.52,Default,,0,0,0,,Sorun yok.
Dialogue: 0,0:08:49.52,0:08:51.55,Default,,0,0,0,,Senin yerine başka kimseyi oyuna sokmadık.
Dialogue: 0,0:08:51.55,0:08:54.76,Default,,0,0,0,,Bu golü hep birlikte koruyacaklarını söylediler.
Dialogue: 0,0:08:55.39,0:08:59.60,Default,,0,0,0,,Tsubasa bayıldı çünkü ona çok fazla yüklendik.
Dialogue: 0,0:09:00.04,0:09:03.14,Default,,0,0,0,,Geri gelip gelmeyeceği önemli değil.
Dialogue: 0,0:09:03.14,0:09:06.52,Default,,0,0,0,,Uzatmaların ilk yarısını kendimiz savunacağız.
Dialogue: 0,0:09:06.52,0:09:10.73,Default,,0,0,0,,On kişi olarak bize verdiği tek golü koruyacağız!
Dialogue: 0,0:09:10.73,0:09:13.14,Default,,0,0,0,,Bu yüzden yalvarıyoruz koç!
Dialogue: 0,0:09:13.14,0:09:15.99,Default,,0,0,0,,Bunu koçtan istediler.
Dialogue: 0,0:09:16.61,0:09:17.82,Default,,0,0,0,,Millet...
Dialogue: 0,0:09:17.82,0:09:22.13,Default,,0,0,0,,Ancak, artık vücudunu aşırı kullanmana izin veremem.
Dialogue: 0,0:09:22.13,0:09:23.00,Default,,0,0,0,,Hah?!
Dialogue: 0,0:09:23.00,0:09:26.21,Default,,0,0,0,,İkinci yarıda Yamamori'nin oynamasını planlıyorum.
Dialogue: 0,0:09:26.62,0:09:28.76,Default,,0,0,0,,Bana söz verdiğini sanıyordum Tsubasa.
Dialogue: 0,0:09:28.76,0:09:31.82,Default,,0,0,0,,Bayılman halinde derhal oyundan çekilecektin.
Dialogue: 0,0:09:31.82,0:09:33.05,Default,,0,0,0,,Doktor ama...!
Dialogue: 0,0:09:33.05,0:09:36.17,Default,,0,0,0,,Neden mücadele için kendini bu kadar zorluyorsun?!
Dialogue: 0,0:09:36.17,0:09:39.36,Default,,0,0,0,,Gerçek hayalin Nankatsu'nun 3.şampiyonluğu değil!
Dialogue: 0,0:09:39.36,0:09:43.27,Default,,0,0,0,,Brezilya'ya gidip dünyanın en iyi futbolcusu olmak gerekiyordu!
Dialogue: 0,0:09:45.61,0:09:50.04,Default,,0,0,0,,Kaybetmeyi göze alamayacağım büyük hayalin uğruna.
Dialogue: 0,0:09:50.04,0:09:53.61,Default,,0,0,0,,Savaşmam ve kazanmam gerekiyor.
Dialogue: 0,0:09:53.61,0:09:57.36,Default,,0,0,0,,Tüm sorumluluğu alacağım.
Dialogue: 0,0:09:57.36,0:10:00.02,Default,,0,0,0,,Bu maçta ölsem bile umrumda değil.
Dialogue: 0,0:10:00.02,0:10:03.53,Default,,0,0,0,,Eğer Tsubasa Ozora burada yorulacak bir insansa,
Dialogue: 0,0:10:03.53,0:10:06.90,Default,,0,0,0,,o zaman Brezilya gitme, Japonyayı dünyada 1. yapma,
Dialogue: 0,0:10:06.90,0:10:09.34,Default,,0,0,0,,ve dünyanın en iyi futbolcusu olma hayalleri....
Dialogue: 0,0:10:09.34,0:10:13.63,Default,,0,0,0,,Bu hayallerin hiçbiri başlangıçta gerçek olamazdı!
Dialogue: 0,0:10:15.52,0:10:17.01,Default,,0,0,0,,Lütfen, bırakın oynasın.
Dialogue: 0,0:10:18.77,0:10:22.10,Default,,0,0,0,,Kazanmak ve kaybetmekten önce, 
Dialogue: 0,0:10:22.10,0:10:25.43,Default,,0,0,0,,futbol oynayamamak Tsubasa-kun için en zor şey.
Dialogue: 0,0:10:25.90,0:10:29.89,Default,,0,0,0,,Tsubasa-kun'dan futbolu almayın lütfen...
Dialogue: 0,0:10:31.61,0:10:33.15,Default,,0,0,0,,Menejer...
Dialogue: 0,0:10:36.86,0:10:38.28,Default,,0,0,0,,Sanki şut çekmene izin veririm!
Dialogue: 0,0:10:40.42,0:10:42.42,Default,,0,0,0,,İyi çalım, Ishizaki-kun.
Dialogue: 0,0:10:43.03,0:10:45.98,Default,,0,0,0,,Millet, iyi savunma.
Dialogue: 0,0:10:45.98,0:10:49.33,Default,,0,0,0,,Millet! Ben... Oynayacağım!
Dialogue: 0,0:10:49.71,0:10:50.83,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:10:50.83,0:10:51.70,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:10:51.70,0:10:52.32,Default,,0,0,0,,Bu Tsubasa!
Dialogue: 0,0:10:52.32,0:10:55.54,Default - i,,0,0,0,,Daha önce sakatlanma nedeniyle sahadan çıkarılan
Dialogue: 0,0:10:55.54,0:10:58.76,Default - i,,0,0,0,,Ozora Tsubasa-kun, yedek kulübesinin önünde göründü.
Dialogue: 0,0:10:56.37,0:10:57.88,Default-TOP,,0,0,0,,Tsubasa geri döndü!
Dialogue: 0,0:10:57.88,0:10:58.76,Default-TOP,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:01.05,0:11:03.76,Default - i,,0,0,0,,Uzaklaştırılan top Hyuga-kun'a gidiyor.
Dialogue: 0,0:11:03.76,0:11:04.81,Default,,0,0,0,,Durdurun onu!
Dialogue: 0,0:11:04.81,0:11:07.10,Default,,0,0,0,,Oradan kolayca Tiger Shot ile skor yapabilir!
Dialogue: 0,0:11:04.81,0:11:07.10,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:11:07.60,0:11:08.35,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:14.57,0:11:16.57,Default - i,,0,0,0,,Hyuga-kun...
Dialogue: 0,0:11:16.57,0:11:18.42,Default - i,,0,0,0,,Tsubasa...
Dialogue: 0,0:11:20.93,0:11:25.93,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:11:31.62,0:11:33.14,Default,,0,0,0,,Hyuga...
Dialogue: 0,0:11:33.14,0:11:36.25,Default,,0,0,0,,Topu, Tsubasa'nın tekrar sahaya girmesi için dışarı gönderdi.
Dialogue: 0,0:11:36.25,0:11:39.09,Default - i,,0,0,0,,Tsubasa-kun sahaya geri dönüyor!
Dialogue: 0,0:11:39.09,0:11:40.38,Default,,0,0,0,,Tsubasa...!
Dialogue: 0,0:11:40.38,0:11:42.34,Default,,0,0,0,,Yani oynayabilirsin, Tsubasa!
Dialogue: 0,0:11:42.34,0:11:44.55,Default,,0,0,0,,Aksi takdirde olmazdı, bilirsin!
Dialogue: 0,0:11:44.55,0:11:46.12,Default,,0,0,0,,TSUBASA!
Dialogue: 0,0:11:46.12,0:11:47.18,Default,,0,0,0,,TSUBASA!
Dialogue: 0,0:11:47.18,0:11:48.85,Default,,0,0,0,,TSUBASA!
Dialogue: 0,0:11:48.85,0:11:52.31,Default - i,,0,0,0,,Tsubasa-kun için tezahürat hızla yükseliyor!
Dialogue: 0,0:11:52.31,0:11:53.69,Default,,0,0,0,,TSUBASA!
Dialogue: 0,0:11:53.69,0:11:55.02,Default,,0,0,0,,TSUBASA!
Dialogue: 0,0:11:55.02,0:11:57.02,Default,,0,0,0,,Pekala! Kaybetmeyeceğiz!
Dialogue: 0,0:11:57.02,0:11:57.85,Default,,0,0,0,,HYUGA!
Dialogue: 0,0:11:57.85,0:11:58.66,Default,,0,0,0,,HYUGA!
Dialogue: 0,0:11:58.66,0:11:59.53,Default,,0,0,0,,HYUGA!
Dialogue: 0,0:12:02.46,0:12:04.52,Default - i,,0,0,0,,Tamamdır. Hadi yapalım, Hyuga-kun!
Dialogue: 0,0:12:04.52,0:12:06.24,Default - i,,0,0,0,,Hadi gel, Tsubasa!
Dialogue: 0,0:12:06.24,0:12:07.90,Default - i,,0,0,0,,Yine şov zamanı!
Dialogue: 0,0:12:07.90,0:12:10.58,Default - i,,0,0,0,,Maçın sonunu bildiren düdük çalıncaya kadar...
Dialogue: 0,0:12:10.58,0:12:12.54,Default - i,,0,0,0,,Savaşmaya devam edeceğiz!
Dialogue: 0,0:12:13.42,0:12:15.04,Default - i,,0,0,0,,Tsubasa-kun oyuna girdi.
Dialogue: 0,0:12:19.38,0:12:20.13,Default - i,,0,0,0,,Tsubasa...!
Dialogue: 0,0:12:21.01,0:12:21.51,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:21.51,0:12:22.17,Default,,0,0,0,,Ah?!
Dialogue: 0,0:12:22.60,0:12:24.72,Default - i,,0,0,0,,Tsubasa-kun topu Hyuga-kun'a gönderdi!
Dialogue: 0,0:12:24.72,0:12:27.72,Default - i,,0,0,0,,Hyuga'nın daha önce yaptığı şeye cevap mı bu?
Dialogue: 0,0:12:28.47,0:12:29.93,Default - i,,0,0,0,,Hadi gidelim, Hyuga-kun!
Dialogue: 0,0:12:31.07,0:12:32.10,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:12:32.82,0:12:34.94,Default - i,,0,0,0,,Vücudun tamamen yorgun olsa bile,
Dialogue: 0,0:12:34.94,0:12:37.11,Default - i,,0,0,0,,sen hala...
Dialogue: 0,0:12:40.19,0:12:41.28,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:12:41.28,0:12:42.28,Default,,0,0,0,,Hadi yapalım!
Dialogue: 0,0:12:42.28,0:12:44.78,Default,,0,0,0,,1.şampiyonluğu ve kazanmayı hedefliyoruz!
Dialogue: 0,0:12:44.78,0:12:45.74,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:45.74,0:12:48.41,Default - i,,0,0,0,,Hyuga-kun kesinlikle hiçbir acıma \Nolmadan Tsubasa-kun'a saldırıyor!
Dialogue: 0,0:12:48.41,0:12:51.04,Default - i,,0,0,0,,Vahşi Kaplan gaddarca top sürüyor!
Dialogue: 0,0:12:51.04,0:12:52.55,Default,,0,0,0,,Onu uzak tutacağız millet!
Dialogue: 0,0:12:52.55,0:12:53.29,Default,,0,0,0,,Tamam!
Dialogue: 0,0:12:53.29,0:12:54.50,Default - i,,0,0,0,,Kahretsin!
Dialogue: 0,0:12:54.50,0:12:56.43,Default - i,,0,0,0,,Kaybediyorum...!
Dialogue: 0,0:12:56.43,0:12:58.58,Default - i,,0,0,0,,Düşüyorum!
Dialogue: 0,0:12:58.58,0:13:02.09,Default - i,,0,0,0,,Maçın sonuna kadar oynamaya devam edeceğim!
Dialogue: 0,0:13:03.88,0:13:06.22,Default - i,,0,0,0,,Her iki takım da umutsuzca saldırıyor ve savunuyor!
Dialogue: 0,0:13:06.89,0:13:10.60,Default - i,,0,0,0,,Ah, top Tsubasa-kun'a doğru döndü.
Dialogue: 0,0:13:10.60,0:13:11.81,Default,,0,0,0,,Tadına bak...
Dialogue: 0,0:13:11.81,0:13:14.23,Default,,0,0,0,,Kayan Takımımızın!
Dialogue: 0,0:13:14.73,0:13:17.69,Default - i,,0,0,0,,Tsubasa-kun bir kez daha uçtu!
Dialogue: 0,0:13:17.69,0:13:20.49,Default,,0,0,0,,Sizi şerefsizler! Bunu Tsubasa'ya yapmaya nasıl cüret edersiniz!
Dialogue: 0,0:13:20.49,0:13:23.11,Default - i,,0,0,0,,Öfkeli Ishizaki-kun'dan cesur bir oyun!
Dialogue: 0,0:13:23.11,0:13:24.74,Default - i,,0,0,0,,Nankatsu topu tekrar çaldı!
Dialogue: 0,0:13:25.64,0:13:29.45,Default - i,,0,0,0,,Ve top bir kez daha Tsubasa-kun'a doğru yol alıyor!
Dialogue: 0,0:13:31.65,0:13:32.75,Default - i,,0,0,0,,Hadi yapalım...
Dialogue: 0,0:13:33.12,0:13:35.75,Default - i,,0,0,0,,Hadi gidelim! Nankatsu'nun 3.şampiyonluğu için!
Dialogue: 0,0:13:35.75,0:13:36.50,Default,,0,0,0,,Evet!
Dialogue: 0,0:13:36.50,0:13:37.75,Default,,0,0,0,,Gel Tsubasa!
Dialogue: 0,0:13:37.75,0:13:41.38,Default,,0,0,0,,Tsubasa, vücudu parçalara ayrılırken bile Nankatsu’ya liderlik ediyor...
Dialogue: 0,0:13:41.38,0:13:43.60,Default,,0,0,0,,Gerçekten kaptan sensin.
Dialogue: 0,0:13:43.60,0:13:45.30,Default,,0,0,0,,Sen Kaptan Tsubasa'sın!
Dialogue: 0,0:13:53.35,0:13:54.34,Default,,0,0,0,,Gidin!
Dialogue: 0,0:13:54.34,0:13:55.60,Default,,0,0,0,,Merhamet etmeyin!
Dialogue: 0,0:13:55.60,0:13:58.06,Default,,0,0,0,,Sahada olduğu sürece, sempati duyulmaya ihtiyacı yok!
Dialogue: 0,0:13:58.06,0:13:59.04,Default,,0,0,0,,Ezin onu!
Dialogue: 0,0:13:59.04,0:14:00.61,Default,,0,0,0,,Sadece Tsubasa'yı ezmek zorundasınız!
Dialogue: 0,0:14:00.61,0:14:02.11,Default,,0,0,0,,T-Tamam!
Dialogue: 0,0:14:02.11,0:14:04.86,Default,,0,0,0,,Toho'nun Kayan Takımı harekete geçti!
Dialogue: 0,0:14:04.86,0:14:06.36,Default,,0,0,0,,Tsubasa-kun, dikkat et!
Dialogue: 0,0:14:06.99,0:14:08.52,Default - i,,0,0,0,,Pas atıyor!
Dialogue: 0,0:14:08.52,0:14:11.99,Default - i,,0,0,0,,Tsubasa rakipleri yaklaştıktan sonra ustaca bir pas gönderiyor!
Dialogue: 0,0:14:13.74,0:14:18.33,Default - i,,0,0,0,,Rahatça hareket etmemiz için tüm savunma oyuncularının ona odaklanmasını sağlıyor.
Dialogue: 0,0:14:19.21,0:14:22.28,Default,,0,0,0,,Tsubasa'dan gelen bu pasın boşa gitmesine izin vermeyin!
Dialogue: 0,0:14:22.28,0:14:23.17,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:23.17,0:14:25.09,Default,,0,0,0,,Wakashimazu'ya gitmene izin vermeyeceğiz!
Dialogue: 0,0:14:25.09,0:14:26.92,Default,,0,0,0,,Bunun olmasına izin vermeyeceğim!
Dialogue: 0,0:14:29.05,0:14:31.97,Default - i,,0,0,0,,Mükemmel bir senkronize üçgen pası!
Dialogue: 0,0:14:31.97,0:14:33.81,Default,,0,0,0,,Biz de onlara katılmalıyız, Takasugi!
Dialogue: 0,0:14:33.81,0:14:35.06,Default,,0,0,0,,Hepimiz saldırıya geçelim!
Dialogue: 0,0:14:35.06,0:14:35.60,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:35.60,0:14:36.60,Default - i,,0,0,0,,Kahretsin!
Dialogue: 0,0:14:36.60,0:14:38.73,Default - i,,0,0,0,,Sawada-kun'dan akıllıca bir uzaklaştırma!
Dialogue: 0,0:14:38.73,0:14:42.65,Default - i,,0,0,0,,Fakat top üstüne gelen Ishizaki-kun'a gidiyor!
Dialogue: 0,0:14:42.65,0:14:44.02,Default - i,,0,0,0,,Pekala! Şut çekeceğim!
Dialogue: 0,0:14:44.02,0:14:45.86,Default,,0,0,0,,Dikkat et, Ishizaki-kun!
Dialogue: 0,0:14:45.86,0:14:47.28,Default,,0,0,0,,Arkanda!
Dialogue: 0,0:14:50.19,0:14:51.28,Default - i,,0,0,0,,Güzel bir hamle!
Dialogue: 0,0:14:51.28,0:14:53.58,Default - i,,0,0,0,,Ishizaki-kun hemen şutunu pasla değiştiriyor!
Dialogue: 0,0:14:55.83,0:14:57.77,Default - i,,0,0,0,,Wakashimazu'nun zayıf noktası...{\alpha&HFF&} burada!
Dialogue: 0,0:14:57.77,0:14:58.79,Default - i,,0,0,0,,Wakashimazu'nun zayıf noktası... burada!
Dialogue: 0,0:14:59.79,0:15:02.86,Default - i,,0,0,0,,Izawa-kun, kalenin sağ köşesine yönelik kavisli bir atış yaptı!
Dialogue: 0,0:15:02.86,0:15:05.71,Default - i,,0,0,0,,Bu, dışa doğru kıvrılan bir Banana Shot!
Dialogue: 0,0:15:02.86,0:15:05.71,Default-TOP,,0,0,0,,Banana Shot: Muz Atışı (?!)
Dialogue: 0,0:15:07.80,0:15:11.34,Default - i,,0,0,0,,{\t(3137,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Eğer bir sonraki turnuvada şampiyon olamazsam, futboldan vazgeçeceğim!
Dialogue: 0,0:15:11.34,0:15:13.18,Default - i,,0,0,0,,Ken Wakashimazu,
Dialogue: 0,0:15:13.18,0:15:14.68,Default - i,,0,0,0,,bir erkek asla sözünden geri dönmez!
Dialogue: 0,0:15:15.14,0:15:16.77,Default - i,,0,0,0,,Yakaladı!
Dialogue: 0,0:15:16.77,0:15:21.77,Default - i,,0,0,0,,Vücut pozisyonu zor olsa da, \Nbu atışı tek elle yakalayarak durdurdu!
Dialogue: 0,0:15:21.77,0:15:23.27,Default,,0,0,0,,Şutum...
Dialogue: 0,0:15:23.27,0:15:25.19,Default - i,,0,0,0,,Sol kolu yaralanmasına rağmen,
Dialogue: 0,0:15:25.19,0:15:29.03,Default - i,,0,0,0,,mutlak krizi sadece sağ eliyle savuşturdu!
Dialogue: 0,0:15:29.03,0:15:31.11,Default - i,,0,0,0,,Nankatsu gol atamadı!
Dialogue: 0,0:15:31.11,0:15:32.99,Default,,0,0,0,,Mükemmel bir saldırıydı, ama...
Dialogue: 0,0:15:33.60,0:15:35.99,Default - i,,0,0,0,,Kalemizi korudum baba.
Dialogue: 0,0:15:36.89,0:15:40.87,Default - i,,0,0,0,,Uzatmaların ilk yarısı bu düdük ile sona eriyor!
Dialogue: 0,0:15:43.38,0:15:44.82,Default,,0,0,0,,Tsubasa, iyi misin?
Dialogue: 0,0:15:44.82,0:15:46.30,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:46.30,0:15:47.38,Default,,0,0,0,,İyi misin?!
Dialogue: 0,0:15:56.78,0:15:57.89,Default,,0,0,0,,Millet...
Dialogue: 0,0:15:57.89,0:15:59.64,Default,,0,0,0,,Ne oldu Tsubasa?
Dialogue: 0,0:16:00.32,0:16:03.27,Default,,0,0,0,,Ben... İstiyorum...
Dialogue: 0,0:16:03.27,0:16:05.92,Default,,0,0,0,,İkinci yarıda da oynamak istiyorum!
Dialogue: 0,0:16:07.36,0:16:13.78,Default,,0,0,0,,Ama artık normal bir şekilde hareket edemiyorum...
Dialogue: 0,0:16:13.78,0:16:16.72,Default,,0,0,0,,Size sadece yük oluyorsam,
Dialogue: 0,0:16:16.72,0:16:18.41,Default,,0,0,0,,dışlanmak umrumda değil.
Dialogue: 0,0:16:19.09,0:16:20.45,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:16:21.10,0:16:24.81,Default,,0,0,0,,Ama ben sonuna kadar oynamak istiyorum.
Dialogue: 0,0:16:24.81,0:16:27.42,Default,,0,0,0,,Sonuna kadar hepinizle oynamak istiyorum.
Dialogue: 0,0:16:30.06,0:16:31.47,Default,,0,0,0,,O zaman sadece oyna, Tsubasa!
Dialogue: 0,0:16:32.80,0:16:35.58,Default,,0,0,0,,İkinci yarıda da birlikte savaşalım, Tsubasa!
Dialogue: 0,0:16:35.58,0:16:36.88,Default,,0,0,0,,Hepimiz bu kadar ilerledik.
Dialogue: 0,0:16:36.88,0:16:38.97,Default,,0,0,0,,Sonuna kadar birlikte olacağız!
Dialogue: 0,0:16:40.17,0:16:41.98,Default,,0,0,0,,Millet...
Dialogue: 0,0:16:41.98,0:16:43.46,Default,,0,0,0,,Gerçekten böylesi iyi mi?
Dialogue: 0,0:16:43.46,0:16:45.31,Default,,0,0,0,,Durumuma rağmen oynarsam sorun olmaz mı?
Dialogue: 0,0:16:45.31,0:16:46.86,Default,,0,0,0,,Bahse girerim!
Dialogue: 0,0:16:47.50,0:16:50.52,Default,,0,0,0,,Sen bizim kaptanımızsın!
Dialogue: 0,0:16:50.52,0:16:52.15,Default,,0,0,0,,Millet...
Dialogue: 0,0:16:53.80,0:16:56.96,Default,,0,0,0,,Anne, Tsubasa Ozora oyunda değilken, 
Dialogue: 0,0:16:56.96,0:17:00.12,Default,,0,0,0,,abim bir kerecik bile şut çekmedi, değil mi?
Dialogue: 0,0:17:00.12,0:17:01.62,Default,,0,0,0,,Ama bu iyi.
Dialogue: 0,0:17:01.62,0:17:05.62,Default,,0,0,0,,Kojiro'nun tek hedefi Tsubasa'yı yenmekti.
Dialogue: 0,0:17:05.62,0:17:08.30,Default,,0,0,0,,Tsubasa-kun, eğer daha fazla oynarsan...
Dialogue: 0,0:17:08.30,0:17:11.37,Default,,0,0,0,,Yine de, Tsubasa'nın ikinci yarıda oynayacağına eminim.
Dialogue: 0,0:17:11.37,0:17:15.13,Default,,0,0,0,,Evet. Sonuna kadar oynamaya devam edecek.
Dialogue: 0,0:17:15.77,0:17:17.09,Default,,0,0,0,,Tek gol liderliği...
Dialogue: 0,0:17:17.09,0:17:21.01,Default,,0,0,0,,Bunu devam ettirebilirsek, Nankatsu kazanacak!
Dialogue: 0,0:17:21.01,0:17:24.27,Default,,0,0,0,,Eminim ki Hyuga onları yakalayacak ve devirecek!
Dialogue: 0,0:17:24.27,0:17:27.21,Default,,0,0,0,,Bu gidişle, Toho Akademi'nin ortaokul, lise,
Dialogue: 0,0:17:27.21,0:17:30.15,Default,,0,0,0,,ve üniversite ile üçlü bir şampiyonluk hayali...
Dialogue: 0,0:17:30.15,0:17:32.96,Default,,0,0,0,,Sayın Müdür, final maçında şimdiye kadar ki,
Dialogue: 0,0:17:32.96,0:17:35.76,Default,,0,0,0,,mücadelelerinden memnun hissediyorum.
Dialogue: 0,0:17:36.28,0:17:41.79,Default,,0,0,0,,Sonuç ne olursa olsun, öğrencilerle gurur duyuyorum.
Dialogue: 0,0:17:41.79,0:17:43.79,Default-TOP,,0,0,0,,NANKATSU ORTAOKULU - SHIZUOKA EYALETİ
Dialogue: 0,0:17:42.88,0:17:45.79,Default,,0,0,0,,Tamam, hadi Tsubasa'nın planını uygulayalım.
Dialogue: 0,0:17:46.60,0:17:47.79,Default,,0,0,0,,Tamam.
Dialogue: 0,0:17:47.79,0:17:50.79,Default,,0,0,0,,Çoktan buraya geldik. Söyleyecek başka bir şeyim yok.
Dialogue: 0,0:17:50.79,0:17:53.80,Default,,0,0,0,,Pişmanlık duymamak için, sahip olduğunuz her şey ile oynayın.
Dialogue: 0,0:17:53.80,0:17:55.13,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:56.18,0:17:57.51,Default,,0,0,0,,Hyuga.
Dialogue: 0,0:17:58.59,0:18:03.10,Default,,0,0,0,,Oynamana izin verdiğim an, maçı senin ellerine bıraktım.
Dialogue: 0,0:18:05.02,0:18:06.23,Default,,0,0,0,,Sana güveniyorum.
Dialogue: 0,0:18:07.60,0:18:08.77,Default,,0,0,0,,Tamam!
Dialogue: 0,0:18:08.77,0:18:12.52,Default - i,,0,0,0,,Oyunun son 10 dakikası... \NUzatmaların ikinci yarısı şimdi başlıyor.
Dialogue: 0,0:18:12.52,0:18:15.07,Default,,0,0,0,,Sana güveniyoruz, Hyuga! Toho!
Dialogue: 0,0:18:15.07,0:18:17.49,Default - i,,0,0,0,,İkinci yarı Toho'nun başlama vuruşuyla başlıyor.
Dialogue: 0,0:18:19.20,0:18:21.58,Default,,0,0,0,,Tsubasa kalenin mi önünde?!
Dialogue: 0,0:18:21.95,0:18:25.46,Default,,0,0,0,,Bu Tsubasa'yı savunma oyuncusu olarak kullanma taktiği.
Dialogue: 0,0:18:25.46,0:18:27.37,Default,,0,0,0,,Nankatsu Shutetsu'yu böyle yendi!
Dialogue: 0,0:18:27.37,0:18:28.91,Default - i,,0,0,0,,Hadi gel Hyuga-kun!
Dialogue: 0,0:18:28.91,0:18:31.54,Default - i,,0,0,0,,Kaybetmeyeceğim... \NMücadele ruhu açısından kaybetmeyeceğim!
Dialogue: 0,0:18:31.54,0:18:34.25,Default,,0,0,0,,Tsubasa-san savunmada...
Dialogue: 0,0:18:34.25,0:18:36.32,Default - i,,0,0,0,,Teşekkürler Tsubasa.
Dialogue: 0,0:18:36.32,0:18:38.59,Default - i,,0,0,0,,Bu benim için oynamayı kolaylaştırıyor.
Dialogue: 0,0:18:39.72,0:18:43.39,Default - i,,0,0,0,,Hyuga-kun anında şut çekmek için pozisyon alıyor!
Dialogue: 0,0:18:43.39,0:18:44.89,Default,,0,0,0,,Tiger Shot!
Dialogue: 0,0:18:43.39,0:18:44.89,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:18:46.02,0:18:46.85,Default,,0,0,0,,Durdurun onu!
Dialogue: 0,0:18:46.85,0:18:48.77,Default,,0,0,0,,Kendini önüne at!
Dialogue: 0,0:18:49.25,0:18:49.77,Default,,0,0,0,,Tamam!
Dialogue: 0,0:18:50.93,0:18:51.65,Default,,0,0,0,,Ne?!
Dialogue: 0,0:18:51.65,0:18:54.07,Default,,0,0,0,,Bu bir aldatmaca mı?
Dialogue: 0,0:18:54.07,0:18:55.46,Default,,0,0,0,,Hadi Tsubasa!
Dialogue: 0,0:18:55.46,0:18:57.32,Default,,0,0,0,,Seni yakalayarak başlayacağım!
Dialogue: 0,0:18:57.82,0:18:59.78,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:18:59.78,0:19:03.16,Default,,0,0,0,,{\bord0\blur0.6\c&H00FFFF&}Ti{\c&H00F7FF&}g{\c&H00E9FF&}er {\c&H00D8FF&}S{\c&H00CBFF&}ho{\c&H00BFFF&}t{\c&H00AEFF&}!
Dialogue: 0,0:18:59.78,0:19:03.16,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:19:03.16,0:19:04.49,Default - i,,0,0,0,,Kaybetme.
Dialogue: 0,0:19:05.70,0:19:07.07,Default - i,,0,0,0,,Kaybetme.
Dialogue: 0,0:19:07.07,0:19:08.62,Default - i,,0,0,0,,Kaybetme, Tsubasa!
Dialogue: 0,0:19:10.46,0:19:13.96,Default,,0,0,0,,Benim adım Tsubasa Ozora!
Dialogue: 0,0:19:14.84,0:19:16.13,Default - i,,0,0,0,,Durdurdu!
Dialogue: 0,0:19:16.13,0:19:18.80,Default - i,,0,0,0,,Tsubasa-kun Tiger Shot'u püskürttü!
Dialogue: 0,0:19:16.13,0:19:18.80,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:19:18.80,0:19:19.72,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:22.28,0:19:23.35,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:19:27.02,0:19:29.38,Default,,0,0,0,,Yakalamayı hedeflediğim adam bu...
Dialogue: 0,0:19:29.38,0:19:31.27,Default - i,,0,0,0,,Tsubasa Ozora...
Dialogue: 0,0:19:31.96,0:19:34.19,Default - i,,0,0,0,,Seni yeneceğim!
Dialogue: 0,0:19:34.19,0:19:36.03,Default-TOP,,0,0,0,,İyi misin Tsubasa?
Dialogue: 0,0:19:34.19,0:19:36.94,Default - i,,0,0,0,,Şu anda yaralanmış olman umrumda değil.
Dialogue: 0,0:19:37.44,0:19:41.49,Default,,0,0,0,,Sana yeteri kadar kaybettim!
Dialogue: 0,0:19:46.95,0:19:48.12,Default,,0,0,0,,Ne!?
Dialogue: 0,0:19:48.12,0:19:51.42,Default - i,,0,0,0,,Nankatsu'nun kalesini koruyacağım!
Dialogue: 0,0:19:51.42,0:19:53.17,Default - i,,0,0,0,,Tsubasa ile birlikte!
Dialogue: 0,0:19:54.54,0:19:55.88,Default,,0,0,0,,Sizler...
Dialogue: 0,0:19:56.28,0:19:57.82,Default,,0,0,0,,Tamamdır! Şimdi saldırıyoruz!
Dialogue: 0,0:19:57.82,0:20:01.22,Default - i,,0,0,0,,Saldırıya geçersek, Tsubasa'nın yükünü hafifletebiliriz!
Dialogue: 0,0:20:01.22,0:20:02.33,Default,,0,0,0,,Savunacağız!
Dialogue: 0,0:20:02.33,0:20:04.59,Default,,0,0,0,,Artık başka bir gol atmanıza izin vermeyeceğiz!
Dialogue: 0,0:20:05.29,0:20:07.70,Default - i,,0,0,0,,Orta sahada şiddetli bir saldırı ve savunma gösterisi!
Dialogue: 0,0:20:07.70,0:20:08.93,Default - i,,0,0,0,,Topu kim alacak?
Dialogue: 0,0:20:10.06,0:20:11.30,Default,,0,0,0,,İşte!
Dialogue: 0,0:20:11.30,0:20:15.94,Default - i,,0,0,0,,Bu mücadelede dengeyi bozan, Toho'nun\N kalecisi Wakashimazu-kun'dan başkası değil!
Dialogue: 0,0:20:15.94,0:20:17.02,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:20:19.03,0:20:20.85,Default,,0,0,0,,Kaptan, zaferimiz!
Dialogue: 0,0:20:20.85,0:20:23.99,Default,,0,0,0,,Şampiyon olacağımıza yemin etmedik mi?
Dialogue: 0,0:20:24.63,0:20:26.03,Default,,0,0,0,,Wakashimazu...
Dialogue: 0,0:20:28.54,0:20:30.32,Default,,0,0,0,,Haydi millet!
Dialogue: 0,0:20:30.32,0:20:31.04,Default,,0,0,0,,Tamam!
Dialogue: 0,0:20:31.04,0:20:32.13,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:32.13,0:20:34.54,Default,,0,0,0,,O atış yüzünden dehşete mi kapıldın?
Dialogue: 0,0:20:34.54,0:20:35.83,Default,,0,0,0,,Top senin arkadaşın.
Dialogue: 0,0:20:35.83,0:20:39.71,Default,,0,0,0,,Bana bunu öğreten sendin, değil mi Tsubasa?
Dialogue: 0,0:20:39.71,0:20:43.01,Default,,0,0,0,,Nankatsu'nun kalesini birlikte koruyalım, Tsubasa!
Dialogue: 0,0:20:43.01,0:20:44.13,Default,,0,0,0,,Sonuna kadar!
Dialogue: 0,0:20:45.59,0:20:47.05,Default,,0,0,0,,Morisaki...
Dialogue: 0,0:20:47.05,0:20:50.56,Default,,0,0,0,,Hyuga-san'a yardım edebilecek benden başka kimse yok!
Dialogue: 0,0:20:50.56,0:20:51.98,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:20:51.98,0:20:53.06,Default,,0,0,0,,Şut çekecek!
Dialogue: 0,0:20:53.06,0:20:53.73,Default,,0,0,0,,Durdurun onu!
Dialogue: 0,0:20:53.73,0:20:54.98,Default,,0,0,0,,Onu durdurmalıyız!
Dialogue: 0,0:20:54.98,0:20:57.16,Default - i,,0,0,0,,Tiger Shot'un ne kadar şaşırtıcı olursa olsun,
Dialogue: 0,0:20:54.98,0:20:57.16,Default-TOP,,0,0,0,,Tiger Shot: Kaplan Vuruşu
Dialogue: 0,0:20:57.16,0:20:59.82,Default - i,,0,0,0,,sadece umursamazca vurursan, gol atamazsın, Hyuga!
Dialogue: 0,0:21:00.21,0:21:01.76,Default - i,,0,0,0,,Panik yapma, Kojiro!
Dialogue: 0,0:21:01.76,0:21:03.11,Default - i,,0,0,0,,Dikkatlice al!
Dialogue: 0,0:21:03.11,0:21:06.03,Default - i,,0,0,0,,Toho Nankatsu'ya karşı kazanıyor...
Dialogue: 0,0:21:06.03,0:21:08.91,Default - i,,0,0,0,,Tsubasa'ya karşı kazanmam anlamına geliyor!
Dialogue: 0,0:21:09.62,0:21:10.87,Default,,0,0,0,,Ne?!
Dialogue: 0,0:21:10.87,0:21:11.99,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:21:11.99,0:21:13.21,Default,,0,0,0,,İşte bu, Kojiro!
Dialogue: 0,0:21:14.50,0:21:16.58,Default - i,,0,0,0,,Top tutulmayan Sorimachi-kun'a gidiyor!
Dialogue: 0,0:21:16.58,0:21:18.79,Default - i,,0,0,0,,Toho için belirleyici bir şans!
Dialogue: 0,0:21:23.14,0:21:25.68,Default - i,,0,0,0,,Kaleci Morisaki tarafından iyi kurtarış!
Dialogue: 0,0:21:25.68,0:21:27.22,Default - i,,0,0,0,,Kalemizi korudum Tsubasa!
Dialogue: 0,0:21:27.22,0:21:30.89,Default - i,,0,0,0,,Ancak, Sawada-kun topu yakalıyor!
Dialogue: 0,0:21:30.89,0:21:32.02,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:21:32.02,0:21:33.27,Default,,0,0,0,,İşte!
Dialogue: 0,0:21:34.77,0:21:37.14,Default - i,,0,0,0,,Nankatsu onları tekrar durduruyor!
Dialogue: 0,0:21:37.14,0:21:40.30,Default - i,,0,0,0,,Tsubasa bu atışı yüzü ile karşıladı ve kalesini koruyor!
Dialogue: 0,0:21:40.30,0:21:42.24,Default - i,,0,0,0,,Top benim arkadaşım...
Dialogue: 0,0:21:42.24,0:21:43.53,Default - i,,0,0,0,,Korkmuyorum!
Dialogue: 0,0:21:44.92,0:21:46.24,Default - i,,0,0,0,,Neden?
Dialogue: 0,0:21:46.24,0:21:47.56,Default - i,,0,0,0,,Neden o?
Dialogue: 0,0:21:47.56,0:21:49.97,Default - i,,0,0,0,,Neden kazanamıyoruz?
Dialogue: 0,0:21:50.70,0:21:52.20,Default,,0,0,0,,Tsubasa-senpai!
Dialogue: 0,0:21:52.63,0:21:53.80,Default,,0,0,0,,Hayır...
Dialogue: 0,0:21:53.80,0:21:55.80,Default,,0,0,0,,Buna artık dayanamıyorum...
Dialogue: 0,0:21:55.80,0:21:56.96,Default,,0,0,0,,Sanae?
Dialogue: 0,0:21:56.96,0:21:58.24,Default,,0,0,0,,Durun!
Dialogue: 0,0:21:58.24,0:22:01.21,Default,,0,0,0,,Artık Tsubasa'ya zarar vermeyin!
Dialogue: 0,0:22:02.41,0:22:07.18,Default - i,,0,0,0,,Bu kadar aşınmış ve parçalara ayrılmış olsa bile, neden?
Dialogue: 0,0:22:07.18,0:22:10.59,Default - i,,0,0,0,,Seni ne bu kadar ileri götürüyor?
Dialogue: 0,0:22:10.59,0:22:11.55,Default - i,,0,0,0,,Hayalin mi?
Dialogue: 0,0:22:11.55,0:22:13.17,Default - i,,0,0,0,,Arkadaşlık mı?
Dialogue: 0,0:22:13.17,0:22:17.87,Default - i,,0,0,0,,Ve neden seni bu halde bile yenemiyorum Tsubasa?
Dialogue: 0,0:22:19.98,0:22:34.98,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.90,0:23:59.97,Default,,0,0,0,,52 BÖLÜM: SONSUZ HAYAL
Dialogue: 0,0:23:49.90,0:24:00.00,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:01:10.22,0:01:12.93,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:13.85,0:01:16.52,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:17.43,0:01:20.14,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:27.03,0:01:29.86,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:29.86,0:01:36.12,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzuketa
Dialogue: 0,0:01:36.12,0:01:42.00,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitte ita no ni
Dialogue: 0,0:01:42.00,0:01:48.59,OPED-TOP,,0,0,0,,kokoro made uchinomesareta kono yoru ni
Dialogue: 0,0:01:48.59,0:01:52.59,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:52.59,0:01:57.10,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:57.10,0:02:02.69,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:02:02.69,0:02:04.23,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:02:04.23,0:02:05.44,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:05.44,0:02:08.94,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:02:08.94,0:02:18.83,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:02:18.83,0:02:19.66,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:19.66,0:02:23.46,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:02:23.46,0:02:27.46,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:02:27.46,0:02:33.72,OPED-TOP,,0,0,0,,kono ai mou ichibyou taritomo
Dialogue: 0,0:02:33.72,0:02:36.55,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:01:10.22,0:01:12.93,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:13.85,0:01:16.52,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:17.43,0:01:20.14,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:27.03,0:01:29.86,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:01:29.86,0:01:36.12,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:01:36.12,0:01:42.00,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:42.00,0:01:48.59,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:48.59,0:01:52.59,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:52.59,0:01:57.10,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:01:57.10,0:02:02.69,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:02:02.69,0:02:04.23,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:02:04.23,0:02:05.44,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:05.44,0:02:08.94,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:02:08.94,0:02:18.83,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:02:18.83,0:02:19.66,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:19.66,0:02:23.46,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:02:23.46,0:02:27.46,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:02:27.46,0:02:33.72,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:33.72,0:02:36.55,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.70,0:22:44.75,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.75,0:22:50.75,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.75,0:22:56.80,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.80,0:23:01.43,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:03.06,0:23:07.73,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:09.06,0:23:15.15,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:15.15,0:23:21.20,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.20,0:23:25.66,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.96,0:23:33.30,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.30,0:23:39.34,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.34,0:23:45.64,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.70,0:22:44.75,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.75,0:22:50.75,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.75,0:22:56.80,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.80,0:23:01.43,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.06,0:23:07.73,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:09.06,0:23:15.15,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:15.15,0:23:21.20,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.20,0:23:25.66,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.96,0:23:33.30,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.30,0:23:39.34,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.34,0:23:45.64,OPED,,0,0,0,,Bu hırslı gençlik sahada!
