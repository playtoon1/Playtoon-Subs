Dialogue: 0,0:00:01.23,0:00:03.73,Default,,0,0,0,,Kaptan Tsubasa'da önceki bölüm.
Dialogue: 0,0:00:03.73,0:00:08.82,Default,,0,0,0,,Rakipleri Wakabayashi ile olan maçları için\NTsubasalar antrenman yapıyordu.
Dialogue: 0,0:00:08.82,0:00:10.28,Default,,0,0,0,,Hepsi özel pratiklerine uyarak...
Dialogue: 0,0:00:10.28,0:00:13.57,Default,,0,0,0,,...günden güne gelişiyordu.
Dialogue: 0,0:00:13.57,0:00:19.79,Default,,0,0,0,,Bu sırada Wakabayashi de\Nmaç için durmadan antrenman yapıyordu.
Dialogue: 0,0:00:20.79,0:00:24.79,Default,,0,0,0,,Okullar arası turnuva için\Nsabırsızlanıyorum Ozora Tsubasa.
Dialogue: 0,0:00:24.79,0:00:31.77,Default,,0,0,0,,Ve yine kaderin bir cilvesiyle\NNankatsu'ya bir delikanlı gelmişti.
Dialogue: 0,0:00:32.17,0:00:34.22,Default,,0,0,0,,Çok iyi top sürüyor.
Dialogue: 0,0:00:34.22,0:00:37.93,Default,,0,0,0,,Herkes hazırdı ve vakit gelmişti.
Dialogue: 0,0:00:37.93,0:00:40.43,Default,,0,0,0,,Tsubasa ve Wakabayashi\Narasındaki hesaplaşma...
Dialogue: 0,0:00:40.43,0:00:44.06,Default,,0,0,0,,...başlamak üzereydi.
Dialogue: 0,0:00:56.00,0:01:01.59,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:00:56.00,0:01:01.59,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:01:01.59,0:01:06.26,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:01:01.59,0:01:06.26,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:01:07.51,0:01:12.18,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:01:07.51,0:01:12.18,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:01:13.06,0:01:20.77,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:01:13.06,0:01:20.77,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:01:20.77,0:01:26.53,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:01:20.77,0:01:26.53,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:01:26.53,0:01:35.29,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:01:26.53,0:01:35.29,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:01:35.29,0:01:40.84,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:01:35.29,0:01:40.84,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:01:40.84,0:01:46.76,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:01:40.84,0:01:46.76,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:01:46.76,0:01:48.43,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:01:46.76,0:01:48.43,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:01:48.43,0:01:55.64,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:01:48.43,0:01:55.64,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo\N
Dialogue: 0,0:01:55.64,0:01:58.65,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:01:55.64,0:01:58.65,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
