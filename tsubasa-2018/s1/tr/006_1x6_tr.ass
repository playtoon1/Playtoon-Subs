Dialogue: 0,0:02:14.28,0:02:17.95,Default,,0,0,0,,{\fad(500,500)\pos(684,903.5)}Bölüm 6: Başlama Vuruşu!\NNankatsu, Shutetsu'ya karşı!\NÇeviri: ARE-YOU-SURE
Dialogue: 0,0:02:18.57,0:02:22.37,Default,,0,0,0,,{\fad(500,500)\pos(960,929)}- 22 Nisan, Özel Shutetsu İlkokulu -
Dialogue: 0,0:02:22.37,0:02:26.25,Default,,0,0,0,,Nankatsu İlkokulu ile Shutetsu İlkokulu'nun\Nkarşı karşıya gelmesi başlıyordu.
Dialogue: 0,0:02:26.91,0:02:28.67,Default,,0,0,0,,Bir puan ve maç bitti.
Dialogue: 0,0:02:29.42,0:02:35.59,Default,,0,0,0,,İki olun da isimlerini ortaya koyması\Nve tezahüratlar eşliğindeki...
Dialogue: 0,0:02:35.59,0:02:38.59,Default,,0,0,0,,...çetin bir mücadeleye\Ntutuşması uzun sürmemişti.
Dialogue: 0,0:02:38.59,0:02:43.10,Default,,0,0,0,,Hora! Hora! Nankatsu!
Dialogue: 0,0:02:44.10,0:02:44.97,Default,,0,0,0,,Iska!
Dialogue: 0,0:02:46.35,0:02:49.06,Default,,0,0,0,,Baksanıza, Anego'ya ne oldu?
Dialogue: 0,0:02:49.06,0:02:52.98,Default,,0,0,0,,Bilmiyorum. Böyle önemli\Nbir anda ne yapıyor ki?
Dialogue: 0,0:02:52.98,0:02:55.65,Default,,0,0,0,,Onu bırakın da sesinizi\Ndaha yüksek çıkarın!
Dialogue: 0,0:02:55.65,0:02:56.53,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:56.53,0:02:58.36,Default,,0,0,0,,Bu sefer spor sahasına gidelim.
Dialogue: 0,0:02:58.36,0:03:02.45,Default,,0,0,0,,Tamam, bu seneki Nankatsu Basketbol\NKulübü çok formunda.
Dialogue: 0,0:03:05.87,0:03:08.00,Default,,0,0,0,,Futbol kulübü.
Dialogue: 0,0:03:08.00,0:03:10.29,Default,,0,0,0,,İşte bu, vardık.
Dialogue: 0,0:03:10.29,0:03:14.38,Default,,0,0,0,,Şu ana kadar ne yapıyordunuz siz?\NAçılış törenine katılmadınız.
Dialogue: 0,0:03:15.21,0:03:17.84,Default,,0,0,0,,Son dakika pratiği yapıyorduk ve...
Dialogue: 0,0:03:17.84,0:03:21.22,Default,,0,0,0,,...planı gözden geçiriyorduk,\Ndeğil mi Tsubasa?
Dialogue: 0,0:03:21.22,0:03:21.80,Default,,0,0,0,,Evet.
Dialogue: 0,0:03:22.72,0:03:24.30,Default,,0,0,0,,Maç vakti geldi çattı.
Dialogue: 0,0:03:24.30,0:03:28.56,Default,,0,0,0,,Wakabayashi-kun ile mücadele edebileceğim.
Dialogue: 0,0:03:31.56,0:03:34.36,Default,,0,0,0,,Pekala... Bu seferki programa göre...
Dialogue: 0,0:03:35.11,0:03:37.65,Default,,0,0,0,,...futbol maçı en sonda.
Dialogue: 0,0:03:37.65,0:03:40.11,Default,,0,0,0,,Millet, o zamana kadar vaktimiz var.
Dialogue: 0,0:03:40.11,0:03:42.11,Default,,0,0,0,,Gidip diğer kulüplerin\Nkarşılaşmalarını izleyelim.
Dialogue: 0,0:03:42.11,0:03:42.86,Default,,0,0,0,,Tamam.
Dialogue: 0,0:03:42.86,0:03:46.49,Default,,0,0,0,,İşi onlara bırakmadan okullar\Narası turnuvayı kazanmalıyız.
Dialogue: 0,0:03:46.49,0:03:48.24,Default,,0,0,0,,Ne dedin lan sen?!
Dialogue: 0,0:03:48.24,0:03:51.46,Default,,0,0,0,,Futbol kulübünü hafife mi alıyorsun sen?!
Dialogue: 0,0:03:51.46,0:03:52.75,Default,,0,0,0,,Almıyorum!
Dialogue: 0,0:03:57.00,0:04:00.30,Default,,0,0,0,,Burası küçük kalemiz olacak şimdilik.
Dialogue: 0,0:04:06.47,0:04:10.06,Default,,0,0,0,,Baba, buradaki manzara harika.
Dialogue: 0,0:04:15.10,0:04:16.98,Default,,0,0,0,,Tarou, ben dışarı çıkıyorum.
Dialogue: 0,0:04:16.98,0:04:17.98,Default,,0,0,0,,Tamam.
Dialogue: 0,0:04:21.32,0:04:23.15,Default,,0,0,0,,Tamam, gidelim.
Dialogue: 0,0:04:33.12,0:04:34.54,Default,,0,0,0,,Roberto?
Dialogue: 0,0:04:36.29,0:04:37.84,Default,,0,0,0,,Annesi.
Dialogue: 0,0:04:37.84,0:04:40.09,Default,,0,0,0,,Burada ne yapıyorsun?
Dialogue: 0,0:04:40.09,0:04:43.88,Default,,0,0,0,,Futbol maçının başlamasına çok var.
Dialogue: 0,0:04:43.88,0:04:46.76,Default,,0,0,0,,Hayır, sadece kestiriyordum.
Dialogue: 0,0:04:47.43,0:04:51.18,Default,,0,0,0,,Burada sahaya bakarak...
Dialogue: 0,0:04:51.18,0:04:56.73,Default,,0,0,0,,...bugün Tsubasa'nın nasıl bir\Noyun sergileyeceğini hayal ediyorum.
Dialogue: 0,0:04:58.06,0:05:02.40,Default,,0,0,0,,İki hafta Tsubasa ile\Npratik yaparken çok şaşırdım.
Dialogue: 0,0:05:02.40,0:05:06.20,Default,,0,0,0,,Tsubasa sanki benim ruh ikizim.
Dialogue: 0,0:05:07.07,0:05:13.62,Default,,0,0,0,,İçimden Tsubasa'ya "böyle\Nhareket et, şuraya şut çek" diye geçirirsem...
Dialogue: 0,0:05:13.62,0:05:18.25,Default,,0,0,0,,...Tsubasa oraya doğru top sürüp\Noraya doğru şut çekiyor.
Dialogue: 0,0:05:20.04,0:05:23.51,Default,,0,0,0,,Bugün eminim ki Tsubasa'nın\Noyununu izlemek...
Dialogue: 0,0:05:23.51,0:05:26.72,Default,,0,0,0,,...sanki kendim oynuyormuş\Ngibi hissettirecek.
Dialogue: 0,0:05:30.47,0:05:34.56,Default,,0,0,0,,Tsubasa'yı dünyayla tanıştıracağın\Ndoğuyor içime.
Dialogue: 0,0:05:34.56,0:05:35.31,Default,,0,0,0,,Ne?
Dialogue: 0,0:05:35.31,0:05:37.65,Default,,0,0,0,,Tsubasa her zaman der ki:
Dialogue: 0,0:05:37.65,0:05:41.07,Default,,0,0,0,,Japon futbolunu, dünyanın\Nen iyi futbolu yapmayı hayal ediyorum.
Dialogue: 0,0:05:41.07,0:05:44.07,Default,,0,0,0,,Ne büyük bir hayal.
Dialogue: 0,0:05:44.07,0:05:47.20,Default,,0,0,0,,Ve mücadele etmeye değer bir hayal.
Dialogue: 0,0:05:52.20,0:05:57.39,Default,,0,0,0,,Bir gün o hayali beraber\Ngerçekleştirelim Tsubasa.
Dialogue: 0,0:05:58.92,0:06:03.09,Default,,0,0,0,,Şimdi erkeklerin 200 metre\Nkoşusu olacak.
Dialogue: 0,0:06:03.09,0:06:05.59,Default,,0,0,0,,Ne? 6. bant boş.
Dialogue: 0,0:06:05.59,0:06:09.64,Default,,0,0,0,,Katılımcımız yaralandığı için çekildi.
Dialogue: 0,0:06:10.72,0:06:14.47,Default,,0,0,0,,Ama bu seneki kişiler de bayağı kötüydü.
Dialogue: 0,0:06:14.47,0:06:17.35,Default,,0,0,0,,Tüm ilk sıraları Shutetsu almış.
Dialogue: 0,0:06:17.35,0:06:18.85,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:06:18.85,0:06:21.81,Default,,0,0,0,,Futbol kulübü olarak\Nneyin artistliğini yapıyorsunuz?
Dialogue: 0,0:06:21.81,0:06:22.94,Default,,0,0,0,,Ne?!
Dialogue: 0,0:06:22.94,0:06:25.65,Default,,0,0,0,,Siz hep kaybediyorsunuz.
Dialogue: 0,0:06:25.65,0:06:29.24,Default,,0,0,0,,Shutetsu'ya karşı 30-0 kaybettiniz.
Dialogue: 0,0:06:29.24,0:06:30.41,Default,,0,0,0,,Yerlerinize.
Dialogue: 0,0:06:30.41,0:06:34.49,Default,,0,0,0,,Shutetsu'da hiç gol yemeden\Nkazanan Wakabayashi var.
Dialogue: 0,0:06:34.49,0:06:37.16,Default,,0,0,0,,Bir gol bile atamazsınız siz.
Dialogue: 0,0:06:38.16,0:06:38.92,Default,,0,0,0,,Hazır.
Dialogue: 0,0:06:40.46,0:06:42.29,Default,,0,0,0,,Canına mı susadın sen?!
Dialogue: 0,0:06:42.29,0:06:43.67,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:06:44.63,0:06:45.71,Default,,0,0,0,,Şuraya bak.
Dialogue: 0,0:06:45.71,0:06:46.46,Default,,0,0,0,,Ne var?
Dialogue: 0,0:06:47.22,0:06:48.55,Default,,0,0,0,,Ne?!
Dialogue: 0,0:06:51.68,0:06:52.72,Default,,0,0,0,,Pekala...
Dialogue: 0,0:06:52.72,0:06:54.35,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:06:55.14,0:06:59.69,Default,,0,0,0,,Ne yapıyor bu?!\NKimin nesi?!
Dialogue: 0,0:06:59.69,0:07:04.07,Default,,0,0,0,,Aniden top süren bir çocuk sahaya daldı.
Dialogue: 0,0:07:06.94,0:07:08.53,Default,,0,0,0,,Bu saçmalık!
Dialogue: 0,0:07:08.53,0:07:11.74,Default,,0,0,0,,Nasıl normal koşan insanlardan\Ndaha hızlı olabilir?!
Dialogue: 0,0:07:11.74,0:07:16.24,Default,,0,0,0,,İşte geliyor, geliyor, geliyor!\NGizemli top süren çocuk geliyor!
Dialogue: 0,0:07:20.25,0:07:21.88,Default,,0,0,0,,Vay canına!
Dialogue: 0,0:07:21.88,0:07:25.50,Default,,0,0,0,,Top süren çocuk liderliği aldı!
Dialogue: 0,0:07:25.50,0:07:27.38,Default,,0,0,0,,Harikasın Tsubasa!
Dialogue: 0,0:07:27.38,0:07:31.38,Default,,0,0,0,,Gizemli top süren çocuk\Nharika bir şekilde dönüyor!
Dialogue: 0,0:07:31.38,0:07:33.89,Default,,0,0,0,,Hızını kaybetmedi!
Dialogue: 0,0:07:34.10,0:07:35.72,Default,,0,0,0,,Neyin nesi bu?!
Dialogue: 0,0:07:35.72,0:07:36.81,Default,,0,0,0,,İmkansız!
Dialogue: 0,0:07:37.93,0:07:40.69,Default,,0,0,0,,İşte! Yarışın son kısmı geldi!
Dialogue: 0,0:07:40.69,0:07:43.52,Default,,0,0,0,,Tamam, son koşu!
Dialogue: 0,0:07:43.52,0:07:46.90,Default,,0,0,0,,Vay canına! Top süren çocuk\Ndaha da hızlandı!
Dialogue: 0,0:07:46.90,0:07:50.99,Default,,0,0,0,,İnanamıyorum! Böyle devam mı edecek?!
Dialogue: 0,0:07:50.99,0:07:53.74,Default,,0,0,0,,Ayrıca size ne oldu koşu kulübü?!
Dialogue: 0,0:07:53.74,0:07:54.57,Default,,0,0,0,,Bastır!
Dialogue: 0,0:07:54.57,0:07:55.45,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:07:55.45,0:07:56.53,Default,,0,0,0,,Yardırıyorsun!
Dialogue: 0,0:07:56.53,0:07:59.91,Default,,0,0,0,,Yap şunu Tsubasa!
Dialogue: 0,0:08:08.09,0:08:09.63,Default,,0,0,0,,Başardım!
Dialogue: 0,0:08:09.63,0:08:14.72,Default,,0,0,0,,Geçti! Birinci sırada, 6. banttaki\Ntop süren gizemli çocuk!
Dialogue: 0,0:08:14.72,0:08:15.60,Default,,0,0,0,,Başardı!
Dialogue: 0,0:08:15.60,0:08:16.85,Default,,0,0,0,,Yok artık!
Dialogue: 0,0:08:16.85,0:08:19.52,Default,,0,0,0,,Gerçekten mi ama?
Dialogue: 0,0:08:41.04,0:08:43.12,Default,,0,0,0,,Pekala. Kompozisyonu belirledim.
Dialogue: 0,0:08:44.50,0:08:47.54,Default,,0,0,0,,Öyleyse ben okul işlerini\Nhalletmeye gidiyorum.
Dialogue: 0,0:08:47.54,0:08:50.34,Default,,0,0,0,,Bu sefer Nankatsu İlkokulu'ydu değil mi?
Dialogue: 0,0:08:59.89,0:09:02.81,Default,,0,0,0,,Matsuyama.
Dialogue: 0,0:09:00.85,0:09:04.10,Default,,0,0,0,,{\fs60\frz343\pos(1100,417)}Matsuyama (Furano İlkokulu)
Dialogue: 0,0:09:04.10,0:09:07.02,Default,,0,0,0,,{\fad(500,500)\pos(984,933)}- Shutetsu İlkokulu Futbol Stadyumu -
Dialogue: 0,0:09:11.96,0:09:16.91,Default,,0,0,0,,{\fad(500,500)\pos(968,933)}- Yamabuki İlkokulu Futbol Kulübü -
Dialogue: 0,0:09:12.36,0:09:16.91,Default,,0,0,0,,{\an8}İyice dinleyin. Bugün Shutetsu\Nhakkında iyice veri toplayın.
Dialogue: 0,0:09:16.91,0:09:22.08,Default,,0,0,0,,Shutetsu'yu yenmezsek ulusallara gidemeyiz.
Dialogue: 0,0:09:22.08,0:09:23.33,Default,,0,0,0,,Shutetsu!
Dialogue: 0,0:09:25.46,0:09:29.04,Default,,0,0,0,,Ama asıl önemli olan\NWakabayashi'nin oynayıp oynamayacağı.
Dialogue: 0,0:09:29.04,0:09:30.55,Default,,0,0,0,,Wakabayashi oynayacak!
Dialogue: 0,0:09:30.55,0:09:31.21,Default,,0,0,0,,Ne?
Dialogue: 0,0:09:32.05,0:09:35.38,Default,,0,0,0,,Sen Nishigaoka İlkokulu'ndan Urabe'sin!
Dialogue: 0,0:09:35.38,0:09:40.97,Default,,0,0,0,,Sizin aksinize biz Wakabayashi'nin\Ngol yemesini izlemeye geldik.
Dialogue: 0,0:09:40.97,0:09:44.14,Default,,0,0,0,,Shutetsu bu maçı kaybedebilir.
Dialogue: 0,0:09:44.14,0:09:46.02,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:09:46.02,0:09:49.98,Default,,0,0,0,,Vay anasını... Demek durum böyle.
Dialogue: 0,0:09:49.98,0:09:53.53,Default,,0,0,0,,Nankatsu ile Shutetsu berabere.
Dialogue: 0,0:09:53.53,0:09:59.45,Default,,0,0,0,,Yani bu seneki sonuç\Nfutbol maçına bakacak!
Dialogue: 0,0:09:59.45,0:10:01.83,Default,,0,0,0,,İşler gittikçe ilginçleşiyor.
Dialogue: 0,0:10:01.83,0:10:06.50,Default,,0,0,0,,Millet, her şeyinizle tezahürat yapın!
Dialogue: 0,0:10:06.50,0:10:07.67,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:10.84,0:10:12.00,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:12.00,0:10:14.34,Default,,0,0,0,,Transfer öğrenci misin?
Dialogue: 0,0:10:14.34,0:10:18.13,Default,,0,0,0,,Şu an herkes Shutetsu İlkokulu'nda.
Dialogue: 0,0:10:18.13,0:10:19.51,Default,,0,0,0,,Shutetsu İlkokulu mu?
Dialogue: 0,0:10:35.94,0:10:38.03,Default,,0,0,0,,Demek o gün geldi ha?
Dialogue: 0,0:10:38.03,0:10:39.20,Default,,0,0,0,,Evet.
Dialogue: 0,0:10:39.20,0:10:41.37,Default,,0,0,0,,Seninle tanıştığımız gün...
Dialogue: 0,0:10:41.37,0:10:45.70,Default,,0,0,0,,...Wakabayashi meydan okumanı\Nmaçta kabul edeceğini söylemişti.
Dialogue: 0,0:10:45.70,0:10:48.79,Default,,0,0,0,,Her şey o gün başladı.
Dialogue: 0,0:10:48.79,0:10:50.46,Default,,0,0,0,,Ne oldu birden?
Dialogue: 0,0:10:50.46,0:10:52.54,Default,,0,0,0,,Yoksa havalı davranmaya mı çalışıyorsun?
Dialogue: 0,0:10:52.54,0:10:54.63,Default,,0,0,0,,Evet, havalı olmaya çalışıyorum.
Dialogue: 0,0:10:54.63,0:10:55.42,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:56.21,0:11:00.93,Default,,0,0,0,,Biraz abartı olabilir ama\Niyi ki seninle tanışmışım.
Dialogue: 0,0:11:00.93,0:11:05.39,Default,,0,0,0,,İlk kez bir futbol maçı\Niçin heyecanlanıyorum.
Dialogue: 0,0:11:05.39,0:11:08.60,Default,,0,0,0,,İyi bir maç yapalım Ishizaki-kun.
Dialogue: 0,0:11:08.60,0:11:10.44,Default,,0,0,0,,Herkese bugün için güveniyorum.
Dialogue: 0,0:11:10.44,0:11:11.44,Default,,0,0,0,,Ben de güveniyorum.
Dialogue: 0,0:11:11.44,0:11:12.02,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:12.02,0:11:12.90,Default,,0,0,0,,Ben de güveniyorum.
Dialogue: 0,0:11:12.90,0:11:15.07,Default,,0,0,0,,Sadece iyi bir maç yapmayalım. Kazanalım.
Dialogue: 0,0:11:15.07,0:11:16.69,Default,,0,0,0,,İyi dedin.
Dialogue: 0,0:11:16.69,0:11:19.99,Default,,0,0,0,,Tıpkı birisi gibi havalı davranmaya çalışıyordum.
Dialogue: 0,0:11:22.20,0:11:24.74,Default,,0,0,0,,Tamam millet, gidelim!
Dialogue: 0,0:11:24.74,0:11:26.24,Default,,0,0,0,,Tamam!
Dialogue: 0,0:11:48.73,0:11:51.98,Default,,0,0,0,,Nankatsu on biri, yanınızdayız!
Dialogue: 0,0:11:52.65,0:11:54.44,Default,,0,0,0,,Ne kadar çok kişi var.
Dialogue: 0,0:11:54.44,0:11:56.86,Default,,0,0,0,,Bacaklarım titremeye başladı.
Dialogue: 0,0:11:56.86,0:12:01.91,Default,,0,0,0,,Bu kadar kişinin önünde maç yapacağım.
Dialogue: 0,0:12:01.91,0:12:04.24,Default,,0,0,0,,Gelmişsiniz millet.
Dialogue: 0,0:12:04.24,0:12:05.58,Default,,0,0,0,,Roberto!
Dialogue: 0,0:12:05.58,0:12:06.95,Default,,0,0,0,,Ne oldu çocuklar?
Dialogue: 0,0:12:06.95,0:12:10.46,Default,,0,0,0,,Daha çok kişi izliyorken daha iyi oynarsınız.
Dialogue: 0,0:12:10.46,0:12:12.33,Default,,0,0,0,,A-Ama...
Dialogue: 0,0:12:12.33,0:12:14.88,Default,,0,0,0,,Tsubasa, dünyaya ulaştığın zaman...
Dialogue: 0,0:12:14.88,0:12:16.84,Default,,0,0,0,,...atmosfer bununla kıyaslanamayacak bile.
Dialogue: 0,0:12:17.16,0:12:17.85,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:24.97,0:12:27.89,Default,,0,0,0,,Alışkınlar demek ha?
Dialogue: 0,0:12:27.89,0:12:31.02,Default,,0,0,0,,Biz korkudan ölüyoruz burada.
Dialogue: 0,0:12:31.02,0:12:32.52,Default,,0,0,0,,Wakabayashi-kun yok.
Dialogue: 0,0:12:32.52,0:12:33.14,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:40.08,0:12:45.06,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:12:47.78,0:12:48.99,Default,,0,0,0,,Yok, Koç.
Dialogue: 0,0:12:48.99,0:12:51.41,Default,,0,0,0,,Kaptanı hiçbir yerde bulamıyoruz.
Dialogue: 0,0:12:51.41,0:12:53.00,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:12:53.00,0:12:54.21,Default,,0,0,0,,Elden bir şey gelmez.
Dialogue: 0,0:12:54.21,0:12:55.80,Default,,0,0,0,,Bugün Wakabayashi olmadan oynayacağız.
Dialogue: 0,0:12:55.80,0:12:58.46,Default,,0,0,0,,Rakibimiz Nankatsu olduğundan endişelenmeye\Ngerek olmadığını düşünüyorum ama...
Dialogue: 0,0:12:58.46,0:13:00.21,Default,,0,0,0,,...dikkatli oynayın.
Dialogue: 0,0:13:00.21,0:13:01.59,Default,,0,0,0,,Tamam!
Dialogue: 0,0:13:01.59,0:13:03.59,Default,,0,0,0,,Şimdi okullar arası turnuva için...
Dialogue: 0,0:13:03.59,0:13:07.76,Default,,0,0,0,,...Shutetsu İlkokulu futbol takımı ile\NNankatsu İlkokulu futbol takımı karşılaşacak.
Dialogue: 0,0:13:13.06,0:13:17.63,Default,,0,0,0,,Neden Nankatsu İlkokulu'na yazılmama\Nrağmen Shutetsu İlkokulu'na gitmeliyim ki?
Dialogue: 0,0:13:18.86,0:13:19.61,Default,,0,0,0,,Pekala!
Dialogue: 0,0:13:19.61,0:13:22.74,Default,,0,0,0,,O aralıktan geçirerek duvara şut çekeceğim!
Dialogue: 0,0:13:25.99,0:13:26.95,Default,,0,0,0,,Dikkat et!
Dialogue: 0,0:13:30.03,0:13:33.91,Default,,0,0,0,,Şehrin içerisindeyken pervasızca\Nşut çekmemelisin.
Dialogue: 0,0:13:35.96,0:13:37.88,Default,,0,0,0,,Wakabayashi gerçekten gelmiyor mu?!
Dialogue: 0,0:13:37.88,0:13:40.00,Default,,0,0,0,,Evet, bir fırsat olabilir bu.
Dialogue: 0,0:13:40.00,0:13:41.88,Default,,0,0,0,,O dahi futbolcu yoksa...
Dialogue: 0,0:13:41.88,0:13:43.76,Default,,0,0,0,,...kazanmak hayal olmaz belki de.
Dialogue: 0,0:13:43.76,0:13:47.22,Default,,0,0,0,,Futbol kulübümüz de son\Nzamanlarda çok sıkı çalışıyordu.
Dialogue: 0,0:13:47.22,0:13:48.39,Default,,0,0,0,,Ben de gördüm onları.
Dialogue: 0,0:13:48.39,0:13:50.18,Default,,0,0,0,,Hep top sürüyorlardı.
Dialogue: 0,0:13:50.18,0:13:52.02,Default,,0,0,0,,Berbat bir futbol kulübüydü üstelik.
Dialogue: 0,0:13:53.89,0:13:55.18,Default,,0,0,0,,Duydun mu?
Dialogue: 0,0:13:55.18,0:13:58.86,Default,,0,0,0,,Wakabayashi'nin kesinlikle\Ngeleceğini söyleyen kimdi?
Dialogue: 0,0:14:00.32,0:14:02.78,Default,,0,0,0,,Böyle olmamalıydı.
Dialogue: 0,0:14:05.53,0:14:08.16,Default,,0,0,0,,Wakabayashi-kun'a ne oldu acaba?
Dialogue: 0,0:14:08.16,0:14:11.20,Default,,0,0,0,,Belki de senden korkup kaçmıştır.
Dialogue: 0,0:14:11.20,0:14:13.49,Default,,0,0,0,,Şakayı bırak Ishizaki.
Dialogue: 0,0:14:14.12,0:14:15.79,Default,,0,0,0,,Wakabayashi!
Dialogue: 0,0:14:19.54,0:14:22.21,Default,,0,0,0,,Koç, Kaptan geldi.
Dialogue: 0,0:14:24.96,0:14:27.47,Default,,0,0,0,,N-Ne var be?
Dialogue: 0,0:14:27.47,0:14:30.55,Default,,0,0,0,,Ozora Tsubasa, daha önce dediğim gibi...
Dialogue: 0,0:14:30.55,0:14:35.26,Default,,0,0,0,,...bu maç senin bana bir gol atıp\Natamayacağına dair bir mücadele olacak.
Dialogue: 0,0:14:36.18,0:14:38.27,Default,,0,0,0,,Sadece bir gol atmayacağım.
Dialogue: 0,0:14:38.27,0:14:41.19,Default,,0,0,0,,Bu maçta Nankatsu, Shutetsu'yu yenecek.
Dialogue: 0,0:15:01.88,0:15:04.75,Default,,0,0,0,,Nankatsu İlkokulu müdürlüğü burası sanırım.
Dialogue: 0,0:15:04.75,0:15:08.51,Default,,0,0,0,,Tsubasa-kun gibi top sürüyorsun sen de!
Dialogue: 0,0:15:09.59,0:15:10.68,Default,,0,0,0,,Tsubasa mı?
Dialogue: 0,0:15:10.68,0:15:12.01,Default,,0,0,0,,Evet, Tsubasa.
Dialogue: 0,0:15:12.01,0:15:14.35,Default,,0,0,0,,Sen de mi futbol oynuyorsun?
Dialogue: 0,0:15:14.35,0:15:17.27,Default,,0,0,0,,Ama bizim Tsubasa-kun gerçekten harikadır.
Dialogue: 0,0:15:18.14,0:15:19.39,Default,,0,0,0,,Benimle gel.
Dialogue: 0,0:15:19.39,0:15:20.94,Default,,0,0,0,,Ona tezahürat yapmaya gidiyorum.
Dialogue: 0,0:15:20.94,0:15:22.23,Default,,0,0,0,,Bekle.
Dialogue: 0,0:15:22.23,0:15:23.90,Default,,0,0,0,,Ben Nankatsu--
Dialogue: 0,0:15:23.90,0:15:27.74,Default,,0,0,0,,Nankatsu İlkokulu amigo takımı kaptanıyım ben.
Dialogue: 0,0:15:27.74,0:15:30.91,Default,,0,0,0,,Bastır! Bastır! Shutetsu!
Dialogue: 0,0:15:30.91,0:15:33.78,Default,,0,0,0,,Anego gelmedi cidden.
Dialogue: 0,0:15:33.78,0:15:36.66,Default,,0,0,0,,Yetiştim.
Dialogue: 0,0:15:36.66,0:15:38.04,Default,,0,0,0,,Anego!
Dialogue: 0,0:15:39.50,0:15:40.71,Default,,0,0,0,,Şuraya bak.
Dialogue: 0,0:15:40.71,0:15:42.71,Default,,0,0,0,,O Tsubasa-kun.
Dialogue: 0,0:15:47.88,0:15:49.26,Default,,0,0,0,,O çocuk.
Dialogue: 0,0:15:49.26,0:15:51.13,Default,,0,0,0,,Baksana sen...
Dialogue: 0,0:15:52.47,0:15:54.14,Default,,0,0,0,,Neden Anego'nun yanındasın bakayım?
Dialogue: 0,0:15:54.80,0:15:56.89,Default,,0,0,0,,Az önce karşılaştık.
Dialogue: 0,0:15:56.89,0:16:00.06,Default,,0,0,0,,Bugün Nankatsu İlkokulu'na transfer oldum da.
Dialogue: 0,0:16:00.06,0:16:01.48,Default,,0,0,0,,Ne? Transfer mi?
Dialogue: 0,0:16:01.48,0:16:04.65,Default,,0,0,0,,Adım Misaki Tarou. Memnun oldum.
Dialogue: 0,0:16:06.19,0:16:10.11,Default,,0,0,0,,Hora! Hora! Tsubasa!
Dialogue: 0,0:16:10.11,0:16:14.24,Default,,0,0,0,,Bastır! Bastır! Tsubasa!
Dialogue: 0,0:16:14.24,0:16:17.08,Default,,0,0,0,,{\an8}# Bastır Tsubasa #
Dialogue: 0,0:16:15.12,0:16:17.08,Default,,0,0,0,,Anego...
Dialogue: 0,0:16:17.08,0:16:18.24,Default,,0,0,0,,Yine geldi...
Dialogue: 0,0:16:18.24,0:16:19.25,Default,,0,0,0,,Harika.
Dialogue: 0,0:16:19.25,0:16:20.91,Default,,0,0,0,,Sadece Tsubasa'nın adı yazıyor.
Dialogue: 0,0:16:20.91,0:16:24.17,Default,,0,0,0,,Havalı olmak da zor Tsubasa.
Dialogue: 0,0:16:24.17,0:16:27.30,Default,,0,0,0,,Tsubasa-kun! Elinden geleni yap!
Dialogue: 0,0:16:29.96,0:16:31.80,Default,,0,0,0,,Geciktiğim için üzgünüm.
Dialogue: 0,0:16:31.80,0:16:32.97,Default,,0,0,0,,Geldin demek.
Dialogue: 0,0:16:32.97,0:16:34.09,Default,,0,0,0,,Evet.
Dialogue: 0,0:16:34.09,0:16:35.93,Default,,0,0,0,,Sana güveniyorum Kaptan.
Dialogue: 0,0:16:35.93,0:16:36.55,Default,,0,0,0,,Evet.
Dialogue: 0,0:16:38.85,0:16:40.18,Default,,0,0,0,,Dinleyin çocuklar!
Dialogue: 0,0:16:40.18,0:16:46.65,Default,,0,0,0,,Bu maçta Ozora Tsubasa'nın gol atmasına\Nne olursa olsun izin vermemelisiniz.
Dialogue: 0,0:16:46.65,0:16:52.03,Default,,0,0,0,,Bu maç, onun bana gol atıp\Natamayacağını gösteren bir mücadele.
Dialogue: 0,0:16:52.03,0:16:53.24,Default,,0,0,0,,- Shimada.\N- Evet.
Dialogue: 0,0:16:53.24,0:16:54.45,Default,,0,0,0,,- Nakamoto.\N- Evet.
Dialogue: 0,0:16:54.45,0:16:56.62,Default,,0,0,0,,Diğer ufaklıkları bırakın.
Dialogue: 0,0:16:56.62,0:16:59.74,Default,,0,0,0,,İkiniz Ozora atağa geçtiğinde\Nonu tutacaksınız.
Dialogue: 0,0:16:59.74,0:17:00.20,Default,,0,0,0,,Tamam.
Dialogue: 0,0:17:00.20,0:17:01.41,Default,,0,0,0,,Anladım.
Dialogue: 0,0:17:01.41,0:17:05.50,Default,,0,0,0,,Ceza sahası içerisinde tutmanız yeterli.
Dialogue: 0,0:17:05.50,0:17:09.21,Default,,0,0,0,,İstediği gibi dışarıdan\Nşut çekmesine izin verin.
Dialogue: 0,0:17:10.84,0:17:13.84,Default,,0,0,0,,Dinleyin çocuklar, tıpkı planladığımız gibi.
Dialogue: 0,0:17:13.84,0:17:14.72,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:15.47,0:17:16.51,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:17:16.51,0:17:19.22,Default,,0,0,0,,Gidip futbolun tadını çıkarın!
Dialogue: 0,0:17:20.81,0:17:22.23,Default,,0,0,0,,Oyuncular sahada.
Dialogue: 0,0:17:22.85,0:17:25.56,Default,,0,0,0,,Okullar arası turnuvanın son\Netkinliği başlamak üzere.
Dialogue: 0,0:17:25.56,0:17:29.44,Default,,0,0,0,,Bu maçın sonucuyla 26. okullar arası\Nturnuvanın kazananı belirlenecek.
Dialogue: 0,0:17:29.44,0:17:31.36,Default,,0,0,0,,Bastır Tsubasa!
Dialogue: 0,0:17:31.36,0:17:36.49,Default,,0,0,0,,Bu maç, Tsubasa ile Shutetsu'dan\NWakabayashi'nin hesaplaşması olacak.
Dialogue: 0,0:17:36.49,0:17:38.12,Default,,0,0,0,,Wakabayashi mi?
Dialogue: 0,0:17:38.12,0:17:40.41,Default,,0,0,0,,Bak. Shutetsu'nun kalecisi.
Dialogue: 0,0:17:41.08,0:17:43.87,Default,,0,0,0,,Wakabayashi o mu?
Dialogue: 0,0:17:43.87,0:17:47.67,Default,,0,0,0,,İki takım da sahaya dağıldı.
Dialogue: 0,0:17:47.67,0:17:49.74,Default,,0,0,0,,Ulusal turnuvanın şampiyonunu Shutetsu'da...
Dialogue: 0,0:17:49.74,0:17:54.76,Default,,0,0,0,,...forvette 9 numara Kisugi-kun ile\N11 numara Taki-kun var.
Dialogue: 0,0:17:54.76,0:17:56.63,Default,,0,0,0,,Dört tane orta sahaları var.
Dialogue: 0,0:17:56.63,0:18:00.10,Default,,0,0,0,,10 numara Izawa-kun, atağa\Nçıkılmasını sağlıyor.
Dialogue: 0,0:18:00.10,0:18:05.77,Default,,0,0,0,,Defansın ortasında 6 numara\NTakasugi-kun varlığını hissettiriyor.
Dialogue: 0,0:18:05.77,0:18:09.36,Default,,0,0,0,,Kale, ulusal turnuvada gol yememiş...
Dialogue: 0,0:18:09.36,0:18:12.11,Default,,0,0,0,,...dahi kaleci Wakabayashi-kun\Ntarafından korunuyor.
Dialogue: 0,0:18:13.23,0:18:16.36,Default,,0,0,0,,Başlama vakti geldi artık.
Dialogue: 0,0:18:18.20,0:18:19.49,Default,,0,0,0,,Ishizaki...
Dialogue: 0,0:18:19.49,0:18:21.49,Default,,0,0,0,,Forvet sen misin?
Dialogue: 0,0:18:21.49,0:18:22.54,Default,,0,0,0,,Sayılır.
Dialogue: 0,0:18:22.54,0:18:24.20,Default,,0,0,0,,Ozora denilen çocuk değil mi yani?
Dialogue: 0,0:18:24.20,0:18:25.46,Default,,0,0,0,,Tsubasa mı?
Dialogue: 0,0:18:25.46,0:18:27.54,Default,,0,0,0,,Evet, o olacağını sanıyorduk.
Dialogue: 0,0:18:28.71,0:18:31.04,Default,,0,0,0,,Tsubasa'yı istiyorsanız orada.
Dialogue: 0,0:18:31.71,0:18:32.96,Default,,0,0,0,,Ne?
Dialogue: 0,0:18:34.71,0:18:38.43,Default,,0,0,0,,Kaptan, nerede orada o?
Dialogue: 0,0:18:38.43,0:18:41.35,Default,,0,0,0,,Ozora'yı tutmamızı söyledin\Nama böyle olursa...
Dialogue: 0,0:18:41.35,0:18:43.35,Default,,0,0,0,,...defansın ortasında!
Dialogue: 0,0:18:43.35,0:18:45.68,Default,,0,0,0,,Tsubasa merkez defans olarak mı oynuyor?
Dialogue: 0,0:18:45.68,0:18:47.52,Default,,0,0,0,,Sana güveniyorum Tsubasa.
Dialogue: 0,0:18:47.52,0:18:48.73,Default,,0,0,0,,Bana bırak.
Dialogue: 0,0:18:50.61,0:18:51.94,Default,,0,0,0,,Neler oluyor?
Dialogue: 0,0:18:51.94,0:18:55.03,Default,,0,0,0,,Tsubasa forvet değil.
Dialogue: 0,0:18:56.15,0:18:59.41,Default,,0,0,0,,Ne yapmaya çalıştığını bilmiyorum\Nama bana hava hoş!
Dialogue: 0,0:18:59.41,0:19:01.87,Default,,0,0,0,,Kesinlikle o kaleye topu sokacağız!
Dialogue: 0,0:19:01.87,0:19:04.24,Default,,0,0,0,,Millet! Her şeyinizle bastırın!
Dialogue: 0,0:19:04.24,0:19:05.45,Default,,0,0,0,,Tamam!
Dialogue: 0,0:19:07.58,0:19:10.25,Default,,0,0,0,,Hakem başlama düdüğünü verdi.
Dialogue: 0,0:19:10.25,0:19:13.67,Default,,0,0,0,,Shutetsu'nun top vuruşuyla maç başladı!
Dialogue: 0,0:19:13.67,0:19:15.09,Default,,0,0,0,,Millet gidelim!
Dialogue: 0,0:19:15.09,0:19:16.30,Default,,0,0,0,,Tamam.
Dialogue: 0,0:19:16.30,0:19:16.97,Default,,0,0,0,,Tamam.
Dialogue: 0,0:19:17.88,0:19:18.59,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:19:19.84,0:19:21.39,Default,,0,0,0,,Güzel.
Dialogue: 0,0:19:23.89,0:19:25.39,Default,,0,0,0,,Kurata, pas ver!
Dialogue: 0,0:19:25.39,0:19:26.81,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:19:26.81,0:19:28.73,Default,,0,0,0,,Lanet olsun be!
Dialogue: 0,0:19:28.73,0:19:30.19,Default,,0,0,0,,Shutetsu atak yapıyor.
Dialogue: 0,0:19:30.19,0:19:33.44,Default,,0,0,0,,Seri paslarla Nankatsu sahasında\Nhızla ilerliyorlar!
Dialogue: 0,0:19:34.77,0:19:37.86,Default,,0,0,0,,Kontrol kulesi Izawa-kun'a geldi top!
Dialogue: 0,0:19:37.86,0:19:38.78,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:19:40.15,0:19:44.12,Default,,0,0,0,,Izawa-kun'un sinyaliyle\NShutetsu'nun atağı başladı!
Dialogue: 0,0:19:44.12,0:19:45.37,Default,,0,0,0,,Ulan seni...
Dialogue: 0,0:19:46.40,0:19:47.29,Default,,0,0,0,,Taki!
Dialogue: 0,0:19:47.58,0:19:49.87,Default,,0,0,0,,Ve kanattaki Taki-kun'a...
Dialogue: 0,0:19:51.67,0:19:53.67,Default,,0,0,0,,Shutetsu'nun bilinen taktiği bu!
Dialogue: 0,0:19:53.67,0:19:55.42,Default,,0,0,0,,Sana bırakıyorum Sakurai!
Dialogue: 0,0:19:56.17,0:20:00.13,Default,,0,0,0,,Topu sürdükten sonra kale çizgisine\Nilerlerken topu veriyor.
Dialogue: 0,0:20:00.13,0:20:02.05,Default,,0,0,0,,Forvet Kisugi-kun atakta!
Dialogue: 0,0:20:02.05,0:20:04.35,Default,,0,0,0,,Shutetsu'nun zafer düzeni bu!
Dialogue: 0,0:20:04.35,0:20:05.01,Default,,0,0,0,,Pekala...
Dialogue: 0,0:20:06.01,0:20:08.27,Default,,0,0,0,,İlk gol Shutetsu'nun mu olacak?!
Dialogue: 0,0:20:10.10,0:20:11.23,Default,,0,0,0,,Engelledi!
Dialogue: 0,0:20:11.23,0:20:13.65,Default,,0,0,0,,Nankatsu şutu engelledi!
Dialogue: 0,0:20:14.40,0:20:15.02,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:15.02,0:20:16.23,Default,,0,0,0,,Başardın!
Dialogue: 0,0:20:16.23,0:20:18.44,Default,,0,0,0,,Tsubasa'dan da bu beklenirdi!
Dialogue: 0,0:20:21.07,0:20:22.70,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:20:22.70,0:20:25.12,Default,,0,0,0,,Anlıyorum. Demek böyle pozisyon alacak.
Dialogue: 0,0:20:25.12,0:20:29.45,Default,,0,0,0,,Gerçekten mi?!\NS-Shutetsu'nun zafer düzeni engellendi!
Dialogue: 0,0:20:29.45,0:20:30.79,Default,,0,0,0,,Ne yapıyorsunuz?!
Dialogue: 0,0:20:30.79,0:20:32.54,Default,,0,0,0,,Çabuk topu geri alın!
Dialogue: 0,0:20:32.54,0:20:33.96,Default,,0,0,0,,T-Tamam!
Dialogue: 0,0:20:37.67,0:20:39.13,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:39.13,0:20:40.05,Default,,0,0,0,,Ulan...
Dialogue: 0,0:20:41.47,0:20:42.76,Default,,0,0,0,,Harika bir çalım.
Dialogue: 0,0:20:42.76,0:20:45.60,Default,,0,0,0,,Shutetsu topa dokunamıyor bile!
Dialogue: 0,0:20:45.60,0:20:47.85,Default,,0,0,0,,O da kim?
Dialogue: 0,0:20:47.85,0:20:50.85,Default,,0,0,0,,Topu o kadar iyi kontrol\Neden birisi mi vardı bizde?
Dialogue: 0,0:20:51.85,0:20:54.15,Default,,0,0,0,,Bilmiyor musunuz?
Dialogue: 0,0:20:54.15,0:20:58.53,Default,,0,0,0,,O ünlü Ozora Tsubasa-kun!
Dialogue: 0,0:20:58.53,0:21:00.44,Default,,0,0,0,,Ozora Tsubasa...
Dialogue: 0,0:21:00.44,0:21:02.82,Default,,0,0,0,,Hey Tsubasa!
Dialogue: 0,0:21:03.74,0:21:05.74,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:21:05.74,0:21:07.16,Default,,0,0,0,,Uzun bir pas!
Dialogue: 0,0:21:07.16,0:21:09.41,Default,,0,0,0,,Top direkt kale önüne geliyor.
Dialogue: 0,0:21:09.41,0:21:12.46,Default,,0,0,0,,Tsubasa, neden gelmiyorsun?
Dialogue: 0,0:21:12.46,0:21:15.58,Default,,0,0,0,,Bu maç seninle benim mücadelemiz olmalıydı.
Dialogue: 0,0:21:15.58,0:21:16.38,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:21:17.04,0:21:18.92,Default,,0,0,0,,Pası aldım!
Dialogue: 0,0:21:18.92,0:21:21.34,Default,,0,0,0,,Neden Ishizaki'ye pas veriyorsun?
Dialogue: 0,0:21:21.34,0:21:23.84,Default,,0,0,0,,Başardım! Önüm boş!
Dialogue: 0,0:21:23.84,0:21:26.64,Default,,0,0,0,,Ishizaki-kun ceza sahasına girdi!
Dialogue: 0,0:21:26.64,0:21:28.89,Default,,0,0,0,,Bastır Nankatsu!
Dialogue: 0,0:21:28.89,0:21:31.89,Default,,0,0,0,,Al bakalım Wakabayashi!
Dialogue: 0,0:21:31.89,0:21:33.69,Default,,0,0,0,,Ishizaki-kun vurdu!
Dialogue: 0,0:21:36.02,0:21:37.06,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:21:37.06,0:21:39.61,Default,,0,0,0,,Neden gelmiyorsun Tsubasa?!
Dialogue: 0,0:21:42.82,0:21:44.15,Default,,0,0,0,,Durdurdu!
Dialogue: 0,0:21:44.15,0:21:45.57,Default,,0,0,0,,Ne?!
Dialogue: 0,0:21:45.57,0:21:48.66,Default,,0,0,0,,Ülkenin en iyi kalecisi Wakabayashi-kun...
Dialogue: 0,0:21:48.66,0:21:52.37,Default,,0,0,0,,...Nankatsu'nun şutunu\Nkıpırdamadan durdurdu!
Dialogue: 0,0:21:53.04,0:21:54.08,Default,,0,0,0,,Çocuklar!
Dialogue: 0,0:21:54.08,0:21:55.71,Default,,0,0,0,,Rakibimiz sadece Tsubasa!
Dialogue: 0,0:21:55.71,0:21:57.21,Default,,0,0,0,,Çabuk gol atın!
Dialogue: 0,0:21:57.21,0:21:59.38,Default,,0,0,0,,Bu maçtaki hedefimiz 50 gol!
Dialogue: 0,0:22:00.50,0:22:01.63,Default,,0,0,0,,50 gol...
Dialogue: 0,0:22:01.63,0:22:02.92,Default,,0,0,0,,Izawa!
Dialogue: 0,0:22:05.17,0:22:07.97,Default,,0,0,0,,Tsubasa. Gel bakalım.
Dialogue: 0,0:22:07.97,0:22:12.77,Default,,0,0,0,,Wakabayashi-kun, bu ben ve senin\Narandaki bir mücadele.
Dialogue: 0,0:22:15.89,0:22:20.21,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Romaji,,0,0,0,,chotto aremi na eesu ga tooru
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Türkçe,,0,0,0,,sert bakışıyla geçiyor bir yıldız
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Romaji,,0,0,0,,suguremono da to machijuu sawagu
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Türkçe,,0,0,0,,tüm şehir söylüyor harika birisi olduğunu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Romaji,,0,0,0,,chochou sanba, jiguzagu sanba
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Türkçe,,0,0,0,,kelebek sambası, zikzak samba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Romaji,,0,0,0,,aitsu no uwasa de chanba mo hashiru
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Türkçe,,0,0,0,,onun hakkındaki söylentiler\Nsambayı bile harekete geçiriyor
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Romaji,,0,0,0,,sore ni tsukete mo oretacha nan darou
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Türkçe,,0,0,0,,onun aksine bizim burada olma sebebimiz
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Romaji,,0,0,0,,booru hitotsu ni kirikiri mai sa
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Türkçe,,0,0,0,,top için delirmek
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Romaji,,0,0,0,,itsuka kimeru ze, inazuma shuuto
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Türkçe,,0,0,0,,bir gün şimşek gibi vuruşum hedefine ulaşacak
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Romaji,,0,0,0,,son toki ore ga suupaa hiiroo sa
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Türkçe,,0,0,0,,o an bir süper kahraman olacağım işte ben
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Romaji,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Türkçe,,0,0,0,,alevlen ve ez geç delikanlı
