Dialogue: 0,0:00:07.40,0:00:10.56,Default,,0,0,0,,{\pos(637.333,626.333)}- TOKYO -
Dialogue: 0,0:00:30.76,0:00:31.47,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:00:32.16,0:00:35.47,Default,,0,0,0,,Dikkatli ol ve çok uzaklaşma sakın.
Dialogue: 0,0:00:37.68,0:00:39.08,Default,,0,0,0,,Cidden ya...
Dialogue: 0,0:00:39.43,0:00:42.56,Default,,0,0,0,,Futbol topu ver, mutlu olmasına yetsin.
Dialogue: 0,0:00:42.72,0:00:43.72,Default,,0,0,0,,Gerçekten öyle.
Dialogue: 0,0:00:54.80,0:00:58.52,Default,,0,0,0,,Bu seyahatim bittiğinde\NTsubasa 2 yaşına basacak.
Dialogue: 0,0:00:59.08,0:01:01.11,Default,,0,0,0,,Unutmasın seni.
Dialogue: 0,0:01:02.52,0:01:04.52,Default,,0,0,0,,Ağlamayacak bu sefer.
Dialogue: 0,0:01:06.76,0:01:08.00,Default,,0,0,0,,Hey, Tsubasa nerede?
Dialogue: 0,0:01:08.23,0:01:10.00,Default,,0,0,0,,Ne? Az önce buradaydı.
Dialogue: 0,0:01:10.47,0:01:12.72,Default,,0,0,0,,Tek başına yola çıkması tehlikeli.
Dialogue: 0,0:01:13.11,0:01:14.23,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:01:24.80,0:01:25.47,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:01:31.32,0:01:32.23,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:09.76,0:03:13.72,Default,,0,0,0,,{\pos(168,542)}Bölüm 1
Dialogue: 0,0:03:09.76,0:03:13.72,Default,,0,0,0,,{\pos(432,608.667)}Gökyüzüne Kanat Açma
Dialogue: 0,0:03:09.76,0:03:13.72,Default,,0,0,0,,{\pos(1005.333,678)}Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:03:14.43,0:03:17.28,Default,,0,0,0,,{\pos(674.667,610.333)}- 10 Yıl Sonra - Pasifik Okyanusu - 
Dialogue: 0,0:03:29.52,0:03:30.72,Default,,0,0,0,,Oğlun mu?
Dialogue: 0,0:03:31.16,0:03:33.52,Default,,0,0,0,,Evet, adı Tsubasa.
Dialogue: 0,0:03:35.32,0:03:37.68,Default,,0,0,0,,Ama futbol sahasında olmamasına rağmen...
Dialogue: 0,0:03:38.00,0:03:40.16,Default,,0,0,0,,...formayla poz vermiş.
Dialogue: 0,0:03:40.72,0:03:42.36,Default,,0,0,0,,Bugün taşınıyorlar.
Dialogue: 0,0:03:43.64,0:03:45.84,Default,,0,0,0,,Yeni eve taşındığını haber veriyor.
Dialogue: 0,0:03:46.00,0:03:47.32,Default,,0,0,0,,Demek öyle.
Dialogue: 0,0:03:47.68,0:03:48.95,Default,,0,0,0,,Hem öyle görünüyor ki...
Dialogue: 0,0:03:49.40,0:03:53.23,Default,,0,0,0,,...bu çocuğun annesine yardım etme\Nkonusunda hiç isteği yok.
Dialogue: 0,0:03:54.23,0:03:58.56,Default,,0,0,0,,{\pos(664,614)}- Nankatsu - Shizuoka Bölgesi -
Dialogue: 0,0:03:59.40,0:04:01.00,Default,,0,0,0,,Size emanet.
Dialogue: 0,0:04:01.16,0:04:02.16,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:04:02.76,0:04:05.28,Default,,0,0,0,,Tsubasa! Nereye kayboldun?
Dialogue: 0,0:04:05.47,0:04:07.04,Default,,0,0,0,,Gel de bir yardım et!
Dialogue: 0,0:04:17.92,0:04:20.34,Default,,0,0,0,,Anne, ben şehre bakmaya gidiyorum.
Dialogue: 0,0:04:20.65,0:04:23.44,Default,,0,0,0,,Ne?! Dursana Tsubasa!
Dialogue: 0,0:04:25.72,0:04:27.40,Default,,0,0,0,,Hey!
Dialogue: 0,0:04:27.92,0:04:31.36,Default,,0,0,0,,Of bu çocuk...\NYaptı yine yapacağını.
Dialogue: 0,0:04:31.52,0:04:33.84,Default,,0,0,0,,Oğlunuz topu çok seviyor.
Dialogue: 0,0:04:34.23,0:04:35.16,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:35.32,0:04:38.76,Default,,0,0,0,,Top sayesinde hayatta zaten.
Dialogue: 0,0:04:40.52,0:04:41.68,Default,,0,0,0,,O çocuk...
Dialogue: 0,0:04:41.92,0:04:44.60,Default,,0,0,0,,...futbol topu ile birlikte büyüdü.
Dialogue: 0,0:04:45.84,0:04:47.76,Default,,0,0,0,,{\i1}Mucize gibiydi gerçekten.{\i0}
Dialogue: 0,0:04:51.04,0:04:51.60,Default,,0,0,0,,{\i1}Tsubasa!{\i0}
Dialogue: 0,0:05:03.84,0:05:04.84,Default,,0,0,0,,{\i1}Tsubasa!{\i0}
Dialogue: 0,0:05:06.11,0:05:08.14,Default,,0,0,0,,{\i1}Araba çarptığında...{\i0}
Dialogue: 0,0:05:08.60,0:05:13.40,Default,,0,0,0,,{\i1}...yere düştüğünde de futbol topu\Ntampon görevi gördüğünden...{\i0}
Dialogue: 0,0:05:13.56,0:05:16.80,Default,,0,0,0,,{\i1}...hiç yara almadan kurtuldu Tsubasa.{\i0}
Dialogue: 0,0:05:20.76,0:05:23.04,Default,,0,0,0,,{\i1}O günden beri hep futbolla ilgilenir.
Dialogue: 0,0:05:24.52,0:05:25.52,Default,,0,0,0,,Fuji Dağı!
Dialogue: 0,0:05:26.04,0:05:31.15,Default,,0,0,0,,{\i1}Sanki futbol oynamak için doğmuş gibi.{\i0}
Dialogue: 0,0:05:36.28,0:05:38.00,Default,,0,0,0,,{\i1}İşte yeni şehre geldim!{\i0}
Dialogue: 0,0:05:53.56,0:05:54.56,Default,,0,0,0,,Merhaba!
Dialogue: 0,0:06:03.95,0:06:04.95,Default,,0,0,0,,Affedersiniz!
Dialogue: 0,0:06:06.36,0:06:07.84,Default,,0,0,0,,Elbette, buyur.
Dialogue: 0,0:06:24.04,0:06:27.43,Default,,0,0,0,,# Nankatsu İlkokulu #
Dialogue: 0,0:06:28.11,0:06:29.80,Default,,0,0,0,,Burası Nankatsu Okulu.
Dialogue: 0,0:06:30.76,0:06:32.40,Default,,0,0,0,,Shutetsu nerede ki?
Dialogue: 0,0:06:47.68,0:06:49.00,Default,,0,0,0,,Futbol sahası!
Dialogue: 0,0:06:54.84,0:06:58.00,Default,,0,0,0,,Hey Ishizaki, bu da ne demek?
Dialogue: 0,0:06:58.47,0:07:00.60,Default,,0,0,0,,Neden ilkokul öğrencilerini getirdin?
Dialogue: 0,0:07:00.95,0:07:01.84,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:02.40,0:07:04.43,Default,,0,0,0,,Anlaşmamıza göre...
Dialogue: 0,0:07:04.68,0:07:07.43,Default,,0,0,0,,...Nankatsu'yu 10-0 yendiğimizden\Nsaha bizde kalacaktı.
Dialogue: 0,0:07:08.00,0:07:10.43,Default,,0,0,0,,Yani biz Shutetsu'da.
Dialogue: 0,0:07:10.60,0:07:11.56,Default,,0,0,0,,Kapa çeneni be!
Dialogue: 0,0:07:11.72,0:07:14.43,Default,,0,0,0,,Zaten kendi sahanız var!
Dialogue: 0,0:07:14.60,0:07:15.87,Default,,0,0,0,,Bunu bize bırakın!
Dialogue: 0,0:07:16.28,0:07:19.68,Default,,0,0,0,,Ulusal olarak isim yapmamız\Nyeni üyeler getirdi.
Dialogue: 0,0:07:20.16,0:07:22.95,Default,,0,0,0,,O saha, A takımımız için.
Dialogue: 0,0:07:23.68,0:07:25.95,Default,,0,0,0,,Burası ise B takımı için.
Dialogue: 0,0:07:26.28,0:07:28.36,Default,,0,0,0,,B takımı mı dedin?!
Dialogue: 0,0:07:29.32,0:07:30.72,Default,,0,0,0,,Hey Wakabayashi!
Dialogue: 0,0:07:30.87,0:07:33.84,Default,,0,0,0,,Futbolda azıcık bir şeyler başarman\Nbize emir vermeni gerektirmez!
Dialogue: 0,0:07:35.11,0:07:37.23,Default,,0,0,0,,Alt sınıflar için önemli bir saha bu!
Dialogue: 0,0:07:37.40,0:07:39.28,Default,,0,0,0,,Tartışmaya girmeden bize ver!
Dialogue: 0,0:07:39.56,0:07:40.60,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:07:41.11,0:07:44.87,Default,,0,0,0,,Vermeyeceğim bayağı bariz aslında.
Dialogue: 0,0:07:46.00,0:07:48.64,Default,,0,0,0,,Siz de pes etmiyorsunuz ama.
Dialogue: 0,0:07:49.56,0:07:52.60,Default,,0,0,0,,Öyleyse buna bir müsabakayla karar verelim.
Dialogue: 0,0:07:52.95,0:07:54.28,Default,,0,0,0,,Bizimle müsabaka mı yapacaksın?
Dialogue: 0,0:07:56.04,0:07:56.76,Default,,0,0,0,,Evet.
Dialogue: 0,0:07:57.16,0:07:58.72,Default,,0,0,0,,Her kulübün kaptanı...
Dialogue: 0,0:07:59.00,0:08:00.68,Default,,0,0,0,,...bir atış yapacak.
Dialogue: 0,0:08:01.84,0:08:05.04,Default,,0,0,0,,Ragbi, hentbol... Ne olduğu önemsiz.
Dialogue: 0,0:08:05.95,0:08:08.32,Default,,0,0,0,,Kendi spor dallarınızla gelin.
Dialogue: 0,0:08:15.04,0:08:17.36,Default,,0,0,0,,Ceza sahası dışından...
Dialogue: 0,0:08:17.52,0:08:19.76,Default,,0,0,0,,...her topu durdurabileceğime\Nbahse giriyorum.
Dialogue: 0,0:08:20.23,0:08:21.80,Default,,0,0,0,,Sahayı istiyorsanız...
Dialogue: 0,0:08:22.20,0:08:24.40,Default,,0,0,0,,...gelin de gol atmayı deneyin bana!
Dialogue: 0,0:08:25.23,0:08:26.64,Default,,0,0,0,,Ne herif ama...
Dialogue: 0,0:08:29.28,0:08:32.68,Default,,0,0,0,,Olur da bir gol bile atarsanız\Nsaha sizindir.
Dialogue: 0,0:08:35.72,0:08:37.16,Default,,0,0,0,,Ulan seni...
Dialogue: 0,0:08:37.68,0:08:39.20,Default,,0,0,0,,Ciddisin demek.
Dialogue: 0,0:08:40.00,0:08:41.00,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:08:41.14,0:08:45.81,Default,,0,0,0,,Genç dahi kaleci Wakabayashi olsan bile...
Dialogue: 0,0:08:46.56,0:08:50.20,Default,,0,0,0,,...bu müsabakayı kazanma şansın yok!
Dialogue: 0,0:08:51.76,0:08:53.76,Default,,0,0,0,,Müsabaka gösterecek bunu.
Dialogue: 0,0:08:59.16,0:09:00.43,Default,,0,0,0,,Ben başlıyorum.
Dialogue: 0,0:09:00.92,0:09:03.84,Default,,0,0,0,,İzle de öğren Ishizaki.\NHemen halledeceğim.
Dialogue: 0,0:09:04.00,0:09:05.40,Default,,0,0,0,,Sana güveniyorum Senpai!
Dialogue: 0,0:09:11.11,0:09:12.56,Default,,0,0,0,,Geliyor!
Dialogue: 0,0:09:19.56,0:09:22.56,Default,,0,0,0,,Gördün mü? Futbolun aksine ragbi topu...
Dialogue: 0,0:09:22.72,0:09:24.84,Default,,0,0,0,,...nereye gidecek anlayamazsın!
Dialogue: 0,0:09:32.28,0:09:33.80,Default,,0,0,0,,Başardın Kaptan!
Dialogue: 0,0:09:34.43,0:09:36.20,Default,,0,0,0,,Harikasın Kaptan!
Dialogue: 0,0:09:37.28,0:09:38.64,Default,,0,0,0,,Bu birdi.
Dialogue: 0,0:09:41.60,0:09:44.00,Default,,0,0,0,,Tamam, sıradaki hentbol.
Dialogue: 0,0:09:44.47,0:09:48.00,Default,,0,0,0,,Futbol topu, hentbol topunun iki katıdır.
Dialogue: 0,0:09:48.52,0:09:50.08,Default,,0,0,0,,İçeri atamazsam...
Dialogue: 0,0:09:51.43,0:09:54.11,Default,,0,0,0,,...hentbol takımının yüz karası olurum!
Dialogue: 0,0:09:56.72,0:09:58.11,Default,,0,0,0,,- Olamaz!\N- İnanılmaz!
Dialogue: 0,0:10:01.23,0:10:03.92,Default,,0,0,0,,Dahi kaleci Wakabayashi'den de bu beklenirdi.
Dialogue: 0,0:10:04.32,0:10:05.95,Default,,0,0,0,,Övmesene şunu.
Dialogue: 0,0:10:06.36,0:10:10.08,Default,,0,0,0,,Biricik alt sınıflarımızın\Nsahasını bırakamayız.
Dialogue: 0,0:10:11.84,0:10:13.28,Default,,0,0,0,,Şimdi benim sıram.
Dialogue: 0,0:10:13.43,0:10:15.08,Default,,0,0,0,,Senpai, ellerinden öper!
Dialogue: 0,0:10:17.16,0:10:20.36,Default,,0,0,0,,Ne kadar iyi olsan da\Nbunu durdurman imkansız.
Dialogue: 0,0:10:20.60,0:10:23.87,Default,,0,0,0,,Bunu atamazsam beyzbolu bırakırım.
Dialogue: 0,0:10:26.23,0:10:26.95,Default,,0,0,0,,Gel!
Dialogue: 0,0:10:29.92,0:10:31.64,Default,,0,0,0,,O gülüş de niye?!
Dialogue: 0,0:10:32.40,0:10:32.95,Default,,0,0,0,,Gel!
Dialogue: 0,0:10:33.52,0:10:34.64,Default,,0,0,0,,Seni korkutmasın!
Dialogue: 0,0:10:34.80,0:10:37.28,Default,,0,0,0,,En hızlı şekilde dümdüz at yeter!
Dialogue: 0,0:10:37.64,0:10:38.23,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:40.04,0:10:41.20,Default,,0,0,0,,Bununla...
Dialogue: 0,0:10:42.36,0:10:43.56,Default,,0,0,0,,...bitecek bu iş!
Dialogue: 0,0:10:47.64,0:10:49.84,Default,,0,0,0,,Nasıl tuttu?!
Dialogue: 0,0:10:55.43,0:10:57.43,Default,,0,0,0,,Canavar bu herif.
Dialogue: 0,0:10:58.95,0:11:00.11,Default,,0,0,0,,Sıradaki kim?
Dialogue: 0,0:11:12.52,0:11:13.52,Default,,0,0,0,,Harika!
Dialogue: 0,0:11:15.20,0:11:17.20,Default,,0,0,0,,Ne oldu? Bitti mi hemen?
Dialogue: 0,0:11:19.00,0:11:20.36,Default,,0,0,0,,Bitmiş gibi duruyor.
Dialogue: 0,0:11:20.80,0:11:22.23,Default,,0,0,0,,Son olarak ben varım!
Dialogue: 0,0:11:27.32,0:11:30.04,Default,,0,0,0,,Bir atlet olarak ne atacaksın?
Dialogue: 0,0:11:31.00,0:11:32.00,Default,,0,0,0,,Bunu.
Dialogue: 0,0:11:33.23,0:11:36.00,Default,,0,0,0,,Cirit mi?! Çok tehlikeli değil mi Senpai?!
Dialogue: 0,0:11:36.47,0:11:40.04,Default,,0,0,0,,Ne? Uzunu kapattığımdan sorun değil.
Dialogue: 0,0:11:40.56,0:11:42.87,Default,,0,0,0,,Ne olduğu bana fark etmez.
Dialogue: 0,0:11:43.11,0:11:44.76,Default,,0,0,0,,Kibirli züppe seni.
Dialogue: 0,0:11:48.11,0:11:49.84,Default,,0,0,0,,Bunu durdurabilecek misin bakalım?
Dialogue: 0,0:11:50.80,0:11:51.72,Default,,0,0,0,,Gel.
Dialogue: 0,0:12:08.20,0:12:09.04,Default,,0,0,0,,Zıpladı!
Dialogue: 0,0:12:12.11,0:12:14.04,Default,,0,0,0,,Tekmeledi!
Dialogue: 0,0:12:19.23,0:12:20.52,Default,,0,0,0,,Cidden mi?
Dialogue: 0,0:12:22.84,0:12:24.28,Default,,0,0,0,,Anlaştık öyleyse.
Dialogue: 0,0:12:26.00,0:12:27.56,Default,,0,0,0,,Düzgünce antrenman yapın.
Dialogue: 0,0:12:27.80,0:12:29.20,Default,,0,0,0,,B-Baş üstüne!
Dialogue: 0,0:12:35.95,0:12:39.64,Default,,0,0,0,,İlk kez bu kadar harika\Nbir kaleci görüyorum!
Dialogue: 0,0:12:46.32,0:12:47.32,Default,,0,0,0,,Senpai.
Dialogue: 0,0:12:47.95,0:12:49.72,Default,,0,0,0,,Üzgünüm Ishizaki.
Dialogue: 0,0:12:50.76,0:12:52.84,Default,,0,0,0,,Biz de antrenman yapmalıyız.
Dialogue: 0,0:12:53.28,0:12:55.20,Default,,0,0,0,,Kusura kalma, vazgeç sen bu sahadan.
Dialogue: 0,0:12:56.28,0:12:59.20,Default,,0,0,0,,Olamaz! Böyle sorun çözülmez ki!
Dialogue: 0,0:13:00.60,0:13:03.60,Default,,0,0,0,,Bu devirde senpaine bile güvenmeyeceksin.
Dialogue: 0,0:13:03.80,0:13:04.92,Default,,0,0,0,,Ishizaki.
Dialogue: 0,0:13:06.11,0:13:07.43,Default,,0,0,0,,İşin bitti mi?
Dialogue: 0,0:13:07.60,0:13:09.92,Default,,0,0,0,,Antrenman yapacağız da burada.
Dialogue: 0,0:13:11.87,0:13:12.87,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:13:13.76,0:13:15.80,Default,,0,0,0,,Ne fiyaka ama!
Dialogue: 0,0:13:15.95,0:13:17.92,Default,,0,0,0,,Sana kaybetmedik ki hem!
Dialogue: 0,0:13:20.64,0:13:21.52,Default,,0,0,0,,Ne?
Dialogue: 0,0:13:23.32,0:13:25.92,Default,,0,0,0,,Baksana, az önceki kaleci nereye gitti?
Dialogue: 0,0:13:26.36,0:13:29.28,Default,,0,0,0,,Bilmem. Evine dönmüştür.
Dialogue: 0,0:13:29.60,0:13:31.43,Default,,0,0,0,,Evinin yerini söyler misin o zaman?
Dialogue: 0,0:13:31.84,0:13:33.56,Default,,0,0,0,,Öğrensen ne yapacaksın ki?
Dialogue: 0,0:13:34.56,0:13:35.68,Default,,0,0,0,,Meydan okumak istiyorum!
Dialogue: 0,0:13:35.92,0:13:37.32,Default,,0,0,0,,Meydan okumak mı?!
Dialogue: 0,0:13:37.76,0:13:41.36,Default,,0,0,0,,Aptal mısın sen?!\NAz önce görmedin mi onu?!
Dialogue: 0,0:13:41.56,0:13:44.16,Default,,0,0,0,,- Beyzbol topunu bile yakaladı.\N- Meydan okuma!
Dialogue: 0,0:13:46.20,0:13:48.92,Default,,0,0,0,,Ama o kadar merak ediyorsan göstereyim.
Dialogue: 0,0:13:49.60,0:13:50.60,Default,,0,0,0,,Teşekkürler!
Dialogue: 0,0:13:51.87,0:13:54.08,Default,,0,0,0,,Adın ne?
Dialogue: 0,0:13:54.60,0:13:56.68,Default,,0,0,0,,Ben Ishizaki Ryo.
Dialogue: 0,0:13:57.23,0:13:59.60,Default,,0,0,0,,Ben de Ozora Tsubasa.
Dialogue: 0,0:14:03.00,0:14:07.95,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:14:18.84,0:14:19.60,Default,,0,0,0,,Bu arada...
Dialogue: 0,0:14:21.08,0:14:23.72,Default,,0,0,0,,...sürekli top sürüyorsun da neden yani?
Dialogue: 0,0:14:23.95,0:14:25.64,Default,,0,0,0,,- Seviyorum.\N- Topu mu?!
Dialogue: 0,0:14:27.11,0:14:29.76,Default,,0,0,0,,Futbolu. Sen sevmiyor musun?
Dialogue: 0,0:14:30.23,0:14:32.36,Default,,0,0,0,,Seviyorum tabii.
Dialogue: 0,0:14:35.20,0:14:37.47,Default,,0,0,0,,{\i1}Bayağı yetenekli aslında.{\i0}
Dialogue: 0,0:14:47.84,0:14:51.40,Default,,0,0,0,,Anlıyorum, bugün taşındın değil mi?
Dialogue: 0,0:14:51.84,0:14:54.32,Default,,0,0,0,,Buradan tüm şehri görebilirsin.
Dialogue: 0,0:14:54.52,0:14:56.43,Default,,0,0,0,,- Güzel yer, değil mi?\N- Evet!
Dialogue: 0,0:14:56.92,0:14:58.00,Default,,0,0,0,,Bak, orası.
Dialogue: 0,0:14:58.95,0:15:01.43,Default,,0,0,0,,O kocaman evde Wakabayashi yaşıyor.
Dialogue: 0,0:15:02.47,0:15:04.11,Default,,0,0,0,,Orası mı? Anladım.
Dialogue: 0,0:15:04.60,0:15:07.92,Default,,0,0,0,,Şehrin en eski ailelerinden birisidir.
Dialogue: 0,0:15:10.95,0:15:12.08,Default,,0,0,0,,Hey, sen--
Dialogue: 0,0:15:23.72,0:15:24.72,Default,,0,0,0,,Nasıl?
Dialogue: 0,0:15:26.11,0:15:29.16,Default,,0,0,0,,Sen de gördün mü\NWakabayashi-kun'un evini?
Dialogue: 0,0:15:30.43,0:15:32.84,Default,,0,0,0,,Sen de ona meydan okumak istiyor musun?
Dialogue: 0,0:15:33.23,0:15:36.47,Default,,0,0,0,,Sen ne yapıyorsun?\NTopla mı konuşuyorsun?
Dialogue: 0,0:15:37.08,0:15:38.72,Default,,0,0,0,,İyi ki bu şehre taşınmışız.
Dialogue: 0,0:15:39.36,0:15:41.92,Default,,0,0,0,,İlginç şeyler yaşayacak gibi hissediyorum.
Dialogue: 0,0:15:43.16,0:15:46.72,Default,,0,0,0,,Bu şehirde futbol tutkumu yaşayacağım.
Dialogue: 0,0:15:47.28,0:15:49.76,Default,,0,0,0,,B-Baksana Ozora...
Dialogue: 0,0:15:50.28,0:15:52.40,Default,,0,0,0,,- Tsubasa desen olur.\N- Tamamdır.
Dialogue: 0,0:15:52.72,0:15:54.04,Default,,0,0,0,,Öyleyse Tsubasa...
Dialogue: 0,0:15:54.64,0:15:56.52,Default,,0,0,0,,...neyin peşindesin bilmiyorum ama...
Dialogue: 0,0:15:56.84,0:15:59.95,Default,,0,0,0,,...senin gibi bir yer elması,\NWakabayashi'yi yenemez.
Dialogue: 0,0:16:00.43,0:16:03.32,Default,,0,0,0,,Ulusal turnuvayı kazanmış birisi o ve...
Dialogue: 0,0:16:03.56,0:16:06.11,Default,,0,0,0,,...bir tane bile gol yememişti.
Dialogue: 0,0:16:06.52,0:16:07.68,Default,,0,0,0,,Ayrıca o...
Dialogue: 0,0:16:09.92,0:16:12.72,Default,,0,0,0,,Ulan! Dediklerimi dinliyor musun?!
Dialogue: 0,0:16:13.87,0:16:15.56,Default,,0,0,0,,Ne yapıyorsun be?!
Dialogue: 0,0:16:17.87,0:16:18.95,Default,,0,0,0,,Bu iş görür.
Dialogue: 0,0:16:19.80,0:16:21.23,Default,,0,0,0,,Bu da ne?
Dialogue: 0,0:16:36.52,0:16:38.20,Default,,0,0,0,,Hey, ciddi misin?
Dialogue: 0,0:16:38.64,0:16:42.11,Default,,0,0,0,,Bu topu Wakabayashi'nin evine\Nyollayabileceğini mi düşünüyorsun?
Dialogue: 0,0:16:44.23,0:16:45.80,Default,,0,0,0,,Geliyor!
Dialogue: 0,0:16:54.56,0:16:55.52,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:16:56.52,0:16:58.00,Default,,0,0,0,,Git!
Dialogue: 0,0:17:06.92,0:17:08.23,Default,,0,0,0,,- Bu...\N- ...saçmalık!
Dialogue: 0,0:17:14.92,0:17:16.23,Default,,0,0,0,,Ne oldu Genzo?
Dialogue: 0,0:17:19.16,0:17:20.40,Default,,0,0,0,,O top...
Dialogue: 0,0:17:20.76,0:17:21.84,Default,,0,0,0,,Mikami-san...
Dialogue: 0,0:17:22.28,0:17:23.80,Default,,0,0,0,,Bunun geldiği yer...
Dialogue: 0,0:17:24.43,0:17:25.72,Default,,0,0,0,,...oradaki tepe.
Dialogue: 0,0:17:25.95,0:17:26.64,Default,,0,0,0,,Ne?
Dialogue: 0,0:17:27.20,0:17:28.60,Default,,0,0,0,,Yanılıyor olmalısın.
Dialogue: 0,0:17:28.76,0:17:31.00,Default,,0,0,0,,Buradan orası ne kadar\Nuzak biliyor musun?
Dialogue: 0,0:17:31.47,0:17:32.32,Default,,0,0,0,,Ama...
Dialogue: 0,0:17:34.23,0:17:35.92,Default,,0,0,0,,{\i1}# Ozora Tsubasa müsabaka istiyor #{\i0}
Dialogue: 0,0:17:36.08,0:17:38.32,Default,,0,0,0,,Ozora Tsubasa...
Dialogue: 0,0:17:39.64,0:17:42.84,Default,,0,0,0,,H-Harika! Tam yerine gitti!
Dialogue: 0,0:17:43.16,0:17:44.72,Default,,0,0,0,,Umarım kabul eder.
Dialogue: 0,0:17:45.11,0:17:47.08,Default,,0,0,0,,Harikasın be sen!
Dialogue: 0,0:17:47.32,0:17:49.08,Default,,0,0,0,,Ne harika vurdun öyle!
Dialogue: 0,0:17:49.60,0:17:51.04,Default,,0,0,0,,Nasıl yaptın?
Dialogue: 0,0:17:52.16,0:17:54.08,Default,,0,0,0,,Gizli alet falan mı var?
Dialogue: 0,0:17:54.36,0:17:56.08,Default,,0,0,0,,Yok tabii.
Dialogue: 0,0:17:56.43,0:18:00.25,Default,,0,0,0,,Yine de Wakabayashi'yi yenme\Nşansın olabilir senin!
Dialogue: 0,0:18:00.49,0:18:01.45,Default,,0,0,0,,Kabul edecektir.
Dialogue: 0,0:18:01.64,0:18:03.80,Default,,0,0,0,,Kesinlikle meydan okumanı kabul edecektir.
Dialogue: 0,0:18:05.16,0:18:07.04,Default,,0,0,0,,{\i1}# Ozora Tsubasa müsabaka istiyor #{\i0}
Dialogue: 0,0:18:07.20,0:18:07.72,Default,,0,0,0,,Genzo!
Dialogue: 0,0:18:08.23,0:18:11.72,Default,,0,0,0,,Yanlış görmüş olmalısın.\NOradan gelmesi imkansız.
Dialogue: 0,0:18:17.47,0:18:19.52,Default,,0,0,0,,Birisi şu köpeği durdurabilir mi?!
Dialogue: 0,0:18:19.80,0:18:20.78,Default,,0,0,0,,Dur John!
Dialogue: 0,0:18:28.23,0:18:29.16,Default,,0,0,0,,Of...
Dialogue: 0,0:18:29.32,0:18:30.20,Default,,0,0,0,,Sen de kimsin?!
Dialogue: 0,0:18:30.36,0:18:33.04,Default,,0,0,0,,- Paparazi bu, polisi arıyorum.\N- Dur bir dur!
Dialogue: 0,0:18:33.20,0:18:34.64,Default,,0,0,0,,Paparazi değilim.
Dialogue: 0,0:18:35.28,0:18:38.72,Default,,0,0,0,,Sadece tepeden gelen\Ntopu takip ediyordum...
Dialogue: 0,0:18:39.16,0:18:42.00,Default,,0,0,0,,...ve buraya vardım işte.
Dialogue: 0,0:18:43.32,0:18:45.56,Default,,0,0,0,,Öyleyse bu top gerçekten de--
Dialogue: 0,0:18:45.92,0:18:49.56,Default,,0,0,0,,Ayrıca bunu atan benim gibi\Nbir çocuk.
Dialogue: 0,0:18:49.92,0:18:50.72,Default,,0,0,0,,Çocuk mu dedin?!
Dialogue: 0,0:18:51.56,0:18:53.84,Default,,0,0,0,,Bir yetişkinin el yazısı değil bu.
Dialogue: 0,0:18:58.84,0:19:00.52,Default,,0,0,0,,- Al.\N- Teşekkürler.
Dialogue: 0,0:19:01.20,0:19:03.87,Default,,0,0,0,,Wakabayashi'yi kesinlikle yenmelisin.
Dialogue: 0,0:19:04.16,0:19:05.52,Default,,0,0,0,,Bu dondurma hatırına!
Dialogue: 0,0:19:10.80,0:19:12.92,Default,,0,0,0,,Meydan okuma öncesinde demelisin ki...
Dialogue: 0,0:19:14.00,0:19:20.52,Default,,0,0,0,,...onu yenersen o futbol sahasını\Nbiz Nankatsu'ya verecek.
Dialogue: 0,0:19:21.08,0:19:21.95,Default,,0,0,0,,Neden?
Dialogue: 0,0:19:22.28,0:19:23.28,Default,,0,0,0,,Neden mi?
Dialogue: 0,0:19:24.00,0:19:28.16,Default,,0,0,0,,Az önce Wakabayashi ve üst sınıflar\Narasındaki müsabakayı görmedin mi?
Dialogue: 0,0:19:28.47,0:19:29.32,Default,,0,0,0,,Gördüm ama...
Dialogue: 0,0:19:30.00,0:19:32.95,Default,,0,0,0,,...zaten iki kale olduğundan...
Dialogue: 0,0:19:33.28,0:19:35.52,Default,,0,0,0,,...her takım kavga etmek yerine kullanabilir.
Dialogue: 0,0:19:38.36,0:19:39.60,Default,,0,0,0,,{\i1}Ozora Tsubasa...{\i0}
Dialogue: 0,0:19:40.16,0:19:41.47,Default,,0,0,0,,{\i1}Kimin nesi bu?{\i0}
Dialogue: 0,0:19:42.32,0:19:44.40,Default,,0,0,0,,{\i1}O tepeden topu attı.{\i0}
Dialogue: 0,0:19:45.52,0:19:49.04,Default,,0,0,0,,{\i1}Bana meydan okuyorsa\NNankatsu'dan mı yani?{\i0}
Dialogue: 0,0:19:49.72,0:19:50.47,Default,,0,0,0,,{\i1}Hayır.{\i0}
Dialogue: 0,0:19:50.64,0:19:54.76,Default,,0,0,0,,{\i1}O futbol kulübünde o kadar\Niyi vuracak birisi yok.{\i0}
Dialogue: 0,0:19:57.87,0:19:58.84,Default,,0,0,0,,{\i1}Bir saniye.{\i0}
Dialogue: 0,0:19:59.28,0:20:03.23,Default,,0,0,0,,{\i1}Ama hiçbir ilkokul öğrencisi de\No kadar sert vuramaz.{\i0}
Dialogue: 0,0:20:04.04,0:20:04.84,Default,,0,0,0,,{\i1}Evet.{\i0}
Dialogue: 0,0:20:05.00,0:20:08.76,Default,,0,0,0,,{\i1}O kadar kötü yazsa bile\Nortaokul veya lise öğrencisi olmalı.{\i0}
Dialogue: 0,0:20:09.84,0:20:10.60,Default,,0,0,0,,Mikami-san.
Dialogue: 0,0:20:12.04,0:20:13.84,Default,,0,0,0,,Bir şey mi oldu Mikami-san?
Dialogue: 0,0:20:14.08,0:20:14.92,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:15.47,0:20:18.11,Default,,0,0,0,,O adamı bir yerlerden görmüş gibiyim.
Dialogue: 0,0:20:18.60,0:20:20.28,Default,,0,0,0,,O sarhoşu mu?
Dialogue: 0,0:20:23.84,0:20:24.43,Default,,0,0,0,,Bak.
Dialogue: 0,0:20:24.84,0:20:26.84,Default,,0,0,0,,Burası az önceki futbol sahası işte.
Dialogue: 0,0:20:27.08,0:20:27.80,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:28.76,0:20:29.84,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:20:30.00,0:20:33.20,Default,,0,0,0,,Bir çocuk o kadar uzağa atamaz.
Dialogue: 0,0:20:33.76,0:20:36.52,Default,,0,0,0,,Genzo, senin için bile biraz imkansız.
Dialogue: 0,0:20:36.76,0:20:37.76,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:40.95,0:20:42.23,Default,,0,0,0,,Wakabayashi bu!
Dialogue: 0,0:20:42.40,0:20:43.08,Default,,0,0,0,,Bak.
Dialogue: 0,0:20:43.32,0:20:44.47,Default,,0,0,0,,Topu tutuyor.
Dialogue: 0,0:20:44.95,0:20:46.72,Default,,0,0,0,,Meydan okumamı almış.
Dialogue: 0,0:20:50.32,0:20:52.76,Default,,0,0,0,,Wakabayashi, geldin iyi ki!
Dialogue: 0,0:20:53.11,0:20:56.32,Default,,0,0,0,,Sana meydan okuyan kişi bu işte!
Dialogue: 0,0:20:56.72,0:20:59.84,Default,,0,0,0,,- Ne dedin?\N- Böyle küçük bir çocuk...
Dialogue: 0,0:21:04.64,0:21:05.72,Default,,0,0,0,,Saçmalama be!
Dialogue: 0,0:21:05.87,0:21:09.16,Default,,0,0,0,,Onun gibi bir yerden bitme\No kadar güçlü tekme atamaz!
Dialogue: 0,0:21:09.52,0:21:11.40,Default,,0,0,0,,Atabilir be, atabilir!
Dialogue: 0,0:21:11.56,0:21:13.95,Default,,0,0,0,,Kendi gözlerimle gördüm ben!
Dialogue: 0,0:21:14.28,0:21:15.28,Default,,0,0,0,,Pekala...
Dialogue: 0,0:21:17.52,0:21:19.00,Default,,0,0,0,,Doğru mu değil mi...
Dialogue: 0,0:21:19.23,0:21:21.20,Default,,0,0,0,,...cevabı şimdi göreceğiz!
Dialogue: 0,0:21:22.36,0:21:23.76,Default,,0,0,0,,Al!
Dialogue: 0,0:21:25.36,0:21:26.87,Default,,0,0,0,,Dikkat et! Geliyor!
Dialogue: 0,0:21:32.52,0:21:35.11,Default,,0,0,0,,{\i1}Attığım topun yönünü değiştirdi!{\i0}
Dialogue: 0,0:21:40.23,0:21:41.18,Default,,0,0,0,,Sen...
Dialogue: 0,0:21:42.76,0:21:44.60,Default,,0,0,0,,Dur! Otobüs geliyor!
Dialogue: 0,0:21:59.43,0:22:00.47,Default,,0,0,0,,Wakabayashi-kun.
Dialogue: 0,0:22:00.87,0:22:03.11,Default,,0,0,0,,Meydan okumamı kabul et.
Dialogue: 0,0:22:06.52,0:22:07.28,Default,,0,0,0,,Sen...
Dialogue: 0,0:22:08.08,0:22:09.47,Default,,0,0,0,,...Ozora Tsubasa'sın.
Dialogue: 0,0:22:10.23,0:22:13.72,Default,,0,0,0,,Evet, ben Ozora Tsubasa'yım!
Dialogue: 0,0:22:14.88,0:22:19.96,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:23:50.04,0:23:59.92,Default,,0,0,0,,Gelecek Bölüm: Uçuyor!
