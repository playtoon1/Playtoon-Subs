Dialogue: 0,0:12:27.01,0:12:32.19,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:00.73,0:00:04.71,Default,,0,0,0,,{\i1}Tsubasalar ulusal turnuvaya katılmaya\Nhak kazanmıştı ama...{\i0}
Dialogue: 0,0:00:04.71,0:00:08.19,Default,,0,0,0,,{\i1}...Wakabayashi'nin durumu kötüleşmişti.{\i0}
Dialogue: 0,0:00:08.19,0:00:11.06,Default,,0,0,0,,{\i1}Ulusallara katılamayacaktı!{\i0}
Dialogue: 0,0:00:11.06,0:00:12.68,Default,,0,0,0,,{\i1}Kötüleşen yaralanmasıyla...{\i0}
Dialogue: 0,0:00:12.68,0:00:15.36,Default,,0,0,0,,{\i1}...maçta oynamak yerine\Narkada kalmalıydı.{\i0}
Dialogue: 0,0:00:15.36,0:00:18.39,Default,,0,0,0,,{\i1}Tsubasa, Wakabayashi'nin yokluğunu kapatıp...{\i0}
Dialogue: 0,0:00:18.39,0:00:21.08,Default,,0,0,0,,{\i1}...finallere kadar kazanmaya\Ndevam edeceğine söz vermişti.{\i0}
Dialogue: 0,0:00:21.88,0:00:24.24,Default,,0,0,0,,{\i1}u an yeni kaptan olarak\Nseçilen Tsubasa ile...{\i0}
Dialogue: 0,0:00:24.24,0:00:28.58,Default,,0,0,0,,{\i1}...Nankatsu FC yeni bir\Ntakım olmuştu.{\i0}
Dialogue: 0,0:00:28.58,0:00:29.71,Default,,0,0,0,,{\i1}Ayrıca...{\i0}
Dialogue: 0,0:00:32.21,0:00:37.13,Default,,0,0,0,,Yemin ediyorum! Katılımcılar olarak\Nsportmence oynayacak...
Dialogue: 0,0:00:37.13,0:00:40.87,Default,,0,0,0,,...ve dürüstlük ilkelerine\Nbağlı kalarak mücadele edeceğiz!
Dialogue: 0,0:00:40.87,0:00:45.81,Default,,0,0,0,,Nankatsu Futbol Kulübü Kaptanı\NOzora Tsubasa!
Dialogue: 0,0:00:46.73,0:00:50.86,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvası\Nsonunda top vuruşu yapıyor!{\i0}
Dialogue: 0,0:00:51.72,0:00:55.51,Default,,0,0,0,,{\i1}Şans eseri Nankatsu'nun\Nilk büyük maçı...{\i0}
Dialogue: 0,0:00:55.51,0:01:01.62,Default,,0,0,0,,{\i1}...şampiyonluk konusunda iddialı\Nbir diğer takım olan Meiwa FC ile!{\i0}
Dialogue: 0,0:01:02.59,0:01:05.45,Default,,0,0,0,,Tamamdır. Önemli bir ilk maç olacak.
Dialogue: 0,0:01:05.45,0:01:07.33,Default,,0,0,0,,Millet, her şeyinizi ortaya koyun.
Dialogue: 0,0:01:07.33,0:01:08.83,Default,,0,0,0,,Tamam!
Dialogue: 0,0:01:09.39,0:01:11.21,Default,,0,0,0,,Güzel şut. Sıradaki.
Dialogue: 0,0:01:11.21,0:01:12.21,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:01:12.56,0:01:13.71,Default,,0,0,0,,{\i1}Wakabayashi-kun...{\i0}
Dialogue: 0,0:01:14.32,0:01:17.48,Default,,0,0,0,,{\i1}Meiwa maçına kadar\Ntamamen iyileşmeliyim.{\i0}
Dialogue: 0,0:01:17.48,0:01:20.43,Default,,0,0,0,,Bu yüzden sana yalvarıyorum Tsubasa!
Dialogue: 0,0:01:20.43,0:01:23.12,Default,,0,0,0,,{\i1}İlk maçımız Meiwa'ya karşı olacak ama...{\i0}
Dialogue: 0,0:01:23.12,0:01:28.31,Default,,0,0,0,,{\i1}...senin yerine bu bacaklarımla gol\Natacak ve maçı kesinlikle kazacağım!{\i0}
Dialogue: 0,0:01:29.56,0:01:31.56,Default,,0,0,0,,Tsubasa bayağı gaza gelmiş.{this boy is on fiiire!}
Dialogue: 0,0:01:31.56,0:01:33.57,Default,,0,0,0,,Aynen öyle! Çok gaza geldim!
Dialogue: 0,0:01:33.57,0:01:35.65,Default,,0,0,0,,Bu yüzden hep birlikte\Nelimizden gelenin en iyisini yapalım!
Dialogue: 0,0:01:35.65,0:01:37.28,Default,,0,0,0,,Evet!
Dialogue: 0,0:01:37.74,0:01:41.53,Default,,0,0,0,,Meiwa FC oyunları, vakit\Ngeldi sayılır. Sahaya...
Dialogue: 0,0:01:44.95,0:01:47.46,Default,,0,0,0,,Koç, vakit gelmiş.
Dialogue: 0,0:01:47.46,0:01:53.09,Default,,0,0,0,,Siz önden gidin.\NBenim orada bulunmam gerekmiyor.
Dialogue: 0,0:01:53.96,0:01:56.51,Default,,0,0,0,,{\pos(912,162)}# Meiwa FC Koçu: Kira Kozo #
Dialogue: 0,0:01:56.51,0:02:01.09,Default,,0,0,0,,Normal bir koçun\Nsöyleyeceği bir laf değil pek.
Dialogue: 0,0:02:01.09,0:02:02.01,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:02:02.01,0:02:09.14,Default,,0,0,0,,Ama bu kişi, Hyuga-san ile Takeshi'yi kısa sürede\Neğitip bizi buraya kadar getiren kişi.
Dialogue: 0,0:02:09.14,0:02:12.99,Default,,0,0,0,,Kojiro, zafer kesinlikle senin olacak.{ok, i stopped being too literal as you might have noticed}
Dialogue: 0,0:02:12.99,0:02:15.44,Default,,0,0,0,,Kazanırsan kimse mızmızlanamaz değil mi?
Dialogue: 0,0:02:16.33,0:02:17.44,Default,,0,0,0,,Evet.
Dialogue: 0,0:02:18.59,0:02:21.45,Default,,0,0,0,,Ne trafik var ama be.
Dialogue: 0,0:02:21.45,0:02:25.45,Default,,0,0,0,,Yıllardır bu turnuvayı izlerim ama\Nböyle kalabalık ilk defa oluyor.
Dialogue: 0,0:02:25.45,0:02:29.79,Default,,0,0,0,,Sadece bu maç bile\Nbu kadar dikkat çekmeye yetecek bir maç.
Dialogue: 0,0:02:30.45,0:02:32.03,Default,,0,0,0,,Sabırsızlanıyorum.
Dialogue: 0,0:02:32.03,0:02:36.11,Default,,0,0,0,,Nasıl yeteneklere sahip\Nkişiler olacak acaba aralarında?{mysterious onee-san}
Dialogue: 0,0:04:08.39,0:04:13.35,Default,,0,0,0,,{\fad(00,00)\pos(252,736)}Bölüm 14
Dialogue: 0,0:04:08.39,0:04:13.35,Default,,0,0,0,,{\fad(00,00)\pos(564,820)}Hadi Nankatsu! Meiwa'yı Yen!
Dialogue: 0,0:04:08.39,0:04:13.35,Default,,0,0,0,,{\pos(1532,1025)}Çeviri: ARE-YOU-SURE\N{\fs65)}AreyousureSubs Sunar
Dialogue: 0,0:04:08.96,0:04:14.19,Default - Top,,0,0,0,,{\i1}Grup eleme maçlarını eş zamanlı\Nolarak burada oynanacak.{\i0}
Dialogue: 0,0:04:14.19,0:04:18.51,Default,,0,0,0,,{\i1}Turnuva başlamadan önceki\Nperdenin kalkmasından evvel...{\i0}
Dialogue: 0,0:04:18.51,0:04:21.48,Default,,0,0,0,,{\i1}...kimsenin beklemediği bir şey oldu.{\i0} {#happening. I didn't want to use happening here. it sounds ok in JP but in ENG, idk}
Dialogue: 0,0:04:23.50,0:04:31.29,Default,,0,0,0,,{\i1}Neredeyse tüm seyirciler Nankatsu ve Meiwa\Nmaçının yapılacağı sahaya toplanmıştı!{\i0}
Dialogue: 0,0:04:31.29,0:04:33.81,Default,,0,0,0,,Ne kadar çok seyirci var.
Dialogue: 0,0:04:33.81,0:04:36.55,Default,,0,0,0,,Evet, Brezilya'yı utandıracak bir sahne.
Dialogue: 0,0:04:36.55,0:04:39.17,Default,,0,0,0,,İşini bilen taraftarlar var gerçekten.{not sure, I feel like he says there are many fans know what they are watching, me no koeta? no sense but I have to listen later}{Fr subs used "aficionado", so simply fans. I somehow recognize those guys from earlier episodes :P}
Dialogue: 0,0:04:39.17,0:04:41.03,Default,,0,0,0,,Bu maç kaçmaz abi.{lol dude, stop exaggerating}{or "You can't miss this match"}
Dialogue: 0,0:04:41.03,0:04:44.17,Default,,0,0,0,,Asıl final maçının bu olacağını söylüyorlar.
Dialogue: 0,0:04:44.17,0:04:47.26,Default,,0,0,0,,Ne çok kişi var be!{not too sure good one <3}
Dialogue: 0,0:04:47.26,0:04:50.19,Default,,0,0,0,,Hey Misaki! Elinden geleni yap!
Dialogue: 0,0:04:50.19,0:04:52.31,Default,,0,0,0,,Biz seni destekleyeceğiz!
Dialogue: 0,0:04:52.31,0:04:54.19,Default,,0,0,0,,Teşekkürler Matsuyama!
Dialogue: 0,0:04:54.19,0:04:56.31,Default,,0,0,0,,Furano İlkokulu olarak siz de\Nelinizden geleni yapın.
Dialogue: 0,0:04:56.31,0:04:58.73,Default,,0,0,0,,Tsubasa-kun, elinden geleni yap!
Dialogue: 0,0:04:58.73,0:05:00.56,Default,,0,0,0,,Demek bu maç karar verecek.
Dialogue: 0,0:05:01.48,0:05:04.32,Default,,0,0,0,,En büyük rakibimin kim olacağına.
Dialogue: 0,0:05:06.11,0:05:09.28,Default,,0,0,0,,Meiwa FC sonunda sahaya çıktı.
Dialogue: 0,0:05:11.08,0:05:13.16,Default,,0,0,0,,Uzun zaman oldu Nankatsu.
Dialogue: 0,0:05:13.69,0:05:16.46,Default,,0,0,0,,Hyuga Kojiro...
Dialogue: 0,0:05:19.29,0:05:22.92,Default,,0,0,0,,Dünkü yemini eden sendin.{how dare he does not know the fucking ozora tsubasa?}
Dialogue: 0,0:05:22.92,0:05:25.76,Default,,0,0,0,,Öyleyse ben de yeminimi burada edeceğim!
Dialogue: 0,0:05:27.42,0:05:30.66,Default,,0,0,0,,Ulusal turnuvanın kazananları biz olacağız!
Dialogue: 0,0:05:30.66,0:05:34.85,Default,,0,0,0,,Bu yüzden bu maçı kazanacak\Nolan da Meiwa FC!
Dialogue: 0,0:05:35.98,0:05:38.35,Default,,0,0,0,,S-Seni...
Dialogue: 0,0:05:44.76,0:05:48.78,Default,,0,0,0,,{\i1}İki takımın oyuncuları da pozisyonlarını aldı.{\i0}
Dialogue: 0,0:05:49.35,0:05:54.04,Default,,0,0,0,,{\i1}Shizuoka bölgesi temsilcisi Nankatsu FC,\Nmuazzam paslaşmalarıyla biliniyor.{\i0}
Dialogue: 0,0:05:54.04,0:05:55.91,Default,,0,0,0,,{\i1}4-3-3 diziliyorlar.{\i0}
Dialogue: 0,0:05:56.62,0:06:01.67,Default,,0,0,0,,{\i1}Ünlü kalecileri Wakabayashi-kun maalesef\Nyaralanması sebebiyle oynamayacak.{\i0} {ok, i missed a word here}
Dialogue: 0,0:06:01.67,0:06:04.88,Default,,0,0,0,,{\i1}Ne var ki Morisaki-kun da\Naz çetin ceviz değildir.{\i0}
Dialogue: 0,0:06:04.88,0:06:08.39,Default,,0,0,0,,{\i1}Merkez defanstaki dev\NTakasugi-kun'un varlığıyla...{\i0}
Dialogue: 0,0:06:08.39,0:06:10.76,Default,,0,0,0,,{\i1}...kale çok iyi korunuyor olacak.{\i0}
Dialogue: 0,0:06:10.76,0:06:15.77,Default,,0,0,0,,{\i1}Orta sahada ise Misaki-kun,\NIzawa-kun, Urabe-kun bir üçgen oluşturuyor.{\i0}
Dialogue: 0,0:06:15.77,0:06:21.27,Default,,0,0,0,,{\i1}Son olarak da Taki-kun, Kisugi-kun ve\NTsubasa-kun atakları yapacak.{\i0}
Dialogue: 0,0:06:21.64,0:06:23.73,Default,,0,0,0,,Millet, her şeyimizle bastıralım!
Dialogue: 0,0:06:24.11,0:06:25.52,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:26.32,0:06:30.13,Default,,0,0,0,,{\i1}Karşılarındaki Saitama bölgesi temsilcisi\NMeiwa FC 4-4-2 düzeninde oynuyor.{\i0}
Dialogue: 0,0:06:30.13,0:06:32.48,Default,,0,0,0,,{\i1}Yırtıcı kaplanları\NHyuga Kojiro-kun'un liderliğinde...{\i0}
Dialogue: 0,0:06:32.48,0:06:35.41,Default,,0,0,0,,{\i1}...sıkı çalışmalarıyla rakiplerini\Nalt etmiş bir takımlar.{\i0}
Dialogue: 0,0:06:35.41,0:06:39.89,Default,,0,0,0,,{\i1}Ofansif orta saha pozisyonunda ise\N4. sınıf Sawada Takeshi-kun var.{\i0} {toppushita? what is he saying? attacking midfielder}
Dialogue: 0,0:06:39.89,0:06:42.67,Default,,0,0,0,,{\i1}Bize nasıl bir oyun sergileyecek acaba?{\i0}
Dialogue: 0,0:06:43.85,0:06:45.83,Default,,0,0,0,,{\i1}Son sırada dizilen 4 kişi...{\i0}
Dialogue: 0,0:06:45.83,0:06:48.92,Default,,0,0,0,,{\i1}...kaleci Kawaguchi-kun ile\Nkaleyi koruyacaklar.{\i0}
Dialogue: 0,0:06:50.70,0:06:53.64,Default,,0,0,0,,Manzaraya bak, manzaraya.
Dialogue: 0,0:06:53.64,0:06:56.39,Default,,0,0,0,,Hoşuma gitti bu görüntü.
Dialogue: 0,0:06:57.64,0:07:03.81,Default,,0,0,0,,Hadi göster kendini Kojiro. Büyük sahneye\Nçıkacak olanlar, biz Meiwa FC'den başkası değil.
Dialogue: 0,0:07:05.45,0:07:12.18,Default,,0,0,0,,{\i1}Turnuvanın ilk maçı Nankatsu FC ve Meiwa FC\Narasındaki maçın top vuruşu yapılacak şu an.{\i0}
Dialogue: 0,0:07:13.23,0:07:15.32,Default,,0,0,0,,Meiwa'ya hayatta kaybetmem!
Dialogue: 0,0:07:15.32,0:07:16.37,Default,,0,0,0,,Gel!
Dialogue: 0,0:07:17.07,0:07:21.41,Default,,0,0,0,,{\i1}Nankatsu'nun yıldızı Ozora Tsubasa-kun, düdük\Nçaldığı gibi şiddetli bir şekilde top sürmeye başladı.{\i0}
Dialogue: 0,0:07:21.41,0:07:27.13,Default,,0,0,0,,{\i1}Onun karşısına çıkmak için ise\NMeiwa'nın yıldızı Hyuga Kojiro-kun geliyor!{\i0} {oh boy, this won't end well}
Dialogue: 0,0:07:32.04,0:07:34.55,Default,,0,0,0,,{\i1}İki yıldız erken karşı karşıya geldi!{\i0}
Dialogue: 0,0:07:36.05,0:07:38.78,Default,,0,0,0,,{\i1}Karşılaşma berabere sonuçlanıyor!{\i0} {atari, physical battle}
Dialogue: 0,0:07:38.78,0:07:41.06,Default,,0,0,0,,{\i1}Top gökyüzüne yükseliyor!{\i0}
Dialogue: 0,0:07:41.06,0:07:42.18,Default,,0,0,0,,Ulan sen...
Dialogue: 0,0:07:45.28,0:07:46.11,Default,,0,0,0,,Al!
Dialogue: 0,0:07:46.11,0:07:47.11,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:07:47.11,0:07:49.11,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:51.51,0:07:53.20,Default,,0,0,0,,{\i1}Bacağım...{\i0}
Dialogue: 0,0:07:53.20,0:07:55.70,Default,,0,0,0,,{\i1}Az önceki çarpışma sonrası titriyor.{\i0} {shibireru nee~}
Dialogue: 0,0:08:00.37,0:08:03.08,Default,,0,0,0,,{\i1}Meiwa'nın as direği\NHyuga-kun yetişemiyor!{\i0}
Dialogue: 0,0:08:03.08,0:08:05.71,Default,,0,0,0,,{\i1}Nankatsu erkenden gol atma\Nfırsatı mı yakalayacak?{\i0}
Dialogue: 0,0:08:06.11,0:08:07.25,Default,,0,0,0,,Sana bırakıyorum!
Dialogue: 0,0:08:07.25,0:08:09.04,Default,,0,0,0,,Tamamdır, bende!
Dialogue: 0,0:08:09.94,0:08:12.05,Default,,0,0,0,,{\i1}Ne var ki Meiwa atağı kesiyor!{\i0}
Dialogue: 0,0:08:12.05,0:08:15.80,Default,,0,0,0,,{\i1}Herkesin dilindeki 4. sınıf\NSawada Takeshi-kun!{\i0}
Dialogue: 0,0:08:15.80,0:08:17.97,Default,,0,0,0,,{\i1}Erkenden yeteneklerini gösteriyor.{\i0}
Dialogue: 0,0:08:17.97,0:08:18.93,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:08:18.93,0:08:20.10,Default,,0,0,0,,Takeshi...
Dialogue: 0,0:08:21.68,0:08:22.73,Default,,0,0,0,,Seni...
Dialogue: 0,0:08:23.29,0:08:24.48,Default,,0,0,0,,Ne?
Dialogue: 0,0:08:27.34,0:08:27.99,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:08:27.99,0:08:29.12,Default,,0,0,0,,{\i1}Verkaç!{\i0}
Dialogue: 0,0:08:29.12,0:08:32.04,Default,,0,0,0,,{\i1}4. sınıf Sawada-kun'un topu bu kadar\Niyi kontrol etmesi beklenmezdi!{\i0}
Dialogue: 0,0:08:32.04,0:08:35.40,Default,,0,0,0,,{\i1}Bu sefer fırsatı elde eden Meiwa FC mi\Nilk golü atacak yoksa?{\i0}
Dialogue: 0,0:08:35.40,0:08:38.17,Default,,0,0,0,,Şimdi bacağım daha iyi sanırım.
Dialogue: 0,0:08:38.17,0:08:39.74,Default,,0,0,0,,Tamamdır, hadi Takeshi!
