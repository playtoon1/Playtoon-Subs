Comment: 0,0:22:20.11,0:23:50.11,Default,,0,0,0,,ED
Dialogue: 0,0:00:01.02,0:00:05.52,Default,,0,0,0,,Sonunda şampiyon Nankatsu ikinci yarıda skoru eşitlemeyi başardı.
Dialogue: 0,0:00:06.10,0:00:09.96,Default,,0,0,0,,Defans Takasugi'nin sayesinde çok önemli bir golü atmayı başardılar.
Dialogue: 0,0:00:09.96,0:00:12.53,Default,,0,0,0,,Nankatsu böyle devam edip maçı kazanabilecek mi?
Dialogue: 0,0:00:12.53,0:00:18.53,Default,,0,0,0,,Diğer yandan çömez Azumaichi MS skorun eşitlenmesine rağmen iyi bir oyun sergiliyor.
Dialogue: 0,0:00:18.53,0:00:21.47,Default,,0,0,0,,Skoru eşitleyip penaltılara gidebilecekler mi?
Dialogue: 0,0:00:21.47,0:00:22.50,Default,,0,0,0,,Aptallar.
Dialogue: 0,0:00:22.50,0:00:24.01,Default,,0,0,0,,Beraberlik söz konusu bile değil.
Dialogue: 0,0:00:24.01,0:00:25.79,Default,,0,0,0,,Kazancağız!
Dialogue: 0,0:00:26.32,0:00:29.13,Default,,0,0,0,,İkinci yarının bitmesine sadece 10 dakika kaldı.
Dialogue: 0,0:00:29.64,0:00:34.18,Default,,0,0,0,,Maçın kaderini son bir gol belirleyecek!
Dialogue: 0,0:00:36.18,0:00:39.01,Default,,0,0,0,,Soda böyle bitmesine izin vermeyecektir.
Dialogue: 0,0:00:39.01,0:02:08.98,Default,,0,0,0,,{AI AI AI}
Dialogue: 0,0:00:39.01,0:00:54.98,AnimeSeverler,,0,0,0,,'{\b0}Anime{\b1} Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr  \NÇevirmen; Brook ( {\c&HD67C65&}Soul King {\c})
Dialogue: 0,0:02:09.19,0:02:13.57,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}BÖLÜM 36: \NHER BİRİNİN ÇÖZÜMÜ {this may be the first and last time i change an ep title}
Dialogue: 0,0:02:09.81,0:02:11.99,Default-TOP,,0,0,0,,Maç devam ediyor!
Dialogue: 0,0:02:13.78,0:02:15.78,Default,,0,0,0,,Pekala. Herkes ileri.
Dialogue: 0,0:02:15.78,0:02:16.78,Default,,0,0,0,,Evet!
Dialogue: 0,0:02:16.78,0:02:21.81,Default,,0,0,0,,Azumaichi şu ana kadar tamamen defansa odaklanmış olsa da şu an bütün oyuncular ileri doğru gidiyor.
Dialogue: 0,0:02:21.81,0:02:23.03,Default,,0,0,0,,Yiyo'sa bize gelin!
Dialogue: 0,0:02:23.03,0:02:26.29,Default,,0,0,0,,İki takım da ortasahada mücadele ediyor!
Dialogue: 0,0:02:26.29,0:02:30.50,Default,,0,0,0,,Soda Tsuabasa'yı bizzat kendisi markajlıyor!
Dialogue: 0,0:02:34.55,0:02:36.67,Default,,0,0,0,,{\i1}Azumaichi hırsla saldırıyor!
Dialogue: 0,0:02:36.67,0:02:38.49,Default,,0,0,0,,Ancak Nankatsu direniyor!
Dialogue: 0,0:02:38.49,0:02:41.34,Default,,0,0,0,,Heyecan dorukta!
Dialogue: 0,0:02:41.34,0:02:42.97,Default,,0,0,0,,Kaybetme, Nankatsu!
Dialogue: 0,0:02:42.97,0:02:44.93,Default,,0,0,0,,Hadi, Azumaichi!
Dialogue: 0,0:02:47.43,0:02:49.39,Default,,0,0,0,,Nankatsu topu çalıyor!
Dialogue: 0,0:02:49.96,0:02:51.66,Default,,0,0,0,,Pekala, Tsubasa boşta....
Dialogue: 0,0:02:53.80,0:02:55.60,Default,,0,0,0,,Hadi, Iwami!
Dialogue: 0,0:02:55.60,0:02:56.15,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:56.84,0:02:59.22,Default,,0,0,0,,Nankatsu topu Izawa'ya atıyor.
Dialogue: 0,0:02:59.22,0:03:01.71,Default,,0,0,0,,Izawa Tsubasa'nın yerine atağı kontrol edebilecek mi?
Dialogue: 0,0:03:01.71,0:03:02.95,Default,,0,0,0,,Hadi, Taki!
Dialogue: 0,0:03:02.95,0:03:05.66,Default,,0,0,0,,{\i1}Izawa topu Taki'ye atıyor.
Dialogue: 0,0:03:05.66,0:03:06.79,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:03:06.79,0:03:07.50,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:07.50,0:03:09.37,Default,,0,0,0,,Sıra bende!
Dialogue: 0,0:03:09.37,0:03:10.62,Default,,0,0,0,,Beyler geri dönün!
Dialogue: 0,0:03:10.62,0:03:12.42,Default,,0,0,0,,{\i1}Azumaichi'nin saldırıları ardı ardına geliyor!{\i0}
Dialogue: 0,0:03:14.28,0:03:15.96,Default,,0,0,0,,Ama Kisugi pası kesti!
Dialogue: 0,0:03:15.96,0:03:16.92,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:16.92,0:03:20.68,Default,,0,0,0,,Soda hala Tsubasa'ya yakın markaj yapıyor!
Dialogue: 0,0:03:21.76,0:03:27.10,Default,,0,0,0,,İki takımda pozisyon oluşturabilecek bir açıklık bulamadı.
Dialogue: 0,0:03:27.10,0:03:29.18,Default,,0,0,0,,Sadece 5 dakika kaldı!
Dialogue: 0,0:03:31.54,0:03:32.52,Default,,0,0,0,,Al!
Dialogue: 0,0:03:32.52,0:03:34.63,Default,,0,0,0,,{\i1}Ishizaki topu uzaklaştırıyor.{\i0}
Dialogue: 0,0:03:34.63,0:03:37.36,Default,,0,0,0,,{\i1}Azumaichi'nin atağı tekrardan engelleniyor.
Dialogue: 0,0:03:38.11,0:03:40.57,Default,,0,0,0,,İşte maç şimdi başlıyor! Hadi gidelim!
Dialogue: 0,0:03:40.57,0:03:42.11,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:03:42.11,0:03:46.78,Default,,0,0,0,,Soda Tsuabasa'yı markajlamayı bırakıp boştaki topa doğru koşmaya başlıyor.
Dialogue: 0,0:03:47.16,0:03:48.97,Default,,0,0,0,,Soda topa yaklaşıyor!
Dialogue: 0,0:03:48.97,0:03:51.54,Default,,0,0,0,,Diğer yandan da Nankatsu'dan Taki ona meydan okuyor.
Dialogue: 0,0:03:51.54,0:03:53.65,Default,,0,0,0,,Taki, sana güveniyorum.
Dialogue: 0,0:03:53.65,0:03:54.17,Default,,0,0,0,,Pekala!
Dialogue: 0,0:03:54.17,0:03:55.21,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:03:56.14,0:03:57.88,Default,,0,0,0,,Bıçak çelmesi!
Dialogue: 0,0:03:59.88,0:04:03.30,Default,,0,0,0,,Soda topu çalıyor ve atağa bizzat kendisi çıkıyor!
Dialogue: 0,0:04:03.30,0:04:06.14,Default,,0,0,0,,Azumaichi bu sefer golü bulucak gibi.
Dialogue: 0,0:04:06.14,0:04:07.76,Default,,0,0,0,,Morisaki şut çekicek!
Dialogue: 0,0:04:07.76,0:04:10.27,Default,,0,0,0,,Topun falsosuna dikkat et.
Dialogue: 0,0:04:10.27,0:04:10.85,Default,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:04:13.90,0:04:14.69,Default,,0,0,0,,{\i1}Tsubasa...{\i0}
Dialogue: 0,0:04:15.36,0:04:18.07,Default,,0,0,0,,{\i1}Senin Ölü yaprak vuruşun hala yeterince iyi değil.
Dialogue: 0,0:04:18.77,0:04:23.15,Default,,0,0,0,,Anca benim Bıçak Şutu'm\N%100 uzmanlaşılmış durumda!
Dialogue: 0,0:04:27.16,0:04:29.66,Default,,0,0,0,,Ve Razor vuruşu her şekilde işe yarıyor!
Dialogue: 0,0:04:30.07,0:04:32.66,Default,,0,0,0,,Maçı aldık!
Dialogue: 0,0:04:35.36,0:04:36.56,Default,,0,0,0,,Morisaki, diğer tarafa!
Dialogue: 0,0:04:36.56,0:04:38.54,Default,,0,0,0,,Bu sefer diğer tarafa zıpla!
Dialogue: 0,0:04:41.56,0:04:45.22,Default,,0,0,0,,Soda Bıçak Vuruşu'nu yapıyor!
Dialogue: 0,0:04:45.95,0:04:48.19,Default,,0,0,0,,Top bu sefer farklı bir falso alıyor!
Dialogue: 0,0:04:48.19,0:04:49.85,Default,,0,0,0,,Sola doğru yöneliyor!
Dialogue: 0,0:04:49.85,0:04:52.06,Default,,0,0,0,,Bu Ters Bıçak Vuruşu!
Dialogue: 0,0:04:54.12,0:04:55.84,Default,,0,0,0,,Ku-Kutardı!
Dialogue: 0,0:04:55.84,0:04:58.14,Default,,0,0,0,,{\i1}Morisaki bu sefer kurtardı!
Dialogue: 0,0:04:58.14,0:04:59.48,Default,,0,0,0,,İnanılmaz bir kurtarış!
Dialogue: 0,0:05:00.40,0:05:01.42,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:05:01.42,0:05:03.15,Default,,0,0,0,,Başardın! Güzel kurtarıştı!
Dialogue: 0,0:05:03.81,0:05:05.66,Default,,0,0,0,,Pekala! Hadi, Morisaki!
Dialogue: 0,0:05:07.41,0:05:08.62,Default,,0,0,0,,Tamam! Tsubasa!
Dialogue: 0,0:05:08.62,0:05:12.79,Default,,0,0,0,,Soda atak yapmak için ileri çıktığından beri Tsubasa tamamen boşta!\N
Dialogue: 0,0:05:12.79,0:05:13.54,Default,,0,0,0,,Pekala!
Dialogue: 0,0:05:13.54,0:05:17.71,Default,,0,0,0,,{\i1}Azumaichi bütün oyuncularıyla atağa çıktığı için defansta kimse kalmadı!
Dialogue: 0,0:05:17.71,0:05:19.17,Default,,0,0,0,,Lanet olsun! Geri gidin!
Dialogue: 0,0:05:19.17,0:05:21.09,Default,,0,0,0,,Hadi, Tsubasa!
Dialogue: 0,0:05:21.09,0:05:23.95,Default,,0,0,0,,{\i1}Tsubasa bu maçta ilk defa markajsız durumda.{\i0} {and he's coming to fuck your shit up}
Dialogue: 0,0:05:23.95,0:05:26.24,Default,,0,0,0,,İlk defa rahat bir şekilde hareket edebiliyor!
Dialogue: 0,0:05:26.24,0:05:28.18,Default,,0,0,0,,{\i1}Tsubasa, bacağın...{\i0}
Dialogue: 0,0:05:28.18,0:05:29.61,Default,,0,0,0,,Boştayım!
Dialogue: 0,0:05:29.61,0:05:33.77,Default,,0,0,0,,Eğer golü atamazsam, 3. şampiyonluğu ancak rüyamda görürüm.
Dialogue: 0,0:05:35.39,0:05:39.27,Default,,0,0,0,,{\i1}Tsubasa son defansı da geçti ve kaleye doğru ilerliyor!
Dialogue: 0,0:05:39.27,0:05:41.96,Default,,0,0,0,,İşe yaramıyor. Artık kimse onu durduramaz!
Dialogue: 0,0:05:45.38,0:05:46.81,Default,,0,0,0,,Gol!
Dialogue: 0,0:05:46.81,0:05:49.00,Default,,0,0,0,,Tusbasa'nın turnuvadaki ilk golü!
Dialogue: 0,0:05:49.00,0:05:51.12,Default,,0,0,0,,Ve zafer golü!
Dialogue: 0,0:05:51.12,0:05:51.81,Default,,0,0,0,,İşte!
Dialogue: 0,0:05:51.81,0:05:52.54,Default,,0,0,0,,Başardım!
Dialogue: 0,0:05:52.54,0:05:54.31,Default,,0,0,0,,Nankatsu önce geçti!
Dialogue: 0,0:05:54.31,0:06:02.30,Default,,0,0,0,,Maç bitimine dakikalar kala Kaptan Tsubasa takımını zafere götürecek golü attı!
Dialogue: 0,0:06:02.30,0:06:03.86,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:06:03.86,0:06:05.84,Default,,0,0,0,,Öndeyiz!
Dialogue: 0,0:06:05.84,0:06:07.92,Default,,0,0,0,,Boş yere bize telaş yaptırdın!
Dialogue: 0,0:06:07.92,0:06:10.05,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:06:10.05,0:06:12.56,Default,,0,0,0,,Bu golle her şey yoluna girdi.
Dialogue: 0,0:06:13.16,0:06:15.32,Default,,0,0,0,,Nasıl bilebildi!
Dialogue: 0,0:06:15.32,0:06:17.98,Default,,0,0,0,,Ters Bıçak Vuruşumu şu ana kadar\N hiçbir maçta kullanmadım...
Dialogue: 0,0:06:17.98,0:06:21.27,Default,,0,0,0,,Bir kere bile...
Dialogue: 0,0:06:24.78,0:06:27.53,Default,,0,0,0,,Son düdük çalıyor!
Dialogue: 0,0:06:27.53,0:06:32.28,Default,,0,0,0,,{\i1}Azumaichi son ana kadar mücadele etti ama onlar için üzücüdür ki süre bitti.
Dialogue: 0,0:06:32.85,0:06:34.28,Default,,0,0,0,,Skor 2-1.
Dialogue: 0,0:06:34.28,0:06:39.59,Default,,0,0,0,,Hükümsüren şampiyon Nankatsu MS bu maçta bir zorlansa da maçı gene de galibiyetle noktalıyor.
Dialogue: 0,0:06:39.59,0:06:43.29,Default,,0,0,0,,{\i1}Ohhh..! Ölye böyle aldık bu maçı.
Dialogue: 0,0:06:43.29,0:06:45.96,Default,,0,0,0,,{\i1}Azumachi emeklerinin sonucunu alamadı.{\i0} {i derped. i really did well, I honestly think thats perfect tho}
Dialogue: 0,0:06:45.96,0:06:48.55,Default,,0,0,0,,Ama Nankatsu karşısında iyi bir mücadele sergilediler.
Dialogue: 0,0:06:49.17,0:06:50.74,Default,,0,0,0,,Aferin çocuklar.
Dialogue: 0,0:06:50.74,0:06:52.05,Default,,0,0,0,,Çok iyidiniz!
Dialogue: 0,0:06:52.63,0:06:55.68,Default,,0,0,0,,Osaka'nın temsilcisi olarak iyi iş çıkardın, Soda.
Dialogue: 0,0:06:55.68,0:07:00.77,Default,,0,0,0,,Tsubasa Ozora... Sen markajsız bırakılmamalısın.
Dialogue: 0,0:07:00.77,0:07:02.33,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:07:02.33,0:07:06.57,Default,,0,0,0,,Soda öne geçmeye çalışmak yerine Tsubasa'ya markaj yapmaya devam etseydi
Dialogue: 0,0:07:06.57,0:07:09.03,Default,,0,0,0,,maç berabere bitecekti.
Dialogue: 0,0:07:09.03,0:07:12.66,Default,,0,0,0,,Görünüşe göre Nankatsu'yu yenen biz olacağız.
Dialogue: 0,0:07:12.66,0:07:13.53,Default,,0,0,0,,Evet.
Dialogue: 0,0:07:16.54,0:07:17.71,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:07:18.29,0:07:19.79,Default,,0,0,0,,Soda...
Dialogue: 0,0:07:19.79,0:07:23.75,Default,,0,0,0,,Ters Bıçak Vuruşu'mu nasıl tahmin edebildin?
Dialogue: 0,0:07:23.75,0:07:28.55,Default,,0,0,0,,Güzel soru. Eğer Tsubasa bana söylemeseydi kuvvetli ihtimal tutamazdım.
Dialogue: 0,0:07:28.55,0:07:31.38,Default,,0,0,0,,6. his diyelim.
Dialogue: 0,0:07:32.72,0:07:36.43,Default,,0,0,0,,Bacaklarının arasındaki açıya baktığımda öyle vuracağını anlayıverdim.
Dialogue: 0,0:07:36.43,0:07:37.89,Default,,0,0,0,,"Anlayıverdim" mi...
Dialogue: 0,0:07:38.28,0:07:42.52,Default,,0,0,0,,Görüyorsun, topa falso aldırmayla \Nilgili zor zamanlar yaşıyorum.
Dialogue: 0,0:07:43.89,0:07:45.49,Default,,0,0,0,,Görüyorum.
Dialogue: 0,0:07:45.49,0:07:51.23,Default,,0,0,0,,Ben galiba senin gibi ölü yaprak \Nvuruşunda uzmanlaşamayacağım.
Dialogue: 0,0:07:51.23,0:07:53.09,Default,,0,0,0,,Eminki sen başarabilirsin.
Dialogue: 0,0:07:54.28,0:07:57.37,Default,,0,0,0,,Bu arada bacağın iyi mi?
Dialogue: 0,0:07:57.37,0:07:59.66,Default,,0,0,0,,Bacağın mı? Bacağına bir şey mi oldu Tsubasa?
Dialogue: 0,0:07:59.66,0:08:03.20,Default,,0,0,0,,Tsubasa bacağını biraz incitti.
Dialogue: 0,0:08:03.20,0:08:05.18,Default,,0,0,0,,NE?!
Dialogue: 0,0:08:05.18,0:08:09.70,Default,,0,0,0,,Arada bir acıyordu zaten.
Dialogue: 0,0:08:09.70,0:08:10.76,Default,,0,0,0,,İyi o zaman.
Dialogue: 0,0:08:11.80,0:08:16.84,Default,,0,0,0,,Bizi per perişan ettiniz. Şampiyon olmadan gelmeyin.
Dialogue: 0,0:08:16.84,0:08:18.64,Default,,0,0,0,,O konuda sıkıntı yok.
Dialogue: 0,0:08:19.08,0:08:22.48,Default,,0,0,0,,Peki o zaman... Görüşürüz Tsubasa.
Dialogue: 0,0:08:22.48,0:08:25.40,Default,,0,0,0,,Lanet olsun! Kaybettik!
Dialogue: 0,0:08:25.40,0:08:27.36,Default,,0,0,0,,Üzülüp ağlamayın beyler.
Dialogue: 0,0:08:27.36,0:08:28.97,Default,,0,0,0,,Eve başınız dik gidin!
Dialogue: 0,0:08:28.97,0:08:30.23,Default,,0,0,0,,Soda...
Dialogue: 0,0:08:30.23,0:08:32.23,Default,,0,0,0,,Makoto Soda...
Dialogue: 0,0:08:32.23,0:08:36.49,Default,,0,0,0,,Biraz puşt biri olduğunu sanıyordum ama iyi çocukmuşsun.
Dialogue: 0,0:08:40.90,0:08:43.50,Default,,0,0,0,,Nankatsu zor da olsa kazandı.
Dialogue: 0,0:08:43.50,0:08:44.61,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:08:44.61,0:08:49.71,Default,,0,0,0,,Soda'yı Tsubasa'ya rakip görebilir miyiz?
Dialogue: 0,0:08:50.33,0:08:51.96,Default,,0,0,0,,Olabilir.
Dialogue: 0,0:08:51.96,0:08:55.34,Default,,0,0,0,,Tsubasa'nın attığı şu şut hakkında...
Dialogue: 0,0:08:56.40,0:09:00.06,Default,,0,0,0,,Bilerek mi yaptı? Yoksa sadece ...
Dialogue: 0,0:09:00.06,0:09:02.98,Default,,0,0,0,,Tabiki de bilerek yaptı.
Dialogue: 0,0:09:02.98,0:09:06.94,Default,,0,0,0,,Ölü yaprak vuruşu Tsubasa'nın üstünde uzmanlaşmaya çalıştığı vuruş.
Dialogue: 0,0:09:06.94,0:09:08.73,Default,,0,0,0,,Ölü yaprak vuruşu mu?
Dialogue: 0,0:09:08.73,0:09:20.56,Default,,0,0,0,,Evet. Eğer Tsubasa bu vuruşta uzmanlaşırsa\N Tsubasa'yı şimdiden japon milli takımına alabiliriz.
Dialogue: 0,0:09:23.76,0:09:25.79,Default,,0,0,0,,Ona şüphe yok.
Dialogue: 0,0:09:25.79,0:09:30.96,Default,,0,0,0,,Ölü yaprak vuruşu Güney Amerika'da \Nözellikle Brezilya'da görülen bir hareketmiş.
Dialogue: 0,0:09:30.96,0:09:33.71,Default,,0,0,0,,Profesyoneller için bile çok zor olan bir hareket.
Dialogue: 0,0:09:33.71,0:09:37.09,Default,,0,0,0,,Ortaokulun 3. senesinde bu harekette uzmanlaşmak...
Dialogue: 0,0:09:37.84,0:09:42.35,Default,,0,0,0,,{\i1}Tsubasa Ozora gerçekten korkulması gereken bir rakip.{\i0}
Dialogue: 0,0:09:43.70,0:09:45.85,Default,,0,0,0,,İkinci yarının 5 dakikasını geride bıraktık
Dialogue: 0,0:09:45.85,0:09:49.10,Default,,0,0,0,,Geleneksel Ortaokul Futbol Turnuvası'nın ikinci maçı
Dialogue: 0,0:09:49.77,0:09:54.69,Default,,0,0,0,,Tokyo'dan Toho Akademi ve Nara'dan Matsukami MS arasında oluyor.
Dialogue: 0,0:09:49.10,0:09:51.65,Default,,0,0,0,,{\an8}SAVAŞ! SAVAŞ! Toho!
Dialogue: 0,0:09:51.65,0:09:54.69,Default,,0,0,0,,{\an8}hADİ! HADİ! Matsukami! EZİN ONLARI! {kouhou wo mawase? i have no idea what i'm doing}
Dialogue: 0,0:09:54.69,0:09:57.70,Default,,0,0,0,,2. yarı olmasına rağmen hala bir gol göremedik.
Dialogue: 0,0:09:57.70,0:10:03.20,Default,,0,0,0,,Toho Akademi Nankatsu'nun rakiplerinden biri olarak görülen bir takım.
Dialogue: 0,0:10:03.20,0:10:08.29,Default,,0,0,0,,Oyun hakimiyetlerine rağmen hala gol atıcak kadar güçlü bir atağa sahip değiller.
Dialogue: 0,0:10:08.29,0:10:10.69,Default,,0,0,0,,As oyuncuarının yokluğu hissediliyor.
Dialogue: 0,0:10:10.69,0:10:15.97,Default,,0,0,0,,{\i1}Kojiro Hyuga yedek kulübesinde oturmuş öylece duruyor.{\i0}
Dialogue: 0,0:10:16.65,0:10:17.67,Default,,0,0,0,,Sakatlanmış mı?
Dialogue: 0,0:10:17.67,0:10:22.22,Default,,0,0,0,,Yoksa genç oyuncuların tecrübe kazanması için mi kenarda bekletiliyor?
Dialogue: 0,0:10:22.22,0:10:25.50,Default,,0,0,0,,Turnuvada hiç beklenmeyen şeyler oluyor.
Dialogue: 0,0:10:25.50,0:10:28.21,Default,,0,0,0,,Ama hala ayrıntıları bilmiyoruz.
Dialogue: 0,0:10:28.21,0:10:29.48,Default,,0,0,0,,Abi...
Dialogue: 0,0:10:29.48,0:10:32.02,Default,,0,0,0,,Kojiro oynamıyor.
Dialogue: 0,0:10:32.02,0:10:35.78,Default,,0,0,0,,Şimdilik Kojiro yedek kulübesinden gözlem yapıyor.
Dialogue: 0,0:10:35.78,0:10:40.24,Default,,0,0,0,,Defanslarıyla tanınan rakipleri Matsukami MS şu ana kadar gayet iyi gidiyor.
Dialogue: 0,0:10:40.24,0:10:43.37,Default,,0,0,0,,Toho'ya alan bırakmıyorlar.
Dialogue: 0,0:10:44.60,0:10:46.87,Default,,0,0,0,,Topu çaldılar!
Dialogue: 0,0:10:46.87,0:10:49.80,Default,,0,0,0,,Hyuga oynamıyorken Toho'ya kaybetmemiz olanaksız.
Dialogue: 0,0:10:49.80,0:10:52.38,Default,,0,0,0,,Golü atacağız ve Hyuga sahaya çıkıcak!
Dialogue: 0,0:10:52.38,0:10:54.75,Default,,0,0,0,,Bu sefer Matsukami kontra atak yapıyor!
Dialogue: 0,0:10:54.75,0:10:56.09,Default,,0,0,0,,Hadi!
Dialogue: 0,0:10:56.09,0:10:56.84,Default,,0,0,0,,Pekala!
Dialogue: 0,0:10:56.84,0:11:00.34,Default,,0,0,0,,Kaleci Wakashimazu topu sıkıca yakalıyor!
Dialogue: 0,0:11:00.81,0:11:02.99,Default,,0,0,0,,Boşuna ortaokulun bir numaralı kalecisi değil.
Dialogue: 0,0:11:02.99,0:11:05.07,Default,,0,0,0,,Gol olmasına o kadar kolay izin vermiyor.
Dialogue: 0,0:11:05.07,0:11:06.35,Default,,0,0,0,,Hey, Takeshi!
Dialogue: 0,0:11:08.73,0:11:11.31,Default,,0,0,0,,Kontra atak yapma sırası Toho'da!
Dialogue: 0,0:11:11.31,0:11:12.31,Default,,0,0,0,,Sorimachi!
Dialogue: 0,0:11:12.31,0:11:13.11,Default,,0,0,0,,İşte boşluk!
Dialogue: 0,0:11:15.92,0:11:17.51,Default,,0,0,0,,Başardı!
Dialogue: 0,0:11:17.51,0:11:21.73,Default,,0,0,0,,Hyuga'nın yerinde oynayan \NSorimachi'den mükemmel bir şut.
Dialogue: 0,0:11:21.73,0:11:26.49,Default,,0,0,0,,Sawada inanılmaz bir ara pas \Nattı. Müfredata geçicek türdendi.
Dialogue: 0,0:11:27.92,0:11:31.15,Default,,0,0,0,,Hyuga'nın oynamamasına rağmen \NToho hala oldukça güçlü.
Dialogue: 0,0:11:31.15,0:11:32.05,Default,,0,0,0,,Ne yazmalıyım?
Dialogue: 0,0:11:32.05,0:11:33.75,Default,,0,0,0,,Hyuga'yı sonraya sakladıklarını mı?
Dialogue: 0,0:11:33.75,0:11:35.59,Default,,0,0,0,,Yoksa bir sakatlık hikayesi mi?
Dialogue: 0,0:11:35.59,0:11:41.21,Default,,0,0,0,,Koç Kitazume Hyuga'yı oynatmayacağını söylediğinden beri hiçbir yorum yapmadı.
Dialogue: 0,0:11:41.21,0:11:45.97,Default,,0,0,0,,Yapabileceğimiz bir şey yok. Belki de başlığa Sorimachi, Sawada ve Wakashimazu'yu koymalıyız.
Dialogue: 0,0:11:47.85,0:11:53.12,Default,,0,0,0,,Koç Hyuga'yı oynatmayacağını söylüyor ama biz onsuz şampiyon olamayız.
Dialogue: 0,0:11:53.12,0:11:55.90,Default,,0,0,0,,Özellikle Nankatsu'yu yenemeyiz.
Dialogue: 0,0:11:56.87,0:11:58.15,Default,,0,0,0,,Şimdilik finallere kadar dayanalım.
Dialogue: 0,0:11:58.69,0:12:03.66,Default,,0,0,0,,O zamana kadar kaptanımız olmadan kendi gücümüzle kazanmaya devam etmeliyiz.
Dialogue: 0,0:12:17.72,0:12:20.59,Default,,0,0,0,,{\i1}Toho Academy tekrar saldırıyor!
Dialogue: 0,0:12:20.59,0:12:21.45,Default,,0,0,0,,Hadi bir gol daha atalım!
Dialogue: 0,0:12:21.45,0:12:22.34,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:22.34,0:12:24.59,Default,,0,0,0,,Sawada'dan inanılmaz bir orta.
Dialogue: 0,0:12:24.59,0:12:27.60,Default,,0,0,0,,{\i1}Sorimachi topu göğslüyle kontrol etti ve...
Dialogue: 0,0:12:28.75,0:12:29.72,Default,,0,0,0,,Şut çekiyor!
Dialogue: 0,0:12:31.64,0:12:33.64,Default,,0,0,0,,N-ne?!
Dialogue: 0,0:12:31.64,0:12:33.64,Default,,0,0,0,,{HE JUST BROKE THE FUCKING CONCRETE, I'LL GO AND DRINK SOMETHING COOL} {THAT'S BECAUSE HYUGA IS A TIGER THEY CAN'T CONTAIN}
Dialogue: 0,0:12:48.66,0:12:50.16,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:12:50.16,0:12:52.83,Default,,0,0,0,,{\i1}Toho Akademi kolaylıkla ikinci golü de atıyor.
Dialogue: 0,0:12:52.83,0:12:54.16,Default,,0,0,0,,Skor 2-0.
Dialogue: 0,0:12:55.28,0:12:57.17,Default,,0,0,0,,Hey onu yakaladın mı?
Dialogue: 0,0:12:57.17,0:12:59.84,Default,,0,0,0,,Tabiki de! Sorimachi'nin ikinci golünü değil mi?
Dialogue: 0,0:12:59.84,0:13:01.30,Default,,0,0,0,,Aptal, onu değil!
Dialogue: 0,0:13:01.30,0:13:03.30,Default,,0,0,0,,Hyuga'nın şutundan bahsediyorum!
Dialogue: 0,0:13:03.30,0:13:03.59,Default,,0,0,0,,Ne?
Dialogue: 0,0:13:13.98,0:13:16.44,Default,,0,0,0,,Ben klüp evine geri gidiyorum.
Dialogue: 0,0:13:18.52,0:13:20.01,Default,,0,0,0,,{\i1}Hyuga...{\i0}
Dialogue: 0,0:13:21.15,0:13:26.15,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:13:28.03,0:13:32.54,Default,,0,0,0,,{\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}— SAITAMA WORLD STADYUMU —
Dialogue: 0,0:13:32.54,0:13:36.54,Default,,0,0,0,,{\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}— BAY COAST STADYUMU —
Dialogue: 0,0:13:29.41,0:13:32.54,Default-TOP,,0,0,0,,Geneleksel Ortaokul Futbol Turnuvasının ikinci günü.
Dialogue: 0,0:13:33.11,0:13:38.22,Default-TOP,,0,0,0,,İnsanların şimdiden stadyumları doldurmaya başladı.
Dialogue: 0,0:13:41.63,0:13:45.47,Default,,0,0,0,,Hyuga kayboldu demişlerdi ama şimdi maçı sadece yedek klubesinden izliyor.
Dialogue: 0,0:13:45.47,0:13:48.78,Default,,0,0,0,,Sakatlandığına dair dedikodular var.
Dialogue: 0,0:13:48.78,0:13:51.41,Default,,0,0,0,,Nankatsu dün baya zorlandı değil mi?
Dialogue: 0,0:13:51.41,0:13:54.85,Default,,0,0,0,,Duyduğuma göre Azumaichi MS'den Soda iyi iş çıkarmış.
Dialogue: 0,0:13:54.85,0:13:56.19,Default,,0,0,0,,Şimdi çek şutu!
Dialogue: 0,0:13:57.48,0:14:00.09,Default,,0,0,0,,Tsubasa'nın bacağı iyi mi?
Dialogue: 0,0:14:00.09,0:14:03.82,Default,,0,0,0,,Umarım bugün dinlendikten sorna kendine gelir.
Dialogue: 0,0:14:03.82,0:14:04.64,Default,,0,0,0,,Umarım.
Dialogue: 0,0:14:04.64,0:14:06.90,Default,,0,0,0,,Yapabileceğimiz tek şey dua etmek.
Dialogue: 0,0:14:07.85,0:14:10.49,Default,,0,0,0,,Tsubasa bacağının durmunu
Dialogue: 0,0:14:10.49,0:14:14.16,Default,,0,0,0,,bizden nasıl saklar.
Dialogue: 0,0:14:14.16,0:14:16.03,Default,,0,0,0,,Ben de aynı soruyu soruyorum kendi kendime.
Dialogue: 0,0:14:17.00,0:14:21.98,Default,,0,0,0,,Tsubasa düşünceli davranıyordu; Maçın ortasında endişelenmemizi istemedi.
Dialogue: 0,0:14:21.98,0:14:23.75,Default,,0,0,0,,O kadarını ben de biliyorum, ama...
Dialogue: 0,0:14:23.75,0:14:28.63,Default,,0,0,0,,Ama artık onu yormamamız gerektiğini bildiğimiz için daha çok çalışmamız gerektiğinin farkındayız.
Dialogue: 0,0:14:28.63,0:14:32.02,Default,,0,0,0,,Çalışma sırası bizde.
Dialogue: 0,0:14:32.02,0:14:33.94,Default,,0,0,0,,Evet, haklısın.
Dialogue: 0,0:14:33.94,0:14:34.64,Default,,0,0,0,,Pekala!
Dialogue: 0,0:14:34.64,0:14:39.67,Default,,0,0,0,,Hadi Nankatsu'yu kendi gücümüzle şampiyonluğa taşıyalım!
Dialogue: 0,0:14:39.67,0:14:40.65,Default,,0,0,0,,Evet!
Dialogue: 0,0:14:41.73,0:14:45.69,Default,,0,0,0,,{\i1}Tsubasa'nın sakatlanması takımı oldukça teşvik etti.{\i0}
Dialogue: 0,0:14:46.79,0:14:48.29,Default,,0,0,0,,Evet, gayet iyi.
Dialogue: 0,0:14:48.29,0:14:50.45,Default,,0,0,0,,Kemikle ilgili bir sıkıntı yok.
Dialogue: 0,0:14:50.45,0:14:53.02,Default,,0,0,0,,Bacağın şimdi nasıl?
Dialogue: 0,0:14:53.02,0:14:56.70,Default,,0,0,0,,Bir günlük bir dinlenmemden sonra pek acı kalmadı.
Dialogue: 0,0:14:56.70,0:14:59.62,Default,,0,0,0,,Küçük bir burkma sadece.
Dialogue: 0,0:14:59.62,0:15:03.57,Default,,0,0,0,,Ama dediğin gibi bacağın bu tür sakatlanmalara meyilli gibi duruyor.
Dialogue: 0,0:15:03.57,0:15:05.16,Default,,0,0,0,,Bu yüzden dikkatli olmalısın.
Dialogue: 0,0:15:05.16,0:15:05.96,Default,,0,0,0,,Tabiki de.
Dialogue: 0,0:15:05.96,0:15:09.97,Default,,0,0,0,,Bir sonraki maçında ayağını bandajlaman lazım.
Dialogue: 0,0:15:09.97,0:15:14.52,Default,,0,0,0,,Bugün kendini çok zorlama ve antremanlara biraz ara ver.
Dialogue: 0,0:15:14.52,0:15:15.72,Default,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:15:15.72,0:15:17.92,Default,,0,0,0,,Kendine dikkat et.
Dialogue: 0,0:15:17.92,0:15:20.35,Default,,0,0,0,,Çok teşekkür ederim efendim.
Dialogue: 0,0:15:20.35,0:15:21.98,Default,,0,0,0,,Çok teşekkürler.
Dialogue: 0,0:15:23.46,0:15:27.48,Default,,0,0,0,,Her ne kadar sürekli gelsemde \Nhastaneleri hiç sevmiyorum.
Dialogue: 0,0:15:27.48,0:15:30.25,Default,,0,0,0,,Bacağında ciddi bir şey olmaması
Dialogue: 0,0:15:30.25,0:15:31.78,Default,,0,0,0,,iyi olmuş.
Dialogue: 0,0:15:31.78,0:15:32.66,Default,,0,0,0,,Aynen.
Dialogue: 0,0:15:32.66,0:15:38.51,Default,,0,0,0,,Böyle bir zamanda bir kaptan olarak maçta oynayamamak bir felaket olurdu.
Dialogue: 0,0:15:38.51,0:15:41.12,Default,,0,0,0,,Bunun için çok çalıştınız.
Dialogue: 0,0:15:41.12,0:15:44.63,Default,,0,0,0,,Menejerimiz sayesinde.
Dialogue: 0,0:15:44.63,0:15:47.88,Default,,0,0,0,,Dediğine sen bile inanmıyorsun.
Dialogue: 0,0:15:47.88,0:15:50.88,Default,,0,0,0,,{damn tsu, you should've "ieie"}
Dialogue: 0,0:15:53.25,0:15:54.64,Default,,0,0,0,,Ne kadar da büyük bir park böyle.
Dialogue: 0,0:15:54.64,0:15:58.27,Default,,0,0,0,,Pazar günü olduğundan oldukça kalabalık.
Dialogue: 0,0:16:17.82,0:16:21.80,Default,,0,0,0,,Ah tabiya! Eğer bugün antreman yapamıyorsam gidip
Dialogue: 0,0:16:21.80,0:16:25.79,Default,,0,0,0,,Nishikigaoka MS ve Ozusan MS arasındaki maçı izlemeliyim.
Dialogue: 0,0:16:26.24,0:16:28.45,Default,,0,0,0,,Manabu zaten gözlem yapmaya gitti.
Dialogue: 0,0:16:28.45,0:16:31.51,Default,,0,0,0,,Eğer acele edersek Furano'nun \Nmaçından önce varabiliriz.
Dialogue: 0,0:16:31.51,0:16:33.26,Default,,0,0,0,,Tabiki.
Dialogue: 0,0:16:33.26,0:16:34.53,Default,,0,0,0,,Pekala, hadi gidelim!
Dialogue: 0,0:16:34.53,0:16:35.11,Default,,0,0,0,,Bek-
Dialogue: 0,0:16:35.11,0:16:35.76,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:36.67,0:16:40.52,Default,,0,0,0,,Allah'ım ya, sakat ayakla koşuyor.
Dialogue: 0,0:16:46.12,0:16:47.77,Default,,0,0,0,,Kaptan nerede?
Dialogue: 0,0:16:47.77,0:16:49.23,Default,,0,0,0,,Sahada değil.
Dialogue: 0,0:16:51.80,0:16:54.57,Default,,0,0,0,,Koç Hyuga daha gelmedi.
Dialogue: 0,0:16:54.57,0:16:56.14,Default,,0,0,0,,Hyuga gelmeyecek.
Dialogue: 0,0:16:57.35,0:16:59.95,Default,,0,0,0,,3. snıflar için bu son turnuva.
Dialogue: 0,0:16:59.95,0:17:04.41,Default,,0,0,0,,Hyuga bu turnuvada oynamayacağı için burada pratik yapmasına gerek yok.
Dialogue: 0,0:17:04.41,0:17:06.38,Default,,0,0,0,,Bu yüzden gelmemesini ben söyledim.
Dialogue: 0,0:17:06.38,0:17:08.86,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:17:08.86,0:17:12.44,Default,,0,0,0,,Koç Hyuga'sız şampiyon olamayız!
Dialogue: 0,0:17:12.44,0:17:13.88,Default,,0,0,0,,Haklı koç.
Dialogue: 0,0:17:13.88,0:17:14.76,Default,,0,0,0,,Kapayın çenenizi!
Dialogue: 0,0:17:14.76,0:17:16.72,Default,,0,0,0,,Bana karşı mı geliyorsunuz?!
Dialogue: 0,0:17:18.51,0:17:21.60,Default,,0,0,0,,Emirlerimi uygulamak zorundasınız!
Dialogue: 0,0:17:21.60,0:17:25.62,Default,,0,0,0,,Wakashimazu bundan sonra turnuva bitene kadar takımın kaptanı sensin.
Dialogue: 0,0:17:26.14,0:17:27.12,Default,,0,0,0,,Anlaşıldı mı?
Dialogue: 0,0:17:28.40,0:17:30.45,Default,,0,0,0,,K-Koç...
Dialogue: 0,0:17:33.44,0:17:34.96,Default,,0,0,0,,{\i1}Hyuga...{\i0}
Dialogue: 0,0:17:34.96,0:17:36.96,Default,,0,0,0,,{touji...}{You called? <3}
Dialogue: 0,0:17:39.62,0:17:43.73,Default,,0,0,0,,{\an8\i1}Üç oyuncu tarafından çevrelenmiş durumda ama gene de topu bırakmıyor!{\i0}
Dialogue: 0,0:17:43.73,0:17:45.54,Default,,0,0,0,,{\an8\i1}İnanılmaz...{\i0}
Dialogue: 0,0:17:44.32,0:17:45.54,Default,,0,0,0,,Ben döndüm!
Dialogue: 0,0:17:45.96,0:17:48.30,Default,,0,0,0,,Abi!
Dialogue: 0,0:17:48.30,0:17:50.54,Default,,0,0,0,,Umarım iyisinizdir!
Dialogue: 0,0:17:51.02,0:17:52.92,Default,,0,0,0,,Kojiro!
Dialogue: 0,0:17:59.08,0:18:01.81,Default,,0,0,0,,{\i1}Matsuyama topu tutuyor!{\i0}
Dialogue: 0,0:18:01.81,0:18:02.47,Default,,0,0,0,,Burdayım!
Dialogue: 0,0:18:04.47,0:18:07.73,Default,,0,0,0,,{\i1}Matsuyama rakiplerinin dikkatini dağıtıp pas atıyor!{\i0}
Dialogue: 0,0:18:08.54,0:18:08.98,Default,,0,0,0,,Sende!
Dialogue: 0,0:18:10.25,0:18:11.02,Default,,0,0,0,,Güzel!
Dialogue: 0,0:18:11.02,0:18:13.50,Default,,0,0,0,,{\i1}Furano pas trafiğini sürdürüyor.{\i0}
Dialogue: 0,0:18:13.50,0:18:14.86,Default,,0,0,0,,İnanılmaz bir takım oyunu!
Dialogue: 0,0:18:14.86,0:18:20.38,Default,,0,0,0,,{\i1}Furano'nun oyuncuları bu sene çok disiplinli bir takım oyunu sergiliyor.{\i0}
Dialogue: 0,0:18:20.38,0:18:23.95,Default,,0,0,0,,Çok centilmen bir oyun sergilediklerini de söylemek lazım!
Dialogue: 0,0:18:24.61,0:18:25.45,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:18:32.50,0:18:33.36,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:33.36,0:18:36.51,Default,,0,0,0,,Kaptanları Matsuyama atağı golle tamamladı.
Dialogue: 0,0:18:36.51,0:18:38.51,Default,,0,0,0,,Skor 6-0.
Dialogue: 0,0:18:38.51,0:18:39.81,Default,,0,0,0,,Başardılar.
Dialogue: 0,0:18:39.81,0:18:43.51,Default,,0,0,0,,Hokkaido'dan geldiğim onca yola değdi.
Dialogue: 0,0:18:45.90,0:18:47.82,Default,,0,0,0,,Ve maç bitti.
Dialogue: 0,0:18:47.82,0:18:49.37,Default,,0,0,0,,Skor 6-0.
Dialogue: 0,0:18:49.37,0:18:56.53,Default,,0,0,0,,{\i1}Hokkaido'nun temsilcisi Furano MS  Okayama'nın temsilcisi Sakucho MS'yi harika bir takım oyunuyla yendi!{\i0}
Dialogue: 0,0:18:56.53,0:18:59.15,Default,,0,0,0,,{\i1}Furano 2. tura gidiyor.
Dialogue: 0,0:18:59.15,0:19:06.08,Default,,0,0,0,,Furano'nunda Nankatsu ve Toho gibi şampiyonluğa aday bir takım oluğunu düşünüyoruz.
Dialogue: 0,0:19:06.08,0:19:10.70,Default,,0,0,0,,Pekala beyler, böyle devam edip şampiyonluk bayrağını Hokkaido'ya götürelim.
Dialogue: 0,0:19:10.70,0:19:11.54,Default,,0,0,0,,Evet!
Dialogue: 0,0:19:12.41,0:19:23.99,Default,,0,0,0,,Bir sonraki maç Kanagawa'dan Nishikigaoka MS ve Kochi'den Ozusan MS arasında 11:30 da olucak.
Dialogue: 0,0:19:23.99,0:19:27.76,Default,,0,0,0,,Oh, görünüşe göre Furona'nın maçı için tam vaktinde geldik.
Dialogue: 0,0:19:29.32,0:19:33.56,Default,,0,0,0,,Bu kadar koştuktan sorna bacağına \Nbir şey olmadı mı Tsubasa?
Dialogue: 0,0:19:33.56,0:19:35.56,Default,,0,0,0,,Oh, unuttum ben onu!
Dialogue: 0,0:19:35.56,0:19:37.19,Default,,0,0,0,,Oh, sen...! {Insert "oh you meme here}
Dialogue: 0,0:19:38.00,0:19:39.20,Default,,0,0,0,,İşte burada! {the generic bobcut data guy}{bobcut and megane}
Dialogue: 0,0:19:39.20,0:19:40.16,Default,,0,0,0,,Manabu! {dang even his name is " to learn"}
Dialogue: 0,0:19:40.16,0:19:40.82,Default,,0,0,0,,Huh?
Dialogue: 0,0:19:40.82,0:19:42.69,Default,,0,0,0,,Oh, Tsubasa!
Dialogue: 0,0:19:42.69,0:19:44.28,Default,,0,0,0,,Bacağın nasıl?
Dialogue: 0,0:19:44.28,0:19:46.12,Default,,0,0,0,,Gayet iyi.
Dialogue: 0,0:19:46.12,0:19:47.68,Default,,0,0,0,,Önemli bir şey yok.
Dialogue: 0,0:19:47.68,0:19:48.83,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:19:48.83,0:19:51.09,Default,,0,0,0,,Furano nasıldı? {get on with the real shit}
Dialogue: 0,0:19:51.09,0:19:53.09,Default,,0,0,0,,Ah evet, oldukça iyidiler.
Dialogue: 0,0:19:53.09,0:19:56.24,Default,,0,0,0,,Geçen seneye göre olduka gelişmişler.
Dialogue: 0,0:19:56.24,0:19:59.20,Default,,0,0,0,,Önümüzde büyük bir engel olacaklar.
Dialogue: 0,0:19:59.20,0:19:59.84,Default,,0,0,0,,Demek öyle?
Dialogue: 0,0:20:00.24,0:20:05.78,Default,,0,0,0,,Nishikigaoka ve Ozusan koalyca yenebileceğimiz rakipler değil.
Dialogue: 0,0:20:05.78,0:20:09.35,Default,,0,0,0,,Geleneksel Turnuvayı kazanmamıza o kadar koaly izin vermeyecekler galiba.
Dialogue: 0,0:20:10.33,0:20:12.35,Default,,0,0,0,,Kim gelirse gelsin kaybetmeyeceğim.
Dialogue: 0,0:20:12.35,0:20:16.11,Default,,0,0,0,,{\ i1} Bu şekilde yenilmeden ve Brezilya'ya gideceğim. {\ i0}
Dialogue: 0,0:20:16.84,0:20:19.36,Default,,0,0,0,,Tsubasa, ne yapıyorsun burada?
Dialogue: 0,0:20:19.36,0:20:22.50,Default,,0,0,0,,Doktor sana kendine zaman ayırman için fırsat verdi.
Dialogue: 0,0:20:22.50,0:20:25.65,Default,,0,0,0,,Siz ikinizin kendinize daha çok zaman ayırmanız lazım.
Dialogue: 0,0:20:27.11,0:20:29.91,Default,,0,0,0,,Ah! Tsubasa orada! {a wild tsubasa appears!}
Dialogue: 0,0:20:30.40,0:20:32.30,Default,,0,0,0,,Siz de mi geldiniz beyler?
Dialogue: 0,0:20:32.30,0:20:33.08,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:33.08,0:20:35.08,Default,,0,0,0,,Sabah antremanı bitti.
Dialogue: 0,0:20:35.08,0:20:36.79,Default,,0,0,0,,Bizde maçı izlemeye geldik.
Dialogue: 0,0:20:36.79,0:20:39.05,Default,,0,0,0,,Nasıldı Tsubasa? {ya ne salak salak sorular bunlar ya, abi sonra da diyecekler içkiliydi bilmem ne}{ben sana soruyor muyum?}{kaç yaşındasın sen ya}
Dialogue: 0,0:20:39.05,0:20:42.09,Default,,0,0,0,,Gayet iyi.
Dialogue: 0,0:20:42.09,0:20:44.42,Default,,0,0,0,,Bacağından konşmuyoruz...
Dialogue: 0,0:20:44.42,0:20:45.94,Default,,0,0,0,,Siz ikiniz yalnızdınız, değil mi?
Dialogue: 0,0:20:45.94,0:20:47.72,Default,,0,0,0,,En azından el ele tutuştunuz değil mi?
Dialogue: 0,0:20:47.72,0:20:49.22,Default,,0,0,0,,Menejerle yani.
Dialogue: 0,0:20:49.88,0:20:51.50,Default,,0,0,0,,Nasıldı?
Dialogue: 0,0:20:51.50,0:20:53.44,Default,,0,0,0,,Tsuabasa'ya nasıl geçti?
Dialogue: 0,0:20:53.44,0:20:55.15,Default,,0,0,0,,Hiçbir şey olmadı.
Dialogue: 0,0:20:56.23,0:20:59.45,Default,,0,0,0,,Ne hakkında konuşuyorsunuz hanımlar?
Dialogue: 0,0:21:00.98,0:21:04.49,Default,,0,0,0,,Hepsi çok meraklı. {dafuq with that evil mastermind reveal scene}
Dialogue: 0,0:21:08.64,0:21:09.24,Default,,0,0,0,,Huh?
Dialogue: 0,0:21:09.24,0:21:11.50,Default,,0,0,0,,Toho Akademi'den ayrlıyor musun?
Dialogue: 0,0:21:11.50,0:21:14.33,Default,,0,0,0,,Koçla küçük bir anlaşmazlık yaşadık.
Dialogue: 0,0:21:14.33,0:21:17.25,Default,,0,0,0,,Görünüşe göre okul bursum iptal edilecek.
Dialogue: 0,0:21:21.30,0:21:24.56,Default,,0,0,0,,Eğer iptal edilirse ve Toho'nun da bir özel okul olduğunu hesaba katarsak
Dialogue: 0,0:21:24.56,0:21:28.64,Default,,0,0,0,,bizim gibi fakir insanlar için ayrılmaktan başka çare yok.
Dialogue: 0,0:21:29.32,0:21:31.01,Default,,0,0,0,,Bu adil değil abi!
Dialogue: 0,0:21:31.01,0:21:32.78,Default,,0,0,0,,Sıkıntı yok.
Dialogue: 0,0:21:32.78,0:21:37.52,Default,,0,0,0,,Ortaokula geri dönüp bir yandan çalışarak mezun olacağım.
Dialogue: 0,0:21:37.52,0:21:41.78,Default,,0,0,0,,Ama Kojiro, eğer öyle yaparsan\N sevdiğin futbola odaklanamazsın.
Dialogue: 0,0:21:41.78,0:21:43.78,Default,,0,0,0,,Yapacak bir şey yok.
Dialogue: 0,0:21:43.78,0:21:46.68,Default,,0,0,0,,Okuldaki futbol hayatım ortaokulla birlikte bitiyor. {do we all ignore that he drinks cola as if he is drinking konjac}{he spent too much time with kira}
Dialogue: 0,0:21:49.72,0:21:54.09,Default,,0,0,0,,Futbola Şu ana kadar ayırıdğım zaman kadarını artık ayıramam
Dialogue: 0,0:21:54.09,0:21:55.96,Default,,0,0,0,,ama kendi başıma oynamaya devam edebilirim.
Dialogue: 0,0:21:56.39,0:21:58.82,Default,,0,0,0,,Çalışırken oynmaya devam edeceğim.
Dialogue: 0,0:21:58.82,0:22:00.46,Default,,0,0,0,,Kojiro.
Dialogue: 0,0:22:00.46,0:22:03.94,Default,,0,0,0,,Eğer beni ayrılmaya zorluyorsanız sıkıntı yok.
Dialogue: 0,0:22:03.94,0:22:05.42,Default,,0,0,0,,Ama karşılığında...
Dialogue: 0,0:22:09.98,0:22:17.62,Default,,0,0,0,,Ama karşılığında Tsubasa'yla karşılacağım ve onu bu sağ bacağımla alt edeceğim.
Dialogue: 0,0:22:20.94,0:22:25.94,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:50.11,0:23:52.11,Default,,0,0,0,,GELECEK BÖLÜM 37: \NSKYLAB HURRICANE!
Dialogue: 0,0:23:50.11,0:23:55.11,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:00:41.27,0:00:43.98,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:44.89,0:00:47.56,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:48.48,0:00:51.19,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:58.07,0:01:00.91,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:00.91,0:01:07.17,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:01:07.17,0:01:13.05,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta na no ni
Dialogue: 0,0:01:13.05,0:01:19.64,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:01:19.64,0:01:23.64,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:23.64,0:01:28.15,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:28.15,0:01:33.69,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:01:33.69,0:01:35.28,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:01:35.28,0:01:36.49,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:36.49,0:01:39.99,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:01:39.99,0:01:49.88,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:01:49.88,0:01:50.71,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:50.71,0:01:54.51,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:01:54.51,0:01:58.51,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:01:58.51,0:02:04.77,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:02:04.77,0:02:07.56,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:00:41.27,0:00:43.98,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:44.89,0:00:47.56,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:48.48,0:00:51.19,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:58.07,0:01:00.91,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum. {I keep lying to myself}
Dialogue: 0,0:01:00.91,0:01:07.17,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile {burning with loneliness}
Dialogue: 0,0:01:07.17,0:01:13.05,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:13.05,0:01:19.64,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:19.64,0:01:23.64,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:23.64,0:01:28.15,OPED,,0,0,0,,Sesinin özlemi{i hate how weak I am \N yearning for your voice}
Dialogue: 0,0:01:28.15,0:01:33.69,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:01:33.69,0:01:35.28,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:01:35.28,0:01:36.49,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:36.49,0:01:39.99,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:01:39.99,0:01:49.88,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:01:49.88,0:01:50.71,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:50.71,0:01:54.51,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:01:54.51,0:01:58.51,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:01:58.51,0:02:04.77,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:04.77,0:02:07.56,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.83,0:22:44.87,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.87,0:22:50.88,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.88,0:22:56.93,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.93,0:23:01.56,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:03.18,0:23:07.85,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:09.19,0:23:15.28,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:15.28,0:23:21.33,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.33,0:23:25.79,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:27.08,0:23:33.42,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.42,0:23:39.47,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.47,0:23:45.77,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.83,0:22:44.87,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.87,0:22:50.88,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.88,0:22:56.93,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.93,0:23:01.56,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.18,0:23:07.85,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:09.19,0:23:15.28,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:15.28,0:23:21.33,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.33,0:23:25.79,OPED,,0,0,0,,Bir gün, bir şimşek vuruşunu yapacağım!
Dialogue: 0,0:23:27.08,0:23:33.42,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.42,0:23:39.47,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.47,0:23:45.77,OPED,,0,0,0,,Bu hırslı gençlik sahada!
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
