Dialogue: 0,0:14:04.99,0:14:09.99,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:00.64,0:00:02.64,Default,,0,0,0,,{\i1}Morisaki'nin kendisini toplaması sonrası...{\i0}
Dialogue: 0,0:00:02.65,0:00:07.90,Default,,0,0,0,,{\i1}...Tsubasa ve Misaki, Meiwa FC'ye\Nkarşı başarılı ataklar yapmıştı.{\i0}
Dialogue: 0,0:00:07.90,0:00:12.57,Default,,0,0,0,,{\i1}Altta kalmamak için de Misaki'den\Ngüçlü bir çalımla topu alan Kojiro...{\i0}
Dialogue: 0,0:00:12.57,0:00:14.88,Default,,0,0,0,,{\i1}...güçlü ve sert oyunu sayesinde...{\i0}
Dialogue: 0,0:00:14.88,0:00:17.36,Default,,0,0,0,,{\i1}...yoluna çıkan herkesi dağıtmış\Nve vole vurarak bir gol atmıştı.{\i0}
Dialogue: 0,0:00:17.36,0:00:21.99,Default,,0,0,0,,{\i1}Maç, ikilinin stilleri arasındaki\Nmücadeleye dönmüştü.{\i0}
Dialogue: 0,0:00:21.99,0:00:26.50,Default,,0,0,0,,{\i1}Son ana kadar ikili arasında\Namansız bir çekişme olmuştu.{\i0}
Dialogue: 0,0:00:26.50,0:00:29.92,Default,,0,0,0,,{\i1}Stadyum çığlıklarla yıkılıyor!{\i0}
Dialogue: 0,0:00:29.92,0:00:33.09,Default,,0,0,0,,{\i1}Tsubasa-kun ve Hyuga-kun arasındaki\Nkarşılaşma ile başlayan maç...{\i0}
Dialogue: 0,0:00:33.09,0:00:35.59,Default,,0,0,0,,{\i1}...ikili arasında devam etti ve\Nşimdi de ikili arasında bitecek!{\i0}
Dialogue: 0,0:00:37.22,0:00:39.72,Default,,0,0,0,,{\i1}Tsubasa-kun dengesini kaybediyor!{\i0}
Dialogue: 0,0:00:39.72,0:00:40.97,Default,,0,0,0,,{\i1}İşte fırsat!{\i0}
Dialogue: 0,0:00:41.06,0:00:41.68,Default,,0,0,0,,Şimdi!
Dialogue: 0,0:00:41.68,0:00:45.23,Default,,0,0,0,,{\i1}Hyuga-kun şut çekemiyor!\NTsubasa-kun topu uzaklaştırıyor!{\i0}
Dialogue: 0,0:00:45.23,0:00:48.02,Default,,0,0,0,,Bilerek öyle davranmış!
Dialogue: 0,0:00:48.02,0:00:49.06,Default,,0,0,0,,{\i1}Son düdük--{\i0}
Dialogue: 0,0:00:56.82,0:01:00.07,Default,,0,0,0,,{\i1}G-Gol!{\i0}
Dialogue: 0,0:01:00.07,0:01:02.70,Default,,0,0,0,,{\i1}Nankatsu kaybediyor!{\i0}
Dialogue: 0,0:01:05.72,0:01:07.29,Default,,0,0,0,,{\i1}Lanet olsun...{\i0}
Dialogue: 0,0:01:07.29,0:01:10.25,Default,,0,0,0,,{\i1}O... Ağlıyor mu?{\i0}
Dialogue: 0,0:01:12.59,0:01:14.67,Default,,0,0,0,,Sen Hyuga Kojiro-kun'sun değil mi?
Dialogue: 0,0:01:15.56,0:01:18.12,Default,,0,0,0,,Yetenek avcısı olarak geldim.
Dialogue: 0,0:02:50.31,0:02:54.27,Default,,0,0,0,,{\fad(500,500)\pos(364,810)}Bölüm 16:\NAkrobatik Futbol
Dialogue: 0,0:02:50.31,0:02:54.27,Default,,0,0,0,,{\fad(500,500)\pos(1548,909)}Çeviri: ARE-YOU-SURE\N{\fs65)}AreyousureSubs Sunar
Dialogue: 0,0:02:52.06,0:02:54.27,Default-Top,,0,0,0,,Ben mi? Toho Akademisi'ne mi?
Dialogue: 0,0:02:54.27,0:02:57.09,Default,,0,0,0,,Bildiğin gibi Toho Akademisi olarak...
Dialogue: 0,0:02:57.09,0:03:00.78,Default,,0,0,0,,...profesyonel futbolcu yetiştirmeye\Nodaklı ünlü bir okuluz.
Dialogue: 0,0:03:00.78,0:03:04.37,Default,,0,0,0,,Seni davet etmek için hazır sayılırız.
Dialogue: 0,0:03:04.37,0:03:07.95,Default,,0,0,0,,Hyuga-kun futbol yeteneklerin gibi elbette...
Dialogue: 0,0:03:07.95,0:03:12.54,Default,,0,0,0,,...kişiliğine ve günlük\Nyaşam tarzına da bakacağız.
Dialogue: 0,0:03:12.54,0:03:15.56,Default,,0,0,0,,Akademimize katılırsan...
Dialogue: 0,0:03:15.56,0:03:20.13,Default,,0,0,0,,...ortaokul, lise ve üniversite boyunca,\Nyaklaşık 10 yıl boyunca...
Dialogue: 0,0:03:20.13,0:03:23.97,Default,,0,0,0,,...tüm günlük ve akademik\Nmasraflarını karşılayacağız.
Dialogue: 0,0:03:23.97,0:03:25.22,Default,,0,0,0,,Ciddi misiniz?!
Dialogue: 0,0:03:25.22,0:03:26.84,Default,,0,0,0,,Ciddiyiz.
Dialogue: 0,0:03:26.84,0:03:28.43,Default,,0,0,0,,Akademimize katılırsan...
Dialogue: 0,0:03:28.43,0:03:31.31,Default,,0,0,0,,...sevdiğin futbola odaklanabilirsin.
Dialogue: 0,0:03:32.94,0:03:35.48,Default,,0,0,0,,Ama şartlarımız var.
Dialogue: 0,0:03:35.48,0:03:36.76,Default,,0,0,0,,Şart mı?
Dialogue: 0,0:03:36.76,0:03:37.90,Default,,0,0,0,,Evet.
Dialogue: 0,0:03:37.90,0:03:39.55,Default,,0,0,0,,Düşündüğümüz tek kişi sen değilsin.
Dialogue: 0,0:03:39.55,0:03:42.12,Default,,0,0,0,,Forvet olarak bir kişiyi daha...
Dialogue: 0,0:03:42.12,0:03:45.20,Default,,0,0,0,,...Ozora Tsubasa-kun'u da düşünüyorduk.
Dialogue: 0,0:03:45.20,0:03:49.89,Default,,0,0,0,,Önceki maçın kazananıyla\Nkim olacağına karar verelim dedik.
Dialogue: 0,0:03:49.89,0:03:52.58,Default,,0,0,0,,Maçı kazanan Meiwa oldu.
Dialogue: 0,0:03:52.58,0:03:58.27,Default,,0,0,0,,Ama o maça bakarak forvette\NTsubasa-kun mu yoksa sen mi...
Dialogue: 0,0:03:58.27,0:04:00.69,Default,,0,0,0,,...daha iyi anlamak için\Nbiraz zorlandık.
Dialogue: 0,0:04:00.69,0:04:01.94,Default,,0,0,0,,Ne diyorsunuz?!
Dialogue: 0,0:04:01.94,0:04:03.72,Default,,0,0,0,,Ona hayatta kaybetmem ben!
Dialogue: 0,0:04:03.72,0:04:05.58,Default,,0,0,0,,Benim daha iyi olduğum aşikar!
Dialogue: 0,0:04:05.58,0:04:07.30,Default,,0,0,0,,Maçı da kazandık!
Dialogue: 0,0:04:07.30,0:04:09.39,Default,,0,0,0,,Turnuvayı kazanarak bunu bize kanıtla.
Dialogue: 0,0:04:09.39,0:04:10.31,Default,,0,0,0,,Ne?
Dialogue: 0,0:04:10.31,0:04:13.60,Default,,0,0,0,,Söylediğin kadar en iyi sensen...
Dialogue: 0,0:04:13.60,0:04:15.86,Default,,0,0,0,,...turnuvayı kazanarak bunu kanıtla.
Dialogue: 0,0:04:15.86,0:04:18.88,Default,,0,0,0,,Bunu başarırsan\Nhiç şüphe etmeden...
Dialogue: 0,0:04:18.88,0:04:22.28,Default,,0,0,0,,...Toho Akademisi sana futbol\Nbursu sunacak.
Dialogue: 0,0:04:22.28,0:04:23.99,Default,,0,0,0,,Ciddi misiniz?
Dialogue: 0,0:04:23.99,0:04:25.91,Default,,0,0,0,,Evet. Ben yalan söylemem.
Dialogue: 0,0:04:25.91,0:04:28.62,Default,,0,0,0,,Tamamdır! Kesinlikle kazanıp\Nbunu kanıtlayacağım!
Dialogue: 0,0:04:35.27,0:04:40.13,Default,,0,0,0,,Grup aşamalarında 2. bile olsan\Nelemelere çıkarsın.
Dialogue: 0,0:04:40.84,0:04:44.98,Default,,0,0,0,,Tsubasa-kun ile bir kez daha\Nkarşılaşma olasılığın olduğunu aklından çıkarma.
Dialogue: 0,0:04:50.76,0:04:54.05,Default,,0,0,0,,{\i1}Bu sırada Tsubasa kaptanlığındaki Nanaktsu...{\i0}
Dialogue: 0,0:04:54.05,0:04:56.97,Default,,0,0,0,,{\i1}...Meiwa'ya karşı aldıkları mağlubiyetin\Nşokunu bir kenara bırakarak...{\i0}
Dialogue: 0,0:04:56.98,0:05:01.64,Default,,0,0,0,,{\i1}...Fukuoka'dan Osu SS'yi\N9-0 gibi ezici bir şekilde yenmişti...{\i0}
Dialogue: 0,0:05:01.64,0:05:04.69,Default,,0,0,0,,{\i1}...ve gruplardaki ilk galibiyetini almıştı.{\i0}
Dialogue: 0,0:05:01.64,0:05:02.95,Default,,0,0,0,,{\an8}Tsubasa-kun!
Dialogue: 0,0:05:02.95,0:05:04.69,Default,,0,0,0,,{\an8}Kazandık! Kazandık! Kazandık!
Dialogue: 0,0:05:04.69,0:05:07.16,Default,,0,0,0,,Tamamdır! 1-1 oldu böylelikle!
Dialogue: 0,0:05:07.16,0:05:08.95,Default,,0,0,0,,Böyle devam edelim...
Dialogue: 0,0:05:08.95,0:05:10.95,Default,,0,0,0,,...ve de gruplardan çıkalım!
Dialogue: 0,0:05:10.95,0:05:13.74,Default,,0,0,0,,Çok saflık ediyorsunuz!
Dialogue: 0,0:05:13.74,0:05:15.54,Default,,0,0,0,,Ne dedin?
Dialogue: 0,0:05:15.54,0:05:17.43,Default,,0,0,0,,1. grubun kazananları...
Dialogue: 0,0:05:17.43,0:05:20.00,Default,,0,0,0,,...Meiwa ve biz, Hanawa, olacağız.
Dialogue: 0,0:05:20.00,0:05:23.66,Default,,0,0,0,,Akita'dan Hanawa Genç Futbol\NKulübü demek?
Dialogue: 0,0:05:23.66,0:05:30.39,Default,,0,0,0,,Az önce yendiğiniz Osu ile\Nsabah maç yaptık ve 10-0 yendik.
Dialogue: 0,0:05:30.39,0:05:32.51,Default,,0,0,0,,Bizden bir fazla gol atmışlar.
Dialogue: 0,0:05:32.51,0:05:34.43,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:05:34.43,0:05:37.18,Default,,0,0,0,,Yoksa bunlar tren istasyonundaki\Nçocuklar mı?
Dialogue: 0,0:05:38.31,0:05:39.46,Default,,0,0,0,,{\i1}Masao!{\i0}
Dialogue: 0,0:05:39.46,0:05:40.75,Default,,0,0,0,,{\i1}Güzel pas!{\i0}
Dialogue: 0,0:05:40.75,0:05:46.86,Default,,0,0,0,,{\i1}Evet. Bu ikili çok senkronize\Noynuyorlar ve harika bir uyumları var.{\i0}
Dialogue: 0,0:05:46.86,0:05:50.82,Default,,0,0,0,,Birazdan çıkacağımız maçı\Niyi izleyin.
Dialogue: 0,0:05:55.04,0:05:59.46,Default,,0,0,0,,{\i1}1. gruptan Hanawa Genç Futbol\NKulübü ve Shimabara FC.{\i0}
Dialogue: 0,0:05:59.46,0:06:01.54,Default,,0,0,0,,{\i1}Hanawa'nın top vuruşuyla başlayacak.{\i0}
Dialogue: 0,0:06:02.67,0:06:04.45,Default,,0,0,0,,Tamamdır! Gidelim Masao!
Dialogue: 0,0:06:04.45,0:06:05.42,Default,,0,0,0,,Tamamdır Kazuo!
Dialogue: 0,0:06:13.68,0:06:15.22,Default,,0,0,0,,Başardık!
Dialogue: 0,0:06:15.22,0:06:16.47,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:18.77,0:06:21.65,Default,,0,0,0,,{\a6}Hanawa FC 7 - 0 Shimabara FC
Dialogue: 0,0:06:23.19,0:06:25.44,Default,,0,0,0,,Hanawa çok hakim oynadı.
Dialogue: 0,0:06:25.44,0:06:26.87,Default,,0,0,0,,Harikaydı.
Dialogue: 0,0:06:26.87,0:06:30.07,Default,,0,0,0,,Hanawa ile olan maçımız için sabırsızlanıyorum.
Dialogue: 0,0:06:30.07,0:06:32.74,Default,,0,0,0,,Evet, ben de sabırsızlanıyorum.
Dialogue: 0,0:06:32.74,0:06:33.45,Default,,0,0,0,,Kazanın.
Dialogue: 0,0:06:33.45,0:06:36.70,Default,,0,0,0,,Kazanacağız. Brezilya beni bekliyor.
Dialogue: 0,0:06:38.36,0:06:43.24,Default,,0,0,0,,{\i1}Ertesi gün Nankatsu, öğleden önceki\Nve sonraki maçları kolaylıkla kazandı...{\i0}
Dialogue: 0,0:06:43.24,0:06:47.21,Default,,0,0,0,,{\i1}...ve 3 zafer, 1 mağlubiyet durumuna geldiler.{\i0}
Dialogue: 0,0:06:47.21,0:06:48.52,Default,,0,0,0,,İşte bu! Başardık!
Dialogue: 0,0:06:48.52,0:06:49.47,Default,,0,0,0,,3 etti!
Dialogue: 0,0:06:49.47,0:06:52.73,Default,,0,0,0,,{\i1}Şimdi ise turnuvada grup aşamalarından\Nçıkacak tarafı belirleyecek...{\i0}
Dialogue: 0,0:06:52.73,0:06:57.22,Default,,0,0,0,,{\i1}...yarınki Hanawa maçı\Nhazırlıklarına başlamışlardı.{\i0}
Dialogue: 0,0:06:57.22,0:07:03.46,Default,,0,0,0,,{\i1}Ve o öğleden sonra 1. gruptaki\N2 mağlubiyet görmemiş takım olan...{\i0}
Dialogue: 0,0:07:03.46,0:07:05.90,Default,,0,0,0,,{\i1}...Meiwa ve Hanawa\Nkarşı karşıya gelmişti ve...{\i0}
Dialogue: 0,0:07:08.07,0:07:08.73,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:07:08.73,0:07:09.82,Default,,0,0,0,,Başardık!
Dialogue: 0,0:07:09.82,0:07:13.41,Default,,0,0,0,,{\a6}Meiwa FC 5 - 5 Hanawa FC
Dialogue: 0,0:07:10.60,0:07:12.16,Default,,0,0,0,,Meiwa ile berabere mi kaldılar?
Dialogue: 0,0:07:12.16,0:07:15.37,Default,,0,0,0,,Öyleyse yarınki Hanawa maçında\Nkazanmak yerine berabere kalırsak...
Dialogue: 0,0:07:15.37,0:07:18.37,Default,,0,0,0,,...elemelere çıkamayacağız.
Dialogue: 0,0:07:23.37,0:07:27.42,Default,,0,0,0,,Yarın Hanawa Genç Futbol Kulübü\Nile maçımız var.
Dialogue: 0,0:07:27.42,0:07:31.26,Default,,0,0,0,,Bu maçı kazanmazsak elemelere çıkamıyoruz.
Dialogue: 0,0:07:31.26,0:07:36.20,Default,,0,0,0,,Bu yüzden yarına hazırlanmak için\NHanawa'nın güçlü noktalarını anlatacağım.
Dialogue: 0,0:07:36.20,0:07:40.10,Default,,0,0,0,,Çocuklar, Hanawa'nın Shimara FC\Nile olan maçını hatırlayın.
Dialogue: 0,0:07:41.03,0:07:46.73,Default,,0,0,0,,Bu takımın özelliği forvetleri olan\NTachibana Kardeşlerin harika uyumları.
Dialogue: 0,0:07:46.73,0:07:53.65,Default,,0,0,0,,{\t(5949,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}O ikisi atağa çıkınca kalan takım orta sahada\Nkalıyor ve defansa yoğunlaşıyor.
Dialogue: 0,0:07:53.70,0:07:56.53,Default,,0,0,0,,Oyunun akışını o ikisi belirliyor.
Dialogue: 0,0:07:56.53,0:07:59.08,Default,,0,0,0,,Evet. Shimabara hiçbir şey yapamamıştı.
Dialogue: 0,0:07:59.08,0:08:03.49,Default,,0,0,0,,Hanawa'nın harika takım uyumunu bozarsak...
Dialogue: 0,0:08:03.49,0:08:05.64,Default,,0,0,0,,...Nankatsu'nun zaferini sağlayabiliriz.
Dialogue: 0,0:08:05.64,0:08:07.21,Default,,0,0,0,,Bunun için bir planım var.
Dialogue: 0,0:08:07.21,0:08:08.04,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:08:08.04,0:08:08.88,Default,,0,0,0,,Efendim?
Dialogue: 0,0:08:08.88,0:08:09.71,Default,,0,0,0,,Misaki.
Dialogue: 0,0:08:09.71,0:08:10.59,Default,,0,0,0,,Efendim?
Dialogue: 0,0:08:10.59,0:08:13.22,Default,,0,0,0,,İkinize bir görev vereceğim.
Dialogue: 0,0:08:18.86,0:08:21.22,Default,,0,0,0,,Büyük bir sorumluluğumuz var.
Dialogue: 0,0:08:21.22,0:08:22.30,Default,,0,0,0,,Evet.
Dialogue: 0,0:08:22.30,0:08:26.44,Default,,0,0,0,,Ama o uyumu bozmak için\Niyi bir yol bence.
Dialogue: 0,0:08:26.44,0:08:29.04,Default,,0,0,0,,Yarın için sana güveniyorum Misaki-kun.
Dialogue: 0,0:08:29.04,0:08:32.54,Default,,0,0,0,,Ben de öyle.\NHanawa'ya bir gol bile attır--
Dialogue: 0,0:08:35.18,0:08:36.42,Default,,0,0,0,,Korktunuz mu?
Dialogue: 0,0:08:36.42,0:08:38.66,Default,,0,0,0,,Siz de katılmalısınız!
Dialogue: 0,0:08:40.96,0:08:42.08,Default,,0,0,0,,Yastık savaşı!
Dialogue: 0,0:08:42.08,0:08:42.91,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:08:42.91,0:08:44.29,Default,,0,0,0,,Hadi bakalım!
Dialogue: 0,0:08:46.50,0:08:47.81,Default,,0,0,0,,Acıttı.
Dialogue: 0,0:08:47.81,0:08:50.42,Default,,0,0,0,,Nishio-kun, üzgünüm.
Dialogue: 0,0:08:50.42,0:08:51.44,Default,,0,0,0,,Gol!
Dialogue: 0,0:08:51.44,0:08:53.26,Default,,0,0,0,,Harbiden forvetsin ha Tsubasa!
Dialogue: 0,0:08:53.26,0:08:56.26,Default,,0,0,0,,Kapayın be çenenizi! Al bakalım!
Dialogue: 0,0:08:57.24,0:08:58.73,Default,,0,0,0,,Ne oldu Nishio?
Dialogue: 0,0:08:58.73,0:09:00.43,Default,,0,0,0,,Demirden bir kaleciyim ben!
Dialogue: 0,0:09:00.43,0:09:03.27,Default,,0,0,0,,Bunu Wakabayashi-san'ın\Nönünde neden söylemiyorsun?
Dialogue: 0,0:09:03.27,0:09:05.43,Default,,0,0,0,,Al bakalım şutumu!
Dialogue: 0,0:09:06.76,0:09:08.23,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:09:08.23,0:09:09.02,Default,,0,0,0,,Al!
Dialogue: 0,0:09:09.02,0:09:10.69,Default,,0,0,0,,Güzel şut!
Dialogue: 0,0:09:10.69,0:09:17.56,Default,,0,0,0,,- Al bakalım!\N- Hadi!
Dialogue: 0,0:09:17.56,0:09:20.57,Default,,0,0,0,,Çocuklar, bu güçle Hanawa'yı yenelim!
Dialogue: 0,0:09:20.57,0:09:22.24,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:28.82,0:09:30.77,Default,,0,0,0,,Turnuvanın ikinci gününün sonunda...
Dialogue: 0,0:09:30.77,0:09:33.87,Default,,0,0,0,,...tüm gelecek vadeden oyuncuları\Ngördük, değil mi?
Dialogue: 0,0:09:33.87,0:09:39.11,Default,,0,0,0,,Katılmayan Nankatsu SC'nin kalecisi\NWakabayashi Genzo hariç.
Dialogue: 0,0:09:39.11,0:09:40.22,Default,,0,0,0,,Evet.
Dialogue: 0,0:09:40.22,0:09:42.69,Default,,0,0,0,,5. sınıf olmasına rağmen\NShutetsu İlkokulu'nun kaptanlığı yapan...
Dialogue: 0,0:09:42.70,0:09:46.74,Default,,0,0,0,,...ve geçen sene hiç gol yemeden\Nşampiyon olan bir dahi.
Dialogue: 0,0:09:46.74,0:09:49.31,Default,,0,0,0,,Onun neslinde onun gibisi yok.
Dialogue: 0,0:09:49.31,0:09:52.20,Default,,0,0,0,,Naniwa FC'den Nakanishi Taichi nasıl?
Dialogue: 0,0:09:52.20,0:09:53.66,Default,,0,0,0,,O da iyi bir kaleci.
Dialogue: 0,0:09:53.66,0:09:56.71,Default,,0,0,0,,Büyük bedenin aksine\Nbeklenmedik derecede çevik.
Dialogue: 0,0:09:56.71,0:10:00.47,Default,,0,0,0,,O kadar büyümesine rağmen Wakabayashi'ye\Nrakip olamaması çok yazık.
Dialogue: 0,0:10:00.47,0:10:02.37,Default,,0,0,0,,Orta sahalar için ne düşünüyorsun?
Dialogue: 0,0:10:02.37,0:10:06.39,Default,,0,0,0,,İyi bir izlenim bırakanlar\NNankatsu'dan Misaki Taro...
Dialogue: 0,0:10:06.39,0:10:11.46,Default,,0,0,0,,...Furano'dan Matsuyama Hikaru,\NMeiwa FC'den Sawada Takeshi.
Dialogue: 0,0:10:11.46,0:10:14.81,Default,,0,0,0,,4. sınıf Takeshi-kun'u\N2 yıl içerisinde tekrar düşünürüm ama...
Dialogue: 0,0:10:14.81,0:10:17.88,Default,,0,0,0,,...Misaki-kun ve Matsuyama-kun\Nistediğim oyuncular.
Dialogue: 0,0:10:17.88,0:10:19.88,Default,,0,0,0,,Matsuyama Hikaru...
Dialogue: 0,0:10:19.88,0:10:21.99,Default,,0,0,0,,Teknik olarak biraz eksik değil mi?
Dialogue: 0,0:10:22.51,0:10:30.75,Default,,0,0,0,,Kaptanlığı yaptığı ilkokul takımını teknikten ziyade\Npotansiyeli ve azmi sayesinde ulusal turnuvaya taşıdı.
Dialogue: 0,0:10:30.75,0:10:34.25,Default,,0,0,0,,Katıldıktan sonra tekniği üzerinde çalışabiliriz.
Dialogue: 0,0:10:35.17,0:10:41.45,Default,,0,0,0,,Ama orta saha konusunda Musashi FC'den\NMisugi Jun daha çok öne çıkıyor gerçekten.
Dialogue: 0,0:10:41.45,0:10:46.30,Default,,0,0,0,,Harika bir oyun kurucu olmanın\Nyanında çok yetenekli bir golcü.
Dialogue: 0,0:10:46.30,0:10:52.71,Default,,0,0,0,,Ortaokuldan Koç Kitazume de gol atma\Nyeteneklerini geliştirmemizi istediğini söylemişti.
Dialogue: 0,0:10:52.88,0:10:55.73,Default,,0,0,0,,Forvet olarak en çok istediklerimiz hiç şüphesiz...
Dialogue: 0,0:10:55.73,0:11:00.88,Default,,0,0,0,,...Nankatsu SC'den Ozora Tsubasa\Nve Meiwa FC'den Hyuga Kojiro.
Dialogue: 0,0:11:00.88,0:11:04.34,Default,,0,0,0,,Bölgesel turnuvadan beri\NTsubasa-kun'a gözümüzü dikmiş olmamıza rağmen...
Dialogue: 0,0:11:04.34,0:11:07.86,Default,,0,0,0,,...dünden beri ulusal turnuvada\Nçok parladı resmen.
Dialogue: 0,0:11:07.86,0:11:11.80,Default,,0,0,0,,Bu kadarını yapamayacak olsa\Nakademimize uygun olmazdı zaten.
Dialogue: 0,0:11:11.80,0:11:16.79,Default,,0,0,0,,O ikilinin bir kez daha\Nkarşı karşıya geldiklerini görmek istiyorum.
Dialogue: 0,0:11:16.79,0:11:19.78,Default,,0,0,0,,Ben de. Finallerde.
Dialogue: 0,0:11:22.04,0:11:25.32,Default,,0,0,0,,{\i1}Turnuvanın 3. günü ve\Ngrup aşamalarının son maçları.{\i0}
Dialogue: 0,0:11:25.91,0:11:32.96,Default,,0,0,0,,{\i1}Furano her şeylerini oyuna koyarak\N5 maçın hepsini de kazandı.{\i0}
Dialogue: 0,0:11:32.96,0:11:38.01,Default,,0,0,0,,{\i1}Musashi FC de Kaptan Misugi yedek\Nkulübesinde dinlenirken...{\i0}
Dialogue: 0,0:11:38.01,0:11:41.22,Default,,0,0,0,,{\i1}...grup aşamalarından\N5 zaferle çıktı.{\i0}
Dialogue: 0,0:11:41.22,0:11:45.88,Default,,0,0,0,,{\i1}Meiwa ise son maçlarında\Nezici güçlerini gösterdi ve...{\i0}
Dialogue: 0,0:11:45.88,0:11:47.97,Default,,0,0,0,,{\i1}...4 zafer, 1 beraberlikle bitirdi.{\i0}
Dialogue: 0,0:11:47.97,0:11:53.77,Default,,0,0,0,,{\i1}Nankatsu'nun elemelerdeki\Nrakipleri belli olmuştu.{\i0}
Dialogue: 0,0:11:53.77,0:11:59.40,Default,,0,0,0,,{\i1}Grup aşamasının son maçında\Nelemelere çıkacak takım belirlenecek.{\i0}
Dialogue: 0,0:11:59.41,0:12:02.86,Default,,0,0,0,,{\i1}Nankatsu-Hanawa maçı başlamak üzere.{\i0}
Dialogue: 0,0:12:02.86,0:12:11.32,Default,,0,0,0,,{\i1}Meiwa ile olan tarihi maçlarında Nankatsu,\Nson anda zaferi elinden kaçırmıştı.{\i0}
Dialogue: 0,0:12:11.45,0:12:15.75,Default,,0,0,0,,{\i1}Öte yandan Hanawa,\Nberabere kalmıştı.{\i0}
Dialogue: 0,0:12:15.75,0:12:19.38,Default,,0,0,0,,{\i1}Stadyum maçı izlemek için\Nhevesli seyircilerle tıklım tıklım dolu.{\i0}
Dialogue: 0,0:12:19.38,0:12:20.98,Default,,0,0,0,,Dinleyin çocuklar.
Dialogue: 0,0:12:20.98,0:12:24.88,Default,,0,0,0,,Bugünkü maç elemelere gidecek\Ntakımı belirleyeceği için çok önemli.
Dialogue: 0,0:12:25.10,0:12:27.71,Default,,0,0,0,,Ne olursa olsun kazanıp elemelere çıkın!
Dialogue: 0,0:12:27.72,0:12:28.60,Default,,0,0,0,,Tamam!
Dialogue: 0,0:12:28.60,0:12:32.06,Default,,0,0,0,,Güzel, plana sadık kalın Tsubasa ve Misaki.
Dialogue: 0,0:12:32.06,0:12:33.14,Default,,0,0,0,,Tamam!
Dialogue: 0,0:12:35.14,0:12:37.96,Default,,0,0,0,,{\i1}İki takım da sahaya çıktı.{\i0}
Dialogue: 0,0:12:37.96,0:12:40.11,Default,,0,0,0,,Size güveniyorum millet.
Dialogue: 0,0:12:40.11,0:12:43.69,Default,,0,0,0,,{\i1}Akita temsilcisi Hanawa\Nşu ana kadar 3 zafer, 1 beraberlik aldı.{\i0}
Dialogue: 0,0:12:43.69,0:12:46.81,Default,,0,0,0,,{\i1}Tachibana Kardeşler forvetteyken\Nkalan takım defansa yoğunlaşıyor.{\i0}
Dialogue: 0,0:12:46.81,0:12:50.15,Default,,0,0,0,,{\i1}Oldukça eşsiz bir takım.{\i0}
Dialogue: 0,0:12:50.15,0:12:54.20,Default,,0,0,0,,{\i1}Öte yandan Shizuoka temsilcisi\NNankatsu 3 zafer, 1 mağlubiyet aldı.{\i0}
Dialogue: 0,0:12:54.20,0:13:00.21,Default,,0,0,0,,{\i1}As forvetleri Tsubasa-kun merkezdeyken\Nharika bir takım oyunu sergiliyorlar.{\i0}
Dialogue: 0,0:13:00.21,0:13:05.26,Default,,0,0,0,,{\i1}İki takımın taraftarları da\Nmaç başlamadan tezahüratlara başladı!{\i0}
Dialogue: 0,0:13:05.26,0:13:10.00,Default,,0,0,0,,{\i1}Büyük tezahüratlar eşliğinde, Hanawa'nın\Ntop vuruşuyla maç başlamak üzere!{\i0}
Dialogue: 0,0:13:11.32,0:13:15.81,Default,,0,0,0,,{\i1}Elemelere çıkan Nankatsu mu\NHanawa mı olacak?{\i0}
Dialogue: 0,0:13:15.81,0:13:17.76,Default,,0,0,0,,Tamamdır, bugün de gol atalım!
Dialogue: 0,0:13:17.76,0:13:18.15,Default,,0,0,0,,Tamam!
Dialogue: 0,0:13:18.15,0:13:21.90,Default,,0,0,0,,{\i1}Hanawa her zamanki gibi Tachibana\NKardeşlerin atağıyla açık bulmaya çalışıyor.{\i0}
Dialogue: 0,0:13:21.90,0:13:26.15,Default,,0,0,0,,Millet, sadece onlar atak yapıyor!\NNe olursa olsun onları durdurun!
Dialogue: 0,0:13:26.15,0:13:27.12,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:13:27.12,0:13:30.66,Default,,0,0,0,,{\i1}Nankatsu onları durdurabilecek mi?{\i0}
Dialogue: 0,0:13:37.42,0:13:38.33,Default,,0,0,0,,Ne?
Dialogue: 0,0:13:38.76,0:13:39.73,Default,,0,0,0,,{\i1}İşe yaramıyor!{\i0}
Dialogue: 0,0:13:39.73,0:13:43.84,Default,,0,0,0,,{\i1}Ünlü Nankatsu bile bu ikilinin\Norta sahayı yarıp geçmesine müdahale edemiyor!{\i0}
Dialogue: 0,0:13:43.84,0:13:46.84,Default,,0,0,0,,Neden? Neden bizi kolayca geçtiler?
Dialogue: 0,0:13:46.84,0:13:50.85,Default,,0,0,0,,{\i1}Tachibana Masao-kun ve Kazuo-kun\Nbugün harika bir uyum sergiliyor.{\i0}
Dialogue: 0,0:13:50.85,0:13:53.43,Default,,0,0,0,,{\i1}Maç başlar başlamaz\Ngol mü atacaklar yoksa?{\i0}
Dialogue: 0,0:13:53.43,0:13:54.64,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:13:54.64,0:13:55.46,Default,,0,0,0,,Hey!
Dialogue: 0,0:13:55.46,0:13:56.52,Default,,0,0,0,,Güzel pas!
Dialogue: 0,0:13:59.02,0:14:00.81,Default,,0,0,0,,Rakibiniz biz olacağız!
Dialogue: 0,0:14:00.81,0:14:02.20,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:10.03,0:14:13.07,Default,,0,0,0,,{\i1}Bu da ne? Normalde merkez forvet\Nolan Tsubasa-kun...{\i0}
Dialogue: 0,0:14:13.07,0:14:14.45,Default,,0,0,0,,{\i1}...bu kadar geriye gelmiş.{\i0}
Dialogue: 0,0:14:14.45,0:14:17.08,Default,,0,0,0,,{\i1}Misaki-kun ile birlikte Tachibana\NKardeşleri tutuyorlar.{\i0}
Dialogue: 0,0:14:17.08,0:14:19.50,Default,,0,0,0,,{\i1}İlginç bir mücadele olacağa benziyor.{\i0}
Dialogue: 0,0:14:19.50,0:14:21.78,Default,,0,0,0,,Masao, bu ikili çetin ceviz.
Dialogue: 0,0:14:21.78,0:14:22.25,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:22.25,0:14:26.59,Default,,0,0,0,,{\i1}Bu da ne? Tachibana Kardeşler\Nilerlemeyi kesti.{\i0}
Dialogue: 0,0:14:26.59,0:14:29.38,Default,,0,0,0,,Ne oldu? Siz gelmezseniz biz geliriz!
Dialogue: 0,0:14:29.38,0:14:30.13,Default,,0,0,0,,{\i1}İşte fırsat!{\i0}
Dialogue: 0,0:14:31.45,0:14:32.05,Default,,0,0,0,,Kazuo!
Dialogue: 0,0:14:32.48,0:14:33.40,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:14:33.40,0:14:34.72,Default,,0,0,0,,Güzeldi Misaki-kun!
Dialogue: 0,0:14:34.72,0:14:37.42,Default,,0,0,0,,{\i1}Tachibana Kardeşler topu kaybediyor!{\i0}
Dialogue: 0,0:14:37.42,0:14:38.56,Default,,0,0,0,,Masao ve Kazuo...
Dialogue: 0,0:14:38.56,0:14:40.02,Default,,0,0,0,,Hadi!
Dialogue: 0,0:14:40.02,0:14:42.48,Default,,0,0,0,,{\i1}Tsubasa-kun uzun bir pas gönderiyor.{\i0}
Dialogue: 0,0:14:42.48,0:14:43.67,Default,,0,0,0,,Güzel pas!
Dialogue: 0,0:14:43.67,0:14:45.67,Default,,0,0,0,,{\i1}Top orta saha Izawa-kun'a gidiyor.{\i0}
Dialogue: 0,0:14:45.67,0:14:47.18,Default,,0,0,0,,Tamamdır, gidelim!
Dialogue: 0,0:14:47.18,0:14:48.17,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:48.17,0:14:51.95,Default,,0,0,0,,{\i1}Şimdi de Nankatsu'daki ünlü\NShutetsu üçlüsünün atak vakti!{\i0}
Dialogue: 0,0:14:51.95,0:14:54.66,Default,,0,0,0,,Ben de Shutetsu'danım bu arada.
Dialogue: 0,0:14:54.66,0:14:57.20,Default,,0,0,0,,{\i1}Ne var ki Hanawa defansı sıkı.{\i0}
Dialogue: 0,0:14:57.20,0:15:00.41,Default,,0,0,0,,{\i1}Nankatsu onları aşıp gol atabilecek mi?{\i0}
Dialogue: 0,0:15:00.41,0:15:02.41,Default,,0,0,0,,Nankatsu gerçekten güçlüymüş.
Dialogue: 0,0:15:02.41,0:15:03.63,Default,,0,0,0,,Gardınızı indirmeyin!
Dialogue: 0,0:15:03.63,0:15:04.70,Default,,0,0,0,,Al Kisugi!
Dialogue: 0,0:15:04.70,0:15:05.75,Default,,0,0,0,,Hey Taki!
Dialogue: 0,0:15:05.75,0:15:07.13,Default,,0,0,0,,Güzel!
Dialogue: 0,0:15:07.13,0:15:10.02,Default,,0,0,0,,Hey, Tsubasa şut çekecek!
Dialogue: 0,0:15:10.02,0:15:11.22,Default,,0,0,0,,Peşine düş Kazuo!
Dialogue: 0,0:15:13.14,0:15:15.89,Default,,0,0,0,,Nankatsu, az daha bastırın!
Dialogue: 0,0:15:15.89,0:15:17.56,Default,,0,0,0,,Dayanın Hanawa!
Dialogue: 0,0:15:17.56,0:15:20.08,Default,,0,0,0,,{\i1}Hanawa'nın defansı sıkı cidden!{\i0}
Dialogue: 0,0:15:20.08,0:15:23.94,Default,,0,0,0,,{\i1}Tüm yollar kapalı ve Nankatsu şut çekemiyor!{\i0}
Dialogue: 0,0:15:23.94,0:15:25.61,Default,,0,0,0,,İşte böyle! Tamamen markaja alın!
Dialogue: 0,0:15:25.61,0:15:27.36,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:15:30.24,0:15:35.00,Default,,0,0,0,,{\i1}Az önceye kadar o kadar geri olan\NTsubasa-kun kaleye doğru koşuyor!{\i0}
Dialogue: 0,0:15:36.62,0:15:37.58,Default,,0,0,0,,İzin verme!
Dialogue: 0,0:15:37.58,0:15:38.37,Default,,0,0,0,,Tamam!
Dialogue: 0,0:15:38.37,0:15:39.95,Default,,0,0,0,,Hadi!
Dialogue: 0,0:15:40.64,0:15:42.37,Default,,0,0,0,,{\i1}Olmuyor! Engelleyemiyorlar!{\i0}
Dialogue: 0,0:15:42.37,0:15:44.37,Default,,0,0,0,,{\i1}Tsubasa-kun sert bir şut çekiyor!{\i0}
Dialogue: 0,0:15:46.27,0:15:47.67,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:15:47.67,0:15:49.51,Default,,0,0,0,,Başardım!
Dialogue: 0,0:15:50.92,0:15:52.26,Default,,0,0,0,,Harikaydı Tsubasa!
Dialogue: 0,0:15:52.26,0:15:53.72,Default,,0,0,0,,Başardık!
Dialogue: 0,0:15:52.62,0:15:56.29,Default,,0,0,0,,{\i1}Tsubasa-kun hiç tereddüt etmeden\Nkaleye şut çekti.{\i0}
Dialogue: 0,0:15:56.29,0:16:01.64,Default,,0,0,0,,{\i1}Sıkı Hanawa defansı bile bu mermi\Ngibi şuta karşı hiçbir şey yapamadı.{\i0}
Dialogue: 0,0:16:01.64,0:16:03.94,Default,,0,0,0,,{\i1}Genç futbolcu yeteneklerini gösteriyor.{\i0}
Dialogue: 0,0:16:03.94,0:16:08.83,Default,,0,0,0,,{\i1}Bununla birlikte Tsubasa-kun,\NHyuga-kun'un 17 gollük...{\i0}
Dialogue: 0,0:16:08.83,0:16:11.86,Default,,0,0,0,,{\i1}...gol krallığını elinden aldı!{\i0}
Dialogue: 0,0:16:11.86,0:16:14.78,Default,,0,0,0,,Masao. Gerçekten inanılmaz birisi.
Dialogue: 0,0:16:14.78,0:16:17.45,Default,,0,0,0,,Evet. Ama maç daha yeni başlıyor.
Dialogue: 0,0:16:17.45,0:16:19.29,Default,,0,0,0,,Kaybedecek değiliz!
Dialogue: 0,0:16:19.72,0:16:24.29,Default,,0,0,0,,{\i1}Nankatsu'nun golü sonrası\NHanawa'nın top vuruşuyla maç devam edecek.{\i0}
Dialogue: 0,0:16:24.29,0:16:26.21,Default,,0,0,0,,Yapalım şunu Masao.
Dialogue: 0,0:16:26.21,0:16:27.04,Default,,0,0,0,,Evet.
Dialogue: 0,0:16:30.17,0:16:33.92,Default,,0,0,0,,{\i1}Hanawa'nın atak kozları, Tachibana Kardeşler.{\i0}
Dialogue: 0,0:16:33.92,0:16:39.02,Default,,0,0,0,,{\i1}Bu ikinin atakları, planlandığı gibi Nankatsu'nun\Nyıldızları Tsubasa ve Misaki tarafından engelleniyor.{\i0}
Dialogue: 0,0:16:39.02,0:16:41.60,Default,,0,0,0,,{\i1}Plan kusursuz işliyor.{\i0}
Dialogue: 0,0:16:41.60,0:16:47.43,Default,,0,0,0,,{\i1}İlk yarının başlarında Tsubasa'nın çektiği\Nşutun gol olması sonrası...{\i0}
Dialogue: 0,0:16:47.43,0:16:51.16,Default,,0,0,0,,{\i1}...Hanawa defansı, Nankatsu ataklarını\Nkesmek için sıkıca kapanmıştı.{\i0}
Dialogue: 0,0:16:51.16,0:16:53.10,Default,,0,0,0,,{\i1}Nankatsu atak yapmaya\Ndevam etmesine rağmen...{\i0}
Dialogue: 0,0:16:53.10,0:16:55.07,Default,,0,0,0,,{\i1}...gol atamıyordu.{\i0}
Dialogue: 0,0:16:55.07,0:16:57.86,Default,,0,0,0,,Nankatsu! Bir tane daha atın!
Dialogue: 0,0:16:57.86,0:17:00.91,Default,,0,0,0,,Ne dert ama! Defansları çok sıkı!
Dialogue: 0,0:17:00.91,0:17:02.70,Default,,0,0,0,,Savunmaya devam Hanawa!
Dialogue: 0,0:17:02.70,0:17:06.12,Default,,0,0,0,,{\i1}Avantajlı taraf Nankatsu gibi.{\i0}
Dialogue: 0,0:17:06.12,0:17:09.79,Default,,0,0,0,,{\i1}Hanawa'daki Tachibana Kardeşler\Nhiçbir fırsat yakalayamıyor.{\i0}
Dialogue: 0,0:17:11.55,0:17:14.67,Default,,0,0,0,,{\i1}Hakemin düdüğüyle ilk yarı bitiyor!{\i0}
Dialogue: 0,0:17:14.67,0:17:18.29,Default,,0,0,0,,{\i1}1. grubun son maçı olan\NHanawa-Nankatsu maçında...{\i0}
Dialogue: 0,0:17:18.29,0:17:20.19,Default,,0,0,0,,{\i1}...ilk yarı 1-0 bitiyor.{\i0}
Dialogue: 0,0:17:20.19,0:17:22.60,Default,,0,0,0,,{\i1}Nankatsu bir golle liderlikte.{\i0}
Dialogue: 0,0:17:26.02,0:17:27.81,Default,,0,0,0,,Millet, çabanıza sağlık.
Dialogue: 0,0:17:27.81,0:17:34.49,Default,,0,0,0,,Bir gol daha atarsanız harika olur ama Tachibana\NKardeşlerin ataklarını durdurma planına sadık kalalım.
Dialogue: 0,0:17:34.49,0:17:35.44,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:35.44,0:17:37.93,Default,,0,0,0,,Tamamdır, ikinci yarıda da\Nliderliği sürdürelim...
Dialogue: 0,0:17:37.93,0:17:40.28,Default,,0,0,0,,...ve rakibimizi ezip gruplardan çıkalım!
Dialogue: 0,0:17:40.28,0:17:41.58,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:42.16,0:17:45.45,Default,,0,0,0,,İkinci yarıda da Tachibana\NKardeşleri tutalım.
Dialogue: 0,0:17:45.45,0:17:46.29,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:46.76,0:17:49.21,Default,,0,0,0,,Nankatsu maçı domine ediyor.
Dialogue: 0,0:17:49.21,0:17:53.55,Default,,0,0,0,,Evet, bu gidişle Nankatsu'nun\Nkazanacağına şüphe yok.
Dialogue: 0,0:17:54.51,0:17:57.34,Default,,0,0,0,,Ne yapacağız Kazuo, Masao?
Dialogue: 0,0:17:57.34,0:18:00.14,Default,,0,0,0,,Biz de mi atağa katılalım?
Dialogue: 0,0:18:02.67,0:18:05.68,Default,,0,0,0,,Bize güvenmiyor musunuz?
Dialogue: 0,0:18:05.68,0:18:08.35,Default,,0,0,0,,Ama bu gidişle gol atamayacağız.
Dialogue: 0,0:18:08.35,0:18:11.96,Default,,0,0,0,,Endişelenmeyin. Daha kozlarımızı oynamadık.
Dialogue: 0,0:18:11.96,0:18:13.28,Default,,0,0,0,,Ne? Koz mu?
Dialogue: 0,0:18:13.28,0:18:14.07,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:14.07,0:18:17.31,Default,,0,0,0,,Grup aşamalarında bunu\Ngöstermek istemiyordum ama...
Dialogue: 0,0:18:17.31,0:18:18.91,Default,,0,0,0,,...başka seçeneğimiz yok Kazuo.
Dialogue: 0,0:18:18.91,0:18:20.82,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:20.82,0:18:23.87,Default,,0,0,0,,{\i1}Ama böylelikle kolayca toparlanabiliriz.{\i0}
Dialogue: 0,0:18:24.42,0:18:27.30,Default,,0,0,0,,Hanawa'dan ümidim vardı açıkçası.
Dialogue: 0,0:18:27.30,0:18:29.08,Default,,0,0,0,,Bir halt olmazlarmış ama.
Dialogue: 0,0:18:29.08,0:18:30.03,Default,,0,0,0,,Ne?
Dialogue: 0,0:18:30.03,0:18:32.75,Default,,0,0,0,,Hanawa ile bilerek berabere kaldım.
Dialogue: 0,0:18:32.75,0:18:33.84,Default,,0,0,0,,Ne?!
Dialogue: 0,0:18:33.84,0:18:37.76,Default,,0,0,0,,Şampiyonluk yolundaki tek\Nengelimiz Nankatsu.
Dialogue: 0,0:18:37.76,0:18:40.76,Default,,0,0,0,,Bunu ilk maçta iyice anladım.
Dialogue: 0,0:18:40.76,0:18:45.01,Default,,0,0,0,,Bu yüzden gruplar bitmeden\NNankatsu'dan kurtulmak istedim.
Dialogue: 0,0:18:45.01,0:18:47.56,Default,,0,0,0,,Bunun için de Hanawa ile\Nbilerek berabere kaldım.
Dialogue: 0,0:18:47.56,0:18:50.59,Default,,0,0,0,,Hanawa ile Nankatsu'nun berabere\Nkalması durumunda...
Dialogue: 0,0:18:50.59,0:18:55.44,Default,,0,0,0,,...Hanawa'nın elemelere çıkabileceği\Nbir durum oluşturmak için.
Dialogue: 0,0:18:55.44,0:18:57.54,Default,,0,0,0,,Ama işe yaramıyor gibi.
Dialogue: 0,0:18:57.54,0:18:59.61,Default,,0,0,0,,Nankatsu gümbür gümbür geliyor, değil mi?
Dialogue: 0,0:18:59.61,0:19:05.28,Default,,0,0,0,,Evet. Ayrıca beni Nankatsu'dan\Nbaşka rahatsız eden bir şey daha var.
Dialogue: 0,0:19:07.54,0:19:09.70,Default,,0,0,0,,Genzo. Bu...
Dialogue: 0,0:19:09.70,0:19:13.85,Default,,0,0,0,,Elemelere kadar formda\Nolduğumdan emin olmalıyım.
Dialogue: 0,0:19:13.85,0:19:14.62,Default,,0,0,0,,Ne?
Dialogue: 0,0:19:14.62,0:19:16.28,Default,,0,0,0,,Durdurmaya çalışacaksan boşa.
Dialogue: 0,0:19:16.28,0:19:18.28,Default,,0,0,0,,Nankatsu, Hanawa'yı yenecek ve...
Dialogue: 0,0:19:18.28,0:19:23.59,Default,,0,0,0,,...ben de büyük finalde Nankatsu'nun\Nkalesini koruyacağım.
Dialogue: 0,0:19:24.80,0:19:26.31,Default,,0,0,0,,{\i1}İkinci yarı başlıyor.{\i0}
Dialogue: 0,0:19:26.31,0:19:29.73,Default,,0,0,0,,{\i1}Liderlikteki Nankatsu\Nritmini koruyabilecek mi?{\i0}
Dialogue: 0,0:19:29.73,0:19:34.15,Default,,0,0,0,,{\i1}İlk yarıda markaja alınan Tachibana\NKardeşler bunu atlatabilecek mi?{\i0}
Dialogue: 0,0:19:34.15,0:19:35.82,Default,,0,0,0,,Şimdi de ikinciyi atacağız!
Dialogue: 0,0:19:35.82,0:19:38.11,Default,,0,0,0,,{\i1}Ama Hanawa karşı koyuyor!{\i0}
Dialogue: 0,0:19:38.11,0:19:40.78,Default,,0,0,0,,Saldır Hanawa! Saldır Hanawa!
Dialogue: 0,0:19:42.38,0:19:42.99,Default,,0,0,0,,Masao!
Dialogue: 0,0:19:43.55,0:19:44.28,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:19:44.28,0:19:45.74,Default,,0,0,0,,Koş Kazuo!
Dialogue: 0,0:19:45.74,0:19:46.72,Default,,0,0,0,,Tamam!
Dialogue: 0,0:19:46.72,0:19:49.22,Default,,0,0,0,,{\i1}Ne?! Neler oluyor böyle?!{\i0}
Dialogue: 0,0:19:49.22,0:19:53.29,Default,,0,0,0,,{\i1}Her zaman yakın duran Tachibana\NKardeşler şimdi uzaklaştılar!{\i0}
Dialogue: 0,0:19:53.29,0:19:55.54,Default,,0,0,0,,Bir şeyler dönüyor!
Dialogue: 0,0:19:55.54,0:19:57.50,Default,,0,0,0,,Buna mı bel bağladınız?! Al bakalım!
Dialogue: 0,0:19:59.71,0:20:00.97,Default,,0,0,0,,Sözünü yedirirler!
Dialogue: 0,0:20:00.97,0:20:02.68,Default,,0,0,0,,Bir şeyler dönüyor kesinlikle!
Dialogue: 0,0:20:03.12,0:20:05.43,Default,,0,0,0,,Masao, yine geliyor!
Dialogue: 0,0:20:05.43,0:20:07.10,Default,,0,0,0,,Biliyorum.
Dialogue: 0,0:20:07.10,0:20:08.85,Default,,0,0,0,,Tamamdır. Artık hazırım Masao!
Dialogue: 0,0:20:08.85,0:20:10.02,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:20:12.85,0:20:15.43,Default,,0,0,0,,{\i1}Masao-kun olabildiğince sert şekilde vuruyor!{\i0}
Dialogue: 0,0:20:15.43,0:20:16.65,Default,,0,0,0,,Yetişemedim.
Dialogue: 0,0:20:16.65,0:20:18.65,Default,,0,0,0,,{\i1}Top kale önüne gidiyor.{\i0}
Dialogue: 0,0:20:18.65,0:20:26.11,Default,,0,0,0,,{\i1}Kazuo-kun orada ama yanındaki Takasugi-kun,\NNishio-kun ve Tsubasa-kun onu markaja almış durumda!{\i0}
Dialogue: 0,0:20:27.66,0:20:31.40,Default,,0,0,0,,{\i1}Ne? Kazuo-kun toptan uzaklaşacak\Nşekilde koşmaya başlıyor!{\i0}
Dialogue: 0,0:20:31.40,0:20:31.91,Default,,0,0,0,,{\i1}Ne?{\i0}
Dialogue: 0,0:20:34.38,0:20:35.67,Default,,0,0,0,,İşte!
Dialogue: 0,0:20:36.42,0:20:40.46,Default,,0,0,0,,{\i1}Zıplamak için kale direğini kullandı!{\i0}
Dialogue: 0,0:20:40.46,0:20:41.09,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:42.59,0:20:43.22,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:20:43.22,0:20:44.80,Default,,0,0,0,,Gel Kazuo!
Dialogue: 0,0:20:44.80,0:20:47.42,Default,,0,0,0,,{\i1}Masao-kun ileri doğru koşuyor!{\i0}
Dialogue: 0,0:20:49.95,0:20:51.14,Default,,0,0,0,,{\i1}Şut!{\i0}
Dialogue: 0,0:20:51.66,0:20:53.02,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:20:53.52,0:20:56.12,Default,,0,0,0,,{\i1}Hanawa oyunu beraberliğe getiriyor.{\i0}
Dialogue: 0,0:20:56.12,0:20:59.90,Default,,0,0,0,,Üçlü şutumuzu gördünüz mü?!
Dialogue: 0,0:20:59.90,0:21:00.90,Default,,0,0,0,,Dikkat et!
Dialogue: 0,0:21:00.90,0:21:02.28,Default,,0,0,0,,Çekil!
Dialogue: 0,0:21:06.83,0:21:08.13,Default,,0,0,0,,{\i1}Bu da ne böyle?!{\i0}
Dialogue: 0,0:21:08.13,0:21:13.20,Default,,0,0,0,,{\i1}Zıplayan Tachibana Kazuo-kun, şut çektikten\Nsonra Nankatsu'dan Nishio-kun'un üzerine düştü{\i0}
Dialogue: 0,0:21:13.20,0:21:14.83,Default,,0,0,0,,{\i1}...ve sert bir şekilde çarpıştılar!{\i0}
Dialogue: 0,0:21:14.83,0:21:16.38,Default,,0,0,0,,Hey, iyi misin?
Dialogue: 0,0:21:16.38,0:21:16.99,Default,,0,0,0,,Evet.
Dialogue: 0,0:21:16.99,0:21:18.33,Default,,0,0,0,,Nishio!
Dialogue: 0,0:21:19.46,0:21:20.32,Default,,0,0,0,,Nishio!
Dialogue: 0,0:21:20.32,0:21:21.84,Default,,0,0,0,,Hey, kanaman var!
Dialogue: 0,0:21:21.84,0:21:24.67,Default,,0,0,0,,Of... Bu çok kötü.
Dialogue: 0,0:21:25.67,0:21:29.59,Default,,0,0,0,,{\i1}Nishio-kun devam edemeyecek gibi görünüyor.{\i0}
Dialogue: 0,0:21:29.59,0:21:30.93,Default,,0,0,0,,{\i1}Şu an sahadan çıkarılıyor.{\i0}
Dialogue: 0,0:21:32.26,0:21:33.32,Default,,0,0,0,,Nishio!
Dialogue: 0,0:21:33.32,0:21:34.64,Default,,0,0,0,,İyiyim.
Dialogue: 0,0:21:34.64,0:21:37.25,Default,,0,0,0,,Böyle bir anda olması ne kadar da kötü...
Dialogue: 0,0:21:38.73,0:21:42.02,Default,,0,0,0,,Ishizaki, Nishio'nun yerine sen gireceksin.
Dialogue: 0,0:21:42.02,0:21:43.82,Default,,0,0,0,,Ne?! Ben mi?!
Dialogue: 0,0:21:44.86,0:21:48.57,Default,,0,0,0,,Tamamdır! Sonunda parlama vaktim geldi!
Dialogue: 0,0:21:49.18,0:21:52.90,Default,,0,0,0,,{\i1}Nankatsu oyuncu değişikliği yapıyor.{\i0}
Dialogue: 0,0:21:52.90,0:21:59.96,Default,,0,0,0,,{\i1}3 numara Nishio-kun yerine\N14 numara Ishizaki-kun giriyor.{\i0}
Dialogue: 0,0:21:59.96,0:22:02.17,Default,,0,0,0,,Hadi!
Dialogue: 0,0:22:02.17,0:22:03.95,Default,,0,0,0,,- Ishizaki-kun!\N- Ishizaki!
Dialogue: 0,0:22:03.95,0:22:05.37,Default,,0,0,0,,Sana güveniyoruz Ishizaki!
Dialogue: 0,0:22:05.37,0:22:07.17,Default,,0,0,0,,Tamamdır, bana bırakın!
Dialogue: 0,0:22:07.17,0:22:09.09,Default,,0,0,0,,Ishizaki-kun çıktı!
Dialogue: 0,0:22:09.09,0:22:11.80,Default,,0,0,0,,Ishizaki, elinden geleni yap!
Dialogue: 0,0:22:11.80,0:22:14.06,Default,,0,0,0,,Teknik olarak eksik olabilirim ama...
Dialogue: 0,0:22:14.06,0:22:18.16,Default,,0,0,0,,...yürek olarak altta kalmam!
Dialogue: 0,0:23:50.07,0:24:00.64,Default,,0,0,0,,Gelecek 17. Bölümde:\N4 Dakika Kaldı! Belirleyici Hava Topu!
Dialogue: 0,0:01:32.01,0:01:37.60,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:01:37.60,0:01:42.27,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:01:43.52,0:01:48.19,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:01:49.07,0:01:56.78,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:01:56.78,0:02:02.54,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:02:02.54,0:02:11.30,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:02:11.30,0:02:16.85,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:02:16.85,0:02:22.77,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:02:22.77,0:02:24.44,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:02:24.44,0:02:31.65,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:02:31.65,0:02:34.66,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:02:34.66,0:02:39.08,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:01:32.01,0:01:37.60,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:01:37.60,0:01:42.27,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:01:43.52,0:01:48.19,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:01:49.07,0:01:56.78,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:01:56.78,0:02:02.54,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:02:02.54,0:02:11.30,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:02:11.30,0:02:16.85,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:02:16.85,0:02:22.77,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:02:22.77,0:02:24.44,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:02:24.44,0:02:31.65,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo\N
Dialogue: 0,0:02:31.65,0:02:34.66,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:02:34.66,0:02:39.08,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Romaji,,0,0,0,,chotto aremi na eesu ga tooru
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Romaji,,0,0,0,,suguremono da to machijuu sawagu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Romaji,,0,0,0,,chochou sanba, jiguzagu sanba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Romaji,,0,0,0,,aitsu no uwasa de chanba mo hashiru
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Romaji,,0,0,0,,sore ni tsukete mo oretacha nan darou
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Romaji,,0,0,0,,booru hitotsu ni kirikiri mai sa
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Romaji,,0,0,0,,itsuka kimeru ze, inazuma shuuto
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Romaji,,0,0,0,,son toki ore ga suupaa hiiroo sa
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Romaji,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Türkçe,,0,0,0,,sert bakışıyla geçiyor bir yıldız
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Türkçe,,0,0,0,,tüm şehir söylüyor harika birisi olduğunu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Türkçe,,0,0,0,,kelebek sambası, zikzak samba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Türkçe,,0,0,0,,onun hakkındaki söylentiler\Nsambayı bile harekete geçiriyor
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Türkçe,,0,0,0,,onun aksine bizim burada olma sebebimiz
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Türkçe,,0,0,0,,top için delirmek
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Türkçe,,0,0,0,,bir gün şimşek gibi vuruşum hedefine ulaşacak
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Türkçe,,0,0,0,,o an bir süper kahraman olacağım işte ben
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Türkçe,,0,0,0,,alevlen ve ez geç delikanlı
