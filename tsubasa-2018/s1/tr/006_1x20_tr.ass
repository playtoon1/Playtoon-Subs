Dialogue: 0,0:01:17.52,0:01:22.19,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:01:23.07,0:01:30.78,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:01:30.78,0:01:36.54,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:01:36.54,0:01:45.30,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:01:45.30,0:01:50.85,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:01:50.85,0:01:56.77,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:01:56.77,0:01:58.44,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:01:58.44,0:02:05.65,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:02:05.65,0:02:08.66,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:02:08.66,0:02:13.08,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
