Dialogue: 0,0:12:13.06,0:12:18.05,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:02.64,0:00:04.31,Default,,0,0,0,,# Nankatsu SC - Musashi FC #
Dialogue: 0,0:00:04.31,0:00:07.15,Default,,0,0,0,,Pekala, şimdi bizim sıramız!
Dialogue: 0,0:00:07.15,0:00:09.58,Default,,0,0,0,,Meiwa ve Furano'nun\Nçekişmeli maçı sonrası hem de!
Dialogue: 0,0:00:09.58,0:00:11.58,Default,,0,0,0,,Hadi bakalım!
Dialogue: 0,0:00:11.58,0:00:12.61,Default,,0,0,0,,Evet!
Dialogue: 0,0:00:13.65,0:00:15.82,Default,,0,0,0,,{\i1}Yarı finallerin ikinci maçının vakti geldi.{\i0}
Dialogue: 0,0:00:15.82,0:00:17.99,Default,,0,0,0,,{\i1}Nankatsu SC ve Musashi FC.{\i0}
Dialogue: 0,0:00:17.99,0:00:21.74,Default,,0,0,0,,{\i1}İki takımın oyuncuları da sahaya giriyor.{\i0}
Dialogue: 0,0:00:24.08,0:00:25.12,Default,,0,0,0,,Misugi-san!
Dialogue: 0,0:00:25.12,0:00:26.71,Default,,0,0,0,,Buraya bak!
Dialogue: 0,0:00:26.71,0:00:29.34,Default,,0,0,0,,Elinden geleni yap Misugi-san!
Dialogue: 0,0:00:29.34,0:00:32.84,Default,,0,0,0,,Hora! Hora! Nankatsu!
Dialogue: 0,0:00:32.84,0:00:36.01,Default,,0,0,0,,Bastır! Bastır! Nankatsu!
Dialogue: 0,0:00:36.50,0:00:42.34,Default,,0,0,0,,{\i1}Turnuvanın en çok beklenen maçı\Nsonunda başlamak üzere!{\i0}
Dialogue: 0,0:00:42.34,0:00:44.06,Default,,0,0,0,,{\i1}Yapalım şunu Tsubasa-kun.{\i0}
Dialogue: 0,0:00:45.14,0:00:48.35,Default,,0,0,0,,{\i1}Misugi-kun, kaybetmeyeceğim!{\i0}
Dialogue: 0,0:02:24.18,0:02:28.58,Default,,0,0,0,,{\fad(500,500)\fs80\pos(276,742.333)}Bölüm 20:
Dialogue: 0,0:02:24.18,0:02:28.58,Default,,0,0,0,,{\fad(500,500)\fs80\pos(476,822.333)}Musashi'nin Gizli Planı
Dialogue: 0,0:02:24.18,0:02:28.58,Default,,0,0,0,,{\fad(500,500)\pos(1476,1030)}Çeviri: ARE-YOU-SURE\N{\fs70}AreyousureSubs Sunar
Dialogue: 0,0:02:25.58,0:02:28.79,Default-Top,,0,0,0,,{\an8\i1}İki takım da sahadaki yerlerini aldı.{\i0}
Dialogue: 0,0:02:30.94,0:02:33.79,Default,,0,0,0,,{\i1}Nankatsu-Musashi maçının\Ntop vuruşu gerçekleşti.{\i0}
Dialogue: 0,0:02:35.96,0:02:38.02,Default,,0,0,0,,Seni orta sahada tutacaklar...
Dialogue: 0,0:02:38.02,0:02:39.17,Default,,0,0,0,,...biz ikimiziz!
Dialogue: 0,0:02:41.30,0:02:43.30,Default,,0,0,0,,Sano! Honma'ya pas ver!
Dialogue: 0,0:02:43.30,0:02:43.80,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:47.86,0:02:49.98,Default,,0,0,0,,{\i1}Musashi kanattan saldırıyor!{\i0}
Dialogue: 0,0:02:49.98,0:02:50.98,Default,,0,0,0,,Seni durduracağım!
Dialogue: 0,0:02:53.57,0:02:55.23,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:02:55.23,0:02:57.36,Default,,0,0,0,,{\i1}Honma-kun orta açıyor.{\i0}
Dialogue: 0,0:02:57.36,0:03:00.03,Default,,0,0,0,,Dur bakalım! Kale önünde\Nseni biz tutacağız!
Dialogue: 0,0:03:01.01,0:03:02.37,Default,,0,0,0,,Hadi Sanada!
Dialogue: 0,0:03:02.37,0:03:03.36,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:03.36,0:03:05.25,Default,,0,0,0,,{\i1}Harika bir hareket!{\i0}
Dialogue: 0,0:03:05.25,0:03:08.74,Default,,0,0,0,,{\i1}Misugi-kun markaja alınıyorken\NSanada-kun'u tutan kimse yok!{\i0}
Dialogue: 0,0:03:08.74,0:03:10.50,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:10.50,0:03:11.71,Default,,0,0,0,,Bende!
Dialogue: 0,0:03:13.73,0:03:16.13,Default,,0,0,0,,{\i1}Morisaki-kun harika tutuyor!{\i0}
Dialogue: 0,0:03:16.13,0:03:18.13,Default,,0,0,0,,{\i1}İşte kaleci!{\i0}
Dialogue: 0,0:03:18.13,0:03:19.48,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:03:19.48,0:03:22.09,Default,,0,0,0,,{\i1}Ama Musashi başarmak üzereydi.{\i0}
Dialogue: 0,0:03:22.09,0:03:26.39,Default,,0,0,0,,{\i1}Misugi-kun sahadayken atakları\Nçok uyumlu gerçekten.{\i0}
Dialogue: 0,0:03:26.39,0:03:29.98,Default,,0,0,0,,{\i1}Hiçbir hareketi boşa değildi.{\i0}
Dialogue: 0,0:03:29.98,0:03:31.93,Default,,0,0,0,,{\i1}Misugi-kun'dan da bu beklenirdi.{\i0}
Dialogue: 0,0:03:32.38,0:03:33.10,Default,,0,0,0,,İşte!
Dialogue: 0,0:03:35.02,0:03:38.65,Default,,0,0,0,,{\i1}Musashi'nin gücünü öğrenelim.{\i0}
Dialogue: 0,0:03:40.07,0:03:42.45,Default,,0,0,0,,Bastır Misaki!
Dialogue: 0,0:03:47.49,0:03:49.14,Default,,0,0,0,,{\i1}Şimdiye kadarki olduğundan farklı.{\i0}
Dialogue: 0,0:03:49.14,0:03:51.79,Default,,0,0,0,,{\i1}Diğer takımlara karşı olduğumuzdan\Ndaha kontrollü olmamız gerekiyor.{\i0}
Dialogue: 0,0:03:55.04,0:03:58.79,Default,,0,0,0,,Kanattan top sürmek uzmanlık alanımdır!
Dialogue: 0,0:03:58.79,0:04:01.65,Default,,0,0,0,,Dikkatli olun! Orta açacak!
Dialogue: 0,0:04:01.65,0:04:02.92,Default,,0,0,0,,Gel Taki!
Dialogue: 0,0:04:02.92,0:04:04.05,Default,,0,0,0,,İşte!
Dialogue: 0,0:04:04.05,0:04:06.47,Default,,0,0,0,,{\i1}Kale önündeki Kisugi-kun'a...{\i0}
Dialogue: 0,0:04:07.00,0:04:08.47,Default,,0,0,0,,{\i1}Hayır, Tsubasa-kun'a!{\i0}
Dialogue: 0,0:04:08.47,0:04:11.22,Default,,0,0,0,,{\i1}Bu kez Nankatsu bir kandırmaca yapıyor.{\i0}
Dialogue: 0,0:04:11.22,0:04:13.85,Default,,0,0,0,,Hadi bakalım! Şut!
Dialogue: 0,0:04:15.48,0:04:17.29,Default,,0,0,0,,{\i1}Misugi-kun kesiyor!{\i0}
Dialogue: 0,0:04:17.29,0:04:19.27,Default,,0,0,0,,{\i1}Nankatsu ilk gollerini atamıyor!{\i0}
Dialogue: 0,0:04:22.15,0:04:24.07,Default,,0,0,0,,Hadi mücadele vakti Tsubasa-kun!
Dialogue: 0,0:04:24.07,0:04:26.82,Default,,0,0,0,,Tamamdır! Mücadeleyi kabul ediyorum Misugi-kun!
Dialogue: 0,0:04:26.82,0:04:30.58,Default,,0,0,0,,{\i1}Misugi-kun ve Tsubasa-kun'un\Nilk karşılaşması.{\i0}
Dialogue: 0,0:04:30.58,0:04:32.29,Default,,0,0,0,,{\i1}Nankatsu ve Musashi!{\i0}
Dialogue: 0,0:04:32.29,0:04:33.79,Default,,0,0,0,,{\i1}Maçın ilk önemli anı.{\i0}
Dialogue: 0,0:04:33.79,0:04:35.08,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:04:37.08,0:04:38.07,Default,,0,0,0,,Bu kez...
Dialogue: 0,0:04:38.07,0:04:38.92,Default,,0,0,0,,...geçit vermeyeceğiz!
Dialogue: 0,0:04:39.47,0:04:41.55,Default,,0,0,0,,{\i1}Her yönden geliyorlar!{\i0}
Dialogue: 0,0:04:41.55,0:04:43.67,Default,,0,0,0,,{\i1}Ne yapacak acaba?{\i0}
Dialogue: 0,0:04:45.62,0:04:47.30,Default,,0,0,0,,{\i1}Top sürerek geçeceğim!{\i0}
Dialogue: 0,0:04:48.68,0:04:50.97,Default,,0,0,0,,{\i1}Misugi-kun çalımlıyor!{\i0}
Dialogue: 0,0:04:50.97,0:04:51.76,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:04:51.76,0:04:54.14,Default,,0,0,0,,{\i1}Tsubasa-kun yetişti!{\i0}
Dialogue: 0,0:04:57.08,0:05:00.06,Default,,0,0,0,,{\i1}Misugi-kun zıplayıp onu atlatıyor!{\i0}
Dialogue: 0,0:05:02.02,0:05:04.11,Default,,0,0,0,,{\i1}Ve şut çekiyor!{\i0}
Dialogue: 0,0:05:05.81,0:05:08.82,Default,,0,0,0,,{\i1}Ne?! Top uzaklaşıyor!{\i0}
Dialogue: 0,0:05:09.30,0:05:12.20,Default,,0,0,0,,{\i1}Tsubasa-kun zar zor uzaklaştırmayı başardı!{\i0}
Dialogue: 0,0:05:12.20,0:05:18.08,Default,,0,0,0,,{\i1}Misugi-kun'un ezici gücüne karşı\NTsubasa-kun harika bir hareket sergiledi.{\i0}
Dialogue: 0,0:05:18.08,0:05:20.26,Default,,0,0,0,,{\i1}Tsubasa-kun'dan da bu beklenirdi.{\i0}
Dialogue: 0,0:05:20.26,0:05:24.84,Default,,0,0,0,,{\i1}Her şeyimi ortaya koyup mücadele\Netmezsem kazanamayacak gibiyim gerçekten.{\i0}
Dialogue: 0,0:05:24.84,0:05:27.81,Default,,0,0,0,,{\i1}Gerçekten de harikasın Misugi-kun.{\i0}
Dialogue: 0,0:05:27.81,0:05:30.85,Default,,0,0,0,,{\i1}Tüm farklı tekniklerini görmek\Niçin sabırsızlanıyorum.{\i0}
Dialogue: 0,0:05:34.48,0:05:38.60,Default,,0,0,0,,{\i1}Bu maçın her anına çok odaklanmalıyım.{\i0}
Dialogue: 0,0:05:47.30,0:05:48.36,Default,,0,0,0,,Jun...
Dialogue: 0,0:05:48.36,0:05:51.03,Default,,0,0,0,,Ne? Sen de mi geldin?
Dialogue: 0,0:05:51.03,0:05:53.03,Default,,0,0,0,,Ne? Sen de mi?
Dialogue: 0,0:05:53.03,0:05:54.12,Default,,0,0,0,,Evet.
Dialogue: 0,0:05:54.12,0:05:58.58,Default,,0,0,0,,Bugünkü maça ne olursa olsun\Ngelmemi istedi Jun.
Dialogue: 0,0:05:59.20,0:06:01.42,Default,,0,0,0,,Yoksa o...
Dialogue: 0,0:06:07.54,0:06:09.45,Default,,0,0,0,,Ne oldu Roberto?
Dialogue: 0,0:06:10.93,0:06:14.18,Default,,0,0,0,,Tsubasa'nın oyunu konusunda\Naklına takılan bir şey mi var?
Dialogue: 0,0:06:14.18,0:06:16.31,Default,,0,0,0,,Hayır, hiç de bile.
Dialogue: 0,0:06:16.31,0:06:23.27,Default,,0,0,0,,Tsubasa çok iyi oynuyor. Aslında bu turnuvada\Nbeklediğimden daha çok gelişme kaydetti.
Dialogue: 0,0:06:23.27,0:06:25.92,Default,,0,0,0,,Yani bu maçı da Tsubasa-kun mu kazanacak?
Dialogue: 0,0:06:25.92,0:06:26.65,Default,,0,0,0,,Evet.
Dialogue: 0,0:06:26.65,0:06:30.65,Default,,0,0,0,,Japonya'da Misugi-kun gibi\Nbaşka yetenekli oyuncular da var.
Dialogue: 0,0:06:30.65,0:06:34.74,Default,,0,0,0,,Ama tek şampiyon Tsubasa olabilir.
Dialogue: 0,0:06:34.74,0:06:38.66,Default,,0,0,0,,O zaman geldiği zaman Tsubasa'yı\NBrezilya'ya götüreceksin Roberto.
Dialogue: 0,0:06:45.17,0:06:47.67,Default,,0,0,0,,{\i1}Bu durumda pas atamam.{\i0}
Dialogue: 0,0:06:47.67,0:06:48.41,Default,,0,0,0,,Misaki!
Dialogue: 0,0:06:48.41,0:06:49.26,Default,,0,0,0,,Dikkat et!
Dialogue: 0,0:06:50.47,0:06:51.38,Default,,0,0,0,,{\i1}Eyvah!{\i0}
Dialogue: 0,0:06:51.38,0:06:54.14,Default,,0,0,0,,{\i1}İşte Sahanın Genç Asili Misugi-kun!{\i0}
Dialogue: 0,0:06:55.89,0:06:57.06,Default,,0,0,0,,Ichinose!
Dialogue: 0,0:06:57.06,0:06:57.97,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:02.06,0:07:05.82,Default,,0,0,0,,{\i1}Çok yakındı! Top direğe çarptı!{\i0}
Dialogue: 0,0:07:09.32,0:07:10.94,Default,,0,0,0,,Moralini bozma Ichinose.
Dialogue: 0,0:07:10.94,0:07:11.57,Default,,0,0,0,,Tamam.
Dialogue: 0,0:07:11.57,0:07:13.22,Default,,0,0,0,,Jun...
Dialogue: 0,0:07:13.22,0:07:15.57,Default,,0,0,0,,Bazı zamanlar olur ki erkeklerin...
Dialogue: 0,0:07:15.57,0:07:22.67,Default,,0,0,0,,...hayallerini gerçekleştirmek için her şeyi\Nortaya koyup imkansızı zorlaması gerekir.
Dialogue: 0,0:07:24.03,0:07:26.88,Default,,0,0,0,,Jun için bu maç böyle bir an.
Dialogue: 0,0:07:26.88,0:07:30.72,Default,,0,0,0,,Bugün her şeyini ortaya\Nkoyacak bu maç.
Dialogue: 0,0:07:33.50,0:07:35.68,Default,,0,0,0,,{\i1}Topun bana gelmesini bekleyemem.{\i0}
Dialogue: 0,0:07:35.68,0:07:36.68,Default,,0,0,0,,{\i1}Öyleyse...{\i0}
Dialogue: 0,0:07:38.10,0:07:43.10,Default,,0,0,0,,{\i1}Misugi-kun pas vermeyip\NTsubasa-kun'un gelmesini bekliyor.{\i0}
Dialogue: 0,0:07:43.10,0:07:44.23,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:07:44.23,0:07:47.19,Default,,0,0,0,,{\i1}Topu kaybetmeyeceğine dair olan\Nöz güvenini mi gösteriyor bu?{\i0}
Dialogue: 0,0:07:47.19,0:07:52.86,Default,,0,0,0,,{\i1}Tsubasa-kun, seninle birebir\Nmücadele etmeyi iple çekiyordum.{\i0}
Dialogue: 0,0:07:52.86,0:07:55.16,Default,,0,0,0,,{\i1}Topu kesinlikle senden alacağım!{\i0}
Dialogue: 0,0:07:56.16,0:07:58.91,Default,,0,0,0,,{\i1}Vücudunu koyarak kontrolü eline alıyor!{\i0}
Dialogue: 0,0:08:03.87,0:08:05.03,Default,,0,0,0,,Misugi-kun!
Dialogue: 0,0:08:05.03,0:08:06.67,Default,,0,0,0,,Tsubasa-kun! Atak vakti!
Dialogue: 0,0:08:08.67,0:08:11.26,Default,,0,0,0,,{\i1}Nankatsu için büyük bir fırsat!{\i0}
Dialogue: 0,0:08:11.26,0:08:12.84,Default,,0,0,0,,{\i1}Tsubasa-kun'a pas!{\i0}
Dialogue: 0,0:08:15.00,0:08:18.26,Default,,0,0,0,,{\i1}Bir anlık gecikme oldu!{\i0}
Dialogue: 0,0:08:18.26,0:08:19.26,Default,,0,0,0,,Lanet olsun.
Dialogue: 0,0:08:19.26,0:08:20.99,Default,,0,0,0,,{\i1}Ne oldu Tsubasa?{\i0}
Dialogue: 0,0:08:20.99,0:08:22.93,Default,,0,0,0,,{\i1}Koşmak için geciktin.{\i0}
Dialogue: 0,0:08:22.93,0:08:24.38,Default,,0,0,0,,{\i1}Tsubasa-kun...{\i0}
Dialogue: 0,0:08:24.38,0:08:27.65,Default,,0,0,0,,{\i1}Yoksa kalp durumumu bilip\Nendişeleniyor musun?{\i0}
Dialogue: 0,0:08:28.73,0:08:32.44,Default,,0,0,0,,{\i1}Öyleyse çok saflık ediyorsun!{\i0}
Dialogue: 0,0:08:32.44,0:08:35.10,Default,,0,0,0,,{\i1}Bir kalp rahatsızlığına kaybedecek değilim!{\i0}
Dialogue: 0,0:08:35.10,0:08:36.16,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:36.68,0:08:39.83,Default,,0,0,0,,{\i1}Ve Tsubasa-kun, sana da kaybedecek değilim!{\i0}
Dialogue: 0,0:08:42.20,0:08:43.16,Default,,0,0,0,,{\i1}Misugi-kun.{\i0}
Dialogue: 0,0:08:43.16,0:08:45.87,Default,,0,0,0,,Daha fazla ilerlemene izin vermem!
Dialogue: 0,0:08:45.87,0:08:49.09,Default,,0,0,0,,{\i1}Nankatsu'dan 3 kişi durdurmak için gidiyor!{\i0}
Dialogue: 0,0:08:51.92,0:08:53.09,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:08:53.09,0:08:55.93,Default,,0,0,0,,{\i1}Nankatsu çaresizce iki taraftan kayıyor!{\i0}
Dialogue: 0,0:08:57.26,0:08:58.51,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:04.70,0:09:07.90,Default,,0,0,0,,{\i1}Gol! Havada harika bir hareket sergiliyor!{\i0}
Dialogue: 0,0:09:09.09,0:09:11.90,Default,,0,0,0,,{\i1}İnanılmaz cesur bir hareketti!{\i0}
Dialogue: 0,0:09:11.90,0:09:13.56,Default,,0,0,0,,{\i1}Misugi Jun!{\i0}
Dialogue: 0,0:09:13.56,0:09:15.84,Default,,0,0,0,,{\i1}Sahanın Genç Asili gerçekten.{\i0}
Dialogue: 0,0:09:15.84,0:09:17.53,Default,,0,0,0,,H-Harika...
Dialogue: 0,0:09:17.53,0:09:21.74,Default,,0,0,0,,{\i1}İlk yarının 10. dakikasında sonunda\NMusashi ilk golü atıp liderliği sağlıyor.{\i0}
Dialogue: 0,0:09:21.74,0:09:24.25,Default,,0,0,0,,Lanet olsun! Çok hızlıydı!
Dialogue: 0,0:09:24.25,0:09:25.38,Default,,0,0,0,,Lanet girsin.
Dialogue: 0,0:09:25.38,0:09:27.50,Default,,0,0,0,,Hiçbir şey yapamadık.
Dialogue: 0,0:09:27.50,0:09:29.66,Default,,0,0,0,,Misgui-kun gerçekten de harika.
Dialogue: 0,0:09:29.66,0:09:30.25,Default,,0,0,0,,Ne?
Dialogue: 0,0:09:30.90,0:09:33.70,Default,,0,0,0,,Ama futbol 11 kişi oynanır
Dialogue: 0,0:09:33.70,0:09:35.46,Default,,0,0,0,,Henüz kaybetmiş değiliz.
Dialogue: 0,0:09:35.46,0:09:38.80,Default,,0,0,0,,Haklısın! Daha çok vaktimiz var!
Dialogue: 0,0:09:38.80,0:09:40.44,Default,,0,0,0,,Hemen bir gol atarız.
Dialogue: 0,0:09:40.44,0:09:43.47,Default,,0,0,0,,İlk yarıda beraberliği sağlar\Nsonra da öne geçeriz!
Dialogue: 0,0:09:43.47,0:09:45.22,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:48.28,0:09:50.06,Default,,0,0,0,,{\i1}Maç devam ediyor!{\i0}
Dialogue: 0,0:09:50.06,0:09:54.90,Default,,0,0,0,,Nankatsu ilk golü yedikten sonra\Nkesinlikle Tsubasa-kun'a pas atmaya çalışacak!
Dialogue: 0,0:09:54.90,0:09:58.90,Default,,0,0,0,,Sano! Kido! Siz ikiniz\NTsubasa'yı tamamen markaja alın!
Dialogue: 0,0:09:58.90,0:09:59.86,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:02.00,0:10:03.12,Default,,0,0,0,,Misaki!
Dialogue: 0,0:10:03.12,0:10:04.99,Default,,0,0,0,,{\i1}Rakiplerim geldi.{\i0}
Dialogue: 0,0:10:04.99,0:10:06.45,Default,,0,0,0,,{\i1}Top sürerek geçeceğim.{\i0}
Dialogue: 0,0:10:07.96,0:10:09.67,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:09.67,0:10:13.21,Default,,0,0,0,,{\i1}Nankatsu'nun Altın İkilisi kaleye yaklaşıyor.{\i0}
Dialogue: 0,0:10:13.21,0:10:15.25,Default,,0,0,0,,{\i1}İyi gidiyorsun Tsubasa-kun.{\i0}
Dialogue: 0,0:10:15.25,0:10:17.42,Default,,0,0,0,,{\i1}Top Tsubasa-kun'a geliyor.{\i0}
Dialogue: 0,0:10:17.42,0:10:17.97,Default,,0,0,0,,{\i1}Tamamdır!{\i0}
Dialogue: 0,0:10:18.98,0:10:20.72,Default,,0,0,0,,{\i1}Misugi-kun pası kesiyor!{\i0}
Dialogue: 0,0:10:20.72,0:10:23.39,Default,,0,0,0,,{\i1}Nankatsu'nun Altın İkilisi işini yapamıyor!{\i0}
Dialogue: 0,0:10:24.64,0:10:26.85,Default,,0,0,0,,{\i1}Musashi'nin karşı atağı!{\i0}
Dialogue: 0,0:10:26.85,0:10:27.90,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:10:27.90,0:10:30.27,Default,,0,0,0,,Daha ne kadar bizi hafife alacaklar?!
Dialogue: 0,0:10:31.64,0:10:33.24,Default,,0,0,0,,Izawa haklı!
Dialogue: 0,0:10:33.24,0:10:36.33,Default,,0,0,0,,Nankatsu, sadece\NTsubasa ve Misaki'den ibaret değil.
Dialogue: 0,0:10:36.33,0:10:36.98,Default,,0,0,0,,Taki!
Dialogue: 0,0:10:38.17,0:10:38.94,Default,,0,0,0,,{\i1}Aynen öyle!{\i0}
Dialogue: 0,0:10:38.94,0:10:42.45,Default,,0,0,0,,{\i1}Nankatsu, futbolunu 11 kişi oynar.{\i0}
Dialogue: 0,0:10:42.45,0:10:43.41,Default,,0,0,0,,Tutun şunu!
Dialogue: 0,0:10:43.41,0:10:45.45,Default,,0,0,0,,Kontrolü ellerine alıyorlar!
Dialogue: 0,0:10:45.45,0:10:46.58,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:47.62,0:10:49.37,Default,,0,0,0,,Taki-kun, buraya!
Dialogue: 0,0:10:49.37,0:10:50.98,Default,,0,0,0,,Sana güveniyorum Misaki!
Dialogue: 0,0:10:50.98,0:10:54.34,Default,,0,0,0,,{\i1}Nankatsu harika bir takım oyunu sergiliyor.{\i0}
Dialogue: 0,0:10:54.34,0:10:57.30,Default,,0,0,0,,{\i1}Olmaz. Tsubasa-kun markajda.{\i0}
Dialogue: 0,0:10:57.80,0:10:59.55,Default,,0,0,0,,Kisugi-san, sana güveniyorum!
Dialogue: 0,0:11:00.26,0:11:03.05,Default,,0,0,0,,{\i1}Misugi, topu almana izin vermem!{\i0}
Dialogue: 0,0:11:05.18,0:11:08.18,Default,,0,0,0,,{\i1}Kisugi-kun kafa vurarak topu sola yönlendiriyor!{\i0}
Dialogue: 0,0:11:08.18,0:11:10.43,Default,,0,0,0,,{\i1}Tsubasa-kun markajdan sıyrılıyor!{\i0}
Dialogue: 0,0:11:10.43,0:11:12.02,Default,,0,0,0,,{\i1}Gol at Tsubasa!{\i0}
Dialogue: 0,0:11:12.02,0:11:13.69,Default,,0,0,0,,{\i1}Herkes çabalayarak bu fırsatı oluşturdu.{\i0}
Dialogue: 0,0:11:13.69,0:11:15.90,Default,,0,0,0,,{\i1}Yıldız oyuncu olarak bunu gole çevirmelisin!{\i0}
Dialogue: 0,0:11:15.90,0:11:18.18,Default,,0,0,0,,{\i1}Tutmaya çalışırsam yetişemem.{\i0}
Dialogue: 0,0:11:18.18,0:11:21.20,Default,,0,0,0,,{\i1}Ben Nankatsu'nun yıldız oyuncusuyum!{\i0}
Dialogue: 0,0:11:22.01,0:11:26.24,Default,,0,0,0,,{\i1}İşte! Tsubasa-kun'un özel rövaşata vuruşu!{\i0}
Dialogue: 0,0:11:31.00,0:11:32.48,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:11:32.48,0:11:35.75,Default,,0,0,0,,{\i1}Bu harika yeteneğe karşı kaleci\Nhiçbir şey yapamıyor!{\i0}
Dialogue: 0,0:11:35.75,0:11:37.75,Default,,0,0,0,,{\i1}Skor 1-1! Beraberlik!{\i0}
Dialogue: 0,0:11:38.11,0:11:39.38,Default,,0,0,0,,Başardım!
Dialogue: 0,0:11:39.38,0:11:40.88,Default,,0,0,0,,İşte böyle!
Dialogue: 0,0:11:40.88,0:11:42.76,Default,,0,0,0,,Harikaydı Tsubasa!
Dialogue: 0,0:11:42.76,0:11:44.16,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:11:44.16,0:11:45.76,Default,,0,0,0,,Harikasın Tsubasa!
Dialogue: 0,0:11:46.32,0:11:48.24,Default,,0,0,0,,{\i1}Tsubasa'dan da bu beklenirdi.{\i0}
Dialogue: 0,0:11:48.24,0:11:50.77,Default,,0,0,0,,{\i1}Diyecek hiçbir şeyim yok.{\i0}
Dialogue: 0,0:11:52.50,0:11:54.28,Default,,0,0,0,,{\i1}Baba... Anne...{\i0}
Dialogue: 0,0:11:54.28,0:11:55.27,Default,,0,0,0,,{\i1}Harika birisi, değil mi?{\i0}
Dialogue: 0,0:11:55.27,0:11:59.28,Default,,0,0,0,,{\i1}Son maçımdaki rakibim\NTsubasa-kun böyle birisi işte.{\i0}
Dialogue: 0,0:12:00.35,0:12:01.53,Default,,0,0,0,,Jun...
Dialogue: 0,0:12:01.53,0:12:04.76,Default,,0,0,0,,Tamamdır millet. Şimdi bizim sıramız.
Dialogue: 0,0:12:04.76,0:12:07.88,Default,,0,0,0,,Musashi FC'nin gerçek gösterelim!
Dialogue: 0,0:12:07.88,0:12:09.03,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:19.84,0:12:22.26,Default,,0,0,0,,{\i1}Maç, Nankatsu kalesinin etrafında dönmeye başladı.{\i0}
Dialogue: 0,0:12:22.26,0:12:24.51,Default,,0,0,0,,{\i1}Musashi 2. golünü atabilecek mi?{\i0}
Dialogue: 0,0:12:24.51,0:12:26.01,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:12:26.01,0:12:26.76,Default,,0,0,0,,Nakajima!
Dialogue: 0,0:12:29.26,0:12:32.43,Default,,0,0,0,,{\i1}İlerlemek yerine Misugi-kun'a\Ngeri pas veriyor!{\i0}
Dialogue: 0,0:12:33.88,0:12:37.18,Default,,0,0,0,,{\i1}Onu tutmak için Tsubasa-kun geldi!{\i0}
Dialogue: 0,0:12:37.18,0:12:40.15,Default,,0,0,0,,{\i1}İkinci karşılaşmaları!{\i0}
Dialogue: 0,0:12:40.15,0:12:44.20,Default,,0,0,0,,Tsubasa-kun, kalp durumumu biliyor musun?
Dialogue: 0,0:12:44.20,0:12:44.74,Default,,0,0,0,,Ne?
Dialogue: 0,0:12:46.20,0:12:49.12,Default,,0,0,0,,{\i1}Demek biliyordun Tsubasa-kun.{\i0}
Dialogue: 0,0:12:49.12,0:12:51.79,Default,,0,0,0,,{\i1}Ne?! Ne oldu Tsubasa-kun?!{\i0}
Dialogue: 0,0:12:52.70,0:12:53.45,Default,,0,0,0,,Uzaklaştıracağım!
Dialogue: 0,0:12:53.45,0:12:54.54,Default,,0,0,0,,Bu kez...
Dialogue: 0,0:12:55.42,0:12:57.04,Default,,0,0,0,,{\i1}Hava topu mücadelesi berabere!{\i0}
Dialogue: 0,0:12:59.12,0:12:59.85,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:12:59.85,0:13:02.75,Default,,0,0,0,,{\i1}Morisaki-kun güzelce yakalıyor.{\i0}
Dialogue: 0,0:13:02.75,0:13:04.38,Default,,0,0,0,,Misugi-kun.
Dialogue: 0,0:13:04.38,0:13:07.24,Default,,0,0,0,,Tsubasa-kun, ne olursa olsun...
Dialogue: 0,0:13:07.24,0:13:08.72,Default,,0,0,0,,...gücünü ortaya koymaktan çekinme.
Dialogue: 0,0:13:09.92,0:13:10.89,Default,,0,0,0,,Elbette!
Dialogue: 0,0:13:12.77,0:13:17.33,Default,,0,0,0,,{\i1}Bugünkü karşılaşmaların durumu\Nskor gibi berabere, 1-1!{\i0}
Dialogue: 0,0:13:17.33,0:13:20.02,Default,,0,0,0,,{\i1}Hangi taraf 2. golü ilk atacak?{\i0}
Dialogue: 0,0:13:20.02,0:13:23.81,Default,,0,0,0,,Tamamdır. Nankatsu, Tsubasa-kun'a\Nkuna ayak uydururken yapacağız.
Dialogue: 0,0:13:23.81,0:13:25.02,Default,,0,0,0,,O planı uygulayacağız.
Dialogue: 0,0:13:25.02,0:13:25.78,Default,,0,0,0,,Tamam!
Dialogue: 0,0:13:25.78,0:13:28.07,Default,,0,0,0,,Bastır Nankatsu!
Dialogue: 0,0:13:28.07,0:13:28.74,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:13:28.74,0:13:29.87,Default,,0,0,0,,Öne geçme vakti!
Dialogue: 0,0:13:34.38,0:13:38.83,Default,,0,0,0,,{\i1}Gol kalesinin önündeki\NTsubasa-kun'u tutan kimse yok!{\i0}
Dialogue: 0,0:13:41.34,0:13:42.46,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:13:42.46,0:13:45.89,Default,,0,0,0,,{\i1}Misaki-kun'un uzun pası ona ulaşacak mı?{\i0}
Dialogue: 0,0:13:45.89,0:13:46.97,Default,,0,0,0,,{\i1}Ulaştı!{\i0}
Dialogue: 0,0:13:46.97,0:13:50.09,Default,,0,0,0,,{\i1}Tsubasa-kun'u kale önünde kimse tutmuyor!{\i0}
Dialogue: 0,0:13:50.09,0:13:52.56,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:13:52.56,0:13:54.42,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:13:54.42,0:13:55.25,Default,,0,0,0,,Başardım!
Dialogue: 0,0:13:55.25,0:13:57.31,Default,,0,0,0,,{\i1}Nankatsu göz açıp kapayıncaya\Ndek skoru tersine çeviriyor.{\i0}
Dialogue: 0,0:13:57.84,0:13:59.81,Default,,0,0,0,,{\i1}Neşeyle kutlanıyor bu!{\i0}
Dialogue: 0,0:13:59.81,0:14:01.22,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:14:01.22,0:14:02.74,Default,,0,0,0,,Başardın!
Dialogue: 0,0:14:05.61,0:14:06.88,Default,,0,0,0,,{\i1}B-Bu da ne?{\i0}
Dialogue: 0,0:14:06.88,0:14:09.73,Default,,0,0,0,,{\i1}Yardımcı hakem bayrağını kaldırıyor.{\i0}
Dialogue: 0,0:14:09.73,0:14:11.50,Default,,0,0,0,,{\i1}Ofsayt durumu var!{\i0}
Dialogue: 0,0:14:11.50,0:14:12.15,Default,,0,0,0,,{\pos(280,1030)}Ne?!
Dialogue: 0,0:14:12.15,0:14:13.10,Default,,0,0,0,,{\pos(1680,1030)}Ofsayt mı?!
Dialogue: 0,0:14:15.06,0:14:16.76,Default,,0,0,0,,{\i1}Ofsayt.{\i0}
Dialogue: 0,0:14:16.76,0:14:21.80,Default,,0,0,0,,{\i1}Atak yapan taraf, rakip sahada\Nkendi takım arkadaşına pas gönderirse...{\i0}
Dialogue: 0,0:14:21.80,0:14:27.74,Default,,0,0,0,,{\i1}...ve bu sırada kale önünde kaleci de\Ndahil olmak üzere ikiden az kişi varsa olur.{\i0}
Dialogue: 0,0:14:27.74,0:14:36.14,Default,,0,0,0,,{\i1}Ve ofsayt tuzağı, bu kuralı kullanarak rakip oyuncuyu\Nofsayt pozisyonunda yalnız bırakmaya dayanır.{\i0}
Dialogue: 0,0:14:36.14,0:14:40.69,Default,,0,0,0,,Yoksa Musashi ofsayt tuzağı\Nkonusunda uzman mı?!
Dialogue: 0,0:14:42.55,0:14:43.23,Default,,0,0,0,,Taki-kun!
Dialogue: 0,0:14:44.15,0:14:45.90,Default,,0,0,0,,Tamamdır! Bu kez...
Dialogue: 0,0:14:46.34,0:14:48.15,Default,,0,0,0,,{\i1}Tsubasa-kun'u yine kimse tutmuyor.{\i0}
Dialogue: 0,0:14:51.11,0:14:52.11,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:14:55.09,0:14:57.76,Default,,0,0,0,,{\i1}Yine ofsayt!{\i0}
Dialogue: 0,0:14:57.76,0:14:59.76,Default,,0,0,0,,{\i1}Ofsayt tuzağı bu.{\i0}
Dialogue: 0,0:14:59.76,0:15:01.62,Default,,0,0,0,,Düşündüğüm gibi! Haklı çıktım!
Dialogue: 0,0:15:01.62,0:15:03.38,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:15:03.38,0:15:08.26,Default,,0,0,0,,{\i1}Tekrarlanan ofsayt tuzakları sayesinde\NTsubasa'nın şut çekmesi engelleniyordu.{\i0}
Dialogue: 0,0:15:12.64,0:15:13.80,Default,,0,0,0,,{\i1}Ofsayt!{\i0}
Dialogue: 0,0:15:13.80,0:15:17.25,Default,,0,0,0,,{\i1}Tsubaa-kun'un elinden hiçbir şey gelmiyor!{\i0}
Dialogue: 0,0:15:17.25,0:15:21.44,Default,,0,0,0,,{\i1}Nankatsu on biri için işler çıkmaza\Ngirmiş gibi görünüyordu.{\i0}
Dialogue: 0,0:15:21.44,0:15:24.09,Default,,0,0,0,,Nankatsu dağınıkken ilerleyin!
Dialogue: 0,0:15:24.09,0:15:24.69,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:15:24.69,0:15:26.06,Default,,0,0,0,,Tamam!
Dialogue: 0,0:15:26.06,0:15:28.19,Default,,0,0,0,,{\i1}Bu kez Musashi atakta!{\i0}
Dialogue: 0,0:15:28.19,0:15:29.03,Default,,0,0,0,,Honma!
Dialogue: 0,0:15:29.99,0:15:31.70,Default,,0,0,0,,{\i1}Top sağ kanada gidiyor!{\i0}
Dialogue: 0,0:15:31.70,0:15:34.20,Default,,0,0,0,,{\i1}Sanada-kun kale önüne doğru koşuyor!{\i0}
Dialogue: 0,0:15:39.02,0:15:41.08,Default,,0,0,0,,Top benim arkadaşım.
Dialogue: 0,0:15:41.08,0:15:44.42,Default,,0,0,0,,Korkmuyorum. Ama çok acıtıyor.
Dialogue: 0,0:15:44.42,0:15:46.67,Default,,0,0,0,,Tamamdır! 3. denemede olacak!
Dialogue: 0,0:15:47.98,0:15:49.80,Default,,0,0,0,,{\i1}Morisaki-kun engelliyor!{\i0}
Dialogue: 0,0:15:49.80,0:15:51.67,Default,,0,0,0,,Lanet olsun! Yine mi olmadı?!
Dialogue: 0,0:15:53.15,0:15:55.97,Default,,0,0,0,,{\i1}Top, Misugi-kun'a doğru geliyor!{\i0}
Dialogue: 0,0:15:56.89,0:15:59.48,Default,,0,0,0,,{\i1}Tsubasa-kun, sana göstereceğim.{\i0}
Dialogue: 0,0:15:59.48,0:16:02.44,Default,,0,0,0,,{\i1}O şutu çekebilecek tek kişi sen değilsin.{\i0}
Dialogue: 0,0:16:06.54,0:16:07.36,Default,,0,0,0,,Bu...
Dialogue: 0,0:16:07.36,0:16:09.58,Default,,0,0,0,,{\i1}B-Bu da ne?!{\i0}
Dialogue: 0,0:16:09.58,0:16:13.28,Default,,0,0,0,,{\i1}Bu sefer Misugi-kun harika\Nbir rövaşata çekiyor!{\i0}
Dialogue: 0,0:16:17.64,0:16:19.74,Default,,0,0,0,,{\i1}Ağları sallıyor!{\i0}
Dialogue: 0,0:16:20.79,0:16:23.44,Default,,0,0,0,,{\i1}Musashi yine liderliği alıyor!{\i0}
Dialogue: 0,0:16:25.12,0:16:27.32,Default,,0,0,0,,{\i1}Maç tamamen Musashi'nin...{\i0}
Dialogue: 0,0:16:27.32,0:16:30.30,Default,,0,0,0,,{\i1}Hayır, Misugi-kun'un kontrolünde!{\i0}
Dialogue: 0,0:16:31.00,0:16:33.30,Default,,0,0,0,,{\i1}Ve ilk yarıyı bitirecek düdük çalıyor!{\i0}
Dialogue: 0,0:16:33.30,0:16:38.93,Default,,0,0,0,,{\i1}Maç 2-1. Musashi ilk yarıyı önde bitiyor.{\i0}
Dialogue: 0,0:16:39.45,0:16:41.31,Default,,0,0,0,,Ç-Çok güçlü.
Dialogue: 0,0:16:42.01,0:16:43.81,Default,,0,0,0,,Millet, çok iyi iş çıkardınız.
Dialogue: 0,0:16:43.81,0:16:46.37,Default,,0,0,0,,İkinci yarıda da böyle devam edin.
Dialogue: 0,0:16:46.37,0:16:47.31,Default,,0,0,0,,Tamam.
Dialogue: 0,0:16:47.94,0:16:49.52,Default,,0,0,0,,İyi misin Misugi?
Dialogue: 0,0:16:49.52,0:16:52.09,Default,,0,0,0,,Evet, ikinci yarıda da böyle devam edebilirim.
Dialogue: 0,0:16:52.09,0:16:53.07,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:16:53.07,0:16:55.07,Default,,0,0,0,,Menajer, biraz konuşabilir miyiz?
Dialogue: 0,0:16:55.07,0:16:57.07,Default,,0,0,0,,T-Tamam.
Dialogue: 0,0:16:57.07,0:16:59.08,Default,,0,0,0,,Ne oldu millet?
Dialogue: 0,0:16:59.08,0:17:01.39,Default,,0,0,0,,Her zamanki kadar enerjik değilsiniz.
Dialogue: 0,0:17:01.39,0:17:06.32,Default,,0,0,0,,Koç, Misugi'nin Musashi'si\Nçetin ceviz gerçekten.
Dialogue: 0,0:17:06.32,0:17:09.84,Default,,0,0,0,,Sanki kafasının arkasında gözü var gibi.
Dialogue: 0,0:17:09.84,0:17:14.80,Default,,0,0,0,,Misugi'nin birkaç yılda bir gelen\Ndahi oyunculardan olduğu doğru.
Dialogue: 0,0:17:14.80,0:17:17.34,Default,,0,0,0,,Ama futbol bir takım oyunudur.
Dialogue: 0,0:17:17.34,0:17:20.68,Default,,0,0,0,,Takım oyunumuz kimsenin altında kalmaz.
Dialogue: 0,0:17:20.68,0:17:22.23,Default,,0,0,0,,Değil mi Tsubasa?
Dialogue: 0,0:17:22.23,0:17:24.89,Default,,0,0,0,,Ne? Evet.
Dialogue: 0,0:17:24.89,0:17:27.85,Default,,0,0,0,,Ama Misugi-kun çok güçlü.
Dialogue: 0,0:17:28.60,0:17:29.61,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:29.61,0:17:31.61,Default,,0,0,0,,Ne oldu Tsubasa? Sen de mi?
Dialogue: 0,0:17:31.61,0:17:32.61,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:17:34.24,0:17:36.53,Default,,0,0,0,,{\i1}Benden çok daha teknik oynuyor.{\i0}
Dialogue: 0,0:17:38.64,0:17:43.88,Default,,0,0,0,,{\i1}Kaptan olarak takımını yönlendirme\Nkonusunda da benden daha başarılı.{\i0}
Dialogue: 0,0:17:43.88,0:17:48.42,Default,,0,0,0,,{\i1}Ayrıca bir de kalp rahatsızlığının\Nengeli söz konusu.{\i0}
Dialogue: 0,0:17:49.05,0:17:51.45,Default,,0,0,0,,{\i1}Gerçekten de{\alpha&HFF&} kazanamam.{\i0}
Dialogue: 0,0:17:51.45,0:17:53.42,Default,,0,0,0,,{\i1}Gerçekten de kazanamam.{\i0}
Dialogue: 0,0:17:54.28,0:17:57.38,Default,,0,0,0,,Şey, ne konuşmak istemiştiniz Kaptan?
Dialogue: 0,0:18:02.69,0:18:03.97,Default,,0,0,0,,Ne?
Dialogue: 0,0:18:04.98,0:18:08.42,Default,,0,0,0,,Neden kalbimin durumundan\NTsubasa-kun'a bahsettin?
Dialogue: 0,0:18:10.90,0:18:17.02,Default,,0,0,0,,Senin yüzünden mücadelemiz\Niki kez yarıda kaldı.
Dialogue: 0,0:18:18.74,0:18:21.91,Default,,0,0,0,,Şans eseri öğrendiğin kalp durumum sonrası...
Dialogue: 0,0:18:21.91,0:18:24.91,Default,,0,0,0,,...benimle hep ilgilendin.
Dialogue: 0,0:18:25.41,0:18:29.24,Default,,0,0,0,,Ama bu maç benimle Tsubasa-kun\Narasındaki bir mücadele.
Dialogue: 0,0:18:29.24,0:18:31.17,Default,,0,0,0,,Burnunu sokmaya hakkın yok!
Dialogue: 0,0:18:33.88,0:18:36.66,Default,,0,0,0,,Özür dilerim Kaptan!
Dialogue: 0,0:18:45.06,0:18:47.21,Default,,0,0,0,,Ne oldu Anego?
Dialogue: 0,0:18:47.21,0:18:50.37,Default,,0,0,0,,İkinci yarıda kesinlikle öne geçeriz.
Dialogue: 0,0:18:50.37,0:18:51.10,Default,,0,0,0,,Hayır.
Dialogue: 0,0:18:51.84,0:18:57.11,Default,,0,0,0,,Ama Nankatsu kazanırsa\NTsubasa-kun Brezilya'ya gidecek.
Dialogue: 0,0:18:58.06,0:19:01.68,Default,,0,0,0,,Eğer Tsubasa-kun Japonya'da kalacaksa...
Dialogue: 0,0:19:01.68,0:19:04.66,Default,,0,0,0,,...belki de bu maçta kaybetmesi daha iyi olur.
Dialogue: 0,0:19:04.66,0:19:05.91,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:06.59,0:19:08.91,Default,,0,0,0,,{\i1}İkinci yarı başlıyor.{\i0}
Dialogue: 0,0:19:08.91,0:19:14.13,Default,,0,0,0,,{\i1}Tsubasa, sahada ilk kez böyle\Nbir duyguyu yaşıyordu.{\i0}
Dialogue: 0,0:19:14.13,0:19:18.30,Default,,0,0,0,,{\i1}Her zaman güven dolu olan\Nve topu arkadaşı gören Tsubasa...{\i0}
Dialogue: 0,0:19:18.30,0:19:23.59,Default,,0,0,0,,{\i1}...ilk kez huzursuz bir şekilde sahada duruyordu.{\i0}
Dialogue: 0,0:19:23.59,0:19:27.60,Default,,0,0,0,,İlk yarıdan farklı bir durumda.
Dialogue: 0,0:19:27.60,0:19:30.10,Default,,0,0,0,,Neşelen Tsubasa-kun!
Dialogue: 0,0:19:30.10,0:19:32.60,Default,,0,0,0,,{\i1}Top, Tsubasa-kun'a gidiyor.{\i0}
Dialogue: 0,0:19:35.28,0:19:38.14,Default,,0,0,0,,{\i1}Ne oldu? Tsubasa-kun topu\Ntutma konusunda hata yapıyor!{\i0}
Dialogue: 0,0:19:38.14,0:19:38.61,Default,,0,0,0,,Alıyorum!
Dialogue: 0,0:19:39.55,0:19:40.82,Default,,0,0,0,,Ne oldu Tsubasa-kun?!
Dialogue: 0,0:19:40.82,0:19:43.03,Default,,0,0,0,,Mücadelemiz daha yeni başladı!
Dialogue: 0,0:19:43.50,0:19:44.91,Default,,0,0,0,,Misugi-kun...
Dialogue: 0,0:19:44.91,0:19:46.45,Default,,0,0,0,,Tamamdır, atak vakti!
Dialogue: 0,0:19:46.45,0:19:47.91,Default,,0,0,0,,Herkes geri dönsün!
Dialogue: 0,0:19:47.91,0:19:51.00,Default,,0,0,0,,Ne olursa olsun savunma yapmalıyız.
Dialogue: 0,0:19:53.21,0:19:54.46,Default,,0,0,0,,Tamamdır! Bende!
Dialogue: 0,0:19:55.89,0:19:57.45,Default,,0,0,0,,{\i1}Misaki-kun geldi!{\i0}
Dialogue: 0,0:19:57.45,0:19:59.96,Default,,0,0,0,,{\i1}Nankatsu kıl payıyla zor durumu atlatıyor!{\i0}
Dialogue: 0,0:19:59.96,0:20:04.81,Default,,0,0,0,,{\i1}Düşündüğüm gibi Misaki-kun\Nbu maçın anahtarı olan oyuncu.{\i0}
Dialogue: 0,0:20:04.81,0:20:10.56,Default,,0,0,0,,{\i1}Ama Nankatsu'nun gerçek yıldız\Noyuncusu sensin Tsubasa-kun.{\i0}
Dialogue: 0,0:20:10.56,0:20:13.32,Default,,0,0,0,,{\i1}Burada bitmesine izin verme lütfen.{\i0}
Dialogue: 0,0:20:13.32,0:20:17.57,Default,,0,0,0,,{\i1}Bir kez daha her şeyini\Nortaya koyarak karşıma çık.{\i0}
Dialogue: 0,0:20:20.10,0:20:21.24,Default,,0,0,0,,Yağmur...
Dialogue: 0,0:20:22.18,0:20:23.99,Default,,0,0,0,,Tsubasa, sana güveniyorum!
Dialogue: 0,0:20:26.35,0:20:27.87,Default,,0,0,0,,Tsubasa-kun, geliyorum!
Dialogue: 0,0:20:28.56,0:20:29.70,Default,,0,0,0,,Misugi-kun...
Dialogue: 0,0:20:31.37,0:20:32.54,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:20:34.66,0:20:37.79,Default,,0,0,0,,{\i1}Tsubasa-kun, Misaki-kun'a pas veriyor!{\i0}
Dialogue: 0,0:20:37.79,0:20:40.25,Default,,0,0,0,,Size güveniyoruz Nankatsu'nun Altın İkilisi!
Dialogue: 0,0:20:40.94,0:20:42.34,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:20:42.34,0:20:43.68,Default,,0,0,0,,{\i1}Ne oldu?{\i0}
Dialogue: 0,0:20:43.68,0:20:45.84,Default,,0,0,0,,{\i1}Tsubasa-kun peşinden gelmiyor.{\i0}
Dialogue: 0,0:20:46.30,0:20:48.85,Default,,0,0,0,,{\i1}Misugi-kun'a denk olamam.{\i0}
Dialogue: 0,0:20:49.92,0:20:50.89,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:20:51.68,0:20:53.98,Default,,0,0,0,,{\i1}Misugi-kun topu çalıyor!{\i0}
Dialogue: 0,0:20:54.89,0:20:56.81,Default,,0,0,0,,{\i1}Ne oldu Tsubasa-kun?!{\i0}
Dialogue: 0,0:20:56.81,0:20:59.73,Default,,0,0,0,,{\i1}Mücadele azmini kayıp mı ettin?!{\i0}
Dialogue: 0,0:21:01.68,0:21:03.24,Default,,0,0,0,,{\i1}Ona denk olamam.{\i0}
Dialogue: 0,0:21:03.24,0:21:06.24,Default,,0,0,0,,{\i1}Yalvarıyorum Tsubasa-kun! Bana gel!{\i0}
Dialogue: 0,0:21:06.24,0:21:08.53,Default,,0,0,0,,{\i1}Top sürüşümü durdur!{\i0}
Dialogue: 0,0:21:09.28,0:21:10.45,Default,,0,0,0,,{\i1}Denk olamam.{\i0}
Dialogue: 0,0:21:11.18,0:21:14.75,Default,,0,0,0,,{\i1}Misugi-kun, Tsubasa-kun'u geçiyor!{\i0}
Dialogue: 0,0:21:17.88,0:21:19.14,Default,,0,0,0,,{\i1}Bitti.{\i0}
Dialogue: 0,0:21:20.25,0:21:21.00,Default,,0,0,0,,{\pos(1652,1030)}Tsubasa!
Dialogue: 0,0:21:21.00,0:21:21.92,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:21:21.92,0:21:23.30,Default,,0,0,0,,{\pos(432,1030)}Tsubasa!
Dialogue: 0,0:21:24.14,0:21:27.98,Default,,0,0,0,,{\i1}İmkansız. Misugi-kun'u yenemem.{\i0}
Dialogue: 0,0:21:30.05,0:21:33.81,Default,,0,0,0,,{\i1}Sanada-kun gol atıyor! 3-1!{\i0}
Dialogue: 0,0:21:33.81,0:21:36.41,Default,,0,0,0,,{\i1}2 gol öndeler!{\i0}
Dialogue: 0,0:21:36.41,0:21:39.06,Default,,0,0,0,,Bu maçın böyle olacağını düşünmezdim.
Dialogue: 0,0:21:39.62,0:21:43.32,Default,,0,0,0,,{\i1}Kaptan Tsubasa-kun'un kötü durumu\Nzincirleme etki mi yaptı?{\i0}
Dialogue: 0,0:21:43.68,0:21:46.70,Default,,0,0,0,,{\i1}Nankatsu oyuncularının hareketleri\Nher zamankinden daha yavaş.{\i0}
Dialogue: 0,0:21:46.70,0:21:49.98,Default,,0,0,0,,{\i1}İlk yarıda enerjileri mi bitti?{\i0}
Dialogue: 0,0:21:49.98,0:21:52.18,Default,,0,0,0,,İşte Nankatsu'nun gücü bu!
Dialogue: 0,0:21:52.95,0:21:58.92,Default,,0,0,0,,Biz Musashi'ye denk olamazlar!\NNankatsu bu kadar işte!
Dialogue: 0,0:21:58.92,0:22:02.45,Default,,0,0,0,,Millet, bu maç artık bizimdir.
Dialogue: 0,0:22:02.45,0:22:05.59,Default,,0,0,0,,Kendinizi tutmayın! Nankatsu'yu ezin geçin!
Dialogue: 0,0:22:05.59,0:22:07.47,Default,,0,0,0,,Tamam!
Dialogue: 0,0:22:17.34,0:22:20.02,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:23:50.11,0:24:00.72,Default,,0,0,0,,Gelecek 21. Bölümde:\NCamın Yıldız Oyuncusu
