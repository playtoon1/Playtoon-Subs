Dialogue: 0,0:00:01.73,0:00:03.69,Default,,0,0,0,,Demek o gün geldi ha?
Dialogue: 0,0:00:03.69,0:00:04.77,Default,,0,0,0,,Evet.
Dialogue: 0,0:00:04.77,0:00:07.77,Default,,0,0,0,,İyi ki seninle tanışmışım.
Dialogue: 0,0:00:07.77,0:00:12.11,Default,,0,0,0,,İlk kez bir futbol maçı\Niçin heyecanlanıyorum.
Dialogue: 0,0:00:12.11,0:00:15.24,Default,,0,0,0,,İyi bir maç yapalım Ishizaki-kun.
Dialogue: 0,0:00:15.24,0:00:17.12,Default,,0,0,0,,Herkese bugün için güveniyorum.
Dialogue: 0,0:00:17.12,0:00:18.12,Default,,0,0,0,,Ben de güveniyorum.
Dialogue: 0,0:00:18.12,0:00:18.66,Default,,0,0,0,,Evet.
Dialogue: 0,0:00:18.66,0:00:19.58,Default,,0,0,0,,Ben de güveniyorum.
Dialogue: 0,0:00:19.58,0:00:21.75,Default,,0,0,0,,Sadece iyi bir maç yapmayalım. Kazanalım.
Dialogue: 0,0:00:21.75,0:00:22.33,Default,,0,0,0,,İyi dedin.
Dialogue: 0,0:00:22.33,0:00:24.79,Default,,0,0,0,,Tamam millet, gidelim!
Dialogue: 0,0:00:24.79,0:00:26.29,Default,,0,0,0,,Tamam!
Dialogue: 0,0:00:26.29,0:00:28.00,Default,,0,0,0,,Dinleyin çocuklar!
Dialogue: 0,0:00:28.00,0:00:34.43,Default,,0,0,0,,Bu maçta Ozora Tsubasa'nın gol atmasına\Nne olursa olsun izin vermemelisiniz.
Dialogue: 0,0:00:34.43,0:00:39.51,Default,,0,0,0,,Bu maç, onun bana gol atıp\Natamayacağını gösteren bir mücadele.
Dialogue: 0,0:00:40.85,0:00:41.85,Default,,0,0,0,,Ishizaki...
Dialogue: 0,0:00:41.85,0:00:43.81,Default,,0,0,0,,Forvet sen misin?
Dialogue: 0,0:00:43.81,0:00:44.85,Default,,0,0,0,,Sayılır.
Dialogue: 0,0:00:44.85,0:00:46.48,Default,,0,0,0,,Ozora denilen çocuk değil mi yani?
Dialogue: 0,0:00:46.48,0:00:48.94,Default,,0,0,0,,Tsubasa'yı istiyorsanız orada.
Dialogue: 0,0:00:49.61,0:00:50.82,Default,,0,0,0,,Ne?
Dialogue: 0,0:00:50.82,0:00:53.11,Default,,0,0,0,,Tsubasa is in the center-back?
Dialogue: 0,0:00:54.49,0:00:55.53,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:00:55.53,0:00:56.78,Default,,0,0,0,,Evet!
Dialogue: 0,0:00:56.78,0:01:00.83,Default,,0,0,0,,Izawa-kun'un sinyaliyle\NShutetsu'nun atağı başladı!
Dialogue: 0,0:01:00.83,0:01:02.08,Default,,0,0,0,,Ulan seni...
Dialogue: 0,0:01:02.08,0:01:04.62,Default,,0,0,0,,Shutetsu'nun meşhur taktiği bu!
Dialogue: 0,0:01:04.62,0:01:07.21,Default,,0,0,0,,Forvet Kisugi-kun atakta!
Dialogue: 0,0:01:08.21,0:01:10.46,Default,,0,0,0,,İlk gol Shutetsu'nun mu olacak?!
Dialogue: 0,0:01:11.88,0:01:12.88,Default,,0,0,0,,Engellendi!
Dialogue: 0,0:01:12.88,0:01:15.80,Default,,0,0,0,,Nankatsu şutu engelledi!
Dialogue: 0,0:01:15.80,0:01:17.68,Default,,0,0,0,,Ulan...
Dialogue: 0,0:01:17.68,0:01:19.43,Default,,0,0,0,,Harika bir çalım.
Dialogue: 0,0:01:19.43,0:01:22.52,Default,,0,0,0,,Shutetsu topa dokunamıyor bile!
Dialogue: 0,0:01:22.52,0:01:24.39,Default,,0,0,0,,Hey Tsubasa!
Dialogue: 0,0:01:25.23,0:01:27.27,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:01:27.27,0:01:30.11,Default,,0,0,0,,Tsubasa, neden gelmiyorsun?
Dialogue: 0,0:01:30.52,0:01:32.82,Default,,0,0,0,,Bu maç seninle benim mücadelemiz olmalıydı.
Dialogue: 0,0:01:32.82,0:01:33.90,Default,,0,0,0,,Pası aldım!
Dialogue: 0,0:01:33.90,0:01:36.15,Default,,0,0,0,,Neden Ishizaki'ye pas veriyorsun?
Dialogue: 0,0:01:36.15,0:01:39.32,Default,,0,0,0,,Al bakalım Wakabayashi!
Dialogue: 0,0:01:41.08,0:01:43.49,Default,,0,0,0,,Neden gelmiyorsun Tsubasa?!
Dialogue: 0,0:01:46.21,0:01:47.21,Default,,0,0,0,,Çocuklar!
Dialogue: 0,0:01:47.21,0:01:48.87,Default,,0,0,0,,Rakibimiz sadece Tsubasa!
Dialogue: 0,0:01:48.87,0:01:50.33,Default,,0,0,0,,Çabuk gol atın!
Dialogue: 0,0:01:50.33,0:01:52.80,Default,,0,0,0,,Bu maçtaki hedefimiz 50 gol!
Dialogue: 0,0:01:55.09,0:01:57.51,Default,,0,0,0,,Tsubasa. Gel bakalım.
Dialogue: 0,0:01:57.97,0:02:02.97,Default,,0,0,0,,Wakabayashi-kun, bu ben ve senin\Narandaki bir mücadele.
Dialogue: 0,0:03:35.69,0:03:41.74,Default,,0,0,0,,{\fad(500,500)\pos(668,899.5)}Bölüm 7: Harika Tsubasa\NÇeviri: ARE-YOU-SURE
Dialogue: 0,0:03:35.69,0:03:41.74,Default,,0,0,0,,{\an8}Shutetsu İlkokulu ile Nankatsu İlkokulu\Narasındaki 26. futbol maçı başlamış bulunmakta.
Dialogue: 0,0:03:42.07,0:03:45.32,Default,,0,0,0,,Şu ana kadar tam bir beraberlik söz konusu.
Dialogue: 0,0:03:45.70,0:03:49.33,Default,,0,0,0,,Sonucu bu futbol maçı belirleyecek.{We already know it's football, so adding it might be redundant...}
Dialogue: 0,0:03:49.33,0:03:52.96,Default,,0,0,0,,{\i1}Bastır! Bastır! Tsubasa-kun!{\i0}
Dialogue: 0,0:03:53.42,0:03:55.79,Default,,0,0,0,,İlk yarı golsüz devam ederken...
Dialogue: 0,0:03:55.79,0:04:01.05,Default,,0,0,0,,...Shutetsu kaptanı Wakabayashi-kun\N50 gol atılmasını istedi!
Dialogue: 0,0:04:01.38,0:04:04.26,Default,,0,0,0,,Shutetsu bunu gerçekleştirmek\Niçin ataklarına devam ediyor!
Dialogue: 0,0:04:07.26,0:04:08.06,Default,,0,0,0,,Taki!
Dialogue: 0,0:04:10.68,0:04:12.06,Default,,0,0,0,,Tamamdır, gidelim!
Dialogue: 0,0:04:12.06,0:04:13.56,Default,,0,0,0,,Bunlar sadece Nankatsu.
Dialogue: 0,0:04:13.56,0:04:14.90,Default,,0,0,0,,50 gol...
Dialogue: 0,0:04:15.69,0:04:17.40,Default,,0,0,0,,...çocuk oyuncağı!
Dialogue: 0,0:04:17.40,0:04:18.65,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:04:20.53,0:04:22.28,Default,,0,0,0,,Taki-kun tekrar topu gönderiyor.
Dialogue: 0,0:04:23.70,0:04:25.57,Default,,0,0,0,,Pekala, ilk gol geliyor!
Dialogue: 0,0:04:27.12,0:04:28.58,Default,,0,0,0,,Kaleyi gördüm.
Dialogue: 0,0:04:29.45,0:04:31.00,Default,,0,0,0,,Shutetsu'dan Izawa-kun...
Dialogue: 0,0:04:31.00,0:04:33.58,Default,,0,0,0,,...orta mesafeli bir şutla\Nkaleyi hedefliyor!
Dialogue: 0,0:04:33.58,0:04:36.54,Default,,0,0,0,,Kaleci umutsuz bir şekilde zıplıyor\Nama ulaşamayacak!
Dialogue: 0,0:04:37.04,0:04:37.71,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:04:39.42,0:04:41.71,Default,,0,0,0,,Vay canına! Durdurdu!
Dialogue: 0,0:04:41.71,0:04:43.34,Default,,0,0,0,,Yine durdurdu!
Dialogue: 0,0:04:45.09,0:04:47.35,Default,,0,0,0,,Ulusal şampiyonları Shutetsu İlkokulu...
Dialogue: 0,0:04:47.35,0:04:49.81,Default,,0,0,0,,...atakları konusunda çok\Ngururlu bir takım olmasına rağmen...
Dialogue: 0,0:04:49.81,0:04:51.39,Default,,0,0,0,,...hala gol atamadı!
Dialogue: 0,0:04:53.23,0:04:58.31,Default,,0,0,0,,Üstelik rakipleri pratik maçında 30-0\Nyendikleri Nankatsu İlkokulu!
Dialogue: 0,0:04:58.31,0:05:03.19,Default,,0,0,0,,Ulusal turnuva şampiyonu Shutetsu İlkokulu,\Nbir kişi tarafından madara ediliyor!
Dialogue: 0,0:05:04.07,0:05:05.07,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:05:05.65,0:05:08.89,Default,,0,0,0,,Sahada duran harika birisi var ve...
Dialogue: 0,0:05:09.28,0:05:10.24,Default,,0,0,0,,...o kişinin adı...
Dialogue: 0,0:05:12.45,0:05:15.37,Default,,0,0,0,,...Nankatsu'nun 10 numarası\NOzara Tsubasa-kun!
Dialogue: 0,0:05:15.37,0:05:18.00,Default,,0,0,0,,Şimdi de röveşata vuruşuyla kaleyi korudu!
Dialogue: 0,0:05:18.00,0:05:19.42,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:05:19.42,0:05:20.54,Default,,0,0,0,,İşte bu.
Dialogue: 0,0:05:20.54,0:05:24.05,Default,,0,0,0,,Çok yaşa! Çok yaşa! Tsubasa!
Dialogue: 0,0:05:24.05,0:05:26.88,Default,,0,0,0,,Shutetsu bir gol bile atamadı.
Dialogue: 0,0:05:27.89,0:05:30.18,Default,,0,0,0,,Demek Ozora Tsubasa o.
Dialogue: 0,0:05:30.18,0:05:31.56,Default,,0,0,0,,Oldukça iyi bir merkez defans.
Dialogue: 0,0:05:32.85,0:05:35.81,Default,,0,0,0,,O aslında merkez defans değil.{it's context. don't change. i think this is the best I don't change if I think it's good enough T_T I am not a bully okay T_T}
Dialogue: 0,0:05:36.27,0:05:41.61,Default,,0,0,0,,Vuruşlarının hassaslığı, top gidişatını\Nanlama yeteneği ve oyun sezgisi.
Dialogue: 0,0:05:42.86,0:05:44.94,Default,,0,0,0,,Yoksa o...
Dialogue: 0,0:05:44.94,0:05:47.53,Default,,0,0,0,,Millet, biraz daha çabalayın!
Dialogue: 0,0:05:47.53,0:05:49.28,Default,,0,0,0,,Her şeyi Tsubasa'ya bırakmayın!
Dialogue: 0,0:05:49.16,0:05:49.87,Default,,0,0,0,,Evet.
Dialogue: 0,0:05:50.99,0:05:52.16,Default,,0,0,0,,Buraya Taki!
Dialogue: 0,0:05:54.95,0:05:56.08,Default,,0,0,0,,İlk golü atalım!
Dialogue: 0,0:05:56.46,0:05:59.13,Default,,0,0,0,,Nankatsu sadece 10 numaran ibaret.{better I guess?}
Dialogue: 0,0:05:59.13,0:06:01.46,Default,,0,0,0,,Başarana kadar atağa devam edin!
Dialogue: 0,0:06:01.46,0:06:02.21,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:02.21,0:06:04.21,Default,,0,0,0,,İzin vereceğimizi mi sandınız?!
Dialogue: 0,0:06:04.21,0:06:06.97,Default,,0,0,0,,Shutetsu atakta!
Dialogue: 0,0:06:15.56,0:06:16.39,Default,,0,0,0,,Çekil!
Dialogue: 0,0:06:17.98,0:06:18.89,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:06:20.52,0:06:21.69,Default,,0,0,0,,Bunlar...
Dialogue: 0,0:06:22.52,0:06:26.65,Default,,0,0,0,,Geçen sefer kolayca geçmiştik bunları.
Dialogue: 0,0:06:29.49,0:06:32.28,Default,,0,0,0,,Bizi o kadar kolay geçmelerine izin veremeyiz!{gives the meaning better I guess}
Dialogue: 0,0:06:32.62,0:06:35.66,Default,,0,0,0,,Koç Roberto ile o kadar pratik yaptık!
Dialogue: 0,0:06:38.71,0:06:39.54,Default,,0,0,0,,Eyvah!{This is nice!!}
Dialogue: 0,0:06:39.54,0:06:42.92,Default,,0,0,0,,Nankatsu'dan Nakazato-kun topu uzaklaştırıyor!
Dialogue: 0,0:06:42.92,0:06:45.09,Default,,0,0,0,,Nankatsu yine zor bir durumdan kurtuldu!
Dialogue: 0,0:06:45.59,0:06:48.92,Default,,0,0,0,,20 dakikalık yarının\N10 dakikası su gibi akıp geçti...
Dialogue: 0,0:06:48.92,0:06:51.09,Default,,0,0,0,,...ve maçta hala gol yok!
Dialogue: 0,0:06:53.89,0:06:56.77,Default,,0,0,0,,Siz ne yapıyorsunuz be?!
Dialogue: 0,0:06:57.60,0:06:59.85,Default,,0,0,0,,İşte bu, tam da planladığımız gibi.
Dialogue: 0,0:07:00.27,0:07:03.90,Default,,0,0,0,,İlk yarının golsüz devam etmesi için\NTsubasa'ya defans oynayacağız ve...
Dialogue: 0,0:07:03.90,0:07:05.86,Default,,0,0,0,,...hamlemizi 2. yarıda yapacağız.{or "we will take our chance in the second half" maybe?}
Dialogue: 0,0:07:07.32,0:07:07.94,Default,,0,0,0,,Kisugi!
Dialogue: 0,0:07:08.36,0:07:10.20,Default,,0,0,0,,Shutetsu'nun golcüsü Kisugi-kun...{goal getter is too engrish Imho, too specific.} {a good term for a striker that does this is 'poacher' or 'lead scorer' btw :)}
Dialogue: 0,0:07:10.20,0:07:12.74,Default,,0,0,0,,...iyi bilinen top sürüşüyle\NNankatsu sahasında ilerliyor!{using dribble twice would be bad so I changed <3}
Dialogue: 0,0:07:12.74,0:07:15.95,Default,,0,0,0,,Shutetsu golcüsü benim...
Dialogue: 0,0:07:15.95,0:07:18.66,Default,,0,0,0,,...hala gol atamamış olması tam bir utanç!{better?} {simplified}
Dialogue: 0,0:07:20.75,0:07:24.92,Default,,0,0,0,,Yine şimşek gibi kayarak topu kesti!{maybe unnecessary, you decide, let it stay. there was an adjective that i didn't understand, dengeki, is usually used on such occasions}
Dialogue: 0,0:07:24.92,0:07:27.59,Default,,0,0,0,,Nankatsu'dan Ozora Tsubasa-kun'un\Nbüyük gayretleriyle...
Dialogue: 0,0:07:27.59,0:07:29.80,Default,,0,0,0,,...Shutetsu hala gol atamadı!
Dialogue: 0,0:07:29.80,0:07:34.47,Default,,0,0,0,,Shutetsu'nun gol atamasının sebebi\Nsadece Nankatsu'nun 10 numarası değil.
Dialogue: 0,0:07:34.97,0:07:37.31,Default,,0,0,0,,Millet, biraz daha ilerleyebilirsiniz.
Dialogue: 0,0:07:37.31,0:07:40.81,Default,,0,0,0,,Tamamdır! Hadi biraz daha ilerleyelim.{I dont know that usage, its used? or cross the line a little further?}
Dialogue: 0,0:07:40.81,0:07:42.48,Default,,0,0,0,,10 numara sayesinde...
Dialogue: 0,0:07:42.48,0:07:45.73,Default,,0,0,0,,...diğer oyuncular korkusuz oynuyor.
Dialogue: 0,0:07:47.78,0:07:52.07,Default,,0,0,0,,Nankatsu koçu, en iyi oyuncusunu\Nmerkez defansta oynatarak...
Dialogue: 0,0:07:52.07,0:07:56.74,Default,,0,0,0,,...takım dengesini kurmuş durumda.
Dialogue: 0,0:07:57.33,0:08:00.04,Default,,0,0,0,,Gol atamamızın tek sebebi\NTsubasa değil.
Dialogue: 0,0:08:00.04,0:08:04.79,Default,,0,0,0,,Ishizaki'ler de hiç beklenmedik\Nbir şekilde iyi oynuyor.
Dialogue: 0,0:08:04.79,0:08:06.25,Default,,0,0,0,,Sadece birkaç haftada...
Dialogue: 0,0:08:06.25,0:08:08.88,Default,,0,0,0,,...o kadar kötüyken nasıl\Nbu kadar iyi olmuşlar?{I liked the weaklings haha}
Dialogue: 0,0:08:08.88,0:08:11.01,Default,,0,0,0,,Hey! Daha çok zorlayın kendinizi!{better I guess}
Dialogue: 0,0:08:11.01,0:08:14.59,Default,,0,0,0,,Hadi Tsubasa! Elinden geleni yap!
Dialogue: 0,0:08:14.59,0:08:16.85,Default,,0,0,0,,Küçük futbolcunun durumu nasıl?
Dialogue: 0,0:08:20.10,0:08:23.14,Default,,0,0,0,,Tsubasa-kun yine engelliyor!
Dialogue: 0,0:08:23.14,0:08:24.56,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:08:25.98,0:08:26.86,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:08:27.82,0:08:30.94,Default,,0,0,0,,Tsubasa-kun'dan Ishizaki-kun'una\Nuzun bir pas geldi!{SO MUCH KUN AND SAN AND AUGH}
Dialogue: 0,0:08:31.28,0:08:34.36,Default,,0,0,0,,Nankatsu'nun oyunu bu karşı atağa bağlı!{Nankatsu's attack will be this counter only!} {this reads much better imo}
Dialogue: 0,0:08:34.36,0:08:37.16,Default,,0,0,0,,Bu fırsatı kullanabilecekler mi?
Dialogue: 0,0:08:37.95,0:08:41.62,Default,,0,0,0,,Ne?! Kaleci Wakabayashi-kun\Ntopa doğru koşuyor!
Dialogue: 0,0:08:41.62,0:08:42.54,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:08:42.54,0:08:43.66,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:43.66,0:08:47.25,Default,,0,0,0,,Wakabayashi-kun kayarak topu kesiyor!{have you SEEN the absurd tackle this dude does what a legend}
Dialogue: 0,0:08:47.25,0:08:48.42,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:08:49.80,0:08:50.76,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:08:50.76,0:08:53.42,Default,,0,0,0,,Wakabayashi-kun gerildi.
Dialogue: 0,0:08:53.42,0:08:55.47,Default,,0,0,0,,Uzun bir top yolluyor.
Dialogue: 0,0:08:56.34,0:08:57.85,Default,,0,0,0,,Ama top...
Dialogue: 0,0:08:59.76,0:09:03.35,Default,,0,0,0,,...direkt rakip Tsubasa-kun'a gidiyor.
Dialogue: 0,0:09:04.98,0:09:08.27,Default,,0,0,0,,Wakabayashi-kun'un pası\Nyanlış yere yolladığı çok nadir görülür!
Dialogue: 0,0:09:08.69,0:09:11.03,Default,,0,0,0,,Tsubasa, gel bakalım!
Dialogue: 0,0:09:16.36,0:09:19.99,Default,,0,0,0,,Bu Wakabayashi-kun'dan bir meydan okuma.
Dialogue: 0,0:09:22.04,0:09:23.83,Default,,0,0,0,,Uzatma dakikalarına girdik.{loss time; stoppage time is also good, but it's something we're "in"}
Dialogue: 0,0:09:24.58,0:09:25.37,Default,,0,0,0,,Pekala.
Dialogue: 0,0:09:31.42,0:09:33.09,Default,,0,0,0,,Top sürmeye başladı!
Dialogue: 0,0:09:33.09,0:09:35.72,Default,,0,0,0,,Şu ana kadar defans yapmış Tsubasa-kun...
Dialogue: 0,0:09:35.72,0:09:37.84,Default,,0,0,0,,...birden karşı kaleye koşmaya başladı!
Dialogue: 0,0:09:38.97,0:09:40.72,Default,,0,0,0,,Tsubasa, plana uy!{stick to the plan, he never said stick to it.}
Dialogue: 0,0:09:41.93,0:09:46.35,Default,,0,0,0,,Tsubasa'nın sadece defans\Nyapmasını beklemek imkansız değil mi?
Dialogue: 0,0:09:46.35,0:09:48.35,Default,,0,0,0,,K-Kaptan!
Dialogue: 0,0:09:48.35,0:09:51.44,Default,,0,0,0,,Tsubasa'nın futbolu defans futbolu değildir.{F O O T B A L L}
Dialogue: 0,0:09:51.44,0:09:53.90,Default,,0,0,0,,Gol atma futboludur.
Dialogue: 0,0:09:54.61,0:09:56.49,Default,,0,0,0,,İşte böyle, devam et!
Dialogue: 0,0:09:56.95,0:10:00.45,Default,,0,0,0,,Hadi Tsubasa!
Dialogue: 0,0:10:00.45,0:10:02.45,Default,,0,0,0,,Ne? Baba...
Dialogue: 0,0:10:02.45,0:10:05.54,Default,,0,0,0,,Ulan sen! Bir de dışarı mı bakıyorsun?!
Dialogue: 0,0:10:07.87,0:10:09.17,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:11.17,0:10:15.30,Default,,0,0,0,,Harika! Tsubasa-kun'nun\Nilerleyişini kimse durduramıyor!
Dialogue: 0,0:10:15.30,0:10:16.05,Default,,0,0,0,,İşte böyle.
Dialogue: 0,0:10:16.05,0:10:17.93,Default,,0,0,0,,Ah şu Tsubasa.
Dialogue: 0,0:10:17.93,0:10:20.55,Default,,0,0,0,,Saldırmak da bir çeşit savunma tabii.{offense also becomes a kind of defense, maybe}
Dialogue: 0,0:10:20.55,0:10:22.18,Default,,0,0,0,,Ne var ne yok deneyeceğiz!{nice addition with all out}
Dialogue: 0,0:10:22.18,0:10:24.72,Default,,0,0,0,,İşte bu! Bu karşılaşma...
Dialogue: 0,0:10:24.72,0:10:29.60,Default,,0,0,0,,...Ozora Tsubasa ile Wakabayashi Genzo\Narasındaki bir mücadele olmalıydı!
Dialogue: 0,0:10:29.60,0:10:32.36,Default,,0,0,0,,Hadi Tsubasa-kun!
Dialogue: 0,0:10:33.86,0:10:35.86,Default,,0,0,0,,Geliyorum Wakabayashi-kun!
Dialogue: 0,0:10:36.28,0:10:38.07,Default,,0,0,0,,Gel bakalım Tsubasa!
Dialogue: 0,0:10:41.07,0:10:43.03,Default,,0,0,0,,Tsubasa orta mesafeden bir şut çekti!
Dialogue: 0,0:10:43.03,0:10:45.20,Default,,0,0,0,,G-Gidişatı...
Dialogue: 0,0:10:46.37,0:10:48.41,Default,,0,0,0,,Wakabayashi-kun çeviriyor!
Dialogue: 0,0:10:51.33,0:10:54.05,Default,,0,0,0,,Güzel bir şut ve güzel bir kurtarıştı!
Dialogue: 0,0:10:54.05,0:10:56.42,Default,,0,0,0,,İkili harika bir oyun sergiledi!
Dialogue: 0,0:10:56.42,0:10:58.47,Default,,0,0,0,,Harika! Sağlak olsaydın...
Dialogue: 0,0:10:58.47,0:11:00.76,Default,,0,0,0,,...kesinlikle girerdi.
Dialogue: 0,0:11:00.76,0:11:03.39,Default,,0,0,0,,Lanet olsun! Yakalayamadım!
Dialogue: 0,0:11:03.80,0:11:07.77,Default,,0,0,0,,Wakabayashi-kun harika çevirmesine rağmen...
Dialogue: 0,0:11:07.77,0:11:10.06,Default,,0,0,0,,...o şutu çektiğine göre...
Dialogue: 0,0:11:10.06,0:11:14.15,Default,,0,0,0,,...Ozora Tsubasa-kun forvet olmalı.
Dialogue: 0,0:11:17.44,0:11:20.32,Default,,0,0,0,,Nankatsu korner vuruşu kullanacak.
Dialogue: 0,0:11:20.32,0:11:22.66,Default,,0,0,0,,Vuracak kişi ise Tsubasa-kun!
Dialogue: 0,0:11:22.66,0:11:24.78,Default,,0,0,0,,Korneri Tsubasa mı kullanacak?
Dialogue: 0,0:11:24.78,0:11:26.33,Default,,0,0,0,,Nereye atacak?
Dialogue: 0,0:11:32.12,0:11:33.42,Default,,0,0,0,,Dinle Tsubasa.
Dialogue: 0,0:11:34.71,0:11:39.30,Default,,0,0,0,,Ayağının önüyle vururken topun\Nmerkezinin biraz dışına vur ve...
Dialogue: 0,0:11:39.72,0:11:41.26,Default,,0,0,0,,...topu çevir!
Dialogue: 0,0:11:42.22,0:11:44.14,Default,,0,0,0,,Tsubasa-kun korneri kullandı!
Dialogue: 0,0:11:44.14,0:11:45.55,Default,,0,0,0,,Aldım!
Dialogue: 0,0:11:45.55,0:11:47.26,Default,,0,0,0,,Ishizaki'ye attı!{centering is a real, but kind of bleh term; cross serves much better almost always}
Dialogue: 0,0:11:51.73,0:11:54.27,Default,,0,0,0,,Yok artık! Falsolandı!{swerved, magatta is spinned away, so its curved}
Dialogue: 0,0:11:54.27,0:11:57.53,Default,,0,0,0,,Tsubasa falso vererek\Ndirekt kaleyi hedef aldı!
Dialogue: 0,0:11:58.03,0:12:01.86,Default,,0,0,0,,Wakabayashi-kun parmaklarıyla uzanıyor!
Dialogue: 0,0:12:01.86,0:12:02.78,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:12:02.78,0:12:04.41,Default,,0,0,0,,Geçti!
Dialogue: 0,0:12:04.41,0:12:06.78,Default,,0,0,0,,Wakabayashi-kun uzanamıyor!
Dialogue: 0,0:12:07.12,0:12:09.91,Default,,0,0,0,,Ama top direğe çarpıyor!
Dialogue: 0,0:12:15.08,0:12:16.67,Default,,0,0,0,,İlk yarı burada bitiyor!
Dialogue: 0,0:12:16.67,0:12:23.51,Default,,0,0,0,,Tsubasa-kun'un kullandığı korner vuruşu\Ngol almaya çok yakındı gerçekten!
Dialogue: 0,0:12:23.51,0:12:26.72,Default,,0,0,0,,Skor hala 0-0.
Dialogue: 0,0:12:26.72,0:12:29.52,Default,,0,0,0,,Oldukça iyi bir oyun sergilendi.
Dialogue: 0,0:12:29.52,0:12:31.73,Default,,0,0,0,,Ne harika bir falso.
Dialogue: 0,0:12:31.73,0:12:34.27,Default,,0,0,0,,Ben bile yapabilir miyim bilmiyorum.{no idea how to insert "even I", that sentence misses the cruicial part tho, "Even a skilled one as I am, I am not sure if I can do it or not"}
Dialogue: 0,0:12:34.90,0:12:36.65,Default,,0,0,0,,İşte Tsubasa.
Dialogue: 0,0:12:36.65,0:12:40.74,Default,,0,0,0,,Yeni öğrendiği falso vermeyi böyle\Nönemli bir anda kullandı.
Dialogue: 0,0:12:44.28,0:12:45.66,Default,,0,0,0,,Baba!
Dialogue: 0,0:12:50.33,0:12:51.79,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:12:52.87,0:12:55.33,Default,,0,0,0,,Beni geçti.{AND BREAK}
Dialogue: 0,0:12:57.98,0:13:02.99,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:13:05.63,0:13:06.89,Default,,0,0,0,,Nasıl oldu Tsubasa?
Dialogue: 0,0:13:06.89,0:13:08.26,Default,,0,0,0,,Şaşırdın mı bakayım?
Dialogue: 0,0:13:08.26,0:13:09.39,Default,,0,0,0,,Evet.
Dialogue: 0,0:13:09.39,0:13:13.89,Default,,0,0,0,,Geleceğini hiç söylememiştin çünkü baba.{because = implied}
Dialogue: 0,0:13:13.89,0:13:17.52,Default,,0,0,0,,Demek Tsubasa'nın babası döndü.
Dialogue: 0,0:13:17.52,0:13:21.07,Default,,0,0,0,,Millet, Tsubasa ile ilgilendiğiniz için sağ olun.{He actually says "he's being a burden to you", but this makes more sense, right?}
Dialogue: 0,0:13:21.07,0:13:22.78,Default,,0,0,0,,Ne demek canım...{well, if you changed "he's being a burden to you" then you should change this too!}
Dialogue: 0,0:13:22.78,0:13:23.86,Default,,0,0,0,,Neyin havası bu?{"What are you so proud of?"}
Dialogue: 0,0:13:25.32,0:13:27.82,Default,,0,0,0,,Millet, ilk yarıda çok güzel\Nbir iş ortaya koydunuz.
Dialogue: 0,0:13:27.82,0:13:29.12,Default,,0,0,0,,Evet.
Dialogue: 0,0:13:29.12,0:13:31.29,Default,,0,0,0,,Tsubasa, çok yakındı be.
Dialogue: 0,0:13:31.29,0:13:33.58,Default,,0,0,0,,Gol atmak üzereydin.
Dialogue: 0,0:13:33.58,0:13:35.29,Default,,0,0,0,,Bunu da öpüp başımıza koyalım.{"you are overreaching?", the french is "Ã§a serait trop beau"="that would be great" nah zeitaku iuna is kinda(lemme go turkish on this one to convey better) "boÅŸan da semerini ye ayÄ±" <3 don't get greedy exactly :) like "you don't have the luxury to ask for that, but i just didn't know how to express it in that context} {i actually need to see the episode to really get the full context here.}
Dialogue: 0,0:13:35.29,0:13:40.34,Default,,0,0,0,,Başımıza koyalım da ilk kez\NShutetsu'ya karşı ilk yarıyı golsüz bitirdik.
Dialogue: 0,0:13:40.34,0:13:42.42,Default,,0,0,0,,Evet, aynen öyle!
Dialogue: 0,0:13:42.42,0:13:46.43,Default,,0,0,0,,Ama planımızı görmezden gelen birisi vardı.
Dialogue: 0,0:13:46.43,0:13:47.59,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:13:48.80,0:13:52.43,Default,,0,0,0,,Ben de eskiden koçun planını\Ngörmezden gelmiştim.{again went rebel on french subs? nope, but i thought as a coach, you'd have duties, so...he is just saying he was a rebel back then too <3}
Dialogue: 0,0:13:52.43,0:13:53.18,Default,,0,0,0,,Ne?
Dialogue: 0,0:13:53.18,0:13:57.65,Default,,0,0,0,,Ve bazen koçun beklediğinden\Ndaha iyi bir iş ortaya konmasını sağlar bu.
Dialogue: 0,0:13:57.65,0:13:59.52,Default,,0,0,0,,Bu sefer Tsubasa'nın yaptığı gibi.
Dialogue: 0,0:14:01.07,0:14:02.23,Default,,0,0,0,,Millet.
Dialogue: 0,0:14:02.23,0:14:05.74,Default,,0,0,0,,Futbol kendi kararlarınızla\Noynadığınız bir oyundur.
Dialogue: 0,0:14:05.74,0:14:08.57,Default,,0,0,0,,Bundan sonra kendi kararlarınıza\Nönem vermenizi istiyorum.
Dialogue: 0,0:14:08.57,0:14:09.45,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:09.45,0:14:12.83,Default,,0,0,0,,Aynen öyle. Sadece size söyleneni yaparsanız...
Dialogue: 0,0:14:12.83,0:14:14.66,Default,,0,0,0,,...asla gelişme gösteremezsiniz.
Dialogue: 0,0:14:14.66,0:14:16.08,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:16.08,0:14:18.46,Default,,0,0,0,,Ne zaman nasıl atak\Nyaptığınızı hatırlayın!
Dialogue: 0,0:14:18.46,0:14:20.04,Default,,0,0,0,,İki kanadı da kullanarak...
Dialogue: 0,0:14:20.04,0:14:23.63,Default,,0,0,0,,...defansı yarın ve ortada açıklık oluşturun.
Dialogue: 0,0:14:24.88,0:14:28.38,Default,,0,0,0,,Nankatsu'nun eski halinden eser\Nolmadığı doğru.
Dialogue: 0,0:14:28.38,0:14:31.72,Default,,0,0,0,,Ama top hakimiyetine bakılırsa\Nüstün taraf biziz.
Dialogue: 0,0:14:31.72,0:14:33.56,Default,,0,0,0,,İkinci yarıda da gardınızı düşürmeyin.{ki wo hikishimeru= not letting guard down}
Dialogue: 0,0:14:33.56,0:14:35.18,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:35.18,0:14:39.15,Default,,0,0,0,,Millet, rica ediyorum.
Dialogue: 0,0:14:39.15,0:14:41.86,Default,,0,0,0,,Bir gol. Sadece bir gol atın.
Dialogue: 0,0:14:41.86,0:14:43.19,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:14:44.03,0:14:47.61,Default,,0,0,0,,50 gol gibi abes şeyler\Nsöylemeyeceğim artık.
Dialogue: 0,0:14:48.28,0:14:51.16,Default,,0,0,0,,Lütfen. Sadece bir gol atın.{pridebayashi mellowed out so bad <3 mellowbayashi-kun} {he had the pride fuckin olympic corner kick shot out of him}
Dialogue: 0,0:14:53.78,0:14:54.91,Default,,0,0,0,,N'aber bakalım?
Dialogue: 0,0:14:54.91,0:14:58.96,Default,,0,0,0,,Dediğim gibi Shutetsu\Nçok zorlanmıyor mu?
Dialogue: 0,0:14:58.96,0:15:01.54,Default,,0,0,0,,İkinci yarının başlangıcına göre...
Dialogue: 0,0:15:01.54,0:15:04.63,Default,,0,0,0,,...Shutetsu kaybedebilir bile.
Dialogue: 0,0:15:05.38,0:15:06.67,Default,,0,0,0,,Anladınız mı?
Dialogue: 0,0:15:06.67,0:15:08.17,Default,,0,0,0,,İkinci yarıda fırsat bulursanız...
Dialogue: 0,0:15:08.17,0:15:09.76,Default,,0,0,0,,...her şeyinizle bastırın.
Dialogue: 0,0:15:09.76,0:15:10.55,Default,,0,0,0,,Tamam!
Dialogue: 0,0:15:10.55,0:15:12.26,Default,,0,0,0,,Hadi gidin halledin şunu!{there can be lots of better ways to put this actually one of the better ones it is} {roberto is a slacker so you know he slanged it up <3}
Dialogue: 0,0:15:13.51,0:15:14.68,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:15.43,0:15:16.52,Default,,0,0,0,,Dinle.
Dialogue: 0,0:15:16.52,0:15:18.81,Default,,0,0,0,,Oynuyorsan sakın kaybetme.
Dialogue: 0,0:15:18.81,0:15:20.94,Default,,0,0,0,,Baban kaybedenlerden nefret eder.
Dialogue: 0,0:15:20.94,0:15:22.31,Default,,0,0,0,,Tamam.
Dialogue: 0,0:15:24.32,0:15:27.86,Default,,0,0,0,,Evet, devre arası bitti\Nve oyuncular sahaya çıktı.
Dialogue: 0,0:15:27.86,0:15:29.70,Default,,0,0,0,,İkinci 20 dakika başlayacak.
Dialogue: 0,0:15:29.70,0:15:31.20,Default,,0,0,0,,Bastır Shutetsu!{SHUUTETSU CHEERLEADING SUCKS}
Dialogue: 0,0:15:31.41,0:15:33.37,Default,,0,0,0,,Bastır Shutetsu!
Dialogue: 0,0:15:33.57,0:15:35.12,Default,,0,0,0,,Kazan Shutetsu!
Dialogue: 0,0:15:35.12,0:15:36.87,Default,,0,0,0,,Kazan Shutetsu!
Dialogue: 0,0:15:36.87,0:15:39.25,Default,,0,0,0,,Tamam! Tamam! Tamam!
Dialogue: 0,0:15:39.25,0:15:42.29,Default,,0,0,0,,Tamam, ikinci yarıda bastıralım!
Dialogue: 0,0:15:42.29,0:15:44.84,Default,,0,0,0,,Peh, sadece havalı davranmaya çalışıyorlar.
Dialogue: 0,0:15:44.84,0:15:48.09,Default,,0,0,0,,Bastır Shutetsu! Bastır Shutetsu!
Dialogue: 0,0:15:48.09,0:15:51.38,Default,,0,0,0,,Nankatsu böyle devam et!
Dialogue: 0,0:15:51.38,0:15:52.68,Default,,0,0,0,,Takımlar yer değiştirdi.
Dialogue: 0,0:15:52.68,0:15:55.51,Default,,0,0,0,,Nankatsu'nun top vuruşuyla\Nikinci yarı başlayacak.
Dialogue: 0,0:16:04.40,0:16:05.44,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:05.44,0:16:07.27,Default,,0,0,0,,İki kişi birden kayıyor!{not literally, but that's what I'd expect to hear}
Dialogue: 0,0:16:08.48,0:16:11.36,Default,,0,0,0,,Shutetsu ilerlemiş topu geri aldı!{not sure about this one. neo says so, it's all right} {this is actually totally correct; if you recover the ball 'high' it means it's deep in enemy territory}
Dialogue: 0,0:16:12.03,0:16:13.86,Default,,0,0,0,,Shutetsu'nun ruh hali değişti.
Dialogue: 0,0:16:14.78,0:16:16.37,Default,,0,0,0,,Kaptanımız...
Dialogue: 0,0:16:16.37,0:16:19.50,Default,,0,0,0,,İlk kez bizden bir şey rica etti.
Dialogue: 0,0:16:19.50,0:16:22.33,Default,,0,0,0,,Ne olursa olsun gol atacağız!
Dialogue: 0,0:16:22.33,0:16:24.17,Default,,0,0,0,,Millet geri!
Dialogue: 0,0:16:24.17,0:16:27.09,Default,,0,0,0,,Shutetsu'nun atağı\Nkabaran bir dalga gibi geliyor!{need a better tl for this} {nah you just needed a Sick Editâ„¢ i gotchu fam}{luv you}{<3}
Dialogue: 0,0:16:27.09,0:16:29.17,Default,,0,0,0,,Nankatsu'nun defans çizgisi geriye çekiliyor!
Dialogue: 0,0:16:37.81,0:16:40.18,Default,,0,0,0,,Taki-kun merkeze atıyor!
Dialogue: 0,0:16:40.18,0:16:41.98,Default,,0,0,0,,Kisugi-kun topu aldı!
Dialogue: 0,0:16:41.98,0:16:44.73,Default,,0,0,0,,Shutetsu'nun altın taktiği bu!{"golden pattern" is what he actually says}
Dialogue: 0,0:16:44.73,0:16:46.81,Default,,0,0,0,,Hayatta izin vermeyiz!
Dialogue: 0,0:16:46.81,0:16:50.32,Default,,0,0,0,,Nankatsu defansı panikte\Nve Kisugi-kun'u engelliyorlar!{let's get physical, physical!}
Dialogue: 0,0:16:52.61,0:16:54.53,Default,,0,0,0,,Nankatsu zor durumda!
Dialogue: 0,0:16:54.53,0:16:56.74,Default,,0,0,0,,Kalenin önünde tam bir karmaşa hakim!
Dialogue: 0,0:16:57.45,0:16:58.49,Default,,0,0,0,,Izawa!
Dialogue: 0,0:17:00.20,0:17:01.45,Default,,0,0,0,,Dışarıya!
Dialogue: 0,0:17:01.45,0:17:02.29,Default,,0,0,0,,Dışarıya at!
Dialogue: 0,0:17:05.42,0:17:08.50,Default,,0,0,0,,Nankatsu zar zor topu uzaklaştırdı...
Dialogue: 0,0:17:08.50,0:17:10.71,Default,,0,0,0,,...ve zor durumu savuşturdu.{"predicament" maybe?}
Dialogue: 0,0:17:13.97,0:17:15.05,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:17:15.89,0:17:19.01,Default,,0,0,0,,Çok gaza gelmiş durumdalar.{or "motivated". he talks about "fighting spirit" if someone can use the term} {fired up would be the term if you want to talk motivation}
Dialogue: 0,0:17:19.01,0:17:23.35,Default,,0,0,0,,Shutetsu için harika bir taç kullanma yeri.
Dialogue: 0,0:17:23.35,0:17:24.35,Default,,0,0,0,,Takasugi!
Dialogue: 0,0:17:25.10,0:17:26.19,Default,,0,0,0,,Sana bırakıyoruz.{don't want to repeat "tanomu" too much}
Dialogue: 0,0:17:26.19,0:17:27.48,Default,,0,0,0,,Bana bırakın.
Dialogue: 0,0:17:27.48,0:17:29.90,Default,,0,0,0,,Takasugi mi taç kullanacak?!
Dialogue: 0,0:17:29.90,0:17:31.07,Default,,0,0,0,,Bir saniye.
Dialogue: 0,0:17:31.07,0:17:35.70,Default,,0,0,0,,Shutetsu'nun merkez defansı Takasugi-kun,\Ntaç kullanmak için o kadar yol geldi.
Dialogue: 0,0:17:35.70,0:17:38.03,Default,,0,0,0,,O defans değil mi?
Dialogue: 0,0:17:38.03,0:17:39.45,Default,,0,0,0,,Neyin peşinde?
Dialogue: 0,0:17:44.21,0:17:45.25,Default,,0,0,0,,Geliyor!
Dialogue: 0,0:17:50.75,0:17:52.55,Default,,0,0,0,,Uzun bir taç kullanıldı!
Dialogue: 0,0:17:52.55,0:17:53.96,Default,,0,0,0,,Harika bir şey bu!
Dialogue: 0,0:17:53.96,0:17:56.63,Default,,0,0,0,,Direkt olarak kalenin\Nönündeki Izawa-kun'a geliyor!
Dialogue: 0,0:17:56.63,0:17:57.72,Default,,0,0,0,,Tsubasa, sana bırakıyorum!
Dialogue: 0,0:17:57.72,0:17:58.72,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:18:00.10,0:18:01.39,Default,,0,0,0,,Kaybetmeyeceğim!
Dialogue: 0,0:18:01.39,0:18:07.56,Default,,0,0,0,,Shutetsu'daki herkesten daha\Nyükseğe zıplayabilirim!
Dialogue: 0,0:18:07.56,0:18:11.57,Default,,0,0,0,,Izawa-kun ve Tsubasa-kun\Nhava topu için karşı karşıya geliyor!
Dialogue: 0,0:18:11.57,0:18:12.65,Default,,0,0,0,,Berabere!
Dialogue: 0,0:18:12.65,0:18:14.57,Default,,0,0,0,,Top uzaklaşıyor!{better suggestion for "koboreta"? good imho}
Dialogue: 0,0:18:16.07,0:18:19.07,Default,,0,0,0,,Orada Nankatsu'dan Okawa-kun var!
Dialogue: 0,0:18:19.07,0:18:20.16,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:18:20.16,0:18:22.41,Default,,0,0,0,,Hemen Shutetsu'dan Kisugi-kun topu alıyor!{takes it, steals it, recovers it}
Dialogue: 0,0:18:22.41,0:18:24.50,Default,,0,0,0,,Şut çekmeye hazırlanıyor!
Dialogue: 0,0:18:24.50,0:18:27.00,Default,,0,0,0,,Tsubasa-kun çarpıştıktan sonra\Nhala kalkamadı!{nothing senpai helpz} {i think i missed sth here, motsureru, tangled up with.wait, it also means to trip. he tripped and fell? yup I mean, they collided in mid air and tangled each other}
Dialogue: 0,0:18:27.00,0:18:28.79,Default,,0,0,0,,Hallettim!
Dialogue: 0,0:18:31.42,0:18:32.84,Default,,0,0,0,,Gol!{actually "he scored"}
Dialogue: 0,0:18:32.84,0:18:36.63,Default,,0,0,0,,Kisugi'nin sol köşeye yolladığı\Nharika şut gol oluyor!{it says "left" in japanese, but to me and to the french, that's the right corner. i don't know what to believe anymore, probably french is wrong here, its tsubasa , you may never know, so lets believe in japanese <3}
Dialogue: 0,0:18:37.76,0:18:39.14,Default,,0,0,0,,Yaşasın!
Dialogue: 0,0:18:39.72,0:18:42.93,Default,,0,0,0,,İlk gol Shutetsu'nun! Shutetsu'nun!
Dialogue: 0,0:18:42.93,0:18:43.93,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:18:43.93,0:18:45.43,Default,,0,0,0,,Gördün mü Nankatsu?
Dialogue: 0,0:18:45.43,0:18:48.19,Default,,0,0,0,,Shutetsu'nun gerçek gücü bu işte!{getting cocky after one goal <3}
Dialogue: 0,0:18:48.19,0:18:50.02,Default,,0,0,0,,Bu golle maç bitti.
Dialogue: 0,0:18:50.02,0:18:52.36,Default,,0,0,0,,Nankatsu'ya göre bayağı\Niyi iş çıkardınız.
Dialogue: 0,0:18:52.36,0:18:53.57,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:18:54.86,0:18:56.65,Default,,0,0,0,,Daha bitmedi!
Dialogue: 0,0:18:56.65,0:19:00.03,Default,,0,0,0,,Daha bitmedi! Gerçek maç şimdi başlıyor!
Dialogue: 0,0:19:00.03,0:19:02.32,Default,,0,0,0,,Şimdi başlıyoruz Shutetsu!{pissed tsubasa is pissed }
Dialogue: 0,0:19:02.32,0:19:03.41,Default,,0,0,0,,Ne?
Dialogue: 0,0:19:03.41,0:19:05.87,Default,,0,0,0,,Evet! Aynı Tsubasa'nın dediği gibi!
Dialogue: 0,0:19:05.87,0:19:07.33,Default,,0,0,0,,Daha yeni başlıyoruz!
Dialogue: 0,0:19:09.17,0:19:11.83,Default,,0,0,0,,Tsubasa ve diğerleri\Niyi bir duruş sergiliyor.
Dialogue: 0,0:19:12.54,0:19:15.09,Default,,0,0,0,,Bu duruşla Shutetsu'yu ezin.
Dialogue: 0,0:19:15.09,0:19:17.84,Default,,0,0,0,,Şimdi gerçek maç başlıyor işte.{match}
Dialogue: 0,0:19:19.30,0:19:22.01,Default,,0,0,0,,Minnettarım millet.
Dialogue: 0,0:19:22.01,0:19:25.22,Default,,0,0,0,,Bu başarıyı kesinlikle müdafaa edeceğim!
Dialogue: 0,0:19:25.22,0:19:26.93,Default,,0,0,0,,Bu da ne böyle?!
Dialogue: 0,0:19:26.93,0:19:29.69,Default,,0,0,0,,Topu o kadar uzağa atmak\Nkurallara aykırı değil mi?{ari here means allowed to do}
Dialogue: 0,0:19:29.69,0:19:31.48,Default,,0,0,0,,Değil.
Dialogue: 0,0:19:31.48,0:19:33.73,Default,,0,0,0,,Shutetsu İlkokulu'ndan da bu beklenirdi.
Dialogue: 0,0:19:36.44,0:19:39.07,Default,,0,0,0,,Takım olarak hareket etme yeteneği.
Dialogue: 0,0:19:39.07,0:19:42.07,Default,,0,0,0,,Ulusal şampiyonların gücü bu mu?
Dialogue: 0,0:19:43.03,0:19:45.99,Default,,0,0,0,,İlk yarıyı iyi bitirseler de...
Dialogue: 0,0:19:45.99,0:19:48.58,Default,,0,0,0,,...Nankatsu için bu gol büyük bir darbe oldu.
Dialogue: 0,0:19:48.58,0:19:51.21,Default,,0,0,0,,Üstelik ikinci yarı başladığı gibi geldi.
Dialogue: 0,0:19:51.21,0:19:54.00,Default,,0,0,0,,Nasıl ayağa kalkacaksınız Nankatsu?
Dialogue: 0,0:19:55.96,0:19:57.71,Default,,0,0,0,,Bu da ne?
Dialogue: 0,0:19:57.71,0:20:01.01,Default,,0,0,0,,Anlaşılan Nankatsu pozisyon değişikliği yapıyor.
Dialogue: 0,0:20:01.63,0:20:03.39,Default,,0,0,0,,Merkez defans olan Tsubasa-kun...
Dialogue: 0,0:20:03.39,0:20:04.76,Default,,0,0,0,,...forvete geçti!
Dialogue: 0,0:20:04.76,0:20:08.27,Default,,0,0,0,,Demek sonunda geleceksin Tsubasa.{mellowbayashi wants hug from tsubasa}
Dialogue: 0,0:20:08.27,0:20:09.93,Default,,0,0,0,,Gidelim Tsubasa.
Dialogue: 0,0:20:09.93,0:20:10.64,Default,,0,0,0,,Tamam!
Dialogue: 0,0:20:11.39,0:20:13.40,Default,,0,0,0,,Senden alınanı geri al.
Dialogue: 0,0:20:13.40,0:20:16.48,Default,,0,0,0,,Mücadelenin altın kuralı budur Tsubasa.
Dialogue: 0,0:20:17.90,0:20:20.32,Default,,0,0,0,,Maç devam ediyor.
Dialogue: 0,0:20:20.32,0:20:22.57,Default,,0,0,0,,Top vuruşuyla Tsubasa-kun\Ntop sürmeye başladı...
Dialogue: 0,0:20:22.57,0:20:24.57,Default,,0,0,0,,...ve Shutetsu sahasında hızla ilerliyor!
Dialogue: 0,0:20:24.57,0:20:25.49,Default,,0,0,0,,Tamamdır millet!
Dialogue: 0,0:20:25.49,0:20:27.33,Default,,0,0,0,,Tsubasa'yı takip edin!
Dialogue: 0,0:20:28.29,0:20:29.37,Default,,0,0,0,,Durdurun!
Dialogue: 0,0:20:29.37,0:20:31.50,Default,,0,0,0,,Sadece ona engel olun yeter!
Dialogue: 0,0:20:38.30,0:20:39.17,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:39.17,0:20:40.34,Default,,0,0,0,,Harika!
Dialogue: 0,0:20:40.34,0:20:41.92,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:20:41.92,0:20:44.30,Default,,0,0,0,,Tsubasa tek başına topu sürüyor...
Dialogue: 0,0:20:44.30,0:20:46.39,Default,,0,0,0,,...ve Shutetsu sahasında ilerlemeye devam ediyor!
Dialogue: 0,0:20:46.39,0:20:47.56,Default,,0,0,0,,Takasugi, durdur onu!
Dialogue: 0,0:20:47.56,0:20:48.89,Default,,0,0,0,,Şut çekecek!{missed this part ;_;utte kuru, utsu}
Dialogue: 0,0:20:48.89,0:20:49.85,Default,,0,0,0,,Fark etmez!
Dialogue: 0,0:20:49.85,0:20:50.68,Default,,0,0,0,,Bırak çeksin!
Dialogue: 0,0:20:53.77,0:20:54.85,Default,,0,0,0,,Gel!
Dialogue: 0,0:20:54.85,0:20:55.69,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:20:56.36,0:20:59.07,Default,,0,0,0,,Tsubasa-kun kalenin önünden şutunu çekiyor!
Dialogue: 0,0:20:59.07,0:21:01.28,Default,,0,0,0,,Demek burayı seçtin!
Dialogue: 0,0:21:02.49,0:21:04.70,Default,,0,0,0,,Wakabayashi-kun güzel yakaladı!
Dialogue: 0,0:21:04.70,0:21:06.07,Default,,0,0,0,,Zıplayıp kurtardı!
Dialogue: 0,0:21:06.87,0:21:07.87,Default,,0,0,0,,Harika.
Dialogue: 0,0:21:07.87,0:21:09.08,Default,,0,0,0,,O gidişatı durdurdun.
Dialogue: 0,0:21:09.08,0:21:11.37,Default,,0,0,0,,İlk yarıda bir şeyler ortaya koysanız da...
Dialogue: 0,0:21:11.37,0:21:14.08,Default,,0,0,0,,...topu geçirmezsem hiçbir şey olmaz!{"nukase wa shinai"}
Dialogue: 0,0:21:14.08,0:21:16.96,Default,,0,0,0,,Millet, Tsubasa dönmeden ilerleyin!
Dialogue: 0,0:21:16.96,0:21:18.13,Default,,0,0,0,,Bir gol daha!{tsuikaten, extra goal}
Dialogue: 0,0:21:19.13,0:21:20.00,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:21:20.00,0:21:21.38,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:21:21.38,0:21:22.76,Default,,0,0,0,,Millet geri dönün!
Dialogue: 0,0:21:23.38,0:21:24.59,Default,,0,0,0,,Roller değişti!{roles? what is "koushi"? missed it probably its a conjugative word, kou=attack= shi defense}{naruhodo. i miss kanji when i hear words like this}
Dialogue: 0,0:21:24.59,0:21:26.76,Default,,0,0,0,,Bu sefer Shutetsu karşı atak yapıyor!
Dialogue: 0,0:21:26.76,0:21:28.51,Default,,0,0,0,,Sanki izin veririm de!
Dialogue: 0,0:21:29.64,0:21:30.60,Default,,0,0,0,,Yoluma çıkıyorsun!
Dialogue: 0,0:21:30.60,0:21:32.18,Default,,0,0,0,,Kaybetmeyeceğim!
Dialogue: 0,0:21:32.93,0:21:36.02,Default,,0,0,0,,Önceki maçta o kadar\Nkolay geçmemize rağmen...{nah you didn't just easily beat them. you bodied them. you omega destroyed them. you... crushed them.}
Dialogue: 0,0:21:36.69,0:21:37.19,Default,,0,0,0,,Taki!
Dialogue: 0,0:21:38.36,0:21:39.36,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:21:39.36,0:21:40.57,Default,,0,0,0,,İşte bu, ikinci gol geliyor.{mega tsubasa toujou!}
Dialogue: 0,0:21:41.36,0:21:42.57,Default,,0,0,0,,{omae ha mou shindeiru}Ne?!
Dialogue: 0,0:21:42.57,0:21:45.20,Default,,0,0,0,,Tsubasa-kun, Taki-kun'dan topu alıyor!
Dialogue: 0,0:21:45.20,0:21:46.91,Default,,0,0,0,,Ne zaman geri döndü?!
Dialogue: 0,0:21:46.91,0:21:50.16,Default,,0,0,0,,Hadi Tsubasa-kun!
Dialogue: 0,0:21:50.16,0:21:51.66,Default,,0,0,0,,Çok hızlı.
Dialogue: 0,0:21:52.33,0:21:55.54,Default,,0,0,0,,Hızı bir yana ataktan savunmaya\Ngeçmesi de çok etkileyici.
Dialogue: 0,0:21:58.67,0:21:59.50,Default,,0,0,0,,Şut çekecek.
Dialogue: 0,0:21:59.50,0:22:00.67,Default,,0,0,0,,Şut çek!
Dialogue: 0,0:22:00.67,0:22:01.38,Default,,0,0,0,,Ne?!
Dialogue: 0,0:22:01.38,0:22:05.05,Default,,0,0,0,,Hala Nankatsu sahasında.
Dialogue: 0,0:22:06.13,0:22:08.22,Default,,0,0,0,,Y-Yoksa bu...
Dialogue: 0,0:22:08.22,0:22:12.06,Default,,0,0,0,,Tsubasa-kun kendi sahasından\Nuzun bir şut çekti!{ji jin, ji in jibun, their own side}
