Dialogue: 0,0:00:00.98,0:00:02.98,Default,,0,0,0,,{\i1}Kaptan Tsubasa'da önceki bölüm.{\i1}{\i0}
Dialogue: 0,0:00:03.73,0:00:06.98,Default,,0,0,0,,{\i1}Futbolu çok seven Ozora Tsubasa...{\i0}
Dialogue: 0,0:00:06.98,0:00:11.28,Default,,0,0,0,,{\i1}...yeni taşındığı şehirde, şans eseri\Nfutbol sahası üzerine bir kavgaya denk gelir.{\i0}
Dialogue: 0,0:00:11.28,0:00:14.70,Default,,0,0,0,,{\i1}Bu, Wakabayashi Genzo\Nve Ishizaki Ryo arasındadır.{\i0}
Dialogue: 0,0:00:14.70,0:00:18.95,Default,,0,0,0,,{\i1}Kendine güven dolu haliyle\Nhiç gol yemeyen Wakabayashi...{\i0}
Dialogue: 0,0:00:18.95,0:00:23.37,Default,,0,0,0,,{\i1}...Ishizaki'nin bir araya getirdiği\Nöğrencilerin tüm denemelerini boşa çıkarır.{\i0}
Dialogue: 0,0:00:24.33,0:00:27.09,Default,,0,0,0,,{\i1}Wakabayashi'nin ortaya koyduğu performans...{\i0}
Dialogue: 0,0:00:27.09,0:00:28.92,Default,,0,0,0,,{\i1}...Tsubasa'nın ilgisini çeker...{\i0}
Dialogue: 0,0:00:28.92,0:00:31.84,Default,,0,0,0,,{\i1}...ve ona meydan okur!{\i0}
Dialogue: 0,0:00:31.84,0:00:34.26,Default,,0,0,0,,{\i1}Wakabayashi, geldin iyi ki!{\i0}
Dialogue: 0,0:00:34.76,0:00:37.93,Default,,0,0,0,,{\i1}Sana meydan okuyan kişi bu işte!{\i0}
Dialogue: 0,0:00:38.56,0:00:39.76,Default,,0,0,0,,{\i1}Saçmalama be!{\i0}
Dialogue: 0,0:00:39.76,0:00:43.27,Default,,0,0,0,,{\i1}Onun gibi bir yerden bitme\No kadar güçlü tekme atamaz!{\i0}
Dialogue: 0,0:00:43.77,0:00:47.61,Default,,0,0,0,,{\i1}Doğru mu değil mi\Ncevabı şimdi göreceğiz!
Dialogue: 0,0:00:48.15,0:00:49.90,Default,,0,0,0,,{\i1}Al!{\i0}
Dialogue: 0,0:00:49.90,0:00:52.11,Default,,0,0,0,,{\i1}Dikkat et! Geliyor!{\i0}
Dialogue: 0,0:00:58.58,0:01:01.45,Default,,0,0,0,,{\i1}Kader miydi tesadüf mü?{\i0}
Dialogue: 0,0:01:01.45,0:01:07.46,Default,,0,0,0,,{\i1}Her halükarda Ozora Tsubasa ve\NWakabayashi Genzo karşılaşmıştı.{\i0}
Dialogue: 0,0:01:14.34,0:01:16.26,Default,,0,0,0,,Nasıl Wakabayashi?!
Dialogue: 0,0:01:16.26,0:01:18.76,Default,,0,0,0,,Onun gerçek gücünü gördün!
Dialogue: 0,0:01:20.85,0:01:23.35,Default,,0,0,0,,{\a6}{\i1}# Ozora Tsubasa müsabaka istiyor #{\i0}
Dialogue: 0,0:01:25.85,0:01:28.56,Default,,0,0,0,,Meydan okumamı kabul edecek misin?
Dialogue: 0,0:01:29.52,0:01:32.07,Default,,0,0,0,,Neden bana meydan okuyorsun?
Dialogue: 0,0:01:32.07,0:01:37.32,Default,,0,0,0,,Geçen gün ragbi ve beyzbol oyuncularının\Ntoplarını kurtardığını görmüş.
Dialogue: 0,0:01:38.28,0:01:40.49,Default,,0,0,0,,Demek öyle.
Dialogue: 0,0:01:40.49,0:01:42.04,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:01:42.45,0:01:43.58,Default,,0,0,0,,Siz miydiniz?
Dialogue: 0,0:01:43.58,0:01:44.95,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:01:44.95,0:01:47.37,Default,,0,0,0,,Eve dönmeyecek miydin?
Dialogue: 0,0:01:47.37,0:01:49.13,Default,,0,0,0,,Harika zamanlama.
Dialogue: 0,0:01:50.71,0:01:53.09,Default,,0,0,0,,O çocuk oldukça sert vuruyor.
Dialogue: 0,0:01:53.50,0:01:57.09,Default,,0,0,0,,Ama sadece bununla futbol\Noynayacağını sanması büyük hata.
Dialogue: 0,0:01:57.09,0:01:58.34,Default,,0,0,0,,Ne?!
Dialogue: 0,0:01:58.34,0:02:00.80,Default,,0,0,0,,Bana meydan okumak istiyorsan...
Dialogue: 0,0:02:01.76,0:02:04.18,Default,,0,0,0,,...hepsini tek başına geçmelisin!
Dialogue: 0,0:02:04.18,0:02:05.10,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:05.10,0:02:08.35,Default,,0,0,0,,Sadece o zaman meydan\Nokumanı kabul edeceğim!
Dialogue: 0,0:03:45.37,0:03:47.95,Default,,0,0,0,,{\a6\b1\fs60\pos(344,639)}Bölüm 2: Uçuyor!\NÇeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com{\b0}
Dialogue: 0,0:03:45.37,0:03:47.95,Default,,0,0,0,,{\an8}Kaptan, bu da ne demek?
Dialogue: 0,0:03:47.95,0:03:49.70,Default,,0,0,0,,Dediğim gibi.
Dialogue: 0,0:03:49.70,0:03:51.87,Default,,0,0,0,,Benim emirlerime uyacaksınız.
Dialogue: 0,0:03:51.87,0:03:53.92,Default,,0,0,0,,Tamam ama...
Dialogue: 0,0:03:53.92,0:03:56.04,Default,,0,0,0,,O cüce de kim?
Dialogue: 0,0:03:57.34,0:04:04.43,Default,,0,0,0,,{\a6} {\i1}# Ozora Tsubasa müsabaka istiyor #{\i0}
Dialogue: 0,0:03:57.71,0:03:59.42,Default,,0,0,0,,Bu da ne?
Dialogue: 0,0:03:59.42,0:04:04.43,Default,,0,0,0,,Bu topu evime çok uzak bir\Nmesafeden fırlattı.
Dialogue: 0,0:04:10.48,0:04:13.85,Default,,0,0,0,,Yani bu meydan okumayı\Nkabul mu edeceksin Kaptan?
Dialogue: 0,0:04:13.85,0:04:16.23,Default,,0,0,0,,Evet, aynen öyle.
Dialogue: 0,0:04:16.65,0:04:18.07,Default,,0,0,0,,Hey, Wakabayashi!
Dialogue: 0,0:04:18.07,0:04:21.24,Default,,0,0,0,,Tsubasa sana meydan okumak istiyor!
Dialogue: 0,0:04:21.24,0:04:24.20,Default,,0,0,0,,Tüm B takımını tek başına\Nalt etmesi çok saçma!
Dialogue: 0,0:04:24.20,0:04:27.12,Default,,0,0,0,,Yapmak istemiyorsa evine dönsün hemen.
Dialogue: 0,0:04:27.12,0:04:29.49,Default,,0,0,0,,Çok adisin Wakabayashi!
Dialogue: 0,0:04:29.49,0:04:31.04,Default,,0,0,0,,Yapacağım.
Dialogue: 0,0:04:31.04,0:04:34.21,Default,,0,0,0,,Ne?! Yapacak mısın?\NCiddi misin?
Dialogue: 0,0:04:34.21,0:04:36.58,Default,,0,0,0,,Çünkü meydan okumamı\Nkabul etmek üzere.
Dialogue: 0,0:04:36.58,0:04:40.00,Default,,0,0,0,,Dursana ama!\NO kadar kişiye karşı tek kişisin!
Dialogue: 0,0:04:41.34,0:04:45.18,Default,,0,0,0,,Ne olduğunu tam anlamadım\Nama eğlenceli duruyor.
Dialogue: 0,0:04:45.18,0:04:47.47,Default,,0,0,0,,Kaptan'a meydan okuyacak kadar yürekliymiş.
Dialogue: 0,0:04:47.47,0:04:50.27,Default,,0,0,0,,Daha baştan kaybetti.
Dialogue: 0,0:04:51.56,0:04:53.69,Default,,0,0,0,,Endişelenme. Bana bırak sen.
Dialogue: 0,0:04:53.69,0:04:54.56,Default,,0,0,0,,Ne?
Dialogue: 0,0:04:55.02,0:04:57.48,Default,,0,0,0,,Gerçekten tuhaf çocuk.
Dialogue: 0,0:05:09.78,0:05:11.16,Default,,0,0,0,,Hey, Tsubasa!
Dialogue: 0,0:05:12.12,0:05:14.04,Default,,0,0,0,,Şimdi fark ettim de...
Dialogue: 0,0:05:14.04,0:05:16.75,Default,,0,0,0,,...bu ayakkabılarla oynayabilir misin?
Dialogue: 0,0:05:19.63,0:05:22.67,Default,,0,0,0,,Evet. Şu an sadece yanımda bu var.
Dialogue: 0,0:05:22.67,0:05:25.13,Default,,0,0,0,,Ne? İmkansız bu.
Dialogue: 0,0:05:26.97,0:05:30.60,Default,,0,0,0,,B takımı olsalar da oldukça iyiler.
Dialogue: 0,0:05:30.60,0:05:34.31,Default,,0,0,0,,Ayrıca yalnızsın.\Nİki dezavantaj birden.
Dialogue: 0,0:05:34.31,0:05:37.15,Default,,0,0,0,,Kanatları kırık bir kuş gibisin.
Dialogue: 0,0:05:37.15,0:05:38.56,Default,,0,0,0,,Ama...
Dialogue: 0,0:05:38.56,0:05:42.19,Default,,0,0,0,,Fazla kramponu olan var mı?\NÖdünç versin.
Dialogue: 0,0:05:42.19,0:05:43.57,Default,,0,0,0,,T-Tamam.
Dialogue: 0,0:05:43.57,0:05:45.49,Default,,0,0,0,,Teşekkürler Wakabayashi-kun.
Dialogue: 0,0:05:45.49,0:05:47.11,Default,,0,0,0,,Teşekkürünü istemez.
Dialogue: 0,0:05:47.11,0:05:50.99,Default,,0,0,0,,Kaybedince krampona bağlama\Ndiye yapıyorum sadece.
Dialogue: 0,0:05:56.46,0:05:58.58,Default,,0,0,0,,Öyleyse meydan okuma vakti.
Dialogue: 0,0:06:05.42,0:06:08.93,Default,,0,0,0,,{\i1}O adamı bir yerde gördüğüme eminim.{\i0}
Dialogue: 0,0:06:09.59,0:06:11.22,Default,,0,0,0,,Halledebilecek mi acaba?
Dialogue: 0,0:06:15.85,0:06:17.44,Default,,0,0,0,,Görebiliyor musun?
Dialogue: 0,0:06:18.02,0:06:20.90,Default,,0,0,0,,Seni buraya getiren kişi.
Dialogue: 0,0:06:21.36,0:06:23.90,Default,,0,0,0,,Adı Wakabayashi-kun.
Dialogue: 0,0:06:23.90,0:06:26.65,Default,,0,0,0,,Yine topla konuşuyor.
Dialogue: 0,0:06:26.65,0:06:31.03,Default,,0,0,0,,Geçen seneki ulusal şampiyonayı\Ngol yemeden kazanmış.
Dialogue: 0,0:06:31.03,0:06:33.70,Default,,0,0,0,,Harika bir kaleci yani.
Dialogue: 0,0:06:34.54,0:06:37.25,Default,,0,0,0,,Ama önce diğer oyuncuları geçmeliyim ki...
Dialogue: 0,0:06:37.25,0:06:40.17,Default,,0,0,0,,...o kaleciye meydan okuyabileyim.
Dialogue: 0,0:06:40.17,0:06:42.42,Default,,0,0,0,,Ne zırvalıyor bu?
Dialogue: 0,0:06:42.42,0:06:44.34,Default,,0,0,0,,Topla konuşuyor.
Dialogue: 0,0:06:44.34,0:06:46.71,Default,,0,0,0,,Sıyırmış belli ki.
Dialogue: 0,0:06:47.38,0:06:51.84,Default,,0,0,0,,Çok küçükken hayatımı kurtarmıştın ama...
Dialogue: 0,0:06:51.84,0:06:53.97,Default,,0,0,0,,...sana yine ihtiyacım var.
Dialogue: 0,0:06:57.73,0:07:01.48,Default,,0,0,0,,Her pahasına ona\Nmeydan okumak istiyorum.
Dialogue: 0,0:07:03.48,0:07:05.28,Default,,0,0,0,,Ne bekliyorsunuz be?!
Dialogue: 0,0:07:05.28,0:07:07.24,Default,,0,0,0,,Acele edin de topu alın!
Dialogue: 0,0:07:07.24,0:07:08.78,Default,,0,0,0,,T-Tamam!
Dialogue: 0,0:07:08.78,0:07:09.95,Default,,0,0,0,,Pekala, gidelim!
Dialogue: 0,0:07:09.95,0:07:10.74,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:12.45,0:07:13.87,Default,,0,0,0,,Hazır mısın?
Dialogue: 0,0:07:13.87,0:07:14.78,Default,,0,0,0,,Gidelim.
Dialogue: 0,0:07:14.78,0:07:15.70,Default,,0,0,0,,Hadi!
Dialogue: 0,0:07:23.46,0:07:24.34,Default,,0,0,0,,Ne?
Dialogue: 0,0:07:27.01,0:07:29.05,Default,,0,0,0,,Anında üç kişiyi geçti!
Dialogue: 0,0:07:47.78,0:07:49.57,Default,,0,0,0,,{\i1}Bu da ne böyle?{\i0}
Dialogue: 0,0:07:49.57,0:07:52.28,Default,,0,0,0,,{\i1}Otobüsün altından şut çekmesi...{\i0}
Dialogue: 0,0:07:52.28,0:07:54.49,Default,,0,0,0,,{\i1}Bu çalımlar...{\i0}
Dialogue: 0,0:07:54.49,0:07:57.37,Default,,0,0,0,,{\i1}Bu çocuk genç yaşına rağmen...{\i0}
Dialogue: 0,0:07:57.37,0:07:59.50,Default,,0,0,0,,{\i1}...topla arkadaş olmuş bile!{\i0}
Dialogue: 0,0:08:00.29,0:08:01.71,Default,,0,0,0,,{\i1}Hiç şüphe yok.{\i0}
Dialogue: 0,0:08:01.71,0:08:03.67,Default,,0,0,0,,{\i1}Bu çocuk...{\i0}
Dialogue: 0,0:08:03.67,0:08:05.34,Default,,0,0,0,,{\i1}İşte o çocuk!{\i0}
Dialogue: 0,0:08:05.34,0:08:07.59,Default,,0,0,0,,Hadi Tsubasa!
Dialogue: 0,0:08:10.47,0:08:12.22,Default,,0,0,0,,Ulan...
Dialogue: 0,0:08:12.22,0:08:15.22,Default,,0,0,0,,Şut çekmesine izin vermeyin!\NÖnünü kapatın!
Dialogue: 0,0:08:21.94,0:08:23.60,Default,,0,0,0,,Uçuyor!
Dialogue: 0,0:08:24.35,0:08:25.36,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:34.99,0:08:36.24,Default,,0,0,0,,Gir!
Dialogue: 0,0:08:40.75,0:08:42.62,Default,,0,0,0,,Top hala oyunda!
Dialogue: 0,0:08:45.25,0:08:47.54,Default,,0,0,0,,Biraz israf olacak ama...
Dialogue: 0,0:08:47.54,0:08:50.26,Default,,0,0,0,,...bu mücadeleye biraz viskiye değer!
Dialogue: 0,0:08:55.26,0:08:57.64,Default,,0,0,0,,Biliyordum, o adam...
Dialogue: 0,0:08:57.64,0:09:00.39,Default,,0,0,0,,...Brezilya milli takımının forveti...
Dialogue: 0,0:09:00.39,0:09:02.06,Default,,0,0,0,,...Roberto Hongo!
Dialogue: 0,0:09:02.06,0:09:04.60,Default,,0,0,0,,Ortayı tamamla!
Dialogue: 0,0:09:14.57,0:09:17.82,Default,,0,0,0,,{\i1}This was how the first challenge between{\i0}
Dialogue: 0,0:09:17.82,0:09:22.37,Default,,0,0,0,,{\i1}...Ozora Tsubasa ve Wakabayashi Genzo'nun\Nilk karşı karşıya gelişiydi.{\i0}
Dialogue: 0,0:09:22.37,0:09:24.66,Default,,0,0,0,,{\i1}Kimse bunun daha sonradan...{\i0}
Dialogue: 0,0:09:24.66,0:09:30.96,Default,,0,0,0,,{\i1}...Japon futbolunu muazzam derecede\Niyi bir yere getireceğini bilemezdi!
Dialogue: 0,0:09:45.69,0:09:47.73,Default,,0,0,0,,İşte bu! Gol!
Dialogue: 0,0:10:04.37,0:10:05.04,Default,,0,0,0,,Genzo!
Dialogue: 0,0:10:05.04,0:10:06.79,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:10:06.79,0:10:07.54,Default,,0,0,0,,Kendine gel.
Dialogue: 0,0:10:07.54,0:10:09.13,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:10:11.84,0:10:12.63,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:10:12.63,0:10:13.68,Default,,0,0,0,,Dokunma!
Dialogue: 0,0:10:13.84,0:10:15.59,Default,,0,0,0,,Neyin var Wakabayashi?!
Dialogue: 0,0:10:15.59,0:10:17.30,Default,,0,0,0,,Kes be!
Dialogue: 0,0:10:26.43,0:10:27.94,Default,,0,0,0,,Hey, kanıyor.
Dialogue: 0,0:10:29.19,0:10:31.19,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:10:31.19,0:10:32.69,Default,,0,0,0,,Genzo!
Dialogue: 0,0:10:34.15,0:10:36.11,Default,,0,0,0,,{\i1}Kaybettim.{\i0}
Dialogue: 0,0:10:36.11,0:10:39.16,Default,,0,0,0,,{\i1}Bu cüceye kaybettim.{\i0}
Dialogue: 0,0:10:41.37,0:10:43.87,Default,,0,0,0,,Ozora Tsubasa değil mi?
Dialogue: 0,0:10:43.87,0:10:44.62,Default,,0,0,0,,Evet.
Dialogue: 0,0:10:45.33,0:10:46.50,Default,,0,0,0,,Maç.
Dialogue: 0,0:10:46.50,0:10:47.54,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:47.54,0:10:50.29,Default,,0,0,0,,Maç yapacağız be maç!
Dialogue: 0,0:10:51.25,0:10:55.30,Default,,0,0,0,,Bu meydan okumaya böyle karar verilemez!
Dialogue: 0,0:10:55.30,0:10:57.42,Default,,0,0,0,,Sadece bir maç karar verebilir!
Dialogue: 0,0:10:57.42,0:11:00.64,Default,,0,0,0,,Meydan okumanı okullar arası\Nturnuvada kabul edeceğim!
Dialogue: 0,0:11:00.64,0:11:01.97,Default,,0,0,0,,Okullar arası mı?
Dialogue: 0,0:11:02.93,0:11:04.39,Default,,0,0,0,,Dur Wakabayashi!
Dialogue: 0,0:11:06.81,0:11:07.89,Default,,0,0,0,,Dinle!
Dialogue: 0,0:11:07.89,0:11:10.90,Default,,0,0,0,,Okullar arası turnuvada\Nbir gol bile atarsan...
Dialogue: 0,0:11:10.90,0:11:13.65,Default,,0,0,0,,...yenildiğimi kabul edeceğim.
Dialogue: 0,0:11:14.90,0:11:16.48,Default,,0,0,0,,Pekala, anladım.
Dialogue: 0,0:11:16.48,0:11:19.28,Default,,0,0,0,,Maçı kimin kazandığı önemsiz.
Dialogue: 0,0:11:19.28,0:11:22.91,Default,,0,0,0,,Bana gol atabilecek misin göreceğiz!
Dialogue: 0,0:11:23.70,0:11:32.10,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:11:40.55,0:11:42.01,Default,,0,0,0,,Ishizaki.
Dialogue: 0,0:11:42.01,0:11:45.05,Default,,0,0,0,,Okullar arası turnuvaya kadar\Nbu sahayı kullanın.
Dialogue: 0,0:11:46.10,0:11:47.93,Default,,0,0,0,,Biraz antrenman yapın da...
Dialogue: 0,0:11:47.93,0:11:50.56,Default,,0,0,0,,...paslanmış olmasın.
Dialogue: 0,0:11:51.81,0:11:52.94,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:11:52.94,0:11:54.06,Default,,0,0,0,,Baş üstüne!
Dialogue: 0,0:11:54.94,0:11:56.44,Default,,0,0,0,,Hey, bekle!
Dialogue: 0,0:11:57.57,0:11:59.57,Default,,0,0,0,,Kramponlar var, kramponlar.
Dialogue: 0,0:11:59.57,0:12:01.11,Default,,0,0,0,,D-Doğru ya...
Dialogue: 0,0:12:01.11,0:12:01.91,Default,,0,0,0,,İstemez!
Dialogue: 0,0:12:06.24,0:12:07.87,Default,,0,0,0,,Kramponlar için teşekkürler.
Dialogue: 0,0:12:07.87,0:12:10.12,Default,,0,0,0,,Bir şey değil.
Dialogue: 0,0:12:10.12,0:12:12.92,Default,,0,0,0,,Okullar arası turnuvada görüşürüz!
Dialogue: 0,0:12:21.17,0:12:25.05,Default,,0,0,0,,Wakabayashi fena çıldırdı ha.
Dialogue: 0,0:12:25.05,0:12:28.31,Default,,0,0,0,,Sana vuracağını sanmıştım.
Dialogue: 0,0:12:28.31,0:12:31.98,Default,,0,0,0,,Ama gol atman çok iyiydi harbiden.
Dialogue: 0,0:12:31.98,0:12:32.94,Default,,0,0,0,,Teşekkürler.
Dialogue: 0,0:12:33.77,0:12:35.36,Default,,0,0,0,,İçeri girmeyi başardın.
Dialogue: 0,0:12:38.07,0:12:39.48,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:12:39.48,0:12:39.90,Default,,0,0,0,,İşte.
Dialogue: 0,0:12:42.07,0:12:43.45,Default,,0,0,0,,Üzgünüm.
Dialogue: 0,0:12:44.70,0:12:48.58,Default,,0,0,0,,Öyle durmasam da\NNankatsu futbol takımının kaptanıyım ben.
Dialogue: 0,0:12:49.37,0:12:50.83,Default,,0,0,0,,Ishizaki-kun, pas ver!
Dialogue: 0,0:12:52.83,0:12:53.96,Default,,0,0,0,,Tamam!
Dialogue: 0,0:12:55.08,0:12:57.92,Default,,0,0,0,,Gelecek sefere seni takımla tanıştırayım.
Dialogue: 0,0:12:57.92,0:13:00.17,Default,,0,0,0,,Tamam, teşekkürler.
Dialogue: 0,0:13:00.17,0:13:03.38,Default,,0,0,0,,Bu arada az önce konuşulan\Nokullar arası turnuva ne?
Dialogue: 0,0:13:03.84,0:13:06.18,Default,,0,0,0,,O konu mu?
Dialogue: 0,0:13:06.18,0:13:11.02,Default,,0,0,0,,İlk olarak Nankatsu ve Shutetsu'nun\Nrakip olduğunu unutma!
Dialogue: 0,0:13:11.02,0:13:11.89,Default,,0,0,0,,Rakip mi?
Dialogue: 0,0:13:11.89,0:13:14.52,Default,,0,0,0,,Evet. Adi Shutetsu!
Dialogue: 0,0:13:15.77,0:13:19.65,Default,,0,0,0,,Futbol takımları çok iyidir.{famous}
Dialogue: 0,0:13:19.65,0:13:22.24,Default,,0,0,0,,Tüm iyi oyuncular onlardayken...
Dialogue: 0,0:13:22.24,0:13:24.28,Default,,0,0,0,,...bizde sadece kötüler var!
Dialogue: 0,0:13:27.66,0:13:32.41,Default,,0,0,0,,Nankatsu ve Shutetsu arasında\Nsadece mücadele vardır!
Dialogue: 0,0:13:33.08,0:13:35.67,Default,,0,0,0,,Bugünkü futbol sahası meselesi...
Dialogue: 0,0:13:35.67,0:13:38.25,Default,,0,0,0,,...bu mücadelelerden birisi sadece.
Dialogue: 0,0:13:38.25,0:13:41.67,Default,,0,0,0,,Sen sahayı paylaşabileceğimizi\Nsöyledin ama...
Dialogue: 0,0:13:41.67,0:13:43.67,Default,,0,0,0,,...asıl mesele bu değil işte!
Dialogue: 0,0:13:45.84,0:13:47.76,Default,,0,0,0,,Aynen öyle duruyor.
Dialogue: 0,0:13:47.76,0:13:51.01,Default,,0,0,0,,Okullar arası turnuva ise...
Dialogue: 0,0:13:51.51,0:13:54.27,Default,,0,0,0,,...Nankatsu ve Shutetsu'nun\Ntüm spor kulüpleri arasındaki...
Dialogue: 0,0:13:54.27,0:13:57.85,Default,,0,0,0,,...her yıl yapılan bir mücadeledir.
Dialogue: 0,0:13:57.85,0:14:00.36,Default,,0,0,0,,Festival gibidir.
Dialogue: 0,0:14:00.36,0:14:04.44,Default,,0,0,0,,Bu şehirde spor festivalinden\Ndaha önemli bir konudur bu!
Dialogue: 0,0:14:04.78,0:14:06.65,Default,,0,0,0,,Ne? Harikaymış.
Dialogue: 0,0:14:06.65,0:14:12.95,Default,,0,0,0,,Tüm kulüplerimiz Shutetsu'nunki\Nkadar iyidir. Sadece futbol hariç.
Dialogue: 0,0:14:13.79,0:14:19.50,Default,,0,0,0,,Bu yüzden diğer kulüplere\Nyük oluyoruz her zaman.
Dialogue: 0,0:14:20.50,0:14:26.88,Default,,0,0,0,,Ama sen takımdayken Shutetsu'ya karşı\Nkesinlikle iyi bir gösteri ortaya koyarız!
Dialogue: 0,0:14:26.88,0:14:28.05,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:32.97,0:14:33.68,Default,,0,0,0,,İşte!
Dialogue: 0,0:14:34.39,0:14:35.93,Default,,0,0,0,,Of, kaçırdım!
Dialogue: 0,0:14:41.02,0:14:43.27,Default,,0,0,0,,Az önce için teşekkürler.
Dialogue: 0,0:14:43.27,0:14:46.19,Default,,0,0,0,,Ne? Lafını etmeye değmez.
Dialogue: 0,0:14:46.65,0:14:49.36,Default,,0,0,0,,Bana güzel bir teklif sundun.
Dialogue: 0,0:14:50.91,0:14:52.78,Default,,0,0,0,,Ozora Tsubasa-kun.
Dialogue: 0,0:14:54.08,0:14:56.29,Default,,0,0,0,,Ben Roberto Hongo.{a.k.a. Mr. Lovemaker}
Dialogue: 0,0:14:56.29,0:14:57.37,Default,,0,0,0,,Memnun oldum.
Dialogue: 0,0:14:58.99,0:15:00.56,Default,,0,0,0,,Roberto Hongo!
Dialogue: 0,0:15:00.76,0:15:04.09,Default,,0,0,0,,Seni tanıyorum!\NDefalarca maçlarını izledim!
Dialogue: 0,0:15:05.21,0:15:06.59,Default,,0,0,0,,Teşekkürler!
Dialogue: 0,0:15:06.59,0:15:08.97,Default,,0,0,0,,Ben de seninle tanıştığıma\Nçok memnun oldum.
Dialogue: 0,0:15:08.97,0:15:11.72,Default,,0,0,0,,Alkol kokuyor! Sarhoşun teki be bu!
Dialogue: 0,0:15:11.72,0:15:14.31,Default,,0,0,0,,Merhaba. Tsubasa'nın arkadaşı mısın sen?
Dialogue: 0,0:15:14.31,0:15:15.06,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:15.06,0:15:17.81,Default,,0,0,0,,Ben Roberto Hongo.\NMemnun oldum.
Dialogue: 0,0:15:17.81,0:15:18.98,Default,,0,0,0,,Memnun oldum.
Dialogue: 0,0:15:18.98,0:15:21.65,Default,,0,0,0,,Sen de futbolu sever misin?
Dialogue: 0,0:15:21.65,0:15:23.44,Default,,0,0,0,,Evet, severim ama...
Dialogue: 0,0:15:23.44,0:15:24.73,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:15:26.19,0:15:28.11,Default,,0,0,0,,Ben futbola bayılırım!
Dialogue: 0,0:15:28.86,0:15:31.24,Default,,0,0,0,,Sıyırmış belli ki.
Dialogue: 0,0:15:32.16,0:15:37.25,Default,,0,0,0,,Okullar arası turnuvaya kadar\Nkoçluk yapmama ne dersiniz?
Dialogue: 0,0:15:38.20,0:15:41.50,Default,,0,0,0,,Bizim takıma bir sarhoş mu koçluk yapacak?!
Dialogue: 0,0:15:41.50,0:15:44.84,Default,,0,0,0,,Aynen öyle.\NSumo kulübüne koç olacak değilim ya.
Dialogue: 0,0:15:44.84,0:15:45.84,Default,,0,0,0,,Bekle bakalım!
Dialogue: 0,0:15:45.84,0:15:49.51,Default,,0,0,0,,İlkokul kulübüyüz diye\Nhafife alma bizi!
Dialogue: 0,0:15:49.51,0:15:52.68,Default,,0,0,0,,Bir tane orta açtın diye\Nkendini bir halt sanma!
Dialogue: 0,0:15:52.68,0:15:54.85,Default,,0,0,0,,Herkes yapar onu!
Dialogue: 0,0:15:54.85,0:15:58.60,Default,,0,0,0,,Hey, hey. Bu kalp kırıcı ama bak.
Dialogue: 0,0:15:58.60,0:16:01.35,Default,,0,0,0,,Neye gülüyorsun be?!\NTadım kaçtı.
Dialogue: 0,0:16:01.35,0:16:05.19,Default,,0,0,0,,Ayrıca kimse bir sarhoşu\Nkoç olarak istemez.
Dialogue: 0,0:16:06.23,0:16:07.40,Default,,0,0,0,,Öyleyse...
Dialogue: 0,0:16:07.40,0:16:09.03,Default,,0,0,0,,...sana göstereyim.
Dialogue: 0,0:16:14.28,0:16:16.58,Default,,0,0,0,,{\i1}Topu kolayca aldı.{\i0}
Dialogue: 0,0:16:33.30,0:16:34.80,Default,,0,0,0,,Ne yapıyor bu?
Dialogue: 0,0:16:41.98,0:16:42.94,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:16:47.52,0:16:49.61,Default,,0,0,0,,Ne? Girmedi bile!
Dialogue: 0,0:16:59.58,0:17:01.08,Default,,0,0,0,,Ne?!
Dialogue: 0,0:17:08.55,0:17:09.92,Default,,0,0,0,,İşte bu.
Dialogue: 0,0:17:09.92,0:17:11.30,Default,,0,0,0,,Mükemmel!
Dialogue: 0,0:17:11.30,0:17:13.42,Default,,0,0,0,,H-Harika!
Dialogue: 0,0:17:13.42,0:17:16.47,Default,,0,0,0,,Ne oldu?\NKoç olarak istiyor musun?
Dialogue: 0,0:17:16.47,0:17:18.81,Default,,0,0,0,,İstiyorum, istiyorum tabii!
Dialogue: 0,0:17:20.60,0:17:22.93,Default,,0,0,0,,Tabii ki! Sana emanetiz.\NDeğil mi Tsubasa?
Dialogue: 0,0:17:24.85,0:17:25.69,Default,,0,0,0,,Ne?
Dialogue: 0,0:17:25.69,0:17:27.19,Default,,0,0,0,,İşte!
Dialogue: 0,0:17:29.23,0:17:30.19,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:34.45,0:17:35.57,Default,,0,0,0,,Yoksa...
Dialogue: 0,0:17:45.50,0:17:46.71,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:48.46,0:17:50.50,Default,,0,0,0,,Hey, iyi misin?
Dialogue: 0,0:17:51.46,0:17:53.26,Default,,0,0,0,,Zormuş bu ya.
Dialogue: 0,0:17:53.26,0:17:56.80,Default,,0,0,0,,Yine de bayağı iyi zıplıyorsun ama ha.
Dialogue: 0,0:17:56.80,0:18:00.14,Default,,0,0,0,,Aynen öyle.\NSenden iyi beklentilerim var Tsubasa.
Dialogue: 0,0:18:00.14,0:18:01.31,Default,,0,0,0,,Gerçekten mi?
Dialogue: 0,0:18:01.31,0:18:02.31,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:05.64,0:18:07.48,Default,,0,0,0,,Tamam, bir kez daha.
Dialogue: 0,0:18:07.48,0:18:09.81,Default,,0,0,0,,O kadar çabuk yapamazsın ki!
Dialogue: 0,0:18:09.81,0:18:11.69,Default,,0,0,0,,Yapabilirim!
Dialogue: 0,0:18:11.69,0:18:13.32,Default,,0,0,0,,Ne?
Dialogue: 0,0:18:15.07,0:18:19.20,Default,,0,0,0,,{\i1}Hareketimi daha yeni gördü\Nama hemen deniyor.{\i0}
Dialogue: 0,0:18:21.20,0:18:23.24,Default,,0,0,0,,{\i1}Çabucak gelişmesine şaşmamalı.{\i0}
Dialogue: 0,0:18:27.12,0:18:31.96,Default,,0,0,0,,{\i1}Gördüğü tüm teknikleri\Nyapmayı kafasına koymuş birisi.{\i0}
Dialogue: 0,0:18:32.84,0:18:34.01,Default,,0,0,0,,Ne?
Dialogue: 0,0:18:36.55,0:18:37.93,Default,,0,0,0,,Kaçırdı...
Dialogue: 0,0:18:39.22,0:18:40.89,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:18:40.89,0:18:43.93,Default,,0,0,0,,Tam babasına çekmiş.
Dialogue: 0,0:18:43.93,0:18:46.27,Default,,0,0,0,,Değil mi Ozora Kaptan?
Dialogue: 0,0:18:52.69,0:18:58.20,Default,,0,0,0,,{\i1}{\a6}{\i1}Natsuko:\NTsubasa kaçtı!{\i0}
Dialogue: 0,0:18:54.57,0:19:02.16,Default,,0,0,0,,Düşündüğüm gibi benim\Nküçük futbolcu işi asmış gene.
Dialogue: 0,0:19:02.16,0:19:05.04,Default,,0,0,0,,Tam Tsubasa'ya yakışır bir hareket gerçi.
Dialogue: 0,0:19:05.04,0:19:05.70,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:19:07.21,0:19:09.04,Default,,0,0,0,,Demek buradaydınız.
Dialogue: 0,0:19:09.54,0:19:11.42,Default,,0,0,0,,Japonya'ya yaklaşıyoruz.
Dialogue: 0,0:19:11.42,0:19:14.84,Default,,0,0,0,,Evet, sonunda eve gidebileceğim.
Dialogue: 0,0:19:14.84,0:19:18.26,Default,,0,0,0,,Bu arada oğlunuz kaç yaşına bastı?
Dialogue: 0,0:19:18.26,0:19:21.39,Default,,0,0,0,,Bu sene 10 yaşına bastı ve\Nilkokul son sınıfta.
Dialogue: 0,0:19:21.39,0:19:23.30,Default,,0,0,0,,10 yaşına mı bastı?
Dialogue: 0,0:19:23.30,0:19:28.06,Default,,0,0,0,,Öyleyse bu sefer gezi hediyesi\Nolarak oyun mu alacaksınız?
Dialogue: 0,0:19:28.06,0:19:30.94,Default,,0,0,0,,Hayır, hediyesini aldı bile.
Dialogue: 0,0:19:33.11,0:19:36.03,Default,,0,0,0,,Ayrıca düşünülebilecek en güzel şey.
Dialogue: 0,0:19:46.14,0:19:46.84,Default,,0,0,0,,İşte...
Dialogue: 0,0:19:55.59,0:19:58.80,Default,,0,0,0,,Of... Yer, gökyüzü birbirine girdi.
Dialogue: 0,0:19:59.72,0:20:01.59,Default,,0,0,0,,Başım dönüyor...
Dialogue: 0,0:20:01.59,0:20:03.43,Default,,0,0,0,,Hey Tsubasa.
Dialogue: 0,0:20:03.43,0:20:07.43,Default,,0,0,0,,Senin için bile bu çok hızlı.
Dialogue: 0,0:20:07.43,0:20:08.93,Default,,0,0,0,,Hiç de değil!
Dialogue: 0,0:20:13.35,0:20:15.86,Default,,0,0,0,,Ama birazdan hava kararacak.
Dialogue: 0,0:20:15.86,0:20:18.03,Default,,0,0,0,,Eve dönme vakti geliyor.
Dialogue: 0,0:20:18.03,0:20:19.86,Default,,0,0,0,,Ayrıca kurt gibi acıktım.
Dialogue: 0,0:20:20.70,0:20:21.86,Default,,0,0,0,,Daha değil!
Dialogue: 0,0:20:28.37,0:20:30.75,Default,,0,0,0,,{\i1}Roberto beklentilerinin yüksek\Nolduğunu söyledi.{\i0}
Dialogue: 0,0:20:34.17,0:20:36.04,Default,,0,0,0,,{\i1}Bunu yapmaktan başka şansımız yok.{\i0}
Dialogue: 0,0:20:42.47,0:20:46.14,Default,,0,0,0,,{\i1}Daha röveşata atamasa bile...{\i0}
Dialogue: 0,0:20:46.14,0:20:50.23,Default,,0,0,0,,{\i1}...her denemede direğe vurabiliyor.{\i0}
Dialogue: 0,0:20:50.85,0:20:52.89,Default,,0,0,0,,{\i1}Harika kontrol ediyor.{\i0}
Dialogue: 0,0:20:53.94,0:20:56.69,Default,,0,0,0,,{\a6}{\i1}# Ozora Tsubasa müsabaka istiyor #{\i0}
Dialogue: 0,0:21:02.40,0:21:05.03,Default,,0,0,0,,{\i1}İyice bak.{\i0}
Dialogue: 0,0:21:06.78,0:21:09.41,Default,,0,0,0,,{\i1}Evet, o kaleye!{\i0}
Dialogue: 0,0:21:11.16,0:21:14.42,Default,,0,0,0,,{\i1}Orası bizim hedefimiz!{\i0}
Dialogue: 0,0:21:14.92,0:21:16.63,Default,,0,0,0,,{\i1}Bu kez atacağız!{\i0}
Dialogue: 0,0:21:18.09,0:21:19.59,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:21:34.19,0:21:36.35,Default,,0,0,0,,Gir!
Dialogue: 0,0:21:39.61,0:21:41.44,Default,,0,0,0,,Girdi!
Dialogue: 0,0:21:43.19,0:21:44.82,Default,,0,0,0,,İnanılmaz!
Dialogue: 0,0:21:46.11,0:21:47.20,Default,,0,0,0,,Başardım.
Dialogue: 0,0:21:49.91,0:21:51.70,Default,,0,0,0,,Başardım!
Dialogue: 0,0:21:52.16,0:21:54.04,Default,,0,0,0,,Başardın Tsubasa!
Dialogue: 0,0:21:54.04,0:21:56.46,Default,,0,0,0,,Sonunda röveşata attın!
Dialogue: 0,0:21:56.46,0:21:57.29,Default,,0,0,0,,Evet!
Dialogue: 0,0:21:57.46,0:21:59.42,Default,,0,0,0,,{\i0}Çok yaşa{\i1} Tsubasa!{\i0}
Dialogue: 0,0:22:06.26,0:22:08.72,Default,,0,0,0,,İnanılmazsın Tsubasa!
Dialogue: 0,0:22:10.68,0:22:13.89,Default,,0,0,0,,{\i1}Mucize çocuk! Harika çocuk!{\i0}
Dialogue: 0,0:22:15.35,0:22:17.65,Default,,0,0,0,,Brezilyalı duygu ifadesi...
Dialogue: 0,0:22:19.06,0:22:25.31,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
