Dialogue: 0,0:14:12.98,0:14:18.00,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:02.91,0:00:05.98,Default,,0,0,0,,{\i1}Hyuga-kun ceza sahası\Ndışından uzun bir şut çekiyor!{\i0}
Dialogue: 0,0:00:07.08,0:00:10.15,Default,,0,0,0,,Tsubasa bile ceza sahası\Ndışından gol atamadı ona.
Dialogue: 0,0:00:10.15,0:00:13.24,Default,,0,0,0,,Senin için imkansız anlayacağın!
Dialogue: 0,0:00:13.24,0:00:14.70,Default,,0,0,0,,{\i1}Tsubasa bile mi?{\i0}
Dialogue: 0,0:00:19.10,0:00:20.20,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:00:20.20,0:00:20.91,Default,,0,0,0,,{\i1}Kaptan...{\i0}
Dialogue: 0,0:00:20.91,0:00:24.04,Default,,0,0,0,,{\i1}Neden ceza sahası dışından\Nvurmaya bu kadar taktın?{\i0}
Dialogue: 0,0:00:24.52,0:00:25.70,Default,,0,0,0,,Hyuga-san.
Dialogue: 0,0:00:25.70,0:00:30.09,Default,,0,0,0,,Açık konuşacağım. Bugün oynadığın\Nfutbol, Meiwa futbolu değildi.
Dialogue: 0,0:00:30.09,0:00:31.42,Default,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:00:31.42,0:00:35.06,Default,,0,0,0,,Meiwa futbolu ne olursa olsun\Nkazanmaya dayalı bir futboldur.
Dialogue: 0,0:00:35.06,0:00:39.80,Default,,0,0,0,,Yine de bugünkü Hyuga-san sadece\Nceza sahasından şut çekti durdu.
Dialogue: 0,0:00:39.80,0:00:42.10,Default,,0,0,0,,Kesinlikle Meiwa futbolu değildi!
Dialogue: 0,0:00:44.71,0:00:45.98,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:00:46.54,0:00:47.77,Default,,0,0,0,,Takeshi...
Dialogue: 0,0:00:48.94,0:00:50.88,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:00:52.31,0:00:57.15,Default,,0,0,0,,Açıkçası bu maç, Toho\NAkademisi'ne girip girmememi bağlıyor.
Dialogue: 0,0:00:57.15,0:01:01.28,Default,,0,0,0,,Ama bu sırada Ozora Tsubasa'yı da\Nizlediklerini söyledikler.
Dialogue: 0,0:01:02.13,0:01:05.44,Default,,0,0,0,,Bu yüzden Tsubasa'dan\Ndaha iyi olduğumu kanıtlamak için...
Dialogue: 0,0:01:05.44,0:01:08.87,Default,,0,0,0,,...ceza sahası dışından\Nşut çekip durdum.
Dialogue: 0,0:01:08.87,0:01:12.06,Default,,0,0,0,,Ama bu bir hataydı.
Dialogue: 0,0:01:12.06,0:01:14.86,Default,,0,0,0,,Takeshi söylediğinde fark ettim.
Dialogue: 0,0:01:14.86,0:01:16.13,Default,,0,0,0,,Hyuga-san...
Dialogue: 0,0:01:16.92,0:01:21.07,Default,,0,0,0,,İkinci yarıda ne pahasına olursa\Nolsun Wakabayashi'ye gol atacağım!
Dialogue: 0,0:01:21.07,0:01:23.85,Default,,0,0,0,,Meiwa'nın kazanmaya dayalı futbolu budur!
Dialogue: 0,0:01:23.85,0:01:26.27,Default,,0,0,0,,Durumu tersine çevireceğiz kesinlikle!
Dialogue: 0,0:01:26.27,0:01:27.56,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:01:27.56,0:01:28.50,Default,,0,0,0,,Aynen öyle!
Dialogue: 0,0:01:28.50,0:01:30.02,Default,,0,0,0,,Yapalım şunu Hyuga-san!
Dialogue: 0,0:01:31.43,0:01:35.23,Default,,0,0,0,,{\i1}Devre arası bitti ve iki takımın\Noyuncuları da sahaya çıktı.{\i0}
Dialogue: 0,0:01:35.23,0:01:37.80,Default,,0,0,0,,{\i1}Sadece 20 dakika kaldı.{\i0}
Dialogue: 0,0:01:37.80,0:01:39.61,Default - Top,,0,0,0,,{\an8}Anne! Acele et!
Dialogue: 0,0:01:39.61,0:01:40.53,Default - Top,,0,0,0,,{\an8}Tamam, tamam.
Dialogue: 0,0:01:38.74,0:01:40.53,Default,,0,0,0,,{\i1}Nankatsu bir gol önde.{\i0}
Dialogue: 0,0:01:40.53,0:01:44.41,Default,,0,0,0,,{\i1}Böyle devam edip mor şampiyonluk\Nflamasını elde edebilecekler mi?{\i0}
Dialogue: 0,0:01:44.41,0:01:49.21,Default,,0,0,0,,{\i1}Yoksa Meiwa ikinci yarıda durumu\Ntersine çevirip şampiyon mu olacak?{\i0}
Dialogue: 0,0:01:49.21,0:01:52.04,Default,,0,0,0,,{\i1}Top vuruşu vakti geldi.{\i0}
Dialogue: 0,0:03:23.72,0:03:28.05,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}Bölüm 24:\NSabır, Mutlak Sabır
Dialogue: 0,0:03:23.72,0:03:28.05,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs50\pos(1536,1018.333)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:03:22.68,0:03:26.30,Default - Top,,0,0,0,,{\i1}İkinci yarı, Nankatsu'nun\Ntop vuruşuyla başlayacak.{\i0}
Dialogue: 0,0:03:28.35,0:03:29.72,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:03:29.72,0:03:34.06,Default,,0,0,0,,İkinci yarıda Meiwa'nın\Ngerçek futbolunu gösterelim!
Dialogue: 0,0:03:34.06,0:03:35.56,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:35.56,0:03:39.20,Default,,0,0,0,,Gidin! Meiwa'nın yıldırım\Nkayarak müdahalesi!
Dialogue: 0,0:03:42.30,0:03:47.78,Default,,0,0,0,,{\i1}Meiwa oyuncuların oyun başlar başlamaz\NTsubasa-kun ve Misaki-kun üzerine çullanıyor!{\i0}
Dialogue: 0,0:03:52.26,0:03:55.79,Default,,0,0,0,,{\i1}Tsubasa-kun ve Misaki-kun\Nonlardan zor sakınıyor!{\i0}
Dialogue: 0,0:03:55.79,0:03:57.38,Default,,0,0,0,,Tamamdır! Hadi Meiwa!
Dialogue: 0,0:03:57.38,0:03:59.04,Default,,0,0,0,,İşte böyle!
Dialogue: 0,0:04:02.60,0:04:03.51,Default,,0,0,0,,{\i1}Tsubasa...{\i0}
Dialogue: 0,0:04:04.06,0:04:06.38,Default,,0,0,0,,Onları ikiye bölseniz bile umurumda değil!
Dialogue: 0,0:04:06.38,0:04:07.94,Default,,0,0,0,,Sadece bastırın!
Dialogue: 0,0:04:07.94,0:04:11.22,Default,,0,0,0,,Daha hızlı! Topun olduğu yere dalın!
Dialogue: 0,0:04:14.81,0:04:18.56,Default,,0,0,0,,{\i1}Oyuncular kaydıktan sonra ellerini\Nkullanıp dönerek tekrar kayıyorlar!{\i0}
Dialogue: 0,0:04:18.56,0:04:21.03,Default,,0,0,0,,{\i1}Çok harika bir müdahale şekli!{\i0}
Dialogue: 0,0:04:21.03,0:04:23.86,Default,,0,0,0,,{\i1}Tsubasa-kun ve Misaki-kun\Nyerlerinden kıpırdayamıyor!{\i0}
Dialogue: 0,0:04:27.33,0:04:28.33,Default,,0,0,0,,Farklı...
Dialogue: 0,0:04:28.59,0:04:31.62,Default,,0,0,0,,Meiwa'nın hareketleri\Nilk yarıdan tamamen farklı!
Dialogue: 0,0:04:31.62,0:04:32.71,Default,,0,0,0,,Al!
Dialogue: 0,0:04:33.90,0:04:34.70,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:04:36.02,0:04:38.08,Default,,0,0,0,,{\i1}Top, bir kez daha Tsubasa-kun!a geliyor!{\i0}
Dialogue: 0,0:04:40.88,0:04:42.86,Default,,0,0,0,,{\i1}Ama çabucak üstüne geliyorlar!{\i0}
Dialogue: 0,0:04:42.86,0:04:44.22,Default,,0,0,0,,{\i1}Tsubasa-kun ne yapacak?!{\i0}
Dialogue: 0,0:04:45.96,0:04:49.73,Default,,0,0,0,,{\i1}Tsubasa-kun zıplayarak\Nmüdahaleden sakınıyor!{\i0}
Dialogue: 0,0:04:49.73,0:04:51.10,Default,,0,0,0,,Güzel zıpladın!
Dialogue: 0,0:04:51.10,0:04:53.10,Default,,0,0,0,,Dikkat et Tsubasa-kun!
Dialogue: 0,0:04:53.84,0:04:56.60,Default,,0,0,0,,{\i1}Hyuga-kun havada topu çalıyor!{\i0}
Dialogue: 0,0:04:56.60,0:04:57.27,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:57.27,0:04:58.15,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:04:59.72,0:05:01.68,Default,,0,0,0,,Bu kez bizim sıramız!
Dialogue: 0,0:05:01.68,0:05:03.61,Default,,0,0,0,,Tamamdır! Kaptan'ı takip edin!
Dialogue: 0,0:05:03.61,0:05:07.03,Default,,0,0,0,,{\i1}İkinci yarıda bayağı\Niddialı görünüyorsunuz Meiwa.{\i0}
Dialogue: 0,0:05:07.03,0:05:09.86,Default,,0,0,0,,{\i1}Hyuga-kun, Nankatsu kalesine\Ndoğru ilerliyor.{\i0}
Dialogue: 0,0:05:09.86,0:05:13.12,Default,,0,0,0,,{\i1}İkinci yarıda Meiwa\Neskisine nazaran çok farklı!{\i0}
Dialogue: 0,0:05:13.12,0:05:14.50,Default,,0,0,0,,Burada onları durduracağız!
Dialogue: 0,0:05:14.50,0:05:15.20,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:15.20,0:05:20.96,Default,,0,0,0,,{\i1}Hyuga-kun'un ünlü top sürüşünü\Ndurdurmak için Nankatsu defansı öne çıkıyor!{\i0}
Dialogue: 0,0:05:20.96,0:05:22.55,Default,,0,0,0,,{\i1}Sana güveniyorum Takeshi.{\i0}
Dialogue: 0,0:05:22.95,0:05:23.76,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:23.76,0:05:26.05,Default,,0,0,0,,{\i1}Hyuga-kun geri pas veriyor!{\i0}
Dialogue: 0,0:05:26.05,0:05:27.97,Default,,0,0,0,,{\i1}Top, Sawada-kun'a gidiyor.{\i0}
Dialogue: 0,0:05:27.97,0:05:29.06,Default,,0,0,0,,{\i1}Farklı.{\i0}
Dialogue: 0,0:05:29.06,0:05:31.79,Default,,0,0,0,,{\i1}Hyuga-kun ilk yarıdakine\Ngöre çok farklı.{\i0}
Dialogue: 0,0:05:31.79,0:05:33.04,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:05:33.04,0:05:37.18,Default,,0,0,0,,{\i1}Ve ilerleyerek Nankatsu\Nceza sahası içerisine giriyor!{\i0}
Dialogue: 0,0:05:37.18,0:05:38.44,Default,,0,0,0,,Hyuga-kun!
Dialogue: 0,0:05:38.44,0:05:40.87,Default,,0,0,0,,Hyuga'ya top gelirse\Ntehlikeli bir durum oluşur!
Dialogue: 0,0:05:40.87,0:05:42.94,Default,,0,0,0,,Defans, Sawada'yı tutun!
Dialogue: 0,0:05:42.94,0:05:44.82,Default,,0,0,0,,{\i1}Almanıza izin vermem!{\i0}
Dialogue: 0,0:05:44.82,0:05:50.57,Default,,0,0,0,,{\i1}Bana güvenip pas veren Hyuga-san'ı\Nve herkesin çabasını boşa çıkaramam.{\i0}
Dialogue: 0,0:05:50.57,0:05:54.79,Default,,0,0,0,,{\i1}Bu topu Hyuga-san'a pas vereceğim.{\i0}
Dialogue: 0,0:05:57.83,0:05:59.33,Default,,0,0,0,,İşte!
Dialogue: 0,0:06:00.58,0:06:02.58,Default,,0,0,0,,{\i1}Sawada Takeshi-kun...{\i0}
Dialogue: 0,0:06:02.58,0:06:07.47,Default,,0,0,0,,{\i1}...Nankatsu defansı arasındaki ufak\Nbir boşluktan harika bir orta açıyor!{\i0}
Dialogue: 0,0:06:07.47,0:06:08.30,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:06:08.30,0:06:12.05,Default,,0,0,0,,{\i1}Hyuga-kun ceza sahası içerisinden\Ndirekt bir şut çekiyor!{\i0}
Dialogue: 0,0:06:18.58,0:06:24.23,Default,,0,0,0,,{\i1}Ne var ki Wakabayashi-kun tüm\Nvücudunu topun önüne koyarak blokluyor!
Dialogue: 0,0:06:24.23,0:06:26.46,Default,,0,0,0,,{\i1}Bu kez durum farklı!{\i0}
Dialogue: 0,0:06:26.46,0:06:29.49,Default,,0,0,0,,Senden önce şut çektim!
Dialogue: 0,0:06:31.46,0:06:34.49,Default,,0,0,0,,{\i1}Bu kez Wakabayashi-kun savruluyor!{\i0}
Dialogue: 0,0:06:35.28,0:06:36.20,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:06:37.70,0:06:39.96,Default,,0,0,0,,{\i1}Kaleye doğru gidiyor!{\i0}
Dialogue: 0,0:06:42.34,0:06:43.21,Default,,0,0,0,,Başardık!
Dialogue: 0,0:06:46.49,0:06:48.75,Default,,0,0,0,,{\i1}Hayır, bu...{\i0}
Dialogue: 0,0:06:48.75,0:06:51.13,Default,,0,0,0,,{\i1}Meiwa yine engelleniyor.{\i0}
Dialogue: 0,0:06:51.13,0:06:53.13,Default,,0,0,0,,{\i1}Tüm bedeni kale içerisinde olmasına rağmen...{\i0}
Dialogue: 0,0:06:53.13,0:06:57.62,Default,,0,0,0,,{\i1}...Wakabayashi-kun topu, kale\Nçizgisinin önünde tutmayı başarıyor!{\i0}
Dialogue: 0,0:06:57.62,0:07:00.43,Default,,0,0,0,,Güzeldi Wakabayashi-san!
Dialogue: 0,0:07:00.43,0:07:04.02,Default,,0,0,0,,Hyuga-san ceza sahası içerisinden\Nbile gol atamadı...
Dialogue: 0,0:07:04.02,0:07:08.02,Default,,0,0,0,,{\i1}Wakabayashi-kun'un savunması\Nilk yarıdaki gibi mükemmel.{\i0}
Dialogue: 0,0:07:08.02,0:07:12.32,Default,,0,0,0,,{\i1}Ne var ki Meiwa'nın coşkusu ilk yarıya\Ngöre çok farklı görünüyor.{\i0}
Dialogue: 0,0:07:13.23,0:07:14.18,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:14.18,0:07:16.37,Default,,0,0,0,,Neden yakaladın ki?!
Dialogue: 0,0:07:16.37,0:07:18.77,Default,,0,0,0,,Abim sonunda şut çekmişti!
Dialogue: 0,0:07:18.77,0:07:19.91,Default,,0,0,0,,Adi!
Dialogue: 0,0:07:19.91,0:07:23.38,Default,,0,0,0,,{\i1}Anne, Takeru, Naoko, Masaru...{\i0}
Dialogue: 0,0:07:23.38,0:07:24.69,Default,,0,0,0,,Ne oldu Kojiro?!
Dialogue: 0,0:07:24.69,0:07:26.75,Default,,0,0,0,,Çabuk bir gol at!
Dialogue: 0,0:07:26.75,0:07:30.42,Default,,0,0,0,,Yoksa Saitama'dan boşu\Nboşuna gelmiş olacağız!
Dialogue: 0,0:07:30.42,0:07:33.37,Default,,0,0,0,,Ne derlerse desinler zafer\Nsenin ayağına bağlı!
Dialogue: 0,0:07:33.37,0:07:35.54,Default,,0,0,0,,Bir şekilde çevir şu durumu tersine!
Dialogue: 0,0:07:35.54,0:07:37.14,Default,,0,0,0,,Evet!
Dialogue: 0,0:07:37.14,0:07:43.06,Default - Top,,0,0,0,,{\an8}Kojiro! Kojiro! Kojiro! Kojiro!
Dialogue: 0,0:07:38.78,0:07:41.02,Default,,0,0,0,,Neden herkes burada?
Dialogue: 0,0:07:41.02,0:07:43.06,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:07:43.06,0:07:45.56,Default,,0,0,0,,Millet, bir gol için daha size güveniyorum!
Dialogue: 0,0:07:45.95,0:07:46.94,Default,,0,0,0,,Alın!
Dialogue: 0,0:07:48.07,0:07:49.44,Default,,0,0,0,,{\i1}Wakabayashi...{\i0}
Dialogue: 0,0:07:49.44,0:07:52.95,Default,,0,0,0,,{\i1}Bu kez kesinlikle gol atacağım.{\i0}
Dialogue: 0,0:07:52.95,0:07:54.45,Default,,0,0,0,,Al Tsubasa!
Dialogue: 0,0:07:54.45,0:07:57.66,Default,,0,0,0,,{\i1}Nankatsu hemen topu Tsubasa-kun'a ulaştırıyor.{\i0}
Dialogue: 0,0:07:57.66,0:07:58.72,Default,,0,0,0,,Tamamdır! Hadi Tsubasa!
Dialogue: 0,0:07:58.72,0:08:02.71,Default,,0,0,0,,{\i1}Orta saha olmasına rağmen\NTsubasa-kun aynı zamanda oyun kurucu.{\i0}
Dialogue: 0,0:08:02.71,0:08:06.21,Default,,0,0,0,,{\i1}Bedeni küçük de olsa\NNankatsu'nun yıldız oyuncusu o.{\i0}
Dialogue: 0,0:08:06.92,0:08:09.92,Default,,0,0,0,,{\i1}Bacağın iyi mi Genzo?{\i0}
Dialogue: 0,0:08:09.92,0:08:12.82,Default,,0,0,0,,{\i1}Bir maç için oynamana izin verilse de...{\i0}
Dialogue: 0,0:08:12.82,0:08:18.10,Default,,0,0,0,,{\i1}...ilk yarıda Hyuga'nın\No güçlü şutlarını durdurdun.{\i0}
Dialogue: 0,0:08:18.10,0:08:22.57,Default,,0,0,0,,{\i1}Böyle bir efor, normal\Nbir maçtan daha fazla yorucu olur.{\i0}
Dialogue: 0,0:08:22.57,0:08:24.73,Default,,0,0,0,,Takasugi! Biraz daha ileri!
Dialogue: 0,0:08:28.09,0:08:34.36,Default,,0,0,0,,{\i1}Wakabayashi-kun, ilk yarının sonunda\NSawada-kun'un şutunu yaralı sol bacağıyla durdurdu.{\i0}
Dialogue: 0,0:08:34.36,0:08:36.87,Default,,0,0,0,,{\i1}Ona daha fazla yük olamayız.{\i0}
Dialogue: 0,0:08:36.87,0:08:40.22,Default,,0,0,0,,Wakabayashi-kun'un hatırı için\Nbir gol daha atalım Misaki-kun!
Dialogue: 0,0:08:40.22,0:08:40.99,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:40.99,0:08:42.50,Default,,0,0,0,,İzin verir miyiz ki?!
Dialogue: 0,0:08:42.50,0:08:43.62,Default,,0,0,0,,İşte!
Dialogue: 0,0:08:43.62,0:08:44.32,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:44.32,0:08:46.29,Default,,0,0,0,,{\i1}Tsubasa-kun, Izawa-kun'a uzun bir pas gönderiyor.{\i0}
Dialogue: 0,0:08:46.94,0:08:48.79,Default,,0,0,0,,{\i1}Sağa ve sola gidiyorlar.{\i0}
Dialogue: 0,0:08:48.79,0:08:52.17,Default,,0,0,0,,{\i1}Artık Meiwa kayarak müdahale edemeyecek.{\i0}
Dialogue: 0,0:08:52.67,0:08:54.04,Default,,0,0,0,,Tamamdır! İşte bu!
Dialogue: 0,0:08:54.04,0:08:58.43,Default,,0,0,0,,Misaki ve Tsubasa yan yana\Noynamazsa daha iyi olur!
Dialogue: 0,0:08:58.43,0:08:59.86,Default,,0,0,0,,Millet yalvarıyorum!
Dialogue: 0,0:08:59.86,0:09:01.97,Default,,0,0,0,,Kaleyi kesinlikle koruyun!
Dialogue: 0,0:09:01.97,0:09:03.93,Default,,0,0,0,,Sonra bana pas verin!
Dialogue: 0,0:09:03.93,0:09:07.19,Default,,0,0,0,,Bu kez kesinlikle...\NKesinlikle gol atacağım!
Dialogue: 0,0:09:07.19,0:09:08.31,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:09:08.31,0:09:09.31,Default,,0,0,0,,{\i1}Hyuga...{\i0}
Dialogue: 0,0:09:09.31,0:09:11.27,Default,,0,0,0,,{\i1}Kojiro...{\i0}
Dialogue: 0,0:09:11.27,0:09:12.91,Default,,0,0,0,,Tamamdır! Koruyacağız!
Dialogue: 0,0:09:12.91,0:09:14.52,Default,,0,0,0,,Kalenin etrafında toplanın!
Dialogue: 0,0:09:14.52,0:09:16.70,Default,,0,0,0,,Ne pahasına olursa olsun koruyacağız!
Dialogue: 0,0:09:16.70,0:09:18.70,Default,,0,0,0,,Kesinlikle Kaptan'a topu göndereceğiz!
Dialogue: 0,0:09:18.70,0:09:23.70,Default,,0,0,0,,{\i1}Nankatsu, her şeyini savunmaya\Nkoyan Meiwa'yı geçebilecek mi?{\i0}
Dialogue: 0,0:09:25.27,0:09:29.46,Default,,0,0,0,,{\i1}Meiwa hızlıca müdahale\Nederek topu çalıyor!{\i0}
Dialogue: 0,0:09:29.46,0:09:32.43,Default,,0,0,0,,{\i1}Misaki-kun hızlıca geri alıyor!{\i0}
Dialogue: 0,0:09:32.43,0:09:35.26,Default,,0,0,0,,{\i1}Her zamanki gibi iyi bir oyun sergiliyor.{\i0}
Dialogue: 0,0:09:35.26,0:09:38.55,Default,,0,0,0,,{\i1}Nankatsu'nun bir diğer\Nyıldız oyuncusu olduğu söylenebilir!{\i0}
Dialogue: 0,0:09:38.55,0:09:40.15,Default,,0,0,0,,Misaki-kun, yukarı gönder!
Dialogue: 0,0:09:40.15,0:09:41.93,Default,,0,0,0,,Kalenin sağına gönder!
Dialogue: 0,0:09:42.81,0:09:47.35,Default,,0,0,0,,{\i1}Tsubasa-kun, Misaki-kun'a talimat\Nvererek kaleye doğru koşuyor!{\i0}
Dialogue: 0,0:09:47.35,0:09:48.49,Default,,0,0,0,,{\i1}Bir şey planlıyorlar...{\i0}
Dialogue: 0,0:09:48.49,0:09:51.44,Default,,0,0,0,,{\i1}Misaki-san'ın orta açmasına\Nizin veremem!{\i0}
Dialogue: 0,0:09:53.73,0:09:56.11,Default,,0,0,0,,{\i1}Misaki-kun kaleye doğru...{\i0}
Dialogue: 0,0:09:56.11,0:09:59.86,Default,,0,0,0,,{\i1}Ah! Meiwa'dan Sawada-kun\Nkayarak müdahale ediyor!{\i0}
Dialogue: 0,0:10:01.99,0:10:03.75,Default,,0,0,0,,{\i1}Çarpışıyorlar!{\i0}
Dialogue: 0,0:10:03.75,0:10:06.41,Default,,0,0,0,,{\i1}Ama Misaki-kun bir saniye\Ndaha erken orta açıyor!{\i0}
Dialogue: 0,0:10:07.73,0:10:08.71,Default,,0,0,0,,Misaki-san!
Dialogue: 0,0:10:09.66,0:10:10.75,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:10:12.21,0:10:15.19,Default,,0,0,0,,{\i1}Top, Meiwa kalesinin\Nüstüne doğru gönderildi.{\i0}
Dialogue: 0,0:10:15.19,0:10:17.47,Default,,0,0,0,,Tamamdır! Burayı bana bırakın!
Dialogue: 0,0:10:18.72,0:10:20.47,Default,,0,0,0,,{\i1}Ne düşünüyor bu?!{\i0}
Dialogue: 0,0:10:20.47,0:10:23.60,Default,,0,0,0,,{\i1}Tsubasa-kun kale direğini\Nhedef alarak koşuyor!{\i0}
Dialogue: 0,0:10:23.60,0:10:25.93,Default,,0,0,0,,Eyvah! Bunun peşinde miymiş?!
Dialogue: 0,0:10:27.02,0:10:30.34,Default,,0,0,0,,{\i1}Wakashimazu-kun da diğer\Nkale direğine doğru koşuyor!{\i0}
Dialogue: 0,0:10:30.34,0:10:31.94,Default,,0,0,0,,{\i1}Yetişmem gerek...{\i0}
Dialogue: 0,0:10:31.94,0:10:33.69,Default,,0,0,0,,B-Bu...
Dialogue: 0,0:10:33.69,0:10:35.94,Default,,0,0,0,,...bizim maçta kullandığımız hareket!
Dialogue: 0,0:10:37.86,0:10:40.67,Default,,0,0,0,,{\i1}Kale direğini kullanarak\Ngökyüzüne doğru yükseliyor...{\i0}
Dialogue: 0,0:10:40.67,0:10:42.92,Default,,0,0,0,,{\i1}...ve en yüksek noktadan şut çekiyor.{\i0}
Dialogue: 0,0:10:42.92,0:10:46.54,Default,,0,0,0,,{\i1}Hanawa'daki Tachibana\NKardeşlerin özel akrobatik futbolu bu!{\i0}
Dialogue: 0,0:10:46.54,0:10:47.75,Default,,0,0,0,,{\i1}Ama...{\i0}
Dialogue: 0,0:10:50.16,0:10:53.71,Default,,0,0,0,,{\i1}...Wakashimazu-kun da üçlü tekmeleme\Nkullanarak zıplıyor!{\i0}
Dialogue: 0,0:10:54.71,0:10:58.34,Default,,0,0,0,,{\i1}Tsubasa-kun ve Wakashimazu-kun\Narasındaki büyük hava mücadelesi!{\i0}
Dialogue: 0,0:11:01.71,0:11:04.62,Default,,0,0,0,,{\i1}Wakashimazu-kun durduruyor!{\i0}
Dialogue: 0,0:11:11.68,0:11:13.77,Default,,0,0,0,,Sözümü tuttum Kaptan!
Dialogue: 0,0:11:13.77,0:11:16.48,Default,,0,0,0,,Şimdi senin gol atma sıran!
Dialogue: 0,0:11:16.48,0:11:18.31,Default,,0,0,0,,Herkes geri dönsün!
Dialogue: 0,0:11:20.10,0:11:20.94,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:21.52,0:11:23.01,Default,,0,0,0,,Misaki!
Dialogue: 0,0:11:23.01,0:11:27.88,Default,,0,0,0,,{\i1}Nankatsu'nun iki yıldız oyuncusu Tsubasa-kun\Nve Misaki-kun, Meiwa tarafında yerde uzanıyor!{\i0}
Dialogue: 0,0:11:27.88,0:11:29.98,Default,,0,0,0,,{\i1}İki yıldız oyuncu da yerde!{\i0}
Dialogue: 0,0:11:28.50,0:11:29.98,Default - Top,,0,0,0,,- Taro...\N- Tsubasa!
Dialogue: 0,0:11:29.98,0:11:32.08,Default,,0,0,0,,{\i1}Nankatsu çok zor durumda!{\i0}
Dialogue: 0,0:11:32.90,0:11:34.50,Default,,0,0,0,,{\i1}Top, Hyuga-kun'a gidiyor.{\i0}
Dialogue: 0,0:11:34.50,0:11:36.29,Default,,0,0,0,,Millet, panik yapmayın!
Dialogue: 0,0:11:36.29,0:11:38.18,Default,,0,0,0,,Önce Hyuga'yı tutun!
Dialogue: 0,0:11:38.18,0:11:40.30,Default,,0,0,0,,Ne olursa olsun burayı korumalıyız!
Dialogue: 0,0:11:40.30,0:11:41.42,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:41.42,0:11:42.84,Default,,0,0,0,,{\i1}Wakabayashi...{\i0}
Dialogue: 0,0:11:42.84,0:11:46.68,Default,,0,0,0,,{\i1}Hayatım boyunca gol atmayı\Nbu kadar çok arzulamamıştım!{\i0}
Dialogue: 0,0:11:46.68,0:11:48.80,Default,,0,0,0,,Millet, Kaptan'a destek olalım!
Dialogue: 0,0:11:48.80,0:11:50.18,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:53.64,0:11:54.69,Default,,0,0,0,,{\i1}Misaki-san...{\i0}
Dialogue: 0,0:11:58.66,0:12:00.94,Default,,0,0,0,,{\i1}Hep yalnız olduğumu düşünmüştüm.{\i0}
Dialogue: 0,0:12:02.22,0:12:04.78,Default,,0,0,0,,{\i1}Etrafımdaki herkesi düşmanım kabul etmiştim.{\i0}
Dialogue: 0,0:12:06.24,0:12:08.74,Default,,0,0,0,,Lanet olsun! Onu durdurmalıyız!
Dialogue: 0,0:12:08.74,0:12:14.17,Default,,0,0,0,,{\i1}Ama yanımda arkadaşlarım varmış.{\i0}
Dialogue: 0,0:12:14.17,0:12:15.92,Default,,0,0,0,,Ne düşünüyor bu?
Dialogue: 0,0:12:15.92,0:12:17.98,Default,,0,0,0,,Lanet olsun! Öyleyse--
Dialogue: 0,0:12:18.53,0:12:19.17,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:20.42,0:12:21.54,Default,,0,0,0,,Kojiro!
Dialogue: 0,0:12:21.54,0:12:24.53,Default,,0,0,0,,{\i1}Hyuga-kun'un top sürerek\Ngeçeceğini düşünmüştük ama...{\i0}
Dialogue: 0,0:12:24.53,0:12:27.05,Default,,0,0,0,,{\i1}...kanada pas verdi.{\i0}
Dialogue: 0,0:12:28.78,0:12:30.51,Default,,0,0,0,,Tamamdır! Gidelim!
Dialogue: 0,0:12:31.51,0:12:33.39,Default,,0,0,0,,Nankatsu'ya topu kaptırmayın!
Dialogue: 0,0:12:33.39,0:12:35.55,Default,,0,0,0,,Son pası Kaptan'ı ulaştıralım!
Dialogue: 0,0:12:35.55,0:12:38.88,Default,,0,0,0,,İşte bu! Çok hızlı bir atak!
Dialogue: 0,0:12:38.88,0:12:41.69,Default,,0,0,0,,{\i1}Buraya kadar bize\Nhocalık yapan Koç Kira...{\i0}
Dialogue: 0,0:12:42.48,0:12:45.45,Default,,0,0,0,,{\i1}Buraya kadar bizi desteklemeye\Ngelen herkes...{\i0}
Dialogue: 0,0:12:46.45,0:12:48.91,Default,,0,0,0,,Ne olursa olsun Hyuga'ya\Npas atılmasını engelleyin!
Dialogue: 0,0:12:48.91,0:12:51.24,Default,,0,0,0,,Ne olursa olsun durduracağım!
Dialogue: 0,0:12:51.24,0:12:53.04,Default,,0,0,0,,Buraya Ishi-san!
Dialogue: 0,0:12:53.04,0:12:54.91,Default,,0,0,0,,{\i1}Sawada-kun'dan harika bir hareket.{\i0}
Dialogue: 0,0:12:54.91,0:12:58.04,Default,,0,0,0,,{\i1}Defansın arkasından geçerek\NIshi-kun'un pasını alıyor!{\i0}
Dialogue: 0,0:12:58.04,0:12:58.81,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:12:58.81,0:13:00.42,Default,,0,0,0,,Sana güveniyorum Takeshi!
Dialogue: 0,0:13:00.42,0:13:02.00,Default,,0,0,0,,{\i1}Aynen öyle Takeshi.{\i0}
Dialogue: 0,0:13:02.00,0:13:06.32,Default,,0,0,0,,{\i1}Sen olmasan gollerim yarım kalırdı.{\i0}
Dialogue: 0,0:13:06.32,0:13:08.18,Default,,0,0,0,,Al Hyuga-san!
Dialogue: 0,0:13:08.18,0:13:14.27,Default,,0,0,0,,{\i1}Harika ortaların her zaman\Nayağıma servis oluyor!{\i0}
Dialogue: 0,0:13:14.92,0:13:16.27,Default,,0,0,0,,{\i1}Ulaştı!{\i0}
Dialogue: 0,0:13:16.96,0:13:21.77,Default,,0,0,0,,{\i1}Nankatsu kalesinin önde, ceza\Nsahasının içerisinde, Hyuga-kun topu alıyor!{\i0}
Dialogue: 0,0:13:23.78,0:13:29.21,Default,,0,0,0,,{\i1}Ve en önemlisi annem, Takeru,\NNaoko ve Masaru'nun hatırı için...{\i0}
Dialogue: 0,0:13:29.21,0:13:33.56,Default,,0,0,0,,{\i1}...bu şutu gole çevireceğim!{\i0}
Dialogue: 0,0:13:33.56,0:13:36.54,Default,,0,0,0,,{\i1}Hyuga-kun 6. şutunu çekiyor!{\i0}
Dialogue: 0,0:13:36.54,0:13:38.16,Default,,0,0,0,,Durdur Genzo!
Dialogue: 0,0:13:38.16,0:13:39.29,Default,,0,0,0,,Wakabayashi!
Dialogue: 0,0:13:41.13,0:13:45.76,Default,,0,0,0,,{\i1}Wakabayashi-kun bu güçlü\Nşutu zor durduruyor!{\i0}
Dialogue: 0,0:13:45.76,0:13:47.88,Default,,0,0,0,,Wakabayashi...
Dialogue: 0,0:13:48.46,0:13:49.46,Default,,0,0,0,,Uzaklaştırın!
Dialogue: 0,0:13:49.46,0:13:50.89,Default,,0,0,0,,Uzaklaştırın lütfen!
Dialogue: 0,0:13:57.15,0:13:58.98,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:13:58.98,0:14:02.65,Default,,0,0,0,,{\i1}Hyuga-kun sabrın meyvesini\Nalarak topu sokuyor!{\i0}
Dialogue: 0,0:14:03.25,0:14:05.15,Default,,0,0,0,,{\i1}Başardım...{\i0}
Dialogue: 0,0:14:19.52,0:14:20.54,Default,,0,0,0,,{\i1}Beraberlik!{\i0}
Dialogue: 0,0:14:20.54,0:14:28.60,Default,,0,0,0,,{\i1}Hyuga-kun azmi ve kafa vuruşuyla\NMeiwa sonunda beraberliği sağlıyor!{\i0}
Dialogue: 0,0:14:20.54,0:14:22.62,Default - Top,,0,0,0,,{\an8}Güzel vurdun Kojiro!
Dialogue: 0,0:14:25.91,0:14:27.70,Default - Top,,0,0,0,,{\an8}Kojiro Abi!
Dialogue: 0,0:14:27.70,0:14:29.43,Default - Top,,0,0,0,,{\an8}Abi, güzel şuttu!
Dialogue: 0,0:14:29.43,0:14:31.28,Default,,0,0,0,,{\i1}Ne azim böyle.{\i0}
Dialogue: 0,0:14:31.28,0:14:38.77,Default,,0,0,0,,{\i1}Acımasız Kaplan Hyuga Kojiro-kun, iyi\Nsavunmasıyla bilinen Wakabayashi-kun'a gol atıyor!{\i0}
Dialogue: 0,0:14:38.77,0:14:40.57,Default,,0,0,0,,Başardın Hyuga-san!
Dialogue: 0,0:14:40.57,0:14:41.77,Default,,0,0,0,,Beraberlik!
Dialogue: 0,0:14:41.77,0:14:43.13,Default,,0,0,0,,Başardın!
Dialogue: 0,0:14:44.16,0:14:45.15,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:14:45.93,0:14:47.08,Default,,0,0,0,,Siz de başardınız.
Dialogue: 0,0:14:47.08,0:14:49.40,Default,,0,0,0,,Hyuga Kojiro'dan da bu beklenirdi.
Dialogue: 0,0:14:49.40,0:14:53.02,Default,,0,0,0,,Defans topu uzaklaştıracakken...
Dialogue: 0,0:14:53.02,0:14:57.11,Default,,0,0,0,,...cesareti sayesinde o durumu\Ngole çevirdi.
Dialogue: 0,0:14:57.11,0:14:59.62,Default,,0,0,0,,Gerçekten de acımasız bir kaplansın.
Dialogue: 0,0:15:02.72,0:15:05.49,Default,,0,0,0,,Hyuga-san, alnın kanıyor.
Dialogue: 0,0:15:05.49,0:15:06.96,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:15:06.96,0:15:09.29,Default,,0,0,0,,Sadece bir çizik bu.
Dialogue: 0,0:15:09.29,0:15:13.91,Default,,0,0,0,,Daha da önemlisi dinleyin millet!\NŞimdi bu gazla durumu tersine çevireceğiz!
Dialogue: 0,0:15:13.91,0:15:15.89,Default,,0,0,0,,Evet!
Dialogue: 0,0:15:19.36,0:15:20.68,Default,,0,0,0,,{\i1}Misaki-san...{\i0}
Dialogue: 0,0:15:21.82,0:15:24.18,Default,,0,0,0,,Lanet olsun, beraberliği sağladılar.
Dialogue: 0,0:15:24.18,0:15:25.04,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:25.04,0:15:26.48,Default,,0,0,0,,İyi misin Tsubasa?
Dialogue: 0,0:15:26.48,0:15:28.44,Default,,0,0,0,,Evet, iyiyim iyi.
Dialogue: 0,0:15:28.44,0:15:33.20,Default,,0,0,0,,{\i1}Tsubasa-kun topallayarak\Nmaça devam edecek gibi görünüyor.{\i0}
Dialogue: 0,0:15:34.83,0:15:36.90,Default,,0,0,0,,Misaki, iyi misin?
Dialogue: 0,0:15:36.90,0:15:38.66,Default,,0,0,0,,{\i1}Misaki-kun ayağa kalkamıyor.{\i0}
Dialogue: 0,0:15:38.66,0:15:42.04,Default,,0,0,0,,{\i1}Sahanın dışında tedavi görecek.{\i0}
Dialogue: 0,0:15:44.70,0:15:48.96,Default,,0,0,0,,{\i1}Maçta talimiz dönmüş gibi görünüyor.{\i0}
Dialogue: 0,0:15:48.96,0:15:54.22,Default,,0,0,0,,{\i1}Misaki-kun'un tedavisi tamamlanana\Nkadar Nankatsu 10 kişi devam etmek zorunda.{\i0}
Dialogue: 0,0:15:54.22,0:15:57.60,Default,,0,0,0,,{\i1}Nankatsu'nun top vuruşuyla\Nmaç devam edecek.{\i0}
Dialogue: 0,0:15:57.60,0:15:59.20,Default,,0,0,0,,Hala beraberlik var!
Dialogue: 0,0:15:59.20,0:16:01.62,Default,,0,0,0,,Millet, kendinizi tutmadan atağa çıkın!
Dialogue: 0,0:16:01.62,0:16:03.44,Default,,0,0,0,,Evet!
Dialogue: 0,0:16:04.77,0:16:06.94,Default,,0,0,0,,Hadi! Topu alın!
Dialogue: 0,0:16:06.94,0:16:09.86,Default,,0,0,0,,Bir golle liderliği hemen alacağız!
Dialogue: 0,0:16:09.86,0:16:10.69,Default,,0,0,0,,Evet!
Dialogue: 0,0:16:10.69,0:16:12.69,Default,,0,0,0,,Al Tsubasa!
Dialogue: 0,0:16:12.69,0:16:17.20,Default,,0,0,0,,{\i1}Nankatsu vakit kaybetmeden yıldız\Noyuncu Tsubasa-kun'a topu ulaştırıyor.{\i0}
Dialogue: 0,0:16:17.20,0:16:18.87,Default,,0,0,0,,{\i1}Bacağı iyi mi?{\i0}
Dialogue: 0,0:16:20.69,0:16:21.95,Default,,0,0,0,,{\i1}Bir kişiyi geçiyor.{\i0}
Dialogue: 0,0:16:21.95,0:16:24.33,Default,,0,0,0,,{\i1}Bir sorun yok gibi duruyor.{\i0}
Dialogue: 0,0:16:24.33,0:16:25.29,Default,,0,0,0,,{\i1}Hayır.{\i0}
Dialogue: 0,0:16:25.29,0:16:28.13,Default,,0,0,0,,{\i1}Tsubasa'nın hareketleri\Nher zamanki kadar seri değil.{\i0}
Dialogue: 0,0:16:28.13,0:16:30.62,Default,,0,0,0,,{\i1}Gerçekten de bacağı...{\i0}
Dialogue: 0,0:16:30.62,0:16:33.26,Default,,0,0,0,,{\i1}Tsubasa-kun'u bekleyen kişi Hyuga-kun.{\i0}
Dialogue: 0,0:16:33.80,0:16:35.26,Default,,0,0,0,,{\i1}Kesinlikle alacağım!{\i0}
Dialogue: 0,0:16:35.26,0:16:37.30,Default,,0,0,0,,{\i1}Bu topu kaybedemem!{\i0}
Dialogue: 0,0:16:37.94,0:16:40.31,Default,,0,0,0,,{\i1}İkili arasında büyük bir karşılaşma!{\i0}
Dialogue: 0,0:16:56.48,0:16:59.53,Default,,0,0,0,,{\i1}Hyuga-kun topu alıyor!{\i0}
Dialogue: 0,0:17:00.27,0:17:03.04,Default,,0,0,0,,{\i1}Tsubasa-kun savruluyor!{\i0}
Dialogue: 0,0:17:04.54,0:17:08.65,Default,,0,0,0,,Her zaman berabere\Nkalan Tsubasa savruldu!
Dialogue: 0,0:17:08.65,0:17:10.71,Default,,0,0,0,,Tsubasa da bacağını da incitmiş gerçekten!
Dialogue: 0,0:17:10.71,0:17:15.42,Default,,0,0,0,,{\i1}Meiwa hızlıca Nankatsu kalesine\Ndoğru atağa geçiyor.{\i0}
Dialogue: 0,0:17:15.42,0:17:19.24,Default,,0,0,0,,{\i1}Tsubasa ve Misaki şu an\Nkarşı sahadayken ben...{\i0}
Dialogue: 0,0:17:19.24,0:17:21.43,Default,,0,0,0,,{\i1}Ben bir şeyler yapmazsam...{\i0}
Dialogue: 0,0:17:21.43,0:17:23.10,Default,,0,0,0,,Hyuga'yı tutun!
Dialogue: 0,0:17:23.10,0:17:23.93,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:23.93,0:17:25.43,Default,,0,0,0,,Hadi Sawaki!
Dialogue: 0,0:17:25.43,0:17:27.44,Default,,0,0,0,,{\i1}Hyuga-kun yine takım oyununa başvuruyor!{\i0}
Dialogue: 0,0:17:27.44,0:17:29.48,Default,,0,0,0,,{\i1}Sawaki-kun boşta!{\i0}
Dialogue: 0,0:17:29.48,0:17:31.23,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:17:31.23,0:17:32.44,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:17:34.12,0:17:37.20,Default,,0,0,0,,{\i1}Wakabayashi-kun dengesini kaybediyor!{\i0}
Dialogue: 0,0:17:41.29,0:17:44.92,Default,,0,0,0,,{\i1}Wakabayashi-kun zar zor\Ntopu kornere yolluyor.{\i0}
Dialogue: 0,0:17:44.92,0:17:46.04,Default,,0,0,0,,Wakabayashi-san!
Dialogue: 0,0:17:47.53,0:17:52.80,Default,,0,0,0,,{\i1}Kaleci Wakabayashi-kun da\Nbacağını tekrardan mı incitti yoksa?{\i0}
Dialogue: 0,0:17:52.80,0:17:53.96,Default,,0,0,0,,Ne?!
Dialogue: 0,0:17:53.96,0:17:55.71,Default,,0,0,0,,Wakabayashi'nin de mi bacağı yaralandı?!
Dialogue: 0,0:17:55.71,0:18:01.70,Default,,0,0,0,,{\i1}Kaleci Wakabayashi-kun, orta saha\NMisaki-kun ve forvet Tsubasa-kun...{\i0}
Dialogue: 0,0:18:01.70,0:18:04.39,Default,,0,0,0,,{\i1}Üçü de yaralandı.{\i0}
Dialogue: 0,0:18:04.39,0:18:10.19,Default,,0,0,0,,{\i1}Maçın gidişatı Meiwa'nın zaferi\Nyönünde değişmeye başlıyor.{\i0}
Dialogue: 0,0:18:10.19,0:18:12.35,Default,,0,0,0,,Devam edebilecek misin?
Dialogue: 0,0:18:12.35,0:18:14.84,Default,,0,0,0,,Evet, iyiyim.
Dialogue: 0,0:18:14.84,0:18:16.39,Default,,0,0,0,,Bir sorun yok.
Dialogue: 0,0:18:16.39,0:18:19.95,Default,,0,0,0,,Hey çocuklar, elimizden geleni\Nyapmaktan başka çaremiz yok!
Dialogue: 0,0:18:19.95,0:18:21.06,Default,,0,0,0,,Ishizaki...
Dialogue: 0,0:18:21.06,0:18:24.40,Default,,0,0,0,,Şu ana kadar Tsubasa, Misaki\Nve Wakabayashi'ye bel bağladık.
Dialogue: 0,0:18:24.40,0:18:26.70,Default,,0,0,0,,Artık bizim çıkartıp masaya vurmamız gerek!
Dialogue: 0,0:18:26.70,0:18:29.46,Default,,0,0,0,,Elimizden geleni yaparak\Nbu zor durumu atlatmalıyız!
Dialogue: 0,0:18:29.46,0:18:29.96,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:29.96,0:18:31.50,Default,,0,0,0,,Ishizaki haklı!
Dialogue: 0,0:18:31.50,0:18:32.98,Default,,0,0,0,,Elimizden geleni yapmalıyız!
Dialogue: 0,0:18:32.98,0:18:35.25,Default,,0,0,0,,Şimdi bizim parlama zamanımız!
Dialogue: 0,0:18:35.25,0:18:36.88,Default,,0,0,0,,Tamamdır! Yapalım şunu!
Dialogue: 0,0:18:36.88,0:18:38.48,Default,,0,0,0,,Nankatsu, bastır!
Dialogue: 0,0:18:38.48,0:18:39.23,Default,,0,0,0,,Millet...
Dialogue: 0,0:18:39.23,0:18:40.59,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:41.18,0:18:44.10,Default,,0,0,0,,{\i1}İkinci yarının 12. dakikasındayız.{\i0}
Dialogue: 0,0:18:44.10,0:18:46.22,Default,,0,0,0,,{\i1}Meiwa korner vuruşu kullanacak.{\i0}
Dialogue: 0,0:18:46.22,0:18:49.35,Default,,0,0,0,,{\i1}Liderliği almak için harika bir fırsat.{\i0}
Dialogue: 0,0:18:49.35,0:18:52.23,Default,,0,0,0,,İşte bu! Bu vuruşla liderliği alın!
Dialogue: 0,0:18:54.15,0:18:55.27,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:18:55.27,0:18:57.53,Default,,0,0,0,,{\i1}Hyuga-kun kaleye doğru yaklaşıyor!{\i0}
Dialogue: 0,0:18:58.94,0:19:00.91,Default,,0,0,0,,{\i1}Zıplayamıyor!{\i0}
Dialogue: 0,0:19:00.91,0:19:01.95,Default,,0,0,0,,Genzo!
Dialogue: 0,0:19:01.95,0:19:03.61,Default,,0,0,0,,Bende!
Dialogue: 0,0:19:03.61,0:19:05.10,Default,,0,0,0,,{\i1}Hyuga-kun ilk zıplayan kişi!{\i0}
Dialogue: 0,0:19:05.10,0:19:07.56,Default,,0,0,0,,{\i1}Kafa vuruşuyla liderliği alabilecek mi?{\i0}
Dialogue: 0,0:19:09.75,0:19:11.75,Default,,0,0,0,,İzin vermeyiz!
Dialogue: 0,0:19:12.45,0:19:17.05,Default,,0,0,0,,{\i1}Izawa-kun ve Takasugi-kun\Nkafalarını koyarak engelliyor!{\i0}
Dialogue: 0,0:19:17.05,0:19:18.34,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:23.38,0:19:26.35,Default,,0,0,0,,{\i1}Top uzaklaştırılıyor.{\i0}
Dialogue: 0,0:19:26.35,0:19:29.10,Default,,0,0,0,,{\i1}Nankatsu zor durumu atlatıyor.{\i0}
Dialogue: 0,0:19:29.10,0:19:29.94,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:19:29.94,0:19:32.02,Default,,0,0,0,,Böyle devam çocuklar!
Dialogue: 0,0:19:32.02,0:19:33.58,Default,,0,0,0,,Millet...
Dialogue: 0,0:19:33.58,0:19:35.59,Default,,0,0,0,,Koç, lütfen tedaviyi hemen yapın.
Dialogue: 0,0:19:35.59,0:19:36.69,Default,,0,0,0,,T-Tamam.
Dialogue: 0,0:19:36.69,0:19:39.38,Default,,0,0,0,,{\i1}Yara düşündüğümden daha derin.{\i0}
Dialogue: 0,0:19:39.38,0:19:41.74,Default,,0,0,0,,{\i1}Bu durumda oynatamam.{\i0}
Dialogue: 0,0:19:41.74,0:19:46.99,Default,,0,0,0,,{\i1}Misaki-kun saha dışındayken Nankatsu\Ndefansa odaklanıyor ve inatla savunuyorlar.{\i0}
Dialogue: 0,0:19:46.99,0:19:48.56,Default,,0,0,0,,Ulan!
Dialogue: 0,0:19:48.56,0:19:51.54,Default,,0,0,0,,{\i1}Yıldız oyuncu Hyuga-kun'a\Ngelecek tüm paslar kesiliyor.{\i0}
Dialogue: 0,0:19:51.54,0:19:56.42,Default,,0,0,0,,{\i1}O kadar çok baskı kurmalarına\Nrağmen hala iyi bir fırsat yakalayamadılar.{\i0}
Dialogue: 0,0:19:56.42,0:19:57.62,Default,,0,0,0,,Biz...
Dialogue: 0,0:19:57.62,0:19:58.90,Default,,0,0,0,,...başaracağız!
Dialogue: 0,0:19:58.90,0:20:00.45,Default,,0,0,0,,Tsubasa'ya, Misaki'ye...
Dialogue: 0,0:20:00.45,0:20:01.61,Default,,0,0,0,,...Wakabayashi-san'a...
Dialogue: 0,0:20:01.61,0:20:03.14,Default,,0,0,0,,...bel bağladığımız her sefer için!
Dialogue: 0,0:20:03.14,0:20:04.98,Default,,0,0,0,,Bu kez...
Dialogue: 0,0:20:04.98,0:20:08.26,Default,,0,0,0,,Bu kez biz bir şeyler yapacağız!
Dialogue: 0,0:20:08.26,0:20:11.27,Default,,0,0,0,,{\i1}M-Millet...{\i0}
Dialogue: 0,0:20:11.27,0:20:18.14,Default,,0,0,0,,{\i1}Bu zor durumda sadece Tsubasa-kun\Ndefansa yardımcı olmuyor.{\i0}
Dialogue: 0,0:20:18.14,0:20:21.69,Default,,0,0,0,,{\i1}Bacağı o kadar mı kötü durumda?{\i0}
Dialogue: 0,0:20:21.69,0:20:23.28,Default,,0,0,0,,{\i1}Tsubasa-kun...{\i0}
Dialogue: 0,0:20:25.78,0:20:29.78,Default,,0,0,0,,Tsubasa-kun'un bacağı\No kadar mı kötü durumda acaba?
Dialogue: 0,0:20:29.78,0:20:34.09,Default,,0,0,0,,Hayır, Tsubasa-kun böyle\Nbir durumda geri kalacak birisi değil.
Dialogue: 0,0:20:34.09,0:20:36.79,Default,,0,0,0,,Eminim bir şeyler düşünüyordur.
Dialogue: 0,0:20:37.45,0:20:39.79,Default,,0,0,0,,{\i1}Değil mi Tsubasa-kun?{\i0}
Dialogue: 0,0:20:41.67,0:20:45.96,Default,,0,0,0,,{\i1}Kale önündeki Hyuga-kun\Nsonunda topu alıyor!{\i0}
Dialogue: 0,0:20:45.96,0:20:46.93,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:20:48.80,0:20:51.06,Default,,0,0,0,,Bu şutu bacağım kırılsa bile tutacağım!
Dialogue: 0,0:20:51.06,0:20:53.06,Default,,0,0,0,,{\i1}Al bakalım Wakabayashi!{\i0}
Dialogue: 0,0:20:58.19,0:21:00.86,Default - Top,,0,0,0,,{\an8}Ishizaki!
Dialogue: 0,0:20:57.61,0:21:04.45,Default,,0,0,0,,{\i1}Hyuga-kun'un mermi şutunu\Nyüzüyle... Yüzüyle durduruyor!{\i0}
Dialogue: 0,0:21:09.34,0:21:10.87,Default,,0,0,0,,Hayatta kaybetmem!
Dialogue: 0,0:21:10.87,0:21:13.10,Default,,0,0,0,,B-Bu...
Dialogue: 0,0:21:13.10,0:21:19.00,Default,,0,0,0,,{\i1}Ishizaki-kun'un çabalarıyla Nankatsu,\Nbir zor durumu daha atlatıyor.{\i0}
Dialogue: 0,0:21:19.00,0:21:22.76,Default,,0,0,0,,{\i1}El birliğiyle kaleyi koruyorlar.{\i0}
Dialogue: 0,0:21:19.00,0:21:20.78,Default - Top,,0,0,0,,{\an8}Harikaydın Ishizaki!
Dialogue: 0,0:21:20.78,0:21:22.76,Default - Top,,0,0,0,,{\an8}Güzel uzaklaştırdın.
Dialogue: 0,0:21:22.76,0:21:24.47,Default,,0,0,0,,Çok yaşa Ishizaki-kun!
Dialogue: 0,0:21:24.47,0:21:25.76,Default,,0,0,0,,Güzel mücadele!
Dialogue: 0,0:21:29.10,0:21:35.08,Default,,0,0,0,,{\i1}Şu an Nankatsu'nun 11 numarası Mikasi-kun\Ntedavisi bittiği için sahaya geri dönüyor.{\i0}
Dialogue: 0,0:21:37.57,0:21:38.90,Default,,0,0,0,,{\i1}Taro...{\i0}
Dialogue: 0,0:21:38.90,0:21:40.14,Default,,0,0,0,,Misaki-kun.
Dialogue: 0,0:21:40.14,0:21:41.36,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:21:41.36,0:21:43.36,Default,,0,0,0,,Ne düşündüğünü biliyorum.
Dialogue: 0,0:21:43.36,0:21:44.15,Default,,0,0,0,,Ne?
Dialogue: 0,0:21:44.15,0:21:47.03,Default,,0,0,0,,Topu alıp sana pas atacağım.
Dialogue: 0,0:21:47.03,0:21:48.37,Default,,0,0,0,,Misaki-kun...
Dialogue: 0,0:21:50.03,0:21:55.29,Default,,0,0,0,,{\i1}Evet, bacağım yaralı olduğundan\Natak ve defans arasında gidip gelemem.{\i0}
Dialogue: 0,0:21:55.29,0:21:59.04,Default,,0,0,0,,{\i1}Ama herkesin çabasına güvenebilirim.{\i0}
Dialogue: 0,0:21:59.04,0:22:04.36,Default,,0,0,0,,{\i1}Meiwa şu an atağa odaklı\Nolduğundan defansı unutmuş durumda.{\i0}
Dialogue: 0,0:22:04.36,0:22:08.26,Default,,0,0,0,,{\i1}Bu yüzden çocuklar topu alıp\Nbana pas atarsa...{\i0}
Dialogue: 0,0:22:08.30,0:22:11.43,Default,,0,0,0,,{\i1}...tek rakibim Wakashimazu-kun olacak.{\i0}
Dialogue: 0,0:22:11.43,0:22:14.63,Default,,0,0,0,,{\i1}Bu bacakla bile gol atabilirim.{\i0}
Dialogue: 0,0:22:14.63,0:22:18.78,Default,,0,0,0,,{\i1}Bir kontra atakla tekrardan\Nliderliği alacağız.{\i0}
Dialogue: 0,0:23:50.07,0:24:00.68,Default,,0,0,0,,Gelecek 25. Bölümde:\NKontra Atak Vakti
Dialogue: 0,0:02:04.01,0:02:09.60,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:02:09.60,0:02:14.27,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:02:15.52,0:02:20.19,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:02:21.07,0:02:28.78,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:02:28.78,0:02:34.54,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:02:34.54,0:02:43.30,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:02:43.30,0:02:48.85,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:02:48.85,0:02:54.77,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:02:54.77,0:02:56.44,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:02:56.44,0:03:03.65,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:03:03.65,0:03:06.66,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:03:06.66,0:03:11.08,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:02:04.01,0:02:09.60,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:02:09.60,0:02:14.27,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:02:15.52,0:02:20.19,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:02:21.07,0:02:28.78,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:02:28.78,0:02:34.54,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:02:34.54,0:02:43.30,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:02:43.30,0:02:48.85,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:02:48.85,0:02:54.77,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:02:54.77,0:02:56.44,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:02:56.44,0:03:03.65,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo
Dialogue: 0,0:03:03.65,0:03:06.66,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:03:06.66,0:03:11.08,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Romaji,,0,0,0,,chotto aremi na eesu ga tooru
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Romaji,,0,0,0,,suguremono da to machijuu sawagu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Romaji,,0,0,0,,chochou sanba, jiguzagu sanba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Romaji,,0,0,0,,aitsu no uwasa de chanba mo hashiru
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Romaji,,0,0,0,,sore ni tsukete mo oretacha nan darou
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Romaji,,0,0,0,,booru hitotsu ni kirikiri mai sa
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Romaji,,0,0,0,,itsuka kimeru ze, inazuma shuuto
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Romaji,,0,0,0,,son toki ore ga suupaa hiiroo sa
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Romaji,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Türkçe,,0,0,0,,sert bakışıyla geçiyor bir yıldız
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Türkçe,,0,0,0,,tüm şehir söylüyor harika birisi olduğunu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Türkçe,,0,0,0,,kelebek sambası, zikzak samba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Türkçe,,0,0,0,,onun hakkındaki söylentiler\Nsambayı bile harekete geçiriyor
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Türkçe,,0,0,0,,onun aksine bizim burada olma sebebimiz
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Türkçe,,0,0,0,,top için delirmek
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Türkçe,,0,0,0,,bir gün şimşek gibi vuruşum hedefine ulaşacak
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Türkçe,,0,0,0,,o an bir süper kahraman olacağım işte ben
