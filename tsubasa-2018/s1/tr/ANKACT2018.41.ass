Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:01.81,0:00:05.22,Default,,0,0,0,,{\i1}Ulusal Ortaokul Futbol Turnuvası'nın çeyrek{\i0}
Dialogue: 0,0:00:05.22,0:00:07.65,Default,,0,0,0,,{\i1}finallerinin son maçı neredeyse başlamak üzere.{\i0}
Dialogue: 0,0:00:07.65,0:00:08.73,Default,,0,0,0,,{\pos(972,856)}HOKKAIDO TEMSİLCİSİ \NFURANO ORTAOKULU
Dialogue: 0,0:00:08.73,0:00:09.94,Default,,0,0,0,,{\pos(932,852)}TOKYO TEMSİLCİSİ \NTOHO AKADEMİSİ
Dialogue: 0,0:00:09.94,0:00:11.11,Default,,0,0,0,,{\pos(948,856)}SAITAMA PREFECTURE TEMSİLCİSİ \NMEIWA HIGASHI ORTAOKULU
Dialogue: 0,0:00:08.14,0:00:10.67,Default-TOP,,0,0,0,,{\i1}Üç takım en iyi dörde ulaştı,{\i0}
Dialogue: 0,0:00:10.67,0:00:13.61,Default-TOP,,0,0,0,,{\i1}sadece bu önemli maçı oynayanlar kaldı.{\i0}
Dialogue: 0,0:00:13.61,0:00:17.16,Default,,0,0,0,,{\i1}Çeyrek finallerin dördüncü karşılaşması, Shizuoka'dan {\i0}
Dialogue: 0,0:00:17.16,0:00:20.66,Default,,0,0,0,,{\i1}Nankatsu ile Nagasaki'den Hirado arasında yapılacak.{\i0}
Dialogue: 0,0:00:20.66,0:00:23.11,Default,,0,0,0,,Bunu bekliyorduk Nankatsu!
Dialogue: 0,0:00:23.11,0:00:24.83,Default,,0,0,0,,Sana yine güveniyoruz, Tsubasa!
Dialogue: 0,0:00:25.74,0:00:27.65,Default,,0,0,0,,Yani bu şampiyon Nankatsu ha.
Dialogue: 0,0:00:27.65,0:00:29.13,Default,,0,0,0,,Nihayet zamanı geldi.
Dialogue: 0,0:00:29.13,0:00:31.26,Default,,0,0,0,,{\i1}Görünüşe göre Hirado oyunu başlatacak.{\i0}
Dialogue: 0,0:00:33.17,0:00:34.89,Default,,0,0,0,,{\i1}Sakin bir gülümseme.{\i0}
Dialogue: 0,0:00:34.89,0:00:39.31,Default,,0,0,0,,{\i1}Hirado'nun şu ana kadar göstermediği bir kartı var.{\i0}
Dialogue: 0,0:00:39.31,0:00:41.68,Default,,0,0,0,,Tam gaz başlıyoruz,bilirsin.
Dialogue: 0,0:00:43.98,0:00:58.98,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \Nİnstagram: AnimeSeverlerrr
Dialogue: 0,0:02:14.44,0:02:19.45,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}41.BÖLÜM: \NKORKUNÇ KARANLIK AT
Dialogue: 0,0:02:16.15,0:02:18.40,Default-TOP,,0,0,0,,{\i1}Nankatsu geçen yılın şampiyonu{\i0}
Dialogue: 0,0:02:18.40,0:02:20.61,Default-TOP,,0,0,0,,{\i1}ve üçüncü zaferlerini hedefliyorlar.{\i0}
Dialogue: 0,0:02:20.61,0:02:23.41,Default,,0,0,0,,{\i1}Bugün her zamanki başlangıç üyelerini kullanıyorlar.{\i0}
Dialogue: 0,0:02:23.41,0:02:25.51,Default,,0,0,0,,{\i1}Rakipleri Hirado, şimdiye kadar{\i0}
Dialogue: 0,0:02:25.51,0:02:27.62,Default,,0,0,0,,{\i1}tüm maçlarını 1-0 skorla kazandı.{\i0}
Dialogue: 0,0:02:27.62,0:02:30.17,Default,,0,0,0,,{\i1}Çok gol atmamış olsalar da, Hirado{\i0}
Dialogue: 0,0:02:30.17,0:02:32.72,Default,,0,0,0,,{\i1} güçlü savunmalarıyla tanınıyor.{\i0}
Dialogue: 0,0:02:32.72,0:02:34.88,Default,,0,0,0,,{\i1}Şampiyon Nankatsu ve öfkeli{\i0}
Dialogue: 0,0:02:34.88,0:02:37.05,Default,,0,0,0,,{\i1}saldırılarını nasıl idare edecekler?{\i0}
Dialogue: 0,0:02:37.05,0:02:39.55,Default,,0,0,0,,{\i1}Bunlar maçın anahatları.{\i0}
Dialogue: 0,0:02:39.55,0:02:44.64,Default,,0,0,0,,{\i1}En iyi dörtteki son yer için oyun şimdi başlıyor!{\i0}
Dialogue: 0,0:02:46.21,0:02:50.14,Default,,0,0,0,,{\i1}Düdük öttüğünde, orta forvet Sano hızla sahada ilerliyor.{\i0}
Dialogue: 0,0:02:53.62,0:02:57.49,Default,,0,0,0,,{\i1}Hirado paslaşıyor ve topu kendi tarafında döndürüyor,{\i0}
Dialogue: 0,0:02:57.49,0:03:01.07,Default,,0,0,0,,{\i1}dikkatle saldırı için zaman bekliyor.{\i0}
Dialogue: 0,0:03:01.07,0:03:03.50,Default,,0,0,0,,Bu ne demek oluyor? Yani gelmeyecekler mi?
Dialogue: 0,0:03:03.50,0:03:05.62,Default,,0,0,0,,O zaman biz gitmeliyiz!
Dialogue: 0,0:03:06.22,0:03:09.50,Default,,0,0,0,,{\i1}Nankatsu takımından Taki topu hızla çaldı!{\i0}
Dialogue: 0,0:03:09.50,0:03:11.02,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:03:13.33,0:03:14.59,Default,,0,0,0,,Geçeceğim!
Dialogue: 0,0:03:17.38,0:03:18.09,Default,,0,0,0,,Taki!
Dialogue: 0,0:03:18.09,0:03:20.99,Default,,0,0,0,,{\i1}Taki onu geçmeye çalıştı, ama çok{\i0}
Dialogue: 0,0:03:20.99,0:03:23.93,Default,,0,0,0,,{\i1}hızlı gitti ve Jito'nun dev bedenine çarptı.{\i0}
Dialogue: 0,0:03:23.93,0:03:25.75,Default,,0,0,0,,Tamam, size Hirado'nun gerçek
Dialogue: 0,0:03:25.75,0:03:27.56,Default,,0,0,0,,gücünü göstermeliyim, bilirsin!
Dialogue: 0,0:03:28.61,0:03:31.09,Default,,0,0,0,,Dikkat et, Morisaki! Şut çekecek!
Dialogue: 0,0:03:31.09,0:03:31.60,Default,,0,0,0,,Ne—
Dialogue: 0,0:03:35.40,0:03:36.52,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:03:37.41,0:03:38.92,Default,,0,0,0,,{\i1}Jito bizi şaşırtıyor! {\i0}
Dialogue: 0,0:03:38.92,0:03:42.74,Default,,0,0,0,,{\i1}Santra çizgisinden pervasızca uzun bir şut çekiyor!{\i0}
Dialogue: 0,0:03:42.74,0:03:43.66,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:43.66,0:03:46.03,Default,,0,0,0,,{\i1}Bu tekme gerçekten güçlü.{\i0}
Dialogue: 0,0:03:46.03,0:03:48.91,Default,,0,0,0,,{\i1}Roket top Nankatsu'nun kalesine yaklaşıyor.{\i0}
Dialogue: 0,0:03:48.91,0:03:49.91,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:03:49.91,0:03:51.91,Default,,0,0,0,,Tamam, bunu alabilirim!
Dialogue: 0,0:03:54.58,0:03:55.21,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:56.21,0:03:59.30,Default,,0,0,0,,{\i1}Bu... Gol!{\i0}
Dialogue: 0,0:04:01.05,0:04:03.75,Default,,0,0,0,,{\i1}Sano, kale önüne yandan zıpladı ve{\i0}
Dialogue: 0,0:04:03.75,0:04:06.47,Default,,0,0,0,,{\i1}Jito'nun şutunu yönlendirerek golü attı!{\i0}
Dialogue: 0,0:04:06.47,0:04:09.18,Default,,0,0,0,,{\i1}Hirado göz açıp kapayıncaya kadar ilk golü attı!{\i0}
Dialogue: 0,0:04:09.18,0:04:11.86,Default,,0,0,0,,{\i1}Bu turnuvada Hirado, Minamiuwa'dan hemen{\i0}
Dialogue: 0,0:04:11.86,0:04:14.52,Default,,0,0,0,,{\i1}sonra ikinci karanlık at olarak kabul edilir.{\i0}
Dialogue: 0,0:04:18.07,0:04:20.87,Default,,0,0,0,,Bu benim ve Sano'nun kombinasyon oyunu, bilirsin!
Dialogue: 0,0:04:20.87,0:04:26.11,Default,,0,0,0,,Şampiyon Nankatsu bile böyle ucuz bir numaraya kandı.
Dialogue: 0,0:04:27.85,0:04:29.76,Default,,0,0,0,,Lanet olsun...
Dialogue: 0,0:04:29.76,0:04:31.91,Default,,0,0,0,,Oyun daha yeni başladı.
Dialogue: 0,0:04:31.91,0:04:34.66,Default,,0,0,0,,Bizden bir puan alırlarsa, bizde onu geri almalıyız.
Dialogue: 0,0:04:34.66,0:04:36.25,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:04:36.25,0:04:38.25,Default,,0,0,0,,Sadece şanslı bir vuruştu!
Dialogue: 0,0:04:38.25,0:04:39.52,Default,,0,0,0,,Aldırmayın!
Dialogue: 0,0:04:39.52,0:04:42.47,Default,,0,0,0,,Böyle bir takıma hiçbir zaman yetişemezsiniz!
Dialogue: 0,0:04:43.79,0:04:45.47,Default,,0,0,0,,Tekrar havaya girelim ve geri dönelim!
Dialogue: 0,0:04:45.47,0:04:46.77,Default,,0,0,0,,Tsubasa haklı!
Dialogue: 0,0:04:46.77,0:04:48.68,Default,,0,0,0,,Eğer gol atarlarsa, hemen geri döneriz!
Dialogue: 0,0:04:49.50,0:04:52.68,Default,,0,0,0,,Ben, Büyük Jito, tek bir gol\N bile atmanıza izin vermeyeceğim!
Dialogue: 0,0:04:54.19,0:04:55.35,Default,,0,0,0,,Dikkat et Kisugi!
Dialogue: 0,0:04:56.30,0:04:58.60,Default,,0,0,0,,{\i1}Ne kadar inanılmaz bir güç!{\i0}
Dialogue: 0,0:04:58.60,0:05:01.40,Default,,0,0,0,,{\i1}Jito büyük bir güçle Kisugi'yi hezimete{\i0}
Dialogue: 0,0:05:01.40,0:05:04.15,Default,,0,0,0,,{\i1}uğratıyor topu ayağından çalıyor!{\i0}
Dialogue: 0,0:05:04.15,0:05:07.52,Default,,0,0,0,,{\i1}Ancak Tsubasa gevşek topu almak için burada.{\i0}
Dialogue: 0,0:05:07.52,0:05:09.58,Default,,0,0,0,,Pekala. Önce eşitlik golünü atalım!
Dialogue: 0,0:05:13.20,0:05:15.33,Default,,0,0,0,,{\i1}Noda ön cepheden yaklaşıyor.{\i0}
Dialogue: 0,0:05:18.29,0:05:19.38,Default,,0,0,0,,Şimdi!
Dialogue: 0,0:05:19.38,0:05:23.09,Default,,0,0,0,,Güçlü savunmamın tadına bak!
Dialogue: 0,0:05:25.01,0:05:25.76,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:05:25.76,0:05:26.76,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:05:26.76,0:05:29.60,Default,,0,0,0,,Bu kötü! Omzuna o kadar sert vurulursa...
Dialogue: 0,0:05:30.60,0:05:33.77,Default,,0,0,0,,{\i1}Jito topu alıyor ve ilerlemeye devam ediyor.{\i0}
Dialogue: 0,0:05:33.77,0:05:35.32,Default,,0,0,0,,{\i1}Şiddetli hamlesi, on sekiz tekerlekli hızlı{\i0}
Dialogue: 0,0:05:35.32,0:05:36.82,Default,,0,0,0,,{\i1}bir araba gibi görünmesini sağlıyor.{\i0}
Dialogue: 0,0:05:36.82,0:05:38.52,Default,,0,0,0,,İkinci gol için geliyorum, bilirsin!
Dialogue: 0,0:05:38.52,0:05:39.65,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:05:39.65,0:05:42.07,Default,,0,0,0,,Küçük numaraların bende işe yaramaz, bilirsin!
Dialogue: 0,0:05:43.48,0:05:45.78,Default,,0,0,0,,{\i1}Sanki on sekiz tekerlekli araba ile çarpışan{\i0}
Dialogue: 0,0:05:45.78,0:05:48.07,Default,,0,0,0,,{\i1}küçük bir araba gibi havaya uçtu!{\i0}
Dialogue: 0,0:05:48.07,0:05:50.78,Default,,0,0,0,,Kayarak müdahalenin bile \Nonun üzerinde etkisi olmaması inanılmaz...!
Dialogue: 0,0:05:50.78,0:05:54.16,Default,,0,0,0,,Yıkıcı gücü, Hyuga'nın top sürmesinden bile daha güçlü.
Dialogue: 0,0:05:54.50,0:05:56.33,Default,,0,0,0,,Jito...
Dialogue: 0,0:05:56.33,0:05:57.95,Default,,0,0,0,,Hangimizin aldığı önemli değil!
Dialogue: 0,0:05:57.95,0:05:59.08,Default,,0,0,0,,Acele edin ve onu durdurun!
Dialogue: 0,0:05:59.08,0:06:02.92,Default,,0,0,0,,Ondan önce şut çekeyim, bilirsin!
Dialogue: 0,0:06:04.46,0:06:09.72,Default,,0,0,0,,{\i1}Jito, santra çizgisinden uzun bir atış yapıyor!{\i0}
Dialogue: 0,0:06:11.05,0:06:14.16,Default,,0,0,0,,Yine aynı numaraya düşeceğimizi mi sandın?!
Dialogue: 0,0:06:14.16,0:06:16.60,Default,,0,0,0,,Bizi aptal yerine koyma!
Dialogue: 0,0:06:16.60,0:06:18.80,Default,,0,0,0,,{\i1}Nankatsu'nun gözüpek Ishizaki'si{\i0}
Dialogue: 0,0:06:18.80,0:06:21.06,Default,,0,0,0,,{\i1}şuta yüzünü siper ediyor ve engelliyor!{\i0}
Dialogue: 0,0:06:21.06,0:06:22.98,Default,,0,0,0,,Güzel, Ishizaki!
Dialogue: 0,0:06:26.88,0:06:29.73,Default,,0,0,0,,Kaptanımız yavaş yavaş ciddileşiyor gibi görünüyor.
Dialogue: 0,0:06:29.73,0:06:32.24,Default,,0,0,0,,Belki ben de ciddi olmalıyım.
Dialogue: 0,0:06:32.66,0:06:35.24,Default,,0,0,0,,"{\i1}Ciddi olmak{\i0}" hakkında ne düşünüyorsun, serseri?!
Dialogue: 0,0:06:37.79,0:06:39.32,Default,,0,0,0,,Ishizaki'yi koru!
Dialogue: 0,0:06:39.32,0:06:40.17,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:43.29,0:06:44.38,Default,,0,0,0,,{\i1}Ama o...{\i0}
Dialogue: 0,0:06:44.50,0:06:47.17,Default,,0,0,0,,{\i1}3 oyuncu bile onu durduramıyor!{\i0}
Dialogue: 0,0:06:48.92,0:06:50.76,Default,,0,0,0,,Millet, Jito geliyor!
Dialogue: 0,0:06:52.94,0:06:54.68,Default,,0,0,0,,Gerçekten bakışlarınızı çevirmeli misiniz?
Dialogue: 0,0:06:56.06,0:06:57.81,Default,,0,0,0,,Bu kötü! Şut çekmesine izin vermeyin!
Dialogue: 0,0:06:59.61,0:07:00.69,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:00.69,0:07:02.94,Default,,0,0,0,,{\i1}Sano rakiplerinin önüne geçiyor ve pas veriyor!{\i0}
Dialogue: 0,0:07:02.94,0:07:06.48,Default,,0,0,0,,{\i1}Yine de, Nankatsu Jito'yu tamamen yalnız bırakmadı.{\i0}
Dialogue: 0,0:07:07.38,0:07:08.96,Default,,0,0,0,,Anlamadın mı?
Dialogue: 0,0:07:08.96,0:07:11.24,Default,,0,0,0,,Senin gibi küçük serseriler beni takip etse de,
Dialogue: 0,0:07:12.32,0:07:13.70,Default,,0,0,0,,faydası yok...
Dialogue: 0,0:07:13.70,0:07:14.95,Default,,0,0,0,,Bilirsin!
Dialogue: 0,0:07:16.65,0:07:20.33,Default,,0,0,0,,{\i1}Jito tutucusunu yok sayar ve güçlü bir şut çeker!{\i0}
Dialogue: 0,0:07:21.75,0:07:24.59,Default,,0,0,0,,{\i1}Bu sefer, kısa mesafeden güçlü bir şut bu!{\i0}
Dialogue: 0,0:07:25.92,0:07:29.89,Default,,0,0,0,,{\i1}Tuttu! Morisaki topu sıkıca\N yakalamak için tüm vücudunu kullanıyor!{\i0}
Dialogue: 0,0:07:29.89,0:07:31.34,Default,,0,0,0,,Aferin Morisaki!
Dialogue: 0,0:07:38.58,0:07:42.81,Default,,0,0,0,,{\i1}Neydi o? Kaleci kaleye doğru uçtu!{\i0}
Dialogue: 0,0:07:42.81,0:07:44.13,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:44.13,0:07:45.06,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:07:45.06,0:07:47.48,Default,,0,0,0,,{\i1}Ne inanılmaz bir güç!{\i0}
Dialogue: 0,0:07:47.48,0:07:49.73,Default,,0,0,0,,{\i1}Ne inanılmaz yıkıcı bir güç!{\i0}
Dialogue: 0,0:07:49.73,0:07:51.88,Default,,0,0,0,,{\i1}Hirado, kaptan Jito'nun güçlü vuruşu{\i0}
Dialogue: 0,0:07:51.88,0:07:53.99,Default,,0,0,0,,{\i1}sayesinde başka bir gol daha attı.{\i0}
Dialogue: 0,0:07:55.22,0:07:58.70,Default,,0,0,0,,{\i1}İlk turnuvaları gibi görünmesine rağmen,{\i0}
Dialogue: 0,0:07:58.70,0:08:01.83,Default,,0,0,0,,{\i1}Hirado Şampiyon Nankatsu'ya iki gol atıyor!{\i0}
Dialogue: 0,0:08:01.83,0:08:05.13,Default,,0,0,0,,{\i1}Nankatsu, hiçbir zaman başlangıçtan beri{\i0}
Dialogue: 0,0:08:05.13,0:08:08.46,Default,,0,0,0,,{\i1}iki gol geride kaldığı zor bir duruma düşmedi.{\i0}
Dialogue: 0,0:08:08.46,0:08:12.26,Default,,0,0,0,,{\i1}Ardışık üçüncü zaferlerine giden yolda bu sarı bir ışık mı?{\i0}
Dialogue: 0,0:08:12.26,0:08:14.67,Default,,0,0,0,,Bu ikinci gol sert bir darbe oldu.
Dialogue: 0,0:08:14.67,0:08:15.26,Default,,0,0,0,,Ne—
Dialogue: 0,0:08:16.15,0:08:17.76,Default,,0,0,0,,{\i1}Hirado'nun ikinci golü, Jito ve Sano'nun{\i0}
Dialogue: 0,0:08:17.76,0:08:19.37,Default,,0,0,0,,{\i1}şaşırtıcı kombo oyunundan geldi,{\i0}
Dialogue: 0,0:08:19.37,0:08:22.81,Default,,0,0,0,,{\i1}güç ve inceliği bir araya getiren şu ana kadarki gizli bir stil.{\i0}
Dialogue: 0,0:08:22.81,0:08:25.69,Default,,0,0,0,,{\i1}Özellikle aralarından kaptan Jito, herhangi bir{\i0}
Dialogue: 0,0:08:25.69,0:08:28.57,Default,,0,0,0,,{\i1}ortaokul öğrencisini aşan yıkıcı bir güç gösterdi,{\i0}
Dialogue: 0,0:08:28.57,0:08:31.00,Default,,0,0,0,,{\i1}ve rakipleri, şampiyon Nankatsu'ya karşı{\i0}
Dialogue: 0,0:08:31.00,0:08:33.40,Default,,0,0,0,,{\i1}büyük bir etki yarattığını gösterdi.{\i0}
Dialogue: 0,0:08:33.40,0:08:35.93,Default,,0,0,0,,{\i1}Hirado kelimenin tam anlamıyla karanlık bir at!{\i0}
Dialogue: 0,0:08:35.93,0:08:38.49,Default,,0,0,0,,{\i1}Korkunç dişlerini saklıyorlardı.{\i0}
Dialogue: 0,0:08:38.49,0:08:40.06,Default,,0,0,0,,Bunu gördün mü, Nankatsu?
Dialogue: 0,0:08:40.06,0:08:42.00,Default,,0,0,0,,Bu Hirado'nun gerçek gücü!
Dialogue: 0,0:08:42.00,0:08:45.04,Default,,0,0,0,,Dev katil dediğimiz Hirado bu işte.
Dialogue: 0,0:08:45.04,0:08:46.07,Default,,0,0,0,,Ne...?
Dialogue: 0,0:08:46.07,0:08:49.09,Default,,0,0,0,,Nagasakideki ön eleme sırasında Kyushu'da böyle davrandılar.
Dialogue: 0,0:08:49.74,0:08:53.69,Default,,0,0,0,,Karşı konulmaz favori olan Saikai MS'i 
Dialogue: 0,0:08:53.69,0:08:57.64,Default,,0,0,0,,finalde 6-0 skorla yenen Hirado oldu.
Dialogue: 0,0:08:57.64,0:09:01.14,Default,,0,0,0,,Hirado maçlarında gevşekti, ancak bu maç
Dialogue: 0,0:09:01.14,0:09:04.64,Default,,0,0,0,,için inanılmaz güçlerini ortaya çıkardılar.
Dialogue: 0,0:09:04.69,0:09:09.94,Default,,0,0,0,,Yani, Hirado şu ana kadar ki bütün maçlarını 1-0 kazandı...
Dialogue: 0,0:09:09.94,0:09:12.45,Default,,0,0,0,,Onlar için, rakiplerinin hiçbirine gerçek
Dialogue: 0,0:09:12.45,0:09:14.96,Default,,0,0,0,,saldırı güçlerini göstermeye değmezdi.
Dialogue: 0,0:09:15.70,0:09:18.02,Default,,0,0,0,,Rakiplerinin seviyesi ne kadar yüksekse,
Dialogue: 0,0:09:18.02,0:09:20.32,Default,,0,0,0,,Hirado MS o kadar güçlü oluyor.
Dialogue: 0,0:09:20.32,0:09:26.70,Default,,0,0,0,,Ve rakipleri güçlendikçe, Hiroshi Jito daha da gaza geliyor.
Dialogue: 0,0:09:26.70,0:09:29.07,Default,,0,0,0,,Hadi, Nankatsu.
Dialogue: 0,0:09:29.07,0:09:32.77,Default,,0,0,0,,Oyun böyle biterse hiç eğlenceli olmayacak.
Dialogue: 0,0:09:32.77,0:09:33.63,Default,,0,0,0,,Ne?
Dialogue: 0,0:09:33.63,0:09:36.93,Default,,0,0,0,,Biraz metanet bile göstermiyorsan,
Dialogue: 0,0:09:36.93,0:09:41.20,Default,,0,0,0,,Kyushu'dan buraya neden \Ngeldiğimi göremeyeceğim,bilirsin?
Dialogue: 0,0:09:44.20,0:09:46.77,Default,,0,0,0,,Lanet olsun. Sadece izle, Jito!
Dialogue: 0,0:09:49.79,0:09:54.79,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:09:55.20,0:10:00.95,Default,,0,0,0,,{\i1}Hirado MS, korkunç güçlerini \Ngizledikleri gizemli perdeyi açtı.{\i0}
Dialogue: 0,0:10:00.95,0:10:04.75,Default,,0,0,0,,{\i1}Şu anda, Şampiyon Nankatsu iki \Ngollük arayı kapatmayı hedefliyor.{\i0}
Dialogue: 0,0:10:04.75,0:10:06.75,Default,,0,0,0,,Geride olduğunuzda tezahürat en önemli şeydir!
Dialogue: 0,0:10:06.75,0:10:08.69,Default,,0,0,0,,Millet, yüksek sesle bağırın!
Dialogue: 0,0:10:08.69,0:10:09.59,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:09.59,0:10:11.62,Default,,0,0,0,,Nankatsu'yu küçümseme!
Dialogue: 0,0:10:11.62,0:10:14.42,Default,,0,0,0,,Burada kaybedecekler siz değilsiniz!
Dialogue: 0,0:10:14.42,0:10:16.13,Default,,0,0,0,,{\i1}Doğru.{\i0}
Dialogue: 0,0:10:16.13,0:10:17.42,Default,,0,0,0,,{\i1}Biz nasıl...{\i0}
Dialogue: 0,0:10:18.08,0:10:20.22,Default,,0,0,0,,{\i1}Burada nasıl kaybedebiliriz?!{\i0}
Dialogue: 0,0:10:21.65,0:10:23.01,Default,,0,0,0,,Hadi gidelim millet!
Dialogue: 0,0:10:23.01,0:10:23.85,Default,,0,0,0,,Evet!
Dialogue: 0,0:10:23.85,0:10:26.02,Default,,0,0,0,,{\i1}Oh, Hirado MS sahanın merkezini{\i0}
Dialogue: 0,0:10:26.02,0:10:28.19,Default,,0,0,0,,{\i1}doldurdu ve savunmasını sıkılaştırdı!{\i0}
Dialogue: 0,0:10:28.19,0:10:30.30,Default,,0,0,0,,Yani gerçekten savunmalarına odaklanacaklar...
Dialogue: 0,0:10:30.30,0:10:31.19,Default,,0,0,0,,Hah?
Dialogue: 0,0:10:31.19,0:10:35.40,Default,,0,0,0,,Hirado rakiplerine sayı vermedi\N ve bu turnuvada sıfır gol yedi.
Dialogue: 0,0:10:35.40,0:10:38.78,Default,,0,0,0,,Bu onların savunmada ne\N kadar emin olduklarını gösteriyor.
Dialogue: 0,0:10:38.78,0:10:42.49,Default,,0,0,0,,2 gol önde olmanın müthiş bir\N darbe olduğunu söylemiştim.
Dialogue: 0,0:10:42.49,0:10:44.46,Default,,0,0,0,,Pekala, gidiyoruz!
Dialogue: 0,0:10:45.24,0:10:48.58,Default,,0,0,0,,{\i1}Nankatsu’nun tarafında, Taki ve\N Kisugi’nin hareketleri biraz ağır.{\i0}
Dialogue: 0,0:10:48.58,0:10:52.29,Default,,0,0,0,,{\i1}Jito'yla olan karşılaşmalarında kendilerini yaraladılar mı?{\i0}
Dialogue: 0,0:10:52.29,0:10:53.88,Default,,0,0,0,,Kisugi! Taki!
Dialogue: 0,0:10:54.96,0:10:56.63,Default,,0,0,0,,{\i1}Benimde omzum yaralandı!{\i0}
Dialogue: 0,0:10:56.63,0:10:57.88,Default,,0,0,0,,{\i1}İşte bu.{\i0}
Dialogue: 0,0:10:57.88,0:11:00.61,Default,,0,0,0,,Gidin! Tsubasa'yı ezin!
Dialogue: 0,0:11:00.61,0:11:01.64,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:03.97,0:11:04.81,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:11:05.43,0:11:07.73,Default,,0,0,0,,{\i1}Tsubasa sıyrılıyor!{\i0}
Dialogue: 0,0:11:07.73,0:11:08.31,Default,,0,0,0,,Izawa!
Dialogue: 0,0:11:09.16,0:11:09.73,Default,,0,0,0,,Al hadi!
Dialogue: 0,0:11:09.73,0:11:10.77,Default,,0,0,0,,{\i1}Yaptılar!{\i0}
Dialogue: 0,0:11:10.77,0:11:13.85,Default,,0,0,0,,{\i1}Tsubasa ve Izawa arasında güzel bir ikili pas.{\i0}
Dialogue: 0,0:11:13.85,0:11:15.36,Default,,0,0,0,,Izawa, kalenin önüne geç!
Dialogue: 0,0:11:15.36,0:11:16.19,Default,,0,0,0,,Tabii!
Dialogue: 0,0:11:16.19,0:11:20.03,Default,,0,0,0,,{\i1}Tsubasa onun için nadir olan yan çizgiye top sürüyor.{\i0}
Dialogue: 0,0:11:20.03,0:11:22.76,Default,,0,0,0,,Hatayama, 8 numara için sana güveniyorum.
Dialogue: 0,0:11:22.76,0:11:24.59,Default,,0,0,0,,Diğer adamı tutacağım, bilirsin.
Dialogue: 0,0:11:24.59,0:11:25.37,Default,,0,0,0,,Tabii ki.
Dialogue: 0,0:11:26.56,0:11:27.71,Default,,0,0,0,,İşte gidiyor!
Dialogue: 0,0:11:27.71,0:11:30.04,Default,,0,0,0,,{\i1}Tsubasa kalenin önüne bir orta gönderiyor!{\i0}
Dialogue: 0,0:11:30.04,0:11:33.63,Default,,0,0,0,,{\i1}Topu, kafa vuruşunda maharetiyle tanınan İzawa'ya mı gönderiyor?{\i0}
Dialogue: 0,0:11:34.88,0:11:35.88,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:35.88,0:11:36.46,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:11:37.34,0:11:39.36,Default,,0,0,0,,{\i1}Izawa bir tuzaktı!{\i0}
Dialogue: 0,0:11:39.36,0:11:42.30,Default,,0,0,0,,{\i1}Nagano için mükemmel bir orta!{\i0}
Dialogue: 0,0:11:42.30,0:11:43.30,Default,,0,0,0,,Tamam başardım!
Dialogue: 0,0:11:43.30,0:11:44.80,Default,,0,0,0,,Sana izin vermeyeceğim, bilirsin!
Dialogue: 0,0:11:44.80,0:11:48.17,Default,,0,0,0,,{\i1}Fakat Jito Nagano'yu durdurdu.{\i0}
Dialogue: 0,0:11:48.17,0:11:50.06,Default,,0,0,0,,{\i1} Nankatsu gol atamadı!{\i0}
Dialogue: 0,0:11:50.06,0:11:52.27,Default,,0,0,0,,{\i1}Takeno serbest topu alıyor.{\i0}
Dialogue: 0,0:11:52.27,0:11:53.94,Default,,0,0,0,,{\i1}Öne uzun bir pas gönderiyor!{\i0}
Dialogue: 0,0:11:54.43,0:11:56.64,Default,,0,0,0,,{\i1}Sano'ya ulaşıyor!{\i0}
Dialogue: 0,0:11:57.27,0:11:58.78,Default,,0,0,0,,Millet, lütfen, durdurun onu!
Dialogue: 0,0:11:58.78,0:12:00.90,Default,,0,0,0,,Bana bırak!
Dialogue: 0,0:12:06.00,0:12:08.50,Default,,0,0,0,,Biz, Nankatsu defansları aynı şeyle tekrar
Dialogue: 0,0:12:08.50,0:12:10.91,Default,,0,0,0,,tekrar yenebileceğiniz türden insanlar değiliz!
Dialogue: 0,0:12:10.91,0:12:12.29,Default,,0,0,0,,Güzel, Takasugi!
Dialogue: 0,0:12:12.29,0:12:15.12,Default,,0,0,0,,{\i1}Nankatsu daha fazla gol vermeyi reddediyor!{\i0}
Dialogue: 0,0:12:15.12,0:12:16.79,Default,,0,0,0,,{\i1}Takasugi ilerlemeye devam ediyor.{\i0}
Dialogue: 0,0:12:16.79,0:12:19.30,Default,,0,0,0,,{\i1}Ama Jito onunla karşılaşmaya geliyor!{\i0}
Dialogue: 0,0:12:19.30,0:12:20.47,Default,,0,0,0,,İşte geliyorum Jito!
Dialogue: 0,0:12:20.47,0:12:21.98,Default,,0,0,0,,Güç yarışmasında kaybetmeyeceğim!
Dialogue: 0,0:12:23.88,0:12:26.80,Default,,0,0,0,,{\i1}İki dev rakip arasında bir çarpışma!{\i0}
Dialogue: 0,0:12:32.82,0:12:37.61,Default,,0,0,0,,{\i1}Nankatsu, Takasugi'nin gücüyle bile Jito'yu geçemiyor!{\i0}
Dialogue: 0,0:12:38.97,0:12:40.00,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:40.00,0:12:43.61,Default,,0,0,0,,{\i1}Ah, Jito bu maçta ilk kez topu kaybetti.{\i0}
Dialogue: 0,0:12:43.61,0:12:47.13,Default,,0,0,0,,Topu Kaptandan çaldılar.
Dialogue: 0,0:12:47.13,0:12:47.62,Default,,0,0,0,,Heh.
Dialogue: 0,0:12:48.20,0:12:50.83,Default,,0,0,0,,Başka türlü ilginç olmazdı, bilirsin.
Dialogue: 0,0:12:52.86,0:12:55.50,Default,,0,0,0,,{\i1}Tsubasa, yaralı omzuna rağmen çok çalışıyor.{\i0}
Dialogue: 0,0:12:55.50,0:12:57.08,Default,,0,0,0,,{\i1}En azından bunu yapabiliriz!{\i0}
Dialogue: 0,0:12:57.08,0:12:59.46,Default,,0,0,0,,Buraya gönder, Tsubasa!
Dialogue: 0,0:12:59.46,0:13:01.71,Default,,0,0,0,,Bize gönder!
Dialogue: 0,0:13:02.80,0:13:04.84,Default,,0,0,0,,Tamam, size güveniyorum!
Dialogue: 0,0:13:05.96,0:13:06.89,Default,,0,0,0,,Hadi gidelim!
Dialogue: 0,0:13:08.04,0:13:09.51,Default,,0,0,0,,Kisugi!
Dialogue: 0,0:13:12.14,0:13:14.18,Default,,0,0,0,,{\i1}Kisugi topu yakalayamadı.{\i0}
Dialogue: 0,0:13:14.18,0:13:17.10,Default,,0,0,0,,{\i1}Hirado kolayca topu kontrol etti.{\i0}
Dialogue: 0,0:13:17.10,0:13:20.20,Default,,0,0,0,,Kisugi ve Taki'nin yerine, Shutetsu üçlüsünün
Dialogue: 0,0:13:20.20,0:13:23.28,Default,,0,0,0,,Mamoru Izawa'sı olarak geri ödeyeceğim!
Dialogue: 0,0:13:24.33,0:13:26.41,Default,,0,0,0,,{\i1}Izawa topu geri çaldı!{\i0}
Dialogue: 0,0:13:26.41,0:13:28.62,Default,,0,0,0,,{\i1}Maç saldırı ve savunma arasında değişmeye devam ediyor.{\i0}
Dialogue: 0,0:13:28.62,0:13:30.53,Default,,0,0,0,,Sanki daha ileri gitmene izin veririz!
Dialogue: 0,0:13:31.78,0:13:32.62,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:13:32.62,0:13:34.75,Default,,0,0,0,,{\i1}Top Izawa'dan uzaklaştı.{\i0}
Dialogue: 0,0:13:34.75,0:13:37.44,Default,,0,0,0,,{\i1}Tsubasa hızla kurtardı.{\i0}
Dialogue: 0,0:13:37.44,0:13:39.38,Default,,0,0,0,,{\i1}Tamam, işte ilk gol!{\i0}
Dialogue: 0,0:13:39.38,0:13:42.00,Default,,0,0,0,,Tek bir gol bile kabul etmeyeceğim!
Dialogue: 0,0:13:43.50,0:13:46.97,Default,,0,0,0,,{\i1}Tsubasa tam zamanında şut çekti!{\i0}
Dialogue: 0,0:13:52.25,0:13:54.98,Default,,0,0,0,,{\i1}Şutu direğe çarptı!{\i0}
Dialogue: 0,0:13:54.98,0:13:55.98,Default,,0,0,0,,Ne?!
Dialogue: 0,0:13:57.08,0:13:57.90,Default,,0,0,0,,{\i1}Ne şanssızlık!{\i0}
Dialogue: 0,0:13:57.90,0:13:59.69,Default,,0,0,0,,{\i1}Nankatsu gol atamadı.{\i0}
Dialogue: 0,0:13:59.69,0:14:02.41,Default,,0,0,0,,{\i1}Ayrıca, Tsubasa'nın yaralı sol omzunu{\i0}
Dialogue: 0,0:14:02.41,0:14:05.11,Default,,0,0,0,,{\i1}sert bir şekilde vuruduğu anlaşılıyor.{\i0}
Dialogue: 0,0:14:05.11,0:14:06.36,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:14:06.36,0:14:07.65,Default,,0,0,0,,Tsubasa senpai!
Dialogue: 0,0:14:07.65,0:14:09.93,Default,,0,0,0,,{\i1}Topa vurduğu anda, omzunu{\i0}
Dialogue: 0,0:14:09.93,0:14:12.23,Default,,0,0,0,,{\i1}Jito'nun yükünden korumaya çalıştı.{\i0}
Dialogue: 0,0:14:12.23,0:14:15.75,Default,,0,0,0,,{\i1}Bu nedenle, hafif bir değişiklik olsa da, şutu döndü.{\i0}
Dialogue: 0,0:14:16.78,0:14:18.12,Default,,0,0,0,,İşte, yolluyorum!
Dialogue: 0,0:14:18.12,0:14:20.88,Default,,0,0,0,,{\i1}Hirado karşı saldırısına başladı.{\i0}
Dialogue: 0,0:14:20.88,0:14:22.50,Default,,0,0,0,,Millet, hemen geri dönün!
Dialogue: 0,0:14:23.57,0:14:24.84,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:14:24.84,0:14:27.63,Default,,0,0,0,,{\i1}Tsubasa acı içinde ve ayakta duramıyor.{\i0}
Dialogue: 0,0:14:27.63,0:14:30.30,Default,,0,0,0,,{\i1}Hirado, avantajlı ve sert saldırılar yapıyor!{\i0}
Dialogue: 0,0:14:30.30,0:14:33.34,Default,,0,0,0,,Kisugi, savunmayı güçlendirerek hatalarımızı telafi edeceğiz!
Dialogue: 0,0:14:33.34,0:14:34.31,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:34.31,0:14:36.88,Default,,0,0,0,,{\i1}İki forvet Taki ve Kisugi umutsuzca saldırı{\i0}
Dialogue: 0,0:14:36.88,0:14:39.44,Default,,0,0,0,,{\i1}engellemek için Hirado'yu takip ediyorlar.{\i0}
Dialogue: 0,0:14:39.44,0:14:43.98,Default,,0,0,0,,{\i1}Bu arada, Sano Nakazato ve Ishizaki tarafından tutuldu.{\i0}
Dialogue: 0,0:14:46.44,0:14:50.28,Default,,0,0,0,,{\i1}Hirado, sahanın merkezinde durur ve bir açıklık arar.{\i0}
Dialogue: 0,0:14:50.69,0:14:52.07,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:14:52.07,0:14:53.18,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:14:53.18,0:14:54.39,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:14:54.39,0:14:55.83,Default,,0,0,0,,Tsubasa senpai!
Dialogue: 0,0:14:55.83,0:14:58.18,Default,,0,0,0,,{\i1}Her iki takım da ilk yarının son 5{\i0}
Dialogue: 0,0:14:58.18,0:15:00.54,Default,,0,0,0,,{\i1}dakikasında bir çıkmaza yakalanır.{\i0}
Dialogue: 0,0:15:01.13,0:15:03.92,Default,,0,0,0,,Sanırım öldürücü darbeyi yapmamın vakti geldi.
Dialogue: 0,0:15:03.92,0:15:05.88,Default,,0,0,0,,Bana gönder, bilirsin!
Dialogue: 0,0:15:05.88,0:15:06.71,Default,,0,0,0,,Jito!
Dialogue: 0,0:15:08.80,0:15:11.53,Default,,0,0,0,,Yine bir kombinasyon oyunu yapacaklar!
Dialogue: 0,0:15:11.53,0:15:13.94,Default,,0,0,0,,Sano'nun serbest kalmasına izin vermeyin!
Dialogue: 0,0:15:13.94,0:15:15.06,Default,,0,0,0,,Tamam!
Dialogue: 0,0:15:17.46,0:15:20.44,Default,,0,0,0,,Üzgünüm, ama bununla birlikte, ilk yarıda üçüncü gol olacak!
Dialogue: 0,0:15:20.44,0:15:23.72,Default,,0,0,0,,Şampiyon Nankatsu efsanesi, büyük
Dialogue: 0,0:15:23.72,0:15:27.01,Default,,0,0,0,,Hiroshi Jito tarafından ezilecek, bilirsin!
Dialogue: 0,0:15:29.78,0:15:32.50,Default,,0,0,0,,{\i1}Topa düzgün vuramadı mı acaba? {\i0}
Dialogue: 0,0:15:32.50,0:15:34.03,Default,,0,0,0,,{\i1}Top her zamanki gücüne sahip değil.{\i0}
Dialogue: 0,0:15:35.83,0:15:37.20,Default,,0,0,0,,Bu dönüş...
Dialogue: 0,0:15:37.20,0:15:39.10,Default,,0,0,0,,{\i1}Kaleci Morisaki ilk sıçramasından sonra{\i0}
Dialogue: 0,0:15:39.10,0:15:40.96,Default,,0,0,0,,{\i1}topu yakalamak için ortaya çıkıyor!{\i0}
Dialogue: 0,0:15:40.96,0:15:42.42,Default,,0,0,0,,Bu kadar!
Dialogue: 0,0:15:44.75,0:15:49.05,Default,,0,0,0,,{\i1}Jito görünüşe göre o topa bolca ters dönüş ekledi!{\i0}
Dialogue: 0,0:15:49.05,0:15:49.97,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:53.89,0:15:57.34,Default,,0,0,0,,{\i1}Sano'nun, Jito'nun ters dönüş pası ile senkronize{\i0}
Dialogue: 0,0:15:57.34,0:16:00.85,Default,,0,0,0,,{\i1}edilen voleybol şutu, Hirado'ya üçüncü bir gol attırdı!{\i0}
Dialogue: 0,0:16:01.76,0:16:08.86,Default,,0,0,0,,{\i1}Şampiyon Nankatsu, ilk yarıda üç skor geride kaldı!{\i0}
Dialogue: 0,0:16:08.86,0:16:09.59,Default,,0,0,0,,Başardınız!
Dialogue: 0,0:16:09.59,0:16:10.84,Default,,0,0,0,,Jito! Sano!
Dialogue: 0,0:16:10.84,0:16:12.61,Default,,0,0,0,,Bu maçı aldık!
Dialogue: 0,0:16:14.12,0:16:15.36,Default,,0,0,0,,Nankatsu...
Dialogue: 0,0:16:15.36,0:16:16.87,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:16:16.87,0:16:17.78,Default,,0,0,0,,Kaybedecek mi?
Dialogue: 0,0:16:22.41,0:16:25.30,Default,,0,0,0,,{\i1}Bu onlar için gerçekten büyük bir darbe oldu.{\i0}
Dialogue: 0,0:16:25.30,0:16:28.12,Default,,0,0,0,,{\i1}Nankatsu için V3'e ulaşma ve bir efsane olma yolunda{\i0}
Dialogue: 0,0:16:28.12,0:16:30.92,Default,,0,0,0,,{\i1}sakatlıklarla dolu zorlayan bir gol müydü?{\i0}
Dialogue: 0,0:16:32.29,0:16:35.72,Default,,0,0,0,,Sanırım futbol için hepsi bu kadar.
Dialogue: 0,0:16:36.25,0:16:38.62,Default,,0,0,0,,Bu çok sıkıcı, bilirsin.
Dialogue: 0,0:16:40.77,0:16:43.16,Default,,0,0,0,,Faydasız.
Dialogue: 0,0:16:43.16,0:16:44.39,Default,,0,0,0,,Kazanamam.
Dialogue: 0,0:16:46.65,0:16:50.85,Default,,0,0,0,,{\i1}Wakabayashi-kun, V3'ümüz şimdi \Nimkansız bir görev gibi görünüyor.{\i0}
Dialogue: 0,0:16:51.81,0:16:55.07,Default,,0,0,0,,{\i1}Misaki-kun, keşke burada olsaydın...{\i0}
Dialogue: 0,0:16:56.36,0:16:58.39,Default,,0,0,0,,{\i1}Üzgünüm, Roberto.{\i0}
Dialogue: 0,0:16:58.39,0:17:00.66,Default,,0,0,0,,{\i1}Her şeyden sonra sanırım kaybedeceğim. {\i0}
Dialogue: 0,0:17:03.66,0:17:05.21,Default,,0,0,0,,Tsubasa?
Dialogue: 0,0:17:05.79,0:17:06.92,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:17:06.92,0:17:08.60,Default,,0,0,0,,Neyin var Tsubasa?!
Dialogue: 0,0:17:08.60,0:17:09.77,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:10.92,0:17:13.92,Default,,0,0,0,,{\t(1570,$end,\1c&H000000&\3c&H000000&\2c&H000000&\4c&H000000&)}Tsubasa...!
Dialogue: 0,0:17:16.28,0:17:17.96,Default,,0,0,0,,{\ i1} Neyin var, Tsubasa? {\ i0}
Dialogue: 0,0:17:25.35,0:17:27.98,Default,,0,0,0,,{\i1}Ne zamandan beri bu kadar pısırıksın?{\i0}
Dialogue: 0,0:17:27.98,0:17:30.77,Default,,0,0,0,,{\i1}Üç gol önde olabilirler, ancak bu sadece ilk yarı.{\i0}
Dialogue: 0,0:17:30.77,0:17:33.11,Default,,0,0,0,,{\i1}Maçtan bu kadar erken vazgeçecek misin?{\i0}
Dialogue: 0,0:17:33.11,0:17:35.39,Default,,0,0,0,,{\ i1} Haklı, Tsubasa-kun. {\ i0}
Dialogue: 0,0:17:35.39,0:17:38.13,Default,,0,0,0,,{\i1}Oyununu takım arkadaşlarından herhangi biriyle birleştirebilirsin.{\i0}
Dialogue: 0,0:17:38.13,0:17:41.18,Default,,0,0,0,,{\i1}Nankatsu iyi kurulmuş böyle bir ekip değil mi?{\i0}
Dialogue: 0,0:17:41.18,0:17:45.12,Default,,0,0,0,,{\i1}Ve yine de, burada tek başına \Npes mi edeceksin, Tsubasa-kun?{\i0}
Dialogue: 0,0:17:45.12,0:17:47.25,Default,,0,0,0,,{\i1}Misaki-kun...{\i0}
Dialogue: 0,0:17:47.25,0:17:49.15,Default,,0,0,0,,{\i1}Wakabayashi-kun...{\i0}
Dialogue: 0,0:17:49.15,0:17:51.13,Default,,0,0,0,,{\ i1} Tsubasa, pes etme! {\ i0}
Dialogue: 0,0:17:51.82,0:17:53.38,Default,,0,0,0,,{\i1}Drive Shot'u kullan.{\i0}
Dialogue: 0,0:17:51.82,0:17:53.38,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:17:53.38,0:17:55.13,Default,,0,0,0,,{\i1}Buna sahipsin.{\i0}
Dialogue: 0,0:17:55.13,0:18:01.14,Default,,0,0,0,,{\i1}Senin için geride bıraktığım ve \Nöğrettiğim o rüya gibi Drive Shot kullan. {\i0}
Dialogue: 0,0:18:01.14,0:18:03.29,Default,,0,0,0,,{\i1}Roberto...{\i0}
Dialogue: 0,0:18:03.29,0:18:04.93,Default,,0,0,0,,{\i1}Drive Shot...{\i0}
Dialogue: 0,0:18:03.29,0:18:04.93,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:18:12.22,0:18:13.17,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:18:13.17,0:18:14.63,Default,,0,0,0,,Kendine gel Tsubasa!
Dialogue: 0,0:18:14.63,0:18:15.34,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:18:15.34,0:18:16.40,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:18:16.40,0:18:17.45,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:18:17.45,0:18:18.91,Default,,0,0,0,,Hey, iyi misin?
Dialogue: 0,0:18:18.91,0:18:19.86,Default,,0,0,0,,Sedye.
Dialogue: 0,0:18:19.86,0:18:21.20,Default,,0,0,0,,Sedyeyi getirin, çabuk!
Dialogue: 0,0:18:21.20,0:18:22.84,Default,,0,0,0,,Sorun değil.
Dialogue: 0,0:18:22.84,0:18:25.41,Default,,0,0,0,,İyiyim.
Dialogue: 0,0:18:26.10,0:18:27.90,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:18:27.90,0:18:30.06,Default,,0,0,0,,Gerçekten iyi misin?
Dialogue: 0,0:18:30.06,0:18:30.92,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:30.92,0:18:33.86,Default,,0,0,0,,Hah, bu maçın sonucu zaten belli, bilirsin.
Dialogue: 0,0:18:33.86,0:18:36.19,Default,,0,0,0,,Neden uyumaya gitmiyorsun, bilirsin?
Dialogue: 0,0:18:36.19,0:18:38.11,Default,,0,0,0,,Ne...?!
Dialogue: 0,0:18:42.68,0:18:45.14,Default,,0,0,0,,{\ i1} İlk yarı burada bitiyor! {\ i0}
Dialogue: 0,0:18:45.14,0:18:49.14,Default,,0,0,0,,{\i1}Nankatsu, üç gol geride kaldı.{\i0}
Dialogue: 0,0:18:49.14,0:18:54.05,Default,,0,0,0,,{\i1}Nankatsu'nun art arda üçüncü \Nşampiyonluk kazanması kesinlikle tehlikede.{\i0}
Dialogue: 0,0:18:54.05,0:18:56.61,Default,,0,0,0,,{\i1}Gerçekten umutsuz bir durumdalar.{\i0}
Dialogue: 0,0:18:56.61,0:18:58.86,Default-TOP,,0,0,0,,HIRADO ORTAOKULU \NNAGASAKI TEMSİLCİSİ
Dialogue: 0,0:18:57.79,0:18:58.86,Default,,0,0,0,,Başardık millet!
Dialogue: 0,0:18:59.36,0:19:00.44,Default,,0,0,0,,Bu harika!
Dialogue: 0,0:19:00.44,0:19:02.88,Default,,0,0,0,,Nankatsu'ya karşı üç gol attık.
Dialogue: 0,0:19:02.88,0:19:05.83,Default,,0,0,0,,Bunu devam ettirirsek daha da gol atabiliriz!
Dialogue: 0,0:19:05.83,0:19:08.61,Default,,0,0,0,,İkinci yarıda da size güveniyoruz çocuklar, Jito, Sano.
Dialogue: 0,0:19:08.61,0:19:09.86,Default,,0,0,0,,Bu kadar yeter.
Dialogue: 0,0:19:09.86,0:19:13.94,Default,,0,0,0,,İkinci yarıda 0-0 gideceğiz, yarın \Niçin kendimizi hazırlıyoruz, bilirsin.
Dialogue: 0,0:19:13.94,0:19:14.75,Default,,0,0,0,,Hah?
Dialogue: 0,0:19:22.28,0:19:23.54,Default,,0,0,0,,{\i1}Kaptan.{\i0}
Dialogue: 0,0:19:23.54,0:19:25.18,Default,,0,0,0,,{\i1}Sen misin, Sano?{\i0}
Dialogue: 0,0:19:25.18,0:19:27.77,Default,,0,0,0,,{\i1}Öğretmen senden şikayet ediyordu.{\i0}
Dialogue: 0,0:19:27.77,0:19:30.29,Default,,0,0,0,,{\i1}Eğer sadece bir şeyleri ciddiye alsaydın, o kadar {\i0}
Dialogue: 0,0:19:30.29,0:19:32.81,Default,,0,0,0,,{\i1}güçlü olurduk ki, ilk başta kimse bizi tanıyamazdı.{\i0}
Dialogue: 0,0:19:32.81,0:19:36.72,Default,,0,0,0,,{\i1}Hah! Kaptan ünvanını üzerime attılar, bilirsin.{\i0}
Dialogue: 0,0:19:36.72,0:19:40.12,Default,,0,0,0,,{\i1}Futbolla gerçekten ilgilenmiyordum zaten.{\i0}
Dialogue: 0,0:19:40.12,0:19:43.00,Default,,0,0,0,,{\i1}Bu yüzden mi okulu asıp kavga ettin?{\i0}
Dialogue: 0,0:19:43.00,0:19:44.45,Default,,0,0,0,,{\i1}Yani öyle.{\i0}
Dialogue: 0,0:19:45.31,0:19:49.84,Default,,0,0,0,,{\i1}Lise öğrencileri bu günlerde çok tuhaf, sıkıcı, bilirsin.{\i0}
Dialogue: 0,0:19:49.84,0:19:53.26,Default,,0,0,0,,{\i1}Acaba bir yerlerde daha güçlü\N adamlar var mı merek ediyorum.{\i0}
Dialogue: 0,0:19:53.26,0:19:54.31,Default,,0,0,0,,{\ i1} Bir tane var. {\ i0}
Dialogue: 0,0:19:54.31,0:19:54.96,Default,,0,0,0,,{\i1}Hmm?{\i0}
Dialogue: 0,0:19:55.53,0:19:57.92,Default,,0,0,0,,{\i1}En güçlü adam şimdi o.{\i0}
Dialogue: 0,0:19:58.40,0:20:00.50,Default,,0,0,0,,{\i1}Bu Nankatsu 'nun kaptanı, takımını iki kere{\i0}
Dialogue: 0,0:20:00.50,0:20:02.59,Default,,0,0,0,,{\i1}Ulusal Turnuva şampiyonasına götürdü.{\i0}
Dialogue: 0,0:20:02.59,0:20:04.93,Default,,0,0,0,,{\i1}Yine de, kavga etmekten ziyade futbolda güçlü.{\i0}
Dialogue: 0,0:20:04.93,0:20:08.24,Default,,0,0,0,,{\i1}Sano, bu adam gerçekten o kadar güçlü mü?! {\i0}
Dialogue: 0,0:20:08.24,0:20:11.74,Default,,0,0,0,,{\i1}Evet, ülkenin dört bir yanındaki futbol kulübü{\i0}
Dialogue: 0,0:20:11.74,0:20:15.23,Default,,0,0,0,,{\i1}üyeleri Tsubasa Ozora'yı yenmeyi hedefliyor.{\i0}
Dialogue: 0,0:20:15.23,0:20:16.69,Default,,0,0,0,,{\i1}Ooo.{\i0}
Dialogue: 0,0:20:22.00,0:20:24.59,Default,,0,0,0,,{\i1}Pratik yapmak çok rahatsız edici.{\i0}
Dialogue: 0,0:20:24.59,0:20:24.87,Default,,0,0,0,,{\i1}Hah?{\i0}
Dialogue: 0,0:20:25.53,0:20:30.23,Default,,0,0,0,,{\i1}Ancak, güçlüleri yenmek benim hobimdir.{\i0}
Dialogue: 0,0:20:30.23,0:20:31.75,Default,,0,0,0,,{\i1}Bir şans verelim mi? {\i0}
Dialogue: 0,0:20:32.26,0:20:33.44,Default,,0,0,0,,{\i1}Kaptan...{\i0}
Dialogue: 0,0:20:34.73,0:20:36.13,Default,,0,0,0,,{\i1}Tabii!{\i0}
Dialogue: 0,0:20:37.24,0:20:44.36,Default,,0,0,0,,{\i1}Ciddiye aldığım ilk rakip Nankatsu ve Tsubasa Ozora oldu.{\i0}
Dialogue: 0,0:20:44.36,0:20:47.68,Default,,0,0,0,,{\i1} Onları yenmenin çok kolay olacağını düşünmek... {\i0}
Dialogue: 0,0:20:48.89,0:20:53.36,Default,,0,0,0,,{\i1}Sanırım sonuçta benden daha güçlü kimse yok.{\i0}
Dialogue: 0,0:20:51.18,0:20:54.19,Default-TOP,,0,0,0,,REVİR
Dialogue: 0,0:20:54.19,0:20:55.76,Default,,0,0,0,,Üç gol önde, ha?
Dialogue: 0,0:20:55.76,0:20:57.70,Default,,0,0,0,,Bu senin için büyük bir sorun.
Dialogue: 0,0:20:57.70,0:21:00.16,Default,,0,0,0,,Sanırım senin gibi biri bile vazgeçmeyi düşünüyordur.
Dialogue: 0,0:21:00.16,0:21:01.11,Default,,0,0,0,,Hayır.
Dialogue: 0,0:21:01.11,0:21:03.99,Default,,0,0,0,,Herhangi biriyle kombinasyon yapma yeteneğim var,
Dialogue: 0,0:21:03.99,0:21:06.94,Default,,0,0,0,,ve en önemlisi, bu maçta bir kere bile
Dialogue: 0,0:21:06.94,0:21:09.87,Default,,0,0,0,,kullanmadığım Drive Shot'a sahibim.
Dialogue: 0,0:21:09.87,0:21:13.37,Default,,0,0,0,,Kesinlikle pes etmeyeceğim!
Dialogue: 0,0:21:14.75,0:21:16.75,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:21:16.75,0:21:19.66,Default,,0,0,0,,Taki ve Kisugi, ikiniz iyi misiniz?
Dialogue: 0,0:21:19.66,0:21:21.87,Default,,0,0,0,,Sadece çürüklerimiz var.
Dialogue: 0,0:21:21.87,0:21:23.75,Default,,0,0,0,,Ama Tsubasa...
Dialogue: 0,0:21:26.34,0:21:28.18,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:21:28.18,0:21:29.68,Default,,0,0,0,,Şimdi, hadi millet gidelim.
Dialogue: 0,0:21:30.13,0:21:31.26,Default,,0,0,0,,İkinci yarı vakti geldi!
Dialogue: 0,0:21:31.80,0:21:33.14,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:21:33.14,0:21:34.27,Default,,0,0,0,,E-Evet!
Dialogue: 0,0:21:34.27,0:21:36.90,Default,,0,0,0,,Doğru, yine de elimizden geleni yapmalıyız!
Dialogue: 0,0:21:36.90,0:21:39.48,Default,,0,0,0,,Artık bu üç gol için hiçbir şey yapamayız.
Dialogue: 0,0:21:39.48,0:21:41.27,Default,,0,0,0,,Pekala millet, hadi yapalım!
Dialogue: 0,0:21:41.27,0:21:45.00,Default,,0,0,0,,{\i1}Sadece gülümsedi ve herkesin istekliliği geri döndü.{\i0}
Dialogue: 0,0:21:45.00,0:21:46.90,Default,,0,0,0,,{\i1}Sanırım yaralı olsun ya da olmasın Tsubasa'ya{\i0}
Dialogue: 0,0:21:46.90,0:21:48.78,Default,,0,0,0,,{\i1} güvenmekten başka seçeneğimiz yok.{\i0}
Dialogue: 0,0:21:50.06,0:21:52.58,Default,,0,0,0,,{\i1} İkinci yarı başlamak üzere.{\i0}
Dialogue: 0,0:21:52.58,0:21:55.99,Default,,0,0,0,,{\i1}Sağlığı kaygı verici olan Nankatsu'nun Kaptanı{\i0}
Dialogue: 0,0:21:55.99,0:21:57.96,Default,,0,0,0,,{\i1}Tsubasa da yarıya başlamak için hazır durumda.{\i0}
Dialogue: 0,0:21:58.37,0:21:59.75,Default,,0,0,0,,Ah adamım.
Dialogue: 0,0:21:59.75,0:22:02.66,Default,,0,0,0,,Izawa, topu çabucak bana ver. 
Dialogue: 0,0:22:02.66,0:22:03.56,Default,,0,0,0,,Hah?
Dialogue: 0,0:22:03.56,0:22:06.42,Default,,0,0,0,,Hemen bir gol atacağım.
Dialogue: 0,0:22:09.61,0:22:11.51,Default,,0,0,0,,{\i1} İşte geliyorum Hirado.{\i0}
Dialogue: 0,0:22:11.51,0:22:17.96,Default,,0,0,0,,{\i1}Drive Shot'umun tadına ilk bakan siz olacaksınız!{\i0}
Dialogue: 0,0:22:19.60,0:22:34.60,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.07,0:23:59.07,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:23:49.07,0:23:58.68,Default,,0,0,0,,42. BÖLÜM: \NTSUBASA, ANKA KUŞU
Dialogue: 0,0:00:46.24,0:00:48.95,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:49.87,0:00:52.54,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:00:53.45,0:00:56.17,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:03.05,0:01:05.88,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:05.88,0:01:12.14,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:01:12.14,0:01:18.02,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta no ni
Dialogue: 0,0:01:18.02,0:01:24.61,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:01:24.61,0:01:28.61,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:28.61,0:01:33.12,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:33.12,0:01:38.67,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:01:38.67,0:01:40.25,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:01:40.25,0:01:41.46,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:41.46,0:01:44.96,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:01:44.96,0:01:54.85,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:01:54.85,0:01:55.68,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:01:55.68,0:01:59.48,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:01:59.48,0:02:03.48,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:02:03.48,0:02:09.74,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:02:09.74,0:02:12.53,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:00:46.24,0:00:48.95,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:49.87,0:00:52.54,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:00:53.45,0:00:56.17,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:03.05,0:01:05.88,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum. {I keep lying to myself}
Dialogue: 0,0:01:05.88,0:01:12.14,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile {burning with loneliness}
Dialogue: 0,0:01:12.14,0:01:18.02,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:18.02,0:01:24.61,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:24.61,0:01:28.61,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:28.61,0:01:33.12,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:01:33.12,0:01:38.67,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:01:38.67,0:01:40.25,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:01:40.25,0:01:41.46,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:41.46,0:01:44.96,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:01:44.96,0:01:54.85,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:01:54.85,0:01:55.68,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:01:55.68,0:01:59.48,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:01:59.48,0:02:03.48,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:02:03.48,0:02:09.74,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:09.74,0:02:12.53,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.28,0:22:44.33,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.33,0:22:50.34,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.34,0:22:56.39,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.39,0:23:01.02,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.64,0:23:07.31,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.65,0:23:14.74,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.74,0:23:20.78,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:20.78,0:23:25.25,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.54,0:23:32.88,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:32.88,0:23:38.93,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:38.93,0:23:45.23,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.28,0:22:44.33,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.33,0:22:50.34,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.34,0:22:56.39,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.39,0:23:01.02,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.64,0:23:07.31,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.65,0:23:14.74,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.74,0:23:20.78,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:20.78,0:23:25.25,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.54,0:23:32.88,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:32.88,0:23:38.93,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:38.93,0:23:45.23,OPED,,0,0,0,,Bu hırslı gençlik sahada!
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
