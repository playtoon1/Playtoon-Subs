Dialogue: 0,0:15:48.42,0:15:50.28,Default,,0,0,0,,{\i1}Top sağa gidiyor!{\i0}
Dialogue: 0,0:15:50.28,0:15:51.63,Default,,0,0,0,,{\i1}Lanet olsun! Kapatmalıyım!{\i0}
Dialogue: 0,0:15:52.25,0:15:54.64,Default,,0,0,0,,{\i1}Yine sağa gidiyor!{\i0}
Dialogue: 0,0:15:54.64,0:15:56.72,Default,,0,0,0,,{\i1}Ve Oda-kun şut çekiyor!{\i0}
Dialogue: 0,0:15:57.54,0:15:59.10,Default,,0,0,0,,{\i1}Furano beraberliği mi sağlayacak?!{\i0}
Dialogue: 0,0:15:59.10,0:16:01.22,Default,,0,0,0,,{\i1}Hayır, sağlayamıyor!{\i0}
Dialogue: 0,0:16:02.10,0:16:04.06,Default,,0,0,0,,{\i1}Hyuga-kun kıl payı engelliyor!{\i0}
Dialogue: 0,0:16:04.06,0:16:07.27,Default,,0,0,0,,{\i1}Ama top Matsuyama-kun'a geliyor!{\i0}
Dialogue: 0,0:16:07.98,0:16:08.86,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:16:08.86,0:16:10.36,Default,,0,0,0,,Şut çekmene izin vermem!
Dialogue: 0,0:16:10.36,0:16:12.86,Default,,0,0,0,,{\i1}Sawada-kun kayarak durdurmaya çalışıyor!{\i0}
Dialogue: 0,0:16:12.86,0:16:15.82,Default,,0,0,0,,{\i1}Matsuyama-kun mu Sawada-kun mu daha hızlı?{\i0}
Dialogue: 0,0:16:18.01,0:16:19.84,Default,,0,0,0,,{\i1}Matsuyama-kun başarıyor!{\i0}
Dialogue: 0,0:16:19.84,0:16:21.33,Default,,0,0,0,,{\i1}Furano beraberliği sağlıyor!{\i0}
Dialogue: 0,0:16:21.33,0:16:23.74,Default,,0,0,0,,Başardın Kaptan! Güzel şuttu!
Dialogue: 0,0:16:23.74,0:16:26.83,Default,,0,0,0,,{\i1}Furano takım oyunuyla skoru eşitliyor!{\i0}
Dialogue: 0,0:16:26.83,0:16:28.75,Default,,0,0,0,,Mükemmel.
Dialogue: 0,0:16:26.83,0:16:28.75,Default,,0,0,0,,{\an8}- Harika.\N- Mükemmel.
Dialogue: 0,0:16:33.51,0:16:34.67,Default,,0,0,0,,Gidelim.
Dialogue: 0,0:16:34.67,0:16:37.39,Default,,0,0,0,,{\i1}Furano güç birliğiyle baskı kuruyor.{\i0}
Dialogue: 0,0:16:38.42,0:16:39.93,Default,,0,0,0,,Lanet olsun...
Dialogue: 0,0:16:39.93,0:16:42.93,Default,,0,0,0,,Siz kimsiniz be?!
Dialogue: 0,0:16:42.93,0:16:45.60,Default,,0,0,0,,{\i1}Hyuga-kun kayarak çalım atacak!{\i0}
Dialogue: 0,0:16:46.16,0:16:47.54,Default,,0,0,0,,{\i1}Atlattı!{\i0}
Dialogue: 0,0:16:47.54,0:16:48.11,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:49.24,0:16:50.78,Default,,0,0,0,,{\i1}Top kale önüne gidiyor!{\i0}
Dialogue: 0,0:16:50.78,0:16:51.98,Default,,0,0,0,,Nasıl?!
Dialogue: 0,0:16:51.98,0:16:54.49,Default,,0,0,0,,{\i1}Oda-kun topa doğru koşuyor.{\i0}
Dialogue: 0,0:16:54.49,0:16:56.74,Default,,0,0,0,,{\i1}Durdurun onu! Şut çekmesine\Nizin vermeyin sakın!{\i0}
Dialogue: 0,0:16:59.92,0:17:01.58,Default,,0,0,0,,{\i1}E-El var!{\i0}
Dialogue: 0,0:17:01.58,0:17:04.54,Default,,0,0,0,,{\i1}Ceza sahası içerisinde Meiwa faul yapıyor!{\i0}
Dialogue: 0,0:17:05.85,0:17:07.79,Default,,0,0,0,,{\i1}Furano penaltı kullanacak!{\i0}
Dialogue: 0,0:17:09.74,0:17:11.68,Default,,0,0,0,,P-Penaltı...
Dialogue: 0,0:17:11.68,0:17:13.55,Default,,0,0,0,,{\i1}Nasıl bir şeydir bu böyle?!{\i0}
Dialogue: 0,0:17:13.55,0:17:17.05,Default,,0,0,0,,{\i1}Maçın bitmesine bir dakikadan az kaldı.{\i0}
Dialogue: 0,0:17:17.54,0:17:21.31,Default,,0,0,0,,{\i1}Furano finallere bileti kazanma şansı yakaladı.{\i0}
Dialogue: 0,0:17:21.82,0:17:24.77,Default,,0,0,0,,{\i1}B-Böyle...{\alpha&HFF&} Böyle bir yerde kayıp mı edeceğim?{\i0}
Dialogue: 0,0:17:24.78,0:17:27.10,Default,,0,0,0,,{\i1}B-Böyle... Böyle bir yerde kayıp mı edeceğim?{\i0}
Dialogue: 0,0:17:28.57,0:17:30.19,Default,,0,0,0,,{\i1}Hyuga-kun...{\i0}
Dialogue: 0,0:17:30.65,0:17:34.08,Default,,0,0,0,,{\i1}Penaltıyı kullanacak kişi\Nilk yarıdaki penaltıyı da kullanan...{\i0}
Dialogue: 0,0:17:34.08,0:17:36.45,Default,,0,0,0,,{\i1}...Furano Kaptanı Matsuyama Hikaru-kun.{\i0}
Dialogue: 0,0:17:36.45,0:17:38.45,Default,,0,0,0,,Kaptan, sana güveniyoruz!
Dialogue: 0,0:17:38.45,0:17:39.20,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:39.20,0:17:43.31,Default,,0,0,0,,Ama bu penaltı hepimizin penaltısı!
Dialogue: 0,0:17:43.31,0:17:47.23,Default,,0,0,0,,O yüzden hepimizin duygularını\Nortaya koyarak kullanacağım!
Dialogue: 0,0:17:47.23,0:17:48.21,Default,,0,0,0,,Evet!
Dialogue: 0,0:17:50.87,0:17:52.00,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:18:05.56,0:18:06.31,Default,,0,0,0,,Durun!
Dialogue: 0,0:18:08.33,0:18:10.44,Default,,0,0,0,,Kaleci değişikliği!
Dialogue: 0,0:18:10.44,0:18:12.73,Default,,0,0,0,,W-Wakashimazu?!
Dialogue: 0,0:18:12.73,0:18:13.82,Default,,0,0,0,,Gelmişsin!
Dialogue: 0,0:18:13.82,0:18:14.98,Default,,0,0,0,,Wakashimazu-san!
Dialogue: 0,0:18:14.98,0:18:17.19,Default,,0,0,0,,Kaleci değişikliği mi?
Dialogue: 0,0:18:17.74,0:18:21.67,Default,,0,0,0,,{\i1}Yenilmez kaleci Wakashimasu Ken'i getirdim.{\i0}
Dialogue: 0,0:18:21.67,0:18:26.48,Default,,0,0,0,,{\i1}Birkaç ay önce trafik kazası geçirmişti ama\Nanka kuşu misali geri döndü!{\i0}
Dialogue: 0,0:18:25.16,0:18:27.32,Default,,0,0,0,,{\an8}- Sana güveniyoruz.\N- Sana bırakıyorum Wakashimazu.
Dialogue: 0,0:18:34.30,0:18:36.09,Default,,0,0,0,,Wakashimazu.
Dialogue: 0,0:18:36.09,0:18:39.51,Default,,0,0,0,,Kaptan, tutunca sana pas vereceğim.
Dialogue: 0,0:18:46.17,0:18:49.06,Default,,0,0,0,,{\i1}Wakashimazu-kun yerini aldı.{\i0}
Dialogue: 0,0:18:50.56,0:18:54.32,Default,,0,0,0,,{\i1}Kaleci kim olursa olsun\Nbunu kesinlikle gole çevireceğim!{\i0}
Dialogue: 0,0:18:59.65,0:19:02.41,Default,,0,0,0,,{\i1}Herkesin gücünü ortaya koyarak\Nelde ettiği penaltıyı!{\i0}
Dialogue: 0,0:19:02.41,0:19:06.04,Default,,0,0,0,,{\i1}Bacağım kırılsa bile bunu gol atacağım!{\i0}
Dialogue: 0,0:19:07.06,0:19:10.04,Default,,0,0,0,,{\i1}Matsuyama-kun tereddüt etmeden\Nmermi gibi bir top yolluyor!{\i0}
Dialogue: 0,0:19:13.92,0:19:15.53,Default,,0,0,0,,{\i1}Y-Yakaladı!{\i0}
Dialogue: 0,0:19:15.53,0:19:18.01,Default,,0,0,0,,{\i1}Wakashimazu-kun topu tutuyor!{\i0}
Dialogue: 0,0:19:18.39,0:19:19.88,Default,,0,0,0,,Gidelim Kaptan!
Dialogue: 0,0:19:22.24,0:19:25.05,Default,,0,0,0,,{\i1}Wakashimazu-kun hiç gecikmeden\NHyuga-kun'a pas atıyor!{\i0}
Dialogue: 0,0:19:25.05,0:19:27.06,Default,,0,0,0,,Eyvah! Hyuga'nın peşine düşün!
Dialogue: 0,0:19:27.06,0:19:30.81,Default,,0,0,0,,{\i1}Hyuga-kun son gücüyle\NFurano kalesine doğru koşuyor!{\i0}
Dialogue: 0,0:19:30.81,0:19:35.14,Default,,0,0,0,,{\i1}Furano ise son saniyelerde tüm gücüyle\Nonun peşinden koşuyor!{\i0}
Dialogue: 0,0:19:35.14,0:19:37.57,Default,,0,0,0,,{\i1}Meiwa ve Furano arasındaki son mücadele!{\i0}
Dialogue: 0,0:19:37.57,0:19:42.24,Default,,0,0,0,,{\i1}Koşan Hyuga-kun orta sahayı\Ngeçti ve Furano sahasında koşmaya devam ediyor!{\i0}
Dialogue: 0,0:19:43.77,0:19:44.74,Default,,0,0,0,,Bacağım...
Dialogue: 0,0:19:45.16,0:19:47.16,Default,,0,0,0,,{\i1}Sana güveniyorum millet...{\i0}
Dialogue: 0,0:19:50.34,0:19:53.46,Default,,0,0,0,,{\i1}Kaleye... Kaleye atmam gerek.{\i0}
Dialogue: 0,0:19:53.46,0:19:55.92,Default,,0,0,0,,Lanet olsun. Kesinlikle yakalacağız.
Dialogue: 0,0:19:58.86,0:20:01.30,Default,,0,0,0,,{\i1}Kaleye... Şut çekmeliyim.{\i0}
Dialogue: 0,0:20:03.71,0:20:07.97,Default,,0,0,0,,{\i1}Furano'nun çalımı ve Hyuga-kun'un\Nşutu arasında sıkışıyor top!{\i0}
Dialogue: 0,0:20:09.94,0:20:10.47,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:15.95,0:20:17.40,Default,,0,0,0,,{\i1}G-Gol!{\i0}
Dialogue: 0,0:20:18.92,0:20:21.74,Default,,0,0,0,,{\i1}Maçı bitiren düdük çalıyor!{\i0}
Dialogue: 0,0:20:22.74,0:20:25.99,Default,,0,0,0,,{\i1}Çok... Çok dramatik bir sonuç!{\i0}
Dialogue: 0,0:20:25.99,0:20:27.65,Default,,0,0,0,,{\i1}3-2!{\i0}
Dialogue: 0,0:20:27.65,0:20:31.13,Default,,0,0,0,,{\i1}Çekişmeli kedi fare oyununun sonu geldi.{\i0}
Dialogue: 0,0:20:31.13,0:20:34.00,Default,,0,0,0,,{\i1}Meiwa FC zorlu olmasına rağmen\NFurano'yu yeniyor.{\i0}
Dialogue: 0,0:20:34.73,0:20:36.50,Default,,0,0,0,,{\i1}Kaptan'dan da bu beklenirdi.{\i0}
Dialogue: 0,0:20:38.96,0:20:41.62,Default,,0,0,0,,Furano kaybetti.
Dialogue: 0,0:20:41.62,0:20:42.84,Default,,0,0,0,,Çocuklar...
Dialogue: 0,0:20:42.84,0:20:44.02,Default,,0,0,0,,Kazandım.
Dialogue: 0,0:20:44.02,0:20:45.42,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:20:45.42,0:20:47.93,Default,,0,0,0,,Kazandım mı?
Dialogue: 0,0:20:48.43,0:20:49.85,Default,,0,0,0,,- Hyuga-san!\N- Kaptan!
Dialogue: 0,0:20:49.85,0:20:51.14,Default,,0,0,0,,Kojiro!
Dialogue: 0,0:20:51.14,0:20:53.10,Default,,0,0,0,,Doktor! Doktor çağırın!
Dialogue: 0,0:20:53.71,0:20:56.73,Default,,0,0,0,,{\i1}Düşündüğüm gibi Hyuga-kun bedeni bugün...{\i0}
Dialogue: 0,0:20:57.34,0:20:59.32,Default,,0,0,0,,Gidelim.
Dialogue: 0,0:20:59.74,0:21:01.32,Default,,0,0,0,,Ağlamayın çocuklar.
Dialogue: 0,0:21:01.32,0:21:06.32,Default,,0,0,0,,Buraya kadar dişimizle\Ntırnağımızla mücadele ederek geldik.
Dialogue: 0,0:21:06.32,0:21:08.82,Default,,0,0,0,,Hokkaido'ya başımız dik dönebiliriz.
Dialogue: 0,0:21:08.82,0:21:10.82,Default,,0,0,0,,E-Evet...
Dialogue: 0,0:21:12.73,0:21:13.96,Default,,0,0,0,,Hyuga-san...
Dialogue: 0,0:21:15.21,0:21:16.60,Default,,0,0,0,,İyiyim.
Dialogue: 0,0:21:17.96,0:21:21.07,Default,,0,0,0,,Sadece biraz başım döndü.
Dialogue: 0,0:21:21.07,0:21:22.21,Default,,0,0,0,,{\i1}Hyuga...{\i0}
Dialogue: 0,0:21:22.21,0:21:25.32,Default,,0,0,0,,{\i1}Hakkında her türlü şey söyledim.{\i0}
Dialogue: 0,0:21:25.32,0:21:28.84,Default,,0,0,0,,{\i1}Ama sen de kendince her şeyi\Nkoyarak mücadele ettin.{\i0}
Dialogue: 0,0:21:28.84,0:21:31.85,Default,,0,0,0,,{\i1}Bugün mücadele ettikten sonra anladım bunu.{\i0}
Dialogue: 0,0:21:32.90,0:21:36.14,Default,,0,0,0,,{\i1}Bugün kaybeden biz olduk.{\i0}
Dialogue: 0,0:21:36.14,0:21:42.18,Default,,0,0,0,,{\i1}Ama bir gün tekrar oynayalım Hyuga Kojiro!{\i0}
Dialogue: 0,0:21:45.66,0:21:47.68,Default,,0,0,0,,Harika bir maçtı.
Dialogue: 0,0:21:47.68,0:21:48.36,Default,,0,0,0,,Evet.
Dialogue: 0,0:21:48.36,0:21:51.37,Default,,0,0,0,,Tamamdır, şimdi bizim sıramız!
Dialogue: 0,0:21:51.37,0:21:55.47,Default,,0,0,0,,Biz de Furano ve Meiwa maçı\Ngibi harika bir maç izletelim!
Dialogue: 0,0:21:55.47,0:21:56.37,Default,,0,0,0,,Tamam!
Dialogue: 0,0:22:03.36,0:22:07.59,Default,,0,0,0,,{\i1}Mücadele vaktimiz geldi sayılır Tsubasa-kun!{\i0}
Dialogue: 0,0:22:07.59,0:22:13.56,Default,,0,0,0,,{\i1}Misugi-kun ne olursa olsun\Nher şeyimle mücadele edeceğim.{\i0}
