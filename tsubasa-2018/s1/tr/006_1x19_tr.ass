Dialogue: 0,0:13:28.96,0:13:33.96,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:00.96,0:00:04.81,Default,,0,0,0,,{\i1}Turnuva sonunda başlamıştı.{\i0}
Dialogue: 0,0:00:04.81,0:00:10.15,Default,,0,0,0,,{\i1}Nankatsu SC, Osaka temsilcisi\NNaniwa FC ile karşılaşmıştı.{\i0}
Dialogue: 0,0:00:10.15,0:00:13.44,Default,,0,0,0,,{\i1}Nakanishi'nin kuvvetli savunmasıyla\Ntam formundayken...{\i0}
Dialogue: 0,0:00:13.44,0:00:16.45,Default,,0,0,0,,{\i1}...Nankatsu durmadan kaleye\Natak yapıyordu.{\i0}
Dialogue: 0,0:00:17.53,0:00:22.04,Default,,0,0,0,,{\i1}Tsubasa'nın vurduğu şutun\NNaniwa FC kalesinde gol olması sonrası...{\i0}
Dialogue: 0,0:00:22.04,0:00:26.12,Default,,0,0,0,,{\i1}...geldiği gazla ardı ardına golleri tıkmıştı.{\i0}
Dialogue: 0,0:00:26.12,0:00:30.84,Default,,0,0,0,,O altın sağ ayağını senden alacağım!
Dialogue: 0,0:00:37.25,0:00:43.52,Default,,0,0,0,,{\i1}Bu sırada Musashi FC'den Misugi'nin\Nkalp rahatsızlığı olduğu açığa çıkmıştı.{\i0}
Dialogue: 0,0:00:43.52,0:00:46.77,Default,,0,0,0,,{\i1}Her takımın durumu karışıktı.{\i0}
Dialogue: 0,0:00:46.77,0:00:51.90,Default,,0,0,0,,{\i1}Kojiro liderliğindeki Meiwa FC de\Ngizli kartlarını oynayacaktı.{\i0}
Dialogue: 0,0:00:53.57,0:00:57.57,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvası bitmek üzere.{\i0}
Dialogue: 0,0:00:57.57,0:01:02.83,Default,,0,0,0,,{\i1}Elemelerde kalan 4 takım var ve\Nsadece yarı finaller ve finaller kaldı.{\i0}
Dialogue: 0,0:01:02.83,0:01:03.91,Default-Top,,0,0,0,,# Furano İlkokulu\NElinizden Geleni Yapın #
Dialogue: 0,0:01:07.79,0:01:09.81,Default,,0,0,0,,{\i1}Bugünkü yarı final maçında...{\i0}
Dialogue: 0,0:01:09.81,0:01:13.80,Default,,0,0,0,,{\i1}...Kuzey Hokkaido'dan Furano İlkokulu\Nve Saitama'dan Meiwa FC oynayacak.{\i0}
Dialogue: 0,0:01:13.80,0:01:20.14,Default,,0,0,0,,{\i1}İkinci maçta Shizuoka'dan Nankatsu SC\Nve Tokyo'dan Musashi FC oynayacak.{\i0}
Dialogue: 0,0:01:20.14,0:01:24.26,Default,,0,0,0,,Meiwa ve Furano... Hangisi kazanırsa\Nkazansın bizim için zorlu olacak.{we lose}
Dialogue: 0,0:01:24.26,0:01:25.14,Default,,0,0,0,,Evet.
Dialogue: 0,0:01:34.64,0:01:36.98,Default,,0,0,0,,{\i1}Şampiyonluğa sadece 2 maç kaldı.{\i0} {"I", because he probably doesn't give a fuck about the other 10 guys I approve}
Dialogue: 0,0:01:38.78,0:01:40.45,Default,,0,0,0,,{\i1}Kesinlikle kazanacağım!{\i0}
Dialogue: 0,0:03:16.29,0:03:20.63,Default,,0,0,0,,{\fad(500,500)\fs80\pos(288,722.333)}19. Bölüm:
Dialogue: 0,0:03:16.29,0:03:20.63,Default,,0,0,0,,{\fad(500,500)\fs80\pos(416,822.333)}Çekişmeli Rekabet!
Dialogue: 0,0:03:16.29,0:03:20.63,Default,,0,0,0,,{\fad(500,500)\fs80\pos(704,914.333)}Meiwa ve Furano
Dialogue: 0,0:03:16.29,0:03:20.63,Default,,0,0,0,,{\fad(500,500)\pos(1476,1030)}Çeviri: ARE-YOU-SURE\N{\fs70}AreyousureSubs Sunar
Dialogue: 0,0:03:17.63,0:03:19.92,Default-Top,,0,0,0,,{\i1}İki takım da yerini aldı.{\i0}
Dialogue: 0,0:03:19.92,0:03:22.09,Default-Top,,0,0,0,,{\i1}Hangisi finallere ilerleyecek?{\i0}
Dialogue: 0,0:03:22.09,0:03:24.19,Default,,0,0,0,,{\i1}Hyuga-kun liderliğindeki Meiwa mı?{\i0}
Dialogue: 0,0:03:24.19,0:03:27.68,Default,,0,0,0,,{\i1}Takım oyununa değer veren\NMatsuyama liderliğindeki Furano mu?{\i0}
Dialogue: 0,0:03:27.68,0:03:31.89,Default,,0,0,0,,{\i1}Hyuga Kojiro. Kafeteryada yaptığını\Nsana ödeteceğim!{\i0}
Dialogue: 0,0:03:32.48,0:03:34.52,Default,,0,0,0,,{\i1}Takım oyunu da neymiş?!{\i0}
Dialogue: 0,0:03:34.52,0:03:38.52,Default,,0,0,0,,{\i1}Böyle bir futbolu darmaduman ederim!{\i0}
Dialogue: 0,0:03:39.38,0:03:43.78,Default,,0,0,0,,{\i1}Yarı finallerin ilk maçı\NMeiwa'nın top vuruşuyla başlıyor.{\i0}
Dialogue: 0,0:03:43.78,0:03:45.28,Default,,0,0,0,,İşte başladı!
Dialogue: 0,0:03:45.28,0:03:48.77,Default,,0,0,0,,{\i1}4. sınıf olmasına rağmen\Nçok çabalayarak takımına destek olan...{\i0}
Dialogue: 0,0:03:48.78,0:03:51.67,Default,,0,0,0,,{\i1}...Sawada Takeshi-kun\Nrakip sahada top sürüyor.{\i0}
Dialogue: 0,0:03:51.67,0:03:53.29,Default,,0,0,0,,Tamamdır! Bugün de halledelim şunu!
Dialogue: 0,0:03:53.29,0:03:55.69,Default,,0,0,0,,4. sınıf olduğu için hafife almayın!
Dialogue: 0,0:03:55.69,0:03:57.40,Default,,0,0,0,,Oynama konusunda çok yetenekli!
Dialogue: 0,0:03:57.40,0:03:58.04,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:59.67,0:04:00.67,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:04:01.55,0:04:02.80,Default,,0,0,0,,{\i1}Güzel pas!{\i0}
Dialogue: 0,0:04:02.80,0:04:06.30,Default,,0,0,0,,{\i1}Meiwa hızlıca topu\NHyuga Kojiro-kun'a ulaştırıyor.{\i0}
Dialogue: 0,0:04:06.30,0:04:08.26,Default,,0,0,0,,{\i1}Güzel. Önce ilk gol!{\i0}
Dialogue: 0,0:04:08.26,0:04:10.68,Default,,0,0,0,,{\i1}Hyuga-kun ileri doğru top sürüyor.{\i0}
Dialogue: 0,0:04:10.68,0:04:12.16,Default,,0,0,0,,Bana bırakın!
Dialogue: 0,0:04:12.16,0:04:15.73,Default,,0,0,0,,{\i1}Hyuga-kun'u tutmak için Furano\NKaptanı Matsuyama Hikaru-kun çıkıyor.{\i0}
Dialogue: 0,0:04:15.73,0:04:18.06,Default,,0,0,0,,Bugün sana hiç fırsat tanımayacağım!
Dialogue: 0,0:04:18.06,0:04:20.65,Default,,0,0,0,,Umarım kendini hazırlamışsındır Hyuga!
Dialogue: 0,0:04:20.65,0:04:22.74,Default,,0,0,0,,Durdurabiliyorsan durdur bakalım!
Dialogue: 0,0:04:22.74,0:04:24.69,Default,,0,0,0,,{\i1}Şimdiden önemli anlar yaşanıyor!{\i0}
Dialogue: 0,0:04:24.69,0:04:26.79,Default,,0,0,0,,{\i1}İki yıldız oyuncu arasında birebir mücadele!{\i0}
Dialogue: 0,0:04:26.79,0:04:28.34,Default,,0,0,0,,{\i1}Matsuyama-kun'dan da bu beklenirdi.{\i0}
Dialogue: 0,0:04:28.34,0:04:30.21,Default,,0,0,0,,{\i1}İzin vermiyor.{\i0}
Dialogue: 0,0:04:30.21,0:04:33.60,Default,,0,0,0,,{\i1}Hyuga-kun hala harika bir şekilde\Ntopu elinde tutuyor.{\i0}
Dialogue: 0,0:04:33.60,0:04:35.16,Default,,0,0,0,,İkisinin de altta kalır yanı yok.
Dialogue: 0,0:04:36.67,0:04:38.04,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:04:38.04,0:04:40.29,Default,,0,0,0,,{\i1}Bu çocuk bayağı iyi.{\i0}
Dialogue: 0,0:04:40.29,0:04:43.57,Default,,0,0,0,,Böyle devam etmesine izin veremeyiz!\NKaptanımıza destek olmalıyız!
Dialogue: 0,0:04:43.57,0:04:44.55,Default,,0,0,0,,Evet!
Dialogue: 0,0:04:44.55,0:04:48.66,Default,,0,0,0,,{\i1}Sabrı tükenen Furano 11'i\Nyardıma geliyor!{\i0}
Dialogue: 0,0:04:48.66,0:04:49.55,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:04:50.46,0:04:51.93,Default,,0,0,0,,Çocuklar!
Dialogue: 0,0:04:51.93,0:04:52.68,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:04:53.02,0:04:53.68,Default,,0,0,0,,Tamam!
Dialogue: 0,0:04:53.68,0:04:56.14,Default,,0,0,0,,{\i1}Hyuga-kun ilk kez Sawada-kun'a pas veriyor.{\i0}
Dialogue: 0,0:04:56.60,0:04:59.85,Default,,0,0,0,,{\i1}Ne?! Matsuyama-kun topu kesiyor!{\i0}
Dialogue: 0,0:04:59.85,0:05:00.56,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:00.56,0:05:01.44,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:05:01.44,0:05:02.19,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:05:02.19,0:05:03.44,Default,,0,0,0,,Kaneda!
Dialogue: 0,0:05:03.94,0:05:05.90,Default,,0,0,0,,{\i1}Furano karşı atağa çıkıyor!{\i0}
Dialogue: 0,0:05:05.90,0:05:07.42,Default,,0,0,0,,Sakın beni almayın...
Dialogue: 0,0:05:07.42,0:05:09.74,Default,,0,0,0,,Bunu sineye çekecek değilim!
Dialogue: 0,0:05:11.97,0:05:13.24,Default,,0,0,0,,Dikkat et Kaneda!
Dialogue: 0,0:05:14.54,0:05:17.33,Default,,0,0,0,,{\i1}Hyuga-kun'un özel kayarak çalımı!{\i0}
Dialogue: 0,0:05:19.40,0:05:20.63,Default,,0,0,0,,Böyle devam!
Dialogue: 0,0:05:21.48,0:05:22.29,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:05:22.29,0:05:23.99,Default,,0,0,0,,{\i1}Hyuga-kun'dan da bu beklenirdi!{\i0}
Dialogue: 0,0:05:23.99,0:05:25.79,Default,,0,0,0,,{\i1}İnanılmaz bir azmi var!{\i0}
Dialogue: 0,0:05:25.79,0:05:29.50,Default,,0,0,0,,{\i1}Göz açıp kapayıncaya kadar\Nkaybettiği topu kayarak çaldı...{\i0}
Dialogue: 0,0:05:29.51,0:05:31.80,Default,,0,0,0,,{\i1}...ve şimdi Furano kalesine doğru ilerliyor!{\i0}
Dialogue: 0,0:05:33.43,0:05:35.18,Default,,0,0,0,,Millet geri dönün! Geri dönün!
Dialogue: 0,0:05:35.68,0:05:40.19,Default,,0,0,0,,{\i1}Şu an kafamda şampiyon\Nolmak haricinde bir şey yok.{\i0}
Dialogue: 0,0:05:40.19,0:05:43.32,Default,,0,0,0,,{\i1}Hyuga-kun anında kale önüne ulaştı!{\i0}
Dialogue: 0,0:05:43.90,0:05:47.36,Default,,0,0,0,,{\i1}Kazanacağım! Ne olursa olsun kazanacağım!{\i0}
Dialogue: 0,0:05:47.36,0:05:48.82,Default,,0,0,0,,{\i1}Benim...{\i0}
Dialogue: 0,0:05:48.82,0:05:51.32,Default,,0,0,0,,{\i1}Hyuga-kun hızlıca şut çekmeye hazırlanıyor!{\i0}
Dialogue: 0,0:05:51.90,0:05:55.58,Default,,0,0,0,,{\i1}Benim kazanmaktan başka çarem yok!{\i0}
Dialogue: 0,0:05:56.73,0:05:57.91,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:05:57.91,0:05:59.83,Default,,0,0,0,,{\i1}Meiwa açılışı yapıyor!{\i0}
Dialogue: 0,0:05:59.83,0:06:01.58,Default,,0,0,0,,Başardın Hyuga-san!
Dialogue: 0,0:06:01.58,0:06:03.41,Default,,0,0,0,,{\i1}Bugün de çok formunda.{\i0}
Dialogue: 0,0:06:03.41,0:06:06.09,Default,,0,0,0,,{\i1}Meiwa'nın öfkeli kaplanı, Hyuga Kojiro-kun!{\i0}
Dialogue: 0,0:06:06.09,0:06:08.84,Default,,0,0,0,,{\i1}Bu, turnuvada 25. golü.{\i0}
Dialogue: 0,0:06:08.84,0:06:13.47,Default,,0,0,0,,{\i1}Gol krallığı konusunda Nankatsu'dan\NOzora Tsubasa-kun ile aynı sayıda.{\i0}
Dialogue: 0,0:06:15.60,0:06:17.52,Default,,0,0,0,,Hemen gol attılar...
Dialogue: 0,0:06:17.52,0:06:19.52,Default,,0,0,0,,Sorun değil çocuklar!
Dialogue: 0,0:06:19.52,0:06:23.77,Default,,0,0,0,,Oyun daha yeni başladı ve Meiwa,\NHyuga'dan oluşan tek kişilik bir takım.
Dialogue: 0,0:06:23.77,0:06:27.40,Default,,0,0,0,,Onlara futbolun takım oyunu\Nolduğunu öğretelim!
Dialogue: 0,0:06:27.40,0:06:28.57,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:29.47,0:06:32.16,Default,,0,0,0,,{\i1}Furano, Meiwa ile mücadeleye devam etti ama...{\i0}
Dialogue: 0,0:06:32.16,0:06:33.41,Default,,0,0,0,,{\i1}İzin vermem!{\i0}
Dialogue: 0,0:06:34.65,0:06:37.29,Default,,0,0,0,,{\i1}Hyuga-kun'un kayarak çalımı çok güçlü!{\i0}
Dialogue: 0,0:06:37.29,0:06:38.44,Default,,0,0,0,,Nakagawa!
Dialogue: 0,0:06:38.44,0:06:43.38,Default,,0,0,0,,{\i1}Hyuga Kojiro önlerini kapatırken bahsi\Ngeçmeye değer bir atak yapamıyorlardı.{\i0}
Dialogue: 0,0:06:43.38,0:06:45.76,Default,,0,0,0,,Gerçekten de Meiwa daha iyi.
Dialogue: 0,0:06:45.76,0:06:47.63,Default,,0,0,0,,Bunu şimdi anlayamazsın.
Dialogue: 0,0:06:48.38,0:06:51.63,Default,,0,0,0,,Furano İlkokulu'nun olduğu yere çok kar yağar.
Dialogue: 0,0:06:52.90,0:06:57.44,Default,,0,0,0,,Herkes o derin kar içerisinde\Nher gün ağır pratikler yapar.
Dialogue: 0,0:06:57.44,0:06:58.89,Default,,0,0,0,,{\i1}Hadi sesini duyayım!{\i0}
Dialogue: 0,0:06:58.89,0:07:01.43,Default,,0,0,0,,{\i1}Bu kadarcık kar cesaretinizi kırmasın!{\i0}
Dialogue: 0,0:07:01.43,0:07:04.11,Default,,0,0,0,,Bu yüzden dayanıklıkları ve\Nkararlılıkları çok yüksektir.
Dialogue: 0,0:07:04.11,0:07:05.19,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:07:05.19,0:07:07.19,Default,,0,0,0,,{\i1}Furano bir fırsat yakalıyor!{\i0}
Dialogue: 0,0:07:07.19,0:07:09.69,Default,,0,0,0,,{\i1}Kale önündeki Matsuyama-kun topu aldı!{\i0}
Dialogue: 0,0:07:09.69,0:07:10.95,Default,,0,0,0,,{\i1}Bomboş!{\i0}
Dialogue: 0,0:07:10.95,0:07:12.50,Default,,0,0,0,,{\i1}Tamamdır, beraberliği sağlayacağım!{\i0}
Dialogue: 0,0:07:12.50,0:07:14.07,Default,,0,0,0,,{\i1}Matsuyama-kun şut çekecek!{\i0}
Dialogue: 0,0:07:14.07,0:07:15.49,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:07:15.49,0:07:18.33,Default,,0,0,0,,{\i1}Ama Hyuga-kun onu durdurmak için arkasında!{\i0}
Dialogue: 0,0:07:18.33,0:07:19.91,Default,,0,0,0,,{\i1}İşte geldin Hyuga.{\i0}
Dialogue: 0,0:07:23.24,0:07:23.85,Default,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:07:23.85,0:07:27.42,Default,,0,0,0,,{\i1}Top yerine ayağına vurduğu çok basit!{\i0}
Dialogue: 0,0:07:29.48,0:07:30.63,Default,,0,0,0,,{\i1}Bariz bir faul.{\i0}
Dialogue: 0,0:07:30.63,0:07:32.58,Default,,0,0,0,,{\i1}Furano penaltı kullanacak.{\i0}
Dialogue: 0,0:07:34.08,0:07:35.18,Default,,0,0,0,,Hyuga.
Dialogue: 0,0:07:36.11,0:07:39.56,Default,,0,0,0,,Kayarak çalımını yendim.
Dialogue: 0,0:07:40.35,0:07:42.81,Default,,0,0,0,,Adi... Bilerek mi ayağını koydun?
Dialogue: 0,0:07:42.81,0:07:44.98,Default,,0,0,0,,{\i1}Hyuga-kun sarı kart alıyor.{\i0}
Dialogue: 0,0:07:44.98,0:07:47.06,Default,,0,0,0,,{\i1}İkinci bir sarı kartta çıkacak.{\i0}
Dialogue: 0,0:07:47.06,0:07:50.82,Default,,0,0,0,,{\i1}Hyuga-kun artık istediği\Nkadar rahat hareket edemeyecek.{\i0}
Dialogue: 0,0:07:52.74,0:07:58.71,Default,,0,0,0,,{\i1}Furano penaltı kazanmasına rağmen\NMatsuyama-kun'un bacağı iyi mi acaba?{\i0}
Dialogue: 0,0:07:58.71,0:08:01.16,Default,,0,0,0,,Böyle bir çalımla yılacak halim yok.
Dialogue: 0,0:08:01.57,0:08:02.90,Default,,0,0,0,,Sana öğreteceğim Hyuga.
Dialogue: 0,0:08:02.90,0:08:04.90,Default,,0,0,0,,Futbol tek kişi oynanmaz.
Dialogue: 0,0:08:04.90,0:08:09.92,Default,,0,0,0,,Tek kişilik Meiwa takımını\NFurano olarak yeneceğiz!
Dialogue: 0,0:08:16.72,0:08:19.14,Default,,0,0,0,,{\i1}Furano beraberlik fırsatı yakaladı.{\i0}
Dialogue: 0,0:08:19.14,0:08:22.22,Default,,0,0,0,,{\i1}Topu yavaşça yerine koyan\NMatsuyama-kun mesafeyi ayarlıyor.{\i0}
Dialogue: 0,0:08:25.12,0:08:26.19,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:08:34.94,0:08:36.34,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:08:36.34,0:08:37.74,Default,,0,0,0,,{\i1}Kaleci hareket bile edemedi.{\i0}
Dialogue: 0,0:08:37.74,0:08:40.24,Default,,0,0,0,,{\i1}Furano beraberliği sağlıyor!{\i0}
Dialogue: 0,0:08:40.24,0:08:41.99,Default,,0,0,0,,- Başardın!\N- İşte bu!
Dialogue: 0,0:08:42.86,0:08:44.07,Default,,0,0,0,,Bıraktın demek?
Dialogue: 0,0:08:49.30,0:08:51.84,Default,,0,0,0,,Liderliği hemen tekrar alacağız.
Dialogue: 0,0:08:52.57,0:08:58.01,Default,,0,0,0,,{\i1}Ne var ki bu andan sonra Kojiro, Furano'nun\Npaslaşmasının tamamen dışında kalmıştı.{\i0}
Dialogue: 0,0:08:59.39,0:09:01.43,Default,,0,0,0,,{\i1}İlk yarı bitiyor!{\i0}
Dialogue: 0,0:09:01.43,0:09:04.10,Default,,0,0,0,,{\i1}İlk yarı biterken skor 1-1.{\i0}
Dialogue: 0,0:09:04.10,0:09:06.44,Default,,0,0,0,,{\i1}Furano her şeyiyle mücadele ediyor.{\i0}
Dialogue: 0,0:09:06.83,0:09:10.44,Default,,0,0,0,,{\i1}Şampiyonluk konusunda iddialı\NMeiwa'nın hiç altında kalmıyor.{\i0}
Dialogue: 0,0:09:10.83,0:09:14.44,Default,,0,0,0,,{\i1}Bunda Kaptan Matsuyama-kun'un\Nçabaları göz ardı edilemez.{\i0}
Dialogue: 0,0:09:14.96,0:09:19.41,Default,,0,0,0,,{\i1}Meiwa'nın gol yıldızı Hyuga-kun'un\Nmaçın başında gol atmasından sonra...{\i0}
Dialogue: 0,0:09:19.41,0:09:21.58,Default,,0,0,0,,{\i1}...onları tamamen köşeye sıkıştırdılar.{\i0}
Dialogue: 0,0:09:22.22,0:09:23.79,Default,,0,0,0,,Bacağın iyi mi?
Dialogue: 0,0:09:23.79,0:09:25.62,Default,,0,0,0,,Endişelenecek bir şey yok.
Dialogue: 0,0:09:25.62,0:09:28.21,Default,,0,0,0,,Daha da önemlisi ikinci\Nyarıda da böyle devam edelim.
Dialogue: 0,0:09:28.21,0:09:29.78,Default,,0,0,0,,Kazanabiliriz çocuklar!
Dialogue: 0,0:09:29.78,0:09:30.88,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:34.46,0:09:38.22,Default,,0,0,0,,{\i1}Hyuga-kun bugün biraz tuhaf görünüyor.{\i0}
Dialogue: 0,0:09:40.22,0:09:42.05,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:09:44.99,0:09:46.85,Default,,0,0,0,,Hyuga-san...
Dialogue: 0,0:09:47.65,0:09:50.86,Default,,0,0,0,,{\i1}Kojiro, imkansızı zorluyorsun.{\i0}
Dialogue: 0,0:09:50.86,0:09:57.82,Default,,0,0,0,,{\i1}Ailene yardım etmek için yarı zamanlı çalışırken\NMeiwa'yı buraya kadar tek başına getirdin.{\i0}
Dialogue: 0,0:09:58.34,0:10:03.83,Default,,0,0,0,,{\i1}Normal bir ilkokul öğrencisi\Nşimdiye kadar aklını kaçırırdı.{\i0}
Dialogue: 0,0:10:05.21,0:10:06.36,Default,,0,0,0,,Takeshi.
Dialogue: 0,0:10:06.36,0:10:07.37,Default,,0,0,0,,Efendim?
Dialogue: 0,0:10:08.06,0:10:10.48,Default,,0,0,0,,Dinle. Nankatsu maçındaki gibi...
Dialogue: 0,0:10:10.48,0:10:13.30,Default,,0,0,0,,...bu maçın anahtarı da olacaksın.
Dialogue: 0,0:10:13.30,0:10:16.52,Default,,0,0,0,,Hyuga'ya şu an senden başkası yardım edemez.
Dialogue: 0,0:10:16.52,0:10:17.92,Default,,0,0,0,,E-Evet.
Dialogue: 0,0:10:20.00,0:10:21.29,Default,,0,0,0,,{\i1}Hyuga-san...{\i0}
Dialogue: 0,0:10:23.82,0:10:26.92,Default,,0,0,0,,{\i1}Hyuga-san ile ilk kez geçen\Nilkbaharda karşılaştım.{\i0}
Dialogue: 0,0:10:27.87,0:10:30.64,Default,,0,0,0,,{\i1}O zamanlar hala 3. sınıftım.{\i0}
Dialogue: 0,0:10:30.64,0:10:32.40,Default,,0,0,0,,{\i1}Bir, iki...{\i0}
Dialogue: 0,0:10:32.40,0:10:35.90,Default,,0,0,0,,{\i1}Sonunda yarın Meiwa FC'nin seçmeleri var.{\i0}
Dialogue: 0,0:10:35.90,0:10:38.28,Default,,0,0,0,,{\i1}Kesinlikle geçeceğim!{\i0}
Dialogue: 0,0:10:39.79,0:10:40.57,Default,,0,0,0,,{\i1}Topum...{\i0}
Dialogue: 0,0:10:41.53,0:10:45.62,Default,,0,0,0,,{\i1}Baksana sen. Kalbinden gelerek\Nfutbol oynamayacaksan bırak.{\i0}
Dialogue: 0,0:10:45.62,0:10:46.62,Default,,0,0,0,,{\i1}Ne?{\i0}
Dialogue: 0,0:10:46.62,0:10:49.76,Default,,0,0,0,,{\i1}Sahada duruyorken\Netrafındaki herkes rakibindir.{\i0}
Dialogue: 0,0:10:49.76,0:10:52.88,Default,,0,0,0,,{\i1}Ve bu rakipler her taraftan gelebilir.{\i0}
Dialogue: 0,0:10:53.76,0:10:58.01,Default,,0,0,0,,{\i1}Meiwa FC'ye girmek istiyorsan\Nbuna kendini hazırla.{\i0}
Dialogue: 0,0:10:59.29,0:11:02.26,Default,,0,0,0,,{\i1}O zamanlar kim olduğunu bilmiyorum.{\i0}
Dialogue: 0,0:11:03.54,0:11:06.69,Default,,0,0,0,,{\i1}Lütfen! Giriş sınavına katılmama izin verin!{\i0}
Dialogue: 0,0:11:06.69,0:11:10.81,Default,,0,0,0,,{\i1}Kurallarda 4. sınıftan büyüklerin\Ngirebileceği yazıyor diyorum ya.{\i0}
Dialogue: 0,0:11:10.81,0:11:12.03,Default,,0,0,0,,{\i1}Yalvarıyorum!{\i0}
Dialogue: 0,0:11:12.03,0:11:13.19,Default,,0,0,0,,{\i1}En azından deneyeyim!{\i0}
Dialogue: 0,0:11:13.19,0:11:14.92,Default,,0,0,0,,{\i1}Dükkanın önünü kapama!{\i0}
Dialogue: 0,0:11:14.92,0:11:17.19,Default,,0,0,0,,{\i1}Bırakın denesin.{\i0}
Dialogue: 0,0:11:17.89,0:11:18.78,Default,,0,0,0,,{\i1}Hyuga!{\i0}
Dialogue: 0,0:11:18.78,0:11:20.65,Default,,0,0,0,,{\i1}Sen önceki kişisin!{\i0}
Dialogue: 0,0:11:21.07,0:11:23.58,Default,,0,0,0,,{\i1}Futbolda yaş önemsizdir.{\i0}
Dialogue: 0,0:11:23.58,0:11:25.62,Default,,0,0,0,,{\i1}Futbol, yetenek mücadelesidir.{\i0}
Dialogue: 0,0:11:25.62,0:11:26.62,Default,,0,0,0,,{\i1}Ne dedin?!{\i0}
Dialogue: 0,0:11:26.62,0:11:30.93,Default,,0,0,0,,{\i1}Sonuçta 5. sınıf olmama rağmen hiçbir\N6. sınıf karşıma çıkamıyor değil mi?!{\i0}
Dialogue: 0,0:11:31.46,0:11:31.88,Default,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:11:31.88,0:11:32.90,Default,,0,0,0,,{\i1}İşte!{\i0}
Dialogue: 0,0:11:32.90,0:11:36.34,Default,,0,0,0,,{\i1}Hyuga-san sayesinde\Ngiriş sınavına girebildim.{\i0}
Dialogue: 0,0:11:36.34,0:11:39.89,Default,,0,0,0,,{\i1}Şu kısa olan çok iyi değil mi?{\i0}
Dialogue: 0,0:11:39.89,0:11:42.10,Default,,0,0,0,,{\i1}Sadece 3. sınıf bir de.{\i0}
Dialogue: 0,0:11:42.10,0:11:43.88,Default,,0,0,0,,{\i1}Öyle mi?{\i0}
Dialogue: 0,0:11:43.88,0:11:47.04,Default,,0,0,0,,{\i1}Sonrasında Koç Kira'nın\Nözel antrenmanları başladı.{\i0}
Dialogue: 0,0:11:47.04,0:11:48.50,Default,,0,0,0,,{\i1}Daha değil Takeshi!{\i0}
Dialogue: 0,0:11:48.50,0:11:49.27,Default,,0,0,0,,{\i1}Tamam!{\i0}
Dialogue: 0,0:11:49.27,0:11:54.52,Default,,0,0,0,,{\i1}Hyuga-san'ın ailesine yardım etmek\Niçin futbol oynarken çalıştığını öğrenince...{\i0}
Dialogue: 0,0:11:54.52,0:11:59.28,Default,,0,0,0,,{\i1}...Hyuga-san'a olan saygım daha da arttı.{\i0}
Dialogue: 0,0:11:59.28,0:12:01.46,Default,,0,0,0,,{\i1}Ve bir yemin ettim.{\i0}
Dialogue: 0,0:12:01.46,0:12:06.45,Default,,0,0,0,,{\i1}Hyuga-san ile birlikte şampiyonluk\Nbayrağını sallandıracağım.{\i0}
Dialogue: 0,0:12:07.79,0:12:09.66,Default,,0,0,0,,{\i1}İkinci yarı başlıyor!{\i0}
Dialogue: 0,0:12:09.66,0:12:11.91,Default,,0,0,0,,Gerçek gücümü daha görmediniz!
Dialogue: 0,0:12:11.91,0:12:14.17,Default,,0,0,0,,Daha fazlasını kaldıramayacağınız\Nderecede göstereceğim!
Dialogue: 0,0:12:14.17,0:12:14.92,Default,,0,0,0,,Al!
Dialogue: 0,0:12:15.36,0:12:17.58,Default,,0,0,0,,{\i1}Hyuga-kun topu çalıyor!{\i0}
Dialogue: 0,0:12:17.58,0:12:19.75,Default,,0,0,0,,{\i1}Rakip sahada top sürüyor.{\i0}
Dialogue: 0,0:12:19.75,0:12:21.05,Default,,0,0,0,,Ben onu tutarım!
Dialogue: 0,0:12:21.44,0:12:23.67,Default,,0,0,0,,{\i1}Hyuga-kun'u tutturmak için\Nyine Matsuyama-kun geliyor!{\i0}
Dialogue: 0,0:12:23.67,0:12:26.47,Default,,0,0,0,,{\i1}İki yıldız oyuncu arasında\Nyine bir çekişme yaşanıyor!{\i0}
Dialogue: 0,0:12:26.47,0:12:29.28,Default,,0,0,0,,{\i1}Matsuyama-kun topu alıyor.{\i0}
Dialogue: 0,0:12:29.28,0:12:29.97,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:12:29.97,0:12:30.93,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:30.93,0:12:34.81,Default,,0,0,0,,{\i1}Topu alan Meiwa'dan Sawada-kun!{\i0}
Dialogue: 0,0:12:34.81,0:12:35.73,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:12:37.00,0:12:37.81,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:12:38.78,0:12:39.81,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:12:39.81,0:12:41.81,Default,,0,0,0,,{\i1}Furano'nun defansı hazırlıksız!{\i0}
Dialogue: 0,0:12:42.36,0:12:44.08,Default,,0,0,0,,{\i1}Sawada-kun orta açıyor!{\i0}
Dialogue: 0,0:12:44.08,0:12:45.40,Default,,0,0,0,,{\i1}Yüksek bir top!{\i0}
Dialogue: 0,0:12:45.40,0:12:47.20,Default,,0,0,0,,{\i1}Matsuyama-kun kesebilecek mi?{\i0}
Dialogue: 0,0:12:48.95,0:12:52.12,Default,,0,0,0,,{\i1}Olmuyor! Top üzerinden geçiyor!{\i0}
Dialogue: 0,0:12:52.12,0:12:54.34,Default,,0,0,0,,Güzel pas Takeshi!
Dialogue: 0,0:12:57.20,0:12:58.42,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:12:58.42,0:13:00.63,Default,,0,0,0,,{\i1}Hyuga-kun bugünkü ikinci golünü atıyor!{\i0}
Dialogue: 0,0:13:01.08,0:13:05.38,Default,,0,0,0,,{\i1}Bu golle birlikte Hyuga-kun\Nturnuvanın gol kralı oluyor!{\i0}
Dialogue: 0,0:13:05.38,0:13:10.89,Default,,0,0,0,,{\i1}Nankatsu'dan Tsubasa-kun ve Misaki-kun'un\Nikili oyunu bu turnuvada çok konuşulsa da...{\i0}
Dialogue: 0,0:13:10.89,0:13:14.52,Default,,0,0,0,,{\i1}...Meiwa'da Hyuga-kun ve Sawada-kun'un\Nikili oyunu da çok söz ettiriyor.{\i0}
Dialogue: 0,0:13:14.52,0:13:18.98,Default,,0,0,0,,{\i1}Bu ikisi birlikteyken\NMeiwa FC çok güçlü oluyor gerçekten!{\i0}
Dialogue: 0,0:13:19.85,0:13:26.48,Default,,0,0,0,,{\i1}Aynen öyle. Turnuvada sonuna dek Hyuga-san'a\Ndestek olacağım ve kesinlikle şampiyon olacağız!{\i0}
Dialogue: 0,0:13:34.52,0:13:38.23,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvası'nın\Nilk yarı final maçı olan...{\i0}
Dialogue: 0,0:13:38.23,0:13:41.00,Default,,0,0,0,,{\i1}...Meiwa ve Furano maçı\Nbitmek üzere.{\i0}
Dialogue: 0,0:13:41.00,0:13:45.13,Default,,0,0,0,,{\i1}Son düdüğe 5 dakika var ve\NMeiwa 2-1 önde.{\i0}
Dialogue: 0,0:13:45.13,0:13:47.62,Default,,0,0,0,,{\i1}Furano durmadan kaleyi\Ntehdit etmesine rağmen...{\i0}
Dialogue: 0,0:13:47.62,0:13:49.64,Default,,0,0,0,,{\i1}...Meiwa çok iyi dayanıyor.{\i0}
Dialogue: 0,0:13:50.16,0:13:54.64,Default,,0,0,0,,{\i1}Meiwa ve Furano arasında\Nçok mücadele döndü.{\i0}
Dialogue: 0,0:13:54.64,0:13:57.14,Default,,0,0,0,,{\i1}Artık bir yorgunluk çökmesi gerekiyor.{\i0}
Dialogue: 0,0:13:57.14,0:13:58.63,Default,,0,0,0,,{\i1}Ama ellerinden geleni yapıyorlar!{\i0}
Dialogue: 0,0:13:58.63,0:14:01.15,Default,,0,0,0,,{\i1}İki taraf da sonuna kadar mücadele ediyor!{\i0}
Dialogue: 0,0:14:01.15,0:14:02.67,Default,,0,0,0,,Elinizden geleni yapın Furano!
Dialogue: 0,0:14:02.67,0:14:03.90,Default,,0,0,0,,Az daha zorlayın!
Dialogue: 0,0:14:03.90,0:14:07.15,Default,,0,0,0,,{\i1}Sizin gibilere hayatta kaybetmem ben!{\i0}
Dialogue: 0,0:14:07.15,0:14:11.51,Default,,0,0,0,,{\i1}Bugünkü maçta Hyuga-kun'un\Nbedeninde kesinlikle bir tuhaflık var.{\i0}
Dialogue: 0,0:14:11.51,0:14:14.66,Default,,0,0,0,,{\i1}Matsuyama da Hyuga'nın çalımı\Nyüzünden bacağını yaraladı.{\i0}
Dialogue: 0,0:14:14.66,0:14:17.91,Default,,0,0,0,,{\i1}Bu maçtan kimin galip\Nçıkacağını hala kestiremeyiz.{\i0}
Dialogue: 0,0:14:19.48,0:14:21.92,Default,,0,0,0,,{\i1}Böyle bir yaralanmanın\Nbeni durdurmasına imkan yok!{\i0}
Dialogue: 0,0:14:21.92,0:14:23.17,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:14:23.17,0:14:25.92,Default,,0,0,0,,{\i1}Matsuyama-kun'a pas geliyor!{\i0}
Dialogue: 0,0:14:25.92,0:14:28.80,Default,,0,0,0,,Ezin şunu! Geçmesine izin vermeyin!
Dialogue: 0,0:14:29.92,0:14:31.43,Default,,0,0,0,,{\i1}Duvar pası geliyor!{\i0}
Dialogue: 0,0:14:31.43,0:14:33.30,Default,,0,0,0,,{\i1}Furano atağa devam edebilecek mi?{\i0}
Dialogue: 0,0:14:33.30,0:14:34.81,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:14:35.41,0:14:38.48,Default,,0,0,0,,{\i1}Matsuyama-kun'un ayağı takılıyor!{\i0}
Dialogue: 0,0:14:38.48,0:14:39.23,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:14:41.66,0:14:43.52,Default,,0,0,0,,{\i1}Meiwa faul yapıyor.{\i0}
Dialogue: 0,0:14:43.52,0:14:45.49,Default,,0,0,0,,{\i1}Ishii-kun sarı kart alıyor.{\i0}
Dialogue: 0,0:14:45.49,0:14:47.15,Default,,0,0,0,,{\i1}Furano serbest vuruş kullanacak.{\i0}
Dialogue: 0,0:14:47.15,0:14:48.15,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:14:49.79,0:14:51.24,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:14:51.24,0:14:53.87,Default,,0,0,0,,Böyle bir şey beni yıldıramaz!
Dialogue: 0,0:14:54.26,0:14:55.41,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:14:55.41,0:14:59.16,Default,,0,0,0,,Mesele antrenman olunca\Nkimseye kaybetmeyiz!
Dialogue: 0,0:14:59.81,0:15:04.62,Default,,0,0,0,,O soğuk karın için antrenman\Nyaptığımız zamanlarla karşılaştırınca...
Dialogue: 0,0:15:04.62,0:15:07.17,Default,,0,0,0,,...buna zorluk bile denmez!
Dialogue: 0,0:15:08.01,0:15:10.37,Default,,0,0,0,,Çocuklar, zor olduğunu biliyorum.
Dialogue: 0,0:15:10.37,0:15:11.92,Default,,0,0,0,,Ama biraz daha çabalamalıyız!
Dialogue: 0,0:15:11.92,0:15:14.64,Default,,0,0,0,,Onlara şimdiye kadarki\Nantrenmanlarımızın sonucunu gösterelim!
Dialogue: 0,0:15:14.64,0:15:15.85,Default,,0,0,0,,Evet!
Dialogue: 0,0:15:17.02,0:15:19.50,Default,,0,0,0,,{\i1}Bu noktadan serbest vuruş kullanacaklar.{\i0}
Dialogue: 0,0:15:19.50,0:15:21.85,Default,,0,0,0,,{\i1}Furano'nun beraberliği sağlama şansı var.{\i0}
Dialogue: 0,0:15:21.85,0:15:23.06,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:15:23.06,0:15:24.94,Default,,0,0,0,,{\i1}Tehlikeli bir pozisyon.{\i0}
Dialogue: 0,0:15:26.46,0:15:27.61,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:15:28.79,0:15:30.53,Default,,0,0,0,,Ateşin var!
Dialogue: 0,0:15:30.53,0:15:32.49,Default,,0,0,0,,Sorun değil Takeshi.
Dialogue: 0,0:15:32.49,0:15:34.28,Default,,0,0,0,,{\i1}Üç forvet var.{\i0}
Dialogue: 0,0:15:34.28,0:15:37.16,Default,,0,0,0,,{\i1}Furano'dan Matsuyama-kun nereye gönderecek?{\i0}
Dialogue: 0,0:15:37.99,0:15:39.08,Default,,0,0,0,,{\i1}Size güveniyorum!{\i0}
Dialogue: 0,0:15:40.87,0:15:42.12,Default,,0,0,0,,{\i1}En uzak direğe!{\i0}
Dialogue: 0,0:15:42.12,0:15:43.58,Default,,0,0,0,,Hava topu mücadelesi!
Dialogue: 0,0:15:43.58,0:15:46.92,Default,,0,0,0,,{\i1}Karlarda zıplamamızla karşılaştırılınca...{\i0}
Dialogue: 0,0:15:46.92,0:15:47.76,Default,,0,0,0,,Al!
