Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:00.98,0:00:03.75,Default,,0,0,0,,Nankatsu'ya karşı yarı final maçı neredeyse geldi.
Dialogue: 0,0:00:03.75,0:00:06.98,Default,,0,0,0,,Bugün, turnuvada ki en büyük engel ile karşılaşacağımızı söyleyebilirim.
Dialogue: 0,0:00:06.98,0:00:11.54,Default,,0,0,0,,Yarını düşünmeyin. Bugün sahip\N olduğunuz her şeyi verin ve onlarla yüzleşin!
Dialogue: 0,0:00:11.54,0:00:12.24,Default,,0,0,0,,Tamam!
Dialogue: 0,0:00:12.24,0:00:13.47,Default,,0,0,0,,İyi.
Dialogue: 0,0:00:13.47,0:00:14.54,Default,,0,0,0,,Koç!
Dialogue: 0,0:00:14.54,0:00:16.21,Default,,0,0,0,,Noldu Menajer?
Dialogue: 0,0:00:16.21,0:00:19.41,Default,,0,0,0,,Yoshiko herkes için saç bandı yaptı.
Dialogue: 0,0:00:19.41,0:00:20.25,Default,,0,0,0,,Oh...
Dialogue: 0,0:00:20.25,0:00:24.16,Default,,0,0,0,,Başka hiçbir takımda yoktu, o yüzden...
Dialogue: 0,0:00:25.28,0:00:26.83,Default,,0,0,0,,Hadi, görmeme izin ver.
Dialogue: 0,0:00:29.82,0:00:33.30,Default,,0,0,0,,Vay... Bu kadarını yapmak çok zor olmalı.
Dialogue: 0,0:00:35.30,0:00:39.19,Default,,0,0,0,,Bu arada, ikinci dönem ABD'de olacaksın, değil mi Fujisawa?
Dialogue: 0,0:00:39.19,0:00:41.59,Default,,0,0,0,,Ayrılık hediyesi olarak harika bir anı kazandırmak
Dialogue: 0,0:00:41.59,0:00:43.94,Default,,0,0,0,,için ulusal şampiyon olmaya yemin ettik.
Dialogue: 0,0:00:45.17,0:00:47.94,Default,,0,0,0,,Pekala! Bugünkü maçta bunları takacağız!
Dialogue: 0,0:00:47.94,0:00:49.33,Default,,0,0,0,,Evet! Anlaştık!
Dialogue: 0,0:00:49.33,0:00:50.13,Default,,0,0,0,,Bunlar güzel! 
Dialogue: 0,0:00:50.13,0:00:51.69,Default,,0,0,0,,Düşündüğümden daha havalı görünüyorlar.
Dialogue: 0,0:00:51.69,0:00:53.32,Default,,0,0,0,,Bazen öne çıkmalıyız, değil mi?
Dialogue: 0,0:00:53.32,0:00:54.65,Default,,0,0,0,,Evet...
Dialogue: 0,0:00:54.65,0:00:55.93,Default,,0,0,0,,İşte, Oda-kun.
Dialogue: 0,0:00:55.93,0:00:56.53,Default,,0,0,0,,Evet.
Dialogue: 0,0:00:56.53,0:01:00.41,Default,,0,0,0,,Yoshiko her birine numaralarınızı işledi.
Dialogue: 0,0:01:00.41,0:01:02.00,Default,,0,0,0,,Vay, haklısın!
Dialogue: 0,0:01:02.00,0:01:04.09,Default,,0,0,0,,Buyur, Matsuyama-kun.
Dialogue: 0,0:01:04.09,0:01:05.81,Default,,0,0,0,,Oh, teşekkürler!
Dialogue: 0,0:01:11.87,0:01:12.59,Default,,0,0,0,,{\i1}Pekala!{\i0}
Dialogue: 0,0:01:13.07,0:01:15.14,Default,,0,0,0,,{\i1}Sonunda geldik, Nankatsu.{\i0}
Dialogue: 0,0:01:15.14,0:01:17.68,Default,,0,0,0,,{\i1}Furano kesinlikle kazanacak! {\i0}
Dialogue: 0,0:01:17.68,0:01:20.64,Default-TOP,,0,0,0,,NANKATSU ORTAOKULU\NSHİZUOKA EYALETİ
Dialogue: 0,0:01:18.44,0:01:20.64,Default,,0,0,0,,Gerçekten iyi olacak mısın Tsubasa?
Dialogue: 0,0:01:20.64,0:01:24.90,Default,,0,0,0,,Evet. Ayak bileğim düzgün bir şekilde\N bantlanırsa, her zamanki gibi oynayabilirim.
Dialogue: 0,0:01:24.90,0:01:26.81,Default,,0,0,0,,Omzum çok daha iyi.
Dialogue: 0,0:01:27.49,0:01:29.16,Default,,0,0,0,,Her neyse, sadece 2 maç daha olacak.
Dialogue: 0,0:01:29.16,0:01:31.65,Default,,0,0,0,,Vücudum parçalara ayrılsa bile, yapacağım.
Dialogue: 0,0:01:31.65,0:01:35.35,Default,,0,0,0,,Bu kadar gaza geldiysen, Tsubasa, bize tam hızda ilerlemekten başka seçenek bırakmıyorsun!
Dialogue: 0,0:01:35.35,0:01:36.07,Default,,0,0,0,,Evet!
Dialogue: 0,0:01:36.52,0:01:37.50,Default,,0,0,0,,{\i1}Pekala!{\i0}
Dialogue: 0,0:01:37.50,0:01:39.07,Default,,0,0,0,,{\ İ1} Hadi yapalım, Matsuyama-kun. {\ İ0}
Dialogue: 0,0:01:50.03,0:02:05.03,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \N{\c&HB1351A&}İnstagram: AnimeSeverlerrr
Dialogue: 0,0:03:14.21,0:03:19.09,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}44.BÖLÜM: \N10 NUMARA VS. 10 NUMARA
Dialogue: 0,0:03:14.67,0:03:17.08,Default-TOP,,0,0,0,,{\ i1} Oyun birazdan başlayacak. {\ i0}
Dialogue: 0,0:03:17.08,0:03:20.47,Default-TOP,,0,0,0,,{\ i1} Ulusal Ortaokul Futbol Turnuvası'nın ikinci yarı final maçı {\ i0}
Dialogue: 0,0:03:20.47,0:03:23.47,Default,,0,0,0,,{\i1}Hokkaido temsilcileri, Furano ve{\i0}
Dialogue: 0,0:03:23.47,0:03:26.47,Default,,0,0,0,,{\i1} Shizuoka temsilcileri Nankatsu arasında olacak.{\i0}
Dialogue: 0,0:03:26.47,0:03:31.98,Default,,0,0,0,,{\i1}Sonunda, hangi takım yarın ki \Nbüyük finalde Toho ile karşılaşacak?{\i0}
Dialogue: 0,0:03:33.18,0:03:37.32,Default,,0,0,0,,{\i1}Yüksek sesli tezahüratlar \Neşliğinde, her iki takım da sahaya çıkıyor.{\i0}
Dialogue: 0,0:03:37.32,0:03:41.53,Default,,0,0,0,,{\i1}Bu nedir? Furano'nun tüm üyeleri \Nsahaya çıkarken kafa bandı takıyorlar.{\i0}
Dialogue: 0,0:03:41.53,0:03:45.78,Default,,0,0,0,,{\i1}Öte yandan, Nankatsu kendi takım üniformalarını giyiyor.{\i0}
Dialogue: 0,0:03:45.78,0:03:48.81,Default,,0,0,0,,{\i1}Furano, Kaptan Hikaru Matsuyama tarafından yönetiliyor.{\i0}
Dialogue: 0,0:03:48.81,0:03:50.16,Default,,0,0,0,,{\i1}10 numara giyen kişi.{\i0}
Dialogue: 0,0:03:50.16,0:03:54.92,Default,,0,0,0,,{\i1}Nankatsu lideri ve kaptanı\N Tsubasa Ozora da 10 numara giyiyor.{\i0}
Dialogue: 0,0:03:55.46,0:03:59.51,Default,,0,0,0,,{\i1}Bu oyun da 10 numara giyen iki orta saha kaptanımız var.{\i0}
Dialogue: 0,0:03:59.51,0:04:02.18,Default,,0,0,0,,{\ i1} Hangisi ilk önce orta sahaya egemen olacak? {\ i0}
Dialogue: 0,0:04:02.18,0:04:06.05,Default,,0,0,0,,{\ i1} Yaralı olsan bile, geri adım atmayacağım Tsubasa! {\ i0}
Dialogue: 0,0:04:06.05,0:04:07.49,Default,,0,0,0,,{\i1}İki tane daha...{\i0}
Dialogue: 0,0:04:07.49,0:04:08.90,Default,,0,0,0,,{\ i1} Kesinlikle kazanacağım! {\ i0}
Dialogue: 0,0:04:08.90,0:04:11.56,Default,,0,0,0,,{\i1}Japonya'da kimseye kaybetmeyi göze alamam!{\i0}
Dialogue: 0,0:04:11.56,0:04:15.35,Default,,0,0,0,,{\i1}Madeni para atıldıktan sonra\N Nankatsu başlayacak gibi görünüyor.{\i0}
Dialogue: 0,0:04:15.97,0:04:18.67,Default,,0,0,0,,Tsubasa, Furano'nun Nankatsu'yu düşürme hedefi var
Dialogue: 0,0:04:18.67,0:04:21.28,Default,,0,0,0,,ve bugün bu hedefi yerine getireceğiz.
Dialogue: 0,0:04:21.28,0:04:23.78,Default,,0,0,0,,Matsuyama-kun, kaybetmeyeceğim!
Dialogue: 0,0:04:26.16,0:04:28.91,Default,,0,0,0,,{\ i1} Lütfen kazan, Matsuyama-kun... {\ i0}
Dialogue: 0,0:04:28.91,0:04:31.91,Default,,0,0,0,,{\ i1} Tsubasa-kun, umarım yaraların daha da kötüye gitmez... {\ i0}
Dialogue: 0,0:04:31.91,0:04:35.17,Default,,0,0,0,,{\i1}Savaş! Savaş! Furano!{\i0}
Dialogue: 0,0:04:35.17,0:04:38.59,Default,,0,0,0,,{\i1}İyi şanslar! İyi şanslar! Nankatsu!{\i0}
Dialogue: 0,0:04:40.46,0:04:44.63,Default,,0,0,0,,{\i1}Hakemin düdüğü ile oyun nihayet başlıyor!{\i0}
Dialogue: 0,0:04:45.21,0:04:45.93,Default,,0,0,0,,İşte!
Dialogue: 0,0:04:46.90,0:04:49.26,Default,,0,0,0,,{\ i1} Top, oyun kurucu Tsubasa'ya geçti. {\ i0}
Dialogue: 0,0:04:50.45,0:04:51.06,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:04:51.97,0:04:55.58,Default,,0,0,0,,{\i1}Tsubasa, tekrar arkaya pas atarsan,{\i0}
Dialogue: 0,0:04:55.58,0:04:58.59,Default,,0,0,0,,{\i1}hepimiz Nankatsu'nun kalesine bir anda saldırırız.{\i0}
Dialogue: 0,0:04:58.59,0:05:01.61,Default,,0,0,0,,{\ i1} Size Furano'nun Çığ Saldırısını göstereceğiz! {\ i0}
Dialogue: 0,0:05:01.61,0:05:03.86,Default,,0,0,0,,İşte geliyorum Tsubasa!
Dialogue: 0,0:05:04.36,0:05:07.53,Default,,0,0,0,,{\ i1} Matsuyama-kun acımasızca Tsubasa-kun'a saldırıyor! {\ i0}
Dialogue: 0,0:05:08.99,0:05:10.26,Default,,0,0,0,,{\ i1} Beklediğim gibi, Tsubasa. {\ i0}
Dialogue: 0,0:05:10.26,0:05:12.22,Default,,0,0,0,,{\ i1} Pas gönderemeyeceğini biliyordun.
Dialogue: 0,0:05:12.22,0:05:15.21,Default,,0,0,0,,{\i1}Ama mücadelede ki ilk şey tuzaktır!
Dialogue: 0,0:05:15.21,0:05:16.87,Default,,0,0,0,,İşte gerçek mücadele!
Dialogue: 0,0:05:17.47,0:05:20.13,Default,,0,0,0,,{\i1}{\ i1} Matsuyama hızla onu tekrar yakalıyor!
Dialogue: 0,0:05:20.13,0:05:21.63,Default,,0,0,0,,Başardın! Aldın!
Dialogue: 0,0:05:21.63,0:05:22.94,Default,,0,0,0,,Kaptanımız bu hareketi buldu!
Dialogue: 0,0:05:22.94,0:05:24.13,Default,,0,0,0,,Bu onun Feinting Tackle!
Dialogue: 0,0:05:22.94,0:05:24.13,Default-TOP,,0,0,0,,Feinting Tackle: Yanıltıcı Top Çalma
Dialogue: 0,0:05:25.04,0:05:26.13,Default,,0,0,0,,Pekala hadi gidelim!
Dialogue: 0,0:05:26.13,0:05:27.13,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:27.13,0:05:29.33,Default,,0,0,0,,Lanet olsun! İyi oynadın Matsuyama-kun.
Dialogue: 0,0:05:29.33,0:05:30.89,Default,,0,0,0,,Ama kaybedemem!
Dialogue: 0,0:05:30.89,0:05:32.89,Default,,0,0,0,,{\ i1} Tsubasa-kun hemen ayağa kalkıyor ve {\ i0}
Dialogue: 0,0:05:32.89,0:05:35.02,Default,,0,0,0,,{\ i1}top süren Matsuyama-kun'nun peşinden koşuyor. {\ i0}
Dialogue: 0,0:05:35.02,0:05:36.19,Default,,0,0,0,,Kaptan, dikkat et!
Dialogue: 0,0:05:36.19,0:05:36.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:38.76,0:05:42.69,Default,,0,0,0,,{\ i1} Arkadaşının uyarısı sayesinde\N Matsuyama-kun topu uzaklaştırdı! {\ i0}
Dialogue: 0,0:05:43.69,0:05:44.94,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:05:46.74,0:05:47.52,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:05:47.52,0:05:48.24,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:48.24,0:05:48.93,Default,,0,0,0,,İyi!
Dialogue: 0,0:05:48.93,0:05:49.95,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:05:49.95,0:05:52.20,Default,,0,0,0,,Tsubasa'ya kaybetmeyeceğim!
Dialogue: 0,0:05:53.65,0:05:58.56,Default,,0,0,0,,{\i1}Tsubasa, sahaya ayak bastığında \Ngerçekten vahşi bir hale geliyorsun.{\i0}
Dialogue: 0,0:05:58.56,0:06:03.34,Default,,0,0,0,,{\i1}Maçta sakatlıkların olduğunu düşünürsek, acımaya başlarız.
Dialogue: 0,0:06:03.34,0:06:05.70,Default,,0,0,0,,{\ i1} Öyleyse, maçtaki sakatlıklarını görmezden geleceğim! {\ i0}
Dialogue: 0,0:06:05.70,0:06:06.38,Default,,0,0,0,,İşte!
Dialogue: 0,0:06:06.38,0:06:07.63,Default,,0,0,0,,İyi pas, Tsubasa!
Dialogue: 0,0:06:07.63,0:06:09.59,Default,,0,0,0,,Tamamdır! Devam et, Kisugi!
Dialogue: 0,0:06:11.47,0:06:13.97,Default,,0,0,0,,{\ i1} Kisugi-kun'nun şutu defansın bacağından saptı!
Dialogue: 0,0:06:13.97,0:06:16.43,Default,,0,0,0,,{\i1}Ve top tam Tsubasa-kun'nun önüne gelir.
Dialogue: 0,0:06:16.43,0:06:17.44,Default,,0,0,0,,{\i1}İyi!{\i0}
Dialogue: 0,0:06:18.23,0:06:21.19,Default,,0,0,0,,{\i1} Tsubasa'nın Drive Shot'unu yakında görecek miyiz?
Dialogue: 0,0:06:18.23,0:06:21.19,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:21.19,0:06:22.73,Default,,0,0,0,,{\i1}Sanki sana izin veririm.
Dialogue: 0,0:06:23.65,0:06:25.65,Default,,0,0,0,,{\ i1} Matsuyama-kun engelliyor! {\ i0}
Dialogue: 0,0:06:25.65,0:06:26.57,Default,,0,0,0,,Matsuyama!
Dialogue: 0,0:06:26.57,0:06:29.82,Default,,0,0,0,,Ne olursa olsun, Drive Shot'u atmana izin veremem!
Dialogue: 0,0:06:26.57,0:06:29.82,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:06:31.31,0:06:33.53,Default,,0,0,0,,{\i1}Matsuyama-kun saldırıya devam ediyor.{\i0}
Dialogue: 0,0:06:33.53,0:06:35.83,Default,,0,0,0,,{\ i1} Tsubasa-kun da hemen peşinde!
Dialogue: 0,0:06:38.79,0:06:44.75,Default,,0,0,0,,{\i1}Bu gerçekten iki orta saha oyuncusu, iki\N 10 numara arasında şiddetli bir güç gösterisi haline geldi.
Dialogue: 0,0:06:44.75,0:06:46.07,Default,,0,0,0,,{\i1}Tsubasa-kun...{\i0}
Dialogue: 0,0:06:46.07,0:06:47.13,Default,,0,0,0,,{\i1}Matsuyama-kun...{\i0}
Dialogue: 0,0:06:52.83,0:06:54.36,Default,,0,0,0,,Git, Matsuyama!
Dialogue: 0,0:06:54.36,0:06:56.04,Default,,0,0,0,,Durdur onu, Tsubasa!
Dialogue: 0,0:06:59.14,0:07:01.52,Default,,0,0,0,,{\i1}Bacaklarını tekmeliyorlar!
Dialogue: 0,0:07:01.52,0:07:03.68,Default,,0,0,0,,{\i1}Top havaya uçuyor!
Dialogue: 0,0:07:03.68,0:07:04.66,Default,,0,0,0,,{\i1}Matsuyama-kun...{\i0}
Dialogue: 0,0:07:04.66,0:07:05.78,Default,,0,0,0,,{\i1}Tsubasa!{\i0}
Dialogue: 0,0:07:06.50,0:07:08.86,Default,,0,0,0,,{\i1}Orta sahayı yönetmene izin vermeyeceğim!{\i0}
Dialogue: 0,0:07:06.61,0:07:08.86,Default-TOP,,0,0,0,,ORTA SAHAYI YÖNETMENE İZİN VERMEYECEĞİM.
Dialogue: 0,0:07:10.31,0:07:11.24,Default,,0,0,0,,Git!
Dialogue: 0,0:07:13.11,0:07:14.74,Default,,0,0,0,,{\i1}İki uzun boylu oyuncu çarpışıyor!{\i0}
Dialogue: 0,0:07:16.20,0:07:18.20,Default,,0,0,0,,{\ i1} Topu kim ele geçirecek? {\ i0}
Dialogue: 0,0:07:19.46,0:07:19.91,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:07:19.91,0:07:21.91,Default,,0,0,0,,Devam et Izawa!
Dialogue: 0,0:07:21.91,0:07:24.44,Default,,0,0,0,,{\ i1} Futbol tamamen takım oyunuyla ilgilidir.
Dialogue: 0,0:07:24.44,0:07:26.48,Default,,0,0,0,,{\ i1} Tsubasa ve Matsuyama'yı eşit kabul edersek,
Dialogue: 0,0:07:26.48,0:07:29.26,Default,,0,0,0,,{\i1}Nankatsu’nun Izawa gibi başka bir oyun kurucusu olduğundan,{\i0}
Dialogue: 0,0:07:29.26,0:07:31.34,Default,,0,0,0,,{\i1}burada avantajı sağlayabilirler.{\i0}
Dialogue: 0,0:07:31.34,0:07:32.56,Default,,0,0,0,,Geri dönün millet!
Dialogue: 0,0:07:32.56,0:07:33.59,Default,,0,0,0,,Savunmalıyız!
Dialogue: 0,0:07:33.59,0:07:34.93,Default,,0,0,0,,Bu senin için Kisugi!
Dialogue: 0,0:07:34.93,0:07:36.06,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:07:36.06,0:07:38.10,Default,,0,0,0,,{\ i1} Kisugi'den kayan bir şut! {\ i0}
Dialogue: 0,0:07:38.10,0:07:38.97,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:39.59,0:07:41.48,Default,,0,0,0,,{\ i1} Ama Furano engelledi! {\ i0}
Dialogue: 0,0:07:41.48,0:07:43.23,Default,,0,0,0,,{\i1}Gollerini tamamen engellediler!{\i0}
Dialogue: 0,0:07:43.23,0:07:44.24,Default,,0,0,0,,Uzaklaştır!
Dialogue: 0,0:07:44.98,0:07:47.10,Default,,0,0,0,,{\i1}Furano bu kötü durumdan çıktı!{\i0}
Dialogue: 0,0:07:47.91,0:07:48.77,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:07:49.53,0:07:53.99,Default,,0,0,0,,{\ i1}Matsuyama-kun durdurma şansı yakalamadan, \NTsubasa-kun Furano'nun kalesine doğru bir pas gönderiyor. {\ i0}
Dialogue: 0,0:07:53.99,0:07:56.28,Default,,0,0,0,,Dayanın, millet! Bundan kurtulacağız!
Dialogue: 0,0:07:57.62,0:08:02.79,Default,,0,0,0,,{\i1}Izawa pası kullanıp zıplayarak kafa vuruşu yapıyor!
Dialogue: 0,0:08:04.13,0:08:05.24,Default,,0,0,0,,{\i1}Engellendi!{\i0}
Dialogue: 0,0:08:05.24,0:08:08.13,Default,,0,0,0,,{\ i1} Kaleci Kato, zar zor engellemeyi başarıyor!
Dialogue: 0,0:08:08.13,0:08:09.76,Default,,0,0,0,,İyiydi, Kato!
Dialogue: 0,0:08:10.23,0:08:11.05,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:08:12.63,0:08:14.31,Default,,0,0,0,,Kalemizi iyi savundunuz!
Dialogue: 0,0:08:14.31,0:08:15.28,Default,,0,0,0,,Herkes öne çıksın!
Dialogue: 0,0:08:15.28,0:08:17.05,Default,,0,0,0,,Furano'nun Çığ Saldırısı'nı kullanıyoruz!
Dialogue: 0,0:08:17.05,0:08:17.97,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:17.97,0:08:19.18,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:19.18,0:08:20.77,Default,,0,0,0,,Az önce "Çığ Saldırısı" mı dedi?
Dialogue: 0,0:08:20.77,0:08:24.62,Default,,0,0,0,,{\i1}Furano, dezavantajlı durumuna rağmen seri bir karşı saldırı için hızla koşuyor!{\i0}
Dialogue: 0,0:08:24.62,0:08:28.29,Default,,0,0,0,,{\i1} Bütün oyuncuları Nankatsu'nun kalesine doğru gidiyor!{\i0}
Dialogue: 0,0:08:28.29,0:08:29.74,Default,,0,0,0,,{\ i1} Tamamdır! Hadi yapalım millet! {\ İ0}
Dialogue: 0,0:08:29.74,0:08:32.00,Default,,0,0,0,,{\ i1} Topu size göndereceğim. {\ i0}
Dialogue: 0,0:08:32.00,0:08:34.22,Default,,0,0,0,,{\ i1} Ne cesur bir taktik! {\ i0}
Dialogue: 0,0:08:34.22,0:08:39.03,Default,,0,0,0,,{\ i1} Matsuyama-kun'nun top kontrol\N becerilerine bu kadar güveniyorlar mı? {\ i0}
Dialogue: 0,0:08:39.59,0:08:41.89,Default,,0,0,0,,{\ i1} Göz açıp kapayıncaya kadar Kisugi ve Taki'yi geçti! {\ i0}
Dialogue: 0,0:08:41.89,0:08:43.12,Default,,0,0,0,,{\ i1} Beklendiği gibi Matsuyama-kun! {\ i0}
Dialogue: 0,0:08:43.12,0:08:45.98,Default,,0,0,0,,{\i1}Turnuvada top kontrol becerilerinde 1. olduğu söyleniyor!{\i0}
Dialogue: 0,0:08:45.98,0:08:47.54,Default,,0,0,0,,{\ i1} Ah, Tsubasa-kun da neredeyse orada!
Dialogue: 0,0:08:47.54,0:08:48.54,Default,,0,0,0,,Yani, bundan önce...
Dialogue: 0,0:08:49.71,0:08:52.37,Default,,0,0,0,,{\ i1} Matsuyama-kun uzun bir pas atıyor! {\ i0}
Dialogue: 0,0:08:52.37,0:08:53.22,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:08:53.22,0:08:54.09,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:54.09,0:08:56.64,Default,,0,0,0,,Kaç kişi, olursa olsun, sadece bir top var!
Dialogue: 0,0:08:56.64,0:08:57.39,Default,,0,0,0,,Sadece uzaklaştırın!
Dialogue: 0,0:08:58.68,0:09:00.87,Default,,0,0,0,,Eğer bizden önce vururlarsa, takip ederiz!
Dialogue: 0,0:09:00.87,0:09:02.40,Default,,0,0,0,,Kahretsin, uzaklaştırın!
Dialogue: 0,0:09:02.40,0:09:03.88,Default,,0,0,0,,Bastırın!
Dialogue: 0,0:09:04.56,0:09:05.52,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:05.52,0:09:06.76,Default,,0,0,0,,Faydasız!
Dialogue: 0,0:09:06.76,0:09:09.86,Default,,0,0,0,,Uzaklaştırdığımız zaman bile, art arda gelmeye devam ediyorlar!
Dialogue: 0,0:09:09.86,0:09:12.04,Default,,0,0,0,,Bizden birinden topu çalarsanız...
Dialogue: 0,0:09:12.04,0:09:13.28,Default,,0,0,0,,Her birimiz...
Dialogue: 0,0:09:13.28,0:09:15.25,Default,,0,0,0,,Birbirimizi koruyacağız!
Dialogue: 0,0:09:15.25,0:09:15.91,Default,,0,0,0,,Bu...
Dialogue: 0,0:09:15.91,0:09:16.99,Default,,0,0,0,,Furano'nun...
Dialogue: 0,0:09:16.99,0:09:19.16,Default,,0,0,0,,Çığ Saldırısı!
Dialogue: 0,0:09:19.16,0:09:20.61,Default,,0,0,0,,{\ i1} Bu Furano'nun Çığ Saldırısı! {\ i0}
Dialogue: 0,0:09:20.61,0:09:23.29,Default,,0,0,0,,{\ i1} Nankatsu'nun savunmasını tek seferde yıkacak mı? {\ i0}
Dialogue: 0,0:09:23.29,0:09:24.13,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:09:24.13,0:09:26.17,Default,,0,0,0,,{\ i1} Sonunda topu kaleye attılar! {\ i0}
Dialogue: 0,0:09:27.04,0:09:29.37,Default,,0,0,0,,{\ i1} Kaleci Morisaki uzaklaştırdı! {\ i0}
Dialogue: 0,0:09:29.37,0:09:31.67,Default,,0,0,0,,{\i1}Bu krizden ucu ucuna kurtuluyor!{\i0}
Dialogue: 0,0:09:31.67,0:09:34.93,Default,,0,0,0,,{\ i1}Ama hem Tsubasa-kun hem de\N Matsuyama-kun topa doğru koşuyor! {\ i0}
Dialogue: 0,0:09:34.93,0:09:36.47,Default,,0,0,0,,{\ i1} Hangisi daha hızlı? {\ i0}
Dialogue: 0,0:09:36.47,0:09:37.76,Default,,0,0,0,,Kaptan, bize bırak!
Dialogue: 0,0:09:38.30,0:09:39.59,Default,,0,0,0,,Tamam!
Dialogue: 0,0:09:39.59,0:09:41.93,Default,,0,0,0,,{\ i1} Matsuyama kaleye doğru gidiyor! {\ i0}
Dialogue: 0,0:09:41.93,0:09:42.93,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:09:45.15,0:09:45.94,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:09:46.98,0:09:49.27,Default,,0,0,0,,Pekala, ben hallederim!
Dialogue: 0,0:09:51.86,0:09:53.69,Default,,0,0,0,,{\i1}Orta okul futbolunun Büyük 2'si... {\i0}
Dialogue: 0,0:09:54.20,0:09:56.27,Default,,0,0,0,,{\i1}Nankatsu ve Toho.{\i0}
Dialogue: 0,0:09:56.27,0:09:59.47,Default,,0,0,0,,{\i1}Onlara kıyasla, Furano’nun açıkça sahip olmadığı gol atma yeteneği.{\i0}
Dialogue: 0,0:09:59.47,0:10:07.51,Default,,0,0,0,,{\ i1} Bunu düzeltmek için, orta saha oyuncusu olarak gol atmak istersem, oyuna başlarken uzun şutlar yapabilmem gerekecek.
Dialogue: 0,0:10:07.51,0:10:10.50,Default,,0,0,0,,{\i1}Tsubasa ve Hyuga gibi doğal olarak yetenekli değilim.{\i0}
Dialogue: 0,0:10:11.14,0:10:12.80,Default,,0,0,0,,{\ i1} Bu yüzden çalışmaya devam edeceğim! {\ i0}
Dialogue: 0,0:10:12.80,0:10:16.88,Default,,0,0,0,,{\ i1} Yeteneksizin, daha fazla çalışmaktan başka çaresi yok! {\ i0}
Dialogue: 0,0:10:25.07,0:10:28.64,Default,,0,0,0,,{\i1}Matsuyama-kun bu uzun şuta sahip olduğu her şeyi koyuyor!{\i0}
Dialogue: 0,0:10:28.64,0:10:29.77,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:10:29.77,0:10:31.44,Default,,0,0,0,,{\ i1} Bunu Minamiuwa'ya karşı kullandı! {\ i0}
Dialogue: 0,0:10:31.44,0:10:34.44,Default,,0,0,0,,{\ i1} Yerde sürünen ve ardında bir toz izi bırakan,{\ i0}
Dialogue: 0,0:10:34.44,0:10:37.44,Default,,0,0,0,,{\ i1} Matsuyama-kun'nun heyecan verici uzun şutu bu! {\ i0}
Dialogue: 0,0:10:41.01,0:10:42.27,Default,,0,0,0,,{\i1}İçerde!{\i0}
Dialogue: 0,0:10:42.27,0:10:44.91,Default,,0,0,0,,{\ i1}Kaleci Morisaki tepki vermek için çok yavaştı!{\ i0}
Dialogue: 0,0:10:44.91,0:10:46.60,Default,,0,0,0,,{\i1}İlk Furano öne geçti!{\i0}
Dialogue: 0,0:10:46.60,0:10:47.25,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:47.25,0:10:49.33,Default,,0,0,0,,Bir gol attım, millet!
Dialogue: 0,0:10:51.50,0:10:56.51,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:10:56.51,0:10:58.52,Default,,0,0,0,,Başardın Kaptan!
Dialogue: 0,0:10:58.52,0:11:00.51,Default,,0,0,0,,{\i1}Furano nihayet öne geçiyor!{\i0}
Dialogue: 0,0:11:00.51,0:11:05.97,Default,,0,0,0,,{\i1}Karlı toprakların kaba zemininde \Nbacaklarını eğiterek yarattığı görkemli bir uzun şut!{\i0}
Dialogue: 0,0:11:05.97,0:11:10.58,Default,,0,0,0,,{\i1}Furano'nun Çığ Saldırısı ile başlayıp, \NMatsuyama-kun'nun "Kuzey Ülkesi Atışı" ile bitti,{\i0}
Dialogue: 0,0:11:10.58,0:11:12.98,Default,,0,0,0,,{\ i1} nihayetinde liderliği kazandılar! {\ i0}
Dialogue: 0,0:11:12.98,0:11:15.17,Default,,0,0,0,,Başardılar Yoshiko!
Dialogue: 0,0:11:15.17,0:11:15.94,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:15.94,0:11:17.28,Default,,0,0,0,,İyi!
Dialogue: 0,0:11:17.28,0:11:18.28,Default,,0,0,0,,{\ i1} Beni yakaladılar. {\ i0}
Dialogue: 0,0:11:18.28,0:11:22.91,Default,,0,0,0,,{\ i1} Bu şutun görünümünden... Çok sıkı \Nantrenman yapmış olmalısın, Matsuyama-kun. {\ i0}
Dialogue: 0,0:11:22.91,0:11:23.97,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:11:23.97,0:11:26.31,Default,,0,0,0,,Baskıyı yapan bizdik, ve yine de...
Dialogue: 0,0:11:26.31,0:11:27.27,Default,,0,0,0,,Her şeye lanet olsun.
Dialogue: 0,0:11:27.27,0:11:28.41,Default,,0,0,0,,Millet.
Dialogue: 0,0:11:28.41,0:11:29.97,Default,,0,0,0,,Ruh halimizi yenileyelim.
Dialogue: 0,0:11:29.97,0:11:31.97,Default,,0,0,0,,Bugün kaybedersek yarın olmaz.
Dialogue: 0,0:11:31.97,0:11:34.42,Default,,0,0,0,,Bugün Furano'yu yenmek için \Nelimizden gelenin en iyisini yapalım.
Dialogue: 0,0:11:35.01,0:11:39.30,Default,,0,0,0,,Eşsiz 3. zaferi kendi gücümüzle kazanacağız!
Dialogue: 0,0:11:39.30,0:11:40.63,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:41.87,0:11:43.97,Default,,0,0,0,,{\ i1} İlk golü yeseler bile, {\ i0}
Dialogue: 0,0:11:43.97,0:11:46.56,Default,,0,0,0,,{\ i1}Nankatsu oyuncuları omuzlarını silkti ve saldırmak için harekete geçti!{\ i0}
Dialogue: 0,0:11:46.56,0:11:48.76,Default,,0,0,0,,{\i1}Morallerini çabucak geri kazanabiliyorlar.{\i0}
Dialogue: 0,0:11:48.76,0:11:51.02,Default,,0,0,0,,{\ i1} Nankatsu’nun korkunç yanı bu. {\ i0}
Dialogue: 0,0:11:51.02,0:11:52.73,Default,,0,0,0,,Konsantre olun!
Dialogue: 0,0:11:52.73,0:11:53.48,Default,,0,0,0,,Tamam!
Dialogue: 0,0:11:53.48,0:11:57.52,Default,,0,0,0,,{\ i1} Kaptan Tsubasa-kun topu kendi kendine sürüyor!
Dialogue: 0,0:11:57.52,0:12:00.16,Default,,0,0,0,,Tamam, Tsubasa'yı bana bırakın!
Dialogue: 0,0:12:01.61,0:12:02.64,Default,,0,0,0,,{\i1}Matsuyama-kun!{\i0}
Dialogue: 0,0:12:02.64,0:12:03.70,Default,,0,0,0,,{\i1}Tsubasa!{\i0}
Dialogue: 0,0:12:03.70,0:12:05.12,Default,,0,0,0,,Al hadi!
Dialogue: 0,0:12:05.12,0:12:08.56,Default,,0,0,0,,{\ i1} Matsuyama-kun ona ulaşmadan önce topu Taki-kun'a gönderiyor. {\ i0}
Dialogue: 0,0:12:08.56,0:12:09.20,Default,,0,0,0,,İşte bu.
Dialogue: 0,0:12:09.20,0:12:10.33,Default,,0,0,0,,Devam edin millet!
Dialogue: 0,0:12:10.33,0:12:12.03,Default,,0,0,0,,Nankatsu'nun meşhur hücumu!
Dialogue: 0,0:12:12.03,0:12:14.17,Default,,0,0,0,,Sadece bir gol! Çabuk karşılığını verin!
Dialogue: 0,0:12:15.79,0:12:17.27,Default,,0,0,0,,{\ i1} Furano dersine çalışmış.{\ i0}
Dialogue: 0,0:12:17.27,0:12:18.50,Default,,0,0,0,,{\ i1} Kondo-kun durdurmak için burada. {\ i0}
Dialogue: 0,0:12:18.50,0:12:19.88,Default,,0,0,0,,Bir adam sorun değil ...!
Dialogue: 0,0:12:21.22,0:12:22.55,Default,,0,0,0,,{\ i1} Kondo-kun onu durdurdu! {\ i0}
Dialogue: 0,0:12:22.55,0:12:23.84,Default,,0,0,0,,İyiydi, Kondo!
Dialogue: 0,0:12:24.80,0:12:25.55,Default,,0,0,0,,Ne–
Dialogue: 0,0:12:25.55,0:12:29.35,Default,,0,0,0,,{\i1}Şimdi burada cesur bir aşırmaya sahip Ishizaki var.{\i0}
Dialogue: 0,0:12:29.35,0:12:31.02,Default,,0,0,0,,Beni izleyin millet!
Dialogue: 0,0:12:31.02,0:12:33.52,Default,,0,0,0,,İşte Ryo Ishizaki'den beklediğiniz şey!
Dialogue: 0,0:12:33.52,0:12:34.94,Default,,0,0,0,,Güzel aşırma, Ishizaki!
Dialogue: 0,0:12:34.94,0:12:36.40,Default,,0,0,0,,Kalenin önüne gönder.
Dialogue: 0,0:12:37.23,0:12:38.23,Default,,0,0,0,,İşte burda!
Dialogue: 0,0:12:38.23,0:12:41.78,Default,,0,0,0,,{\ i1} Kafa vuruşları ile tanınan Izawa-kun ve \NNagano-kun, Furano'nun kalesine yakınlar. {\ i0}
Dialogue: 0,0:12:41.78,0:12:44.15,Default,,0,0,0,,{\ i1} Tsubasa-kun da arkalarında koşuyor.
Dialogue: 0,0:12:45.40,0:12:46.28,Default,,0,0,0,,İşte!
Dialogue: 0,0:12:46.28,0:12:47.95,Default,,0,0,0,,Harika!
Dialogue: 0,0:12:47.95,0:12:49.45,Default,,0,0,0,,{\ i1} Tsubasa bir kafa vuruşu kullanıyor! {\ i0}
Dialogue: 0,0:12:49.95,0:12:50.41,Default,,0,0,0,,Ah!
Dialogue: 0,0:12:50.93,0:12:52.02,Default,,0,0,0,,{\ İ1} Gitmiyor! {\ İ0}
Dialogue: 0,0:12:52.02,0:12:54.04,Default,,0,0,0,,{\ i1} Matsuyama-kun atışı engelledi! {\ i0}
Dialogue: 0,0:12:54.04,0:12:56.54,Default,,0,0,0,,Aptallar, kendinize dikkat edin!
Dialogue: 0,0:12:56.54,0:12:59.38,Default,,0,0,0,,Top hala oyunda! 
Dialogue: 0,0:12:59.38,0:13:02.46,Default,,0,0,0,,{\ i1} Ishizaki saptırılan topa sert bir şekilde vuruyor! {\ i0}
Dialogue: 0,0:13:02.46,0:13:03.34,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:13:03.97,0:13:05.40,Default,,0,0,0,,{\ i1} Çok yakındı! {\ i0}
Dialogue: 0,0:13:05.40,0:13:06.93,Default,,0,0,0,,{\ i1} Top çizginin dışına çıkıyor. {\ i0}
Dialogue: 0,0:13:06.93,0:13:09.05,Default,,0,0,0,,Kahretsin, iyi bir şanstı...
Dialogue: 0,0:13:10.12,0:13:13.01,Default,,0,0,0,,{\ i1} Furano, kale vuruşu ile devam ediyor. {\ i0}
Dialogue: 0,0:13:13.01,0:13:13.81,Default,,0,0,0,,İşte!
Dialogue: 0,0:13:13.81,0:13:16.21,Default,,0,0,0,,{\ i1} Topu kaptanı Matsuyama-kun'a gönderiyor. {\ i0}
Dialogue: 0,0:13:16.21,0:13:16.69,Default,,0,0,0,,{\i1}İyi.{\i0}
Dialogue: 0,0:13:17.27,0:13:20.17,Default,,0,0,0,,{\ i1} Tsubasa, topu çalmaya geldiğinde sana kaybetmeyeceğim.
Dialogue: 0,0:13:20.17,0:13:22.40,Default,,0,0,0,,{\ i1} Bu sefer, seni geçeceğim! {\ i0}
Dialogue: 0,0:13:22.40,0:13:26.41,Default,,0,0,0,,{\ i1} Nankatsu, Matsuyama-kun'u tutmak için Kaptan Tsubasa-kun'u gönderdi. {\ i0}
Dialogue: 0,0:13:26.41,0:13:30.99,Default,,0,0,0,,{\i1}Kötü kararım nedeniyle yediğimiz golü geri alacağım.{\i0}
Dialogue: 0,0:13:34.44,0:13:37.62,Default,,0,0,0,,{\ i1} Tsubasa-kun topu çalacak mı? {\ i0}
Dialogue: 0,0:13:37.62,0:13:39.96,Default,,0,0,0,,{\ i1}Yine de Matsuyama-kun topu bırakmıyor. {\ i0}
Dialogue: 0,0:13:43.46,0:13:45.09,Default,,0,0,0,,Kaptan, pas ver!
Dialogue: 0,0:13:45.09,0:13:47.93,Default,,0,0,0,,Lütfen millet, bu konuda bana güvenin.
Dialogue: 0,0:13:47.93,0:13:51.22,Default,,0,0,0,,Tsubasa'yı burada geçebilirsem, \Nmaçın geri kalanı lehimize akacak!
Dialogue: 0,0:13:53.02,0:13:56.94,Default,,0,0,0,,{\ i1} Başka hiçbir oyuncu bu savaşa dahil edilmiyor. {\ i0}
Dialogue: 0,0:13:56.94,0:13:59.27,Default,,0,0,0,,{\i1}Bunu ikisine mi bıraktılar?{\i0}
Dialogue: 0,0:13:59.27,0:14:00.52,Default,,0,0,0,,{\i1}Senden beklendiği gibi Matsuyama-kun.{\i0}
Dialogue: 0,0:14:00.52,0:14:01.98,Default,,0,0,0,,{\ i1} Ne harika topa sahip olma becerisi.
Dialogue: 0,0:14:01.98,0:14:04.09,Default,,0,0,0,,{\ i1} Bana topu çalma şansı vermiyor. {\ i0}
Dialogue: 0,0:14:04.09,0:14:05.96,Default,,0,0,0,,{\i1}Kahretsin, senden beklendiği gibi Tsubasa.{\i0} 
Dialogue: 0,0:14:05.96,0:14:08.24,Default,,0,0,0,,{\ i1} O kadar kolay geçmeme izin vermiyor. {\ i0}
Dialogue: 0,0:14:13.41,0:14:15.04,Default,,0,0,0,,{\ i1} Bu gidişle, bu asla bitmeyecek... {\ i0}
Dialogue: 0,0:14:15.04,0:14:16.21,Default,,0,0,0,,{\ i1} Batma ya da yüzme zamanı! {\ i0}
Dialogue: 0,0:14:15.04,0:14:16.21,Default-TOP,,0,0,0,,Ç.N: "ya batarsın ya çıkarsın" deyimi galiba.
Dialogue: 0,0:14:18.58,0:14:21.57,Default,,0,0,0,,{\ i1} Ah, Tsubasa-kun dengesini kaybetti! {\ i0}
Dialogue: 0,0:14:21.57,0:14:23.05,Default,,0,0,0,,{\ i1} Harika, işte şansım! {\ i0}
Dialogue: 0,0:14:23.67,0:14:26.05,Default,,0,0,0,,{\ i1} Matsuyama-kun bu şansın kaçmasına izin vermeyecek. {\ i0}
Dialogue: 0,0:14:27.80,0:14:28.79,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:28.79,0:14:30.27,Default,,0,0,0,,{\ i1} Onu bacağından durdurdu!
Dialogue: 0,0:14:30.27,0:14:32.44,Default,,0,0,0,,{\i1}Tsubasa-kun'dan bir numara!{\i0}
Dialogue: 0,0:14:32.44,0:14:36.14,Default,,0,0,0,,Orta okula girdikten sonra kendi \Nyaptığı yüksek seviyede bir çalım.
Dialogue: 0,0:14:36.14,0:14:38.27,Default,,0,0,0,,{\ i1} Furano'nun kalesine doğru tam gaz gidiyor! {\ i0}
Dialogue: 0,0:14:38.27,0:14:39.69,Default,,0,0,0,,Geri dönün, millet!
Dialogue: 0,0:14:39.69,0:14:40.72,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:14:40.72,0:14:44.61,Default,,0,0,0,,{\i1}Matsuyama-kun ateşli bir şekilde top \Nçalındıktan sonra Tsubasa'yı takip ediyor.{\i0}
Dialogue: 0,0:14:44.61,0:14:48.11,Default,,0,0,0,,{\ i1} Tsubasa Drive Shot için hazırlanıyor! {\ i0}
Dialogue: 0,0:14:44.61,0:14:48.11,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:14:48.11,0:14:51.24,Default,,0,0,0,,Vurmana izin vermeyeceğim!
Dialogue: 0,0:14:51.24,0:14:52.25,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:52.25,0:14:55.37,Default,,0,0,0,,{\ i1} Matsuyama-kun kayarak engelleyip bir kez daha durdurdu!
Dialogue: 0,0:14:55.37,0:14:57.70,Default,,0,0,0,,{\ i1}Tsubasa'nın skor yapmasına izin vermiyor.{\ i0}
Dialogue: 0,0:14:58.26,0:15:00.46,Default,,0,0,0,,{\i1}Tsubasa'nın Drive Shot...{\i0}
Dialogue: 0,0:14:58.26,0:15:00.46,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:15:00.46,0:15:02.88,Default,,0,0,0,,{\i1}Atışı hazırlamanın zaman alması,{\i0}
Dialogue: 0,0:15:02.88,0:15:05.38,Default,,0,0,0,,{\i1}onu açığa çıkardıktan sonra ortaya çıktı.{\i0}
Dialogue: 0,0:15:05.38,0:15:07.79,Default,,0,0,0,,{\ i1} Matsuyama-kun'dan daha azını beklemezdim. {\ i0}
Dialogue: 0,0:15:07.79,0:15:11.09,Default,,0,0,0,,{\ i1} Ama Matsuyama henüz zıplayacak konumda değil! {\ i0}
Dialogue: 0,0:15:11.09,0:15:12.39,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:15:13.34,0:15:14.18,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:14.18,0:15:20.31,Default,,0,0,0,,{\i1}İşte burda! Tsubasa-kun'nun en sevdiği hamle uzun bir süreden sonra, Overhead Kick!{\i0}
Dialogue: 0,0:15:14.18,0:15:20.31,Default-TOP,,0,0,0,,Overhead Kick: Şahin Tekmesi, Tepeden Tekme
Dialogue: 0,0:15:25.98,0:15:27.09,Default,,0,0,0,,{\i1}İçerde!{\i0}
Dialogue: 0,0:15:27.09,0:15:29.37,Default,,0,0,0,,{\i1}Topu kontrol ederek sağ köşeye gönderiyor.{\i0}
Dialogue: 0,0:15:29.37,0:15:32.45,Default,,0,0,0,,{\ i1} Tsubasa-kun'nun Overhead Kick gerçekten mükemmel! {\ i0}
Dialogue: 0,0:15:29.37,0:15:32.45,Default-TOP,,0,0,0,,Overhead Kick: Şahin Tekmesi, Tepeden Tekme
Dialogue: 0,0:15:32.45,0:15:33.95,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:15:33.95,0:15:37.80,Default,,0,0,0,,{\i1}Nankatsu, ilk yarının 28. dakikasında oyunu berabere bağladı!{\i0}
Dialogue: 0,0:15:37.80,0:15:38.83,Default,,0,0,0,,Ah...!
Dialogue: 0,0:15:38.83,0:15:39.62,Default,,0,0,0,,Bu kötü!
Dialogue: 0,0:15:39.62,0:15:41.62,Default,,0,0,0,,Yine omzu yaralanacak!
Dialogue: 0,0:15:43.83,0:15:44.84,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:15:44.84,0:15:45.84,Default,,0,0,0,,Tsubasa-kun! 
Dialogue: 0,0:15:45.84,0:15:46.34,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:46.34,0:15:46.83,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:15:46.83,0:15:48.00,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:49.08,0:15:50.34,Default,,0,0,0,,Matsuyama-kun!
Dialogue: 0,0:15:51.45,0:15:53.40,Default,,0,0,0,,Kahretsin, beni üzdün.
Dialogue: 0,0:15:53.40,0:15:54.85,Default,,0,0,0,,Ama hala berabere!
Dialogue: 0,0:15:54.85,0:15:57.60,Default,,0,0,0,,Asla pes etmeyeceğim!
Dialogue: 0,0:15:57.60,0:15:58.85,Default,,0,0,0,,Matsuyama-kun...
Dialogue: 0,0:15:58.85,0:16:01.80,Default,,0,0,0,,{\ i1} Matsuyama-kun, Tsubasa-kun'u düşerken sıkıca yakaladı
Dialogue: 0,0:16:01.80,0:16:04.80,Default,,0,0,0,,{\ i1} ve omzunu daha fazla incitmekten kurtardı. {\ i0}
Dialogue: 0,0:16:04.80,0:16:09.15,Default,,0,0,0,,{\i1}Adil bir maçta, elinden gelenin en iyisini yapan iki oyuncu arasında mükemmel bir arkadaşlık.{\i0}
Dialogue: 0,0:16:10.09,0:16:11.86,Default,,0,0,0,,Teşekkürler, Matsuyama-kun.
Dialogue: 0,0:16:11.86,0:16:13.62,Default,,0,0,0,,Birşey değil.
Dialogue: 0,0:16:13.62,0:16:16.80,Default,,0,0,0,,Sadece en iyi durumda iken seni yenmek istiyorum.
Dialogue: 0,0:16:17.66,0:16:20.24,Default,,0,0,0,,{\ i1} İlk yarı burada bitiyor! {\ i0}
Dialogue: 0,0:16:20.24,0:16:22.16,Default,,0,0,0,,{\ i1} Skor 1-1. {\ i0}
Dialogue: 0,0:16:22.16,0:16:25.17,Default,,0,0,0,,{\ i1}Dahası, Tsubasa'nın herkesin endişe duyduğu yaralanması, 
Dialogue: 0,0:16:25.17,0:16:28.10,Default,,0,0,0,,{\i1}oyununu gözle görülür bir şekilde etkilemedi, rahatlatıcı!{\i0}
Dialogue: 0,0:16:29.11,0:16:34.29,Default,,0,0,0,,{\i1}Yaralanma, birkaç gün içinde yenebileceğin bir şey değil.{\i0}
Dialogue: 0,0:16:34.29,0:16:38.21,Default,,0,0,0,,{\i1}Göstermiyor olabilir, ama bu maçta çok çalışıyor.{\i0}
Dialogue: 0,0:16:38.21,0:16:41.56,Default,,0,0,0,,{\i1}Sol ayağı oldukça yük taşıyor olmalı.{\i0}
Dialogue: 0,0:16:41.56,0:16:44.31,Default-TOP,,0,0,0,,NANKATSU ORTAOKULU \N SHİZUOKA EYALETİ
Dialogue: 0,0:16:42.51,0:16:44.31,Default,,0,0,0,,İyi iş çıkardınız millet.
Dialogue: 0,0:16:44.31,0:16:46.33,Default,,0,0,0,,Tsubasa, devam edebilir misin?
Dialogue: 0,0:16:46.33,0:16:47.73,Default,,0,0,0,,Evet! Her şey yolunda efendim.
Dialogue: 0,0:16:51.86,0:16:53.11,Default-TOP,,0,0,0,,FURANO ORTAOKULU \NHOKKAİDO
Dialogue: 0,0:16:52.52,0:16:55.89,Default,,0,0,0,,Tamam, böyle devam edin ve ikinci yarıda ümidinizi yitirmeyin.
Dialogue: 0,0:16:55.89,0:16:57.59,Default,,0,0,0,,Sıcaklığın sizi etkilemesine izin vermeyin!
Dialogue: 0,0:16:57.59,0:16:58.66,Default,,0,0,0,,Tamam!
Dialogue: 0,0:16:58.66,0:17:02.48,Default,,0,0,0,,{\i1}Gücümüzü birleştirirsek, bunu kazanabileceğimize eminim.{\i0}
Dialogue: 0,0:17:02.48,0:17:05.62,Default,,0,0,0,,{\ i1} Zamanı gelince, tekrar skor yapacağım! {\ i0}
Dialogue: 0,0:17:08.59,0:17:10.98,Default,,0,0,0,,{\i1}Bana olan güvenlerine karşılık vermeliyim.{\i0}
Dialogue: 0,0:17:10.98,0:17:15.63,Default,,0,0,0,,{\i1}Bunu dün tamamladığım Drive Shot ile çözeceğim.{\i0}
Dialogue: 0,0:17:10.98,0:17:15.63,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:17:16.34,0:17:17.63,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:17:17.63,0:17:19.24,Default,,0,0,0,,{\i1}Yoksa, sen...
Dialogue: 0,0:17:20.59,0:17:23.85,Default,,0,0,0,,Yoshiko! Bizi yakaladılar.
Dialogue: 0,0:17:23.85,0:17:25.04,Default,,0,0,0,,Evet.
Dialogue: 0,0:17:25.04,0:17:27.85,Default,,0,0,0,,Bana "evet" deme, bu gidişle, Yoshiko...
Dialogue: 0,0:17:28.89,0:17:30.20,Default,,0,0,0,,{\i1}Matsuyama-kun.{\i0}
Dialogue: 0,0:17:32.30,0:17:34.15,Default,,0,0,0,,{\ i1} İkinci yarı başlamak üzere. {\ i0}
Dialogue: 0,0:17:34.15,0:17:36.99,Default,,0,0,0,,{\i1}Çarpışma bir kez daha başlıyor ve 30 dakika kaldı!{\i0}
Dialogue: 0,0:17:40.70,0:17:42.50,Default,,0,0,0,,Tamam, gidelim millet!
Dialogue: 0,0:17:42.50,0:17:43.70,Default,,0,0,0,,Evet!
Dialogue: 0,0:17:43.70,0:17:48.75,Default,,0,0,0,,{\i1}İki forvet, Kisugi-kun ve Oda-kun, başta birbirleriyle sert bir şekilde çarpışıyor!{\i0}
Dialogue: 0,0:17:50.25,0:17:52.48,Default,,0,0,0,,{\ i1} Nankatsu topu alıyor! {\ i0}
Dialogue: 0,0:17:52.48,0:17:55.59,Default,,0,0,0,,{\i1}Tsubasa sakatlıklarını saklarken şüphesiz oynuyor.{\i0}
Dialogue: 0,0:17:55.59,0:17:56.80,Default,,0,0,0,,Izawa!
Dialogue: 0,0:17:56.80,0:17:59.76,Default,,0,0,0,,{\i1}Pas gölge oyun kurucu Izawa-kun'a ulaştı.{\i0}
Dialogue: 0,0:17:59.76,0:18:02.35,Default,,0,0,0,,{\ i1} Tsubasa'nın payını da telafi etmeliyiz!{\ i0}
Dialogue: 0,0:18:03.35,0:18:06.85,Default,,0,0,0,,{\i1}Nagano'dan iyi paslaşma,\N dev forvet, onun usta kafa vuruşuyla!{\i0}
Dialogue: 0,0:18:06.85,0:18:07.85,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:18:07.85,0:18:10.11,Default,,0,0,0,,{\ i1} Ancak, Furano engelliyor! {\ i0}
Dialogue: 0,0:18:10.11,0:18:10.73,Default,,0,0,0,,İşte!
Dialogue: 0,0:18:10.73,0:18:12.65,Default,,0,0,0,,{\ i1} Ishizaki-kun topu hızlı bir şekilde yukarıya gönderiyor! {\ i0}
Dialogue: 0,0:18:12.65,0:18:14.52,Default,,0,0,0,,Tamam! Harika gidiyorsun Nankatsu!
Dialogue: 0,0:18:14.52,0:18:16.40,Default,,0,0,0,,Takım çalışması olunca biz de hiç beceriksiz değiliz!
Dialogue: 0,0:18:16.94,0:18:20.14,Default,,0,0,0,,{\ i1}Sadece Tsubasa'nın gücüyle kazanabilmelerinin imkânı yok. {\ i0}
Dialogue: 0,0:18:20.14,0:18:23.33,Default,,0,0,0,,{\ i1} Yani, sonuçta, bu Nankatsu'nun baştan beri gerçek gücü idi. {\ i0}
Dialogue: 0,0:18:23.33,0:18:24.29,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:18:24.29,0:18:26.43,Default,,0,0,0,,{\i1}Beklendiği gibi, top kaleye Tsubasa'ya gidiyor!{\i0}
Dialogue: 0,0:18:26.43,0:18:28.92,Default,,0,0,0,,{\ i1} Bu pasa ulaşmana izin veremem! {\ i0}
Dialogue: 0,0:18:28.92,0:18:31.05,Default,,0,0,0,,{\ i1} Herkes benim için bu şansı yarattı. {\ i0}
Dialogue: 0,0:18:31.05,0:18:33.42,Default,,0,0,0,,{\ i1} Şut çekemesem bile, bir pas atacağım! {\ i0}
Dialogue: 0,0:18:34.11,0:18:36.84,Default,,0,0,0,,{\i1}Tsubasa-kun, Matsuyama-kun'dan bir saniye önce topa vurdu!{\i0}
Dialogue: 0,0:18:36.84,0:18:38.18,Default,,0,0,0,,Sana güveniyorum Izawa!
Dialogue: 0,0:18:38.18,0:18:41.85,Default,,0,0,0,,{\ i1} Tsubasa yaralansa bile, bize hala en iyi oyununu gösteriyor! {\ i0}
Dialogue: 0,0:18:41.85,0:18:44.26,Default,,0,0,0,,Bunu kesinlikle atacağım!
Dialogue: 0,0:18:44.26,0:18:45.68,Default,,0,0,0,,{\ i1} Ulaşacağım! {\ i0}
Dialogue: 0,0:18:45.68,0:18:48.71,Default,,0,0,0,,{\ i1} Izawa-kun'dan umutsuz bir kafa vuruşu! {\ i0}
Dialogue: 0,0:18:51.86,0:18:53.08,Default,,0,0,0,,{\i1}İçerde!{\i0}
Dialogue: 0,0:18:53.08,0:18:57.44,Default,,0,0,0,,{\i1}Izawa atlama becerilerini gösteriyor ve Beş Metre Kafa Vuruşu ağı deliyor!{\i0}
Dialogue: 0,0:18:57.44,0:19:01.81,Default,,0,0,0,,{\i1}Nankatsu nihayet rakibi Furano'nun takım \Nçalışmasını geçerek tabloyu tersine çevirdi!
Dialogue: 0,0:19:01.81,0:19:02.95,Default,,0,0,0,,{\i1}2-1!{\i0}
Dialogue: 0,0:19:02.95,0:19:05.95,Default,,0,0,0,,{\ i1} Bu kez, Furano Nankatsu’nun peşinde olacak! {\ i0}
Dialogue: 0,0:19:05.95,0:19:07.72,Default,,0,0,0,,Başardın, Izawa!
Dialogue: 0,0:19:07.72,0:19:08.47,Default,,0,0,0,,Bunu gördünüz mü?
Dialogue: 0,0:19:08.47,0:19:11.65,Default,,0,0,0,,Bu bizim takım çalışmamız!
Dialogue: 0,0:19:11.65,0:19:12.46,Default,,0,0,0,,Ne—
Dialogue: 0,0:19:13.47,0:19:14.46,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:14.46,0:19:15.46,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:15.46,0:19:16.46,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:19:16.46,0:19:17.46,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:17.46,0:19:22.72,Default,,0,0,0,,{\ i1} Tsubasa-kun pası Izawa-kun'a \Ngönderdiğinde, Matsuyama-kun'a çarptı. {\ i0}
Dialogue: 0,0:19:22.72,0:19:27.31,Default,,0,0,0,,{\i1}Birbirlerine takılıp düştüler ve yaralı sol \Nbacağına bir darbe almış gibi gözüküyor.{\i0}
Dialogue: 0,0:19:27.31,0:19:28.39,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:19:28.39,0:19:30.39,Default,,0,0,0,,İyi misin Tsubasa?
Dialogue: 0,0:19:31.58,0:19:33.10,Default,,0,0,0,,İyiyim. 
Dialogue: 0,0:19:33.10,0:19:34.25,Default,,0,0,0,,Daha önemlisi...
Dialogue: 0,0:19:35.10,0:19:37.90,Default,,0,0,0,,Şimdi önünüzdeyiz, Matsuyama-kun!
Dialogue: 0,0:19:38.58,0:19:39.53,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:19:41.17,0:19:46.41,Default,,0,0,0,,{\t(4473,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Onu tamamen durdurmam gerekiyordu ama bir pas göndermek için sadece birkaç santimetre kullandı.{\i0}
Dialogue: 0,0:19:46.41,0:19:49.19,Default,,0,0,0,,{\ i1} Bu maç başlamadan önce kararımı vermiştim... {\ i0}
Dialogue: 0,0:19:49.19,0:19:51.92,Default,,0,0,0,,{\i1}Tsubasa yaralandığı için hiç merhamet etmedim.{\i0}
Dialogue: 0,0:19:51.92,0:19:57.50,Default,,0,0,0,,{\ i1} Tsubasa, şu andan itibaren,\N yaralanmalarını tamamen unutacağım. {\ i0}
Dialogue: 0,0:19:59.01,0:20:03.00,Default,,0,0,0,,{\i1}Başlangıçta ayağımı iyice \Nbantlayarak acıyı durdurmayı başardım, {\i0}
Dialogue: 0,0:20:03.00,0:20:06.01,Default,,0,0,0,,{\i1} ancak tekrar kötüleşiyor gibi geliyor.{\i0}
Dialogue: 0,0:20:06.01,0:20:07.76,Default,,0,0,0,,{\ i1} Oyun devam ediyor. {\ i0}
Dialogue: 0,0:20:07.76,0:20:09.09,Default,,0,0,0,,Hadi gidelim millet!
Dialogue: 0,0:20:09.09,0:20:11.47,Default,,0,0,0,,Bir gol attıktan sonra hemen vazgeçemeyiz!
Dialogue: 0,0:20:11.47,0:20:12.27,Default,,0,0,0,,Evet!
Dialogue: 0,0:20:17.87,0:20:18.91,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:20:18.91,0:20:22.20,Default,,0,0,0,,{\i1}Yaralı bir oyuncu bu şekilde mi oynar?!{\i0}
Dialogue: 0,0:20:22.20,0:20:25.48,Default,,0,0,0,,{\ i1} Daha fazla puan almaya çalışacak gücüm yok... {\ i0}
Dialogue: 0,0:20:25.48,0:20:27.37,Default,,0,0,0,,{\ i1} Yapabileceğim şey onu ısrarla tutmak! {\ i0}
Dialogue: 0,0:20:30.00,0:20:32.37,Default,,0,0,0,,{\ i1} Furano tek taraflı saldırılarına devam ediyor! {\ i0}
Dialogue: 0,0:20:32.37,0:20:34.98,Default,,0,0,0,,{\ i1} Ancak, Nankatsu'nun kalesine bir adım bile yaklaşamıyorlar! {\ i0}
Dialogue: 0,0:20:34.98,0:20:36.79,Default,,0,0,0,,Dayan Furano!
Dialogue: 0,0:20:36.79,0:20:40.17,Default,,0,0,0,,{\ i1} Furano, Matsuyama olmadan bile saldırılarını devam ettirebilir... {\ i0}
Dialogue: 0,0:20:40.17,0:20:42.30,Default,,0,0,0,,{\ i1} Ancak, puan alma yetenekleri yok. {\ i0}
Dialogue: 0,0:20:42.79,0:20:45.41,Default,,0,0,0,,{\ i1} Şu anda, Matsuyama tamamen tutuldu. {\ i0}
Dialogue: 0,0:20:45.41,0:20:48.31,Default,,0,0,0,,{\i1}Nankatsu'dan bir gol almak onlar\N için inanılmaz derecede zor olacak.{\i0}
Dialogue: 0,0:20:48.31,0:20:50.52,Default,,0,0,0,,{\ i1} Nankatsu topu tekrar uzaklaştırdı. {\ i0}
Dialogue: 0,0:20:50.52,0:20:53.48,Default,,0,0,0,,{\ i1} Her iki kaptan da top için savaşıyor. {\ i0}
Dialogue: 0,0:20:53.48,0:20:55.87,Default,,0,0,0,,{\ i1} Ondan birkaç saniye önce gelebilirsem, {\ i0}
Dialogue: 0,0:20:55.87,0:20:58.27,Default,,0,0,0,,{\ i1} sadece birkaç santimetre kadar alan yeterli olacak! {\ i0}
Dialogue: 0,0:20:58.27,0:21:00.03,Default,,0,0,0,,{\ i1} Şut çekmene izin vermeyeceğim! {\ i0}
Dialogue: 0,0:21:00.03,0:21:03.03,Default,,0,0,0,,{\ i1} Tsubasa-kun, Matsuyama-kun'nun şutunu engelledi! {\ i0}
Dialogue: 0,0:21:05.37,0:21:08.65,Default,,0,0,0,,{\ i1} Tsubasa yine sol bacağına zarar mı verdi?! {\ i0}
Dialogue: 0,0:21:08.65,0:21:09.91,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:21:10.89,0:21:12.20,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:21:12.20,0:21:13.70,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:21:13.70,0:21:15.61,Default,,0,0,0,,Fazla zamanımız kalmadı.
Dialogue: 0,0:21:15.61,0:21:17.50,Default,,0,0,0,,Nankatsu gerçekten güçlü.
Dialogue: 0,0:21:17.50,0:21:19.21,Default,,0,0,0,,Saldırmaya devam etmemize rağmen, yapamıyoruz...
Dialogue: 0,0:21:19.21,0:21:23.35,Default,,0,0,0,,Oda, Furano Lisesinin giriş sınavına gireceksin, değil mi?
Dialogue: 0,0:21:23.35,0:21:25.72,Default,,0,0,0,,Ne— Bu aniden nereden çıktı?
Dialogue: 0,0:21:25.72,0:21:28.92,Default,,0,0,0,,Yamamuro, bir tarım lisesine gideceksin.
Dialogue: 0,0:21:28.92,0:21:32.67,Default,,0,0,0,,Makinelerle uğraşmayı seviyorsun,\N Wakamatsu. Yani teknik bir liseye gideceksin.
Dialogue: 0,0:21:32.67,0:21:37.17,Default,,0,0,0,,Ortaokuldan sonra ailene çiftlikte\N yardım edeceksin, değil mi Kondo?
Dialogue: 0,0:21:37.17,0:21:38.23,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:21:38.23,0:21:41.32,Default,,0,0,0,,Turnuva başlamadan önce bunu düşündüm.
Dialogue: 0,0:21:41.32,0:21:46.15,Default,,0,0,0,,İlkokuldan beri hep birlikte futbol oynuyoruz.
Dialogue: 0,0:21:46.15,0:21:50.24,Default,,0,0,0,,Ama üçüncü yılın yazı... Bu turnuva son kez olacak.
Dialogue: 0,0:21:50.24,0:21:56.19,Default,,0,0,0,,Eğer kaybedersek, bu maç hepimizin birlikte oynadığı son maç olacak.
Dialogue: 0,0:21:56.19,0:21:57.53,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:21:57.53,0:22:03.26,Default,,0,0,0,,Bu yüzden... Şimdiye dek kazandığımız her şeyi \Noyunumuza katalım ve savaşmaya devam edelim!
Dialogue: 0,0:22:03.26,0:22:04.19,Default,,0,0,0,,Millet!
Dialogue: 0,0:22:04.19,0:22:05.55,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:22:08.72,0:22:11.45,Default,,0,0,0,,İyi misin Tsubasa?
Dialogue: 0,0:22:11.45,0:22:13.73,Default,,0,0,0,,Evet. Kaybetmeyeceğim.
Dialogue: 0,0:22:13.73,0:22:14.72,Default,,0,0,0,,Kaybetmeme imkân yok.
Dialogue: 0,0:22:19.52,0:22:34.52,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:48.98,0:24:03.98,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:23:48.98,0:23:58.49,Default,,0,0,0,,45. BÖLÜM: HAVAALANINDA GÖZYAŞLARI
Dialogue: 0,0:01:46.25,0:01:48.96,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:49.88,0:01:52.55,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:53.46,0:01:56.17,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:03.06,0:02:05.89,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:02:05.89,0:02:12.15,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:02:12.15,0:02:18.03,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta no ni
Dialogue: 0,0:02:18.03,0:02:24.62,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:02:24.62,0:02:28.62,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:02:28.62,0:02:33.13,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:02:33.13,0:02:38.72,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:02:38.72,0:02:40.26,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:02:40.26,0:02:41.47,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:41.47,0:02:44.97,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:02:44.97,0:02:54.86,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:02:54.86,0:02:55.69,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:55.69,0:02:59.49,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:02:59.49,0:03:03.49,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:03:03.49,0:03:09.75,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:03:09.75,0:03:12.58,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:01:46.25,0:01:48.96,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:49.88,0:01:52.55,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:53.46,0:01:56.17,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:03.06,0:02:05.89,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:02:05.89,0:02:12.15,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:02:12.15,0:02:18.03,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:02:18.03,0:02:24.62,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:02:24.62,0:02:28.62,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:02:28.62,0:02:33.13,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:02:33.13,0:02:38.72,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:02:38.72,0:02:40.26,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:02:40.26,0:02:41.47,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:41.47,0:02:44.97,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:02:44.97,0:02:54.86,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:02:54.86,0:02:55.69,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:55.69,0:02:59.49,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:02:59.49,0:03:03.49,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:03:03.49,0:03:09.75,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:03:09.75,0:03:12.58,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.25,0:22:44.30,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.30,0:22:50.30,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.30,0:22:56.35,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.35,0:23:00.98,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.61,0:23:07.28,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.61,0:23:14.70,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.70,0:23:20.75,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:20.75,0:23:25.21,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.50,0:23:32.84,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:32.84,0:23:38.89,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:38.89,0:23:45.19,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.25,0:22:44.30,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.30,0:22:50.30,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.30,0:22:56.35,OPED,,0,0,0,,Kelebek samba zig-zag samba
Dialogue: 0,0:22:56.35,0:23:00.98,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.61,0:23:07.28,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.61,0:23:14.70,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.70,0:23:20.75,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:20.75,0:23:25.21,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.50,0:23:32.84,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:32.84,0:23:38.89,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:38.89,0:23:45.19,OPED,,0,0,0,,Bu hırslı gençlik sahada!
