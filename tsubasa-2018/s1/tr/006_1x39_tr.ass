Comment: 0,0:12:37.98,0:12:42.99,Default,,0,0,0,,PART B
Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:02.52,0:00:04.35,Default,,0,0,0,,İşte başlıyorum, Masao!
Dialogue: 0,0:00:04.35,0:00:07.61,Default,,0,0,0,,{\i1}Nankatsu için umutsuz bir durum!{\i0}
Dialogue: 0,0:00:07.61,0:00:09.94,Default,,0,0,0,,Git, Skylab...!
Dialogue: 0,0:00:09.94,0:00:10.73,Default,,0,0,0,,Onları yakaladık!
Dialogue: 0,0:00:10.73,0:00:11.90,Default,,0,0,0,,Bu bir dönüş!
Dialogue: 0,0:00:14.95,0:00:15.54,Default,,0,0,0,,{\i1}Ah!{\i0}
Dialogue: 0,0:00:15.54,0:00:16.37,Default,,0,0,0,,{\i1}Zıplayamadılar!{\i0}
Dialogue: 0,0:00:16.37,0:00:17.39,Default,,0,0,0,,{\i1}Kırıldı!{\i0}
Dialogue: 0,0:00:17.39,0:00:20.91,Default-TOP,,0,0,0,,Skylab Hurricane: Gökyüzü Kasırgası
Dialogue: 0,0:00:17.39,0:00:20.91,Default,,0,0,0,,{\i1}Tachibana ikizleri Skylab Hurricane gerçekleştiremedi!{\i0}
Dialogue: 0,0:00:20.91,0:00:22.33,Default,,0,0,0,,Gerçekten büyük zarar verdi, ha...
Dialogue: 0,0:00:22.33,0:00:23.37,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:00:23.37,0:00:25.83,Default,,0,0,0,,{\i1}Her ikisinin de bacağına kramp girdi gibi görünüyor.{\i0}
Dialogue: 0,0:00:25.83,0:00:27.83,Default,,0,0,0,,Görünüşe göre şimdilik güvendeyiz.
Dialogue: 0,0:00:27.83,0:00:28.81,Default,,0,0,0,,Evet.
Dialogue: 0,0:00:28.81,0:00:31.21,Default,,0,0,0,,Görünüşe göre Tsubasa sonunda bacaklarına 
Dialogue: 0,0:00:31.21,0:00:33.61,Default,,0,0,0,,büyük bir zarar verecekleri konusunda haklı çıktı.
Dialogue: 0,0:00:34.59,0:00:36.08,Default,,0,0,0,,{\i1}İşte geliyor!{\i0}
Dialogue: 0,0:00:36.08,0:00:38.49,Default,,0,0,0,,{\i1}Nankatsu'nun kaptanı Tsubasa mücadeleden {\i0}
Dialogue: 0,0:00:38.49,0:00:40.89,Default,,0,0,0,,{\i1}kısa bir çekilme sonrasında geri döndü!{\i0}
Dialogue: 0,0:00:40.89,0:00:43.69,Default,,0,0,0,,{\i1}Demek döndün Tsubasa.{\i0}
Dialogue: 0,0:00:43.69,0:00:44.57,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:00:44.57,0:00:46.06,Default,,0,0,0,,Omzun iyi mi?
Dialogue: 0,0:00:46.06,0:00:47.44,Default,,0,0,0,,Evet, sorun yok.
Dialogue: 0,0:00:47.44,0:00:49.10,Default,,0,0,0,,Üzgünüm Tsubasa.
Dialogue: 0,0:00:49.10,0:00:50.86,Default,,0,0,0,,Batırdık ve skoru eşitlemelerine izin verdik.
Dialogue: 0,0:00:50.86,0:00:54.07,Default,,0,0,0,,Bizi yakaladılarsa, tek\N yapmamız gereken tekrar hareket etmek.
Dialogue: 0,0:00:54.07,0:00:57.82,Default,,0,0,0,,Onlara ilk yarının başında sahip\N olduğumuz hücumu bir kez daha gösterelim!
Dialogue: 0,0:00:57.82,0:00:59.33,Default,,0,0,0,,Evet!
Dialogue: 0,0:00:59.33,0:01:02.77,Default,,0,0,0,,Bacaklarımız iyileşene kadar\N savunma yapmamız gerekecek.
Dialogue: 0,0:01:02.77,0:01:03.58,Default,,0,0,0,,Evet.
Dialogue: 0,0:01:03.58,0:01:07.08,Default,,0,0,0,,En azından, bir kez daha \NSkylab Hurricane kullanabileceğiz.
Dialogue: 0,0:01:03.58,0:01:07.08,Default-TOP,,0,0,0,,Skylab Hurricane: Gökyüzü Kasırgası
Dialogue: 0,0:01:07.08,0:01:08.00,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:01:08.00,0:01:09.17,Default,,0,0,0,,Sana güveniyorum!
Dialogue: 0,0:01:10.20,0:01:12.65,Default,,0,0,0,,{\i1}Fiziksel oyunun yoğun olduğu kalenin önüne geçemem,{\i0}
Dialogue: 0,0:01:12.65,0:01:14.88,Default,,0,0,0,,{\i1}çünkü temastan kaçınmam gerekiyor.{\i0}
Dialogue: 0,0:01:14.88,0:01:17.05,Default,,0,0,0,,{\i1}Kisugi veya Taki'yi de kullanamam.{\i0}
Dialogue: 0,0:01:17.05,0:01:20.18,Default,,0,0,0,,{\i1}O zaman, puan almak için tek bir şansım var.{\i0}
Dialogue: 0,0:01:20.18,0:01:21.26,Default,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:01:26.85,0:01:30.82,Default,,0,0,0,,{\i1}Bunu için tek yol Drive Shot!{\i0}
Dialogue: 0,0:01:26.85,0:01:30.82,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:01:30.82,0:01:33.67,Default,,0,0,0,,Hanawa'nın güçlü savunmasını gördükten sonra, Tsubasa 
Dialogue: 0,0:01:33.67,0:01:36.53,Default,,0,0,0,,hemen kararlı bir uzun şut için pozisyonuna girdi!
Dialogue: 0,0:01:36.53,0:01:37.89,Default,,0,0,0,,Geliyor, kameraman!
Dialogue: 0,0:01:37.89,0:01:40.58,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:01:37.89,0:01:40.58,Default,,0,0,0,,Tsubasa Ozora'nın Drive Shot burada!
Dialogue: 0,0:01:40.58,0:01:41.81,Default,,0,0,0,,İyi değerlendir, Tsubasa!
Dialogue: 0,0:01:41.81,0:01:42.83,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:01:41.81,0:01:42.83,Default,,0,0,0,,Drive Shot'un!
Dialogue: 0,0:01:42.83,0:01:44.41,Default,,0,0,0,,Yapabileceğini biliyorum!
Dialogue: 0,0:01:44.41,0:01:45.29,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:01:45.29,0:01:46.91,Default,,0,0,0,,{\i1}Git!{\i0}
Dialogue: 0,0:01:50.59,0:01:55.01,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:01:50.59,0:01:51.46,Default,,0,0,0,,{\c&HFFF069&}Drive...
Dialogue: 0,0:01:53.18,0:01:55.01,Default,,0,0,0,,{\c&HFFF069&}Shot!
Dialogue: 0,0:01:55.01,0:02:15.01,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \N{\c&HB1351A&}İnstagram: AnimeSeverlerrr
Dialogue: 0,0:03:25.22,0:03:30.23,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}39. BÖLÜM: \N{\fs66}NANKATSU VS. HANAWA - SONUÇ!
Dialogue: 0,0:03:25.34,0:03:26.72,Default-TOP,,0,0,0,,{\i1}Git!{\i0}
Dialogue: 0,0:03:26.72,0:03:31.48,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:03:26.72,0:03:28.43,Default-TOP,,0,0,0,,{\i1}Drive...{\i0}
Dialogue: 0,0:03:29.90,0:03:31.48,Default-TOP,,0,0,0,,{\i1}Shot!{\i0}
Dialogue: 0,0:03:31.48,0:03:34.98,Default,,0,0,0,,{\i1}Tsubasa bütün gücünü veriyor ve şut çekiyor!{\i0}
Dialogue: 0,0:03:35.68,0:03:38.23,Default,,0,0,0,,{\i1}Hanawa'nın sık savunma hattını geçiyor!{\i0}
Dialogue: 0,0:03:38.23,0:03:40.49,Default,,0,0,0,,{\i1}Oyuncular zorlukla tepki verebiliyor!{\i0}
Dialogue: 0,0:03:42.22,0:03:45.66,Default,,0,0,0,,{\i1}Topa yapılan dönüş hamlesiyle, şutu kaleye doğru iniyor!{\i0}
Dialogue: 0,0:03:45.66,0:03:47.95,Default,,0,0,0,,{\i1}Buna bitirme atışı derim!{\i0}
Dialogue: 0,0:03:47.95,0:03:50.89,Default,,0,0,0,,{\i1}Bu, Azumaichi MS ile ilk karşılaşmasında da{\i0}
Dialogue: 0,0:03:50.89,0:03:53.83,Default,,0,0,0,,{\i1}denediği Tsubasa'nın Drive Shot'u.{\i0}
Dialogue: 0,0:03:50.89,0:03:53.83,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:03:54.21,0:03:56.54,Default,,0,0,0,,{\i1}Kaleci tepki veremiyor!{\i0}
Dialogue: 0,0:03:57.25,0:03:59.10,Default,,0,0,0,,{\i1}Ah hayır, direğe çarptı!{\i0}
Dialogue: 0,0:03:59.10,0:04:00.88,Default,,0,0,0,,{\i1}Gol olmadı!{\i0}
Dialogue: 0,0:04:00.88,0:04:01.73,Default,,0,0,0,,Çok yakındı...
Dialogue: 0,0:04:01.73,0:04:03.84,Default,,0,0,0,,Neredeyse oradaydı.
Dialogue: 0,0:04:03.84,0:04:06.94,Default,,0,0,0,,{\i1}Top gol çizgisinden fırladı.{\i0}
Dialogue: 0,0:04:07.51,0:04:09.55,Default,,0,0,0,,{\i1}Bir kez daha başarısız oldum...{\i0}
Dialogue: 0,0:04:09.55,0:04:11.52,Default,,0,0,0,,{\i1}Bu sefer olacağına emindim.{\i0}
Dialogue: 0,0:04:11.52,0:04:13.84,Default,,0,0,0,,Bu sefer şanslıydık.
Dialogue: 0,0:04:13.84,0:04:16.18,Default,,0,0,0,,Azumaichi maçında kullandığı şut.
Dialogue: 0,0:04:16.18,0:04:18.27,Default,,0,0,0,,Buna dikkat etmeliyiz.
Dialogue: 0,0:04:19.40,0:04:21.04,Default,,0,0,0,,Yakındı, Tsubasa.
Dialogue: 0,0:04:21.04,0:04:21.78,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:22.53,0:04:26.57,Default,,0,0,0,,{\i1}Ah hayır! Bu şut yüzünden omzum ve bacağım...{\i0}
Dialogue: 0,0:04:26.57,0:04:29.61,Default,,0,0,0,,{\i1}İlk oyunda top direğe çarptı ve kaleye girdi...{\i0}
Dialogue: 0,0:04:29.61,0:04:31.38,Default,,0,0,0,,{\i1}Ve şimdi direğe çarptı.{\i0}
Dialogue: 0,0:04:31.38,0:04:33.58,Default,,0,0,0,,{\i1}Neredeyse Drive Shot'unu mükemmelleştirdi.{\i0}
Dialogue: 0,0:04:31.38,0:04:33.58,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:04:34.79,0:04:36.33,Default,,0,0,0,,{\i1}Belki de omzundan kaynaklandı,{\i0}
Dialogue: 0,0:04:36.33,0:04:40.25,Default,,0,0,0,,{\i1}ama topu tekmelemediğinde, \Nağırlık merkezi hafifçe sola kaydı,{\i0}
Dialogue: 0,0:04:40.25,0:04:42.63,Default,,0,0,0,,{\t(1406,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}ve top da sola döndü.{\i0}
Dialogue: 0,0:04:42.67,0:04:46.26,Default,,0,0,0,,{\i1}Bu olmasaydı, kesinlikle gol olacaktı.{\i0}
Dialogue: 0,0:04:46.85,0:04:48.14,Default,,0,0,0,,{\i1}Anlıyorum.{\i0}
Dialogue: 0,0:04:48.14,0:04:50.97,Default,,0,0,0,,{\i1}Biraz dönüş vererek şut atıyorsun.{\i0}
Dialogue: 0,0:04:50.97,0:04:54.10,Default,,0,0,0,,{\i1}Tsubasa'nın uzun şutu da gol olmadı.{\i0}
Dialogue: 0,0:04:54.10,0:04:56.98,Default,,0,0,0,,{\i1}Oyun çıkmazda devam ediyor.{\i0}
Dialogue: 0,0:04:56.98,0:05:00.83,Default,,0,0,0,,{\i1}Turnuvanın dördüncü günü ve üçüncü\N maç Hanawa ve Nankatsu arasında.{\i0}
Dialogue: 0,0:05:00.83,0:05:04.50,Default,,0,0,0,,{\i1}İkinci yarıda 25 dakika geçti ve skor 2-2!{\i0}
Dialogue: 0,0:05:04.50,0:05:06.90,Default,,0,0,0,,{\i1}Hanawa'nın savunmaya öncelik vermesiyle {\i0}
Dialogue: 0,0:05:06.90,0:05:09.34,Default,,0,0,0,,{\i1}penaltı atışlarını amaçladıklarını varsayabilir miyiz?{\i0}
Dialogue: 0,0:05:09.34,0:05:12.62,Default,,0,0,0,,{\i1}Nankatsu saldırmaya devam etti, \Nancak gol atma şansı görünmüyor.{\i0}
Dialogue: 0,0:05:13.15,0:05:14.36,Default,,0,0,0,,{\i1}Ne yapmalıyız?{\i0}
Dialogue: 0,0:05:14.36,0:05:16.54,Default,,0,0,0,,{\i1}Zaman azalıyor...{\i0}
Dialogue: 0,0:05:17.12,0:05:19.34,Default,,0,0,0,,{\i1}İşler böyle devam ederse skoru yükseltemeyiz.{\i0}
Dialogue: 0,0:05:19.34,0:05:21.55,Default,,0,0,0,,{\i1}Ne olursa olsun, Tachibana İkizlerinin bacakları{\i0}
Dialogue: 0,0:05:21.55,0:05:23.76,Default,,0,0,0,,{\i1}iyileşmeden önce bir gol atmamız gerekiyor.{\i0}
Dialogue: 0,0:05:23.76,0:05:26.15,Default,,0,0,0,,{\i1}Yaralı omzum ve bacağım ağrıyor ama{\i0}
Dialogue: 0,0:05:26.15,0:05:28.55,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:05:26.15,0:05:28.55,Default,,0,0,0,,{\i1}Drive Shot'umu bir kez daha denemeli miyim?{\i0}
Dialogue: 0,0:05:28.55,0:05:30.30,Default,,0,0,0,,{\i1}Yoksa...{\i0}
Dialogue: 0,0:05:30.30,0:05:34.56,Default,,0,0,0,,{\i1}Her neyse, bir şey yapmalıyım.{\i0}
Dialogue: 0,0:05:35.36,0:05:36.89,Default,,0,0,0,,{\i1}Sadece 5 dakika kaldı...{\i0}
Dialogue: 0,0:05:36.89,0:05:38.31,Default,,0,0,0,,{\i1}Şimdi yapmalıyız.{\i0}
Dialogue: 0,0:05:38.31,0:05:39.19,Default,,0,0,0,,{\i1}Evet!{\i0}
Dialogue: 0,0:05:41.11,0:05:46.45,Default,,0,0,0,,{\i1}Hanawa'nın Tachibana İkizleri, Kisugi \Nve Taki'yi tutmayı bıraktı ve topu çaldı.{\i0}
Dialogue: 0,0:05:46.45,0:05:48.49,Default,,0,0,0,,Olamaz! Önce davrandılar!
Dialogue: 0,0:05:48.49,0:05:50.87,Default,,0,0,0,,{\i1}Tachibana İkizleri mücadeleye hazır!{\i0}
Dialogue: 0,0:05:50.87,0:05:53.62,Default,,0,0,0,,{\i1}İkinci yarıda ilk denemelerini başarısız olduktan sonra,{\i0}
Dialogue: 0,0:05:53.62,0:05:55.87,Default,,0,0,0,,{\i1}Skylab Hurricane bir kez\N daha kullanmaya mı çalışacaklar?!{\i0}
Dialogue: 0,0:05:53.62,0:05:55.87,Default-TOP,,0,0,0,,Skylab Hurricane: Gökyüzü Kasırgası
Dialogue: 0,0:05:55.87,0:05:57.57,Default,,0,0,0,,Bacaklarınız iyi mi?
Dialogue: 0,0:05:57.57,0:05:59.17,Default,,0,0,0,,Peşlerinden gidelim!
Dialogue: 0,0:05:59.17,0:06:02.67,Default,,0,0,0,,{\i1}Hanawa'nın arka hattı da öne\N çıkıyor ve bir birim olarak saldırıyorlar!{\i0}
Dialogue: 0,0:06:02.67,0:06:04.26,Default,,0,0,0,,Geri çekilin Millet!
Dialogue: 0,0:06:04.26,0:06:09.26,Default,,0,0,0,,İkisi ceza sahasına girdiğinde,\N topu kim alırsa oraya göndermeli!
Dialogue: 0,0:06:09.84,0:06:10.60,Default,,0,0,0,,Daimaru!
Dialogue: 0,0:06:12.14,0:06:13.93,Default,,0,0,0,,Takasugi, yukarı çıkıyoruz!
Dialogue: 0,0:06:13.93,0:06:16.46,Default,,0,0,0,,Yüksekliğe karşı koymak için başka seçeneğimiz yok.
Dialogue: 0,0:06:16.46,0:06:17.14,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:17.14,0:06:19.02,Default,,0,0,0,,{\i1}Ne olursa olsun onları durduracağız.{\i0}
Dialogue: 0,0:06:22.16,0:06:22.98,Default,,0,0,0,,Daimaru!
Dialogue: 0,0:06:26.17,0:06:29.14,Default,,0,0,0,,{\i1}Başka bir alçak pas!{\i0}
Dialogue: 0,0:06:29.14,0:06:30.19,Default,,0,0,0,,Ah hayır!
Dialogue: 0,0:06:30.19,0:06:31.37,Default,,0,0,0,,Aşağıdan mı?!
Dialogue: 0,0:06:33.16,0:06:34.45,Default,,0,0,0,,Hadi gidelim!
Dialogue: 0,0:06:35.13,0:06:41.71,Default,,0,0,0,,Bu son Skylab Hurricane'miz!
Dialogue: 0,0:06:35.13,0:06:41.71,Default-TOP,,0,0,0,,Skylab Hurricane: Gökyüzü Kasırgası
Dialogue: 0,0:06:41.71,0:06:43.84,Default,,0,0,0,,Tamam! Hadi, Tachibana İkizleri!
Dialogue: 0,0:06:45.80,0:06:46.46,Default,,0,0,0,,Git!
Dialogue: 0,0:06:46.46,0:06:50.05,Default,,0,0,0,,{\i1}İkisi de aynı anda top için zıpladı.{\i0}
Dialogue: 0,0:06:50.05,0:06:50.97,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:06:52.16,0:06:55.40,Default,,0,0,0,,{\i1}Ahh, tek başına zıplayarak Tsubasa yeterince hızlı değil.{\i0}
Dialogue: 0,0:06:55.40,0:06:56.81,Default,,0,0,0,,{\i1}Ulaşamıyor!{\i0}
Dialogue: 0,0:06:56.81,0:06:58.31,Default,,0,0,0,,Tamam, hallederim!
Dialogue: 0,0:06:58.31,0:06:59.23,Default,,0,0,0,,Hayır yapmazsın!
Dialogue: 0,0:06:59.23,0:07:00.44,Default,,0,0,0,,Ne!?
Dialogue: 0,0:07:02.14,0:07:04.91,Default,,0,0,0,,{\i1}Tsubasa çift zıplama ile topu uzaklaştırdı.{\i0}
Dialogue: 0,0:07:04.91,0:07:08.84,Default,,0,0,0,,{\i1}İkinci bir adım attıktan sonra\N alçak Skylab Hurricane kırıyor!{\i0}
Dialogue: 0,0:07:04.91,0:07:08.84,Default-TOP,,0,0,0,,Skylab Hurricane: Gökyüzü Kasırgası
Dialogue: 0,0:07:08.84,0:07:10.74,Default,,0,0,0,,Başardın, Tsubasa!
Dialogue: 0,0:07:11.95,0:07:14.65,Default,,0,0,0,,{\i1}Ancak, Hanawa hafif topu kurtarır!{\i0}
Dialogue: 0,0:07:14.65,0:07:17.08,Default,,0,0,0,,Tamai! Topu buraya at!
Dialogue: 0,0:07:17.08,0:07:19.83,Default,,0,0,0,,Ama Skylab Hurricane kullanamazsınız...
Dialogue: 0,0:07:17.08,0:07:19.83,Default-TOP,,0,0,0,,Skylab Hurricane: Gökyüzü Kasırgası
Dialogue: 0,0:07:19.83,0:07:21.17,Default,,0,0,0,,Her neyse, sadece bana at!
Dialogue: 0,0:07:21.17,0:07:23.54,Default,,0,0,0,,{\i1}Top Masao'ya gönderildi.\N{\i0}
Dialogue: 0,0:07:24.52,0:07:27.21,Default,,0,0,0,,{\i1}Ama şimdi hava tekniğini kullanamıyor.{\i0}
Dialogue: 0,0:07:27.21,0:07:28.71,Default,,0,0,0,,{\i1}Hadi, Kazuo!{\i0}
Dialogue: 0,0:07:28.71,0:07:30.84,Default,,0,0,0,,{\i1}Yapıyor muyuz Masao nii-chan?{\i0}
Dialogue: 0,0:07:30.84,0:07:34.68,Default,,0,0,0,,{\i1}Nankatsu'yu yenme hedefimiz için çok çalıştık...{\i0}
Dialogue: 0,0:07:34.68,0:07:36.76,Default,,0,0,0,,{\i1}Özel bir hamlemiz daha var!{\i0}
Dialogue: 0,0:07:36.76,0:07:37.60,Default,,0,0,0,,Kazuo!
Dialogue: 0,0:07:38.95,0:07:41.06,Default,,0,0,0,,Hala ellerinde bir şey mi var?
Dialogue: 0,0:07:42.06,0:07:44.18,Default,,0,0,0,,{\i1}Masao topu havalandırdı.{\i0}
Dialogue: 0,0:07:44.18,0:07:46.54,Default,,0,0,0,,{\i1}Kazuo hızla koşuyor!{\i0}
Dialogue: 0,0:07:46.54,0:07:48.44,Default,,0,0,0,,{\i1}Bu nedir?!{\i0}
Dialogue: 0,0:07:48.44,0:07:51.30,Default,,0,0,0,,Biz Japonya'nın 1 numaralı ikilisiyiz!
Dialogue: 0,0:07:51.30,0:07:54.07,Default,,0,0,0,,Bunu kanıtlamak için, bu senkronize hareketi yaptık!
Dialogue: 0,0:07:56.33,0:07:57.83,Default,,0,0,0,,B-Bu...
Dialogue: 0,0:07:57.83,0:08:00.45,Default-TOP,,0,0,0,,Twin Shot: İkiz Şutu
Dialogue: 0,0:07:57.83,0:08:00.45,Default,,0,0,0,,Twin Shot!
Dialogue: 0,0:08:02.21,0:08:06.84,Default,,0,0,0,,{\i1}Tachibana İkizler birlikte bir şut çekti!{\i0}
Dialogue: 0,0:08:06.84,0:08:08.14,Default,,0,0,0,,{\i1}Sadece bir top var...{\i0}
Dialogue: 0,0:08:08.14,0:08:09.52,Default,,0,0,0,,{\i1}Top benim arkadaşım!{\i0}
Dialogue: 0,0:08:09.52,0:08:11.20,Default,,0,0,0,,{\i1}Yüzüme gelse de umurumda değil! Hadi...{\i0}
Dialogue: 0,0:08:11.20,0:08:13.93,Default,,0,0,0,,Bana vur, lütfen!
Dialogue: 0,0:08:13.93,0:08:14.80,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:08:15.34,0:08:18.68,Default,,0,0,0,,{\i1}Top Morisaki'nin omzuna çarptı.{\i0}
Dialogue: 0,0:08:19.52,0:08:23.14,Default,,0,0,0,,{\i1}Yönü değişmesine rağmen, kaleye doğru ilerliyor!{\i0}
Dialogue: 0,0:08:23.14,0:08:23.77,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:08:24.60,0:08:28.22,Default,,0,0,0,,Lanet olsun! Eğer içeri girerse, işimiz biter!
Dialogue: 0,0:08:32.29,0:08:35.23,Default,,0,0,0,,{\i1}Yüzüyle uzaklaştırıyor!{\i0}
Dialogue: 0,0:08:35.23,0:08:37.07,Default,,0,0,0,,{\i1}Ishizaki'den mükemmel bir hamle!{\i0}
Dialogue: 0,0:08:37.83,0:08:40.45,Default,,0,0,0,,Evet! Onlara maymunun zamanlamasını göster, Ishizaki!
Dialogue: 0,0:08:42.37,0:08:43.21,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:08:43.21,0:08:46.43,Default,,0,0,0,,{\i1}Top tekrar oyuna girdi ve Tsubasa'ya ulaştı.{\i0}
Dialogue: 0,0:08:46.43,0:08:47.46,Default,,0,0,0,,Ishizaki...
Dialogue: 0,0:08:47.46,0:08:49.68,Default,,0,0,0,,İyiyim.
Dialogue: 0,0:08:49.68,0:08:51.46,Default,,0,0,0,,Beni unut, git ve saldır!
Dialogue: 0,0:08:51.46,0:08:54.37,Default,,0,0,0,,Hanawa'nın savunması şimdi zayıf.
Dialogue: 0,0:08:55.05,0:08:56.26,Default,,0,0,0,,Tamam anladım.
Dialogue: 0,0:08:56.26,0:08:57.93,Default,,0,0,0,,Karşı saldırı zamanı!
Dialogue: 0,0:08:57.93,0:08:59.76,Default,,0,0,0,,Bu kötü, geri dönün!
Dialogue: 0,0:09:03.27,0:09:05.56,Default,,0,0,0,,{\i1}Tsubasa topu uzaklaştırıyor!{\i0}
Dialogue: 0,0:09:05.56,0:09:08.40,Default,,0,0,0,,{\i1}Hızla karşı tarafa doğru ilerliyor!{\i0}
Dialogue: 0,0:09:08.40,0:09:10.40,Default,,0,0,0,,Tamam! Devam et, Tsubasa!
Dialogue: 0,0:09:10.40,0:09:13.90,Default,,0,0,0,,{\i1}Ishizaki'nin bizim için yarattığı bu şansı kullanmalıyım.\N{\i0}
Dialogue: 0,0:09:13.90,0:09:15.56,Default,,0,0,0,,Geri dönmemiz gerekiyor!
Dialogue: 0,0:09:15.56,0:09:16.20,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:16.20,0:09:16.95,Default,,0,0,0,,Izawa!
Dialogue: 0,0:09:17.45,0:09:19.53,Default,,0,0,0,,{\i1}Tsubasa İzawa'ya pas atıyor.{\i0}
Dialogue: 0,0:09:20.16,0:09:22.41,Default,,0,0,0,,{\i1}Ve ilerlemeye devam ediyor.{\i0}
Dialogue: 0,0:09:22.41,0:09:24.54,Default,,0,0,0,,{\i1}Hanawa ellerinden geldiğince geri koşuyor,{\i0}
Dialogue: 0,0:09:24.54,0:09:26.67,Default,,0,0,0,,{\i1}ancak savunmaları tamamen kargaşa içinde!{\i0}
Dialogue: 0,0:09:27.40,0:09:28.13,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:09:28.13,0:09:29.88,Default,,0,0,0,,{\i1}Izawa topu tekrar ortaya gönderiyor!{\i0}
Dialogue: 0,0:09:31.94,0:09:34.40,Default,,0,0,0,,{\i1}Bu şut çekme şansı mı?!{\i0}
Dialogue: 0,0:09:34.40,0:09:37.51,Default,,0,0,0,,{\i1}Tsubasa'nın uzun bir şut atması için yeterince yakın.{\i0}
Dialogue: 0,0:09:37.51,0:09:39.51,Default,,0,0,0,,Başka bir Drive Shot mu?
Dialogue: 0,0:09:37.51,0:09:39.51,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu
Dialogue: 0,0:09:40.93,0:09:42.35,Default,,0,0,0,,{\i1}Fakat başarısız olursam, {\i0}
Dialogue: 0,0:09:42.35,0:09:45.31,Default,,0,0,0,,{\i1}Ishizaki'nin çabası hiçbir şey ifade etmez.{\i0}
Dialogue: 0,0:09:46.06,0:09:48.56,Default,,0,0,0,,{\i1}Yaralanmam umurumda değil!{\i0}
Dialogue: 0,0:09:48.56,0:09:50.37,Default,,0,0,0,,{\i1}Ortasından geçeceğim!{\i0}
Dialogue: 0,0:09:50.37,0:09:53.07,Default,,0,0,0,,{\i1}Tsubasa şut çekmiyor!{\i0}
Dialogue: 0,0:09:53.07,0:09:55.32,Default,,0,0,0,,{\i1}Kaleye doğru hızla koşuyor.{\i0}
Dialogue: 0,0:09:55.32,0:09:56.32,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:09:56.32,0:09:57.57,Default,,0,0,0,,Ne yapıyor...?
Dialogue: 0,0:09:57.57,0:09:58.28,Default,,0,0,0,,Durdurun onu!
Dialogue: 0,0:09:58.28,0:09:59.32,Default,,0,0,0,,Onu ezeceğiz!
Dialogue: 0,0:09:59.32,0:10:00.82,Default,,0,0,0,,{\i1}Üç kişiye karşıyım.{\i0}
Dialogue: 0,0:10:04.16,0:10:05.90,Default,,0,0,0,,{\i1}Tsubasa topu tutuyor.{\i0}
Dialogue: 0,0:10:05.90,0:10:07.79,Default,,0,0,0,,{\i1}Hepsini geçebilecek mi?!{\i0}
Dialogue: 0,0:10:08.92,0:10:10.17,Default,,0,0,0,,{\i1}Tamam, hallettim.{\i0}
Dialogue: 0,0:10:11.17,0:10:12.16,Default,,0,0,0,,{\i1}Dördüncü mü?{\i0}
Dialogue: 0,0:10:12.16,0:10:12.92,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:10:13.53,0:10:15.85,Default,,0,0,0,,{\i1}Mücadele ruhu söz konusu olduğunda Hanawa kaybetmez!{\i0}
Dialogue: 0,0:10:15.85,0:10:18.26,Default,,0,0,0,,{\i1}Aimoto rakibini omuzu ile durduruyor.{\i0}
Dialogue: 0,0:10:18.88,0:10:21.68,Default,,0,0,0,,{\i1}Tsubasa ilk kez dengesini kaybediyor!{\i0}
Dialogue: 0,0:10:21.68,0:10:23.06,Default,,0,0,0,,Tamam, topu aldım.
Dialogue: 0,0:10:23.06,0:10:24.43,Default,,0,0,0,,{\i1}Sanki sana veririm!{\i0}
Dialogue: 0,0:10:25.10,0:10:25.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:28.79,0:10:29.65,Default,,0,0,0,,{\i1}Omzum...{\i0}
Dialogue: 0,0:10:30.07,0:10:30.86,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:10:30.86,0:10:32.94,Default,,0,0,0,,{\i1}Hanawa'nın kalecisi topu kurtarmak için dışarı koşuyor!{\i0}
Dialogue: 0,0:10:32.94,0:10:34.61,Default,,0,0,0,,{\i1}İyi karar!\N{\i0}
Dialogue: 0,0:10:34.61,0:10:37.09,Default,,0,0,0,,Kazuo! Kaleyi koruyacağız!
Dialogue: 0,0:10:37.09,0:10:37.99,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:37.99,0:10:39.54,Default,,0,0,0,,Acı bir şey değil!
Dialogue: 0,0:10:39.54,0:10:43.99,Default,,0,0,0,,Kaptan olarak, Ishizaki'den \Ndaha azını yapmayı göze alamam!
Dialogue: 0,0:10:44.49,0:10:47.02,Default,,0,0,0,,{\i1}Kaleci bir saniye ile gecikti!{\i0}
Dialogue: 0,0:10:47.02,0:10:49.25,Default,,0,0,0,,{\i1}Tsubasa'dan kayan bir şut!{\i0}
Dialogue: 0,0:10:49.25,0:10:51.45,Default,,0,0,0,,{\i1}Top açık kaleye doğru gidiyor.{\i0}
Dialogue: 0,0:10:51.45,0:10:52.38,Default,,0,0,0,,Bu sefer, içeride!
Dialogue: 0,0:10:52.38,0:10:53.63,Default,,0,0,0,,Henüz değil!
Dialogue: 0,0:10:53.63,0:10:56.63,Default,,0,0,0,,Git!
Dialogue: 0,0:10:57.46,0:11:01.21,Default,,0,0,0,,{\i1}Hanawa, Tachibana ikizlerinin\N Skylab Hurricane ile durdurmaya çalışıyor.{\i0}
Dialogue: 0,0:10:57.46,0:11:01.21,Default-TOP,,0,0,0,,Skylab Hurricane: Gökyüzü Kasırgası
Dialogue: 0,0:11:01.21,0:11:03.85,Default,,0,0,0,,Bacaklarında hala o kadar güç kaldı mı?
Dialogue: 0,0:11:03.85,0:11:05.93,Default,,0,0,0,,Durduracağım!
Dialogue: 0,0:11:05.93,0:11:06.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:09.23,0:11:12.48,Default,,0,0,0,,{\i1}Tsubasa'nın şutu ağın arkasına bıçak gibi saplandı!{\i0}
Dialogue: 0,0:11:12.48,0:11:14.09,Default,,0,0,0,,{\i1}Nankatsu liderliği ele geçirdi!{\i0}
Dialogue: 0,0:11:14.09,0:11:15.61,Default,,0,0,0,,{\i1}3-2!{\i0}
Dialogue: 0,0:11:15.61,0:11:17.86,Default,,0,0,0,,İçeride!
Dialogue: 0,0:11:18.26,0:11:19.10,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:19.10,0:11:20.36,Default,,0,0,0,,Tsubasa senpai!
Dialogue: 0,0:11:20.36,0:11:22.11,Default,,0,0,0,,Başardı!
Dialogue: 0,0:11:22.11,0:11:23.11,Default,,0,0,0,,Başardın!
Dialogue: 0,0:11:23.11,0:11:25.32,Default,,0,0,0,,Bu bizim Kaptan Tsubasa!
Dialogue: 0,0:11:25.32,0:11:27.24,Default,,0,0,0,,Yapması gerektiğinde gol atıyor.
Dialogue: 0,0:11:27.24,0:11:30.42,Default,,0,0,0,,O küçük aptal kendini zorladı.
Dialogue: 0,0:11:30.42,0:11:33.25,Default,,0,0,0,,Şimdi onu sıfırdan tedavi etmek zorunda kalacağım.
Dialogue: 0,0:11:34.00,0:11:37.50,Default,,0,0,0,,Lanet olsun! Sadece biraz daha, ve başaracaktım...
Dialogue: 0,0:11:38.63,0:11:40.68,Default,,0,0,0,,{\i1}Tachibana İkizleri mahvoldu!{\i0}
Dialogue: 0,0:11:40.68,0:11:42.38,Default,,0,0,0,,{\i1}Hanawa MS mahvoldu!{\i0}
Dialogue: 0,0:11:43.62,0:11:46.39,Default,,0,0,0,,{\i1}Bitiş düdüğü çalıyor.{\i0}
Dialogue: 0,0:11:46.39,0:11:48.07,Default,,0,0,0,,Başardık! Biz kazandık!
Dialogue: 0,0:11:48.07,0:11:50.14,Default,,0,0,0,,Üçüncü oyun bitti!
Dialogue: 0,0:11:50.14,0:11:53.74,Default,,0,0,0,,{\i1}Nankatsu, çeyrek finale yükselen ilk takım.{\i0}
Dialogue: 0,0:11:53.74,0:11:55.93,Default,,0,0,0,,Biz... Kaybettik.
Dialogue: 0,0:11:56.65,0:12:01.03,Default,,0,0,0,,Her şey söylendikten sonra, Nankatsu olmalı, biliyorsun.
Dialogue: 0,0:12:01.03,0:12:05.06,Default,,0,0,0,,{\i1}Yine de, çok heyecanlı sert bir maç oldu.{\i0}
Dialogue: 0,0:12:05.06,0:12:06.57,Default,,0,0,0,,{\i1}Hanawa cesurca mücadele etti.{\i0}
Dialogue: 0,0:12:06.57,0:12:09.33,Default,,0,0,0,,{\i1}Seyirciler onları güçlü bir alkışla gönderdiler.{\i0}
Dialogue: 0,0:12:09.88,0:12:11.89,Default,,0,0,0,,{\i1}Kolay bir final maçı olabilirdi.{\i0}
Dialogue: 0,0:12:11.89,0:12:15.33,Default,,0,0,0,,{\i1}Şimdiye kadar oynanan en iyi üçüncü maçtı.{\i0}
Dialogue: 0,0:12:15.98,0:12:19.40,Default,,0,0,0,,Senin için yakın ya da kolay\N olup olmadığı umurumda değil...
Dialogue: 0,0:12:19.40,0:12:22.84,Default,,0,0,0,,Finale kadar kazanmaya devam et, Tsubasa.
Dialogue: 0,0:12:22.84,0:12:26.60,Default,,0,0,0,,Zamanı geldiğinde seni ezeceğim!
Dialogue: 0,0:12:29.01,0:12:30.98,Default,,0,0,0,,Hey, Hyuga!
Dialogue: 0,0:12:30.98,0:12:32.98,Default,,0,0,0,,Matsuyama?
Dialogue: 0,0:12:35.00,0:12:42.99,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:12:42.99,0:12:45.49,Default-TOP,,0,0,0,,REVİR
Dialogue: 0,0:12:44.21,0:12:49.69,Default,,0,0,0,,Yakın temas kurmamanı söylemiştim, yine de yaptın!
Dialogue: 0,0:12:50.77,0:12:53.96,Default,,0,0,0,,Ama Futbol ve sakatlıklar bir aradadır.
Dialogue: 0,0:12:53.96,0:12:55.00,Default,,0,0,0,,Acıdı, ovv, ovv...
Dialogue: 0,0:12:55.00,0:12:56.63,Default,,0,0,0,,İyi misin Tsubasa-kun?
Dialogue: 0,0:12:56.63,0:12:57.61,Default,,0,0,0,,Senpai...
Dialogue: 0,0:12:57.61,0:12:58.25,Default,,0,0,0,,Acıyor mu?
Dialogue: 0,0:12:58.25,0:12:59.35,Default,,0,0,0,,Tsubasa?
Dialogue: 0,0:13:01.13,0:13:02.06,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:13:02.06,0:13:04.12,Default,,0,0,0,,Niye? Neden sadece Tsubasa?
Dialogue: 0,0:13:04.12,0:13:05.93,Default,,0,0,0,,Ben de yaralandım, biliyorsunuz?!
Dialogue: 0,0:13:05.93,0:13:07.42,Default,,0,0,0,,Evet, doğru!
Dialogue: 0,0:13:07.42,0:13:09.22,Default,,0,0,0,,Tamamen unuttuk.
Dialogue: 0,0:13:09.22,0:13:10.16,Default,,0,0,0,,Izawa!
Dialogue: 0,0:13:10.16,0:13:12.01,Default,,0,0,0,,Şaka yapıyorum, şaka!
Dialogue: 0,0:13:16.88,0:13:19.17,Default,,0,0,0,,Omzun nasıl Tsubasa?
Dialogue: 0,0:13:19.17,0:13:20.52,Default,,0,0,0,,Tachibana İkizleri!
Dialogue: 0,0:13:20.52,0:13:21.94,Default,,0,0,0,,Tachibana-kun. 
Dialogue: 0,0:13:21.94,0:13:23.88,Default,,0,0,0,,Ne diyeceğimi bilemiyorum...
Dialogue: 0,0:13:23.88,0:13:26.35,Default,,0,0,0,,Üzgünüm. Benim yüzümden...
Dialogue: 0,0:13:26.35,0:13:28.70,Default,,0,0,0,,Sorun değil. Sonuçta bir kazaydı.
Dialogue: 0,0:13:28.70,0:13:31.20,Default,,0,0,0,,Neyse, beni kontrol ettiğiniz için teşekkürler.
Dialogue: 0,0:13:32.63,0:13:35.63,Default,,0,0,0,,Evet, iyi iş çıkardın şempanze!
Dialogue: 0,0:13:35.63,0:13:37.68,Default,,0,0,0,,Size kaybettik!
Dialogue: 0,0:13:37.68,0:13:39.58,Default,,0,0,0,,"Şempanze" kısmı gereksizdi!
Dialogue: 0,0:13:39.58,0:13:42.05,Default,,0,0,0,,Kahretsin! Her bir kişi... 
Dialogue: 0,0:13:42.05,0:13:44.32,Default,,0,0,0,,Üzerinize düşeni yaptığınızdan emin olun.
Dialogue: 0,0:13:44.32,0:13:46.53,Default,,0,0,0,,Kaybederseniz sizi affetmeyeceğiz!
Dialogue: 0,0:13:46.53,0:13:48.05,Default,,0,0,0,,Bize güvenebilirsiniz.
Dialogue: 0,0:13:48.05,0:13:50.13,Default,,0,0,0,,Kazanacağımızdan emin olacağız.
Dialogue: 0,0:13:54.77,0:13:57.30,Default,,0,0,0,,Yani, yaralı değilsin?
Dialogue: 0,0:13:57.30,0:14:00.15,Default,,0,0,0,,Evet. Yaralanma ya da öyle bir şey değil.
Dialogue: 0,0:14:00.15,0:14:02.78,Default,,0,0,0,,Peki neden hiçbir maçta oynamıyorsun?
Dialogue: 0,0:14:02.78,0:14:06.57,Default,,0,0,0,,Seni ilgilendirmez.
Dialogue: 0,0:14:06.57,0:14:08.25,Default,,0,0,0,,Beni ilgilendiriyor!
Dialogue: 0,0:14:08.25,0:14:10.49,Default,,0,0,0,,Sana hala borçluyum.
Dialogue: 0,0:14:10.49,0:14:16.93,Default,,0,0,0,,Yoksa sana bir maçta geri \Nödeyeceğimi söylediğimi unuttun mu?
Dialogue: 0,0:14:18.92,0:14:20.17,Default,,0,0,0,,Böyle eski bir hikaye anlatmak ...
Dialogue: 0,0:14:20.17,0:14:22.86,Default,,0,0,0,,Her neyse... Biz, Furano, Tsubasa'yı yeneceğiz
Dialogue: 0,0:14:22.86,0:14:25.54,Default,,0,0,0,,ve finallerde sizi alaşağı etmeyi planlıyoruz.
Dialogue: 0,0:14:25.54,0:14:29.18,Default,,0,0,0,,Ne oldu bilmiyorum ama finalde oynasan iyi edersin.
Dialogue: 0,0:14:30.40,0:14:34.40,Default,,0,0,0,,Söyleyeceklerim bu kadar. Görüşürüz.
Dialogue: 0,0:14:39.85,0:14:42.86,Default,,0,0,0,,Pekala Millet. Otobüse binin.
Dialogue: 0,0:14:46.36,0:14:47.96,Default,,0,0,0,,Ah, Hyuga!
Dialogue: 0,0:14:47.96,0:14:49.61,Default,,0,0,0,,Hyuga?
Dialogue: 0,0:14:50.60,0:14:53.63,Default,,0,0,0,,Hey, Hyuga! Burada ne halt ediyorsun?
Dialogue: 0,0:14:53.63,0:14:55.63,Default,,0,0,0,,Bugünkü maçta oynamadın mı?
Dialogue: 0,0:14:55.63,0:14:58.96,Default,,0,0,0,,Toho güçlü bir takım olduğu için bizi küçümseme!
Dialogue: 0,0:14:58.96,0:15:03.34,Default,,0,0,0,,Merak etme, finallerde orada olacağım.
Dialogue: 0,0:15:03.34,0:15:05.96,Default,,0,0,0,,Öyleyse bu bir yaralanma değil, değil mi Hyuga-kun?
Dialogue: 0,0:15:06.97,0:15:07.97,Default,,0,0,0,,Doğru.
Dialogue: 0,0:15:07.97,0:15:10.53,Default,,0,0,0,,O zaman üst üste üçüncü kez finallerde 
Dialogue: 0,0:15:10.53,0:15:13.10,Default,,0,0,0,,başka bir Nankatsu vs. Toho mücadelesi yapalım.
Dialogue: 0,0:15:16.97,0:15:20.90,Default,,0,0,0,,Finallere kadar formda olduğundan emin olsan iyi edersin! 
Dialogue: 0,0:15:20.90,0:15:23.19,Default,,0,0,0,,Aksi takdirde, seni ezmek anlamsız olacak!
Dialogue: 0,0:15:32.31,0:15:34.06,Default,,0,0,0,,{\i1}Maç bitti!{\i0}
Dialogue: 0,0:15:34.06,0:15:35.41,Default,,0,0,0,,{\i1}3-0!{\i0}
Dialogue: 0,0:15:35.41,0:15:38.16,Default,,0,0,0,,{\i1}Tokyo'nun temsilcileri, Toho Akademisi,\N{\i0}
Dialogue: 0,0:15:38.16,0:15:42.17,Default,,0,0,0,,{\i1}Gifu'nun Myoko MS'sini yendi ve en iyi sekizde yerlerini aldı!{\i0}
Dialogue: 0,0:15:42.17,0:15:45.17,Default,,0,0,0,,Yaptım Hyuga-san.
Dialogue: 0,0:15:52.04,0:15:53.78,Default,,0,0,0,,İşte, gönder!
Dialogue: 0,0:15:53.78,0:15:55.26,Default,,0,0,0,,Ah, abi!
Dialogue: 0,0:15:55.26,0:15:56.09,Default,,0,0,0,,Hey!
Dialogue: 0,0:15:56.09,0:15:57.19,Default,,0,0,0,,İyi akşamlar!
Dialogue: 0,0:15:57.19,0:15:59.10,Default,,0,0,0,,O senin arkadaşın, değil mi?
Dialogue: 0,0:15:59.10,0:16:00.98,Default,,0,0,0,,Bir süredir bizimle oynuyor!
Dialogue: 0,0:16:00.98,0:16:02.55,Default,,0,0,0,,Neden buradasın? 
Dialogue: 0,0:16:02.55,0:16:05.57,Default,,0,0,0,,Bütün bu yolu kirli evimi görmek için mi geldin?
Dialogue: 0,0:16:05.57,0:16:07.86,Default,,0,0,0,,Bugün oynamadın, değil mi?
Dialogue: 0,0:16:09.40,0:16:11.31,Default,,0,0,0,,Annenden bazı şeyler duydum.
Dialogue: 0,0:16:11.31,0:16:12.81,Default,,0,0,0,,Bunun anlamı nedir?
Dialogue: 0,0:16:12.81,0:16:15.40,Default,,0,0,0,,Maçlarda oynamayarak, sonra\N Toho'dan ayrılacağını söyleyerek...
Dialogue: 0,0:16:15.40,0:16:17.08,Default,,0,0,0,,Sadede gel. Ne istiyorsun?
Dialogue: 0,0:16:18.07,0:16:19.67,Default,,0,0,0,,O zaman yapacağım.
Dialogue: 0,0:16:19.67,0:16:22.01,Default,,0,0,0,,Sadece bir şey yapmaya geldim.
Dialogue: 0,0:16:22.01,0:16:26.08,Default,,0,0,0,,Bizi yenerek Tokyo temsilcileri oldunuz, Musashi.
Dialogue: 0,0:16:26.08,0:16:31.01,Default,,0,0,0,,Tokyo temsilcilerinin korkunç bir şov yapmasını ve 
Dialogue: 0,0:16:31.01,0:16:34.34,Default,,0,0,0,,sen yokken isimsiz bir takım \Ntarafından mağlup edilmesini istemiyorum.
Dialogue: 0,0:16:34.34,0:16:35.97,Default,,0,0,0,,Hepsi bu kadar.
Dialogue: 0,0:16:42.38,0:16:44.85,Default,,0,0,0,,Hepsi buysa, eve dönmekte özgürsün.
Dialogue: 0,0:16:44.85,0:16:46.61,Default,,0,0,0,,Ağabey...
Dialogue: 0,0:16:48.24,0:16:48.94,Default,,0,0,0,,Gidelim.
Dialogue: 0,0:16:48.94,0:16:49.54,Default,,0,0,0,,Hah?
Dialogue: 0,0:16:49.54,0:16:50.61,Default,,0,0,0,,Tamam.
Dialogue: 0,0:16:53.11,0:16:56.24,Default,,0,0,0,,Durumun ve sağlığın iyi göründüğü için rahatladım.
Dialogue: 0,0:16:56.24,0:16:58.73,Default,,0,0,0,,Yaralanma nedeniyle değil gibi görünüyor.
Dialogue: 0,0:16:58.73,0:17:01.58,Default,,0,0,0,,Tsubasa'yı yenebilecek tek kişi sensin.
Dialogue: 0,0:17:01.58,0:17:04.61,Default,,0,0,0,,Final maçını sabırsızlıkla bekliyorum.
Dialogue: 0,0:17:04.61,0:17:05.40,Default,,0,0,0,,Sonra görüşürüz, tamam mı?
Dialogue: 0,0:17:05.40,0:17:06.22,Default,,0,0,0,,Elbette.
Dialogue: 0,0:17:08.85,0:17:09.77,Default,,0,0,0,,Tch...
Dialogue: 0,0:17:10.96,0:17:12.89,Default,,0,0,0,,{\i1}Hepsi...{\i0}
Dialogue: 0,0:17:12.89,0:17:15.68,Default,,0,0,0,,{\i1}Benim gibi biri için gereksiz yere endişelenmek...{\i0}
Dialogue: 0,0:17:17.43,0:17:18.30,Default,,0,0,0,,Ağabey!
Dialogue: 0,0:17:18.30,0:17:18.95,Default,,0,0,0,,Yaklaşma!
Dialogue: 0,0:17:18.95,0:17:19.97,Default,,0,0,0,,Hah?
Dialogue: 0,0:17:19.97,0:17:22.35,Default,,0,0,0,,Buraya gelme, Takeru!
Dialogue: 0,0:17:22.35,0:17:25.79,Default,,0,0,0,,Sadece izleyin. Oynayacağım.
Dialogue: 0,0:17:25.79,0:17:29.19,Default,,0,0,0,,Kesinlikle oynayacağım ve hepsini kazanacağım!
Dialogue: 0,0:17:33.52,0:17:36.07,Default,,0,0,0,,{\i1}Turnuvanın beşinci gününde,{\i0}
Dialogue: 0,0:17:36.07,0:17:40.83,Default,,0,0,0,,{\i1}çeyrek finaldeki en iyi sekiz takım\N arasındaki mücadele bu sabah sona erdi.{\i0}
Dialogue: 0,0:17:40.83,0:17:45.63,Default,,0,0,0,,{\i1}Shizuoka'dan Nankatsu MS, Nagazaki'den Hirado MS,{\i0}
Dialogue: 0,0:17:45.63,0:17:47.98,Default,,0,0,0,,{\i1}ve Ehime'den Minamiuwa MS - Hokkaido'dan Furano MS{\i0}
Dialogue: 0,0:17:47.98,0:17:53.43,Default,,0,0,0,,{\i1}blok A'da kendi maçları olacak.{\i0}
Dialogue: 0,0:17:53.43,0:17:57.72,Default,,0,0,0,,{\i1}Tokyo'dan Toho Akademisi, Nagano'dan Chubu MS,{\i0}
Dialogue: 0,0:17:57.72,0:18:02.62,Default,,0,0,0,,{\i1} ve Saitama'dan Meiwa Higashi, Miyazaki'den Kanamura MS{\i0}
Dialogue: 0,0:18:02.62,0:18:05.35,Default,,0,0,0,,{\i1}blok B'de kendi maçları olacak.{\i0}
Dialogue: 0,0:18:15.81,0:18:16.24,Default,,0,0,0,,Huh?
Dialogue: 0,0:18:16.91,0:18:17.86,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:18:17.86,0:18:18.95,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:18:18.95,0:18:21.70,Default,,0,0,0,,Koç, bugünden itibaren tekrar bankta yerimi alacağım.
Dialogue: 0,0:18:21.70,0:18:22.81,Default,,0,0,0,,Oh!
Dialogue: 0,0:18:22.81,0:18:26.33,Default,,0,0,0,,Hah, her zamanki gibi bencilsin.
Dialogue: 0,0:18:26.33,0:18:30.06,Default,,0,0,0,,Oyuncu olarak kabulün turnuvadan önce yapıldı.
Dialogue: 0,0:18:30.06,0:18:31.96,Default,,0,0,0,,Bankta olman umrumda değil ama...
Dialogue: 0,0:18:31.96,0:18:34.00,Default,,0,0,0,,Maça girmene izin vermeyeceğim.
Dialogue: 0,0:18:34.00,0:18:35.26,Default,,0,0,0,,Oh...
Dialogue: 0,0:18:35.26,0:18:38.09,Default,,0,0,0,,Kazanmak istiyorsan oynamama izin vermelisin.
Dialogue: 0,0:18:44.51,0:18:46.85,Default,,0,0,0,,{\i1}Maç burada bitiyor.{\i0}
Dialogue: 0,0:18:46.85,0:18:51.61,Default,,0,0,0,,{\i1}Çeyrek finallerin ilk maçı,\N Miyazaki'den Kanamura MS'i 2-0 yenen {\i0}
Dialogue: 0,0:18:51.61,0:18:56.11,Default,,0,0,0,,{\i1}Saitama'nın temsilcisi Meiwa\N Higashi, en iyi dört arasında yerini aldı!{\i0}
Dialogue: 0,0:18:56.11,0:18:58.56,Default,,0,0,0,,{\i1}Yarı finale yükselen ilk takım onlar!{\i0}
Dialogue: 0,0:18:58.56,0:19:00.61,Default,,0,0,0,,Yani ilk Meiwa Higashi.
Dialogue: 0,0:19:00.61,0:19:03.17,Default,,0,0,0,,Turnuva sona yaklaşıyor, değil mi?
Dialogue: 0,0:19:03.17,0:19:08.87,Default,,0,0,0,,Evet. Seçim Ekibi için 24 adayın\Nseçim süreci oldukça ilginç bir hal aldı.
Dialogue: 0,0:19:08.87,0:19:12.82,Default,,0,0,0,,{\i1}Bu turnuvada Japonya'daki en \Ngüçlü 24 genç oyuncuyu seçeceğim {\i0}
Dialogue: 0,0:19:12.82,0:19:16.63,Default,,0,0,0,,{\i1}ve onları bir eğitim kampına götürerek başlayacağım.{\i0}
Dialogue: 0,0:19:16.63,0:19:22.34,Default,,0,0,0,,{\i1}Bundan sonra, ana aşamaya bir\N uğrama, Avrupa, onları bekliyor.{\i0}
Dialogue: 0,0:19:22.98,0:19:25.23,Default,,0,0,0,,Tamam! Şimdi sol bacağına bir göz atalım.
Dialogue: 0,0:19:25.23,0:19:26.10,Default,,0,0,0,,Eh?
Dialogue: 0,0:19:26.10,0:19:28.35,Default,,0,0,0,,Yaşlı gözlerimi kandıramazsın evlat.
Dialogue: 0,0:19:28.35,0:19:32.23,Default,,0,0,0,,Sadece omzun değil. Sol bacağın da incindi, değil mi?
Dialogue: 0,0:19:32.23,0:19:33.91,Default,,0,0,0,,Ama zaten...
Dialogue: 0,0:19:33.91,0:19:35.73,Default,,0,0,0,,Sorun değil, sadece göster bana.
Dialogue: 0,0:19:35.73,0:19:39.11,Default,,0,0,0,,Bu nedir? Çoktan bandajladın mı?
Dialogue: 0,0:19:39.11,0:19:40.24,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:40.24,0:19:43.56,Default,,0,0,0,,Bunlar iyi bandajlama becerileri.
Dialogue: 0,0:19:43.56,0:19:45.99,Default,,0,0,0,,Menajer kız mı yaptı?
Dialogue: 0,0:19:45.99,0:19:48.61,Default,,0,0,0,,Şey... Evet...
Dialogue: 0,0:19:48.61,0:19:50.97,Default,,0,0,0,,Bu cevapta ne böyle?
Dialogue: 0,0:19:50.97,0:19:51.50,Default,,0,0,0,,Ne—
Dialogue: 0,0:19:51.50,0:19:52.25,Default,,0,0,0,,Ouch!
Dialogue: 0,0:19:52.25,0:19:56.13,Default,,0,0,0,,Utanıyor musun? Genç olmak güzel olmalı!
Dialogue: 0,0:19:58.13,0:20:00.92,Default,,0,0,0,,Yani bir sonraki oyun Toho ve Chubu arasında.
Dialogue: 0,0:20:00.92,0:20:02.80,Default,,0,0,0,,Hey, Yukari!
Dialogue: 0,0:20:03.98,0:20:05.80,Default,,0,0,0,,Hirado MS'in Jito'su!
Dialogue: 0,0:20:05.80,0:20:09.56,Default,,0,0,0,,Şimdiye kadar bir şekilde\N kazanmayı başardığınıza sevindim.
Dialogue: 0,0:20:09.56,0:20:11.82,Default,,0,0,0,,Kendi beğenmiş ve küstahça davranışlarda ne?
Dialogue: 0,0:20:11.82,0:20:15.06,Default,,0,0,0,,Bir gol farkıyla zar zor başardınız, Hiroshi-kun!
Dialogue: 0,0:20:15.06,0:20:17.44,Default,,0,0,0,,Ah? Öyle mi oldu?
Dialogue: 0,0:20:18.40,0:20:19.32,Default,,0,0,0,,Ne—
Dialogue: 0,0:20:20.07,0:20:24.00,Default,,0,0,0,,Özellikle size karşı oynamak için buradayız, Nankatsu.
Dialogue: 0,0:20:24.00,0:20:26.20,Default,,0,0,0,,Diğer maçları gerçekten umursamıyoruz.
Dialogue: 0,0:20:26.20,0:20:27.41,Default,,0,0,0,,Az önce ne dedin?
Dialogue: 0,0:20:27.41,0:20:30.85,Default,,0,0,0,,Kuzenimin içinde olduğu takımı yenmek hoş değil ama
Dialogue: 0,0:20:30.85,0:20:34.29,Default,,0,0,0,,Nankatsu'nun galibiyeti burada bitecek, biliyorsun.
Dialogue: 0,0:20:34.29,0:20:38.67,Default,,0,0,0,,Bugünkü karşılaşmamızdan \Nsonra efsaneniz çökecek ve düşecek.
Dialogue: 0,0:20:38.67,0:20:39.81,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:39.81,0:20:42.30,Default,,0,0,0,,Peki, bunu göreceğiz.
Dialogue: 0,0:20:46.08,0:20:47.51,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:20:47.51,0:20:53.21,Default,,0,0,0,,Oh, bu Nankatsu'nun kaptanı Tsubasa Ozora değil mi!
Dialogue: 0,0:20:53.21,0:20:56.77,Default,,0,0,0,,Zaferi hedefleyelim ve bugün \Nelimizden gelenin en iyisini yapalım, bilirsin.
Dialogue: 0,0:20:57.31,0:21:00.41,Default,,0,0,0,,Ben Hirado MS’in kaptanıyım Hiroshi Jito, bilirsin.
Dialogue: 0,0:21:00.41,0:21:01.56,Default,,0,0,0,,Tanıştığıma memnun oldum.
Dialogue: 0,0:21:01.56,0:21:02.44,Default,,0,0,0,,Benim için bir zevk.
Dialogue: 0,0:21:10.41,0:21:13.00,Default,,0,0,0,,Cidden, seninle tanıştığıma memnun oldum, bilirsin.
Dialogue: 0,0:21:22.01,0:21:22.76,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:21:22.76,0:21:24.13,Default,,0,0,0,,Kojiro Hyuga!
Dialogue: 0,0:21:24.13,0:21:24.88,Default,,0,0,0,,Ha...
Dialogue: 0,0:21:24.88,0:21:26.26,Default,,0,0,0,,Hyuga-kun!
Dialogue: 0,0:21:28.01,0:21:29.30,Default,,0,0,0,,Hey, bu Hyuga!
Dialogue: 0,0:21:29.30,0:21:30.26,Default,,0,0,0,,Hyuga orada!
Dialogue: 0,0:21:30.26,0:21:32.02,Default,,0,0,0,,Yani bugün oynayacak.
Dialogue: 0,0:21:32.02,0:21:33.78,Default,,0,0,0,,Hyuga sahada.
Dialogue: 0,0:21:33.78,0:21:35.73,Default,,0,0,0,,Yani Hyuga sonunda oynayacak.
Dialogue: 0,0:21:37.48,0:21:38.69,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:21:41.72,0:21:44.61,Default,,0,0,0,,{\i1}Oynamama izin vermeyeceğini söylemen umurumda değil.{\i0}
Dialogue: 0,0:21:44.61,0:21:47.10,Default,,0,0,0,,{\i1}Ancak beni finalde kullanmazsan {\i0}
Dialogue: 0,0:21:47.10,0:21:50.62,Default,,0,0,0,,{\i1}Nankatsu ile olan maçta kazanmamız imkansız.{\i0}
Dialogue: 0,0:21:51.37,0:21:55.54,Default,,0,0,0,,{\i1}Toho'nun zaferi için, şimdi yapmam gereken takım{\i0}
Dialogue: 0,0:21:55.54,0:21:59.71,Default,,0,0,0,,{\i1}arkadaşlarımın en iyisini finallere kadar çıkarmak.{\i0}
Dialogue: 0,0:21:59.71,0:22:02.96,Default,,0,0,0,,{\i1}Bu şimdi yapmam gereken bir şey!{\i0}
Dialogue: 0,0:22:06.59,0:22:09.14,Default,,0,0,0,,{\i1}Bu şutta fazla güç kullanmasa da,{\i0}
Dialogue: 0,0:22:09.14,0:22:11.68,Default,,0,0,0,,{\i1}geçen seneden çok daha güçlü.{\i0}
Dialogue: 0,0:22:11.68,0:22:15.18,Default,,0,0,0,,{\i1}Yani Hyuga gerçekten yaralanmadı...{\i0}
Dialogue: 0,0:22:15.18,0:22:20.02,Default,,0,0,0,,{\i1}Finallerde kesinlikle oynayacağım!{\i0}
Dialogue: 0,0:22:20.02,0:22:35.02,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.99,0:24:00.51,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:23:49.99,0:24:00.51,Default,,0,0,0,, 40. BÖLÜM: FURANO SAVAŞIYOR
Dialogue: 0,0:01:57.26,0:01:59.97,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:00.89,0:02:03.56,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:04.47,0:02:07.19,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:14.07,0:02:16.90,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:02:16.90,0:02:23.16,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:02:23.16,0:02:29.04,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta no ni
Dialogue: 0,0:02:29.04,0:02:35.63,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:02:35.63,0:02:39.63,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:02:39.63,0:02:44.14,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:02:44.14,0:02:49.69,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:02:49.69,0:02:51.27,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:02:51.27,0:02:52.48,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:52.48,0:02:55.98,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:02:55.98,0:03:05.87,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:03:05.87,0:03:06.70,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:03:06.70,0:03:10.50,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:03:10.50,0:03:14.50,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:03:14.50,0:03:20.76,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:03:20.76,0:03:23.55,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:01:57.26,0:01:59.97,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:00.89,0:02:03.56,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:04.47,0:02:07.19,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:14.07,0:02:16.90,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:02:16.90,0:02:23.16,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile 
Dialogue: 0,0:02:23.16,0:02:29.04,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:02:29.04,0:02:35.63,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:02:35.63,0:02:39.63,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:02:39.63,0:02:44.14,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:02:44.14,0:02:49.69,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:02:49.69,0:02:51.27,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:02:51.27,0:02:52.48,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:52.48,0:02:55.98,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:02:55.98,0:03:05.87,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:03:05.87,0:03:06.70,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:03:06.70,0:03:10.50,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:03:10.50,0:03:14.50,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:03:14.50,0:03:20.76,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:03:20.76,0:03:23.55,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.75,0:22:44.80,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.80,0:22:50.80,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.80,0:22:56.85,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.85,0:23:01.48,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:03.11,0:23:07.78,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:09.11,0:23:15.20,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:15.20,0:23:21.25,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.25,0:23:25.71,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:27.01,0:23:33.35,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.35,0:23:39.39,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.39,0:23:45.69,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.75,0:22:44.80,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.80,0:22:50.80,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.80,0:22:56.85,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.85,0:23:01.48,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.11,0:23:07.78,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:09.11,0:23:15.20,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:15.20,0:23:21.25,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.25,0:23:25.71,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:27.01,0:23:33.35,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.35,0:23:39.39,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.39,0:23:45.69,OPED,,0,0,0,,Bu hırslı gençlik sahada!
