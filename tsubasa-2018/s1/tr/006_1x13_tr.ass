Dialogue: 0,0:11:47.10,0:11:52.25,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:22:18.46,0:22:20.19,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:00.65,0:00:03.28,Default,,0,0,0,,{\i1}Shizuoka Bölge Turnuvası finalleri.{\i0}
Dialogue: 0,0:00:03.28,0:00:06.23,Default,,0,0,0,,{\i1}Rakip, ünlü Shimizu FC.{\i0}
Dialogue: 0,0:00:06.23,0:00:12.32,Default,,0,0,0,,{\i1}Maç başladığı andan itibaren Tsubasa\Nmarkaja alındı ve rahatça hareket edemedi.{\i0}
Dialogue: 0,0:00:12.32,0:00:15.66,Default,,0,0,0,,{\i1}Rakibin Wakabayashi'yi durdurma\Namaçlı ona çarpması...{\i0}
Dialogue: 0,0:00:15.66,0:00:17.74,Default,,0,0,0,,{\i1}...işleri daha da kötü bir duruma soktu.{\i0}
Dialogue: 0,0:00:18.31,0:00:22.08,Default,,0,0,0,,{\i1}Bacağındaki ağrının tekrar alevlenmesiyle\NWakabayashi rahatça hareket edemez oldu.{\i0}
Dialogue: 0,0:00:22.08,0:00:28.08,Default,,0,0,0,,{\i1}Ne var ki kaleyi koruma azmiyle\NWakabayashi, topu Tsubasa'ya ulaştırdı.{\i0}
Dialogue: 0,0:00:28.08,0:00:31.92,Default,,0,0,0,,{\i1}Üç kişilik markajı geçmesiyle\Ngol atmayı başardı.{\i0}
Dialogue: 0,0:00:32.67,0:00:36.13,Default,,0,0,0,,{\i1}Nankatsu FC, Shizuoka Bölge\NTurnuvası'nı kazandı ve...{\i0}
Dialogue: 0,0:00:36.13,0:00:40.51,Default,,0,0,0,,{\i1}...ulusal turnuva biletini elde etti.{\i0}
Dialogue: 0,0:00:41.64,0:00:43.68,Default,,0,0,0,,Hey Tsubasa! Atıştırmayı kes!
Dialogue: 0,0:00:43.68,0:00:44.63,Default,,0,0,0,,Acıdı.
Dialogue: 0,0:00:44.63,0:00:49.10,Default,,0,0,0,,Kahvaltı birazdan hazır olacak,\Ngit duşunu al.
Dialogue: 0,0:00:49.10,0:00:50.90,Default,,0,0,0,,Ama açlıktan ölüyorum.
Dialogue: 0,0:00:50.90,0:00:52.02,Default,,0,0,0,,Biraz acele edemez misin?
Dialogue: 0,0:00:52.02,0:00:53.16,Default,,0,0,0,,Bana karşılık verme.
Dialogue: 0,0:00:53.16,0:00:55.40,Default,,0,0,0,,{\i1}Ozora evindeki sıradan bir sabah.{\i0}
Dialogue: 0,0:00:55.82,0:00:58.68,Default,,0,0,0,,{\i1}Kaptan, annesi, Tsubasa...{\i0}
Dialogue: 0,0:00:58.68,0:01:02.45,Default,,0,0,0,,{\i1}Ozora ailesi, şu an oldukça mutlu.{\i0}
Dialogue: 0,0:01:02.45,0:01:05.93,Default,,0,0,0,,{\i1}Yine de üçü istese de...{\i0}
Dialogue: 0,0:01:05.93,0:01:08.96,Default,,0,0,0,,{\i1}...Tsubasa'nın benimle birlikte\NBrezilya'ya gelmesi doğru olacak mı?{\i0}
Dialogue: 0,0:01:09.39,0:01:11.77,Default,,0,0,0,,{\i1}Bir ailenin bir arada olması gerekir.{\i0}
Dialogue: 0,0:01:11.77,0:01:15.96,Default,,0,0,0,,{\i1}Bu ailenin mutluluğunu\Nbozmuş olmayacak mıyım?{\i0}
Dialogue: 0,0:01:15.96,0:01:17.59,Default,,0,0,0,,Roberto!
Dialogue: 0,0:01:18.62,0:01:19.84,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:01:19.84,0:01:22.12,Default,,0,0,0,,Bir şey yok.
Dialogue: 0,0:01:22.12,0:01:23.60,Default,,0,0,0,,Peki o zaman.
Dialogue: 0,0:02:57.07,0:03:00.24,Default,,0,0,0,,{\fad(00,00)\pos(280,816)}Bölüm 13\NVe Ulusallar
Dialogue: 0,0:02:57.07,0:03:00.24,Default,,0,0,0,,{\pos(1392,1025)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:03:00.58,0:03:03.03,Default - Top,,0,0,0,,6. Ulusal Genç Futbol Turnuvası\NHokkaido Turnuvası Finali
Dialogue: 0,0:03:04.58,0:03:06.72,Default,,0,0,0,,Sapporo FC, ne yapıyorsun be?!
Dialogue: 0,0:03:06.72,0:03:08.04,Default,,0,0,0,,Çabuk topu geri alın!
Dialogue: 0,0:03:08.04,0:03:10.04,Default,,0,0,0,,Sadece bir dakika kaldı!
Dialogue: 0,0:03:10.78,0:03:11.60,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:03:11.60,0:03:15.64,Default,,0,0,0,,{\i1}Sapporo FC, çok sayıda oyuncusu bir araya\Ngelmesine rağmen topu geri alamıyor!{\i0}
Dialogue: 0,0:03:15.64,0:03:18.34,Default,,0,0,0,,{\i1}Furano'nun Kaptanı Matsuyama-kun\Ntopu harika koruyor.{\i0}
Dialogue: 0,0:03:18.64,0:03:20.05,Default,,0,0,0,,{\i1}Hayatta izin vermem!{\i0}
Dialogue: 0,0:03:21.05,0:03:21.76,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:03:25.04,0:03:27.76,Default,,0,0,0,,Çok inatçı çıktı! Çabuk geri alalım şunu!
Dialogue: 0,0:03:27.76,0:03:29.12,Default,,0,0,0,,Kaptan, pas ver!
Dialogue: 0,0:03:29.12,0:03:32.81,Default,,0,0,0,,İmkansız. Etrafı tamamen sarılmış\Ndurumda. Pas veremez.
Dialogue: 0,0:03:32.81,0:03:36.31,Default,,0,0,0,,{\i1}Matsuyama-kun dar alanda hala\Ntopu elinde tutmayı başarıyor.{\i0}
Dialogue: 0,0:03:36.31,0:03:38.82,Default,,0,0,0,,{\i1}Topu rakibine kaptırmamaya\Ndevam edebilecek mi?{\i0}
Dialogue: 0,0:03:38.82,0:03:41.49,Default,,0,0,0,,{\i1}Uzatmalara girmiş bulunmaktayız!{\i0}
Dialogue: 0,0:03:41.49,0:03:45.45,Default,,0,0,0,,Bölgesel turnuvanın favorisi\NSapporo FC, kayıp mı edecek?
Dialogue: 0,0:03:45.45,0:03:48.62,Default,,0,0,0,,Furano! Biraz daha dayanın!
Dialogue: 0,0:03:49.01,0:03:51.19,Default,,0,0,0,,Kaptan, elinden geleni yap!
Dialogue: 0,0:03:55.17,0:03:57.84,Default,,0,0,0,,{\i1}İşte hakem düdüğünü çalıyor.{\i0}
Dialogue: 0,0:03:58.25,0:04:01.31,Default,,0,0,0,,Başardık!
Dialogue: 0,0:04:01.31,0:04:03.00,Default,,0,0,0,,{\i1}Beklenmedik bir sonuç!{\i0}
Dialogue: 0,0:04:03.00,0:04:06.30,Default,,0,0,0,,{\i1}Herkesin favorisi Sapporo FC kaybetti!{\i0}
Dialogue: 0,0:04:07.08,0:04:11.24,Default,,0,0,0,,{\i1}Furano İlkokulu uzun zamandır hayal ettiği\Nulusallara ilk kez katılacak!{\i0}
Dialogue: 0,0:04:11.24,0:04:13.06,Default,,0,0,0,,{\i1}Kaptan Matsuyama-kun da dahil olmak üzere...{\i0}
Dialogue: 0,0:04:13.06,0:04:16.63,Default,,0,0,0,,{\i1}...11 oyuncunun her biri\Nçok çaba sarf etti.{\i0}
Dialogue: 0,0:04:16.63,0:04:20.19,Default,,0,0,0,,{\i1}Furano İlkokulu Futbol Kulübü,\Nbu sonucu sıkı çalışarak elde etti!{\i0}
Dialogue: 0,0:04:20.84,0:04:24.34,Default,,0,0,0,,Misaki'nin bıraktığı boşluğu\Niyi doldurduk.
Dialogue: 0,0:04:24.34,0:04:25.54,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:25.54,0:04:28.18,Default,,0,0,0,,Ulusallarda onunla karşılaşacağız.
Dialogue: 0,0:04:28.18,0:04:29.20,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:29.99,0:04:32.08,Default,,0,0,0,,{\i1}Misaki, kazandık.{\i0}
Dialogue: 0,0:04:32.08,0:04:35.04,Default,,0,0,0,,{\i1}Ulusallarda sana karşı oynayacağım.{\i0}
Dialogue: 0,0:04:46.27,0:04:48.76,Default,,0,0,0,,Resmini bitirmişsin baba.
Dialogue: 0,0:04:48.76,0:04:50.60,Default,,0,0,0,,Yine başka bir şehre mi gideceğiz?
Dialogue: 0,0:04:51.13,0:04:52.22,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:53.77,0:04:56.11,Default,,0,0,0,,Senin ulusallar bitince...
Dialogue: 0,0:04:56.11,0:04:58.77,Default,,0,0,0,,...ikinci dönem için\Nbaşka bir okula gideceksin.
Dialogue: 0,0:04:58.77,0:05:01.24,Default,,0,0,0,,Arkadaşlarını da bilgilendir.
Dialogue: 0,0:05:01.24,0:05:02.53,Default,,0,0,0,,Tamam.
Dialogue: 0,0:05:09.16,0:05:12.39,Default,,0,0,0,,Sonuç olarak ulusallara katılmaktan\Nvazgeçmen en iyisi.
Dialogue: 0,0:05:12.39,0:05:13.21,Default,,0,0,0,,Olmaz!
Dialogue: 0,0:05:13.21,0:05:14.50,Default,,0,0,0,,Sakin ol Genzo.
Dialogue: 0,0:05:14.50,0:05:17.44,Default,,0,0,0,,Hala gelişim dönemindesin.
Dialogue: 0,0:05:17.44,0:05:18.73,Default,,0,0,0,,Kendini zorlamamalısın.
Dialogue: 0,0:05:18.73,0:05:22.91,Default,,0,0,0,,Maça çıkarsan bacağının daha\Nkötü olacağı çok bariz.
Dialogue: 0,0:05:22.91,0:05:26.23,Default,,0,0,0,,Tamamen iyileşene kadar\Ndişini sıkman gerek.
Dialogue: 0,0:05:26.23,0:05:27.62,Default,,0,0,0,,Haklı, Genzo.
Dialogue: 0,0:05:27.62,0:05:31.01,Default,,0,0,0,,Başka fırsatlar da olacak.\NBu seferlik vazgeç.
Dialogue: 0,0:05:31.60,0:05:36.77,Default,,0,0,0,,Ama ne pahasına olursa olsun\Nborcumu ödemek istediğim birisi var.
Dialogue: 0,0:05:38.52,0:05:41.61,Default,,0,0,0,,{\i1}Genç bey evde değil maalesef.{\i0}
Dialogue: 0,0:05:41.61,0:05:44.20,Default,,0,0,0,,Boşa geldik, Kaptan evde yok.
Dialogue: 0,0:05:44.20,0:05:47.19,Default,,0,0,0,,Yani Kaptan'ın bacağı iyi mi demek bu?
Dialogue: 0,0:05:47.19,0:05:48.57,Default,,0,0,0,,Umarım öyledir.
Dialogue: 0,0:05:48.57,0:05:53.31,Default,,0,0,0,,Hemen iyileşsin de birlikte\Ngidip ulusallarda oynayabilelim.
Dialogue: 0,0:05:53.31,0:05:56.18,Default,,0,0,0,,O zaman bir kez daha\Nşampiyonluğu eve getiririz.
Dialogue: 0,0:05:56.18,0:05:57.46,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:58.27,0:05:59.33,Default,,0,0,0,,Hadi Ryo!
Dialogue: 0,0:05:59.33,0:06:00.29,Default,,0,0,0,,Düzgünce temizle yerleri.
Dialogue: 0,0:06:00.29,0:06:02.71,Default,,0,0,0,,Ne kafa ütüledin be!
Dialogue: 0,0:06:02.71,0:06:06.17,Default,,0,0,0,,Burada çalışmıyorum ya ben!
Dialogue: 0,0:06:06.17,0:06:08.56,Default,,0,0,0,,Şu laflara da bak sen.
Dialogue: 0,0:06:08.56,0:06:12.89,Default,,0,0,0,,Takımın kazanmasına rağmen bir kez\Nolsun seni maça bile çıkarmadılar.
Dialogue: 0,0:06:12.89,0:06:14.89,Default,,0,0,0,,Ne yapabilirim ki?!
Dialogue: 0,0:06:14.89,0:06:17.53,Default,,0,0,0,,Takımdaki herkes çok iyi.
Dialogue: 0,0:06:17.53,0:06:19.98,Default,,0,0,0,,Bu yüzden fayansları düzgün\Ntemizlemelisin işte.
Dialogue: 0,0:06:19.98,0:06:21.84,Default,,0,0,0,,Bacaklarını çalıştırır.
Dialogue: 0,0:06:22.60,0:06:25.57,Default,,0,0,0,,Bir gün dinlenebilirim sanmıştım ben de.
Dialogue: 0,0:06:28.33,0:06:34.66,Default,,0,0,0,,{\i1}Böylelikle Nankatsu on biri, ulusallardan\Nönce vaktini dinlenerek geçirdi.{\i0}
Dialogue: 0,0:06:34.98,0:06:36.99,Default,,0,0,0,,{\i1}Tsubasa ise...{\i0}
Dialogue: 0,0:06:47.76,0:06:49.05,Default,,0,0,0,,Ne oldu Tsubasa?!
Dialogue: 0,0:06:49.05,0:06:51.70,Default,,0,0,0,,Böyle bir topu bile alamıyor musun?
Dialogue: 0,0:06:51.70,0:06:53.22,Default,,0,0,0,,T-Tamam.
Dialogue: 0,0:06:55.18,0:06:58.07,Default,,0,0,0,,{\i1}Roberto'nun bugün neyi vardı acaba?{\i0}
Dialogue: 0,0:06:58.07,0:07:00.35,Default,,0,0,0,,{\i1}Her zamankinden farklıydı.{\i0}
Dialogue: 0,0:07:02.89,0:07:06.24,Default,,0,0,0,,Tsubasa, her halükarda\NBrezilya'ya gitmek istiyor musun?
Dialogue: 0,0:07:06.24,0:07:09.19,Default,,0,0,0,,Evet. Nereden açıldı bu konu birden?
Dialogue: 0,0:07:09.19,0:07:14.25,Default,,0,0,0,,Brezilya'ya gidersen annen yalnız kalacak.
Dialogue: 0,0:07:14.25,0:07:16.88,Default,,0,0,0,,Yine de benimle birlikte\NBrezilya'ya gelmek istiyor musun?
Dialogue: 0,0:07:16.88,0:07:17.91,Default,,0,0,0,,Ne?
Dialogue: 0,0:07:17.91,0:07:21.87,Default,,0,0,0,,Roberto, Brezilya'ya gitmek istiyorum tabii.
Dialogue: 0,0:07:23.42,0:07:25.38,Default,,0,0,0,,Bir süredir aklımı kurcalıyor.
Dialogue: 0,0:07:25.38,0:07:30.63,Default,,0,0,0,,Belki de sadece seni rüyamı\Nyaşamaya zorluyorumdur.
Dialogue: 0,0:07:30.63,0:07:33.72,Default,,0,0,0,,Bu, aileni parçalayabilir.
Dialogue: 0,0:07:33.72,0:07:36.37,Default,,0,0,0,,Roberto, ama ben--
Dialogue: 0,0:07:36.37,0:07:38.18,Default,,0,0,0,,Tsubasa, ben--
Dialogue: 0,0:07:40.11,0:07:41.73,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:07:41.73,0:07:44.35,Default,,0,0,0,,Tsubasa, konuşmamız gerek.
Dialogue: 0,0:07:46.78,0:07:49.86,Default,,0,0,0,,Ben ulusallara gidemeyeceğim.
Dialogue: 0,0:07:49.86,0:07:50.86,Default,,0,0,0,,Ne?
Dialogue: 0,0:07:52.05,0:07:55.96,Default,,0,0,0,,Yaralanmam düşündüğümden\Ndaha kötü gibi görünüyor.
Dialogue: 0,0:07:55.96,0:07:57.90,Default,,0,0,0,,İyileşene kadar beklemem gerek.
Dialogue: 0,0:07:58.78,0:08:02.25,Default,,0,0,0,,Bu yüzden senden bir iyilik\Nisteyeceğim Tsubasa.
Dialogue: 0,0:08:02.80,0:08:07.22,Default,,0,0,0,,Ben olmasam bile Meiwa FC'den\NHyuga Kojiro ile oynayana kadar...
Dialogue: 0,0:08:07.22,0:08:09.58,Default,,0,0,0,,...ne pahasına olursa olsun\Nkazanmanı istiyorum.
Dialogue: 0,0:08:09.58,0:08:10.92,Default,,0,0,0,,Wakabayashi-kun...
Dialogue: 0,0:08:11.37,0:08:16.23,Default,,0,0,0,,Bana attığı golü ne olursa olsun\Nona ödetmeliyim.
Dialogue: 0,0:08:16.23,0:08:19.38,Default,,0,0,0,,Meiwa maçına kadar\Ntamamen iyileşmeliyim.
Dialogue: 0,0:08:19.38,0:08:22.56,Default,,0,0,0,,Bu yüzden sana yalvarıyorum Tsubasa!
Dialogue: 0,0:08:23.37,0:08:26.40,Default,,0,0,0,,Anladım. O zamana kadar\Nkesinlikle kazanacağım.
Dialogue: 0,0:08:31.68,0:08:32.19,Default,,0,0,0,,Hadi, hadi!
Dialogue: 0,0:08:34.70,0:08:35.65,Default,,0,0,0,,Buraya!
Dialogue: 0,0:08:37.72,0:08:40.50,Default,,0,0,0,,Ne oldu çocuklar?! Canlanın biraz!
Dialogue: 0,0:08:40.50,0:08:42.47,Default,,0,0,0,,Bu sıcaklık bile yıldırıyorsa sizi...
Dialogue: 0,0:08:42.47,0:08:45.00,Default,,0,0,0,,...ulusallarda asla kazanamazsınız!
Dialogue: 0,0:08:45.00,0:08:45.62,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:46.66,0:08:52.21,Default,,0,0,0,,Wakabayashi'nin yokluğu çocukların\Nmotivasyonunun zararına mı oluyordur dersin?
Dialogue: 0,0:08:52.21,0:08:53.18,Default,,0,0,0,,Evet.
Dialogue: 0,0:08:53.18,0:08:59.76,Default,,0,0,0,,Wakabayashi'nin yokluğunun takım çalışmasındaki\Netkisi bize olan etkisinden daha büyük oluyor.
Dialogue: 0,0:08:59.76,0:09:03.32,Default,,0,0,0,,Üstelik defansımızın bel kemiği Wakabayashi...
Dialogue: 0,0:09:03.32,0:09:05.77,Default,,0,0,0,,...Kaptan olarak tüm takımı\Nbir arada tutuyordu.
Dialogue: 0,0:09:05.77,0:09:12.44,Default,,0,0,0,,Oyun bir yana Tokyo'ya giderken onun yanlarında\Nolmayacağını bilmek de on birin moralini bozuyor.
Dialogue: 0,0:09:12.44,0:09:16.26,Default,,0,0,0,,Ama her şeye rağmen her zamanki\Ngibi morali yerinde olan kişi Tsubasa.
Dialogue: 0,0:09:16.26,0:09:17.28,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:09:17.28,0:09:18.96,Default,,0,0,0,,İşte! Bir, iki!
Dialogue: 0,0:09:18.96,0:09:20.96,Default,,0,0,0,,Yanında da her zaman Misaki oluyor.
Dialogue: 0,0:09:23.71,0:09:25.54,Default,,0,0,0,,Başardım!
Dialogue: 0,0:09:25.54,0:09:28.65,Default,,0,0,0,,Aptal! Bunu bile durduramıyor musun?
Dialogue: 0,0:09:28.65,0:09:32.75,Default,,0,0,0,,Wakabayashi yokken sana\Nbel bağlayacağız biz!
Dialogue: 0,0:09:30.55,0:09:32.75,Default,,0,0,0,,{\an8}Bir de Ishizaki var tabii.
Dialogue: 0,0:09:35.63,0:09:40.14,Default,,0,0,0,,{\i1}Wakabayashi-kun'a kazanacağıma\Ndair söz verdim.{\i0}
Dialogue: 0,0:09:45.73,0:09:47.23,Default,,0,0,0,,Mama-san.
Dialogue: 0,0:09:47.23,0:09:51.23,Default,,0,0,0,,Tsubasa giderse tek başına\Nyalnızlık çekmez misin?
Dialogue: 0,0:09:51.23,0:09:54.10,Default,,0,0,0,,Ne? Nereden çıktı birden?
Dialogue: 0,0:09:54.10,0:09:55.82,Default,,0,0,0,,Lütfen cevap ver Mama-san.
Dialogue: 0,0:09:58.52,0:10:02.32,Default,,0,0,0,,Yalnızlık çekmeyeceğimi söylersem\Nyalan söylemiş olurum ama...
Dialogue: 0,0:10:02.32,0:10:07.59,Default,,0,0,0,,...kocamın dediği gibi aileler\Nçocuklarının hayallerine karışmamalı.
Dialogue: 0,0:10:07.59,0:10:10.33,Default,,0,0,0,,Ama Tsubasa hala ilkokulda.
Dialogue: 0,0:10:10.33,0:10:15.06,Default,,0,0,0,,Ama Tsubasa yaşına göre çok olgun.
Dialogue: 0,0:10:15.06,0:10:18.84,Default,,0,0,0,,Birinci sınıf bir futbol\Noyuncusu olmak da...
Dialogue: 0,0:10:18.84,0:10:21.34,Default,,0,0,0,,...Tsubasa'nın hayali.
Dialogue: 0,0:10:21.34,0:10:27.02,Default,,0,0,0,,Bu yüzden yanında sen varken gitmesi\Nbeni içten içe mutlu eder.
Dialogue: 0,0:10:27.02,0:10:30.36,Default,,0,0,0,,Şu an hayali için her şeyi yapması...
Dialogue: 0,0:10:30.36,0:10:36.19,Default,,0,0,0,,...ve arkasına bakmadan ilerlemesi\Nbeni mutlu eder.
Dialogue: 0,0:10:37.58,0:10:39.45,Default,,0,0,0,,Millet, çabanıza sağlık.
Dialogue: 0,0:10:39.45,0:10:44.37,Default,,0,0,0,,Üç gün içinde ulusallara katılmak için\NTokyo'ya doğru yola koyulacağız.
Dialogue: 0,0:10:44.37,0:10:47.70,Default,,0,0,0,,Bu yüzden şu an\Nyeni bir kaptan seçeceğiz.
Dialogue: 0,0:10:47.70,0:10:48.89,Default,,0,0,0,,Yeni kaptan mı?
Dialogue: 0,0:10:48.89,0:10:50.04,Default,,0,0,0,,Wakabayashi'ye ne oldu?
Dialogue: 0,0:10:50.04,0:10:54.09,Default,,0,0,0,,Maalesef yaralanması kötüleştiği için\Nkendisi katılamayacak.
Dialogue: 0,0:10:54.09,0:10:58.84,Default,,0,0,0,,Bu yüzden Wakabayashi'nin boşluğunu\Ndolduracak birisine ihtiyacımız var.
Dialogue: 0,0:10:58.84,0:11:01.59,Default,,0,0,0,,Wakabayashi'nin yokluğunun zor olduğu belli.
Dialogue: 0,0:11:01.59,0:11:06.93,Default,,0,0,0,,Ama buna takılı kalırsak\Nasla ilerleme kaydedemeyiz.
Dialogue: 0,0:11:07.50,0:11:08.85,Default,,0,0,0,,Öyleyse açıklıyorum.
Dialogue: 0,0:11:09.68,0:11:12.48,Default,,0,0,0,,Nankatsu FC'nin yeni kaptanı...
Dialogue: 0,0:11:15.12,0:11:17.30,Default,,0,0,0,,...Ozora Tsubasa!
Dialogue: 0,0:11:17.30,0:11:19.24,Default,,0,0,0,,B-Ben mi?
Dialogue: 0,0:11:19.24,0:11:20.90,Default,,0,0,0,,Adamsın be Tsubasa!
Dialogue: 0,0:11:20.90,0:11:22.29,Default,,0,0,0,,Tsubasa demek.
Dialogue: 0,0:11:22.29,0:11:24.49,Default,,0,0,0,,Çok neşeli bir takım olduk.
Dialogue: 0,0:11:24.49,0:11:27.49,Default,,0,0,0,,Bugünden itibaren\Nyeni Kaptan Tsubasa ile...
Dialogue: 0,0:11:27.49,0:11:30.35,Default,,0,0,0,,...yeni Nankatsu FC'nin nasıl\Nfutbol oynadığını göstereceğiz.
Dialogue: 0,0:11:30.35,0:11:31.60,Default,,0,0,0,,Tamam!
Dialogue: 0,0:11:31.60,0:11:33.99,Default,,0,0,0,,Tsubasa, yeni Kaptan olarak takımı selamla.
Dialogue: 0,0:11:33.99,0:11:34.50,Default,,0,0,0,,Tamam!
Dialogue: 0,0:11:39.30,0:11:41.97,Default,,0,0,0,,Hep birlikte Japonya'nın en iyisi olalım!
Dialogue: 0,0:11:41.97,0:11:43.70,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:53.34,0:11:56.31,Default,,0,0,0,,Anne. Beni kaptan yaptılar.
Dialogue: 0,0:11:56.31,0:11:58.31,Default,,0,0,0,,Ne? Seni mi?
Dialogue: 0,0:11:58.31,0:12:01.03,Default,,0,0,0,,Evet. Roberto'ya da söylemem lazım.
Dialogue: 0,0:12:01.03,0:12:02.11,Default,,0,0,0,,Nerede?
Dialogue: 0,0:12:02.11,0:12:04.37,Default,,0,0,0,,Az önce dışarı çıktı sanırım.
Dialogue: 0,0:12:04.37,0:12:06.87,Default,,0,0,0,,Ne? Hadi ya.
Dialogue: 0,0:12:06.87,0:12:11.75,Default,,0,0,0,,Ama kaptan olacaksan\Ndaha çok çabalaman gerek.
Dialogue: 0,0:12:11.75,0:12:13.00,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:19.75,0:12:25.51,Default,,0,0,0,,Kimse için sorun yokken\Nneden ben bu kadar tereddütte kalıyorum?
Dialogue: 0,0:12:25.51,0:12:29.51,Default,,0,0,0,,Tsubasa'yı Brezilya'ya götürmek\Nisteyen ben değil miydim?
Dialogue: 0,0:12:29.51,0:12:32.77,Default,,0,0,0,,Öyleyse neden?!
Dialogue: 0,0:12:35.77,0:12:39.52,Default,,0,0,0,,{\i1}Ulusallar zamanı geldi Tsubasa.{\i0}
Dialogue: 0,0:12:39.52,0:12:41.14,Default,,0,0,0,,{\i1}Elinden geleni yap.{\i0}
Dialogue: 0,0:12:41.14,0:12:44.57,Default,,0,0,0,,{\i1}Ve her şey için sana güveniyorum Roberto.{\i0}
Dialogue: 0,0:12:47.61,0:12:55.46,Default,,0,0,0,,{\i1}Sonunda bugün Nankatsu FC,\Nulusallara katılmak için Tokyo'ya yola çıkacak.{\i0}
Dialogue: 0,0:12:55.46,0:12:59.36,Default,,0,0,0,,Öyleyse Nankatsu FC'nin zaferini\Ndilemek amacıyla...
Dialogue: 0,0:12:59.36,0:13:03.01,Default,,0,0,0,,Hora! Hora! Nankatsu!
Dialogue: 0,0:13:03.01,0:13:05.14,Default,,0,0,0,,Hora! Hora! Nankatsu!
Dialogue: 0,0:13:05.14,0:13:07.51,Default,,0,0,0,,Hora! Hora! Nankatsu!
Dialogue: 0,0:13:07.51,0:13:09.51,Default,,0,0,0,,Ne büyük bir uğurlama ama.
Dialogue: 0,0:13:09.51,0:13:11.46,Default,,0,0,0,,Gösteriye dönmüş resmen.
Dialogue: 0,0:13:11.46,0:13:13.77,Default,,0,0,0,,Annen de bir inanılmaz.
Dialogue: 0,0:13:13.77,0:13:16.01,Default,,0,0,0,,{\an8}#Bastır Ishizaki Ryo#
Dialogue: 0,0:13:13.77,0:13:16.01,Default,,0,0,0,,Ryo! Günlerini göster!
Dialogue: 0,0:13:16.02,0:13:19.04,Default,,0,0,0,,Wakabayashi-san uğurlamaya da gelmedi.
Dialogue: 0,0:13:19.89,0:13:22.19,Default,,0,0,0,,Bizi giderken izlemeye katlanamamıştır.
Dialogue: 0,0:13:22.92,0:13:25.94,Default,,0,0,0,,{\i1}Sözümü kesinlikle tutacağım Wakabayashi-kun.{\i0}
Dialogue: 0,0:13:25.94,0:13:27.07,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:27.57,0:13:30.85,Default,,0,0,0,,{\i1}Roberto! Maçlarımı izle!{\i0}
Dialogue: 0,0:13:30.85,0:13:33.77,Default,,0,0,0,,{\i1}Brezilya'ya kesinlikle gideceğim.{\i0}
Dialogue: 0,0:13:36.87,0:13:40.84,Default,,0,0,0,,Hora! Hora! Nankatsu!
Dialogue: 0,0:13:41.96,0:13:47.22,Default,,0,0,0,,Tsubasa-kun! Biz de arkadan geleceğiz!
Dialogue: 0,0:13:52.56,0:13:54.56,Default,,0,0,0,,{\i1}Size güveniyorum millet.{\i0}
Dialogue: 0,0:13:55.24,0:13:57.94,Default,,0,0,0,,{\i1}Ben de orada olacağım.{\i0}
Dialogue: 0,0:13:58.98,0:14:00.94,Default - Top,,0,0,0,,— Tokyo —
Dialogue: 0,0:14:00.94,0:14:03.94,Default - Top,,0,0,0,,— Wangan Futbol Sahası —
Dialogue: 0,0:14:07.47,0:14:10.07,Default,,0,0,0,,Sonunda geldik ulusallara!
Dialogue: 0,0:14:10.07,0:14:11.87,Default,,0,0,0,,Her zamanki gibi neşen yerinde.
Dialogue: 0,0:14:12.78,0:14:14.61,Default,,0,0,0,,Herkes burada mı?
Dialogue: 0,0:14:14.61,0:14:17.25,Default,,0,0,0,,Bir şey unutmadığınıza dair\Nbir kez daha emin olun.
Dialogue: 0,0:14:17.25,0:14:19.48,Default,,0,0,0,,Gidip sahaya bakalım mı?
Dialogue: 0,0:14:19.48,0:14:22.24,Default,,0,0,0,,Önce çantaları otele bırakalım.
Dialogue: 0,0:14:22.24,0:14:24.92,Default,,0,0,0,,Hey siz! Ne yapıyorsunuz?!
Dialogue: 0,0:14:27.01,0:14:28.13,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:28.13,0:14:29.63,Default,,0,0,0,,Al Kazuo!
Dialogue: 0,0:14:30.51,0:14:31.51,Default,,0,0,0,,Güzel pas!
Dialogue: 0,0:14:31.51,0:14:32.15,Default,,0,0,0,,Ne?
Dialogue: 0,0:14:32.15,0:14:34.65,Default,,0,0,0,,Ne yapıyor bunlar?
Dialogue: 0,0:14:34.65,0:14:38.18,Default,,0,0,0,,Platformun karşı taraflarından paslaşıyorlar.
Dialogue: 0,0:14:38.85,0:14:42.48,Default,,0,0,0,,Hey! Kesin şunu!
Dialogue: 0,0:14:42.48,0:14:45.32,Default,,0,0,0,,Tokyo istasyonu görevlileri de\Nçok dırdırcı çıktı.
Dialogue: 0,0:14:48.05,0:14:48.78,Default,,0,0,0,,Masao!
Dialogue: 0,0:14:49.24,0:14:50.32,Default,,0,0,0,,Güzel pas!
Dialogue: 0,0:14:52.32,0:14:54.24,Default,,0,0,0,,Bunlar ikiz!
Dialogue: 0,0:14:54.24,0:14:55.40,Default,,0,0,0,,Al!
Dialogue: 0,0:14:55.40,0:14:56.29,Default,,0,0,0,,İşte.
Dialogue: 0,0:14:56.29,0:14:57.08,Default,,0,0,0,,Al!
Dialogue: 0,0:14:57.08,0:15:00.83,Default,,0,0,0,,Masao, Kazuo. Çabuk olun, gidiyoruz.
Dialogue: 0,0:15:00.83,0:15:02.02,Default,,0,0,0,,Tamam.
Dialogue: 0,0:15:02.02,0:15:03.58,Default,,0,0,0,,Kazuo, gidelim.
Dialogue: 0,0:15:03.58,0:15:06.09,Default,,0,0,0,,Tamam. Bu son. Al.
Dialogue: 0,0:15:06.40,0:15:08.59,Default,,0,0,0,,Tamam. Ne?
Dialogue: 0,0:15:09.12,0:15:11.60,Default,,0,0,0,,Siz de mi ulusallara katılacaksınız?
Dialogue: 0,0:15:11.60,0:15:12.39,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:12.39,0:15:15.97,Default,,0,0,0,,Biz Akita'dan Hanawa Genç Futbol Kulübü'yüz.
Dialogue: 0,0:15:15.97,0:15:17.14,Default,,0,0,0,,Memnun oldul.
Dialogue: 0,0:15:17.14,0:15:19.04,Default,,0,0,0,,Masao, acele et!
Dialogue: 0,0:15:19.04,0:15:20.39,Default,,0,0,0,,Tamam.
Dialogue: 0,0:15:20.39,0:15:21.97,Default,,0,0,0,,Neyi var bunların?
Dialogue: 0,0:15:21.97,0:15:23.40,Default,,0,0,0,,Tuhaf tipler.
Dialogue: 0,0:15:23.40,0:15:25.92,Default,,0,0,0,,Ama oldukça yetenekliydiler.
Dialogue: 0,0:15:25.92,0:15:27.65,Default,,0,0,0,,Evet, öylelerdi.
Dialogue: 0,0:15:28.16,0:15:29.24,Default,,0,0,0,,{\i1}Aynen öyle.{\i0}
Dialogue: 0,0:15:29.24,0:15:32.91,Default,,0,0,0,,{\i1}Ulusallarda başka bilmediğimiz\Ninanılmaz oyuncular da olacak.{\i0}
Dialogue: 0,0:15:33.53,0:15:35.37,Default,,0,0,0,,{\i1}Oynarken bunu aklımızda bulundurmalıyız.{\i0}
Dialogue: 0,0:15:37.58,0:15:40.44,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvası...{\i0}
Dialogue: 0,0:15:40.44,0:15:46.59,Default,,0,0,0,,{\i1}...her yıl yaz tatili sırasında genç futbolcular\Narasında düzenlenen yıllık bir turnuvadır.{\i0}
Dialogue: 0,0:15:46.59,0:15:49.85,Default,,0,0,0,,{\i1}Ülke çapındaki 48 takım...{\i0}
Dialogue: 0,0:15:49.85,0:15:56.68,Default,,0,0,0,,{\i1}...önce 6 kişilik bloklara koyulur\Nsonra ikişer blok...{\i0}
Dialogue: 0,0:15:56.68,0:16:00.98,Default,,0,0,0,,{\i1}...turnuva şampiyonluğu\Niçin karşı karşıya gelmeye başlar.{\i0}
Dialogue: 0,0:16:00.98,0:16:02.73,Default,,0,0,0,,# Ulusal Genç Futbol Turnuvası\NTanışma Toplantısı #
Dialogue: 0,0:16:05.23,0:16:06.36,Default,,0,0,0,,Misaki!
Dialogue: 0,0:16:06.36,0:16:07.26,Default,,0,0,0,,Ne?
Dialogue: 0,0:16:07.26,0:16:10.39,Default,,0,0,0,,Matsuyama! Çocuklar!
Dialogue: 0,0:16:10.39,0:16:12.26,Default,,0,0,0,,Gerçekten de sensin!
Dialogue: 0,0:16:12.26,0:16:15.64,Default,,0,0,0,,En iyilerden Nankatsu'ya gittin demek.
Dialogue: 0,0:16:15.64,0:16:18.37,Default,,0,0,0,,Hokkaido'dan arkadaşlarım.
Dialogue: 0,0:16:18.37,0:16:19.58,Default,,0,0,0,,Vay.
Dialogue: 0,0:16:19.99,0:16:21.45,Default,,0,0,0,,Ben Kaptan Matsuyama.
Dialogue: 0,0:16:21.45,0:16:24.67,Default,,0,0,0,,Bizim kaptanımız Ozora Tsubasa-kun.
Dialogue: 0,0:16:24.67,0:16:25.54,Default,,0,0,0,,Memnun oldum.
Dialogue: 0,0:16:25.54,0:16:27.45,Default,,0,0,0,,Sonunda seninle tanıştım.
Dialogue: 0,0:16:27.45,0:16:29.80,Default,,0,0,0,,Misaki'den hakkında çok şey duydum.
Dialogue: 0,0:16:31.21,0:16:33.78,Default,,0,0,0,,Bu sefer rakip olacağız.
Dialogue: 0,0:16:33.78,0:16:35.51,Default,,0,0,0,,Evet. Aynen öyle.
Dialogue: 0,0:16:35.51,0:16:38.38,Default,,0,0,0,,Bir saniye Tsubasa-kun!
Dialogue: 0,0:16:39.06,0:16:40.77,Default,,0,0,0,,Şimdi de Tsubasa.
Dialogue: 0,0:16:41.11,0:16:43.40,Default,,0,0,0,,Şükür ki seni buldum.
Dialogue: 0,0:16:43.40,0:16:47.77,Default,,0,0,0,,Tanıştırayım. Kaptanımız Misugi Jun-kun.
Dialogue: 0,0:16:47.77,0:16:50.90,Default,,0,0,0,,Memnun oldum. Musashi FC'den Misugi.
Dialogue: 0,0:16:51.44,0:16:53.96,Default,,0,0,0,,Ozora Tsubasa. Ben de memnun oldum.
Dialogue: 0,0:16:53.96,0:16:56.78,Default,,0,0,0,,Seninle maç yapmak için sabırsızlanıyorum.
Dialogue: 0,0:16:57.16,0:16:59.65,Default,,0,0,0,,{\i1}Çok tatlı kız be.{\i0}
Dialogue: 0,0:16:59.65,0:17:02.60,Default,,0,0,0,,Sen Nankatsu FC'den misin?
Dialogue: 0,0:17:02.60,0:17:05.12,Default,,0,0,0,,Oha! Dev gibi!
Dialogue: 0,0:17:05.12,0:17:07.88,Default,,0,0,0,,Wakabayashi Genzo'nun gelmeyeceği\Ndoğru mu?
Dialogue: 0,0:17:07.88,0:17:10.04,Default,,0,0,0,,Evet, doğru.
Dialogue: 0,0:17:10.04,0:17:12.99,Default,,0,0,0,,Ben Naniwa FC'den Nakanishi.
Dialogue: 0,0:17:12.99,0:17:18.95,Default,,0,0,0,,Wakabayashi yoksa buradaki\Nen iyi kaleci benim.
Dialogue: 0,0:17:21.20,0:17:23.26,Default,,0,0,0,,{\i1}İstasyondaki çocuklar.{\i0}
Dialogue: 0,0:17:23.26,0:17:27.19,Default,,0,0,0,,{\i1}Akita'dan Hanawa Genç Futbol Kulübü mü\Ndemişlerdi ki?{\i0}
Dialogue: 0,0:17:28.44,0:17:30.19,Default,,0,0,0,,Hyuga Kojiro!
Dialogue: 0,0:17:30.19,0:17:31.94,Default,,0,0,0,,Meiwa FC mi?
Dialogue: 0,0:17:32.59,0:17:36.19,Default,,0,0,0,,{\i1}Tsubasa'nın rakipleri bir araya gelmişti.{\i0}
Dialogue: 0,0:17:40.99,0:17:43.95,Default,,0,0,0,,Şimdi de bloklardaki takımlara\Nkarar vereceğiz.
Dialogue: 0,0:17:43.95,0:17:48.88,Default,,0,0,0,,Shizuoka temsilcisi Nankatsu FC\NKaptanı Ozora Tsubasa-kun.
Dialogue: 0,0:17:48.88,0:17:49.71,Default,,0,0,0,,Burada!
Dialogue: 0,0:17:53.93,0:17:58.55,Default,,0,0,0,,Nankatsu FC, ilk bloka birinci\NA takımı olarak giriyor.
Dialogue: 0,0:17:59.39,0:18:04.61,Default,,0,0,0,,İşte bu Tsubasa!\Nİyi seçtin ha! Birinci gruptan A!
Dialogue: 0,0:18:08.85,0:18:10.65,Default,,0,0,0,,Ne yapıyor bu?
Dialogue: 0,0:18:10.65,0:18:13.77,Default,,0,0,0,,Meiwa FC, ilk blok B.
Dialogue: 0,0:18:14.81,0:18:16.23,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:18:16.23,0:18:18.49,Default,,0,0,0,,Öyleyse ilk maçımız--
Dialogue: 0,0:18:18.49,0:18:20.49,Default,,0,0,0,,Meiwa FC mi?
Dialogue: 0,0:18:21.55,0:18:22.90,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:18:24.96,0:18:27.04,Default,,0,0,0,,Evet. Az önce duydum.
Dialogue: 0,0:18:27.04,0:18:33.17,Default,,0,0,0,,Evet. Bu yüzden hemen iyileş de\Nbizimle birlikte finallerde oyna.
Dialogue: 0,0:18:33.17,0:18:37.32,Default,,0,0,0,,Evet. Kazanın Tsubasa.\NKesinlikle kazanın.
Dialogue: 0,0:18:37.32,0:18:39.30,Default,,0,0,0,,Kazanacağız. Söz.
Dialogue: 0,0:18:40.96,0:18:43.55,Default,,0,0,0,,Wakabayashi yıkılmıştır eminim.
Dialogue: 0,0:18:44.16,0:18:47.56,Default,,0,0,0,,Lanet olsun! Bacağım iyi olsaydı...
Dialogue: 0,0:18:48.51,0:18:53.19,Default,,0,0,0,,Ama neden ilk maçta bu oluyor?!
Dialogue: 0,0:18:55.69,0:18:57.94,Default,,0,0,0,,# Meiwa 3. Grup #
Dialogue: 0,0:18:59.06,0:19:02.78,Default,,0,0,0,,Kaptan! Kaptan bandını\Ntakmanız gerek.
Dialogue: 0,0:19:06.25,0:19:07.49,Default,,0,0,0,,Sen tak.
Dialogue: 0,0:19:07.49,0:19:09.46,Default,,0,0,0,,Ne? Ben mi?
Dialogue: 0,0:19:09.46,0:19:11.21,Default,,0,0,0,,Ben istemiyorum.
Dialogue: 0,0:19:12.42,0:19:14.21,Default,,0,0,0,,Tamam.
Dialogue: 0,0:19:17.42,0:19:20.05,Default,,0,0,0,,Durun! Durun!
Dialogue: 0,0:19:23.77,0:19:26.13,Default,,0,0,0,,Gerçekten de işe yaramıyor Anego.
Dialogue: 0,0:19:26.13,0:19:28.08,Default,,0,0,0,,Herkes bencil olmuş.
Dialogue: 0,0:19:28.08,0:19:30.56,Default,,0,0,0,,Öyleyse...
Dialogue: 0,0:19:30.56,0:19:33.20,Default,,0,0,0,,İkiniz gidin de bir araba çarpsın size!
Dialogue: 0,0:19:33.20,0:19:34.62,Default,,0,0,0,,O zaman dururlar!
Dialogue: 0,0:19:34.62,0:19:36.58,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:19:38.46,0:19:40.17,Default,,0,0,0,,Hey! Gençler!
Dialogue: 0,0:19:40.17,0:19:41.59,Default,,0,0,0,,Alayım mı sizi?
Dialogue: 0,0:19:41.59,0:19:42.79,Default,,0,0,0,,Gerçekten mi
Dialogue: 0,0:19:42.79,0:19:44.20,Default,,0,0,0,,Tokyo'ya götürebilir misiniz?
Dialogue: 0,0:19:44.20,0:19:45.14,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:45.14,0:19:46.83,Default,,0,0,0,,Ben de Tokyo'ya gidiyorum.
Dialogue: 0,0:19:46.83,0:19:48.68,Default,,0,0,0,,Hadi çabuk atlayın.
Dialogue: 0,0:19:48.68,0:19:52.08,Default,,0,0,0,,Yaşasın! Çocuklar kamyon durdu! Şanslıyız!
Dialogue: 0,0:19:52.45,0:19:53.30,Default,,0,0,0,,Yaşasın!
Dialogue: 0,0:19:53.30,0:19:53.91,Default,,0,0,0,,Başardık!
Dialogue: 0,0:19:53.91,0:19:55.42,Default,,0,0,0,,Hep beraber tezahürat yapabiliriz.
Dialogue: 0,0:19:55.42,0:19:59.55,Default,,0,0,0,,Bekleyin, bekleyin, bekleyin.\NBu kadar kişiyi almak kurallara aykırı.
Dialogue: 0,0:19:59.55,0:20:00.38,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:00.38,0:20:02.09,Default,,0,0,0,,Bana bırakın siz.
Dialogue: 0,0:20:02.09,0:20:05.34,Default,,0,0,0,,Biz kamyon şoförleri kimseyi darda koymayız.
Dialogue: 0,0:20:05.34,0:20:07.15,Default,,0,0,0,,Destek istiyorum.
Dialogue: 0,0:20:07.15,0:20:08.46,Default,,0,0,0,,Destek istiyorum.
Dialogue: 0,0:20:08.46,0:20:10.39,Default,,0,0,0,,Shizuoka bölgesinden Nankatsu kasabası.
Dialogue: 0,0:20:10.39,0:20:13.07,Default,,0,0,0,,Yükümüz bir hanımefendi ve arkadaşları.
Dialogue: 0,0:20:13.07,0:20:14.59,Default,,0,0,0,,Size güveniyorum!
Dialogue: 0,0:20:20.61,0:20:21.57,Default,,0,0,0,,Vay canına!
Dialogue: 0,0:20:21.57,0:20:23.21,Default,,0,0,0,,Harika!
Dialogue: 0,0:20:23.21,0:20:25.11,Default,,0,0,0,,Çocuklar, atlayın kamyonlara.
Dialogue: 0,0:20:28.91,0:20:30.88,Default,,0,0,0,,Amca, acele edebilir miyiz?
Dialogue: 0,0:20:30.88,0:20:32.75,Default,,0,0,0,,Ne için gidiyorsunuz siz?
Dialogue: 0,0:20:32.75,0:20:34.26,Default,,0,0,0,,Futbol takımımızı desteklemeye.
Dialogue: 0,0:20:34.26,0:20:36.86,Default,,0,0,0,,Demek öyle.\NAmigo takımısınız yani.
Dialogue: 0,0:20:36.86,0:20:37.63,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:20:37.63,0:20:41.14,Default,,0,0,0,,Anlıyorum. Ben de futbolu severim.
Dialogue: 0,0:20:41.14,0:20:46.84,Default,,0,0,0,,Ama menajer olsan takımla\Nbirlikte gitmez miydin hanımefendi?
Dialogue: 0,0:20:47.72,0:20:49.71,Default,,0,0,0,,O konu yasak!
Dialogue: 0,0:20:50.67,0:20:52.73,Default,,0,0,0,,{\i1}Menajere ihtiyacımız yok.{\i0}
Dialogue: 0,0:20:52.73,0:20:57.16,Default,,0,0,0,,{\i1}O koç yüzünden menajer olamadım.{\i0}
Dialogue: 0,0:20:57.16,0:21:02.31,Default,,0,0,0,,Ama şu an seni desteklemeye\Ngeliyorum Tsubasa-kun!
Dialogue: 0,0:21:07.31,0:21:09.20,Default,,0,0,0,,{\i1}Katılımcılar girsin.{\i0}
Dialogue: 0,0:21:09.20,0:21:13.28,Default,,0,0,0,,{\an8}Furano Genç Futbol Kulübü\NHokkaido
Dialogue: 0,0:21:10.19,0:21:14.46,Default,,0,0,0,,{\i1}İşte bu seneki\NUlusal Genç Futbol Turnuvası için...{\i0}
Dialogue: 0,0:21:15.00,0:21:18.46,Default,,0,0,0,,{\i1}...kuzeyden ve güneyden gelen\N48 takımın genç futbolcuları...{\i0}
Dialogue: 0,0:21:18.46,0:21:25.22,Default,,0,0,0,,{\i1}...bu turnuvanın zorlu maçları için\Nelemeleri geçerek geldi.{\i0}
Dialogue: 0,0:21:25.22,0:21:28.39,Default,,0,0,0,,{\i1}Eminiz ki bu gençler arasında...{\i0}
Dialogue: 0,0:21:28.39,0:21:31.49,Default,,0,0,0,,{\i1}...turnuvada yeteneklerini gösterecek çok kişi var.{\i0}
Dialogue: 0,0:21:32.31,0:21:35.48,Default,,0,0,0,,{\an8}Nankatsu FC\NShizuoka Bölgesi
Dialogue: 0,0:21:33.80,0:21:36.56,Default,,0,0,0,,Ulusal turnuva başlamak üzere.
Dialogue: 0,0:21:40.17,0:21:41.78,Default,,0,0,0,,{\i1}Katılımcı yeminleri.{\i0}
Dialogue: 0,0:21:41.78,0:21:45.57,Default,,0,0,0,,{\i1}Nankatsu FC Kaptanı Ozora Tsubasa-kun.{\i0}
Dialogue: 0,0:21:49.72,0:21:55.08,Default,,0,0,0,,Yemin ediyorum! Katılımcılar olarak\Nsportmence oynayacak...
Dialogue: 0,0:21:55.08,0:21:58.81,Default,,0,0,0,,...ve dürüstlük ilkelerine\Nbağlı kalacağız!
Dialogue: 0,0:21:58.81,0:22:04.09,Default,,0,0,0,,Nankatsu Futbol Kulübü Kaptanı\NOzora Tsubasa!
Dialogue: 0,0:22:06.72,0:22:09.37,Default,,0,0,0,,Vay canına! Çok iyiydi!
Dialogue: 0,0:22:09.37,0:22:11.37,Default,,0,0,0,,Değil mi Roberto?
Dialogue: 0,0:22:11.37,0:22:12.51,Default,,0,0,0,,Evet.
Dialogue: 0,0:22:16.40,0:22:18.30,Default,,0,0,0,,{\i1}Sportmenlik mi?{\i0}
Dialogue: 0,0:23:50.24,0:24:00.81,Default,,0,0,0,,Gelecek 14. Bölümde\NHadi Nankatsu! Meiwa'yı Yen!
Dialogue: 0,0:01:39.11,0:01:44.70,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:01:44.70,0:01:49.37,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:01:50.62,0:01:55.29,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:01:56.17,0:02:03.88,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:02:03.88,0:02:09.64,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:02:09.64,0:02:18.40,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:02:18.40,0:02:23.95,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:02:23.95,0:02:29.87,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:02:29.87,0:02:31.54,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:02:31.54,0:02:38.75,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:02:38.75,0:02:41.76,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:02:41.76,0:02:46.18,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:01:39.11,0:01:44.70,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:01:44.70,0:01:49.37,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:01:50.62,0:01:55.29,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:01:56.17,0:02:03.88,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:02:03.88,0:02:09.64,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:02:09.64,0:02:18.40,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:02:18.40,0:02:23.95,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:02:23.95,0:02:29.87,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:02:29.87,0:02:31.54,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:02:31.54,0:02:38.75,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo\N
Dialogue: 0,0:02:38.75,0:02:41.76,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:02:41.76,0:02:46.18,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Romaji,,0,0,0,,chotto aremi na eesu ga tooru
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Romaji,,0,0,0,,suguremono da to machijuu sawagu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Romaji,,0,0,0,,chochou sanba, jiguzagu sanba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Romaji,,0,0,0,,aitsu no uwasa de chanba mo hashiru
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Romaji,,0,0,0,,sore ni tsukete mo oretacha nan darou
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Romaji,,0,0,0,,booru hitotsu ni kirikiri mai sa
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Romaji,,0,0,0,,itsuka kimeru ze, inazuma shuuto
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Romaji,,0,0,0,,son toki ore ga suupaa hiiroo sa
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Romaji,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Türkçe,,0,0,0,,sert bakışıyla geçiyor bir yıldız
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Türkçe,,0,0,0,,tüm şehir söylüyor harika birisi olduğunu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Türkçe,,0,0,0,,kelebek sambası, zikzak samba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Türkçe,,0,0,0,,onun hakkındaki söylentiler\Nsambayı bile harekete geçiriyor
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Türkçe,,0,0,0,,onun aksine bizim burada olma sebebimiz
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Türkçe,,0,0,0,,top için delirmek
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Türkçe,,0,0,0,,bir gün şimşek gibi vuruşum hedefine ulaşacak
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Türkçe,,0,0,0,,o an bir süper kahraman olacağım işte ben
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Türkçe,,0,0,0,,sonuna kadar koş
