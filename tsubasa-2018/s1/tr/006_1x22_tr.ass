Dialogue: 0,0:12:47.12,0:12:52.35,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:02.69,0:00:05.38,Default,,0,0,0,,{\i1}Oyun birkaç dakikalığına\Nkesintiye uğramıştı ama...{\i0}
Dialogue: 0,0:00:05.38,0:00:07.48,Default,,0,0,0,,{\i1}...şu an devam etmeye hazır.{\i0}
Dialogue: 0,0:00:08.07,0:00:10.88,Default,,0,0,0,,{\i1}Nankatsu beraberliği sağlayabilecek mi?{\i0}
Dialogue: 0,0:00:10.88,0:00:12.65,Default,,0,0,0,,{\i1}Yoksa Musashi bu durumu koruyabilecek mi?{\i0}
Dialogue: 0,0:00:13.46,0:00:19.66,Default,,0,0,0,,{\i1}Musashi Kaptanı Misugi-kun hala geride\Nduruyor ve kale direğine yaslanıyor.{\i0}
Dialogue: 0,0:00:19.66,0:00:21.26,Default,,0,0,0,,{\i1}Sadece 2 dakika kaldı!{\i0}
Dialogue: 0,0:00:21.26,0:00:24.04,Default,,0,0,0,,{\i1}Hangi takım finale ilerleyecek?{\i0}
Dialogue: 0,0:01:58.38,0:02:03.39,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}Bölüm 22:\NBelirleyici Uzatmalar
Dialogue: 0,0:01:58.38,0:02:03.39,Default,,0,0,0,,{\fad(500,500)\pos(1576,1006)}Çeviri: ARE-YOU-SURE\N{\fs50}AreyousureSubs Sunar
Dialogue: 0,0:02:00.80,0:02:02.05,Default - Top,,0,0,0,,Gidelim Musashi!
Dialogue: 0,0:02:02.05,0:02:03.68,Default - Top,,0,0,0,,Gelin Nankatsu!
Dialogue: 0,0:02:03.68,0:02:07.37,Default,,0,0,0,,{\i1}Nankatsu paslaşarak defansta\Naçık bulmaya çalışıyor.{\i0}
Dialogue: 0,0:02:07.37,0:02:10.98,Default,,0,0,0,,{\i1}Ne var ki Musashi'nin forvetleri bile\Ngeri dönmüşken herkes defansta!{\i0}
Dialogue: 0,0:02:10.98,0:02:15.11,Default,,0,0,0,,{\i1}Bu bir gollük liderliği\Nkorumaya çalıştıklarına şüphe yok.{\i0}
Dialogue: 0,0:02:15.11,0:02:18.61,Default,,0,0,0,,Honma' Sanada! Tsubasa-kun'u\Nböyle tutmaya devam edin!
Dialogue: 0,0:02:18.61,0:02:19.20,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:19.20,0:02:22.83,Default,,0,0,0,,Bu gidişle Nankatsu'nun Tsubasa-kun'dan\Nbaşka güvenecek kimsesi olmayacak!
Dialogue: 0,0:02:22.83,0:02:26.58,Default,,0,0,0,,Topu düşünmeyin! Sadece\NTsubasa-kun'u sağlam bir markaja alın!
Dialogue: 0,0:02:26.58,0:02:27.12,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:27.12,0:02:28.00,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:28.00,0:02:29.64,Default,,0,0,0,,Ne oldu çocuklar?!
Dialogue: 0,0:02:29.64,0:02:32.04,Default,,0,0,0,,Tsubasa'yı sağlam bir\Nmarkaja alacakları bariz!
Dialogue: 0,0:02:32.74,0:02:37.42,Default,,0,0,0,,Ama Nankatsu, buraya kadar\Nsadece Tsubasa sayesinde kazanarak gelmedi!
Dialogue: 0,0:02:37.42,0:02:41.47,Default,,0,0,0,,Bu önemli anda herkes gücünü\Nbirleştirerek o golü almalı!
Dialogue: 0,0:02:41.47,0:02:43.25,Default,,0,0,0,,Wakabayashi-san...
Dialogue: 0,0:02:43.25,0:02:43.76,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:02:43.76,0:02:47.10,Default,,0,0,0,,Shutetsu Üçlüsü olarak\Ndefanslarını yarıp geçeceğiz!
Dialogue: 0,0:02:47.10,0:02:47.64,Default,,0,0,0,,Evet!
Dialogue: 0,0:02:47.64,0:02:50.14,Default,,0,0,0,,Ichinose! Mukai!\NSola gidip ikisini tutun!
Dialogue: 0,0:02:51.01,0:02:51.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:51.85,0:02:53.56,Default,,0,0,0,,Bu taraftan olmuyorsan...
Dialogue: 0,0:02:53.56,0:02:55.56,Default,,0,0,0,,Sağ tarafa pas verecek!
Dialogue: 0,0:02:55.56,0:02:56.73,Default,,0,0,0,,Nakajima, tut onu!
Dialogue: 0,0:02:56.73,0:02:57.48,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:58.48,0:03:02.03,Default,,0,0,0,,{\i1}Kisugi-kun'un pas verebileceği hiçbir yer yok.{\i0}
Dialogue: 0,0:03:02.03,0:03:03.28,Default,,0,0,0,,{\i1}Olamaz.{\i0}
Dialogue: 0,0:03:03.28,0:03:06.45,Default,,0,0,0,,{\i1}Misugi-kun tüm hareketlerimizi okuyor.{\i0}
Dialogue: 0,0:03:07.64,0:03:10.28,Default,,0,0,0,,{\i1}Çok sakin ve kendine hakim.{\i0}
Dialogue: 0,0:03:10.28,0:03:13.33,Default,,0,0,0,,{\i1}Misugi-kun'un harika yönlendirmeleri sayesinde...{\i0}
Dialogue: 0,0:03:13.33,0:03:15.42,Default,,0,0,0,,{\i1}...Musashi'nin defansında hiç açık yok!{\i0}
Dialogue: 0,0:03:15.42,0:03:17.84,Default,,0,0,0,,{\i1}İşte bu! Bu maç bizimdir!{\i0}
Dialogue: 0,0:03:17.84,0:03:19.49,Default,,0,0,0,,{\i1}Nankatsu zor bir durumda.{\i0}
Dialogue: 0,0:03:19.49,0:03:22.26,Default,,0,0,0,,{\i1}Bu durumda düzgün bir atak çıkaramıyorlar.{\i0}
Dialogue: 0,0:03:22.26,0:03:25.34,Default,,0,0,0,,{\i1}Bir dakikadan az bir süre kaldı!{\i0}
Dialogue: 0,0:03:25.34,0:03:28.59,Default,,0,0,0,,Yavaşlıyorlar! İşte bizi için bir fırsat!
Dialogue: 0,0:03:28.59,0:03:30.10,Default,,0,0,0,,Gidip topu alın!
Dialogue: 0,0:03:30.10,0:03:33.64,Default,,0,0,0,,Burada topu alıp elimizde\Ntutarsak maçı kazanırız!
Dialogue: 0,0:03:33.64,0:03:34.56,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:34.56,0:03:37.84,Default,,0,0,0,,{\i1}Şimdi Musashi topu çalmak\Niçin büyük bir baskı yapıyor!{\i0}
Dialogue: 0,0:03:37.84,0:03:41.40,Default,,0,0,0,,{\i1}Nankatsu, topu vermemek için\Nher şeyiyle mücadele ediyor!{\i0}
Dialogue: 0,0:03:41.40,0:03:42.56,Default,,0,0,0,,Olmuyor.
Dialogue: 0,0:03:42.56,0:03:44.28,Default,,0,0,0,,Bu gidişle süre bitecek!
Dialogue: 0,0:03:44.28,0:03:45.64,Default,,0,0,0,,Bende!
Dialogue: 0,0:03:45.64,0:03:48.66,Default,,0,0,0,,{\i1}Ne?! Nankatsu panikliyor mu?!{\i0}
Dialogue: 0,0:03:48.66,0:03:51.45,Default,,0,0,0,,{\i1}Musashi sonunda topu alıyor!{\i0}
Dialogue: 0,0:03:51.45,0:03:53.04,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:03:53.70,0:03:57.13,Default,,0,0,0,,{\i1}Nankatsu'dan Ishizaki-kun\Ntopu hemen geri alıyor!{\i0}
Dialogue: 0,0:03:57.13,0:03:58.75,Default,,0,0,0,,Adamsın Ishizaki-kun!
Dialogue: 0,0:03:58.75,0:04:00.05,Default,,0,0,0,,Gidelim millet!
Dialogue: 0,0:04:00.90,0:04:03.76,Default,,0,0,0,,{\i1}Maç bitmeye yakından\Natak şansı yakılıyorlar!{\i0}
Dialogue: 0,0:04:04.26,0:04:09.31,Default,,0,0,0,,{\i1}Ne var ki Nankatsu'nun yıldız oyuncusu\NTsubasa-kun hala sağlam bir markajda!{\i0}
Dialogue: 0,0:04:09.31,0:04:10.51,Default,,0,0,0,,Çocuklar...
Dialogue: 0,0:04:10.51,0:04:11.77,Default,,0,0,0,,Süre...
Dialogue: 0,0:04:13.06,0:04:15.39,Default,,0,0,0,,Şu markaj konusunda\Nhiçbir şey yapamaz mısın?!
Dialogue: 0,0:04:15.93,0:04:17.52,Default,,0,0,0,,{\i1}Taki-kun buradan şut mu çekecek?!{\i0}
Dialogue: 0,0:04:19.52,0:04:21.83,Default,,0,0,0,,{\i1}Çekmiyor! Geri pas veriyor!{\i0}
Dialogue: 0,0:04:21.83,0:04:23.36,Default,,0,0,0,,{\i1}Misaki-kun'a geliyor.{\i0}
Dialogue: 0,0:04:23.85,0:04:25.74,Default,,0,0,0,,{\i1}Henüz kaybedemeyiz!{\i0}
Dialogue: 0,0:04:27.16,0:04:31.91,Default,,0,0,0,,{\i1}Herkesle birlikte son maçım\Nolması için daha çok erken!{\i0}
Dialogue: 0,0:04:31.91,0:04:33.04,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:04:33.04,0:04:38.08,Default,,0,0,0,,{\i1}Beklenildiği gibi son saniyeye kadar pes etmeyi\Nreddeden Nankatsu'nun ikinci anahtar oyuncusu...{\i0}
Dialogue: 0,0:04:38.08,0:04:40.00,Default,,0,0,0,,{\i1}...Misaki-kun oluyor!{\i0}
Dialogue: 0,0:04:40.00,0:04:44.01,Default,,0,0,0,,Durdurun onu! Top sürüşünü\Ntüm gücünüzü kullanarak durdurun!
Dialogue: 0,0:04:44.01,0:04:46.51,Default,,0,0,0,,Bunu başarırsanız zafer bizim olur!
Dialogue: 0,0:04:46.51,0:04:47.92,Default,,0,0,0,,Tamamdır, durduralım!
Dialogue: 0,0:04:47.92,0:04:49.76,Default,,0,0,0,,Daha fazla ilerlemesine izin veremeyiz!
Dialogue: 0,0:04:49.76,0:04:50.90,Default,,0,0,0,,{\i1}Olamaz.{\i0}
Dialogue: 0,0:04:50.90,0:04:54.64,Default,,0,0,0,,{\i1}Kalanlar peşimden gelse bile\NTsubasa-kun hala markajda.{\i0}
Dialogue: 0,0:04:55.30,0:04:57.52,Default,,0,0,0,,{\i1}Buraya kadar mıydı her şey?{\i0}
Dialogue: 0,0:04:57.52,0:05:00.27,Default,,0,0,0,,Misaki! Tüm gücünle şut çek!
Dialogue: 0,0:05:00.78,0:05:01.94,Default,,0,0,0,,{\i1}Wakabayashi-kun!{\i0}
Dialogue: 0,0:05:01.94,0:05:03.26,Default,,0,0,0,,Aynen öyle Misaki-kun!
Dialogue: 0,0:05:03.26,0:05:04.94,Default,,0,0,0,,Bana pas vermen imkansız.
Dialogue: 0,0:05:04.94,0:05:06.65,Default,,0,0,0,,Şut çek!
Dialogue: 0,0:05:07.82,0:05:10.83,Default,,0,0,0,,Tamamdır! Ya hep ya hiç!
Dialogue: 0,0:05:10.83,0:05:13.12,Default,,0,0,0,,Ben burayı bir şekilde tutarım!
Dialogue: 0,0:05:13.12,0:05:14.84,Default,,0,0,0,,Kaleci, sağ tarafa atla!
Dialogue: 0,0:05:14.84,0:05:15.45,Default,,0,0,0,,Tamam!
Dialogue: 0,0:05:15.45,0:05:19.00,Default,,0,0,0,,{\i1}Misaki-kun kaleyi hedef alarak\Ntüm gücüyle vuruyor!{\i0}
Dialogue: 0,0:05:20.80,0:05:22.75,Default,,0,0,0,,{\i1}E-Engelledi!{\i0}
Dialogue: 0,0:05:23.26,0:05:26.63,Default,,0,0,0,,{\i1}Musashi'nin kazandığının belirlendiği an mı bu?!{\i0}
Dialogue: 0,0:05:26.63,0:05:29.84,Default,,0,0,0,,{\i1}Daha değil! Henüz hakem düdük çalmadı!{\i0}
Dialogue: 0,0:05:29.84,0:05:33.56,Default,,0,0,0,,{\i1}Maçta son ana dek\Nvazgeçmemi nasıl beklersiniz?!{\i0}
Dialogue: 0,0:05:33.56,0:05:34.56,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:05:35.56,0:05:37.33,Default,,0,0,0,,{\i1}Nankatsu tekrardan topu alıyor!{\i0}
Dialogue: 0,0:05:37.33,0:05:40.10,Default,,0,0,0,,{\i1}Nankatsu'nun son şansı hala kaçmadı!{\i0}
Dialogue: 0,0:05:40.10,0:05:44.11,Default,,0,0,0,,Tsubasa-kun dar açılardan\Nşut çekebilecek birisi!
Dialogue: 0,0:05:44.11,0:05:46.28,Default,,0,0,0,,Tüm şut yollarını kapatın!
Dialogue: 0,0:05:46.28,0:05:46.86,Default,,0,0,0,,Tamam!
Dialogue: 0,0:05:46.86,0:05:47.78,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:05:47.78,0:05:51.53,Default,,0,0,0,,{\i1}Tsubasa-kun bu şekilde şut çekemez!{\i0}
Dialogue: 0,0:05:51.53,0:05:56.10,Default,,0,0,0,,{\i1}Etrafı tamamen sarılmışken\NTsubasa-kun pas bile atamaz.{\i0}
Dialogue: 0,0:05:56.10,0:05:57.46,Default,,0,0,0,,{\i1}Vakit de kalmadı ayrıca!{\i0}
Dialogue: 0,0:05:58.79,0:05:59.54,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:05:59.54,0:06:00.54,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:06:00.54,0:06:01.13,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:06:01.13,0:06:02.04,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:06:02.04,0:06:04.42,Default,,0,0,0,,Topu oradan çıkarmasına izin vermeyin!
Dialogue: 0,0:06:04.42,0:06:06.24,Default,,0,0,0,,{\i1}Pes edemem.{\i0}
Dialogue: 0,0:06:06.24,0:06:08.13,Default,,0,0,0,,{\i1}Bitti demek için çok erken.{\i0}
Dialogue: 0,0:06:08.13,0:06:10.76,Default,,0,0,0,,{\i1}Bir şans olması gerek.{\i0}
Dialogue: 0,0:06:10.76,0:06:12.64,Default,,0,0,0,,{\i1}Bir şekilde olmalı...{\i0}
Dialogue: 0,0:06:12.64,0:06:13.90,Default,,0,0,0,,{\i1}Eminim!{\i0}
Dialogue: 0,0:06:16.93,0:06:19.44,Default,,0,0,0,,Bu kafesten tek bir çıkış var.
Dialogue: 0,0:06:20.06,0:06:21.58,Default,,0,0,0,,O da burası!
Dialogue: 0,0:06:21.58,0:06:22.24,Default,,0,0,0,,Ne?!
Dialogue: 0,0:06:22.24,0:06:26.78,Default,,0,0,0,,{\i1}Tsubasa-kun topu havalandırıyor!{\i0}
Dialogue: 0,0:06:28.74,0:06:30.45,Default,,0,0,0,,{\i1}Tsubasa-kun topla birlikte zıplıyor.{\i0}
Dialogue: 0,0:06:35.87,0:06:37.26,Default,,0,0,0,,{\i1}İşte!{\i0}
Dialogue: 0,0:06:37.26,0:06:41.71,Default,,0,0,0,,{\i1}Tsubasa-kun maçın son anlarında\Nrövaşata vuruş yapıyor!{\i0}
Dialogue: 0,0:06:41.71,0:06:43.96,Default,,0,0,0,,T-Tsubasa-kun!
Dialogue: 0,0:06:44.60,0:06:46.26,Default,,0,0,0,,{\i1}Tsubasa-kun'dan da bu beklenirdi.{\i0}
Dialogue: 0,0:06:46.26,0:06:48.71,Default,,0,0,0,,{\i1}Köşeye sıkıştığında bile harika bir oyuncusun.{\i0}
Dialogue: 0,0:06:48.71,0:06:51.97,Default,,0,0,0,,{\i1}Ama şut çekilecek bir açı değil bu.{\i0}
Dialogue: 0,0:06:51.97,0:06:54.18,Default,,0,0,0,,{\i1}Çok dar.{\i0}
Dialogue: 0,0:06:54.18,0:06:56.81,Default,,0,0,0,,{\i1}Kazanan Musashi olacak gerçekten.{\i0}
Dialogue: 0,0:07:01.64,0:07:02.77,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:07:02.77,0:07:03.40,Default,,0,0,0,,Başardık!
Dialogue: 0,0:07:03.40,0:07:08.40,Default,,0,0,0,,{\i1}Misaki-kun topa birlikte kaleye giriyor!\NNe harika bir kafa vuruşu yaptı bu çocuk!{\i0}
Dialogue: 0,0:07:08.40,0:07:09.68,Default,,0,0,0,,{\i1}Beraberlik!{\i0}
Dialogue: 0,0:07:09.68,0:07:14.49,Default,,0,0,0,,{\i1}Nankatsu son anda 4-4\Nberaberliği sağlıyor!{\i0}
Dialogue: 0,0:07:14.49,0:07:17.19,Default,,0,0,0,,Başardım!
Dialogue: 0,0:07:17.19,0:07:18.98,Default,,0,0,0,,{\i1}Misaki-kun çok mutlu olmalı.{\i0}
Dialogue: 0,0:07:18.98,0:07:23.36,Default,,0,0,0,,{\i1}Kaybetmek üzerelerken\Nharika bir gol attı.{\i0}
Dialogue: 0,0:07:23.36,0:07:25.90,Default,,0,0,0,,Misaki-kun, teşekkürler.
Dialogue: 0,0:07:25.90,0:07:27.67,Default,,0,0,0,,Çok güzel attın gerçekten.
Dialogue: 0,0:07:27.67,0:07:28.98,Default,,0,0,0,,Başardık! Başardık!
Dialogue: 0,0:07:28.98,0:07:30.42,Default,,0,0,0,,Başardın Misaki!
Dialogue: 0,0:07:31.30,0:07:32.80,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:07:32.80,0:07:34.80,Default,,0,0,0,,Tsubasa... Misaki...
Dialogue: 0,0:07:34.80,0:07:36.30,Default,,0,0,0,,Beraberlik!
Dialogue: 0,0:07:36.30,0:07:37.89,Default,,0,0,0,,Harikasın Misaki!
Dialogue: 0,0:07:37.89,0:07:39.56,Default,,0,0,0,,En büyük Nankatsu!
Dialogue: 0,0:07:40.57,0:07:41.60,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:41.60,0:07:44.06,Default,,0,0,0,,Zafere bir adım uzaklıktaydık.
Dialogue: 0,0:07:44.92,0:07:48.77,Default,,0,0,0,,{\i1}Gerçekten de asıl anahtar\Noyuncu Misaki-kun'muş.{\i0}
Dialogue: 0,0:07:48.77,0:07:52.93,Default,,0,0,0,,{\i1}Ve Tsubasa-kun'un o attığı son rövaşata...{\i0}
Dialogue: 0,0:07:52.93,0:07:56.03,Default,,0,0,0,,{\i1}...şuttan ziyade pastı.{\i0}
Dialogue: 0,0:07:56.92,0:08:00.39,Default,,0,0,0,,{\i1}Son anda oyunu okumada\Nkonusunda hata yaptım.{\i0}
Dialogue: 0,0:08:00.39,0:08:03.32,Default,,0,0,0,,{\i1}Hala çok toyum.{\i0}
Dialogue: 0,0:08:03.32,0:08:06.08,Default,,0,0,0,,{\i1}Futbol çok zor gerçekten.{\i0}
Dialogue: 0,0:08:06.08,0:08:11.43,Default,,0,0,0,,{\i1}Saatte süre kalmadı ve\Nuzatma dakikalara girdik.{\i0}
Dialogue: 0,0:08:11.43,0:08:13.43,Default,,0,0,0,,{\i1}Musashi'nin top vuruşuyla maç devam edecek.{\i0}
Dialogue: 0,0:08:16.97,0:08:18.22,Default,,0,0,0,,{\i1}Berabere mi bitecek?{\i0}
Dialogue: 0,0:08:18.22,0:08:20.47,Default,,0,0,0,,{\i1}Penaltı mı çekişeceğiz?{\i0}
Dialogue: 0,0:08:20.47,0:08:21.45,Default,,0,0,0,,{\i1}Daha değil!{\i0}
Dialogue: 0,0:08:21.45,0:08:24.10,Default,,0,0,0,,{\i1}Maç henüz bittiğini düşünmeyin!{\i0}
Dialogue: 0,0:08:24.10,0:08:27.90,Default,,0,0,0,,{\i1}Hakem düdüğünü çalana dek,\Nson ana dek...{\i0}
Dialogue: 0,0:08:27.90,0:08:29.65,Default,,0,0,0,,{\i1}...her şeyimi ortaya koyacağım!{\i0}
Dialogue: 0,0:08:29.65,0:08:30.90,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:08:30.90,0:08:34.15,Default,,0,0,0,,{\i1}Tsubasa-kun henüz maçtan vazgeçmedi!{\i0}
Dialogue: 0,0:08:34.15,0:08:36.74,Default,,0,0,0,,Tsubasa-kun, sen...
Dialogue: 0,0:08:36.74,0:08:39.49,Default,,0,0,0,,{\i1}Bu, Misugi-kun'un oynadığı son maç.{\i0}
Dialogue: 0,0:08:39.49,0:08:43.05,Default,,0,0,0,,{\i1}Misugi-kun, kalp rahatsızlığı\Nile geride olmasına rağmen...{\i0}
Dialogue: 0,0:08:43.05,0:08:45.62,Default,,0,0,0,,{\i1}...kendi sınırlarını zorladı.{\i0}
Dialogue: 0,0:08:45.62,0:08:52.13,Default,,0,0,0,,{\i1}Misugi-kun'a cevap olarak bu maçın\Nbir saniyesini bile israf edemem!{\i0}
Dialogue: 0,0:08:52.13,0:08:55.13,Default,,0,0,0,,Kaptan! Şut çekecek!
Dialogue: 0,0:08:56.10,0:08:56.94,Default,,0,0,0,,{\i1}Durduracağım!{\i0}
Dialogue: 0,0:08:56.94,0:08:59.14,Default,,0,0,0,,{\i1}Bu şutu ben durduracağım!{\i0}
Dialogue: 0,0:08:59.14,0:09:00.89,Default,,0,0,0,,Gidelim Misugi-kun!
Dialogue: 0,0:09:07.98,0:09:11.44,Default,,0,0,0,,{\i1}Tsubasa-kun çok uzaktan şut çekiyor!{\i0}
Dialogue: 0,0:09:13.05,0:09:16.90,Default,,0,0,0,,Git! Bu ıslak zeminde top,\Nher zaman olduğundan daha hızlı gider!
Dialogue: 0,0:09:16.90,0:09:19.78,Default,,0,0,0,,Kaleci için tutması en zor şutlardandır!
Dialogue: 0,0:09:19.78,0:09:22.33,Default,,0,0,0,,{\i1}Tazawa-kun yetişemiyor!{\i0}
Dialogue: 0,0:09:22.33,0:09:24.50,Default,,0,0,0,,{\i1}Ama Misugi-kun geliyor!{\i0}
Dialogue: 0,0:09:27.23,0:09:29.75,Default,,0,0,0,,{\i1}Misugi-kun bir an gecikiyor!{\i0}
Dialogue: 0,0:09:29.75,0:09:31.75,Default,,0,0,0,,{\i1}Ve aynı anda hakem düdüğünü çalıyor.{\i0}
Dialogue: 0,0:09:32.22,0:09:33.79,Default,,0,0,0,,{\i1}Ne oldu acaba?{\i0}
Dialogue: 0,0:09:33.79,0:09:37.17,Default,,0,0,0,,{\i1}Gol mü yoksa maçın sonu mu?{\i0}
Dialogue: 0,0:09:54.82,0:09:56.90,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:09:56.90,0:09:59.11,Default,,0,0,0,,{\i1}Maç, golle birlikte bitiyor!{\i0}
Dialogue: 0,0:09:59.80,0:10:04.87,Default,,0,0,0,,{\i1}Shizuoka temsilcisi\NNankatsu SC, 5-4 kazanıyor!{\i0}
Dialogue: 0,0:10:04.87,0:10:06.69,Default,,0,0,0,,{\i1}Bu bir mucize!{\i0}
Dialogue: 0,0:10:06.69,0:10:09.42,Default,,0,0,0,,{\i1}Son ana kadar böyle bir\Ngeri dönüş yapacakları beklenemezdi!{\i0}
Dialogue: 0,0:10:09.42,0:10:15.05,Default,,0,0,0,,{\i1}Tsubasa-kun'un pes etmeyen azimli\Niradesi sayesinde mucize gerçekleşti!{\i0}
Dialogue: 0,0:10:16.02,0:10:18.23,Default,,0,0,0,,Kazandım...
Dialogue: 0,0:10:18.23,0:10:19.86,Default,,0,0,0,,Kazandım mı?
Dialogue: 0,0:10:19.86,0:10:22.30,Default,,0,0,0,,Başardın! Başardın Tsubasa!
Dialogue: 0,0:10:28.02,0:10:29.57,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:10:32.02,0:10:34.13,Default,,0,0,0,,İyiyim menajer.
Dialogue: 0,0:10:34.94,0:10:36.19,Default,,0,0,0,,Misugi-kun!
Dialogue: 0,0:10:37.19,0:10:39.87,Default,,0,0,0,,Tebrik ederim Tsubasa-kun.
Dialogue: 0,0:10:39.87,0:10:41.95,Default,,0,0,0,,Gerçekten harikaydın.
Dialogue: 0,0:10:41.95,0:10:44.95,Default,,0,0,0,,Mücadelemizi sen kazandın.
Dialogue: 0,0:10:44.95,0:10:47.70,Default,,0,0,0,,Bu doğru değil Misugi-kun.
Dialogue: 0,0:10:47.70,0:10:53.33,Default,,0,0,0,,Bedeninde sorun sebepli engelin\Nolmasa son şutumu kesinlikle durdururdun...
Dialogue: 0,0:10:53.33,0:10:56.89,Default,,0,0,0,,...ve bu maçı kazanan Musashi olurdu.
Dialogue: 0,0:10:56.89,0:10:59.00,Default,,0,0,0,,Teşekkürler Tsubasa-kun.
Dialogue: 0,0:10:59.00,0:11:00.90,Default,,0,0,0,,Ama sorun değil.
Dialogue: 0,0:11:01.91,0:11:05.35,Default,,0,0,0,,Tüm kalbimle tatmin oldum.
Dialogue: 0,0:11:05.35,0:11:07.10,Default,,0,0,0,,Misugi-kun...
Dialogue: 0,0:11:07.10,0:11:10.80,Default,,0,0,0,,Her zaman maçlarda\Nbirkaç dakikalığına oynamıştım.
Dialogue: 0,0:11:10.80,0:11:15.86,Default,,0,0,0,,Ama senin rakibim olman sayesinde\Nbugün tüm süre boyunca oynayabildim.
Dialogue: 0,0:11:15.86,0:11:22.62,Default,,0,0,0,,Son ana dek seninle böyle harika bir\Nmaç yapmak, seninle mücadele etmeye oranla...
Dialogue: 0,0:11:22.62,0:11:24.87,Default,,0,0,0,,...çok mutlu etti beni.
Dialogue: 0,0:11:25.47,0:11:27.87,Default,,0,0,0,,Teşekkürler Tsubasa-kun.
Dialogue: 0,0:11:27.87,0:11:29.87,Default,,0,0,0,,Teşekkürler millet.
Dialogue: 0,0:11:29.87,0:11:30.90,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:11:30.90,0:11:32.37,Default,,0,0,0,,Misugi-san...
Dialogue: 0,0:11:32.37,0:11:37.00,Default,,0,0,0,,Menajer, özür dilerim ama\Nomzunu biraz ödünç alabilir miyim?
Dialogue: 0,0:11:37.00,0:11:43.13,Default,,0,0,0,,Bugünkü maç, sen olmasan\Nbu kadar harika olmazdı.
Dialogue: 0,0:11:44.22,0:11:45.64,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:11:45.64,0:11:48.44,Default,,0,0,0,,Şimdiye kadar yaptıkların için teşekkürler.
Dialogue: 0,0:11:48.44,0:11:52.56,Default,,0,0,0,,Musashi FC menajeri olarak\Nson görevin bu.
Dialogue: 0,0:11:52.56,0:11:54.82,Default,,0,0,0,,Lütfen yedek kulübesine kadar\Nbana yardımcı ol.
Dialogue: 0,0:11:56.08,0:11:57.55,Default,,0,0,0,,Tamam!
Dialogue: 0,0:11:58.73,0:12:00.19,Default,,0,0,0,,Misugi-san...
Dialogue: 0,0:12:00.19,0:12:03.28,Default,,0,0,0,,Hayatım, Jun çok iyi bir iş çıkardı.
Dialogue: 0,0:12:03.28,0:12:05.06,Default,,0,0,0,,Gerçekten çok iyi bir iş çıkardı.
Dialogue: 0,0:12:05.06,0:12:06.70,Default,,0,0,0,,E-Evet.
Dialogue: 0,0:12:08.90,0:12:09.95,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:12:10.95,0:12:13.96,Default,,0,0,0,,Sonuç olarak futbol oynamayı bırakmayacağım.
Dialogue: 0,0:12:16.21,0:12:19.64,Default,,0,0,0,,1-2 dakika oynayabilsem bile...
Dialogue: 0,0:12:19.64,0:12:22.38,Default,,0,0,0,,...saha üzerinde duracağım kesinlikle.
Dialogue: 0,0:12:22.38,0:12:26.34,Default,,0,0,0,,Ve bir gün kalbimin bu durumunu yeneceğim.
Dialogue: 0,0:12:26.34,0:12:28.34,Default,,0,0,0,,Misugi-kun...
Dialogue: 0,0:12:38.36,0:12:43.09,Default,,0,0,0,,{\fad(500,500)}# Nankatsu SC: 5\NMusashi FC: 4 #
Dialogue: 0,0:12:56.42,0:13:01.30,Default,,0,0,0,,Kaptan, bugün Tsubasa-kun'un\Nfinal maçı günü, değil mi?
Dialogue: 0,0:13:01.30,0:13:05.30,Default,,0,0,0,,Evet. Japonya'dan izleyemem\Nçok yazık gerçekten.
Dialogue: 0,0:13:05.30,0:13:07.80,Default,,0,0,0,,Biz de onu tutuyoruz.
Dialogue: 0,0:13:07.80,0:13:10.55,Default,,0,0,0,,Lütfen maç başlayınca buradan izleyin.
Dialogue: 0,0:13:10.55,0:13:13.20,Default,,0,0,0,,Kalanını bize bırakın lütfen.
Dialogue: 0,0:13:13.20,0:13:14.91,Default,,0,0,0,,Olmaz ki öyle.
Dialogue: 0,0:13:16.72,0:13:19.31,Default,,0,0,0,,{\i1}Elinden geleni yap Tsubasa.{\i0}
Dialogue: 0,0:13:26.94,0:13:29.03,Default,,0,0,0,,Ne gecikti be bu amca.
Dialogue: 0,0:13:29.03,0:13:32.20,Default,,0,0,0,,Gerçekten ya. Ne yapıyor ki yani?
Dialogue: 0,0:13:33.20,0:13:34.39,Default,,0,0,0,,Ne?
Dialogue: 0,0:13:36.56,0:13:38.28,Default,,0,0,0,,Geldiler!
Dialogue: 0,0:13:38.28,0:13:39.38,Default,,0,0,0,,Gerçekten de öyle!
Dialogue: 0,0:13:39.38,0:13:41.88,Default,,0,0,0,,# Kesin Zafer! Nankatsu #
Dialogue: 0,0:13:41.88,0:13:43.63,Default,,0,0,0,,Harika!
Dialogue: 0,0:13:47.13,0:13:49.26,Default,,0,0,0,,Beklettiğim için üzgünüm.
Dialogue: 0,0:13:49.26,0:13:50.64,Default,,0,0,0,,Herkes atlasın.
Dialogue: 0,0:13:52.50,0:13:55.32,Default,,0,0,0,,Amca, her gün gelip\Nbizi götürdüğün için teşekkürler.
Dialogue: 0,0:13:55.32,0:13:58.14,Default,,0,0,0,,Ne? Zaten aynı saatte işim var.
Dialogue: 0,0:13:58.14,0:14:00.98,Default,,0,0,0,,Ama Nankatsu cidden çok güçlü ha.
Dialogue: 0,0:14:00.98,0:14:03.40,Default,,0,0,0,,Desteklenmeye değerler.
Dialogue: 0,0:14:03.40,0:14:06.11,Default,,0,0,0,,Tsubasa-kun oynadığı için tabii!
Dialogue: 0,0:14:06.11,0:14:08.20,Default,,0,0,0,,Evet, evet. Tsubasa-kun değil mi?
Dialogue: 0,0:14:08.20,0:14:10.36,Default,,0,0,0,,Erkek arkadaşın sanırım.
Dialogue: 0,0:14:10.36,0:14:10.93,Default,,0,0,0,,Ne?
Dialogue: 0,0:14:10.93,0:14:13.49,Default,,0,0,0,,Ne diyorsun be amca?
Dialogue: 0,0:14:13.49,0:14:16.33,Default,,0,0,0,,Hey! Araç kullanıyorken vurmasana bana!
Dialogue: 0,0:14:16.84,0:14:19.58,Default,,0,0,0,,Millet, bugüne kadar iyi iş çıkardınız.
Dialogue: 0,0:14:20.24,0:14:23.92,Default,,0,0,0,,Bu süreçte çok şey yaşadık.
Dialogue: 0,0:14:23.92,0:14:26.46,Default,,0,0,0,,Nishio yaralandığı için aramızdan ayrıldı.
Dialogue: 0,0:14:26.46,0:14:28.92,Default,,0,0,0,,Endişelendirdiğim için üzgünüm çocuklar.
Dialogue: 0,0:14:28.92,0:14:32.14,Default,,0,0,0,,Onun yerini doldurma konusunda\Nçok çabaladın Ishizaki.
Dialogue: 0,0:14:33.64,0:14:41.03,Default,,0,0,0,,Boşluk demişken Wakabayashi yerine\Ngeçen Morisaki harika işler çıkardı.
Dialogue: 0,0:14:41.03,0:14:42.02,Default,,0,0,0,,Teşekkürler.
Dialogue: 0,0:14:42.02,0:14:46.18,Default,,0,0,0,,Bugün Nankatsu'nun kalesini\Nkoruyacak kişi Wakabayashi olacak.
Dialogue: 0,0:14:46.18,0:14:48.03,Default,,0,0,0,,Teşekkürler Morisaki.
Dialogue: 0,0:14:48.03,0:14:50.53,Default,,0,0,0,,Asıl ben teşekkür ederim Wakabayashi-san.
Dialogue: 0,0:14:50.53,0:14:55.28,Default,,0,0,0,,Şimdiye kadar koruduğun Nankatsu kalesine\NMeiwa'nın bir gol atmasına bile izin vermeyeceğim.
Dialogue: 0,0:14:56.54,0:15:00.63,Default,,0,0,0,,Ama Wakabayashi'nin\Nbacağında bir aksilik olursa...
Dialogue: 0,0:15:00.63,0:15:02.86,Default,,0,0,0,,...hemen girmen gerekecek Morisaki.
Dialogue: 0,0:15:02.86,0:15:05.70,Default,,0,0,0,,Tamam. Hazırlıklarımı bitirdim.
Dialogue: 0,0:15:05.70,0:15:08.05,Default,,0,0,0,,Ve kaptanımız Tsubasa.
Dialogue: 0,0:15:08.05,0:15:09.17,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:09.17,0:15:12.89,Default,,0,0,0,,Buraya kadar takıma\Nharika liderlik ettin.
Dialogue: 0,0:15:12.89,0:15:20.62,Default,,0,0,0,,Kalanının da öyle. Her biriniz\Ngerçekten her şeyinizi ortaya koydunuz.
Dialogue: 0,0:15:20.62,0:15:26.11,Default,,0,0,0,,Ama bu birlikte oynayacağınız son maç olacak.
Dialogue: 0,0:15:26.11,0:15:30.47,Default,,0,0,0,,Misaki bu maçtan sonra\Nyine başka bir yere taşınacak.
Dialogue: 0,0:15:31.36,0:15:37.33,Default,,0,0,0,,Ve Tsubasa şampiyon olursa\NBrezilya'ya gidecek gibi görünüyor.
Dialogue: 0,0:15:37.33,0:15:38.70,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:38.70,0:15:40.90,Default,,0,0,0,,Dinleyin çocuklar.
Dialogue: 0,0:15:40.90,0:15:46.14,Default,,0,0,0,,Finallerde her şeyinizi ortaya koyup\Nmücadele edin ki sonradan pişman olmayın!
Dialogue: 0,0:15:46.14,0:15:47.09,Default,,0,0,0,,Evet!
Dialogue: 0,0:15:54.62,0:15:59.66,Default,,0,0,0,,{\i1}Ulusal Futbol Turnuvası büyük finali.\NBuraya kadar gelmeyi başaranlar...{\i0}
Dialogue: 0,0:15:59.66,0:16:05.52,Default,,0,0,0,,{\i1}...Saitama temsilcisi Meiwa FC ve\NShizuoka temsilcisi Nankatsu SC.{\i0}
Dialogue: 0,0:16:05.52,0:16:08.52,Default,,0,0,0,,{\i1}Bu yılki ilkokul öğrencileri çok tutkulu.{\i0}
Dialogue: 0,0:16:08.52,0:16:13.53,Default,,0,0,0,,{\i1}Stadyum, maçı izlemek isteyen\Nseyircilerle dolup taşıyor!{\i0}
Dialogue: 0,0:16:23.54,0:16:27.08,Default,,0,0,0,,{\i1}İlk olarak Nankatsu SC\Noyuncuları sahaya çıkıyor.{\i0}
Dialogue: 0,0:16:27.08,0:16:29.99,Default,,0,0,0,,Nankatsu! Bastır!
Dialogue: 0,0:16:29.99,0:16:30.92,Default,,0,0,0,,Evet!
Dialogue: 0,0:16:30.92,0:16:32.76,Default,,0,0,0,,Millet, elinizden geleni yapın!
Dialogue: 0,0:16:32.76,0:16:34.43,Default,,0,0,0,,Kesinlikle kazanın!
Dialogue: 0,0:16:34.43,0:16:36.50,Default,,0,0,0,,Bunlar annemler!
Dialogue: 0,0:16:36.50,0:16:37.55,Default,,0,0,0,,Baba!
Dialogue: 0,0:16:37.55,0:16:41.43,Default,,0,0,0,,Lan Ryo! Bugün gelmek için hamamı kapattım!
Dialogue: 0,0:16:41.43,0:16:44.81,Default,,0,0,0,,Sakın hata yapıp başkalarına yük olma!
Dialogue: 0,0:16:44.81,0:16:50.55,Default,,0,0,0,,Hadi ama... Tezahürat yapacaksan\Ndaha iyi bir şeyler bulamadın mı?
Dialogue: 0,0:16:51.32,0:16:53.82,Default,,0,0,0,,{\i1}B-Baba...{\i0}
Dialogue: 0,0:16:53.82,0:16:59.33,Default,,0,0,0,,{\i1}Herkesle birlikte son maçın bu.\NElinden geleni yap Taro.{\i0}
Dialogue: 0,0:16:59.33,0:17:03.33,Default,,0,0,0,,Babam gelmiş! Babam!
Dialogue: 0,0:17:07.33,0:17:08.83,Default,,0,0,0,,Roberto!
Dialogue: 0,0:17:09.36,0:17:12.34,Default,,0,0,0,,{\i1}Sonunda finallere ulaştın.{\i0}
Dialogue: 0,0:17:12.34,0:17:14.82,Default,,0,0,0,,{\i1}Kazanacağım Roberto.{\i0}
Dialogue: 0,0:17:14.82,0:17:17.64,Default,,0,0,0,,{\i1}Kazanacağım ve birlikte\NBrezilya'ya gideceğiz.{\i0}
Dialogue: 0,0:17:19.44,0:17:22.40,Default,,0,0,0,,{\i1}Nankatsu hemen vuruş\Nısınmalarına başladı ama...{\i0}
Dialogue: 0,0:17:22.40,0:17:23.81,Default,,0,0,0,,{\i1}...bir şey mi oldu acaba?{\i0}
Dialogue: 0,0:17:24.50,0:17:28.60,Default,,0,0,0,,{\i1}Meiwa oyuncuları henüz sahaya çıkmadı.{\i0}
Dialogue: 0,0:17:28.60,0:17:30.24,Default,,0,0,0,,{\i1}Geciktiler.{\i0}
Dialogue: 0,0:17:30.24,0:17:31.11,Default,,0,0,0,,{\i1}Yoksa...{\i0}
Dialogue: 0,0:17:34.07,0:17:37.25,Default,,0,0,0,,{\i1}Hyuga-kun dünkü maç yüzünden...{\i0}
Dialogue: 0,0:17:41.16,0:17:42.74,Default,,0,0,0,,Ne?!
Dialogue: 0,0:17:47.55,0:17:49.08,Default,,0,0,0,,{\i1}Geldiler!{\i0}
Dialogue: 0,0:17:49.08,0:17:51.25,Default,,0,0,0,,{\i1}Meiwa FC burada!{\i0}
