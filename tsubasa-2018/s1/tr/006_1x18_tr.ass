Dialogue: 0,0:12:51.00,0:12:56.22,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:01.95,0:00:03.95,Default,,0,0,0,,{\i1}Sonunda başlıyor demek.{\i0}
Dialogue: 0,0:00:03.95,0:00:08.52,Default,,0,0,0,,{\i1}Grup aşamalarının aksine şimdi\Ntam bir nakavt turnuvası gerçekleşecek.{\i0}
Dialogue: 0,0:00:08.52,0:00:11.33,Default,,0,0,0,,{\i1}Bir kez kaybedersen her şey biter.{\i0}
Dialogue: 0,0:00:11.33,0:00:13.42,Default,,0,0,0,,{\i1}Her maç belirleyici.{\i0}
Dialogue: 0,0:00:14.36,0:00:17.06,Default,,0,0,0,,{\i1}Ve hiçbir takım da zayıf değil.{\i0}
Dialogue: 0,0:00:17.06,0:00:19.03,Default,,0,0,0,,{\i1}Tüm maçlar zorlu olacak.{\i0}
Dialogue: 0,0:00:21.51,0:00:23.64,Default,,0,0,0,,Alo Wakabayashi-kun?{lovers skype call}
Dialogue: 0,0:00:23.64,0:00:24.71,Default,,0,0,0,,Selam Tsubasa.
Dialogue: 0,0:00:24.71,0:00:29.84,Default,,0,0,0,,İlk olarak söz verdiğin gibi\Ngruplardan çıktığın için teşekkür ederim.
Dialogue: 0,0:00:29.84,0:00:31.92,Default,,0,0,0,,Siz de iyi iş çıkardınız çocuklar.
Dialogue: 0,0:00:31.92,0:00:32.84,Default,,0,0,0,,Evet!
Dialogue: 0,0:00:32.84,0:00:36.00,Default,,0,0,0,,Wakabayashi-kun, yaranın durumu nasıl?
Dialogue: 0,0:00:36.00,0:00:41.81,Default,,0,0,0,,Büyük ölçüde iyileşti ama görünüşe\Ngöre sadece bir maçta oynayabileceğim.
Dialogue: 0,0:00:41.81,0:00:43.06,Default,,0,0,0,,Bir maç mı?!
Dialogue: 0,0:00:43.06,0:00:47.56,Default,,0,0,0,,Evet. Bir maç oynayacaksam\Nbu elbette...
Dialogue: 0,0:00:47.56,0:00:48.90,Default,,0,0,0,,Finaller değil mi?
Dialogue: 0,0:00:48.90,0:00:53.78,Default,,0,0,0,,Hep birlikte finallere kadar\Ngidebileceğinize inanıyorum.
Dialogue: 0,0:00:53.78,0:00:55.57,Default,,0,0,0,,Tamam, anladım.
Dialogue: 0,0:00:55.57,0:01:00.36,Default,,0,0,0,,Dün hep birlikte bu turnuvayı\Nkazanacağımıza da söz verdik.
Dialogue: 0,0:01:00.36,0:01:01.28,Default,,0,0,0,,Evet!
Dialogue: 0,0:01:01.28,0:01:04.54,Default,,0,0,0,,Bu yüzden finallerde sana\Ngüveniyor olacağız Wakabayashi-kun.
Dialogue: 0,0:01:04.54,0:01:06.64,Default,,0,0,0,,Tamam. Görüşürüz.
Dialogue: 0,0:01:07.52,0:01:09.92,Default,,0,0,0,,Genzo, ne olursa olsun gidecek misin?
Dialogue: 0,0:01:10.67,0:01:11.50,Default,,0,0,0,,Evet.
Dialogue: 0,0:02:43.30,0:02:47.56,Default,,0,0,0,,{\pos(276,822)}Bölüm 18:\Nİşte Finaller
Dialogue: 0,0:02:43.30,0:02:47.56,Default,,0,0,0,,{\pos(1540,1026)}Çeviri: ARE-YOU-SURE\N{\fs65}AreyousureSubs Sunar
Dialogue: 0,0:02:44.18,0:02:46.62,Default-Top,,0,0,0,,{\i1}Elemelerin ilk günü.{\i0}
Dialogue: 0,0:02:46.62,0:02:50.35,Default-Top,,0,0,0,,{\i1}Her güçlü rakip kendine\Nburada yer buldu.{\i0}
Dialogue: 0,0:02:50.35,0:02:54.91,Default,,0,0,0,,{\i1}Kuzey Hokkaido temsilcisi,\NKaptan Matsuyama liderliğinde...{\i0}
Dialogue: 0,0:02:54.91,0:02:58.53,Default,,0,0,0,,{\i1}...Furano İlkokulu, ilk çıkan\Ntakım olmuştu.{\i0}
Dialogue: 0,0:02:59.53,0:03:06.20,Default,,0,0,0,,{\i1}Tokyo temsilcisi Musashi FC'nin yıldızı\NMisugi yedek kulübesinde beklerken çıkmıştı.{\i0}
Dialogue: 0,0:03:07.20,0:03:10.00,Default,,0,0,0,,{\i1}Saitama temsilcisi Meiwa FC...{\i0}
Dialogue: 0,0:03:10.00,0:03:14.88,Default,,0,0,0,,{\i1}...Hyuga Kojiro tarafından\Nilk yarıda hat trick yapmıştı.{\i0}
Dialogue: 0,0:03:15.86,0:03:24.95,Default,,0,0,0,,{\i1}Tsubasa'nın gol krallığını unvanını almasıyla takımının\Nşampiyonluk konusunda ne kadar iddialı göstermişti.{\i0}
Dialogue: 0,0:03:24.95,0:03:27.50,Default,,0,0,0,,{\i1}Ama 3. maçlarında...{\i0}
Dialogue: 0,0:03:27.50,0:03:33.19,Default,,0,0,0,,{\i1}...Nankatsu SC, beklenmedik derecede\Nzorlu bir takıma denk gelmişti.{\i0}
Dialogue: 0,0:03:33.19,0:03:35.06,Default,,0,0,0,,Hadi Tsubasa!
Dialogue: 0,0:03:39.36,0:03:40.40,Default,,0,0,0,,Yine mi?
Dialogue: 0,0:03:40.40,0:03:44.78,Default,,0,0,0,,{\i1}Yine şutu durduruldu!{\i0}
Dialogue: 0,0:03:46.28,0:03:50.74,Default,,0,0,0,,{\i1}Nakanishi-kun, elemelerde bir gol bile yemedi!{\i0}
Dialogue: 0,0:03:50.74,0:03:53.54,Default,,0,0,0,,{\i1}Turnuvanın bir numaralı\Nkalecisi olarak görünüyor!{\i0}
Dialogue: 0,0:03:53.54,0:03:55.43,Default,,0,0,0,,Doğru mu bu Manabu?
Dialogue: 0,0:03:55.43,0:04:00.48,Default,,0,0,0,,Osaka temsilcisi Naniwa FC, gruplardaki\N5 maçında gol yemedi ve maç kaybetmedi.
Dialogue: 0,0:04:00.48,0:04:05.23,Default,,0,0,0,,İnanılmaz güçlü defanslarıyla güçlü\Nrakipleri yenen sürpriz bir takım.
Dialogue: 0,0:04:05.23,0:04:06.80,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:04:10.14,0:04:13.82,Default,,0,0,0,,Şimdiye kadar çok gol atmış olsan da...
Dialogue: 0,0:04:13.82,0:04:16.56,Default,,0,0,0,,...bugün hiç gol atmana izin vermeyeceğim!
Dialogue: 0,0:04:16.56,0:04:18.02,Default,,0,0,0,,Bak ne diyeceğim!
Dialogue: 0,0:04:18.02,0:04:22.44,Default,,0,0,0,,Ben bu sene, Wakabayashi'nin geçen\Nsene yaptığı gibi gol yememeyi hedefliyorum!
Dialogue: 0,0:04:22.44,0:04:23.78,Default,,0,0,0,,Ne?!{ghastly waka appears}
Dialogue: 0,0:04:23.78,0:04:25.49,Default,,0,0,0,,Gidin! İleri!
Dialogue: 0,0:04:26.04,0:04:28.16,Default,,0,0,0,,{\i1}Nakanishi-kun uzun bir top yolluyor!{\i0}
Dialogue: 0,0:04:28.60,0:04:31.54,Default,,0,0,0,,{\i1}Top yükseldikçe yükseliyor!{\i0}
Dialogue: 0,0:04:31.54,0:04:32.54,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:32.54,0:04:36.50,Default,,0,0,0,,{\i1}B-Bu da ne böyle?! Direkt\NNankatsu kalesine gidiyor!{\i0}
Dialogue: 0,0:04:37.21,0:04:40.88,Default,,0,0,0,,{\i1}Hazırlıksız yakalanan Nankatsu\Nkalesinin defansı boş!{\i0}
Dialogue: 0,0:04:40.88,0:04:43.09,Default,,0,0,0,,Tamamdır! İşte bu kadar!
Dialogue: 0,0:04:45.84,0:04:47.32,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:04:47.32,0:04:51.60,Default,,0,0,0,,{\i1}Naniwa'dan 11 numaralı\NMarui-kun kafa vuruşuyla gol atıyor!{\i0}
Dialogue: 0,0:04:52.52,0:04:55.48,Default,,0,0,0,,{\i1}Hızlı bir karşı ataktı!
Dialogue: 0,0:04:56.48,0:04:59.85,Default,,0,0,0,,{\i1}Nakanishi-kun da çok güçlü bir vuruş gerçekleştirdi.{\i0}
Dialogue: 0,0:04:59.85,0:05:03.48,Default,,0,0,0,,{\i1}Yetişkinlerle yarışacak derecede\Ngüçlü bir vuruştu.{\i0}
Dialogue: 0,0:05:03.48,0:05:06.46,Default,,0,0,0,,Lanet olsun! Ne canavarca bir güç!
Dialogue: 0,0:05:06.46,0:05:07.59,Default,,0,0,0,,Ama sadece bir gol!
Dialogue: 0,0:05:07.59,0:05:08.88,Default,,0,0,0,,Modumuzu düşürmeden devam!
Dialogue: 0,0:05:08.88,0:05:09.66,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:10.23,0:05:11.03,Default,,0,0,0,,{\i1}Ama...{\i0}
Dialogue: 0,0:05:11.62,0:05:12.79,Default,,0,0,0,,Al!
Dialogue: 0,0:05:14.91,0:05:19.29,Default,,0,0,0,,{\i1}Naniwa'nın kalecisi Nakanishi,\Ninanılmaz bir duvar örerek kaleyi koruyordu!{\i0} {Naniwa's giant keeper Nakanishi's wall was thick!} {kyokan giant kokan crotch, I vote for crotch keeper}
Dialogue: 0,0:05:20.84,0:05:22.46,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:24.38,0:05:27.76,Default,,0,0,0,,Hadi bir kez daha ileri!
Dialogue: 0,0:05:28.40,0:05:30.47,Default,,0,0,0,,Tamamdır! Bir tane daha!
Dialogue: 0,0:05:32.33,0:05:35.43,Default,,0,0,0,,{\i1}Bu uzun pası zıplayarak kesiyorlar!{\i0}  {I couldnt pick a word sis, may need opinion}{i put my word and gattai!}
Dialogue: 0,0:05:36.17,0:05:39.14,Default,,0,0,0,,{\i1}Kesen kişi, turnuvada döktüren Misaki-kun!{\i0}
Dialogue: 0,0:05:39.14,0:05:40.81,Default,,0,0,0,,İşte Misaki!
Dialogue: 0,0:05:40.81,0:05:41.77,Default,,0,0,0,,Lanet olsun.
Dialogue: 0,0:05:41.77,0:05:45.78,Default,,0,0,0,,{\i1}Şimdi Misaki-kun top sürerek ilerliyor.{\i0}
Dialogue: 0,0:05:45.78,0:05:50.58,Default,,0,0,0,,{\i1}Şimdiye kadar çektiğimiz şutların hepsi\Nyakın mesafeden direkt onu hedef alaraktı.{\i0}
Dialogue: 0,0:05:50.58,0:05:54.49,Default,,0,0,0,,Ama bu bedenle köşelere\Nhareket etmekte yavaş olmalı!
Dialogue: 0,0:05:54.49,0:05:58.00,Default,,0,0,0,,{\i1}Misaki-kun orta mesafeden\Nalt köşeye bir şut çekiyor!{\i0}
Dialogue: 0,0:05:59.14,0:06:02.35,Default,,0,0,0,,{\i1}Ne?! Ne inanılmaz çeviklikte oraya zıpladı!{\i0}
Dialogue: 0,0:06:04.38,0:06:08.92,Default,,0,0,0,,{\i1}B-Bu gerçekten de Wakabayashi-kun'un parlama\Nzamanlarındaki gibi harika bir performansla...{\i0}
Dialogue: 0,0:06:08.92,0:06:10.68,Default,,0,0,0,,{\i1}...Nakanishi Taichi-kun!{\i0}
Dialogue: 0,0:06:10.68,0:06:13.43,Default,,0,0,0,,Gol yemeyeceğimi söylemiştim!
Dialogue: 0,0:06:13.43,0:06:15.93,Default,,0,0,0,,Bu turnuvanın bir numaralı kalecisi benim!
Dialogue: 0,0:06:15.93,0:06:17.57,Default,,0,0,0,,Harika.{no time to be impressed brainybu-kun}
Dialogue: 0,0:06:17.57,0:06:18.99,Default,,0,0,0,,Ne diyorsun be?!
Dialogue: 0,0:06:18.99,0:06:20.94,Default,,0,0,0,,Bu lafları kazandıktan sonrasına sakla!
Dialogue: 0,0:06:20.94,0:06:22.54,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:06:22.54,0:06:23.75,Default,,0,0,0,,Her şey yolunda.
Dialogue: 0,0:06:23.75,0:06:24.60,Default,,0,0,0,,Ne?
Dialogue: 0,0:06:24.60,0:06:29.28,Default,,0,0,0,,Ne kadar güçlü olursa olsun\NWakabayashi-kun'dan daha iyi bir kaleci yoktur.
Dialogue: 0,0:06:29.28,0:06:30.86,Default,,0,0,0,,Wakabayashi-san!{Ghastlybayashi is back, laughed so hard at this scene}
Dialogue: 0,0:06:30.86,0:06:35.08,Default,,0,0,0,,Evet, Wakabayashi-kun'dan\Ndaha iyi bir kaleci yok kesinlikle.
Dialogue: 0,0:06:35.08,0:06:37.50,Default,,0,0,0,,Bu kez kesinlikle gol atarak\Nbunu kanıtlayacağım!
Dialogue: 0,0:06:37.50,0:06:42.04,Default,,0,0,0,,{\i1}Kaleci Nakanishi-kun'un uzun bir\Ntop fırlatmasıyla bu kez onlar atakta!{\i0}
Dialogue: 0,0:06:42.04,0:06:44.17,Default,,0,0,0,,Lanet olsun! Bizi hafife alıyorlar!
Dialogue: 0,0:06:44.17,0:06:46.17,Default,,0,0,0,,Takayanagi, sola pas ver!
Dialogue: 0,0:06:46.17,0:06:47.88,Default,,0,0,0,,Tamam!
Dialogue: 0,0:06:47.88,0:06:50.01,Default,,0,0,0,,Shirai, topu kanatlara at!
Dialogue: 0,0:06:51.12,0:06:52.39,Default,,0,0,0,,{\i1}Bu harika!{\i0}
Dialogue: 0,0:06:52.39,0:06:54.53,Default,,0,0,0,,{\i1}Nakanishi-kun çok doğru talimatlar veriyor!{\i0}
Dialogue: 0,0:06:54.53,0:06:59.46,Default,,0,0,0,,{\i1}Evet! Kaleciler arkada yerleştiği\Niçin oyuncuların hareketini en iyi gören kişiler!{\i0}
Dialogue: 0,0:06:59.46,0:07:01.64,Default,,0,0,0,,İleriye pas ver!
Dialogue: 0,0:07:02.73,0:07:05.27,Default,,0,0,0,,{\i1}Top, forvet Ogami-kun'a gidiyor.{\i0}
Dialogue: 0,0:07:05.85,0:07:09.74,Default,,0,0,0,,{\i1}Orta forvet Tsubasa-kun,\Ntopu çalmaya geldi!{\i0}
Dialogue: 0,0:07:11.11,0:07:12.99,Default,,0,0,0,,Ogami, solo pas ver!
Dialogue: 0,0:07:13.46,0:07:14.21,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:14.21,0:07:15.70,Default,,0,0,0,,Ishizaki-kun, sağ!
Dialogue: 0,0:07:15.70,0:07:16.74,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:07:17.34,0:07:19.29,Default,,0,0,0,,{\i1}Ishizaki-kun kesiyor!{\i0}
Dialogue: 0,0:07:19.29,0:07:22.25,Default,,0,0,0,,{\i1}Tsubasa-kun, Nakanishi-kun'un\Ntalimatlarının bir adım önünde!{\i0}
Dialogue: 0,0:07:22.25,0:07:22.90,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:22.90,0:07:23.58,Default,,0,0,0,,Başardık!
Dialogue: 0,0:07:23.58,0:07:25.75,Default,,0,0,0,,Al bakalım Kisugi!
Dialogue: 0,0:07:26.82,0:07:28.00,Default,,0,0,0,,Güzel pas!
Dialogue: 0,0:07:28.00,0:07:31.59,Default,,0,0,0,,Sonunda işe yarar bir şey yapmış gibiyim!
Dialogue: 0,0:07:31.59,0:07:33.84,Default,,0,0,0,,Maeda, sağ kanada destek ol!
Dialogue: 0,0:07:33.84,0:07:35.09,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:35.09,0:07:37.26,Default,,0,0,0,,Pas böyle atılır.
Dialogue: 0,0:07:37.75,0:07:38.68,Default,,0,0,0,,Eyvah!{shimootah! that forced accent lol, well it was like it back in 84 probs}
Dialogue: 0,0:07:39.31,0:07:42.23,Default,,0,0,0,,Tamamdır! Bu kez kesinlikle gol atacağım!
Dialogue: 0,0:07:42.23,0:07:45.81,Default,,0,0,0,,Aynen öyle! Wakabayashi-san'dan\Ndaha iyi bir kaleci yoktur!
Dialogue: 0,0:07:45.81,0:07:48.52,Default,,0,0,0,,Wakabayashi-san asla\Nböyle bir hata yapmazdı!{Wakabayashi would never make a mistake like that. }
Dialogue: 0,0:07:48.52,0:07:51.28,Default,,0,0,0,,Biz de Tsubasa'ya destek olalım!{We'll go and support Tsubasa too!}
Dialogue: 0,0:07:51.28,0:07:53.65,Default,,0,0,0,,Lanet olsun! Herkes geri dönsün!{Damn! Fall back, everyone!}
Dialogue: 0,0:07:53.65,0:07:56.44,Default,,0,0,0,,Şu yer elmasının ilerleyişini durdurun!{Block that squirt's dribble course!}
Dialogue: 0,0:07:56.44,0:07:57.12,Default,,0,0,0,,Evet!
Dialogue: 0,0:07:57.12,0:08:00.54,Default,,0,0,0,,{\i1}Naniwa'nın iyi organize\Nolmuş defansı onu bekliyor.{\i0}
Dialogue: 0,0:08:00.54,0:08:01.83,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:08:01.83,0:08:03.58,Default,,0,0,0,,Arkandayım!
Dialogue: 0,0:08:03.58,0:08:06.98,Default,,0,0,0,,{\i1}Tsubasa-kun arkaya pas\Nverip koşmaya başlıyor!{\i0}
Dialogue: 0,0:08:06.98,0:08:07.88,Default,,0,0,0,,Al!
Dialogue: 0,0:08:07.88,0:08:09.66,Default,,0,0,0,,{\i1}Harika bir ikili oyun!{\i0}
Dialogue: 0,0:08:09.66,0:08:12.13,Default,,0,0,0,,{\i1}Naniwa bile bunu tahmin edemedi.{\i0}
Dialogue: 0,0:08:12.13,0:08:15.65,Default,,0,0,0,,{\i1}Farklı ilkokullardan geldiler ve\Neskiden rakiplerdi.{\i0}
Dialogue: 0,0:08:15.65,0:08:19.04,Default,,0,0,0,,{\i1}Ama şimdi harika bir uyumları var.{\i0}
Dialogue: 0,0:08:19.04,0:08:21.64,Default,,0,0,0,,{\i1}Nankatsu SC iyi bir takım.{\i0}
Dialogue: 0,0:08:21.64,0:08:24.14,Default,,0,0,0,,{\i1}Tsubasa-kun kaleciyle karşı karşıya.{\i0}
Dialogue: 0,0:08:24.14,0:08:25.06,Default,,0,0,0,,Gel bakalım!
Dialogue: 0,0:08:25.06,0:08:29.25,Default,,0,0,0,,{\i1}Ceza sahasının dışından\Nerken bir şut çekecek!{\i0}
Dialogue: 0,0:08:29.25,0:08:30.77,Default,,0,0,0,,{\i1}Bu çok erken oldu!{\i0}
Dialogue: 0,0:08:30.77,0:08:31.78,Default,,0,0,0,,{\i1}İsraf olacak!{\i0}
Dialogue: 0,0:08:32.26,0:08:35.20,Default,,0,0,0,,{\i1}Wakabayashi-kun'dan\Ndaha iyi bir kaleci yoktur.{\i0} {"There's no other goalkeeper for me other than wakabayashi" 2romantic4me}
Dialogue: 0,0:08:35.20,0:08:37.03,Default,,0,0,0,,{\i1}Bu durduğum yerden\Nsana bunu kanıtlayacağım.{\i0}
Dialogue: 0,0:08:39.37,0:08:41.37,Default,,0,0,0,,Aptal mısın?!\NÇok erken davrandın!
Dialogue: 0,0:08:41.88,0:08:42.83,Default,,0,0,0,,Bende!
Dialogue: 0,0:08:44.21,0:08:47.46,Default,,0,0,0,,{\i1}Nakanishi-kun iki eliyle yakalıyor.{\i0}
Dialogue: 0,0:08:48.51,0:08:50.21,Default,,0,0,0,,{\i1}Hayır!{\i0}
Dialogue: 0,0:08:50.21,0:08:52.30,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:08:52.30,0:08:54.22,Default,,0,0,0,,{\i1}Mermi gibi bir gol!{\i0}
Dialogue: 0,0:08:54.89,0:08:55.84,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:08:55.84,0:08:58.82,Default,,0,0,0,,{\i1}Top inanılmaz derecede dönüyordu.{\i0}
Dialogue: 0,0:08:58.82,0:09:00.93,Default,,0,0,0,,{\i1}Nankatsu beraberliği sağlıyor!{\i0}
Dialogue: 0,0:09:00.93,0:09:03.24,Default,,0,0,0,,Tamamdır! Başardın Tsubasa!
Dialogue: 0,0:09:03.24,0:09:05.12,Default,,0,0,0,,Ceza sahasının dışından mı vurdu?
Dialogue: 0,0:09:05.12,0:09:05.94,Default,,0,0,0,,Ne?
Dialogue: 0,0:09:05.94,0:09:10.88,Default,,0,0,0,,Okullar arası turnuva sırasında\NTsubasa sana iki gol atmıştı.
Dialogue: 0,0:09:10.88,0:09:13.78,Default,,0,0,0,,Ama ceza sahasının dışından\Ngol yememiştin.
Dialogue: 0,0:09:14.69,0:09:19.78,Default,,0,0,0,,Tsubasa senden daha iyi bir\Nkaleci olmadığını kanıtlamak istiyordu.{it's a declaration of love}
Dialogue: 0,0:09:19.78,0:09:25.29,Default,,0,0,0,,Ayrıca bununla birlikte senin\Ngeçen seneki rekorunu kıramayacak.
Dialogue: 0,0:09:25.29,0:09:28.96,Default,,0,0,0,,Lanet olsun...\NŞu Tsubasa'ya bak hele.
Dialogue: 0,0:09:28.96,0:09:32.67,Default,,0,0,0,,Harikasın Tsubasa-kun!
Dialogue: 0,0:09:32.67,0:09:35.25,Default,,0,0,0,,{\i1}Tsubasa-kun'un golüyle\N1-1 beraberlik oluyor.{\i0}
Dialogue: 0,0:09:35.25,0:09:37.17,Default,,0,0,0,,{\i1}Nankatsu forvetlerinin keyfi yerine geldi!{\i0}
Dialogue: 0,0:09:37.17,0:09:40.62,Default,,0,0,0,,{\i1}Misaki-kun harika top kontrolüyle\Nsürekli atakta!{\i0}
Dialogue: 0,0:09:40.62,0:09:43.06,Default,,0,0,0,,{\i1}Nankatsu forvetleri de\Nkale önünde toplanıyor!{\i0}
Dialogue: 0,0:09:44.19,0:09:46.93,Default,,0,0,0,,{\i1}Top Tsubasa-kun'a geldi!{\i0}
Dialogue: 0,0:09:46.93,0:09:50.61,Default,,0,0,0,,Lanet olsun! Öyle kolayca\Nbir gol daha attırmam!
Dialogue: 0,0:09:50.61,0:09:53.11,Default,,0,0,0,,Tüm bedenimle onu durduracağım!
Dialogue: 0,0:09:54.94,0:09:55.65,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:55.65,0:09:57.99,Default,,0,0,0,,{\i1}Boşta olan Kisugi-kun şut çekiyor!{\i0}
Dialogue: 0,0:09:59.08,0:10:00.28,Default,,0,0,0,,{\i1}Başardı!{\i0}
Dialogue: 0,0:10:00.28,0:10:02.77,Default,,0,0,0,,{\i1}Nankatsu skoru tersine çevirmeyi başardı!{\i0}
Dialogue: 0,0:10:02.77,0:10:04.08,Default,,0,0,0,,Başardık!
Dialogue: 0,0:10:05.32,0:10:06.58,Default,,0,0,0,,{\i1}İlk yarı bitiyor!{\i0}
Dialogue: 0,0:10:06.58,0:10:08.68,Default,,0,0,0,,{\i1}Rakibine inanılmaz baskı\Nkuran Nankatsu...{\i0} {HALP!! halp done}
Dialogue: 0,0:10:08.68,0:10:11.96,Default,,0,0,0,,{\i1}...Naniwa'ya karşı 2-1 önde!{\i0}
Dialogue: 0,0:10:13.59,0:10:16.01,Default,,0,0,0,,Tamamdır! Böyle devam edelim çocuklar!
Dialogue: 0,0:10:16.01,0:10:16.75,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:16.75,0:10:19.38,Default,,0,0,0,,Evet! Benim şutum bile girdi!
Dialogue: 0,0:10:19.38,0:10:21.43,Default,,0,0,0,,Rakibimizin kalecisi\No kadar da korkutucu değil.
Dialogue: 0,0:10:22.02,0:10:24.45,Default,,0,0,0,,Nakanishi'nin neyi var?
Dialogue: 0,0:10:24.45,0:10:26.11,Default,,0,0,0,,2 gol yedi.
Dialogue: 0,0:10:26.11,0:10:27.25,Default,,0,0,0,,Evet.
Dialogue: 0,0:10:27.25,0:10:30.06,Default,,0,0,0,,{\i1}Bana karşı 2 gol attılar.
Dialogue: 0,0:10:32.57,0:10:35.19,Default,,0,0,0,,{\i1}Naniwa'nın kalecisinin suçu yok.{\i0}
Dialogue: 0,0:10:35.19,0:10:37.76,Default,,0,0,0,,{\i1}Nankatsu gerçekten de çok güçlü.{\i0}
Dialogue: 0,0:10:37.76,0:10:41.82,Default,,0,0,0,,{\i1}Bize karşı oynadıkları zamana\Ngöre kendilerini çok geliştirdiler.{\i0}
Dialogue: 0,0:10:41.82,0:10:46.54,Default,,0,0,0,,{\i1}İkinci yarıda da Nankatsu\Natakları devam etti.{\i0}
Dialogue: 0,0:10:46.54,0:10:51.37,Default,,0,0,0,,{\i1}Turnuva başladığından beri\Ntakımın seviyesi sürekli yükseliyor.{\i0}
Dialogue: 0,0:10:51.37,0:10:57.88,Default,,0,0,0,,{\i1}Bunun farkında olan Tsubasa sadece kendini\Ndeğil takım arkadaşlarını da geliştiriyor.{\i0}
Dialogue: 0,0:10:57.88,0:11:01.13,Default,,0,0,0,,{\i1}Çok büyümüşsün Tsubasa.{\i0}
Dialogue: 0,0:11:01.92,0:11:03.68,Default,,0,0,0,,{\i1}Nankatsu 4. gollerini atıyor!{\i0}
Dialogue: 0,0:11:03.68,0:11:09.22,Default,,0,0,0,,{\i1}Gol ardına gol yiyen Nakanishi-kun\Nazmini kaybetmiş gibi!{\i0}
Dialogue: 0,0:11:09.22,0:11:10.31,Default,,0,0,0,,Lanet olsun...
Dialogue: 0,0:11:10.31,0:11:14.31,Default,,0,0,0,,{\i1}Bu maç tamamen mağlup oldum.{\i0}
Dialogue: 0,0:11:14.31,0:11:18.90,Default,,0,0,0,,{\i1}Ama Ozora Tsubasa...\NBenim yüzümü düşürerek çok ileri gittin.{\i0}
Dialogue: 0,0:11:18.90,0:11:21.82,Default,,0,0,0,,{\i1}Sana bunu ödeteceğim!{\i0}
Dialogue: 0,0:11:21.82,0:11:24.57,Default,,0,0,0,,{\i1}Tsubasa-kun hızlıca kaleye yaklaşıyor!{\i0}
Dialogue: 0,0:11:26.20,0:11:28.29,Default,,0,0,0,,{\i1}Tsubasa-kun şut çekmeye hazırlanıyor!{\i0}
Dialogue: 0,0:11:28.29,0:11:33.08,Default,,0,0,0,,O altın sağ ayağını senden alacağım!
Dialogue: 0,0:11:33.50,0:11:36.10,Default,,0,0,0,,Al!
Dialogue: 0,0:11:36.75,0:11:41.42,Default,,0,0,0,,{\i1}Tsubasa-kun, Nakanishi-kun'un\Nsaldırısından kıl payı kurtuluyor!{\i0} {HALP!!}
Dialogue: 0,0:11:45.85,0:11:48.04,Default,,0,0,0,,{\i1}Kusursuz bir gol!{\i0}
Dialogue: 0,0:11:48.04,0:11:51.81,Default,,0,0,0,,{\i1}5-1! Tsubasa-kun bir posta daha koyuyor!{\i0}
Dialogue: 0,0:11:51.81,0:11:53.81,Default,,0,0,0,,Başardık!
Dialogue: 0,0:11:56.54,0:12:00.68,Default,,0,0,0,,Nakanishi-kun, saldırmak yerine\Ntopu tutmaya çalışsan...
Dialogue: 0,0:12:00.68,0:12:02.87,Default,,0,0,0,,...şimdikini kurtarabilirdin belki de.
Dialogue: 0,0:12:10.91,0:12:13.62,Default,,0,0,0,,Tamamen mağlup oldum.{It's a total loss for me}
Dialogue: 0,0:12:15.53,0:12:17.72,Default,,0,0,0,,{\i1}Maçın son düdüğü de çalıyor.{\i0}
Dialogue: 0,0:12:17.72,0:12:20.13,Default,,0,0,0,,{\i1}Nankatsu en iyi 8 arasında!{\i0}
Dialogue: 0,0:12:19.17,0:12:20.13,Default-Top,,0,0,0,,Nankatsu SC: 5 - 1: Naniwa FC
Dialogue: 0,0:12:20.13,0:12:21.21,Default,,0,0,0,,Bir, iki...
Dialogue: 0,0:12:21.21,0:12:23.44,Default,,0,0,0,,Başardın Nankatsu!
Dialogue: 0,0:12:23.44,0:12:25.38,Default,,0,0,0,,Hadi şampiyon olun!
Dialogue: 0,0:12:25.38,0:12:28.22,Default,,0,0,0,,{\i1}Nankatsu SC gittikçe güçleniyor.{\i0}
Dialogue: 0,0:12:28.22,0:12:30.98,Default,,0,0,0,,{\i1}Gözlerinizi ayıramayacağınız bir takım.{\i0} {you're just too good to be true, i can't take my eyess off of you}
Dialogue: 0,0:12:31.85,0:12:34.66,Default,,0,0,0,,Kaptan Tsubasa-kun'dan da bu beklenirdi.
Dialogue: 0,0:12:34.66,0:12:39.23,Default,,0,0,0,,Takımının ana diğeri rolünde\Nve her şeyi dengeliyor.
Dialogue: 0,0:12:39.23,0:12:44.74,Default,,0,0,0,,Baştan sona oynamadığım sürece\Nonlara karşı kazanamayız gibi görünüyor.
Dialogue: 0,0:12:45.29,0:12:46.49,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:12:56.92,0:13:01.37,Default,,0,0,0,,{\i1\pos(968,1028)}Yarınki yarı finallerde\N8 takımdan...{\i0}
Dialogue: 0,0:13:01.37,0:13:03.13,Default,,0,0,0,,{\i1}...en iyisi dört 4 tanesi belirlenecek.{\i0}
Dialogue: 0,0:13:04.65,0:13:05.29,Default-Top,,0,0,0,,Meiwa FC: 5 - 1: Kozai İlkokulu
Dialogue: 0,0:13:04.18,0:13:10.26,Default,,0,0,0,,{\i1}Meiwa FC ve Furano İlkokulu\Nşiddetli maçlar sonucunda çıkmıştı.{\i0}
Dialogue: 0,0:13:08.22,0:13:10.26,Default-Top,,0,0,0,,Furano İlkokulu: 3 - 1: Bizen FC
Dialogue: 0,0:13:10.26,0:13:14.33,Default,,0,0,0,,{\i1}Bizim Nankatsu ise karşılaştığı\NShinjo'yu büyük bir farkla yenerek...{\i0}
Dialogue: 0,0:13:14.33,0:13:17.60,Default,,0,0,0,,{\i1}...en iyi dört arasında kendine yer bulmuştu.{\i0} {i have no idea why i'm not being literal}
Dialogue: 0,0:13:13.29,0:13:17.60,Default-Top,,0,0,0,,Nankatsu SC: 7 - 0: Shinjo FC
Dialogue: 0,0:13:17.60,0:13:19.60,Default,,0,0,0,,Millet, elinize sağlık.
Dialogue: 0,0:13:19.60,0:13:22.95,Default,,0,0,0,,Bugünkü Musashi ve Hitachi\Nmaçının kazananı...
Dialogue: 0,0:13:22.95,0:13:25.61,Default,,0,0,0,,...yarınki rakibimiz olacak.
Dialogue: 0,0:13:25.61,0:13:27.88,Default,,0,0,0,,Her şey yolunda giderse...
Dialogue: 0,0:13:27.88,0:13:30.25,Default,,0,0,0,,Bir aksilik çıkmazsa muhtemelen\NMusashi kazanır, değil mi?
Dialogue: 0,0:13:30.25,0:13:30.95,Default,,0,0,0,,Evet.
Dialogue: 0,0:13:30.95,0:13:34.59,Default,,0,0,0,,Musashi FC, Kanto bölgesinin temsilcisi.
Dialogue: 0,0:13:34.59,0:13:38.21,Default,,0,0,0,,Oyuncuları 1000 kişi arasından\Nseçilen üst düzey kişiler.
Dialogue: 0,0:13:38.21,0:13:43.84,Default,,0,0,0,,Takımlarında en çok dikkat çeken\Nkişi kaptanları Misugi Jun.
Dialogue: 0,0:13:43.84,0:13:46.63,Default,,0,0,0,,Tekniğiyle ilkokul seviyesinin çok üstünde.
Dialogue: 0,0:13:46.63,0:13:49.20,Default,,0,0,0,,Başkaları onu yenmeyi bırakın,\Nfiziksel temasa bile giremiyor.
Dialogue: 0,0:13:49.20,0:13:51.16,Default,,0,0,0,,Zarif oyun tarzıyla...
Dialogue: 0,0:13:51.16,0:13:54.47,Default,,0,0,0,,Sahanın Genç Asili deniyor.\NDeğil mi Koç?
Dialogue: 0,0:13:54.47,0:13:55.62,Default,,0,0,0,,Vay...
Dialogue: 0,0:13:55.62,0:13:59.91,Default,,0,0,0,,Ama turnuvada daha\Nbir maçta bile oynamadı ki.
Dialogue: 0,0:13:59.91,0:14:01.61,Default,,0,0,0,,Belki de yaralı falandır.
Dialogue: 0,0:14:01.61,0:14:03.83,Default,,0,0,0,,Hayır. Sebebini bilmiyorum ama...
Dialogue: 0,0:14:03.83,0:14:07.44,Default,,0,0,0,,...Misugi hep maçlarda az oynar.
Dialogue: 0,0:14:07.44,0:14:08.11,Default,,0,0,0,,Ne?
Dialogue: 0,0:14:08.11,0:14:10.11,Default,,0,0,0,,Bu yüzden tüm kızlar...
Dialogue: 0,0:14:10.11,0:14:13.96,Default,,0,0,0,,{\c&H410DEA&}Kyaaa{\c&H049EF6&} >.< {\c&H00EEFD&}Misugi-san{\c&H00FF00&} çok giz{\c&HFFFF00&}eml{\c&HF77B5B&}i! Ne kada{\c&HFF00FF&}r da harika!{\c&H3233EB&}
Dialogue: 0,0:14:13.96,0:14:15.68,Default,,0,0,0,,diyor ya.
Dialogue: 0,0:14:15.68,0:14:17.62,Default,,0,0,0,,Sadece boş hava işte.
Dialogue: 0,0:14:17.62,0:14:23.26,Default,,0,0,0,,Musashi, takım çalışması sayesinde\Ngruplardan çıkabildi ama...
Dialogue: 0,0:14:23.26,0:14:27.28,Default,,0,0,0,,...bize karşı oynayacaklarsa\NMisugi'yi de oynatırlar eminim.
Dialogue: 0,0:14:27.28,0:14:28.85,Default,,0,0,0,,Biz de bunu beklerdik.
Dialogue: 0,0:14:28.85,0:14:31.70,Default,,0,0,0,,Kesinlikle kazanıp finallere çıkacağız!
Dialogue: 0,0:14:31.70,0:14:33.51,Default,,0,0,0,,Wakabayashi-san'ın hatırı için de!
Dialogue: 0,0:14:33.51,0:14:34.85,Default,,0,0,0,,Evet!
Dialogue: 0,0:14:34.85,0:14:36.65,Default,,0,0,0,,Hey Misugi-san!
Dialogue: 0,0:14:36.65,0:14:38.65,Default,,0,0,0,,Yarı finaller geldi sayılır.{It's almost the semi-finals.}
Dialogue: 0,0:14:38.65,0:14:41.11,Default,,0,0,0,,Misugi-kun, oynama durumunuz nedir?
Dialogue: 0,0:14:41.11,0:14:42.88,Default,,0,0,0,,Kim bilir?
Dialogue: 0,0:14:42.88,0:14:47.69,Default,,0,0,0,,Bunu kazanırsanız şampiyonluk konusunda\Niddialı Nankatsu SC ile oynayacaksınız.
Dialogue: 0,0:14:47.69,0:14:51.19,Default,,0,0,0,,Nankatsu güçlü. Özellikle Ozora Tsubasa-kun.
Dialogue: 0,0:14:51.19,0:14:54.52,Default,,0,0,0,,Onunla yeteneklerimizi yarıştırmak isterdim.
Dialogue: 0,0:14:54.52,0:14:55.05,Default,,0,0,0,,Ne?
Dialogue: 0,0:14:55.05,0:14:56.70,Default,,0,0,0,,Yani oynayacağınızdan\Nemin olabilir miyiz?
Dialogue: 0,0:14:56.70,0:15:00.56,Default,,0,0,0,,Misugi-san, Nankatsu maçına\Nkadar oynamayacak mı?{whats with the hooker voice of that elementary girl?}
Dialogue: 0,0:15:00.56,0:15:03.27,Default,,0,0,0,,Ama zor durumda kalırlarsa\Nbelki bugün de oynar.
Dialogue: 0,0:15:03.27,0:15:06.71,Default,,0,0,0,,Öyleyse rakip takım Hitachi FC'nin\Nelinden geleni yapması gerek.{oh my god she's dumb}
Dialogue: 0,0:15:06.71,0:15:10.28,Default,,0,0,0,,Hora! Hora! Hitachi!
Dialogue: 0,0:15:10.28,0:15:12.47,Default,,0,0,0,,Hora! Hora! Hitachi!
Dialogue: 0,0:15:12.47,0:15:16.98,Default,,0,0,0,,Lanet olası Misugi! Bizi\Ngörmezden geliyor tamamen!{promise we'll save ishizaki from his gambling addiction}
Dialogue: 0,0:15:16.98,0:15:19.06,Default,,0,0,0,,Ona neler yapabileceğimizi gösterelim.{or lets teach him a lesson}
Dialogue: 0,0:15:19.52,0:15:21.81,Default,,0,0,0,,Ne demek istiyorsun Misugi?
Dialogue: 0,0:15:21.81,0:15:26.36,Default,,0,0,0,,Koç, bu turnuva benim için çok özel.
Dialogue: 0,0:15:26.36,0:15:28.48,Default,,0,0,0,,Bunun farkındasınız değil mi?
Dialogue: 0,0:15:29.86,0:15:33.61,Default,,0,0,0,,Kendimi en iyi tanıyan benim.
Dialogue: 0,0:15:33.61,0:15:37.40,Default,,0,0,0,,Ozara Tsubasa'ya karşı\Nbu kadar çok mu oynamak istiyorsun?
Dialogue: 0,0:15:37.40,0:15:38.29,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:38.29,0:15:41.20,Default,,0,0,0,,Duygularını tam anlayamıyorum ama...
Dialogue: 0,0:15:41.20,0:15:43.58,Default,,0,0,0,,...o kadar kolayca oynamana izin veremem.
Dialogue: 0,0:15:44.00,0:15:48.09,Default,,0,0,0,,Bugün sakince yedek kulübesinde\Noturacaksın. Daha sonra bunu konuşacağız.
Dialogue: 0,0:15:48.64,0:15:49.91,Default,,0,0,0,,Anladım.{cheap drama-tier eavesdropping}
Dialogue: 0,0:15:54.64,0:15:56.14,Default,,0,0,0,,Menajer?
Dialogue: 0,0:15:58.47,0:16:01.68,Default,,0,0,0,,Ne kalabalık toplanmış.
Dialogue: 0,0:16:01.68,0:16:05.10,Default,,0,0,0,,Musashi FC çok fazla dikkat çektiği için böyle.
Dialogue: 0,0:16:05.10,0:16:06.58,Default,,0,0,0,,Tsubasa-kun.
Dialogue: 0,0:16:07.57,0:16:09.30,Default,,0,0,0,,Yayoi-chan!
Dialogue: 0,0:16:09.30,0:16:11.82,Default,,0,0,0,,Biraz konuşmamız gerek.{break up talk}
Dialogue: 0,0:16:14.32,0:16:17.44,Default,,0,0,0,,Yine kamyonla mı seyahat edeceğiz şimdi?
Dialogue: 0,0:16:17.44,0:16:17.87,Default,,0,0,0,,Ne?
Dialogue: 0,0:16:20.79,0:16:23.29,Default,,0,0,0,,Tsubasa-kun o kızla birlikte mi?!
