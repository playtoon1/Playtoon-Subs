Dialogue: 0,0:00:00.00,0:00:05.00,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:00.78,0:00:03.77,Default,,0,0,0,,{\i1}Otomo Orta Okulu Nankatsu'nun bir sayı arkasında,{\i0}
Dialogue: 0,0:00:03.77,0:00:09.78,Default,,0,0,0,,{\i1}Nitta, hızlı bir gelişme gösteren Tsubasa'nın\N Şahin Vuruşunu taklit ediyor.{\i0}
Dialogue: 0,0:00:09.78,0:00:15.20,Default,,0,0,0,,{\i1}Aynı zamanda, Nankatsu'nun saldırıları Urabe, takım ve kaleci Ichijo tarafından engellendi.{\i0}
Dialogue: 0,0:00:15.20,0:00:20.25,Default,,0,0,0,,{\i1}Uzun pasları ile Nitta kaleyi geçti ve nihayet özel hareketini tamamlamayı başardı.{\i0}
Dialogue: 0,0:00:20.25,0:00:25.46,Default,,0,0,0,,İşte! Şahin Vuruşu!
Dialogue: 0,0:00:25.46,0:00:28.38,Default,,0,0,0,,{\i1}Otomo Orta Okulu nihayet Nankatsu'ya yetişti.{\i0}
Dialogue: 0,0:00:28.38,0:00:32.00,Default,,0,0,0,,{\i1}Ancak, Tsubasa oturup devam etmesini izlemeyi planlamıyor.{\i0}
Dialogue: 0,0:00:34.44,0:00:40.90,Default,,0,0,0,,{\i1}Karşılık olarak bir gol atar, ve Nankatsu tekrar skoru 2-1 yapar.{\i0}
Dialogue: 0,0:00:41.81,0:00:45.60,Default,,0,0,0,,{\i1}Tsubasa'nın görkemli şutu sayesinde Nankatsu Ortaokulu bir gol daha attı.{\i0}
Dialogue: 0,0:00:45.60,0:00:47.26,Default,,0,0,0,,{\i1}Eğer puan verirlerse,{\i0}
Dialogue: 0,0:00:47.26,0:00:50.11,Default,,0,0,0,,{\i1}işler kızışır.{\i0}
Dialogue: 0,0:00:50.11,0:00:56.32,Default,,0,0,0,,{\i1}Dahası, bu gol Nankatsu'nun hücum oyuncularının  Otomo'nun savunmasını kırma çabalarının meyvesiydi,{\i0}
Dialogue: 0,0:00:56.32,0:00:59.33,Default,,0,0,0,,{\i1}Tsubasa'nın tüm oyunu kontrol altında tutmasına rağmen.{\i0}
Dialogue: 0,0:00:59.70,0:01:02.28,Default,,0,0,0,,{\i1}Bu yüzden herşey daha önemli.{\i0}
Dialogue: 0,0:01:03.07,0:01:06.21,Default,,0,0,0,,{\i1}Yani, Nankatsu 3. şampiyonluğunu kazanmak için motive oldu...{\i0}
Dialogue: 0,0:01:06.21,0:01:10.68,Default,,0,0,0,,{\i1}Ama... Şahin Vuruşunda ustalaştım!{\i0}
Dialogue: 0,0:01:10.68,0:01:13.24,Default,,0,0,0,,{\i1}Onları hemen sollayabileceğimizi göstereceğim!{\i0}
Dialogue: 0,0:01:13.97,0:01:28.97,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \N{\c&HB1351A&}İnstagram: AnimeSeverlerrr
Dialogue: 0,0:01:13.97,0:02:44.01,Default,,0,0,0,,{OP} 
Dialogue: 0,0:02:44.26,0:02:48.52,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}BÖLÜM 32: \NTSUBASA'YI DEVİRMEK! HYUGA VS MISUGI
Dialogue: 0,0:02:45.77,0:02:48.77,Default-TOP,,0,0,0,,{\i1}Final maçının 20 dakikasını geçmek üzereyiz.{\i0}
Dialogue: 0,0:02:50.14,0:02:52.02,Default,,0,0,0,,{\i1}Top kanattaki Taki'ye gönderildi.{\i0}
Dialogue: 0,0:02:53.93,0:02:55.53,Default,,0,0,0,,{\i1}Urabe topu çalıyor!{\i0}
Dialogue: 0,0:02:56.78,0:02:57.74,Default,,0,0,0,,Nitta!
Dialogue: 0,0:02:57.74,0:02:59.74,Default,,0,0,0,,{\i1}Otomo uzun bir pasa vuruyor!{\i0}
Dialogue: 0,0:02:59.74,0:03:01.74,Default,,0,0,0,,{\i1}Nitta'ya ulaşacak mı?{\i0}
Dialogue: 0,0:03:01.74,0:03:02.49,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:03.71,0:03:07.83,Default,,0,0,0,,{\i1}Hayır, Izawa sıçradı ve engelledi!{\i0}
Dialogue: 0,0:03:07.83,0:03:08.70,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:10.95,0:03:13.65,Default,,0,0,0,,{\i1}Nitta, Şahin Vuruşunda ustalaştıktan sonra,{\i0}
Dialogue: 0,0:03:13.65,0:03:16.92,Default,,0,0,0,,{\i1}herkes pasların rotasını okumaya odaklandı.{\i0}
Dialogue: 0,0:03:16.92,0:03:21.34,Default,,0,0,0,,{\i1}İkinci yarının başlangıcından itibaren Nankatsu, {\i0}
Dialogue: 0,0:03:21.34,0:03:24.55,Default,,0,0,0,,{\i1}Otomo'nun hızına alıştı ve ayak uydurabildi.{\i0}
Dialogue: 0,0:03:25.41,0:03:26.06,Default,,0,0,0,,Nitta!
Dialogue: 0,0:03:26.52,0:03:27.72,Default,,0,0,0,,Senin sıran, Takasugi!
Dialogue: 0,0:03:27.72,0:03:28.70,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:28.70,0:03:30.14,Default,,0,0,0,,{\i1}Başka bir müdahale!{\i0}
Dialogue: 0,0:03:30.14,0:03:31.30,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:03:31.30,0:03:35.11,Default,,0,0,0,,{\i1}Topu aldığım sürece skoru almak için buradayım...{\i0}
Dialogue: 0,0:03:35.11,0:03:37.86,Default,,0,0,0,,{\i1}İkinci yarının 23. dakikasına ulaşmak üzereyiz.{\i0}
Dialogue: 0,0:03:38.80,0:03:40.86,Default,,0,0,0,,{\i1}Nishio topu çalıyor!{\i0}
Dialogue: 0,0:03:45.58,0:03:46.80,Default,,0,0,0,,Nitta!
Dialogue: 0,0:03:46.80,0:03:49.44,Default,,0,0,0,,{\i1}Otomo öne uzun bir pas yolluyor.{\i0}
Dialogue: 0,0:03:49.44,0:03:50.08,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:52.68,0:03:55.52,Default,,0,0,0,,{\i1}Ama Nitta ofsayt!{\i0}
Dialogue: 0,0:03:55.52,0:03:56.29,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:56.29,0:03:58.00,Default,,0,0,0,,{\i1}İyi iş!{\i0}
Dialogue: 0,0:03:58.00,0:04:00.18,Default,,0,0,0,,{\i1}Nankatsu'nun savunucuları Otomo'yu ferkediyorlar{\i0}
Dialogue: 0,0:04:00.18,0:04:03.34,Default,,0,0,0,,{\i1} ve bir tuzak kuruyorlar!{\i0}
Dialogue: 0,0:04:03.34,0:04:06.85,Default,,0,0,0,,Lanet olsun! Paslarımızı tamamen okudular!
Dialogue: 0,0:04:06.85,0:04:09.35,Default,,0,0,0,,{\i1} Sadece 5 dakika kaldı. {\i0}
Dialogue: 0,0:04:10.52,0:04:12.56,Default,,0,0,0,,{\i1} Bu sefer, Nankatsu saldırıya geçti.{\i0}
Dialogue: 0,0:04:12.96,0:04:17.88,Default,,0,0,0,,{\i1}Nitta'nın Şahin Vuruşunu kullanamamasına izin veremeyiz!{\i0}
Dialogue: 0,0:04:18.84,0:04:20.99,Default,,0,0,0,,{\i1}Ancak Otomo'nun savunması gayretli!{\i0}
Dialogue: 0,0:04:21.39,0:04:21.94,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:04:21.94,0:04:22.56,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:22.56,0:04:24.98,Default,,0,0,0,,{\i1}Ishizaki ribaundu alıyor.{\i0}
Dialogue: 0,0:04:24.98,0:04:27.68,Default,,0,0,0,,{\i1}Ishizaki koşuyor ve yan çizgiyi aşıyor.{\i0}
Dialogue: 0,0:04:27.68,0:04:28.28,Default,,0,0,0,,İşte!
Dialogue: 0,0:04:28.28,0:04:30.15,Default,,0,0,0,,{\i1}Bir hile!{\i0}
Dialogue: 0,0:04:30.15,0:04:33.29,Default,,0,0,0,,{\i1} Fakat biraz fazla ileri gitmedi mi? {\i0}
Dialogue: 0,0:04:33.80,0:04:36.67,Default,,0,0,0,,{\i1}Hayır, Tsubasa yaklaşıyor!{\i0}
Dialogue: 0,0:04:36.67,0:04:41.46,Default,,0,0,0,,Ichijo! Vuruş açısı olmasa bile Tsubasa vuracak!
Dialogue: 0,0:04:41.46,0:04:44.59,Default,,0,0,0,,{\i1}Tsubasa, topu yakaladıktan sonra vurdu.{\i0}
Dialogue: 0,0:04:45.20,0:04:47.30,Default,,0,0,0,,{\i1}Ancak, hedef dışı.\N{\i0} 
Dialogue: 0,0:04:47.30,0:04:49.06,Default,,0,0,0,,Pekala!
Dialogue: 0,0:04:50.36,0:04:52.81,Default,,0,0,0,,{\i1}Taki kafa vuruşu yapıyor!{\i0}
Dialogue: 0,0:04:53.58,0:04:54.81,Default,,0,0,0,,{\i1} 3. gol!{\i0}
Dialogue: 0,0:04:54.81,0:04:58.81,Default,,0,0,0,,{\i1}Kaleci Ichijo, Tsubasa tarafından tamamen geride bırakıldı.{\i0}
Dialogue: 0,0:04:58.81,0:05:03.78,Default,,0,0,0,,{\i1}Son aşamada, Nankatsu, taşı deliğinde oturtur gibi oyunun sonunda tekrar puan alıyor.{\i0}
Dialogue: 0,0:05:03.78,0:05:07.28,Default,,0,0,0,,Lanet Olsun! Bu Nankatsu'nun gerçek yüzü mü?
Dialogue: 0,0:05:07.28,0:05:10.36,Default,,0,0,0,,{\i1}Oyunda sadece ek süre kaldı.{\i0}
Dialogue: 0,0:05:10.36,0:05:13.16,Default,,0,0,0,,{\i1}Bu Nankatsu için iyi bir zafer.{\i0}
Dialogue: 0,0:05:13.16,0:05:19.10,Default,,0,0,0,,{\i1}Sadece kendi değil, aynı zamanda takım arkadaşlarıda puan almak için çalışıyor.{\i0}
Dialogue: 0,0:05:19.10,0:05:20.96,Default,,0,0,0,,{\i1}Yani, bu Tsubasa Ozora...{\i0}
Dialogue: 0,0:05:21.60,0:05:24.38,Default,,0,0,0,,{\i1}Yinede, sonuna kadar pes etmeyeceğim!{\i0}
Dialogue: 0,0:05:26.50,0:05:28.89,Default,,0,0,0,,{\i1}Otomo, pes etmeyi reddederek saldırmaya devam ediyor!{\i0}
Dialogue: 0,0:05:28.89,0:05:32.89,Default,,0,0,0,,{\i1}Sonuna kadar görevimiz topu Nitta'ya ulaştırmak.{\i0}
Dialogue: 0,0:05:34.02,0:05:35.48,Default,,0,0,0,,{\i1}Topu Nitta'ya ulaştıracağız!{\i0}
Dialogue: 0,0:05:36.16,0:05:37.02,Default,,0,0,0,,Urabe...
Dialogue: 0,0:05:37.02,0:05:38.90,Default,,0,0,0,,{\i1}Topu Nitta'ya ulaştıracağız!{\i0}
Dialogue: 0,0:05:39.40,0:05:40.48,Default,,0,0,0,,{\i1}Yapmamız gereken şey bu!{\i0}
Dialogue: 0,0:05:43.76,0:05:47.04,Default,,0,0,0,,{\i1}Düdük çaldı!{\i0}
Dialogue: 0,0:05:47.04,0:05:49.10,Default,,0,0,0,,{\i1}Nankatsu kazandı!{\i0}
Dialogue: 0,0:05:49.10,0:05:49.91,Default,,0,0,0,,Kazandık!
Dialogue: 0,0:05:51.49,0:05:54.62,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:05:59.27,0:06:00.13,Default,,0,0,0,,Nitta!
Dialogue: 0,0:06:04.16,0:06:09.00,Default,,0,0,0,,{\i1}Nitta kaleye mükemmel bir Şahin Vuruşu attı, ama çok geç.{\i0}
Dialogue: 0,0:06:09.92,0:06:13.64,Default,,0,0,0,,{\i1}Ulusal Ortaokul Futbol Turnuvası galibi{\i0}
Dialogue: 0,0:06:13.64,0:06:17.38,Default,,0,0,0,,{\i1}Shizuoka İl Turnuvası, üçüncü sırada yer alan Nankatsu.{\i0}
Dialogue: 0,0:06:17.38,0:06:18.33,Default,,0,0,0,,Başardık!
Dialogue: 0,0:06:18.33,0:06:20.78,Default,,0,0,0,,Tekrar Ulusal Turnuvaya gideceğiz!
Dialogue: 0,0:06:21.98,0:06:25.27,Default,,0,0,0,,{\i1}Otomo Ortaokulu, oyun boyunca Nankatsu'yu bırakmadı,{\i0}
Dialogue: 0,0:06:25.27,0:06:28.24,Default,,0,0,0,,{\i1}ama güçleri gerçekten savaşmadan önce bitti.{\i0}
Dialogue: 0,0:06:28.24,0:06:33.95,Default,,0,0,0,,{\i1}Nankatsu kazandı çünkü Otomo'nun topu Nitta'ya göndermesini engelledi. Onların gücünü gösterir.{\i0}
Dialogue: 0,0:06:33.95,0:06:34.74,Default,,0,0,0,,Evet.
Dialogue: 0,0:06:35.34,0:06:38.50,Default,,0,0,0,,{\i1}Pekala! Şimdi bir kez daha Nankatsu'ya karşı oynayacağız!{\i0}
