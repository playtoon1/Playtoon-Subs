Dialogue: 0,0:06:45.28,0:06:47.48,Default,,0,0,0,,Nankatsu gerçekten güçlü.
Dialogue: 0,0:06:47.48,0:06:50.66,Default,,0,0,0,,Onları izlemek için gelmeye değdi.
Dialogue: 0,0:06:50.66,0:06:51.84,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:06:53.50,0:06:55.77,Default,,0,0,0,,Özür dilerim Nitta.
Dialogue: 0,0:06:56.78,0:07:00.77,Default,,0,0,0,,Topu sana ulaştıramamız bizim suçumuz.
Dialogue: 0,0:07:02.35,0:07:05.27,Default,,0,0,0,,Sizin hatanız değil.
Dialogue: 0,0:07:05.27,0:07:09.92,Default,,0,0,0,,Bu maçta Tsubasa Ozora'ya tamamen kaybettim.
Dialogue: 0,0:07:15.16,0:07:16.54,Default,,0,0,0,,{\i1}Kararımı verdim.{\i0}
Dialogue: 0,0:07:17.37,0:07:23.04,Default,,0,0,0,,{\i1}Bundan sonra amacım, Tsubasa, sizi yakalamak ve sonunda geride bırakmak.{\i0}
Dialogue: 0,0:07:23.04,0:07:28.10,Default,,0,0,0,,Tsubasa, Shizuoka İl turnuvasında üst üste üçüncü zaferiniz için tebrikler.
Dialogue: 0,0:07:28.10,0:07:29.30,Default,,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:07:29.30,0:07:35.32,Default,,0,0,0,,Bir kez daha Ulusal maçlara doğru ilerledin.\N Oynamak istediğin bir oyuncu var mı?
Dialogue: 0,0:07:35.32,0:07:37.56,Default,,0,0,0,,Oynamak istediğim biri mi?
Dialogue: 0,0:07:38.75,0:07:45.31,Default,,0,0,0,,Şu an en çok oynamak istediğim oyuncu Taro Misaki!
Dialogue: 0,0:07:45.31,0:07:46.06,Default,,0,0,0,,Misaki?
Dialogue: 0,0:07:46.06,0:07:47.15,Default,,0,0,0,,Taro?
Dialogue: 0,0:07:47.15,0:07:48.36,Default,,0,0,0,,Ne dedi?
Dialogue: 0,0:07:48.36,0:07:54.27,Default,,0,0,0,,Misaki'den kastın, ilkokulda ikili oluşturduğun Misaki'yi mi kastediyorsun?
Dialogue: 0,0:07:54.27,0:07:55.37,Default,,0,0,0,,Evet, öyle.
Dialogue: 0,0:07:56.05,0:08:00.54,Default,,0,0,0,,Ulusal Gençlik Futbol Turnuvasından bu yana, futbol dünyasında ismi hiç duyulmadı.
Dialogue: 0,0:08:00.54,0:08:06.89,Default,,0,0,0,,İnsanlar, o turnuva sırasında yaralanması nedeniyle geri dönemediğini söylüyor.
Dialogue: 0,0:08:06.89,0:08:09.63,Default,,0,0,0,,Bu imkansız. Burada Misaki'den bahsediyoruz!
Dialogue: 0,0:08:11.09,0:08:14.42,Default,,0,0,0,,Eminim hala bir yerlerde futbol oynuyordur.
Dialogue: 0,0:08:16.19,0:08:17.22,Default,,0,0,0,,Bundan eminim.
Dialogue: 0,0:08:18.75,0:08:23.48,Default,,0,0,0,,{\i1}Lanet olsun! En çok Misaki ile mi oynamak istiyor?{\i0}
Dialogue: 0,0:08:23.48,0:08:30.69,Default,,0,0,0,,{\i1}Tsubasa, bir kez daha hatırlatıyorum, müthiş Kojiro Hyuga, ben de Ulusal Turnuvadayım!{\i0}
Dialogue: 0,0:08:31.12,0:08:32.07,Default,,0,0,0,,Hadi yapalım!
Dialogue: 0,0:08:32.07,0:08:36.94,Default,,0,0,0,,Yarın Musashi Orta Okulu'nu parçalayacağız ve Tokyo temsilcileri olarak Ulusal maçlara gideceğiz!
Dialogue: 0,0:08:36.94,0:08:37.70,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:38.20,0:08:42.67,Default,,0,0,0,,{\i1}Shizuoka İl Turnuvası şampiyonu Nankatsu Ortaokulu.{\i0}
Dialogue: 0,0:08:45.60,0:08:46.96,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:08:47.42,0:08:48.54,Default,,0,0,0,,Kaybettik.
Dialogue: 0,0:08:48.54,0:08:51.21,Default,,0,0,0,,Bir söz verdim. Emirlerini bekliyorum.
Dialogue: 0,0:08:51.21,0:08:51.96,Default,,0,0,0,,Ne?
Dialogue: 0,0:08:52.61,0:08:55.78,Default,,0,0,0,,Sorun yok Urabe. Bunu unutalım.
Dialogue: 0,0:08:55.78,0:08:58.59,Default,,0,0,0,,Yapamam. Erkek sözü verdim.
Dialogue: 0,0:08:58.59,0:09:02.00,Default,,0,0,0,,O zaman bizi Ulusal maçlarda neşelendirin.
Dialogue: 0,0:09:02.00,0:09:02.77,Default,,0,0,0,,Bu yeterli.
Dialogue: 0,0:09:02.77,0:09:05.48,Default,,0,0,0,,Başka bir şey istemediğinden emin misin?
Dialogue: 0,0:09:05.48,0:09:06.93,Default,,0,0,0,,Evet.
Dialogue: 0,0:09:06.93,0:09:09.73,Default,,0,0,0,,Tamam o zaman! Sizin için çok tezahüarat yapacağım!
Dialogue: 0,0:09:09.73,0:09:11.85,Default,,0,0,0,,Karşılığında, kaybetmeye cüret etme.
Dialogue: 0,0:09:11.85,0:09:15.08,Default,,0,0,0,,Shizuoka İli'nin temsilcileri sizsiniz.
Dialogue: 0,0:09:15.08,0:09:16.24,Default,,0,0,0,,T-Tamam...
Dialogue: 0,0:09:19.03,0:09:19.60,Default,,0,0,0,,JAPON ULUSAL FUTBOL FEDERASYONU
Dialogue: 0,0:09:19.95,0:09:23.54,Default,,0,0,0,,2,5 yıllık eğitimi tamamladığınız için tebrikler Bay Mikami.
Dialogue: 0,0:09:23.54,0:09:26.42,Default,,0,0,0,,Teşekkürler, Katagiri-kun.
Dialogue: 0,0:09:26.42,0:09:29.19,Default,,0,0,0,,Kabalığımı bağışlayın, ama bahsettiğim belgeler burada.
Dialogue: 0,0:09:29.19,0:09:32.51,Default,,0,0,0,,Oh... Japonya’ya ayak bile atmadım, biliyorsun...
Dialogue: 0,0:09:32.51,0:09:38.58,Default,,0,0,0,,Bay Mikami, ulusal ortaokul seçim ekibinin koçu olacaksınız.
Dialogue: 0,0:09:38.58,0:09:41.66,Default,,0,0,0,,Bu çok önemli görevi halletmenizi istiyoruz.
Dialogue: 0,0:09:40.01,0:09:44.02,Default-TOP,,0,0,0,,ORTAOKUL FUTBOL TURNUVA SEÇİMİ İÇİN ADAY LİSTESİ
Dialogue: 0,0:09:41.72,0:09:44.02,Default,,0,0,0,,Yani dinlenecek zamanım olmayacak.
Dialogue: 0,0:09:44.52,0:09:46.82,Default,,0,0,0,,Wakabayashi-kun nasıl?
Dialogue: 0,0:09:46.82,0:09:48.77,Default,,0,0,0,,Her zamanki gibi çok çalışıyor.
Dialogue: 0,0:09:49.18,0:09:55.15,Default,,0,0,0,,Almanya'da üst düzey profesyonel oyuncular ile çevrili, becerileri hızla gelişiyor.
Dialogue: 0,0:09:56.14,0:10:00.37,Default,,0,0,0,,Orada olmasam bile, kendi başına yeterince iyi olacak.
Dialogue: 0,0:10:00.37,0:10:03.37,Default,,0,0,0,,Tsubasa'nın da büyüdüğü anlaşılıyor.
Dialogue: 0,0:10:03.37,0:10:05.27,Default,,0,0,0,,Evet tabi ki.
Dialogue: 0,0:10:05.27,0:10:09.38,Default,,0,0,0,,Japonya'da dengi olabilecek bir oyuncu olmadığını söyleyebilirim.
Dialogue: 0,0:10:09.38,0:10:14.67,Default,,0,0,0,,Tsubasa üçüncü bir Ulusal şampiyonluğa vararak efsane mi olacak 
Dialogue: 0,0:10:14.67,0:10:17.13,Default,,0,0,0,,yoksa rakipleri onu arkada mı bırakacak?
Dialogue: 0,0:10:17.82,0:10:23.14,Default-TOP,,0,0,0,,Tsubasa ve arkadaşlarının yaz'ı hızla yaklaşıyor.
Dialogue: 0,0:10:18.30,0:10:22.64,Default,,0,0,0,,{\fad(500,500)\pos(960,848.667)} HOKKAİDO FİNALLERİ FURANO ORTAOKULU - SATSUNISHI ORTAOKULU
Dialogue: 0,0:10:25.68,0:10:28.77,Default,,0,0,0,,{\fad(500,500)\pos(960,848.667)}FURANO ORTAOKUL KAPTANI \NHIKARU MATSUYAMA
Dialogue: 0,0:10:25.60,0:10:28.10,Default-TOP,,0,0,0,,{\i1}Furano'nun kasırgası Hokkaido'da.{\i0}
Dialogue: 0,0:10:28.10,0:10:28.76,Default,,0,0,0,,İşte!
Dialogue: 0,0:10:30.65,0:10:34.65,Default,,0,0,0,,Tamam, git! Yapabileceğimiz kadar çok gol atacağız!
Dialogue: 0,0:10:34.65,0:10:36.37,Default,,0,0,0,,Evet, kaptan!
Dialogue: 0,0:10:36.37,0:10:39.06,Default,,0,0,0,,{\i1}Bu Furano'nun tüm üyeleriyle nasıl oynadığıdır.{\i0}
Dialogue: 0,0:10:39.06,0:10:41.87,Default,,0,0,0,,{\i1}Onların takım çalışması Japonya'da hiç yok.{\i0}
Dialogue: 0,0:10:41.87,0:10:43.87,Default,,0,0,0,,Git! Vur!
Dialogue: 0,0:10:46.06,0:10:48.70,Default,,0,0,0,,{\i1}Maç biter! 7-0!{\i0}
Dialogue: 0,0:10:48.70,0:10:50.52,Default,,0,0,0,,{\ i1} Furano Ortaokulu kazandı! {\ i0}
Dialogue: 0,0:10:51.88,0:10:54.71,Default,,0,0,0,,{\i1}Furano kasırgasını Nationals'a götürmek {\i0}
Dialogue: 0,0:10:54.71,0:10:58.67,Default,,0,0,0,,{\i1}ve bu yıl şampiyonluk flamasıyla Hokkaido'ya geri dönmek istiyorlar.{\i0}
Dialogue: 0,0:10:58.67,0:11:01.47,Default,,0,0,0,,Bekle, Nankatsu...! Tsubasa!
Dialogue: 0,0:11:01.85,0:11:05.85,Default,,0,0,0,,{\fad(500,500)\pos(960,848.667)}AKITA İL FİNALi - HANAWA ORTAOKULU - SAKURADA ORTAOKULU
Dialogue: 0,0:11:02.34,0:11:07.85,Default-TOP,,0,0,0,,{\i1}Akita İl Müsabakaları finalindeyiz! Hanawa'nın Tachibana İkizleri futbolu mucizevi!{\i0}
Dialogue: 0,0:11:08.50,0:11:09.73,Default,,0,0,0,,Yine onlar!
Dialogue: 0,0:11:10.65,0:11:16.73,Default,,0,0,0,,{\i1}Sürekli değişen saldırılarıyla, bu ikisi Hanawa'nın gollerinin % 90'ını elde etti.\N{\i0}
Dialogue: 0,0:11:16.73,0:11:18.28,Default,,0,0,0,,Hadi yapalım Kazuo!
Dialogue: 0,0:11:18.28,0:11:19.36,Default,,0,0,0,,Evet, Masao!
Dialogue: 0,0:11:21.62,0:11:22.36,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:11:22.36,0:11:24.34,Default,,0,0,0,,{\i1}Bu maçın 5. gölü.{\i0}
Dialogue: 0,0:11:25.11,0:11:28.95,Default,,0,0,0,,Bu sene ulusal şampiyon olacağız.
Dialogue: 0,0:11:29.33,0:11:32.92,Default,,0,0,0,,{\fad(500,500)\pos(960,848.667)}OSAKA İL FİNALİ \NNANIWA ORTAOKULU - AZUMAICHI ORTAOKULU
Dialogue: 0,0:11:29.29,0:11:31.44,Default-TOP,,0,0,0,,{\i1}İkinci yarının uzatmalarındayız.{\i0}
Dialogue: 0,0:11:31.44,0:11:32.92,Default-TOP,,0,0,0,,{\i1}Naniwa mücadele ediyor!{\i0}
Dialogue: 0,0:11:33.71,0:11:37.88,Default,,0,0,0,,{\fad(500,500)\pos(960,848.667)}NANIWA ORTAOKULU \NTAICHI NAKANISHI
Dialogue: 0,0:11:33.21,0:11:36.70,Default-TOP,,0,0,0,,{\i1}Nakanishi'nin çabaları sayesinde skoru 0-0'da tutmuş olsalar bile,{\i0}
Dialogue: 0,0:11:36.70,0:11:38.53,Default-TOP,,0,0,0,,{\i1}bir gol bile atamıyorlar! {\i0}
Dialogue: 0,0:11:38.53,0:11:41.34,Default,,0,0,0,,{\i1}Lütfen, sadece bir gol! Sadece bir gol atın! {\i0}
Dialogue: 0,0:11:41.94,0:11:45.43,Default,,0,0,0,,{\ i1} Azumaichi'nin savunucusu Soda topu çaldı! {\ i0}
Dialogue: 0,0:11:45.43,0:11:48.14,Default,,0,0,0,,{\i1}Ulusallara gideceğim!{\i0}
Dialogue: 0,0:11:49.77,0:11:54.36,Default,,0,0,0,,Hadi, Nakanishi, Jilet Vuruşumun tadını çıkar!
Dialogue: 0,0:11:54.36,0:11:57.48,Default,,0,0,0,,{\ i1} Soda sahip olduğu her şeyle uzun bir atış yaptı! {\ i0}
Dialogue: 0,0:11:57.48,0:11:59.32,Default,,0,0,0,,Puan almana izin vermeyeceğim!
Dialogue: 0,0:12:00.48,0:12:01.36,Default,,0,0,0,,Ne?! 
Dialogue: 0,0:12:02.84,0:12:04.11,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:12:04.91,0:12:06.49,Default,,0,0,0,,{\i1}Naniwa yenildi!{\i0}
Dialogue: 0,0:12:06.49,0:12:10.80,Default,,0,0,0,,{\i1}Azumaichi Ortaokulu ilk kez Ulusallara bir bilet kazandı.{\i0}
Dialogue: 0,0:12:10.80,0:12:13.04,Default,,0,0,0,,Olamaz...
Dialogue: 0,0:12:13.04,0:12:15.04,Default,,0,0,0,,{\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}— TOKYO —
Dialogue: 0,0:12:15.94,0:12:19.89,Default,,0,0,0,,{\i1}Tüm o alkışları duyabiliyor musunuz?{\i0}
Dialogue: 0,0:12:19.89,0:12:26.14,Default,,0,0,0,,{\i1}2 yıllık rehabilitasyonundan sonra, Sahanın Genç Aslanı, Jun Misugi tekrar oyuna geri döndü!{\i0}
Dialogue: 0,0:12:29.01,0:12:34.02,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:12:34.02,0:12:38.78,Default,,0,0,0,,{\i1}Ulusal Gençlik Futbol Turnuvasından bu yana, "Cam Ası" Jun Misugi,{\i0}
Dialogue: 0,0:12:38.78,0:12:42.58,Default-TOP,,0,0,0,,{\i1}hala kalp hastalığıyla mücadele ederken, zorlu bir rehabilitasyon{\i0}
Dialogue: 0,0:12:42.58,0:12:46.74,Default-TOP,,0,0,0,,{\i1}sürecine devam ettikten sonra, ortaokulun 3. yılında geri dönüyor!{\i0}
Dialogue: 0,0:12:39.40,0:12:44.07,Default,,0,0,0,,{\fad(500,500)\pos(960,848.667)}MUSASHI MIDDLE ORTAOKULU KAPTAN \NJUN MISUGI
Dialogue: 0,0:12:47.61,0:12:51.75,Default,,0,0,0,,{\i1}Bir kez daha sahalara geri döndüm.{\i0}
Dialogue: 0,0:12:51.75,0:12:56.84,Default,,0,0,0,,{\i1}Kişisel doktoru, 30 dakikadan fazla süren yoğun egzersiz yapmasını yasakladığı için{\i0}
Dialogue: 0,0:12:56.84,0:12:58.50,Default,,0,0,0,,{\i1}tam zamanlı oynayamayacak.\N{\i0}
Dialogue: 0,0:12:58.50,0:13:06.27,Default,,0,0,0,,{\i1}Musashi'nin kadroya eklenmesiyle, bu sert turnuvanın finallerine doğru bir kestirme yol buldular.{\i0}
Dialogue: 0,0:13:06.27,0:13:10.31,Default,,0,0,0,,İki yıl aradan sonra bile, bu kadar iyi oynuyor. Ne muhteşem bir çocuk.
Dialogue: 0,0:13:11.10,0:13:13.51,Default,,0,0,0,,{\fad(500,500)\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}— 1 AY ÖNCE —
Dialogue: 0,0:13:11.62,0:13:13.31,Default-TOP,,0,0,0,,{\ i1} Tamam, sorun değil. {\ i0}
Dialogue: 0,0:13:13.77,0:13:15.98,Default,,0,0,0,,{\ i1} Bu doğru mu? {\ i0}
Dialogue: 0,0:13:15.98,0:13:20.60,Default,,0,0,0,,{\i1}Yani bana tekrar futbol oynayabileceğimi söylüyorsunuz, değil mi?{\i0}
Dialogue: 0,0:13:20.60,0:13:24.51,Default,,0,0,0,,{\i1}Sadece güçlü iradeni ve futbolla ilgili çabalarını reddedemem.{\i0}
Dialogue: 0,0:13:24.51,0:13:26.57,Default,,0,0,0,,{\i1}Turnuva için izin vereceğim.{\i0}
Dialogue: 0,0:13:27.35,0:13:28.31,Default,,0,0,0,,{\i1}İşte bu!{\i0}
Dialogue: 0,0:13:28.31,0:13:29.32,Default,,0,0,0,,{\i1}Sonunda yaptım!{\i0}
Dialogue: 0,0:13:29.32,0:13:31.91,Default,,0,0,0,,{\i1}Tebrikler, Kaptan.{\i0}
Dialogue: 0,0:13:31.91,0:13:33.66,Default,,0,0,0,,{\i1}Menejer!{\i0}
Dialogue: 0,0:13:33.66,0:13:38.48,Default,,0,0,0,,{\i1}Son 2 yılda bana bu kadar çok baktığın için teşekkür ederim.{\i0}
Dialogue: 0,0:13:38.48,0:13:41.17,Default,,0,0,0,,{\i1}Tekrar oynayabileceğim için teşekkürler.{\i0}
Dialogue: 0,0:13:43.92,0:13:44.97,Default,,0,0,0,,{\i1}Afedersin.{\i0} 
Dialogue: 0,0:13:44.97,0:13:46.67,Default,,0,0,0,,{\i1}Önemli değil.{\i0}
Dialogue: 0,0:13:47.95,0:13:49.93,Default,,0,0,0,,{\i1}Genç olmak keyifli.{\i0}
Dialogue: 0,0:13:50.64,0:13:52.97,Default,,0,0,0,,Elinden gelenin en iyisini yap Kaptan.
Dialogue: 0,0:13:54.14,0:13:56.73,Default,,0,0,0,,TOHO AKADEMİSİ - BEKLEME ODASI
Dialogue: 0,0:13:55.12,0:13:56.73,Default-TOP,,0,0,0,,Verilerden anlaşıldığı gibi,
Dialogue: 0,0:13:56.73,0:13:59.31,Default,,0,0,0,,Musashi, değişmeden önce ilk yarıda savunma yapar,
Dialogue: 0,0:13:59.31,0:14:02.23,Default,,0,0,0,,Misugi oyuna girdiğinde ikinci yarıda bahis oynar.
Dialogue: 0,0:14:04.03,0:14:07.24,Default,,0,0,0,,{\fad(500,500)\pos(960,848.667)}TOHO AKADEMİSİ KOÇU \NMAKOTO KITAZUME 
Dialogue: 0,0:14:02.23,0:14:04.94,Default-TOP,,0,0,0,,Dinleyin, ilk yarı bu maçın anahtarı.
Dialogue: 0,0:14:04.94,0:14:09.18,Default-TOP,,0,0,0,,Misugi dışarıdayken ilk yarıda serbestçe sayı alacağız ve girmeden önce bitireceğiz.
Dialogue: 0,0:14:09.18,0:14:10.24,Default,,0,0,0,,Evet!
Dialogue: 0,0:14:10.98,0:14:13.74,Default,,0,0,0,,Bu final maçını düzgün bir şekilde izlememiz lazım.
Dialogue: 0,0:14:13.74,0:14:16.62,Default,,0,0,0,,Nankatsu bizim tek rakibimiz değil.
Dialogue: 0,0:14:16.62,0:14:17.45,Default,,0,0,0,,Tamam.
Dialogue: 0,0:14:17.45,0:14:20.46,Default,,0,0,0,,{\i1}Her iki takım da ortaya çıkıyor.{\i0}
Dialogue: 0,0:14:23.82,0:14:30.13,Default,,0,0,0,,{\i1}Toho Akademi, Ulusal Turnuvada 3. olarak yer almayı amaçlayarak, şimdiye kadar as Hyuga'nın dinlenmesine{\i0}
Dialogue: 0,0:14:30.13,0:14:32.55,Default,,0,0,0,,{\i1}izin vermesine rağmen başlangıç olarak oynatıyor.{\i0}
Dialogue: 0,0:14:32.55,0:14:38.81,Default,,0,0,0,,{\i1}Musashi, Misugi'yi henüz oraya göndermiyor, maçı defansif bir formasyonla açıyor.{\i0}
Dialogue: 0,0:14:39.42,0:14:40.77,Default,,0,0,0,,Hey, Sanae.
Dialogue: 0,0:14:40.77,0:14:43.57,Default,,0,0,0,,Şimdi kayıt olacak, değil mi?
Dialogue: 0,0:14:47.66,0:14:49.03,Default,,0,0,0,,Tamam, bu kadar!
Dialogue: 0,0:14:49.03,0:14:51.32,Default,,0,0,0,,Bitti mi?
Dialogue: 0,0:14:51.32,0:14:53.26,Default,,0,0,0,,Çünkü dün oynadık.
Dialogue: 0,0:14:53.26,0:14:56.21,Default,,0,0,0,,Vücudunuzun dinlenip bugün için soğumasına izin vermelisiniz.
Dialogue: 0,0:14:56.21,0:14:57.09,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:57.09,0:15:00.67,Default,,0,0,0,,Pekala, şimdi Tokyo Turnuvasına bir göz atabilirim.
Dialogue: 0,0:15:04.09,0:15:07.42,Default,,0,0,0,,Burada dinlenmenin anlamını bilmeyen biri var.
Dialogue: 0,0:15:07.42,0:15:11.19,Default,,0,0,0,,Tsubasa! Tokyo Turnuvası finalleri başlamak üzere.
Dialogue: 0,0:15:11.19,0:15:12.85,Default,,0,0,0,,Birkaç dakika daha ver.
Dialogue: 0,0:15:17.40,0:15:18.35,Default,,0,0,0,,Bu iyi değil.
Dialogue: 0,0:15:19.33,0:15:22.44,Default,,0,0,0,,{\i1}"Uzun vuruşlarınızı Drive Shot'la yapın."{\i0}
Dialogue: 0,0:15:22.44,0:15:26.69,Default,,0,0,0,,{\i1}"Bu şutta ustalaşmadıkça, birinci sınıf bir oyuncu olamayacaksınız," değil mi?{\i0}
Dialogue: 0,0:15:27.61,0:15:33.57,Default,,0,0,0,,{\i1}Genellikle vücut ağırlığınızla topa vurursunuz, bu yüzden çok yüksek uçmaz.{\i0}
Dialogue: 0,0:15:33.57,0:15:36.74,Default,,0,0,0,,{\ i1} Bunun için bir sonraki seviye Drive Shot. {\ i0}
Dialogue: 0,0:15:37.44,0:15:43.75,Default,,0,0,0,,{\i1}Bu atış, yüksekten uçtuktan sonra kaleciyi aşar sonra keskin bir dalış yapar ve sayı alır.{\i0}
Dialogue: 0,0:15:44.32,0:15:46.75,Default,,0,0,0,,{\i1}Roberto, ustalaşmak zor.{\i0}
Dialogue: 0,0:15:47.78,0:15:50.66,Default,,0,0,0,,{\i1}Yanlardan eklenen dönüşlerle çekim yapmak kolay,{\i0}
Dialogue: 0,0:15:50.66,0:15:54.80,Default,,0,0,0,,{\i1}ancak bir topa nasıl bir dönüş ekleyebilirim?{\i0}
Dialogue: 0,0:15:55.81,0:16:00.30,Default,,0,0,0,,{\i1}Bana temelleri göstermek için burada olsaydın, çabucak çözebilirdim.{\i0}
Dialogue: 0,0:16:00.30,0:16:02.64,Default,,0,0,0,,{\ i1} Sanırım kendi başıma pratik yapmalıyım. {\ i0}
Dialogue: 0,0:16:03.99,0:16:06.42,Default,,0,0,0,,{\ i1} Roberto, sadece bir yıl daha. {\ i0}
Dialogue: 0,0:16:06.42,0:16:08.30,Default,,0,0,0,,{\ i1} Daha sonra Brezilya'ya gideceğim. {\ i0}
Dialogue: 0,0:16:09.87,0:16:15.05,Default,,0,0,0,,Kahretsin, yalnız başına antrenman yapmasına izin veremeyiz!
Dialogue: 0,0:16:15.05,0:16:17.03,Default,,0,0,0,,Tamam çocuklar, biz de antrenman yapacağız!
Dialogue: 0,0:16:17.03,0:16:17.80,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:16:17.80,0:16:18.76,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:18.76,0:16:20.66,Default,,0,0,0,,Biz de eşlik edeceğiz.
Dialogue: 0,0:16:20.66,0:16:25.51,Default,,0,0,0,,{\i1}Sanae-chan, Tsubasa-kun ile nasıl gidiyor?{\i0}
Dialogue: 0,0:16:25.51,0:16:27.38,Default,,0,0,0,,{\ i1} Her şey yolunda mı? {\ i0}
Dialogue: 0,0:16:27.38,0:16:30.88,Default,,0,0,0,,{\ i1} İlişkimiz gördüğün gibi böyle. {\ i0}
Dialogue: 0,0:16:35.86,0:16:38.93,Default,,0,0,0,,{\i1}Yayoi-chan, bizim için imkansız.{\i0}
Dialogue: 0,0:16:38.93,0:16:42.94,Default,,0,0,0,,{\i1}Tsubasa 'nın tüm gözü futbolda.{\i0}
Dialogue: 0,0:16:45.88,0:16:47.98,Default,,0,0,0,,{\i1}Toho ve Musashi...{\i0}
Dialogue: 0,0:16:47.98,0:16:49.98,Default,,0,0,0,,{\i1}Hyuga ve Misugi arasında bir çekişme, ha?{\i0}
Dialogue: 0,0:16:49.98,0:16:54.24,Default,,0,0,0,,{\i1}Hangi taraf kazanırsa kazasın, kazanan en sonunda ben olurum!{\i0}
Dialogue: 0,0:16:54.24,0:16:55.58,Default,,0,0,0,,{\i1}Git!{\i0}
Dialogue: 0,0:16:55.58,0:16:59.49,Default,,0,0,0,,{\i1}Sawada, Musashi'nin yoğun savunmasını kesti.{\i0}
Dialogue: 0,0:16:59.49,0:17:01.04,Default,,0,0,0,,İyi gidiyor, Takeshi.
Dialogue: 0,0:17:06.73,0:17:08.21,Default,,0,0,0,,{\i1}Üçüncü gol!{\i0}
Dialogue: 0,0:17:08.21,0:17:08.64,Default,,0,0,0,,Hah!
Dialogue: 0,0:17:08.64,0:17:11.13,Default,,0,0,0,,{\i1}Zaten ilk yarıda bir hat-trick attı!{\i0}
Dialogue: 0,0:17:11.13,0:17:14.88,Default,,0,0,0,,{\i1}Kojiro Hyuga, aslında bütün ülkede hüküm süren atakçı.{\i0}
Dialogue: 0,0:17:15.36,0:17:18.14,Default,,0,0,0,,{\i1}Toho, takımıda inanılmaz derecede güçlü.{\i0}
Dialogue: 0,0:17:18.14,0:17:21.11,Default,,0,0,0,,{\i1}Öte yandan, Musashi, defansif ilk yarıda bu kadar çok ödün veriyor{\i0}
Dialogue: 0,0:17:21.11,0:17:22.93,Default,,0,0,0,,{\i1}ve son derece acı verici bir darbe alıyor.{\i0}
Dialogue: 0,0:17:23.72,0:17:25.71,Default,,0,0,0,,Koç, oynayacağım.
Dialogue: 0,0:17:25.71,0:17:27.94,Default,,0,0,0,,Ama Misugi, ikinci yarıda oynamalısın.
Dialogue: 0,0:17:28.35,0:17:31.68,Default,,0,0,0,,Başka gollerde olursa, bunu kazanamayacağız.
Dialogue: 0,0:17:31.68,0:17:33.52,Default,,0,0,0,,30 dakika geçince ayrılacağım.
Dialogue: 0,0:17:33.52,0:17:34.95,Default,,0,0,0,,Bırak oynayayım Koç.
Dialogue: 0,0:17:36.11,0:17:39.03,Default,,0,0,0,,{\i1}Musashi burada bir değişiklik yapmaya karar verir.{\i0}
Dialogue: 0,0:17:42.23,0:17:43.75,Default,,0,0,0,,{\i1}İlk yarının 20 dakikası kaldı.{\i0}
Dialogue: 0,0:17:43.75,0:17:46.33,Default,,0,0,0,,{\ i1} Misugi oyuna giriyor! {\ i0}
Dialogue: 0,0:17:46.33,0:17:49.71,Default,,0,0,0,,{\i1}Daha fazla gol olmaması düşüncesiyle sert bir strateji.{\i0}
Dialogue: 0,0:17:49.71,0:17:51.70,Default,,0,0,0,,{\i1}Faydasız, Misugi.{\i0} 
Dialogue: 0,0:17:51.70,0:17:56.22,Default,,0,0,0,,{\i1}Şu an çıksan bile, Toho Akademisi'nin kaybetmesinin bir yolu yok.{\i0}
Dialogue: 0,0:17:56.97,0:17:59.50,Default,,0,0,0,,Üzgünüz, üç kez sayı almalarına izin verdik.
Dialogue: 0,0:17:59.50,0:18:00.60,Default,,0,0,0,,Ne diyorsun?
Dialogue: 0,0:18:00.60,0:18:02.46,Default,,0,0,0,,Sadece üç gol.
Dialogue: 0,0:18:02.46,0:18:05.10,Default,,0,0,0,,10 dakika bu yarıda kaldı, ikinci yarıda 30 daha kaldı.
Dialogue: 0,0:18:05.10,0:18:08.23,Default,,0,0,0,,Her 10 dakikada bir puan alırsak, kazanabiliriz.
Dialogue: 0,0:18:08.23,0:18:10.15,Default,,0,0,0,,Bak, şimdi başlıyor!
Dialogue: 0,0:18:10.15,0:18:13.74,Default,,0,0,0,,Musashi'nin futbolunun gerçekten neye benzediğini onlara tattıralım!
Dialogue: 0,0:18:13.74,0:18:14.74,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:14.74,0:18:18.84,Default,,0,0,0,,{\i1}Misugi gelir gelmez Musashi hücuma geçiyor.{\i0}
Dialogue: 0,0:18:18.84,0:18:20.16,Default,,0,0,0,,{\ i1} Maç devam ediyor! {\ i0}
Dialogue: 0,0:18:23.20,0:18:27.93,Default,,0,0,0,,{\i1}Musashi, topu kontrol kulesine emanet ederek, bir oyun kurucusu olarak ona güveniyor.{\i0}
Dialogue: 0,0:18:28.76,0:18:32.67,Default,,0,0,0,,{\ i1} Toho'nun bu maçtaki ezici gücü tersine dönecek mi? {\ i0}
Dialogue: 0,0:18:32.67,0:18:34.09,Default,,0,0,0,,Hadi Misugi.
Dialogue: 0,0:18:34.09,0:18:35.80,Default,,0,0,0,,Bir tebrik olarak al!
Dialogue: 0,0:18:37.86,0:18:38.55,Default,,0,0,0,,Ne?!
Dialogue: 0,0:18:38.55,0:18:40.21,Default,,0,0,0,,Git, Takeshi!
Dialogue: 0,0:18:41.38,0:18:42.18,Default,,0,0,0,,Sawada!
Dialogue: 0,0:18:43.43,0:18:44.43,Default,,0,0,0,,Yakaladım seni!
Dialogue: 0,0:18:45.68,0:18:46.43,Default,,0,0,0,,Ne?!
Dialogue: 0,0:18:47.50,0:18:50.94,Default,,0,0,0,,{\i1}Tetikte olmamasına rağmen, Misugi zarif bir sıçrama yapıyor!{\i0}
Dialogue: 0,0:18:51.94,0:18:53.94,Default,,0,0,0,,Hadi gidelim! İlk golümüzü şimdi atacağız!
Dialogue: 0,0:18:53.94,0:18:54.69,Default,,0,0,0,,Tamam!
Dialogue: 0,0:18:54.69,0:18:58.18,Default,,0,0,0,,{\i1}Musashi'nin ileri gelen üçlüsü, hedefe doğru ilerliyor.{\i0}
Dialogue: 0,0:18:58.18,0:19:00.70,Default,,0,0,0,,{\i1}Ne tür bir pas atacak ve kime?{\i0}
Dialogue: 0,0:19:00.70,0:19:02.99,Default,,0,0,0,,Adam adama poziyonuna geçin!
Dialogue: 0,0:19:02.99,0:19:05.65,Default,,0,0,0,,{\i1}Toho'nun savunucuları üçlüyü tutuyor.{\i0}
Dialogue: 0,0:19:05.65,0:19:12.25,Default,,0,0,0,,{\i1}Kaleyi koruyan kişi, bu turnuvada bir gol attırmayan 1. ortaokul kalecisi, Wakashimazu!{\i0}
Dialogue: 0,0:19:12.25,0:19:13.91,Default,,0,0,0,,{\ i1} İşte geliyorum, Toho. {\ i0}
Dialogue: 0,0:19:13.91,0:19:17.98,Default,,0,0,0,,{\i1}İki yılımı feda ettim ve bu 3. yılda herşeye bahse girdim.{\i0}
Dialogue: 0,0:19:17.98,0:19:21.01,Default,,0,0,0,,{\i1}Ulusal maçlara gitmeden önce burada kaybedeceğimi mi{\i0}
Dialogue: 0,0:19:21.01,0:19:24.01,Default,,0,0,0,,{\i1}düşünüyorsunuz? Tsubasa'yla buluşmadan önce mi?{\i0}
Dialogue: 0,0:19:25.26,0:19:26.14,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:26.14,0:19:27.98,Default,,0,0,0,,{\i1}Bu beklenmedik!{\i0}
Dialogue: 0,0:19:27.98,0:19:32.40,Default,,0,0,0,,{\i1}Savunmayı geride bıraktı ve topu tutarak kaleye giden yolu korudu!{\i0}
Dialogue: 0,0:19:32.40,0:19:34.15,Default,,0,0,0,,Saçmalık, bizi dışarıda bıraktı!
Dialogue: 0,0:19:37.89,0:19:40.48,Default,,0,0,0,,{\i1}İçerde! 3-1!{\i0}
Dialogue: 0,0:19:40.48,0:19:42.62,Default,,0,0,0,,{\i1}Misugi maça katıldıktan sadece 1 dakika 30 saniye{\i0}
Dialogue: 0,0:19:42.62,0:19:46.49,Default,,0,0,0,,{\i1}sonra, Musashi karşı saldırı yaptı ve ilk golleri!{\i0}
Dialogue: 0,0:19:46.49,0:19:48.29,Default,,0,0,0,,Tamam çocuklar, başlıyoruz!
Dialogue: 0,0:19:49.13,0:19:50.00,Default,,0,0,0,,Tamam!
Dialogue: 0,0:19:50.00,0:19:52.50,Default,,0,0,0,,Lanet olsun Misugi.
Dialogue: 0,0:19:52.50,0:19:57.90,Default,,0,0,0,,Misugi'nin topu tek başına tuttuğu ve şu ana kadar tek başına attığı bir durum yoktu, değil mi?
Dialogue: 0,0:19:57.90,0:20:01.51,Default,,0,0,0,,Evet. Her oyunda Misugi'nin asistleriyle gol attılar.
Dialogue: 0,0:20:01.51,0:20:06.88,Default,,0,0,0,,{\i1}Kalbini zorlamadan geçmeye odaklandığını düşündüm,{\i0}
Dialogue: 0,0:20:06.88,0:20:09.98,Default,,0,0,0,,{\i1}ama bireysel yeteneklerini her zaman kullanabiliyordu.{\i0}
Dialogue: 0,0:20:09.98,0:20:15.98,Default,,0,0,0,,{\i1}Bu senin için harika Jun Misugi. Ancak, bu 3-1'lik skorla ilk yarıyı sona erdireceğiz.{\i0}
Dialogue: 0,0:20:15.98,0:20:21.49,Default,,0,0,0,,{\i1}Sawada, sadece Hyuga'ya saldırıyı bırakacağız ve ilk yarıda savunmaya odaklanacağız.{\i0}
Dialogue: 0,0:20:21.49,0:20:22.99,Default,,0,0,0,,{\i1}Anladım!{\i0}
Dialogue: 0,0:20:22.99,0:20:24.08,Default,,0,0,0,,{\i1}Lanet olsun, Misugi.{\i0}
Dialogue: 0,0:20:24.08,0:20:25.22,Default,,0,0,0,,{\i1}Bunu ödeteceğim!{\i0}
Dialogue: 0,0:20:25.22,0:20:27.74,Default,,0,0,0,,{\i1}Bu sefer gol atacağım.{\i0}
Dialogue: 0,0:20:27.74,0:20:30.15,Default,,0,0,0,,{\i1}Maç Toho'nun vuruşuyla devam ediyor.{\i0}
Dialogue: 0,0:20:31.23,0:20:33.71,Default,,0,0,0,,Sayı verdiğinde gol atmak benim futbolum!
Dialogue: 0,0:20:33.71,0:20:37.04,Default,,0,0,0,,{\i1}Hyuga, ilk golü kabul etti.{\i0}
Dialogue: 0,0:20:37.04,0:20:38.18,Default,,0,0,0,,{\i1}Bu olduğunda...{\i0}
Dialogue: 0,0:20:38.18,0:20:38.55,Default,,0,0,0,,Hadi!
Dialogue: 0,0:20:38.55,0:20:39.55,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:40.26,0:20:44.05,Default,,0,0,0,,{\i1}Hızımla kimse beni geçemez!{\i0}
Dialogue: 0,0:20:44.05,0:20:44.72,Default,,0,0,0,,Şimdi!
Dialogue: 0,0:20:46.33,0:20:49.37,Default,,0,0,0,,{\i1}Misugi'nin kesin olarak amaçladığı bir takım oyunu!{\i0}
Dialogue: 0,0:20:50.02,0:20:54.52,Default,,0,0,0,,Futbol sadece bireysel yeteneklerle ilgili değildir, takım oyunu da önemlidir, Hyuga.
Dialogue: 0,0:20:54.52,0:20:55.77,Default,,0,0,0,,Seni küçük...!
Dialogue: 0,0:20:55.77,0:20:58.77,Default,,0,0,0,,{\i1}Musashi hızlı pasla sahada yükseldi!{\i0}
Dialogue: 0,0:20:58.77,0:21:02.03,Default,,0,0,0,,{\i1}Misugi'nin oyuna girmesiyle oyun Musashi'nin düzenine girdi!{\i0}
Dialogue: 0,0:21:02.03,0:21:08.20,Default,,0,0,0,,{\i1}Toho şimdiye kadar mükemmel bir şekilde oynadı, ancak bir golü hemen kabul ettiler.{\i0}
Dialogue: 0,0:21:08.20,0:21:10.70,Default,,0,0,0,,{\ i1} Bu zihinsel şok onlar için çok büyük. {\ i0}
Dialogue: 0,0:21:11.11,0:21:11.70,Default,,0,0,0,,Honma!
Dialogue: 0,0:21:12.58,0:21:15.46,Default,,0,0,0,,{\ i1} Sawada, Honma'ya yönelen pası kesti!{\i0}
Dialogue: 0,0:21:15.46,0:21:16.71,Default,,0,0,0,,Tamam, buraya gönder, Takeshi!
Dialogue: 0,0:21:18.71,0:21:22.23,Default,,0,0,0,,{\ i1} Misugi Sawada'nın pasını okudu ve kesti! {\ i0}
Dialogue: 0,0:21:22.23,0:21:24.13,Default,,0,0,0,,{\ i1} Misugi, burada çalım için tehdit ediyor! {\i0}
Dialogue: 0,0:21:27.02,0:21:28.26,Default,,0,0,0,,{\i1}Hayır pas attı!{\i0}
Dialogue: 0,0:21:28.26,0:21:30.51,Default,,0,0,0,,{\i1}Zarif bir ikili pası yaptı.{\i0}
Dialogue: 0,0:21:30.51,0:21:34.02,Default,,0,0,0,,Seni yakaladım, şimdi de başrole iş düşer!
Dialogue: 0,0:21:35.23,0:21:37.98,Default,,0,0,0,,Sanki tekrar sayı veririmde!
Dialogue: 0,0:21:39.26,0:21:40.56,Default,,0,0,0,,{\i1}Yakaladı!{\i0}
Dialogue: 0,0:21:40.56,0:21:43.24,Default,,0,0,0,,{\i1}Wakashimazu mükemmel bir zıplama yakalayıcısı!{\i0}
Dialogue: 0,0:21:45.53,0:21:47.66,Default,,0,0,0,,{\ i1} Tamda senden beklendiği gibi Wakashimazu. {\ i0}
Dialogue: 0,0:21:47.66,0:21:50.74,Default,,0,0,0,,{\i1}Hız, çeviklik ve atlama becerisi.{\i0}
Dialogue: 0,0:21:50.74,0:21:53.25,Default,,0,0,0,,{\i1}Uzun mesafeden sayı alamayacağım gibi görünüyor.{\i0}
Dialogue: 0,0:21:54.26,0:21:56.00,Default,,0,0,0,,{\i1}İlk yarı burada sona eriyor!{\i0}
Dialogue: 0,0:21:56.00,0:21:59.50,Default,,0,0,0,,{\i1}Misugi geldiğinde maçın hızı Musashi'nin lehine akmaya başladı.{\i0}
Dialogue: 0,0:21:59.50,0:22:04.13,Default,,0,0,0,,{\i1}Ancak Toho bu karşı saldırıyı savuşturmayı başardı ve tek bir gole taşıdı.{\i0}
Dialogue: 0,0:22:04.13,0:22:06.35,Default,,0,0,0,,{\i1}Kimsenin benim yoluma çıkmasına izin vermeyeceğim.{\i0}
Dialogue: 0,0:22:06.35,0:22:11.35,Default,,0,0,0,,{\i1}Ulusal maçlara katılan ve Tsubasa'yı yenen kişi ben olucam!{\i0}
Dialogue: 0,0:22:11.35,0:22:15.38,Default,,0,0,0,,{\i1}Yine Tsubasa'ya karşı savaşana kadar kaybetmeyeceğim!{\i0}
