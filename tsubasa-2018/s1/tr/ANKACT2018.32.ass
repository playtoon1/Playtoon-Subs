Dialogue: 0,0:23:49.57,0:24:03.17,Default,,0,0,0,,GELECEK BÖLÜM 33: \NTOKYO TURNUVASININ SONUCU
Dialogue: 0,0:01:16.22,0:01:18.93,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:19.85,0:01:22.52,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:23.43,0:01:26.14,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:33.03,0:01:35.86,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:35.86,0:01:42.12,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:01:42.12,0:01:48.00,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta na no ni
Dialogue: 0,0:01:48.00,0:01:54.59,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:01:54.59,0:01:58.59,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:58.59,0:02:03.10,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:02:03.10,0:02:08.64,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:02:08.64,0:02:10.23,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:02:10.23,0:02:11.44,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:11.44,0:02:14.94,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:02:14.94,0:02:24.83,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:02:24.83,0:02:25.66,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:25.66,0:02:29.46,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:02:29.46,0:02:33.46,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:02:33.46,0:02:39.72,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:02:39.72,0:02:42.51,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:01:16.22,0:01:18.93,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:19.85,0:01:22.52,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:23.43,0:01:26.14,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:33.03,0:01:35.86,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum. {I keep lying to myself}
Dialogue: 0,0:01:35.86,0:01:42.12,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile {burning with loneliness}
Dialogue: 0,0:01:42.12,0:01:48.00,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:48.00,0:01:54.59,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:54.59,0:01:58.59,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:58.59,0:02:03.10,OPED,,0,0,0,,Sesinin özlemi{i hate how weak I am \N yearning for your voice}
Dialogue: 0,0:02:03.10,0:02:08.64,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:02:08.64,0:02:10.23,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:02:10.23,0:02:11.44,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:11.44,0:02:14.94,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:02:14.94,0:02:24.83,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:02:24.83,0:02:25.66,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:25.66,0:02:29.46,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:02:29.46,0:02:33.46,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:02:33.46,0:02:39.72,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:39.72,0:02:42.51,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.79,0:22:44.84,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.84,0:22:50.84,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.84,0:22:56.89,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.89,0:23:01.52,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:03.15,0:23:07.82,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:09.15,0:23:15.24,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:15.24,0:23:21.29,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.29,0:23:25.75,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:27.05,0:23:33.39,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.39,0:23:39.43,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.43,0:23:45.73,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.79,0:22:44.84,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.84,0:22:50.84,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.84,0:22:56.89,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.89,0:23:01.52,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.15,0:23:07.82,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:09.15,0:23:15.24,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:15.24,0:23:21.29,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.29,0:23:25.75,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:27.05,0:23:33.39,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.39,0:23:39.43,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.43,0:23:45.73,OPED,,0,0,0,,Bu hırslı gençlik sahada!
