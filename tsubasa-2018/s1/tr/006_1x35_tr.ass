Comment: 0,0:13:12.93,0:13:12.93,Default,,0,0,0,,BÖLÜM B:
Dialogue: 0,0:00:00.93,0:00:03.92,Default,,0,0,0,,Geleneksel turnuvaya girme hakkı kazandıktan sonra
Dialogue: 0,0:00:03.92,0:00:08.52,Default,,0,0,0,,Tsubasa Wakabayashi'den Taro Misaki'nin şu anda Fransa'da olduğunu öğrendi.
Dialogue: 0,0:00:08.52,0:00:11.07,Default,,0,0,0,,{\i1}Eski arkadaşından haber aldıktan sonra,{\i0} {is doing there}
Dialogue: 0,0:00:11.07,0:00:13.91,Default,,0,0,0,,{\i1}Tsubasa daha da hırslandı!{\i0} {i'd like to say "gets even more fired up" but yaruki juubun ni naru? wth narrator-san?ikr but we can use completely here}
Dialogue: 0,0:00:13.91,0:00:16.57,Default,,0,0,0,,{\i1}Bu sırada daha güçlü olmayı ümit eden{\i0}
Dialogue: 0,0:00:16.57,0:00:22.04,Default,,0,0,0,,{\i1}Kojiro Koç Kira'nın yerinde ağır bir antremandan geçti.{\i0}
Dialogue: 0,0:00:24.34,0:00:28.04,Default,,0,0,0,,Kaplan artık uykusundan uyandı!
Dialogue: 0,0:00:28.04,0:00:30.42,Default,,0,0,0,,{\i1}Kojiro'nun eforunun karşısında{\i0}
Dialogue: 0,0:00:30.42,0:00:34.90,Default,,0,0,0,,{\i1}Tsubasa da ölü yaprak vuruşunu yapmak için çok çalışıyordu.{\i0}
Dialogue: 0,0:00:35.80,0:00:38.89,Default,,0,0,0,,{\i1}Ve sonunda Geleneksel Turnuva'nın günü geldi.{\i0}
Dialogue: 0,0:00:38.89,0:00:42.73,Default,,0,0,0,,{\i1}Kojiro eğitimini tamamladıktan \Nsonra takımının yanına döndü.{\i0}
Dialogue: 0,0:00:42.73,0:00:44.06,Default,,0,0,0,,{\i1}Ancak...{\i0}
Dialogue: 0,0:00:45.26,0:00:48.79,Default,,0,0,0,,Hyuga, seni bu turnuvada oynatamam. {What an ass}{Aykut kocaman to Alex de souza}
Dialogue: 0,0:00:50.07,0:00:56.18,Default,,0,0,0,,{\i1}Geleneksel Turnuva'da beklenmedik olaylar yaşanıyor!{\i0} {like, up and downs}{like it falls for him. the use the word for "fall"}{the curtain should "rise" on the nationals, right? narrator-san is confusing me }
Dialogue: 0,0:00:58.41,0:01:01.20,Default,,0,0,0,,{\i1}Bütün okullar ilgisini ilk maça yöneltmiş durumda.{\i0}
Dialogue: 0,0:01:01.20,0:01:05.04,Default,,0,0,0,,Geleneksek Ortaokul Futbol Turnuvası'nın açılış maçı
Dialogue: 0,0:01:05.04,0:01:10.34,Default,,0,0,0,,Shizuoka'dan Nankatsu ile Osaka'dan Azumaichi arasında olucak.
Dialogue: 0,0:01:10.34,0:01:12.55,Default,,0,0,0,,Maç birazdan başlayacak.
Dialogue: 0,0:01:15.54,0:01:19.27,Default,,0,0,0,,Nankatsu tarihinde ilk olacak olan 3. şampiyonluğu hedefliyor.
Dialogue: 0,0:01:19.27,0:01:24.10,Default,,0,0,0,,Ve amaçlarına ulaşmadaki ilk adım olan maça Tsubasa kaptanlık yapacak.
Dialogue: 0,0:01:24.10,0:01:27.24,Default,,0,0,0,,{\i1}Azumaichi MS geçen senin Osaka temsilcisi olan Naniwa MS'yi yenip
Dialogue: 0,0:01:27.24,0:01:29.36,Default,,0,0,0,,bu sene ilk defa bu turnuvaya katıldı.
Dialogue: 0,0:01:29.36,0:01:32.69,Default,,0,0,0,,Namağlup Nankatsu'yla oynayacak olmalarına rağmen yüzlerin en ufak bir gerginlik bile yok.
Dialogue: 0,0:01:35.72,0:01:39.49,Default,,0,0,0,,{\i1}Azumaichi'nin defansını Soda baskı yapmaya koşuyor.
Dialogue: 0,0:01:39.49,0:01:41.74,Default,,0,0,0,,Bu kadar yavaş oynama!
Dialogue: 0,0:01:43.20,0:01:44.70,Default,,0,0,0,,İşte! Al bunu!
Dialogue: 0,0:01:44.70,0:01:46.16,Default,,0,0,0,,Uzaktan bir orta açıyor!
Dialogue: 0,0:01:46.16,0:01:48.00,Default,,0,0,0,,Sanki izin vericem!
Dialogue: 0,0:01:48.00,0:01:51.75,Default,,0,0,0,,Tsubasa topu yakalıyor!
Dialogue: 0,0:01:52.18,0:01:53.96,Default,,0,0,0,,Helal, Tsubasa!
Dialogue: 0,0:01:53.96,0:01:55.26,Default,,0,0,0,,Bu şerefsiz...
Dialogue: 0,0:01:55.26,0:01:59.72,Default,,0,0,0,,İki takımın da as oyuncuları hırstan alev alev yanıyor!
Dialogue: 0,0:02:01.18,0:02:03.18,AnimeSeverler,,0,0,0,,'{\b0}Anime{\b1} Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr  \NÇevirmen; Brook ( {\c&HD67C65&}Soul King {\c})
Dialogue: 0,0:02:01.97,0:03:31.98,Default,,0,0,0,,{OP}
Dialogue: 0,0:03:32.10,0:03:36.23,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}BÖLÜM 35: \NBIÇAK'IN GÜCÜ PATLIYOR
Dialogue: 0,0:03:36.27,0:03:37.38,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:03:37.38,0:03:41.07,Default,,0,0,0,,3. şampiyonluğu hedeflerken bu maçı hafife almam.
Dialogue: 0,0:03:41.64,0:03:46.08,Default,,0,0,0,,Karşımıza kim gelirse gelsin, her bir maç için elimden geleni yapacağım.
Dialogue: 0,0:03:47.83,0:03:49.35,Default,,0,0,0,,Tsubasa'yı takip edin.
Dialogue: 0,0:03:49.35,0:03:50.00,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:50.00,0:03:52.04,Default,,0,0,0,,Soda da hemen arkasında.
Dialogue: 0,0:03:52.04,0:03:54.92,Default,,0,0,0,,Bu maçın yıldızı olmana izin vermeyeceğim!
Dialogue: 0,0:03:55.94,0:03:58.14,Default,,0,0,0,,Soda Tsubasa'nın hızına ayak uyduruyor!
Dialogue: 0,0:03:58.14,0:04:01.63,Default,,0,0,0,,Boş konuşmuyormuş meğer!
Dialogue: 0,0:04:01.63,0:04:02.47,Default,,0,0,0,,Kayboldu!
Dialogue: 0,0:04:03.39,0:04:05.19,Default,,0,0,0,,Bıçak Çelmesi
Dialogue: 0,0:04:05.19,0:04:06.08,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:06.08,0:04:14.40,Default,,0,0,0,,Soda Tsubasa'nın görüş alanından çıkmak için yerini değiştirip güçlü bir çelme attı!
Dialogue: 0,0:04:14.77,0:04:16.52,Default,,0,0,0,,Bıçak Çelmesi mi dedi?
Dialogue: 0,0:04:16.52,0:04:17.90,Default,,0,0,0,,Çok sert bir hareketti!
Dialogue: 0,0:04:19.28,0:04:20.99,Default,,0,0,0,,Güzel! Bu sefer sıra bizde!
Dialogue: 0,0:04:21.90,0:04:23.22,Default,,0,0,0,,Hadi gidelim beyler!
Dialogue: 0,0:04:23.22,0:04:24.20,Default,,0,0,0,,Hızlı bir atak yapalım!
Dialogue: 0,0:04:24.20,0:04:29.49,Default,,0,0,0,,Nankatsu'nun defansının ve forvetinin mihenk taşı olan Tsubasa yerdeyken Azumaichi MS atağa kalkıyor!
Dialogue: 0,0:04:30.24,0:04:31.62,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:04:32.25,0:04:33.50,Default,,0,0,0,,İşte!
Dialogue: 0,0:04:33.50,0:04:37.67,Default,,0,0,0,,{\i1}Azumaichi MS'nin bugünkü ilk şansı!
Dialogue: 0,0:04:37.67,0:04:38.25,Default,,0,0,0,,Gellan buraya!
Dialogue: 0,0:04:38.67,0:04:39.30,Default,,0,0,0,,İşte geliyor!
Dialogue: 0,0:04:39.30,0:04:42.09,Default,,0,0,0,,{\i1}Ide Nankatsu'nun kalesinin \N pozisyon almış durumda.{\i0}
Dialogue: 0,0:04:42.09,0:04:44.43,Default,,0,0,0,,{\i1}Onodera onu bekliyor!{\i0}
Dialogue: 0,0:04:45.26,0:04:46.39,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:46.39,0:04:47.64,Default,,0,0,0,,Pekala!
Dialogue: 0,0:04:47.64,0:04:51.85,Default,,0,0,0,,Defansın merkezi Soda boşta!
Dialogue: 0,0:04:52.85,0:04:53.88,Default,,0,0,0,,Şut çekmesine izin vermeyin!
Dialogue: 0,0:04:53.88,0:04:55.48,Default,,0,0,0,,Açısını kapatın!
Dialogue: 0,0:04:56.58,0:04:59.32,Default,,0,0,0,,Bunun yeterli olduğunu mu sanıyorsunuz?
Dialogue: 0,0:04:59.32,0:05:02.82,Default,,0,0,0,,{\i1}Haksız olduğunuzu şutumla göstereyim!{\i0} {okay, I don't get what he says here. correct my made-up sentence pl0x cant fin either, enshi? eenshi? renshi? need french lel}{[it goes "vous allez faire connaissance avec mon tir" = you'll see it with this shot. i keep hearing eishi but that does not exist... 実演 jitsuen's en probably I found it!!11!!}
Dialogue: 0,0:05:06.82,0:05:12.70,Default,,0,0,0,,Bıçak Vuruşu!
Dialogue: 0,0:05:12.70,0:05:15.21,Default,,0,0,0,,{\i1}Soda şutu çekiyor!{\i0} {kek at the DF guy}
Dialogue: 0,0:05:16.33,0:05:17.33,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:05:17.33,0:05:18.08,Default,,0,0,0,,Yakalayabilirsin!
Dialogue: 0,0:05:19.25,0:05:20.67,Default,,0,0,0,,{\i1}Morisaki zıplıyor!{\i0}
Dialogue: 0,0:05:22.17,0:05:22.84,Default,,0,0,0,,{\i1}Ne?!{\i0} {oh the edge!}
Dialogue: 0,0:05:24.84,0:05:26.17,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:05:26.17,0:05:29.60,Default,,0,0,0,,Top sağ 90'dan ağlarla buluştu!
Dialogue: 0,0:05:29.60,0:05:31.28,Default,,0,0,0,,İşte böyle!
Dialogue: 0,0:05:31.28,0:05:34.10,Default,,0,0,0,,Bıçak Vuruşu'nun gücünü görmüş olduk.
Dialogue: 0,0:05:35.35,0:05:36.10,Default,,0,0,0,,Ne?
Dialogue: 0,0:05:36.10,0:05:38.10,Default,,0,0,0,,İlk golü Nankatsu yedi!
Dialogue: 0,0:05:39.73,0:05:44.74,Default,,0,0,0,,İlk yarının 5. dakikasında namağlup Nankatsu gol yedi.
Dialogue: 0,0:05:45.32,0:05:48.24,Default,,0,0,0,,Golü atan defans Makoto Soda.
Dialogue: 0,0:05:48.24,0:05:49.64,Default,,0,0,0,,Bu doğru.
Dialogue: 0,0:05:49.64,0:05:54.50,Default,,0,0,0,,Bu Osaka Turnuvası'nın finalinde de gördüğümüz Bıçak vuruşuydu!
Dialogue: 0,0:05:54.50,0:05:56.66,Default,,0,0,0,,Makoto Soda...
Dialogue: 0,0:05:56.66,0:05:57.82,Default,,0,0,0,,Sizi aptallar!
Dialogue: 0,0:05:57.82,0:05:59.21,Default,,0,0,0,,Çok dikkatsizsiniz!
Dialogue: 0,0:05:59.21,0:06:03.17,Default,,0,0,0,,Geleneksel Ortaokul Futbol Turnuvasının atmosferi değişmiş durumda!
Dialogue: 0,0:06:03.17,0:06:06.31,Default,,0,0,0,,Nankatsu ile Azumaichi arasındaki açılış maçında
Dialogue: 0,0:06:06.31,0:06:09.94,Default,,0,0,0,,İlk golü namağlüp Nankatsu'nun yemesi
Dialogue: 0,0:06:09.94,0:06:14.22,Default,,0,0,0,,maçı oldukça ilgi çekici bir hale getirdi.
Dialogue: 0,0:06:14.22,0:06:17.16,Default,,0,0,0,,Beyler, maç daha yeni başladı.
Dialogue: 0,0:06:17.16,0:06:19.35,Default,,0,0,0,,Panik yapmayın. Sadece oyuna odaklanın!
Dialogue: 0,0:06:19.35,0:06:20.44,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:20.44,0:06:21.42,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:06:21.42,0:06:24.98,Default,,0,0,0,,O çocuk topa inanılmaz bir falso verdi.
Dialogue: 0,0:06:24.98,0:06:26.49,Default,,0,0,0,,Bir dahakine daha dikkatli ol.
Dialogue: 0,0:06:26.49,0:06:28.74,Default,,0,0,0,,Tamam kaptan.
Dialogue: 0,0:06:31.12,0:06:34.37,Default,,0,0,0,,Soda'nın pekte vaktini almadı...
Dialogue: 0,0:06:34.37,0:06:36.62,Default,,0,0,0,,{\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}—  BAY COAST STADYUMU —
Dialogue: 0,0:06:36.62,0:06:38.62,Default,,0,0,0,,Bir, iki, üç, dört!
Dialogue: 0,0:06:38.62,0:06:40.13,Default,,0,0,0,,Hey, şuna bakın.
Dialogue: 0,0:06:40.13,0:06:41.79,Default,,0,0,0,,Hyuga bankta oturuyor.
Dialogue: 0,0:06:41.79,0:06:45.26,Default,,0,0,0,,Herkes ısınırken o kenarda kendi halinde oturuyor. {lol, seikan means a lot of things. I hope I got the right one 性感 kek}{well, he'salmost at that age...}
Dialogue: 0,0:06:45.26,0:06:49.38,Default,,0,0,0,,Tokyu Turnuvasının bitişinden beri gizli bir şekilde antreman yapmıyor muydu?
Dialogue: 0,0:06:49.38,0:06:52.97,Default,,0,0,0,,Yani "Hyuga ortadan kayboldu" haberi uydurma mıydı?
Dialogue: 0,0:06:53.86,0:06:55.22,Default,,0,0,0,,İşte koç Kitazume!
Dialogue: 0,0:06:55.22,0:06:56.77,Default,,0,0,0,,Koç Kitazume!
Dialogue: 0,0:06:56.77,0:06:59.50,Default,,0,0,0,,Hyuga'nın durumunu söyler misiniz?
Dialogue: 0,0:06:59.50,0:07:03.86,Default,,0,0,0,,"Kayıp" olayı bir çeşit gizli antreman mıydı?
Dialogue: 0,0:07:03.86,0:07:06.74,Default,,0,0,0,,Gizli antreman mı? Böyle bir şey duymadım.
Dialogue: 0,0:07:06.74,0:07:09.45,Default,,0,0,0,,Hyuga hakkında bir yorumum yok.
Dialogue: 0,0:07:09.45,0:07:11.91,Default,,0,0,0,,Hadi ama! Saklamayın lütfen.
Dialogue: 0,0:07:11.91,0:07:13.91,Default,,0,0,0,,Sağlam bir antremandan geçti değil mi?
Dialogue: 0,0:07:13.91,0:07:15.03,Default,,0,0,0,,Yeter!
Dialogue: 0,0:07:15.03,0:07:17.33,Default,,0,0,0,,Söyleyebileceğim tek şey
Dialogue: 0,0:07:17.33,0:07:20.92,Default,,0,0,0,,Hyuga'nın bu turnuvada oynamasına izin vermeyeceğim.
Dialogue: 0,0:07:20.92,0:07:21.92,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:21.92,0:07:23.50,Default,,0,0,0,,Koç...
Dialogue: 0,0:07:28.34,0:07:30.76,Default,,0,0,0,,{\i1}Nankatsu maça kötü başladı!{\i0}
Dialogue: 0,0:07:30.76,0:07:34.47,Default,,0,0,0,,{\i1}Her zamanki gibi atağı Tsubasa Ozora yönetiyor!{\i0}
Dialogue: 0,0:07:34.47,0:07:36.47,Default,,0,0,0,,Sana güveniyoruz, Tsubasa!
Dialogue: 0,0:07:39.14,0:07:42.28,Default,,0,0,0,,Golü attıktan sonra tek yapmam gereken markaj yapmak.
Dialogue: 0,0:07:42.28,0:07:44.06,Default,,0,0,0,,Eğer yaparsam maç bizde demektir.
Dialogue: 0,0:07:46.82,0:07:47.98,Default,,0,0,0,,Allah belanı versin!
Dialogue: 0,0:07:49.12,0:07:49.74,Default,,0,0,0,,Hadi be!
Dialogue: 0,0:07:49.74,0:07:54.37,Default,,0,0,0,,Soda'nın yakın markajına rağmen Tsubasa iyi bir pas atabildi.
Dialogue: 0,0:07:54.37,0:07:57.92,Default,,0,0,0,,Her takım Tsubasa'yı markajlar.
Dialogue: 0,0:07:57.92,0:08:01.75,Default,,0,0,0,,Önemli olan Tsubasa ve diğerlerinin bunu nasıl hallettiği.
Dialogue: 0,0:08:01.75,0:08:02.81,Default,,0,0,0,,Hadi gidelim!
Dialogue: 0,0:08:02.81,0:08:05.54,Default,,0,0,0,,Onlara Nankatsu'nun Tsubasa'dan\N ibaret olmadığını gösterelim.
Dialogue: 0,0:08:05.54,0:08:06.71,Default,,0,0,0,,Pekala!
Dialogue: 0,0:08:06.71,0:08:09.63,Default,,0,0,0,,{\i1}Nankatsu ortasahayı aşmaya çalışıyor!{\i0}
Dialogue: 0,0:08:09.63,0:08:11.51,Default,,0,0,0,,Sanki izin vereceğim!
Dialogue: 0,0:08:11.51,0:08:13.97,Default,,0,0,0,,Ancak Azumaichi defansı çok güçlü.
Dialogue: 0,0:08:16.70,0:08:17.10,Default,,0,0,0,,Lanet olsun.
Dialogue: 0,0:08:17.10,0:08:19.77,Default,,0,0,0,,Demek top bende olmasa bile beni markajlamaya devam ediceksin.
Dialogue: 0,0:08:19.77,0:08:20.93,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:08:20.93,0:08:23.27,Default,,0,0,0,,Cehennemin dibine kadar peşinden gideceğim.
Dialogue: 0,0:08:23.85,0:08:26.42,Default,,0,0,0,,Eğer durum bu hale geldiyse, o zaman görelim bakalım kim daha iyimiş.
Dialogue: 0,0:08:26.42,0:08:28.06,Default,,0,0,0,,Markajından kurtulacağım!
Dialogue: 0,0:08:28.06,0:08:31.19,Default,,0,0,0,,Hmph! Benden daha hızlı koşamazsın!
Dialogue: 0,0:08:31.19,0:08:34.70,Default,,0,0,0,,{\i1}Nankatsu atağa Tsubasa'sız devam ediyor.{\i0} {the endless pitch strikes back}
Dialogue: 0,0:08:34.70,0:08:38.03,Default,,0,0,0,,{\i1}Azumaichi'den Soda'nın inatçı markajı işe yarıyor.{\i0}
Dialogue: 0,0:08:38.03,0:08:41.08,Default,,0,0,0,,{\i1}Bravı Soda! Keçi gibi inatçı olmaya devam et.{\i0} {does this idiom sound weird in Eng? well for english ox would be the correct animal like how we use keçi or katır for something similar idiom }
Dialogue: 0,0:08:41.08,0:08:43.25,Default,,0,0,0,,Maç başlayalı 10 dakika oldu.
Dialogue: 0,0:08:43.25,0:08:44.25,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:08:45.00,0:08:48.34,Default,,0,0,0,,{\i1}Izawa Tsubasa'ya başarılı bir pas atıyor.{\i0}
Dialogue: 0,0:08:48.34,0:08:49.40,Default,,0,0,0,,{\i1}Gerçekten iyi bir rakip.{\i0}
Dialogue: 0,0:08:49.40,0:08:52.76,Default,,0,0,0,,Bire bir markajı beni bu kadar zorlayan ilk kişi.
Dialogue: 0,0:08:52.76,0:08:54.98,Default,,0,0,0,,Dedikleri kadar varmışsın Tsubasa Ozora.
Dialogue: 0,0:08:54.98,0:08:58.64,Default,,0,0,0,,Daha önce bir kere Bıçak Çelmesi attım ama ikincisine izin vermiyor.
Dialogue: 0,0:08:58.64,0:09:02.62,Default,,0,0,0,,Defansın kanatlardaki yeteneği oldukça iyi.
Dialogue: 0,0:09:02.62,0:09:05.81,Default,,0,0,0,,Bu #7... Makoto Soda.
Dialogue: 0,0:09:05.81,0:09:11.53,Default,,0,0,0,,Markajlamada iyi ve defansın her\N bölgesinde de iyi iş çıkartıyor.
Dialogue: 0,0:09:12.28,0:09:14.53,Default,,0,0,0,,Görüyorum...
Dialogue: 0,0:09:14.53,0:09:17.54,Default,,0,0,0,,Tsubasa! Sen onu ezer geçersin! {lol, at least offer to help!}
Dialogue: 0,0:09:17.54,0:09:19.62,Default,,0,0,0,,Biz gol için ileriye gidiyoruz!
Dialogue: 0,0:09:19.62,0:09:21.41,Default,,0,0,0,,Sadece terse orta aç!
Dialogue: 0,0:09:21.41,0:09:22.66,Default,,0,0,0,,Bunu göze alamam!
Dialogue: 0,0:09:22.66,0:09:24.25,Default,,0,0,0,,Atarım!
Dialogue: 0,0:09:28.04,0:09:29.66,Default,,0,0,0,,Onu durdurdu!
Dialogue: 0,0:09:29.66,0:09:31.96,Default,,0,0,0,,Soda ona arkasından çelme taktı.
Dialogue: 0,0:09:31.96,0:09:32.80,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:34.50,0:09:36.13,Default,,0,0,0,,Faul?
Dialogue: 0,0:09:36.13,0:09:38.68,Default,,0,0,0,,Vay şerefsiz! Bilerek yaptı!
Dialogue: 0,0:09:39.38,0:09:40.64,Default,,0,0,0,,Sarı kart!
Dialogue: 0,0:09:40.64,0:09:45.75,Default,,0,0,0,,Eğer Soda bir sarı kart daha alırsa oyundan çıkıcak.
Dialogue: 0,0:09:45.75,0:09:49.10,Default,,0,0,0,,Ben birini markajladığımda ne olursa olsun durdururum.
Dialogue: 0,0:09:49.10,0:09:51.68,Default,,0,0,0,,Bir ya da iki faul yapsam bile.
Dialogue: 0,0:09:52.36,0:09:55.66,Default,,0,0,0,,{\i1}Azumaichi MS turnuvadaki ilk \Nmaçında gayet iyi iş çıkartıyor.{\i0}
Dialogue: 0,0:09:55.66,0:09:58.70,Default,,0,0,0,,Tsubasa'ya oynaması için alan bırakmıyorlar.
Dialogue: 0,0:09:58.70,0:10:00.18,Default,,0,0,0,,Kenidinze gelin!
Dialogue: 0,0:10:00.18,0:10:02.08,Default,,0,0,0,,Bize karşı finallerde yaptığınız gibi
Dialogue: 0,0:10:02.08,0:10:04.58,Default,,0,0,0,,onlara Tsubasa'sız da oynayabildiğinizi gösterin!
Dialogue: 0,0:10:04.58,0:10:05.85,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:10:05.85,0:10:07.93,Default,,0,0,0,,Eğer Tsubasa'yla pozisyon oluşturamıyorsak
Dialogue: 0,0:10:07.93,0:10:09.54,Default,,0,0,0,,biz de kendimiz oluştururuz!
Dialogue: 0,0:10:09.54,0:10:11.64,Default,,0,0,0,,Sİze güveniyoruz, Shutetsu Trio! {It's been 3 years they deserved to be called nankatsu front 3}
Dialogue: 0,0:10:11.64,0:10:15.13,Default,,0,0,0,,Nankatsu'nun forveti Izawa, Taki ve Kisugi{\i0}
Dialogue: 0,0:10:15.13,0:10:18.84,Default,,0,0,0,,gole koşuyorlar.
Dialogue: 0,0:10:18.84,0:10:20.01,Default,,0,0,0,,Bana salın!
Dialogue: 0,0:10:20.01,0:10:21.24,Default,,0,0,0,,Sizi aptallar!
Dialogue: 0,0:10:21.24,0:10:23.26,Default,,0,0,0,,Şu küçükleri halledemiyor musunuz?!
Dialogue: 0,0:10:24.31,0:10:25.31,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:10:25.31,0:10:29.31,Default,,0,0,0,,Soda'nın dikkatsizliğinden\N yararlanan Tsubasa boşa çıkıyor.
Dialogue: 0,0:10:29.31,0:10:31.64,Default,,0,0,0,,Taki! Tsubasa boşta!
Dialogue: 0,0:10:31.64,0:10:32.65,Default,,0,0,0,,Ona katılalım!
Dialogue: 0,0:10:32.65,0:10:33.72,Default,,0,0,0,,Evet!
Dialogue: 0,0:10:34.78,0:10:35.65,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:10:36.32,0:10:40.16,Default,,0,0,0,,Orta defansa çarpıp yön değiştirdi.
Dialogue: 0,0:10:41.53,0:10:43.83,Default,,0,0,0,,Sırtını kaleye dönüyor!
Dialogue: 0,0:10:43.83,0:10:47.36,Default,,0,0,0,,Bu duruş... Rövaşata vurucak!
Dialogue: 0,0:10:47.36,0:10:50.62,Default,,0,0,0,,Bu benim ilk şansım. Bunu kullanmalıyım!
Dialogue: 0,0:10:51.38,0:10:53.04,Default,,0,0,0,,Sanki sana izin vereceğim!
Dialogue: 0,0:10:53.04,0:10:57.80,Default,,0,0,0,,Soda rövaşata vuruşuyla onu engelliyor!
Dialogue: 0,0:10:59.26,0:11:00.51,Default,,0,0,0,,Harikasın Soda!
Dialogue: 0,0:11:03.65,0:11:04.31,Default,,0,0,0,,Aldım!
Dialogue: 0,0:11:04.31,0:11:07.06,Default,,0,0,0,,{\i1}Izawa boşa düşen topu alıyor!{\i0}
Dialogue: 0,0:11:07.06,0:11:09.56,Default,,0,0,0,,Lanet olsun! Boşta!
Dialogue: 0,0:11:09.56,0:11:10.56,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:11:12.40,0:11:13.90,Default,,0,0,0,,Durdur onu kaleci!
Dialogue: 0,0:11:15.66,0:11:17.28,Default,,0,0,0,,Kurtardı!
Dialogue: 0,0:11:18.28,0:11:20.02,Default,,0,0,0,,Muhteşem bir kurtarış!
Dialogue: 0,0:11:20.02,0:11:22.39,Default,,0,0,0,,Nankatsu'nun pozisyonu golle tamamlayamadı.
Dialogue: 0,0:11:22.39,0:11:23.95,Default,,0,0,0,,Güzel kurtarış kaleci!
Dialogue: 0,0:11:23.95,0:11:28.95,Default,,0,0,0,,Gol atamadılar ama sonunda Nankatsu'nun adına yaraşır bir atak yaptılar.
Dialogue: 0,0:11:28.95,0:11:32.20,Default,,0,0,0,,Still, Azumaichi MS'nin defansı çok güçlü.
Dialogue: 0,0:11:32.20,0:11:36.46,Default,,0,0,0,,#7 Soda'yı gören defansif bir takım olduğunu anlar zaten.
Dialogue: 0,0:11:36.46,0:11:39.03,Default,,0,0,0,,Bu doğru. Takımın kianahtarı o.
Dialogue: 0,0:11:39.03,0:11:42.58,Default,,0,0,0,,Tsubasa'yı bloklaması taktire şayandı.
Dialogue: 0,0:11:42.58,0:11:45.85,Default,,0,0,0,,Evet, oldukça haklısın.
Dialogue: 0,0:11:45.85,0:11:48.60,Default,,0,0,0,,Azumaichi defansif bir takım.
Dialogue: 0,0:11:48.60,0:11:52.05,Default,,0,0,0,,Osaka Turnuvasında hiç gol yemediler.
Dialogue: 0,0:11:52.05,0:11:53.85,Default,,0,0,0,,Ve şu Makoto Soda...
Dialogue: 0,0:11:54.92,0:11:58.61,Default,,0,0,0,,Ona Kasai'de "As katili Soda" derler.
Dialogue: 0,0:11:58.61,0:12:04.78,Default,,0,0,0,,Karşı takımın as oyuncusuna yapışıp \Ndurdurmak için ya topa ya da bacağına vurur.
Dialogue: 0,0:12:04.78,0:12:10.64,Default,,0,0,0,,{\t(5408,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}As oyuncumuzu sakatladı. Bir daha futbol oynayamaz hale getirdi.
Dialogue: 0,0:12:10.70,0:12:11.79,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:11.79,0:12:15.54,Default,,0,0,0,,Azumaichi'nin bir golle önde olduğuna bakarak
Dialogue: 0,0:12:15.54,0:12:18.55,Default,,0,0,0,,maçın onlarda olduğunu söyleyebilirim.
Dialogue: 0,0:12:19.36,0:12:21.34,Default,,0,0,0,,As Katili Soda...
Dialogue: 0,0:12:24.09,0:12:27.35,Default,,0,0,0,,Lanet olsun! Yaptığı hareket...
Dialogue: 0,0:12:27.35,0:12:31.92,Default,,0,0,0,,{\u0}Sürekli markajlı olduğundan dolayı terse oynamalı.{\u0} {\u1}{is cross play a thing? my ignorance about football is showing}
Dialogue: 0,0:12:31.92,0:12:36.61,Default,,0,0,0,,{\i1}Eğer Nankatsu kaybederse \NTsubasa'nın sakatlığından dolayı olur.{\i0}
Dialogue: 0,0:12:39.94,0:12:42.49,Default,,0,0,0,,{\i1}Nankatsu gol atamadı!{\i0}
Dialogue: 0,0:12:42.49,0:12:44.36,Default,,0,0,0,,İlk yarı bitti.
Dialogue: 0,0:12:46.24,0:12:48.13,Default,,0,0,0,,Harikaydınız beyler!
Dialogue: 0,0:12:48.13,0:12:52.04,Default,,0,0,0,,Soda ikinci yarı da Tsubasa'ya markaja devam edebilir misin?
Dialogue: 0,0:12:52.04,0:12:54.79,Default,,0,0,0,,Soda eğer Tsubasa'yı markajlamakta \Nzorlanırsan sana yardımcı gönderebilirim.
Dialogue: 0,0:12:54.79,0:12:58.54,Default,,0,0,0,,Endişelenmeyin. Maç bizde.
Dialogue: 0,0:12:59.55,0:13:01.92,Default,,0,0,0,,Bacağını sakatladı. {oh my god what an asshole!}
Dialogue: 0,0:13:01.92,0:13:03.86,Default,,0,0,0,,Ne?!
Dialogue: 0,0:13:01.92,0:13:06.92,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:13:07.92,0:13:12.93,Default,,0,0,0,,{worst boy's player card}
Dialogue: 0,0:13:13.84,0:13:16.19,Default,,0,0,0,,Okawa, ne oldu?
Dialogue: 0,0:13:16.19,0:13:18.94,Default,,0,0,0,,Sana ihtiyacımız var, çabuk ol.
Dialogue: 0,0:13:18.94,0:13:20.44,Default,,0,0,0,,REVİR
Dialogue: 0,0:13:22.44,0:13:24.19,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:24.19,0:13:28.82,Default,,0,0,0,,Finallerde Huyga'yla oynarken sakatlanen yer ağırıyor.
Dialogue: 0,0:13:28.82,0:13:32.60,Default,,0,0,0,,Önemli bir şey olduğunu sanmıyorum ama bandajlamana ihtiyacım var.
Dialogue: 0,0:13:32.60,0:13:33.70,Default,,0,0,0,,Hızlıca lütfen.
Dialogue: 0,0:13:33.70,0:13:35.46,Default,,0,0,0,,Tamam.
Dialogue: 0,0:13:35.46,0:13:40.95,Default,,0,0,0,,2. yılın bahar antremanını bu sakatlığından dolayı es geçmemiş miydiniz?
Dialogue: 0,0:13:40.95,0:13:45.34,Default,,0,0,0,,Evet. Ona bandajlatarak haletmiştik.
Dialogue: 0,0:13:45.34,0:13:49.16,Default,,0,0,0,,Manabu, bundan kimseye bahsetme.
Dialogue: 0,0:13:49.16,0:13:52.10,Default,,0,0,0,,Daha 2. yarı var ve kimsenin endişelenmesini istemiyorum.
Dialogue: 0,0:13:52.10,0:13:54.10,Default,,0,0,0,,Biliyorum.
Dialogue: 0,0:14:00.81,0:14:02.61,Default,,0,0,0,,Evet. Bitti.
Dialogue: 0,0:14:02.61,0:14:03.44,Default,,0,0,0,,Teşekkürler.
Dialogue: 0,0:14:06.72,0:14:07.97,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:14:07.97,0:14:10.49,Default,,0,0,0,,Evet. Kazanacağım. Söz veriyorum.
Dialogue: 0,0:14:13.36,0:14:14.23,Default,,0,0,0,,Pekala!
Dialogue: 0,0:14:14.23,0:14:18.48,Default,,0,0,0,,Eğer Tsubasa Ozora sakatsa diğer üçüyle ilgilenmemiz lazım!
Dialogue: 0,0:14:18.48,0:14:20.58,Default,,0,0,0,,Kisugi, Izawa ve Taki.
Dialogue: 0,0:14:20.58,0:14:23.46,Default,,0,0,0,,Kaleye yaklaştıklarında bire bir mücadeleye girin.
Dialogue: 0,0:14:23.46,0:14:24.56,Default,,0,0,0,,Tamam koç!
Dialogue: 0,0:14:24.56,0:14:28.58,Default,,0,0,0,,Pekala! Hadi böyle devam edip Nankatsu'yu yenelim.
Dialogue: 0,0:14:28.58,0:14:30.89,Default,,0,0,0,,Eğer pozisyon olursa kontra atağa kalkın.
Dialogue: 0,0:14:30.89,0:14:31.72,Default,,0,0,0,,Evet!
Dialogue: 0,0:14:33.22,0:14:36.20,Default,,0,0,0,,Sıkıntı yok. 2. yarı maçı berabere yapabilirizç
Dialogue: 0,0:14:36.20,0:14:39.35,Default,,0,0,0,,Evet. Maçı çevirebiliriz.
Dialogue: 0,0:14:39.35,0:14:41.16,Default,,0,0,0,,Sadece acele etmeyin.
Dialogue: 0,0:14:41.16,0:14:43.86,Default,,0,0,0,,Her zaman oynadığınız gibi oynayın ve kazanın!
Dialogue: 0,0:14:43.86,0:14:44.94,Default,,0,0,0,,Tamam koç!
Dialogue: 0,0:14:45.41,0:14:47.38,Default,,0,0,0,,Tsubasa nerede?
Dialogue: 0,0:14:49.33,0:14:50.88,Default,,0,0,0,,Toilette miydin?
Dialogue: 0,0:14:50.88,0:14:53.37,Default,,0,0,0,,Evet. Şimdi daha iyiyim.
Dialogue: 0,0:14:53.37,0:14:56.02,Default,,0,0,0,,Hadi gidelim beyler! İkinci yarıda savaşalım!
Dialogue: 0,0:14:56.02,0:14:57.37,Default,,0,0,0,,Evet!
Dialogue: 0,0:14:59.37,0:15:01.00,Default,,0,0,0,,Sana güveniyoruz, Nankatsu!
Dialogue: 0,0:15:01.00,0:15:02.96,Default,,0,0,0,,İlk olarak skoru eşitleyin!
Dialogue: 0,0:15:02.96,0:15:06.21,Default,,0,0,0,,Hooray, hooray, 'ichi MS!
Dialogue: 0,0:15:06.21,0:15:08.38,Default,,0,0,0,,Neredeydin Sanae?
Dialogue: 0,0:15:08.38,0:15:09.97,Default,,0,0,0,,Yapmam gereken küçük bir işim vardı.
Dialogue: 0,0:15:10.97,0:15:12.97,Default,,0,0,0,,İkinci yarı başlıyor!
Dialogue: 0,0:15:15.98,0:15:18.39,Default,,0,0,0,,Nankatsı hızlı bir başlangıç yapıyor.
Dialogue: 0,0:15:18.82,0:15:20.23,Default,,0,0,0,,Koş, Tsubasa!
Dialogue: 0,0:15:20.23,0:15:22.86,Default,,0,0,0,,{\i1}Azumaichi MS hiç gerilmemiş durumda.{\i0}
Dialogue: 0,0:15:22.86,0:15:26.57,Default,,0,0,0,,Eğer Nankatsu şimdi ileri giderse kontra atak yiyebilirler.
Dialogue: 0,0:15:29.39,0:15:32.07,Default,,0,0,0,,{\i1}Soda hala Tsubasa'yı markajlıyor!
Dialogue: 0,0:15:32.07,0:15:33.82,Default,,0,0,0,,Neyin var, Tsubasa?
Dialogue: 0,0:15:33.82,0:15:36.59,Default,,0,0,0,,Markajımdan kurtulmaya çalışmayacak mısın?
Dialogue: 0,0:15:36.59,0:15:39.08,Default,,0,0,0,,Galiba o bacaklarla koşamıyorsun.
Dialogue: 0,0:15:39.08,0:15:41.62,Default,,0,0,0,,Bacağımın durumunu biliyor...
Dialogue: 0,0:15:41.62,0:15:44.59,Default,,0,0,0,,Eğer sen bana gelmezsen ben sana gelirim!
Dialogue: 0,0:15:47.13,0:15:47.98,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:15:47.98,0:15:50.98,Default,,0,0,0,,Nankatsu inanılmaz bir duvar pası yapıyor.
Dialogue: 0,0:15:50.98,0:15:51.84,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:15:51.84,0:15:55.30,Default,,0,0,0,,Ancak Soda pes etmeyip markajına devam ediyor.
Dialogue: 0,0:15:55.30,0:16:00.62,Default,,0,0,0,,Uzun süre boşta kalamam. Orta açmam lazım.
Dialogue: 0,0:16:03.56,0:16:07.07,Default,,0,0,0,,Bu golü engellemeye mi çalışıyorsun Azumaichi MS?{\i0}
Dialogue: 0,0:16:07.07,0:16:11.57,Default,,0,0,0,,{\i1}Tüsubasa pas veremiyor ve Soda da hemen arkasında!{\i0}
Dialogue: 0,0:16:11.57,0:16:14.57,Default,,0,0,0,,Lanet olsun! Denemek zorundayım!
Dialogue: 0,0:16:14.57,0:16:18.41,Default,,0,0,0,,Tsubasa şut vurucak!
Dialogue: 0,0:16:18.41,0:16:19.16,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:19.16,0:16:21.85,Default,,0,0,0,,{\t(2446,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Roberto, sana meydan okuyorum!{\i0}
Dialogue: 0,0:16:21.87,0:16:23.21,Default,,0,0,0,,Sana izin vermem!
Dialogue: 0,0:16:28.71,0:16:34.51,Default,,0,0,0,,{\blur0.6\c&H000000&}Ölü Yaprak Vuruşu! {put this in sparkly colors please! like inazuma eleven}
Dialogue: 1,0:16:28.71,0:16:34.51,Default,,0,0,0,,{\bord0\blur0.6\c&HFFFFDC&\4a&HFF&}Ö{\c&HF8FABE&}l{\c&HF0F49F&}ü {\c&HF8F284&}Y{\c&HFFF069&}a{\c&HC7F7C8&}p{\c&HABFAF7&}r{\c&H97FAF8&}a{\c&H82FAF9&}k{\c&H3AFFFD&} Vuruşu! {put this in sparkly colors please! like inazuma eleven}
Dialogue: 0,0:16:34.51,0:16:36.90,Default,,0,0,0,,{\i1}Soda zamanında çelme takamadı!{\i0}
Dialogue: 0,0:16:36.90,0:16:38.97,Default,,0,0,0,,{\i1}Tsubasa uzaktan bir şut denemesi yapıyor!{\i0}
Dialogue: 0,0:16:38.97,0:16:42.48,Default,,0,0,0,,{\i1}Yetişemedim! Çok hızlı vurdu!{\i0}
Dialogue: 0,0:16:43.64,0:16:48.15,Default,,0,0,0,,{\i1}Ama top havalandı! Galiba dışarı çıkıcak...{\i0}
Dialogue: 0,0:16:50.98,0:16:54.56,Default,,0,0,0,,{\i1}Ah! Top aniden aşağıya yöneldi!{\i0}
Dialogue: 0,0:16:54.56,0:16:57.28,Default,,0,0,0,,{\i1}Çok iyi bir spin aldırmış anlaşılan!{\i0} {added an explanation so the casual viewers who might not know what a "drive" effect actually is—really reminding them what it means, since it WAS explained in an earlier chapter}
Dialogue: 0,0:16:57.28,0:16:59.53,Default,,0,0,0,,{\i1}Hadi, gol ol!{\i0}
Dialogue: 0,0:17:03.91,0:17:05.04,Default,,0,0,0,,Kaleci!
Dialogue: 0,0:17:05.04,0:17:06.17,Default,,0,0,0,,Ne?!
Dialogue: 0,0:17:09.90,0:17:13.05,Default,,0,0,0,,{\i1}Ve gol! Kaleci dona kaldı!{\i0}
Dialogue: 0,0:17:13.05,0:17:15.18,Default,,0,0,0,,Süper!
Dialogue: 0,0:17:15.18,0:17:21.68,Default,,0,0,0,,Hayır bizim hatamız! Top kalenin üstüne inmiş!
Dialogue: 0,0:17:21.68,0:17:23.10,Default,,0,0,0,,Hadi be!
Dialogue: 0,0:17:23.10,0:17:26.02,Default,,0,0,0,,Çok yakındı!
Dialogue: 0,0:17:26.02,0:17:27.77,Default,,0,0,0,,Bu inanılmaz!
Dialogue: 0,0:17:27.77,0:17:30.23,Default,,0,0,0,,Ağların hemen üstüne indi!
Dialogue: 0,0:17:30.23,0:17:33.98,Default,,0,0,0,,Üzgünüm Roberto. Hala başaramadım.
Dialogue: 0,0:17:33.98,0:17:37.51,Default,,0,0,0,,Hala bu vuruş üzerinde uzmanlaşamadım.
Dialogue: 0,0:17:37.51,0:17:42.37,Default,,0,0,0,,Ayrıca bu vuruş bacağımı tahmin\N ettiğimden daha çok zorladı.
Dialogue: 0,0:17:42.37,0:17:45.29,Default,,0,0,0,,Bu şutu daha fazla deneyemem!
Dialogue: 0,0:17:45.29,0:17:48.04,Default,,0,0,0,,Lanet olsun! Korkuttun beni!
Dialogue: 0,0:17:48.04,0:17:51.96,Default,,0,0,0,,Ölü yaprak vuruşu? Ben de bu vuruşu düşünüyordum.
Dialogue: 0,0:17:57.26,0:18:01.40,Default,,0,0,0,,Ama topa spin aldırmak çok zor.
Dialogue: 0,0:18:01.40,0:18:10.38,Default,,0,0,0,,Bundan dolayı onun yerine \NBıçak Vuruşu'mu mükemmelleştirdim.
Dialogue: 0,0:18:10.38,0:18:17.53,Default,,0,0,0,,Tsubasa senin için bile... Bu yaşteyken ölü yaprak vuruşu imkansız.
Dialogue: 0,0:18:17.53,0:18:20.78,Default,,0,0,0,,{\i1}Azumaichi MS out kullanıyor.
Dialogue: 0,0:18:20.78,0:18:23.58,Default,,0,0,0,,Pekala! Eğer pozisyon olursa saldıracağız!
Dialogue: 0,0:18:23.58,0:18:24.54,Default,,0,0,0,,Hadi!
Dialogue: 0,0:18:26.54,0:18:30.26,Default,,0,0,0,,Eminim ki son vuruşundan kendini oldukça zorladın.
Dialogue: 0,0:18:30.26,0:18:33.67,Default,,0,0,0,,{\i1}Artık markajımdan kaçamayacaksın, Tsubasa Ozora!{\i0}
Dialogue: 0,0:18:33.67,0:18:36.30,Default,,0,0,0,,İkinci yarının 7 dakikası geçti bile.
Dialogue: 0,0:18:39.30,0:18:42.30,Default,,0,0,0,,Sadece top çeviriyorlar!
Dialogue: 0,0:18:43.48,0:18:46.22,Default,,0,0,0,,Saldırmaya niyetimiz yok!
Dialogue: 0,0:18:47.43,0:18:48.77,Default,,0,0,0,,Allah belanı versin!
Dialogue: 0,0:18:48.77,0:18:51.74,Default,,0,0,0,,Çok güzel. Rakibi kışkırtın.
Dialogue: 0,0:18:51.74,0:18:53.91,Default,,0,0,0,,Tsubasa'nın şutlarına dikkat etmeliyiz.
Dialogue: 0,0:18:53.91,0:18:58.15,Default,,0,0,0,,Soda onu 20 dakika kadar tutabilirse kazanırız.
Dialogue: 0,0:18:58.73,0:19:00.46,Default,,0,0,0,,Acele etmeyin.
Dialogue: 0,0:19:00.46,0:19:04.16,Default,,0,0,0,,Atak yaparsanız hızlıca geri dönün.
Dialogue: 0,0:19:04.16,0:19:06.66,Default,,0,0,0,,Atmosfer hiç hoşuma gitmedi.
Dialogue: 0,0:19:06.66,0:19:09.21,Default,,0,0,0,,{\i1}Tsubasa tamamen markajlanmış durumda.
Dialogue: 0,0:19:09.21,0:19:11.92,Default,,0,0,0,,Maç bitiyor!
Dialogue: 0,0:19:11.92,0:19:14.80,Default,,0,0,0,,Üzücü bir sonuçla bitebilir...
Dialogue: 0,0:19:14.80,0:19:19.82,Default,,0,0,0,,{\i1}Nankatsu 'nun hiç pozisyon bulamadığı ikinci yarının 20 dakikasını geride bıraktık.{\i0}
Dialogue: 0,0:19:19.82,0:19:21.72,Default,,0,0,0,,Lanet olsun! Sadece 10 dakika kaldı.
Dialogue: 0,0:19:23.84,0:19:24.47,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:19:25.49,0:19:28.52,Default,,0,0,0,,{\i1}Izawa çelmeyle topu aldı!{\i0}
Dialogue: 0,0:19:29.91,0:19:33.86,Default,,0,0,0,,Soda'nın Tsubasa'ya olan markajı Tsubasa'nın pas atmasını imkansız hale getiriyor.
Dialogue: 0,0:19:34.86,0:19:38.61,Default,,0,0,0,,Soda'nın Tsubasa'ya markaj yapması önemli değil!
Dialogue: 0,0:19:38.61,0:19:40.44,Default,,0,0,0,,Hiç zaman kalmasa bile,
Dialogue: 0,0:19:40.44,0:19:43.49,Default,,0,0,0,,hala Tsubasa'ya güveniyoruz!
Dialogue: 0,0:19:44.11,0:19:47.16,Default,,0,0,0,,Markajlı olmasına rağmen Nankatsu Tsubasa'ya pas atıyor.
Dialogue: 0,0:19:47.99,0:19:50.54,Default,,0,0,0,,Benden kaçamazsın Tsubasa!
Dialogue: 0,0:19:50.54,0:19:52.79,Default,,0,0,0,,Yakala beni Soda!
Dialogue: 0,0:19:55.00,0:19:57.92,Default,,0,0,0,,{\i1}Tsubasa direkt olarak rakibine koşuyor!{\i0}
Dialogue: 0,0:19:58.82,0:20:00.97,Default,,0,0,0,,{\i1}Hemen çarpmadan önce aralarından sıyrılıyor!{\i0} {I came in like a wreeecking baaaaaaaaall}{kek}
Dialogue: 0,0:20:01.84,0:20:02.80,Default,,0,0,0,,Pekala!
Dialogue: 0,0:20:02.80,0:20:05.68,Default,,0,0,0,,{\i1}Nankatsu uzun zamandan sonra bir pozisyon buldu!
Dialogue: 0,0:20:05.68,0:20:09.72,Default,,0,0,0,,Tsubasa'nın orta açması gerekiyor.
Dialogue: 0,0:20:09.72,0:20:11.81,Default,,0,0,0,,Tsubasa, şerefsiz seni...!
Dialogue: 0,0:20:11.81,0:20:17.07,Default,,0,0,0,,{\i1}Ama kalenin karşısındaki Kisugi, Izawa ve Taki markajlamış durumdalar.{\i0}
Dialogue: 0,0:20:18.39,0:20:21.45,Default,,0,0,0,,{\i1}Ah! Nanktasu'nun hala markajlanmamış bir oyuncusu var!{\i0}
Dialogue: 0,0:20:21.45,0:20:22.32,Default,,0,0,0,,Nagano! {is that right? yes hiroshi nagano}
Dialogue: 0,0:20:22.32,0:20:23.70,Default,,0,0,0,,Hadi, Tsubasa!
Dialogue: 0,0:20:23.70,0:20:25.66,Default,,0,0,0,,Ben markajlarım!
Dialogue: 0,0:20:25.66,0:20:29.24,Default,,0,0,0,,{\i1}Tsubasa kimseye pas veremiyor!{\i0}
Dialogue: 0,0:20:29.24,0:20:31.17,Default,,0,0,0,,Ne yapıyorsun, Tsubasa?
Dialogue: 0,0:20:31.17,0:20:33.29,Default,,0,0,0,,Boştasın! Kendin koş!
Dialogue: 0,0:20:33.29,0:20:35.29,Default,,0,0,0,,Pekala!
Dialogue: 0,0:20:35.29,0:20:37.67,Default,,0,0,0,,Tsubasa orta açıyor!
Dialogue: 0,0:20:37.67,0:20:39.70,Default,,0,0,0,,Top havadan gelirse bizde.
Dialogue: 0,0:20:39.70,0:20:41.94,Default,,0,0,0,,Herkes topu uzaklaştırmaya çalışsın!
Dialogue: 0,0:20:41.94,0:20:42.55,Default,,0,0,0,,Evet!
Dialogue: 0,0:20:43.93,0:20:48.24,Default,,0,0,0,,{\i1}Ah! Tsubasa topu defansın merkezi Takasugi'ye attı!{\i0} {FORESHADOWING}
Dialogue: 0,0:20:48.24,0:20:49.18,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:49.18,0:20:51.18,Default,,0,0,0,,{\i1}Al bunu!{\i0}
Dialogue: 0,0:20:51.18,0:20:53.56,Default,,0,0,0,,{\i1} Kafa vuruşu yapıyor!{\i0}
Dialogue: 0,0:20:54.86,0:20:55.76,Default,,0,0,0,,Ah!
Dialogue: 0,0:20:55.76,0:20:59.82,Default,,0,0,0,,{\i1}Ve gol! Nankatsu skoru eşitledi!{\i0}
Dialogue: 0,0:20:59.82,0:21:01.57,Default,,0,0,0,,Başardım!
Dialogue: 0,0:21:01.57,0:21:04.32,Default,,0,0,0,,Woah! Güzel kafaydı, Takasugi!
Dialogue: 0,0:21:05.52,0:21:06.87,Default,,0,0,0,,Güzel koşuydu! {change this to the proper tango nothiingxs senpai said overlap is good}
Dialogue: 0,0:21:07.43,0:21:10.46,Default,,0,0,0,,Şerefsiz seni! Benden önce gol attın!
Dialogue: 0,0:21:10.46,0:21:12.37,Default,,0,0,0,,Bunun şaka olarak kalması gerekiyordu!
Dialogue: 0,0:21:12.37,0:21:17.38,Default,,0,0,0,,{\i1}Nankatsu Takasugi'yle golü buldu!{\i0}
Dialogue: 0,0:21:17.38,0:21:21.55,Default,,0,0,0,,{\i1}Tsubasa'nın dikkati sayesinde Takasugi golü buldu.{\i0}
Dialogue: 0,0:21:21.55,0:21:22.67,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:21:22.67,0:21:25.30,Default,,0,0,0,,Eğer berabere olduysa maç bizde demektir!
Dialogue: 0,0:21:25.30,0:21:28.75,Default,,0,0,0,,Tsubasa bacağın iyi mi?
Dialogue: 0,0:21:30.00,0:21:32.43,Default,,0,0,0,,Biz defanslar kaleci gibiyizdir.
Dialogue: 0,0:21:32.43,0:21:35.39,Default,,0,0,0,,Hareketleri arkadan izleriz.
Dialogue: 0,0:21:36.05,0:21:40.02,Default,,0,0,0,,Takasugi! Ben iyiyim. Endişelenecek bir şey yok.
Dialogue: 0,0:21:40.02,0:21:41.85,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:21:41.85,0:21:46.61,Default,,0,0,0,,{\i1}Tsubasa! Bacağından doalyı mı kendin gitmedin?{\i0}
Dialogue: 0,0:21:46.61,0:21:49.87,Default,,0,0,0,,Phew! Rahatladım be.
Dialogue: 0,0:21:49.87,0:21:52.33,Default,,0,0,0,,Nankatsu bundan sonra seriye bağlar.
Dialogue: 0,0:21:52.33,0:21:54.16,Default,,0,0,0,,Galiba öyle.
Dialogue: 0,0:21:54.16,0:21:56.14,Default,,0,0,0,,Lanet olsun! Berabere oldu.
Dialogue: 0,0:21:56.14,0:21:58.12,Default,,0,0,0,,Sadece biraz daha dayanmamız gerekiyordu.
Dialogue: 0,0:21:58.12,0:22:01.04,Default,,0,0,0,,Oyununa geldim, Tsubasa Ozora.
Dialogue: 0,0:22:01.72,0:22:03.76,Default,,0,0,0,,Endişelenmeyin çocuklar!
Dialogue: 0,0:22:03.76,0:22:06.84,Default,,0,0,0,,Bıçak vuruşumla oyunu çevireceğim.
Dialogue: 0,0:22:07.27,0:22:12.14,Default,,0,0,0,,Ama Soda, bu sefer daha hazırlıklı olacaklardır.
Dialogue: 0,0:22:12.14,0:22:17.10,Default,,0,0,0,,Sıkıntı yok. Bıçak vuruşuö her türlü işe yarar!
Dialogue: 0,0:22:18.81,0:22:33.81,Default-TOP,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBu bölüm hakkındaki düşüncelerinizi {\c&H090AEB&}İnstagram{\c} paylaşımlarımızın altına iletebilirsiniz...
Dialogue: 0,0:23:49.90,0:24:00.46,Default,,0,0,0,,BİR SONRAKİ BÖLÜM 36: \NRESOLUTION OF EACH {feel free to make it sound better}
Dialogue: 0,0:23:49.90,0:24:00.46,AnimeSeverler,,0,0,0,,{\3c&H8A5B2A&}~Anime Severler~\NBir sonraki altyazıda görüşmek dileğiyle...
Dialogue: 0,0:02:04.22,0:02:06.93,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:07.84,0:02:10.51,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:11.43,0:02:14.14,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:02:21.02,0:02:23.86,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:02:23.86,0:02:30.12,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:02:30.12,0:02:36.00,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta na no ni
Dialogue: 0,0:02:36.00,0:02:42.59,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:02:42.59,0:02:46.59,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:02:46.59,0:02:51.10,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:02:51.10,0:02:56.64,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:02:56.64,0:02:58.23,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:02:58.23,0:02:59.44,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:59.44,0:03:02.94,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:03:02.94,0:03:12.83,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:03:12.83,0:03:13.66,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:03:13.66,0:03:17.46,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:03:17.46,0:03:21.46,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:03:21.46,0:03:27.72,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:03:27.72,0:03:30.51,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:02:04.22,0:02:06.93,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:07.84,0:02:10.51,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:11.43,0:02:14.14,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:02:21.02,0:02:23.86,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum. {I keep lying to myself}
Dialogue: 0,0:02:23.86,0:02:30.12,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile {burning with loneliness}
Dialogue: 0,0:02:30.12,0:02:36.00,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:02:36.00,0:02:42.59,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:02:42.59,0:02:46.59,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:02:46.59,0:02:51.10,OPED,,0,0,0,,Sesinin özlemi{i hate how weak I am \N yearning for your voice}
Dialogue: 0,0:02:51.10,0:02:56.64,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:02:56.64,0:02:58.23,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:02:58.23,0:02:59.44,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:59.44,0:03:02.94,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:03:02.94,0:03:12.83,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:03:12.83,0:03:13.66,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:03:13.66,0:03:17.46,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:03:17.46,0:03:21.46,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:03:21.46,0:03:27.72,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:03:27.72,0:03:30.51,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.67,0:22:44.71,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.71,0:22:50.72,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.72,0:22:56.77,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.77,0:23:01.40,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:03.02,0:23:07.69,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:09.03,0:23:15.12,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:15.12,0:23:21.17,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:21.17,0:23:25.63,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.92,0:23:33.26,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:33.26,0:23:39.31,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.31,0:23:45.61,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.67,0:22:44.71,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.71,0:22:50.72,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.72,0:22:56.77,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.77,0:23:01.40,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.02,0:23:07.69,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:09.03,0:23:15.12,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:15.12,0:23:21.17,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.17,0:23:25.63,OPED,,0,0,0,,Bir gün, bir şimşek vuruşunu yapacağım!
Dialogue: 0,0:23:26.92,0:23:33.26,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.26,0:23:39.31,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.31,0:23:45.61,OPED,,0,0,0,,Bu hırslı gençlik sahada!
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
