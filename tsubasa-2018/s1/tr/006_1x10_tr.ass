Dialogue: 0,0:00:01.10,0:00:03.73,Default,,0,0,0,,Okullar arası turnuva, berabere bitmişti.
Dialogue: 0,0:00:03.73,0:00:07.90,Default,,0,0,0,,Nankatsu şehri, yaklaşan ulusal turnuva\Niçin karma bir şehir takımı oluşturup...{feel free to Newline wherever}
Dialogue: 0,0:00:07.90,0:00:10.86,Default,,0,0,0,,...Nankatsu FC olarak\Nkatılmaya karar vermişti.
Dialogue: 0,0:00:10.86,0:00:12.74,Default,,0,0,0,,Katılmayı hedefleyen...
Dialogue: 0,0:00:12.74,0:00:17.58,Default,,0,0,0,,...Tsubasa, Misaki ve Ishizaki\Nsıkı bir pratik yapıyordu.
Dialogue: 0,0:00:17.58,0:00:19.40,Default,,0,0,0,,Bu sırada Roberto ise...
Dialogue: 0,0:00:19.41,0:00:26.46,Default,,0,0,0,,...Tsubasa'yı kendi yanında\NBrezilya futbol okuluna götürmek için izin istemişti.
Dialogue: 0,0:00:27.08,0:00:29.67,Default,,0,0,0,,Tsubasa kararsız kalmıştı.
Dialogue: 0,0:00:29.67,0:00:32.38,Default,,0,0,0,,En sonunda ise Brezilya'ya\Ngitmeye karar vermişti.
Dialogue: 0,0:00:32.92,0:00:35.55,Default,,0,0,0,,Nankatsu FC oyuncusu\Nolarak seçilmişti ve...
Dialogue: 0,0:00:35.55,0:00:38.14,Default,,0,0,0,,...ulusal turnuva elemelerine\Ndoğru yol alıyordu.
Dialogue: 0,0:02:10.02,0:02:13.07,Default,,0,0,0,,{\fad(00,00)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(308,829)}Bölüm 10\NKojiro Gelir
Dialogue: 0,0:02:10.02,0:02:13.07,Default,,0,0,0,,{\bord2\3c&H373737&\xbord4.5\blur1\b1\pos(1392,1025)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:02:12.61,0:02:13.82,Default,,0,0,0,,{\an8}Sana bırakıyorum!
Dialogue: 0,0:02:13.82,0:02:14.53,Default,,0,0,0,,Durdurun!
Dialogue: 0,0:02:14.53,0:02:16.94,Default,,0,0,0,,Hyuga'dan topu alsak yeter!
Dialogue: 0,0:02:16.94,0:02:17.99,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:20.74,0:02:23.95,Default,,0,0,0,,Zayıf defansınızla beni\Ndurdurabileceğinizi mi sandınız?!
Dialogue: 0,0:02:23.95,0:02:25.83,Default,,0,0,0,,Beni durdurmak istiyorsanız...
Dialogue: 0,0:02:25.83,0:02:27.54,Default,,0,0,0,,...hayatınızı ortaya koymanız gerekir!
Dialogue: 0,0:02:27.54,0:02:30.21,Default,,0,0,0,,Daha fazla top sürmene izin vermem!{missed here, yoroshiku Aria <3 dokuten,}
Dialogue: 0,0:02:31.54,0:02:32.46,Default,,0,0,0,,Nasıl?
Dialogue: 0,0:02:33.34,0:02:35.55,Default,,0,0,0,,Şut!{ARTISTIC LICENSE waiting for original JPN}
Dialogue: 0,0:02:39.97,0:02:42.72,Default,,0,0,0,,Hyuga Kojiro, korkunç birisin!
Dialogue: 0,0:02:42.72,0:02:43.93,Default,,0,0,0,,Çok abartıyorsun.
Dialogue: 0,0:02:43.93,0:02:46.68,Default,,0,0,0,,Kaç kişiyi yaralama niyetindesin?{After how many injured will you calm down?}
Dialogue: 0,0:02:46.68,0:02:47.85,Default,,0,0,0,,Kes be!
Dialogue: 0,0:02:47.85,0:02:51.02,Default,,0,0,0,,Böyle yaralanmalar sizi korkutuyorsa\Nfutbolu bırakın!
Dialogue: 0,0:02:51.02,0:02:52.36,Default,,0,0,0,,Sen--
Dialogue: 0,0:02:52.36,0:02:56.03,Default,,0,0,0,,Hem bu bölgesel turnuva\Nöncesi pratik maçı.
Dialogue: 0,0:02:56.03,0:02:58.86,Default,,0,0,0,,Daha fazla yaralanmayı kaldıramayız.
Dialogue: 0,0:02:58.86,0:03:00.78,Default,,0,0,0,,Maç burada bitmiştir!
Dialogue: 0,0:03:03.53,0:03:05.79,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:03:05.79,0:03:07.87,Default,,0,0,0,,Bugün biraz abartmadın mı?
Dialogue: 0,0:03:07.87,0:03:09.25,Default,,0,0,0,,Ne dedin?
Dialogue: 0,0:03:09.25,0:03:11.54,Default,,0,0,0,,Siz de mi beni eleştiriyorsunuz?
Dialogue: 0,0:03:15.13,0:03:16.42,Default,,0,0,0,,Pekala.
Dialogue: 0,0:03:16.42,0:03:20.01,Default,,0,0,0,,Öyleyse kendi futbolunuzla\Nelemeleri geçmeyi deneyin.{what happened here I saw something vanish did I forget the n} {just a typo, it was "with" instead "win"}{oh i'm dumb gg}{no, you're awesomely bad<3} {#gotem}
Dialogue: 0,0:03:20.01,0:03:21.01,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:21.01,0:03:23.97,Default,,0,0,0,,Bundan sonra eleme maçlarına\Nçıkmam artık ben.
Dialogue: 0,0:03:23.97,0:03:28.47,Default,,0,0,0,,Bakalım kendi yeteneklerinizle ulusal\Nturnuvaya katılmayı başarabilecek misiniz?
Dialogue: 0,0:03:28.47,0:03:29.52,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:03:29.52,0:03:35.23,Default,,0,0,0,,Ben Hyuga Kojira'nın oynadığı futbol mu\Ndoğru yoksa sizin mi futbolunuz doğru...
Dialogue: 0,0:03:35.23,0:03:37.69,Default,,0,0,0,,...göreceğiz bakalım!{I know that Kojiro straight up states his name here, but the problem is that this is the kind of shit you can get away with in Japanese but you can't really get away with this one in English without it sounding like you're from the 1600s. if i can figure out a better way to get him to just be like THE WAY THAT I, KOJIRO HYUGA, PLAY then i'll use that ... i actually think i already just did by writing that btw. this is how my brain works. fuck you, brain, it is a nice brain, be thankful} {how's that sound instead? both works good but this one is also faithful to jp so better imho} {ok let us please our Japanese Overlords and their KORE WO... KORE WO KIMERARENAKYA... ORE WA STRIKER JA NEEEE Hyuga over the top bullshit<3} {ORE NO MONDO NO YO TENKA MUTEKI NO RAIJU SHUUTO DA} {god fuck Hyuga} {he's hot} {i love him} {#teamhyuga}
Dialogue: 0,0:03:41.57,0:03:42.32,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:03:45.37,0:03:47.03,Default,,0,0,0,,Güzel şut Tsubasa-kun!
Dialogue: 0,0:03:47.03,0:03:49.25,Default,,0,0,0,,Evet. Sırada Misaki-kun var, değil mi?
Dialogue: 0,0:03:53.37,0:03:55.46,Default,,0,0,0,,Gerçekten böylesi iyi mi acaba?{for the best}
Dialogue: 0,0:03:59.46,0:04:02.13,Default,,0,0,0,,Kaptan, 2 haftaya demir alacak.
Dialogue: 0,0:04:02.13,0:04:05.22,Default,,0,0,0,,Tsubasa'yı yanımda Brezilya'ya götürmem...
Dialogue: 0,0:04:05.22,0:04:08.31,Default,,0,0,0,,Annesi de yalnız kalacak.{Captain Ozora will find another drowning alcoholic hunk for her, don't worry lel dont forget he will be another half} {WOW (you rite tho)}
Dialogue: 0,0:04:08.31,0:04:12.18,Default,,0,0,0,,Ayrıca Tsubasa, Brezilya'ya gitmeye\Nhazır olduğunu söylese de...
Dialogue: 0,0:04:12.18,0:04:15.48,Default,,0,0,0,,...ailesinden ayrılması ona\Nyalnızlık çektirmeyecek mi?
Dialogue: 0,0:04:15.48,0:04:16.49,Default,,0,0,0,,Roberto!
Dialogue: 0,0:04:18.19,0:04:19.23,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:04:19.23,0:04:20.44,Default,,0,0,0,,Daldın gittin.
Dialogue: 0,0:04:21.65,0:04:24.11,Default,,0,0,0,,Üzgünüm. Biraz mola verelim mi?
Dialogue: 0,0:04:24.11,0:04:25.20,Default,,0,0,0,,- Olur.\N- Tamam.
Dialogue: 0,0:04:25.20,0:04:26.45,Default,,0,0,0,,Ya Ishizaki-kun?
Dialogue: 0,0:04:29.33,0:04:30.70,Default,,0,0,0,,Hadi ama. Ne oldu?
Dialogue: 0,0:04:30.70,0:04:32.29,Default,,0,0,0,,Daha yeni başladık.
Dialogue: 0,0:04:35.50,0:04:37.13,Default,,0,0,0,,Hadi ama. Ne oldu?{OI, DOUSHITA}
Dialogue: 0,0:04:37.13,0:04:39.21,Default,,0,0,0,,Ayaklarında derman kalmamış.
Dialogue: 0,0:04:39.21,0:04:42.59,Default,,0,0,0,,Biraz acımasız davranmıyor musunuz?!
Dialogue: 0,0:04:42.59,0:04:45.01,Default,,0,0,0,,5 dakika verin de bir soluklanayım.
Dialogue: 0,0:04:45.01,0:04:48.35,Default,,0,0,0,,Olur ama yarından itibaren\Nmola falan olmayacak.
Dialogue: 0,0:04:48.35,0:04:49.93,Default,,0,0,0,,Şeytan falan mısın Manabu?!
Dialogue: 0,0:04:49.93,0:04:52.56,Default,,0,0,0,,Ama sen, Tsubasa ve Misaki...
Dialogue: 0,0:04:52.56,0:04:55.60,Default,,0,0,0,,...30 kişilik seçme takıma seçildiniz.
Dialogue: 0,0:04:55.60,0:04:58.56,Default,,0,0,0,,Seçilen son 15 içinde\Nyer almak istemez misin?
Dialogue: 0,0:04:58.56,0:05:01.82,Default,,0,0,0,,Evet. Tsubasa ve Misaki'nin\Nişi garanti gibi ama...
Dialogue: 0,0:05:01.82,0:05:03.74,Default,,0,0,0,,...senin iş biraz yaş değil mi Ishizaki?{Ishizaki's on the line, right?}
Dialogue: 0,0:05:03.74,0:05:05.82,Default,,0,0,0,,Gerçekten de hiç lafınızı esirgemiyorsunuz.{better suggestion for "iitai houdai"?}
Dialogue: 0,0:05:05.82,0:05:09.37,Default,,0,0,0,,Her neyse. Bizim seni\Ndestekleme yöntemimiz bu.{halped}
Dialogue: 0,0:05:09.37,0:05:12.58,Default,,0,0,0,,Sıkı çalışmazsan ulusallara gidemezsin bak.
Dialogue: 0,0:05:14.25,0:05:15.33,Default,,0,0,0,,Anladım.
Dialogue: 0,0:05:18.08,0:05:20.88,Default,,0,0,0,,Üçümüzün gitmesi ne güzel olur.
Dialogue: 0,0:05:20.88,0:05:21.88,Default,,0,0,0,,Evet.
Dialogue: 0,0:05:22.76,0:05:24.01,Default,,0,0,0,,Yine geliyor!
Dialogue: 0,0:05:24.01,0:05:26.55,Default,,0,0,0,,Defans! Bu sefer durdurun onları!
Dialogue: 0,0:05:34.31,0:05:35.60,Default,,0,0,0,,Başardım!
Dialogue: 0,0:05:35.60,0:05:36.81,Default,,0,0,0,,Bugün tam formundasın.{or you are on a roll today}
Dialogue: 0,0:05:37.24,0:05:42.43,Default,,0,0,0,,Bu pratik maçı, Nankatsu FC oyuncuları\Niçin ısınma bile sayılmaz.
Dialogue: 0,0:05:44.32,0:05:45.99,Default,,0,0,0,,Geçti!
Dialogue: 0,0:05:45.99,0:05:46.57,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:05:47.03,0:05:48.07,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:05:48.07,0:05:50.83,Default,,0,0,0,,Aynı takımdayken arka\Narkaya 2. kez şampiyon olacağım.{better suggestion for "nirenpa"?}{too long for little time}
Dialogue: 0,0:05:51.24,0:05:52.08,Default,,0,0,0,,Hadi!
Dialogue: 0,0:05:52.08,0:05:52.83,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:05:55.00,0:05:55.87,Default,,0,0,0,,Olmuyor!
Dialogue: 0,0:05:55.87,0:05:57.75,Default,,0,0,0,,Wakabayashi'yi geçemiyoruz!{OUCH Wakabayashi's poor leg} {CRRRRRUNCH} {definitely not intentional, riiiight}
Dialogue: 0,0:06:02.96,0:06:04.26,Default,,0,0,0,,Maç bitti.
Dialogue: 0,0:06:04.26,0:06:05.84,Default,,0,0,0,,Ö-Özür dilerim.
Dialogue: 0,0:06:12.76,0:06:16.43,Default,,0,0,0,,Hey, Nankatsu FC kulübü harika değil mi?
Dialogue: 0,0:06:16.43,0:06:19.19,Default,,0,0,0,,Shutetsu'dan kişiler ve\NTsubasa ile Misaki varken...
Dialogue: 0,0:06:19.19,0:06:21.27,Default,,0,0,0,,...ulusal turnuvayı\Nkazanmazlar mı sizce de?
Dialogue: 0,0:06:21.27,0:06:23.90,Default,,0,0,0,,Evet, bunu görmeyi çok istiyorum.
Dialogue: 0,0:06:23.90,0:06:26.03,Default,,0,0,0,,O kadar emin olamazsın.{you don't know about that}
Dialogue: 0,0:06:26.03,0:06:29.07,Default,,0,0,0,,Ulusalların seviyesi gittikçe yükseliyor.
Dialogue: 0,0:06:29.07,0:06:32.91,Default,,0,0,0,,Doğru ya, çok fazla okula\Ntransfer oldun değil mi?
Dialogue: 0,0:06:32.91,0:06:35.91,Default,,0,0,0,,Örnek olarak Shiba'dan\NKujiukuri FC'yi ele alalım.
Dialogue: 0,0:06:35.91,0:06:40.50,Default,,0,0,0,,Her gün sahilde pratik yaparak\Nbacaklarını ve belden aşağısını geliştirirler.
Dialogue: 0,0:06:40.50,0:06:42.59,Default,,0,0,0,,Bu yüzden koşma konusunda\Nasla kaybetmezler...
Dialogue: 0,0:06:42.59,0:06:44.67,Default,,0,0,0,,...ve dayanıklılıklarıyla bilinirler.
Dialogue: 0,0:06:45.21,0:06:48.97,Default,,0,0,0,,Osaka'dan Naniwa FC oyuncuları uzundur...{MAMBERS LMAO IDK WHY THE WORD MAMBERS LOOKS GODLIKE, Black mamba's?} {sorry for making fun of you but LMAO}{nankatsu mambers can make a nice team name} {changing my captain tsubasa dream team team name to MAMBERS}
Dialogue: 0,0:06:48.97,0:06:51.68,Default,,0,0,0,,...ve hava toplarında asla top kaybetmezler.
Dialogue: 0,0:06:51.68,0:06:56.47,Default,,0,0,0,,Fukuoka'dan Hakata FC'de yetişkinlerden\Nçocuklara kadar herkes aynı takımdadır.
Dialogue: 0,0:06:56.47,0:06:58.18,Default,,0,0,0,,Daha büyük oyuncularla\Npratik yaptıkları için...
Dialogue: 0,0:06:58.18,0:07:00.85,Default,,0,0,0,,...yetişkinleri bile madara edecek\Nşekilde bir oyun sergileyebilirler.
Dialogue: 0,0:07:00.85,0:07:04.02,Default,,0,0,0,,Vay canına. Ne kadar çok takım varmış.
Dialogue: 0,0:07:04.02,0:07:06.98,Default,,0,0,0,,Ama ulusal turnuvaya gidersek...
Dialogue: 0,0:07:06.98,0:07:10.49,Default,,0,0,0,,...en güçlüleri Meiwa FC olabilir.
Dialogue: 0,0:07:10.91,0:07:14.37,Default,,0,0,0,,Baş forvetleri Hyuga Kojiro...
Dialogue: 0,0:07:14.37,0:07:17.33,Default,,0,0,0,,...Tsubasa-kun kadar yeteneklidir.
Dialogue: 0,0:07:17.33,0:07:18.33,Default,,0,0,0,,Ciddi misin?!
Dialogue: 0,0:07:18.33,0:07:19.66,Default,,0,0,0,,Yalancı!
Dialogue: 0,0:07:19.66,0:07:22.00,Default,,0,0,0,,Tsubasa ulusal turnuva\NWakabayashi'ye...
Dialogue: 0,0:07:22.00,0:07:24.42,Default,,0,0,0,,...tek başına gol atmış birisi!{good two lines}{i can die happy now}
Dialogue: 0,0:07:24.42,0:07:26.34,Default,,0,0,0,,Tek bilmeniz gereken...
Dialogue: 0,0:07:26.34,0:07:31.18,Default,,0,0,0,,...Kojiro'nun Tsubasa-kun'dan\Nçok farklı bir forvet tarzı olduğu.
Dialogue: 0,0:07:31.59,0:07:35.14,Default,,0,0,0,,Meiwa FC... Hyuga Kojiro...
Dialogue: 0,0:07:42.94,0:07:45.44,Default,,0,0,0,,Of... Daha fazla dayanamayacağım.
Dialogue: 0,0:07:49.40,0:07:51.24,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:07:51.24,0:07:52.99,Default,,0,0,0,,Siz de mi eve dönüyordunuz?
Dialogue: 0,0:07:53.91,0:07:58.33,Default,,0,0,0,,Ishizaki, neden sadece senin\Nkıyafetlerin kirli?
Dialogue: 0,0:07:58.33,0:07:59.29,Default,,0,0,0,,Kes be!
Dialogue: 0,0:07:59.29,0:08:02.29,Default,,0,0,0,,Seçme takımın son 15 kişisine\Nkalmak için özel antrenman yapıyordum!
Dialogue: 0,0:08:02.29,0:08:04.63,Default,,0,0,0,,Gerçi hepsi boşa gidecek.
Dialogue: 0,0:08:04.63,0:08:06.34,Default,,0,0,0,,Ne dedin lan sen?!
Dialogue: 0,0:08:09.46,0:08:10.59,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:08:12.17,0:08:13.93,Default,,0,0,0,,Bir şey yok.{then he turned around and whispered: everything. Roberto knows LOL}
Dialogue: 0,0:08:20.52,0:08:23.89,Default,,0,0,0,,Meiwa FC'den Hyuga ile\Ntanışmak istiyorum gerçekten.
Dialogue: 0,0:08:23.89,0:08:26.77,Default,,0,0,0,,Senden farklı bir tarzı olduğunu söyledi.
Dialogue: 0,0:08:26.77,0:08:28.94,Default,,0,0,0,,Yani sen hala özelsin.{"and you will be my slave" he added?} {bruh}
Dialogue: 0,0:08:28.94,0:08:30.99,Default,,0,0,0,,Dünyadaki tüm oyunculardan farklısın.
Dialogue: 0,0:08:30.99,0:08:31.65,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:08:32.95,0:08:35.99,Default,,0,0,0,,Brezilya'da çok farklı\Noyuncular var değil mi?
Dialogue: 0,0:08:35.99,0:08:37.70,Default,,0,0,0,,Brezilya'ya gidince...
Dialogue: 0,0:08:37.70,0:08:40.62,Default,,0,0,0,,...profesyonel oluncaya kadar\NJaponya'ya dönmeyeceğine söz ver.
Dialogue: 0,0:08:40.62,0:08:41.54,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:41.54,0:08:44.92,Default,,0,0,0,,Yine de mümkün olan en hızlı\Nşekilde profesyonel olmak istiyorum!{we may add still at the first part? <3}
Dialogue: 0,0:08:44.92,0:08:48.25,Default,,0,0,0,,O zaman tüm gün boyunca\Nfutbol oynayabilirim!
Dialogue: 0,0:08:48.25,0:08:49.34,Default,,0,0,0,,Yavaş ol.
Dialogue: 0,0:08:49.34,0:08:53.30,Default,,0,0,0,,Ulusal turnuvayı kazanamazsan\Nbenimle gelemezsin.
Dialogue: 0,0:08:53.30,0:08:55.59,Default,,0,0,0,,Tsubasa, sözleştik bak.
Dialogue: 0,0:08:55.59,0:08:56.93,Default,,0,0,0,,Elbette!
Dialogue: 0,0:08:58.35,0:09:00.77,Default,,0,0,0,,Profesyonel olmak zordur.
Dialogue: 0,0:09:04.69,0:09:05.23,Default,,0,0,0,,İzle.
Dialogue: 0,0:09:11.86,0:09:14.36,Default,,0,0,0,,Antrenman yaparak er ya da geç bacakların\Nbu kadar güçlenecektir.{I expect you to be able to do as much.} {all the comments became irrelevant in the face of Context™}{note for tl, kitaeru here means train, I know its friggin annoying haha}
Dialogue: 0,0:09:16.11,0:09:19.41,Default,,0,0,0,,Şimdilik bunu yapabilmen için\Nçok erken ama.
Dialogue: 0,0:09:19.41,0:09:22.12,Default,,0,0,0,,Kemikleri hala gelişen bir\Nçocuk olarak bunu denersen...
Dialogue: 0,0:09:22.12,0:09:24.16,Default,,0,0,0,,...değerli bacaklarını incitebilirsin.
Dialogue: 0,0:09:24.16,0:09:25.87,Default,,0,0,0,,Tamam, anladım.
Dialogue: 0,0:09:25.87,0:09:28.83,Default,,0,0,0,,Bu arada bugün Wakabayashi...
Dialogue: 0,0:09:28.83,0:09:32.34,Default,,0,0,0,,Sanki bugün yürürken ayağına\Nağırlığını vermiyormuş gibiydi.
Dialogue: 0,0:09:32.34,0:09:33.55,Default,,0,0,0,,Ne?
Dialogue: 0,0:09:35.63,0:09:40.26,Default,,0,0,0,,Nankatsu Genç Futbol Kulübü'nün\Nilk pratik günü gelmişti sonunda.
Dialogue: 0,0:09:41.01,0:09:45.18,Default,,0,0,0,,Bu 30 kişiden ulusal turnuvaya gitmek için...
Dialogue: 0,0:09:45.18,0:09:49.90,Default,,0,0,0,,...15 kişi temsilci olarak seçilecekti.
Dialogue: 0,0:09:49.90,0:09:50.90,Default,,0,0,0,,Pekala.
Dialogue: 0,0:09:50.90,0:09:52.90,Default,,0,0,0,,Şimdi iki grup halinde maç yapacağız.
Dialogue: 0,0:09:52.90,0:09:55.65,Default,,0,0,0,,Shutetsu'dan daha fazla\Noyuncumuz olduğu için...
Dialogue: 0,0:09:55.65,0:10:00.53,Default,,0,0,0,,...Shutetsu İlkokulu'nun oyuncularından\Nbir takım olacak.
Dialogue: 0,0:10:00.53,0:10:02.91,Default,,0,0,0,,Kalanlar da karma bir takım oluşturacak.{meh keeping this for brevity even if it sounds a teensy bit funny}
Dialogue: 0,0:10:03.91,0:10:05.33,Default,,0,0,0,,Shutetsu'ya karşıyız demek?
Dialogue: 0,0:10:05.33,0:10:07.37,Default,,0,0,0,,Okullar arası turnuvadan sonra\N2. kez karşılaşmamız.
Dialogue: 0,0:10:07.37,0:10:08.50,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:08.50,0:10:12.92,Default,,0,0,0,,Bu maçı kazanalım ve son 15 temsilci\Narasına hepimiz girelim!{you wish lil bish}
Dialogue: 0,0:10:12.92,0:10:13.75,Default,,0,0,0,,Tamam!
Dialogue: 0,0:10:19.97,0:10:22.47,Default,,0,0,0,,Öyleyse maç başlıyor.
Dialogue: 0,0:10:28.19,0:10:29.06,Default,,0,0,0,,Bakalım...
Dialogue: 0,0:10:29.69,0:10:32.57,Default,,0,0,0,,Ben de mi başlasam ki?
Dialogue: 0,0:10:32.57,0:10:35.07,Default,,0,0,0,,Tamam, geliyoruz karma takım!
Dialogue: 0,0:10:35.07,0:10:36.36,Default,,0,0,0,,Hayatta kaybetmeyiz!
Dialogue: 0,0:10:36.36,0:10:38.86,Default,,0,0,0,,Biz de son 15 içinde yer almak istiyoruz!
Dialogue: 0,0:10:38.86,0:10:42.49,Default,,0,0,0,,Pas ver! Pas verip\Ntempolarını bozun!{to disturb them? make kakuran flow confuse also works}
Dialogue: 0,0:10:42.49,0:10:44.58,Default,,0,0,0,,Wakabayashi sen misin?
Dialogue: 0,0:10:46.20,0:10:47.96,Default,,0,0,0,,Sen de kimsin?
Dialogue: 0,0:10:47.96,0:10:50.97,Default,,0,0,0,,Meiwa FC'den{\alpha&HFF&} Hyuga Kojiro!
Dialogue: 0,0:10:50.97,0:10:52.59,Default,,0,0,0,,Meiwa FC'den Hyuga Kojiro!
Dialogue: 0,0:10:52.59,0:10:55.09,Default,,0,0,0,,Hyuga Kojiro mu?
Dialogue: 0,0:10:55.09,0:10:57.26,Default,,0,0,0,,Sana meydan okuyorum Wakabayashi!{this kid can't get a rest from challenges}
Dialogue: 0,0:10:57.26,0:10:58.09,Default,,0,0,0,,Ne?
Dialogue: 0,0:11:01.93,0:11:03.89,Default,,0,0,0,,Koç, şuna bak!
Dialogue: 0,0:11:05.10,0:11:05.77,Default,,0,0,0,,Kisugi!
Dialogue: 0,0:11:05.77,0:11:07.22,Default,,0,0,0,,Tamam, aldım.
Dialogue: 0,0:11:07.22,0:11:07.85,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:11:07.85,0:11:09.52,Default,,0,0,0,,İlk gol Shutetsu'nun!
Dialogue: 0,0:11:11.19,0:11:12.31,Default,,0,0,0,,Ne?
Dialogue: 0,0:11:14.65,0:11:16.57,Default,,0,0,0,,Geliyorum Shutetsu.
Dialogue: 0,0:11:18.19,0:11:19.82,Default,,0,0,0,,Wakabayashi Genzo!
Dialogue: 0,0:11:19.82,0:11:20.99,Default,,0,0,0,,Kojiro!
Dialogue: 0,0:11:20.99,0:11:21.61,Default,,0,0,0,,Ne?
Dialogue: 0,0:11:21.61,0:11:22.82,Default,,0,0,0,,Ne dedin Misaki?
Dialogue: 0,0:11:22.82,0:11:25.16,Default,,0,0,0,,Öyleyse o Meiwa FC'den mi?
Dialogue: 0,0:11:25.16,0:11:26.58,Default,,0,0,0,,Kaptan, bu--
Dialogue: 0,0:11:26.58,0:11:27.41,Default,,0,0,0,,Sorun değil.
Dialogue: 0,0:11:27.41,0:11:29.62,Default,,0,0,0,,Meydan okumasını kabul ediyorum.
Dialogue: 0,0:11:29.62,0:11:32.33,Default,,0,0,0,,Koç, sorun yok mu?
Dialogue: 0,0:11:33.96,0:11:37.09,Default,,0,0,0,,Demek Hyuga Kojiro o.
Dialogue: 0,0:11:37.84,0:11:39.22,Default,,0,0,0,,Seni adi...
Dialogue: 0,0:11:39.22,0:11:42.18,Default,,0,0,0,,Nasıl gol atma fırsatımı engellersin?
Dialogue: 0,0:11:43.09,0:11:44.72,Default,,0,0,0,,Çekil!{CONTEXT HERE PLS incoming, he rekts kisugi , like real rex}{"get off me" seemed better to me on second watch} {it has a question mark is why i ask lol}{my epic typos:(} {he says Get out of my way! when he uses the gouinna dribble in CT: Dream Team so i'm just gonna use that LMAO}{why not, he just chased the poor kid like he was a bug}{I love how they fall like they've been hit by a sniper}
Dialogue: 0,0:11:44.72,0:11:46.14,Default,,0,0,0,,Dalga mı geçiyorsun be?!
Dialogue: 0,0:11:46.14,0:11:47.97,Default,,0,0,0,,Shutetsu! Birlikte gidip durduralım şunu!
Dialogue: 0,0:11:53.35,0:11:56.02,Default,,0,0,0,,Direkt kalenin üzerine gidiyor.
Dialogue: 0,0:11:56.02,0:11:58.53,Default,,0,0,0,,Dümdüz top sürüyor resmen.{the name of the "move" is usually just Straight-Line Dribble — surprise, surprise}
Dialogue: 0,0:11:58.53,0:12:01.49,Default,,0,0,0,,Haklısın. Sen teknik temellik\Nfutbol oynarken...
Dialogue: 0,0:12:01.49,0:12:03.36,Default,,0,0,0,,...Kojiro kaba kuvvetle oynar.
Dialogue: 0,0:12:03.36,0:12:05.32,Default,,0,0,0,,Ne yapıyorsunuz Shutetsu?!
Dialogue: 0,0:12:05.32,0:12:07.37,Default,,0,0,0,,Çabuk alın topu şundan!
Dialogue: 0,0:12:07.37,0:12:08.79,Default,,0,0,0,,Git Takasugi.
Dialogue: 0,0:12:08.79,0:12:11.16,Default,,0,0,0,,Birebirde kaybetmezsin sen.
Dialogue: 0,0:12:11.16,0:12:11.87,Default,,0,0,0,,Tamam.
Dialogue: 0,0:12:17.96,0:12:19.26,Default,,0,0,0,,Seni adi!
Dialogue: 0,0:12:19.26,0:12:20.59,Default,,0,0,0,,Bilerek vurdun!
Dialogue: 0,0:12:20.59,0:12:21.80,Default,,0,0,0,,Kes be!
Dialogue: 0,0:12:21.80,0:12:25.05,Default,,0,0,0,,Benim futbolum sizin\Nnazik futbolunuzdan farklı.{kill him no, cuz your football is real deal}
Dialogue: 0,0:12:26.43,0:12:28.35,Default,,0,0,0,,Geliyorum Wakabayashi!
Dialogue: 0,0:12:28.35,0:12:32.98,Default,,0,0,0,,Dahi kalecinin yeteneklerini\Ndeneyelim bakalım!{"let me try out", but i like this better} {i actually like this one in the end because I can then use so-called later}
Dialogue: 0,0:12:34.19,0:12:36.31,Default,,0,0,0,,Wakabayashi-kun, tut!
Dialogue: 0,0:12:53.33,0:12:56.92,Default,,0,0,0,,Dahi kaleci Wakabayashi denilen\Nkişinin yetenekleri bu muymuş?
Dialogue: 0,0:12:56.92,0:13:00.34,Default,,0,0,0,,Şutuma karşı kılını bile kıpırdatamadı.
Dialogue: 0,0:13:02.63,0:13:03.97,Default,,0,0,0,,Misaki-kun.
Dialogue: 0,0:13:03.97,0:13:06.84,Default,,0,0,0,,Şimdi gücünü belli etmemen\Ndaha iyi olur Tsubasa-kun.{he really is an agent} {what a guy}
Dialogue: 0,0:13:10.47,0:13:11.43,Default,,0,0,0,,Misaki?
Dialogue: 0,0:13:11.43,0:13:12.89,Default,,0,0,0,,Kojiro.
Dialogue: 0,0:13:12.89,0:13:15.14,Default,,0,0,0,,Gerçekten de sensin Misaki.
Dialogue: 0,0:13:15.14,0:13:18.94,Default,,0,0,0,,Ne oldu?\NŞimdi de bu şehre mi geldin?
Dialogue: 0,0:13:18.94,0:13:22.82,Default,,0,0,0,,Bu takımın oyuncusuysan\Nsöyleyeyim madem.
Dialogue: 0,0:13:22.82,0:13:24.95,Default,,0,0,0,,Bu seneki ulusal turnuvanın kazananı...
Dialogue: 0,0:13:25.45,0:13:27.95,Default,,0,0,0,,...Meiwa FC olacak.
Dialogue: 0,0:13:27.95,0:13:30.08,Default,,0,0,0,,Görüşürüz.
Dialogue: 0,0:13:30.91,0:13:34.79,Default,,0,0,0,,Kojiro, buraya araştırma yapmaya geldiysen...
Dialogue: 0,0:13:34.79,0:13:36.83,Default,,0,0,0,,...bir şeyi kaçırdın.
Dialogue: 0,0:13:37.58,0:13:40.92,Default,,0,0,0,,Bu takımdaki Ozora Tsubasa\Nisimli kişiyi.
Dialogue: 0,0:13:40.92,0:13:43.63,Default,,0,0,0,,Onu tanımadan gittin.
Dialogue: 0,0:13:44.30,0:13:45.47,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:13:52.18,0:13:54.10,Default,,0,0,0,,İnanamıyorum.
Dialogue: 0,0:13:54.10,0:13:57.77,Default,,0,0,0,,Wakabayashi nasıl Tsubasa'dan\Nbaşka birisine kaybedebilir?
Dialogue: 0,0:13:57.77,0:14:00.36,Default,,0,0,0,,Sonrasında hemen eve gitti.
Dialogue: 0,0:14:02.11,0:14:04.82,Default,,0,0,0,,# Nakai Ortopedi #
Dialogue: 0,0:14:05.32,0:14:06.11,Default,,0,0,0,,Wakabayashi!
Dialogue: 0,0:14:11.86,0:14:17.53,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:14:17.79,0:14:19.96,Default,,0,0,0,,Kötü bir anda buldunuz beni.
Dialogue: 0,0:14:20.38,0:14:22.88,Default,,0,0,0,,Bacağını gerçekten incittin mi?
Dialogue: 0,0:14:22.88,0:14:26.13,Default,,0,0,0,,Demek o yüzden az önceki\Nşuta tepki veremedin.
Dialogue: 0,0:14:26.13,0:14:29.05,Default,,0,0,0,,Hayır. Tepki verseydim bile...
Dialogue: 0,0:14:29.05,0:14:30.72,Default,,0,0,0,,...tutabilir miydim emin değilim.
Dialogue: 0,0:14:30.72,0:14:34.64,Default,,0,0,0,,Gerçekten güçlü bir şuttu.
Dialogue: 0,0:14:35.43,0:14:39.35,Default,,0,0,0,,Ayrıca kaybettiğim için\Nbahane bulmak istemiyorum.
Dialogue: 0,0:14:39.35,0:14:41.40,Default,,0,0,0,,Yaralanmam kendi hatam.
Dialogue: 0,0:14:41.86,0:14:45.44,Default,,0,0,0,,Tsubasa, kesinlikle ulusallara gideceğiz.
Dialogue: 0,0:14:45.44,0:14:47.99,Default,,0,0,0,,Hyuga Kojiro da orada olacaktır.
Dialogue: 0,0:14:47.99,0:14:50.16,Default,,0,0,0,,Bunu ona o zaman ödeteceğiz.
Dialogue: 0,0:14:51.20,0:14:52.66,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:10.59,0:15:12.09,Default,,0,0,0,,Günaydın Kojiro.
Dialogue: 0,0:15:12.09,0:15:15.06,Default,,0,0,0,,Günaydın. Erkenden\Nişe gitmeyecek misin?
Dialogue: 0,0:15:15.06,0:15:17.48,Default,,0,0,0,,Annen için endişelenmeyi bırak artık.
Dialogue: 0,0:15:17.48,0:15:20.31,Default,,0,0,0,,Gidip sevdiğin futbolu oynasana.
Dialogue: 0,0:15:21.10,0:15:23.56,Default,,0,0,0,,Bunu futbol için yapıyorum.
Dialogue: 0,0:15:25.07,0:15:29.53,Default,,0,0,0,,Babam öldüğünden beri\Nannem bir sürü işte çalışıyor.
Dialogue: 0,0:15:29.53,0:15:32.57,Default,,0,0,0,,Sevdiği şeyleri yapabilen\Ntek kişi ben olamam.
Dialogue: 0,0:15:33.24,0:15:36.33,Default,,0,0,0,,Günaydın. Yardım etmeye geldim.
Dialogue: 0,0:15:36.33,0:15:38.79,Default,,0,0,0,,Hep de zahmet veriyorum.\NÇok yardımcı oluyorsun.
Dialogue: 0,0:15:38.79,0:15:40.83,Default,,0,0,0,,Antrenmanımın bir parçası bu da.
Dialogue: 0,0:15:42.71,0:15:45.67,Default,,0,0,0,,Ortaokula başladığım zaman...
Dialogue: 0,0:15:45.67,0:15:48.09,Default,,0,0,0,,...daha çok paraya ihtiyacım olacak.
Dialogue: 0,0:15:48.09,0:15:51.26,Default,,0,0,0,,Ayrıca benden sonra\N3 kişi daha var.
Dialogue: 0,0:15:51.26,0:15:54.14,Default,,0,0,0,,Küçük erkek ve kız kardeşlerim.
Dialogue: 0,0:15:54.14,0:15:56.14,Default,,0,0,0,,Buyur. Bugünkü ödülün.{not salary}
Dialogue: 0,0:15:56.14,0:15:57.93,Default,,0,0,0,,Çok teşekkürler!
Dialogue: 0,0:15:58.52,0:16:01.60,Default,,0,0,0,,Futbolla hayatımı değiştireceğim!
Dialogue: 0,0:16:01.60,0:16:03.94,Default,,0,0,0,,Ailemi rahat ettireceğim!
Dialogue: 0,0:16:03.94,0:16:07.53,Default,,0,0,0,,Bunun için futbolumu geliştirmeli...{read as:killing skills} {HISSATSU WAZA} {just leave football, we haven't even seen techniques yet} {fucking kid doesn't even have a tiger shot yet, he can only use DANGAN SHOT}
Dialogue: 0,0:16:07.53,0:16:09.69,Default,,0,0,0,,...ve mümkün olduğunca\Nbüyük turnuvalara katılmalıyım.
Dialogue: 0,0:16:10.36,0:16:14.70,Default,,0,0,0,,Kesinlikle ulusal turnuvalara da katılacağım!{YOU KNOW, BY TELLING HIS TEAM TO GO FUCK ITSELF cuz he is alpha he hates beta soyboy males}{a reverse psychology master}
Dialogue: 0,0:16:18.70,0:16:20.66,Default,,0,0,0,,Abi, günaydın.
Dialogue: 0,0:16:20.66,0:16:22.83,Default,,0,0,0,,Herkes uyanmış.
Dialogue: 0,0:16:22.83,0:16:24.88,Default,,0,0,0,,Annem gitti mi?
Dialogue: 0,0:16:24.88,0:16:27.96,Default,,0,0,0,,Evet. Hemen kahvaltı hazırlayacağım size.
Dialogue: 0,0:16:31.55,0:16:33.84,Default,,0,0,0,,Baban bugün başka bir\Nyolculuğa daha çıkacak.
Dialogue: 0,0:16:33.84,0:16:36.60,Default,,0,0,0,,Brezilya'ya gitmeye karar verdiğin için...
Dialogue: 0,0:16:36.60,0:16:41.02,Default,,0,0,0,,...gelecek sefere döndüğümde\Nevde olmayacaksın muhtemelen.
Dialogue: 0,0:16:41.02,0:16:41.85,Default,,0,0,0,,Evet.
Dialogue: 0,0:16:41.85,0:16:46.52,Default,,0,0,0,,Aslında Tsubasa ile bu konuda\Nbir söz verdik Kaptan.
Dialogue: 0,0:16:46.52,0:16:47.82,Default,,0,0,0,,Söz mü?{to hook up with Genzo. sango approvves}
Dialogue: 0,0:16:47.82,0:16:50.32,Default,,0,0,0,,Ulusal turnuvayı kazanmadığı sürece...
Dialogue: 0,0:16:50.32,0:16:52.70,Default,,0,0,0,,...Brezilya'ya gelmeyecek.
Dialogue: 0,0:16:52.70,0:16:54.86,Default,,0,0,0,,Bu biraz ağırmış.
Dialogue: 0,0:16:54.86,0:17:00.04,Default,,0,0,0,,Ama bir şey değişmeyecek yine de. Tsubasa\Nkesinlikle ulusal turnuvaları kazanacaktır.
Dialogue: 0,0:17:00.04,0:17:01.75,Default,,0,0,0,,Teşekkürler baba.
Dialogue: 0,0:17:01.75,0:17:05.25,Default,,0,0,0,,Öyleyse babana da\Nbir söz ver Tsubasa.
Dialogue: 0,0:17:05.25,0:17:06.63,Default,,0,0,0,,Ne?
Dialogue: 0,0:17:06.63,0:17:09.59,Default,,0,0,0,,Bugünkü maçta hat trick yaparsan...
Dialogue: 0,0:17:09.59,0:17:12.13,Default,,0,0,0,,...Brezilya'ya gitmene izin vereceğim.
Dialogue: 0,0:17:12.13,0:17:15.59,Default,,0,0,0,,Gitmesine izin vermeyi\Nsöyleyen sendin zaten.
Dialogue: 0,0:17:15.59,0:17:19.01,Default,,0,0,0,,Tsubasa'nın gitme konusunda\Nne kadar ciddi olduğunu görmek istiyorum.
Dialogue: 0,0:17:19.01,0:17:22.77,Default,,0,0,0,,Anladım. Hat trick yapmam\Nyeterli, değil mi?{BECAUSE IT'S SO EASY, I'M TSUBASA "MARY SUE" OZORA, KING OF THE FUCKING JUNGLE}
Dialogue: 0,0:17:23.14,0:17:26.02,Default,,0,0,0,,Öyleyse güzelce kaydedeceğim bunu.
Dialogue: 0,0:17:26.56,0:17:30.94,Default,,0,0,0,,Tsubasa'nın Japonya'daki\Nson turnuvası olacak, değil mi?
Dialogue: 0,0:17:32.78,0:17:33.86,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:17:35.11,0:17:36.20,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:17:36.20,0:17:37.45,Default,,0,0,0,,Bekle lütfen!
Dialogue: 0,0:17:37.45,0:17:40.12,Default,,0,0,0,,Gerçekten de bölgesel turnuvaya\Nkatılmayacak mısın?
Dialogue: 0,0:17:40.12,0:17:45.04,Default,,0,0,0,,Kendi futbolunuzla ulusallara\Ngitmeyi başarmayacak mıydınız?
Dialogue: 0,0:17:46.12,0:17:48.88,Default,,0,0,0,,Görüşürüz. İyi haberleri bekliyor olacağım.
Dialogue: 0,0:17:48.88,0:17:51.05,Default,,0,0,0,,Kesinlikle kazanın.
Dialogue: 0,0:17:52.71,0:17:55.05,Default,,0,0,0,,Bu kadar sert olmak zorunda değil ki.
Dialogue: 0,0:17:55.05,0:17:58.18,Default,,0,0,0,,Hayır. Şu ana kadar\Nona çok bel bağladık.
Dialogue: 0,0:17:58.18,0:18:02.31,Default,,0,0,0,,Ayrıca kaptanın kesinlikle\Nkazanmasını gerektiren bir sebep var.
Dialogue: 0,0:18:02.31,0:18:02.97,Default,,0,0,0,,Sebep mi?
Dialogue: 0,0:18:03.39,0:18:07.10,Default,,0,0,0,,Geçen sene Kaptan, babasını kaybetti.
Dialogue: 0,0:18:08.40,0:18:10.56,Default,,0,0,0,,Hala küçük kardeşleri de var...
Dialogue: 0,0:18:10.56,0:18:13.07,Default,,0,0,0,,...ve annesi farklı işlerde çalışıyor.{a lot also works here but then nuance will be lost, working hard and working in different jobs are not same}
Dialogue: 0,0:18:13.07,0:18:16.61,Default,,0,0,0,,Bu durumda tüm ev işleri\NKaptan'a bakıyor.
Dialogue: 0,0:18:17.11,0:18:21.91,Default,,0,0,0,,Bu yüzden Kaptan, profesyonel takımların\Nkendisini keşfetmesi için ulusalları kazanmak istiyor.
Dialogue: 0,0:18:21.91,0:18:25.29,Default,,0,0,0,,Annesine daha erken yardımcı\Nolabilecek böylelikle.
Dialogue: 0,0:18:25.29,0:18:29.79,Default,,0,0,0,,Doğru ya. Ulusallara çok sayıda\Nyetenek avcısı oluyor değil mi?
Dialogue: 0,0:18:29.79,0:18:30.75,Default,,0,0,0,,Anladım.
Dialogue: 0,0:18:30.75,0:18:34.13,Default,,0,0,0,,Kaptan'ımız için biz de\Nelimizden geleni yapmalıyız!
Dialogue: 0,0:18:34.13,0:18:35.51,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:36.97,0:18:42.10,Default,,0,0,0,,Tüm ülke çapında, ulusal turnuva\Niçin elemeler başlamıştı.
Dialogue: 0,0:18:43.56,0:18:45.10,Default,,0,0,0,,Yine seçildim.{"is he a smug asshole?", tsubasa and genzo think}
Dialogue: 0,0:18:45.68,0:18:48.02,Default,,0,0,0,,Wakabayashi-kun, birazdan başlayacağız.{work here, i can never get this right. but i can say this, they're serious about each other. good meaning wise. nope}
Dialogue: 0,0:18:48.02,0:18:49.90,Default,,0,0,0,,Evet. Başlayacağız.
Dialogue: 0,0:18:49.90,0:18:51.11,Default,,0,0,0,,Bacağın iyi mi?
Dialogue: 0,0:18:51.11,0:18:54.11,Default,,0,0,0,,İyi olduğu için buradayım.
Dialogue: 0,0:18:54.48,0:18:57.24,Default,,0,0,0,,İlk turun 3. maçı başlamak üzere.
Dialogue: 0,0:18:57.65,0:19:01.74,Default,,0,0,0,,Nankatsu FC ile Fuji FC\Nkarşı karşıya gelecek.
Dialogue: 0,0:19:02.07,0:19:05.08,Default,,0,0,0,,Bu ilk maçınız. Her şeyinizi ortaya koyun.
Dialogue: 0,0:19:05.08,0:19:06.00,Default,,0,0,0,,- Tamam!\N- Tamam!
Dialogue: 0,0:19:07.75,0:19:10.37,Default,,0,0,0,,Yedekte miyim yani?!
Dialogue: 0,0:19:11.67,0:19:14.84,Default,,0,0,0,,Tsubasa, seni desteklemeye geldim.
Dialogue: 0,0:19:14.84,0:19:16.01,Default,,0,0,0,,Baba!
Dialogue: 0,0:19:16.01,0:19:18.26,Default,,0,0,0,,O hat tricki yap!
Dialogue: 0,0:19:18.59,0:19:19.51,Default,,0,0,0,,Tamam!
Dialogue: 0,0:19:22.39,0:19:26.06,Default,,0,0,0,,Tsubasa-kun, hadi!
Dialogue: 0,0:19:26.68,0:19:29.39,Default,,0,0,0,,Nankatsu'nun top vuruşuyla maç başlıyor.
Dialogue: 0,0:19:30.64,0:19:32.65,Default,,0,0,0,,Bekle beni ulusallar.
Dialogue: 0,0:19:32.65,0:19:35.65,Default,,0,0,0,,Herkese yeteneğimi göstereceğim.
Dialogue: 0,0:19:35.65,0:19:39.32,Default,,0,0,0,,O zaman futbol temelli bir okulda\Nfutbol bursu alabilirim.
Dialogue: 0,0:19:39.32,0:19:42.91,Default,,0,0,0,,Böylelikle kendimi tamamen\Nfutbola adayabilirim!
Dialogue: 0,0:19:43.57,0:19:47.08,Default,,0,0,0,,Girdi! Nankatsu çabucak bir gol attı!
Dialogue: 0,0:19:47.08,0:19:48.83,Default,,0,0,0,,İşte bu! Bir!
Dialogue: 0,0:19:48.83,0:19:50.00,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:50.87,0:19:54.75,Default,,0,0,0,,Aynen öyle.\NKaderini kendin yazabilirsin sadece.{path is meant to be carved on your own maybe}{nah this is a good translation, it's an idiom} {i get the implication is that "YOU carve your own path" but it's kind of implied; if you want to overemphasize then we can try this...}
Dialogue: 0,0:19:57.96,0:19:59.72,Default,,0,0,0,,Nankatsu 2. golünü atıyor!
Dialogue: 0,0:20:06.06,0:20:08.68,Default,,0,0,0,,Bu sefer Tsubasa-kun topu sürüp\Ngolü attı!
Dialogue: 0,0:20:09.14,0:20:11.44,Default,,0,0,0,,Bacağım için endişeleniyordum ama...
Dialogue: 0,0:20:11.44,0:20:14.31,Default,,0,0,0,,...bu gidişle kaleci\Nyeteneklerime ihtiyaçları olmayacak.{ok, what? aria help he says "at this rate  they wont need my goalkeeping skillz}
Dialogue: 0,0:20:14.31,0:20:16.61,Default,,0,0,0,,Elinden geleni yap!
Dialogue: 0,0:20:14.69,0:20:16.61,Default - Top,,0,0,0,,Hadi bastır Tsubasa!
Dialogue: 0,0:20:16.61,0:20:18.32,Default,,0,0,0,,Böyle devam et!
Dialogue: 0,0:20:18.32,0:20:19.82,Default,,0,0,0,,Tutun şunu! Etrafını sarın!
Dialogue: 0,0:20:26.37,0:20:29.87,Default,,0,0,0,,Tsubasa-kun ve Misaki-kun\Nharika bir ikili pas sergiliyor!
Dialogue: 0,0:20:29.87,0:20:32.37,Default,,0,0,0,,İşte kombine oyunları!
Dialogue: 0,0:20:32.37,0:20:35.79,Default,,0,0,0,,Koşup voleyi yapıştırıyor!
Dialogue: 0,0:20:37.13,0:20:39.09,Default,,0,0,0,,Kaleci hareket bile edemedi!
Dialogue: 0,0:20:39.09,0:20:42.63,Default,,0,0,0,,Tsubasa-kun ilk yarının daha\Nbaşlarında hat trick yaptı!
Dialogue: 0,0:20:42.63,0:20:44.51,Default,,0,0,0,,Başardım baba!{let me hook up with Genzo}
Dialogue: 0,0:20:44.51,0:20:48.97,Default,,0,0,0,,Güzel. Baban en sevdiği gemisiyle\Ndeniz yolculuğuna çıkacak.
Dialogue: 0,0:20:48.97,0:20:54.52,Default,,0,0,0,,Sen de ulusalları kazanıp Brezilya'ya\Ngit ve futbolunu geliştir!
Dialogue: 0,0:20:54.52,0:20:57.52,Default,,0,0,0,,Tamam! Kendine dikkat et baba!{while I hook up with him}
Dialogue: 0,0:20:59.65,0:21:00.86,Default,,0,0,0,,İyi yolculuklar.
Dialogue: 0,0:21:00.86,0:21:02.90,Default,,0,0,0,,Evet. Geri döneceğim.
Dialogue: 0,0:21:04.66,0:21:08.74,Default,,0,0,0,,Nankatsu FC 7 - 0 Fuji FC\Nİkinci Tur Elemeleri
Dialogue: 0,0:21:10.75,0:21:14.62,Default,,0,0,0,,İşte. Çocukların uyuma vakti gelmiş olmalı.
Dialogue: 0,0:21:15.04,0:21:16.88,Default,,0,0,0,,Hoş geldin anne.
Dialogue: 0,0:21:17.25,0:21:19.46,Default,,0,0,0,,Akşam yemeğini hazırladım.
Dialogue: 0,0:21:19.46,0:21:20.55,Default,,0,0,0,,Kazandınız mı?
Dialogue: 0,0:21:20.55,0:21:22.55,Default,,0,0,0,,Bugün maçın vardı değil mi?
Dialogue: 0,0:21:22.55,0:21:24.88,Default,,0,0,0,,Evet. Çocuklar kazanmış.
Dialogue: 0,0:21:24.88,0:21:27.09,Default,,0,0,0,,Oynamamanda sorun yok mu?
Dialogue: 0,0:21:29.51,0:21:36.04,Default,,0,0,0,,İlk turu kazanmasının ardından Nankatsu FC,\Nseri bir şekilde zafer almasını hala sürdürüyordu.
Dialogue: 0,0:21:36.04,0:21:37.56,Default,,0,0,0,,Bu sırada...
Dialogue: 0,0:21:38.31,0:21:40.32,Default,,0,0,0,,Girdi! 2-0!
Dialogue: 0,0:21:40.32,0:21:42.94,Default,,0,0,0,,Saitama'yı temsil edecek takımı\Nbelirleyecek maçta...
Dialogue: 0,0:21:42.94,0:21:47.07,Default,,0,0,0,,...ilk yarının başlarında Nanbu FC,\NMeiwa FC'ye iki gol atarak liderliği ele aldı!
Dialogue: 0,0:21:47.45,0:21:48.87,Default,,0,0,0,,İmkansız.
Dialogue: 0,0:21:48.87,0:21:52.12,Default,,0,0,0,,Dünkü çeyrek finalleri zar zor kazandık ama...
Dialogue: 0,0:21:52.12,0:21:55.08,Default,,0,0,0,,Hyuga-san olmadan bu maçı...
Dialogue: 0,0:21:59.54,0:22:01.42,Default,,0,0,0,,Kaptan.
Dialogue: 0,0:22:08.14,0:22:10.64,Default,,0,0,0,,Bizim sıramız gelmiş gibi duruyor.
Dialogue: 0,0:22:10.64,0:22:12.06,Default,,0,0,0,,Gidelim Takeshi!{that's the name of the kid that gets bullied in school! true words}
Dialogue: 0,0:22:12.06,0:22:13.81,Default,,0,0,0,,Tamam Kaptan!{hai, owari!}
