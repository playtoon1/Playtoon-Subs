Dialogue: 0,0:00:00.00,0:00:03.98,AnimeSeverler,,0,0,0,,'Anime Severler' İyi Seyirler Diler!\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:00:01.27,0:00:03.98,Default,,0,0,0,,{\fad(500,0)\pos(960,940.999)}SHİZUOKA EYALETİ - NANKATSU ŞEHRİ
Dialogue: 0,0:00:02.58,0:00:03.98,Default-TOP,,0,0,0,,Hey, şuna bir bak.
Dialogue: 0,0:00:03.98,0:00:06.44,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:00:03.98,0:00:06.44,Default-TOP,,0,0,0,,DRİVE SHOT TAMAMLANDI!
Dialogue: 0,0:00:03.98,0:00:06.44,Default,,0,0,0,,Tsubasa hakkında bir makale var.
Dialogue: 0,0:00:06.44,0:00:09.96,Default,,0,0,0,,"Tsubasa Ozora, mucizevi Drive Shot'unu mükemmelleştirdi.
Dialogue: 0,0:00:09.96,0:00:12.72,Default,,0,0,0,,Nankatsu'nun 3. zaferine sadece 2 maç kaldı."diyor.
Dialogue: 0,0:00:12.72,0:00:16.67,Default,,0,0,0,,Yarı finaller Nankatsu-Furano ve Toho-Meiwa Higashi arasında olacak.
Dialogue: 0,0:00:16.67,0:00:19.47,Default,,0,0,0,,Finalin, Nankatsu ve Toho arasında olacağı bariz değil mi?
Dialogue: 0,0:00:19.47,0:00:21.50,Default,,0,0,0,,Bunu hala bilmiyoruz.
Dialogue: 0,0:00:21.50,0:00:22.67,Default,,0,0,0,,Urabe!
Dialogue: 0,0:00:22.67,0:00:26.28,Default,,0,0,0,,Tsubasa'nın Drive Shot'u azimli olabilir, ancak Furano'nun
Dialogue: 0,0:00:26.28,0:00:29.88,Default,,0,0,0,,takım oyununa karşı tek başına kazanması zor olacaktır.
Dialogue: 0,0:00:22.67,0:00:29.88,Default-TOP,,0,0,0,,Drive Shot: İçeri Dalma Vuruşu, Kartal Vuruşu
Dialogue: 0,0:00:30.88,0:00:35.38,Default,,0,0,0,,{\fad(500,500)\pos(960,940.999)}MEİWA HİGASHİ ORTAOKULU
Dialogue: 0,0:00:30.32,0:00:36.66,Default-TOP,,0,0,0,,Dahası, Toho'nun rakipleri, Meiwa Higashi'nin normal 8'i eski Meiwa FC üyesidir,
Dialogue: 0,0:00:36.89,0:00:39.39,Default,,0,0,0,,{\fad(500,500)\pos(960,940.999)}MEİWA FC
Dialogue: 0,0:00:36.66,0:00:39.39,Default-TOP,,0,0,0,,o zamanlar Hyuga'nın yanında mücadele eden arkadaşlarından.
Dialogue: 0,0:00:39.39,0:00:42.26,Default,,0,0,0,,Yani Koç Kira'nın öğrencileri arasında bir gösteri mi olacak?
Dialogue: 0,0:00:42.26,0:00:46.77,Default,,0,0,0,,Meiwa Higashi ayrıca Hyuga ve arkadaşlarının kişilikleri ve alışkanlıklarını da biliyor.
Dialogue: 0,0:00:46.77,0:00:48.42,Default,,0,0,0,,Hepsi bu değil.
Dialogue: 0,0:00:48.42,0:00:51.94,Default,,0,0,0,,Bugünkü maça sahip oldukları her şeyi koyacaklarına eminiz.
Dialogue: 0,0:00:51.94,0:00:55.20,Default,,0,0,0,,Tıpkı Nankatsu'ya karşı yaptığımız gibi...
Dialogue: 0,0:00:55.96,0:01:00.70,Default,,0,0,0,,Toho bu yarı final maçında Hyuga'yı kullanmazsa,
Dialogue: 0,0:01:00.70,0:01:05.33,Default,,0,0,0,,Toho ile Meiwa Higashi arasındaki maçı kimin kazanacağını bilmek mümkün değil.
Dialogue: 0,0:01:09.96,0:01:24.96,AnimeSeverler,,0,0,0,,{\4c&HB2A722&}Alt yazıyla ilgili görüşlerinizi instagram hesabımıza iletebilirsiniz. \Nİnstagram: AnimeSeverlerrr
Dialogue: 0,0:02:40.34,0:02:45.35,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}43. BÖLÜM: \NŞİDDETLİ KAPLAN ATEŞİ YAKAR
Dialogue: 0,0:02:42.87,0:02:45.50,Default-TOP,,0,0,0,,{\i1}Ulusal Ortaokul Futbol Turnuvasında, Japonya'nın{\i0}
Dialogue: 0,0:02:45.50,0:02:48.13,Default,,0,0,0,,{\i1}her bir bölgesini temsil eden 47 takım mücadele etti,{\i0}
Dialogue: 0,0:02:48.13,0:02:49.60,Default,,0,0,0,,{\i1}ve dört takım dışında hepsi kaybetti!{\i0}
Dialogue: 0,0:02:49.60,0:02:52.31,Default,,0,0,0,,{\i1}İlk yarı final maçı başlamak üzere!{\i0}
Dialogue: 0,0:02:52.31,0:02:55.15,Default,,0,0,0,,{\i1}Ev sahibi Saitama eyaletinin temsilcileri, Meiwa Higashi,{\i0}
Dialogue: 0,0:02:55.15,0:02:58.69,Default,,0,0,0,,{\i1}ve Tokyo temsilcileri Toho Akademi ile, çarpışacak.{\i0}
Dialogue: 0,0:02:58.69,0:03:02.15,Default,,0,0,0,,{\i1}Her iki takımın oyuncuları sahaya çıktı.{\i0}
Dialogue: 0,0:03:04.99,0:03:07.33,Default,,0,0,0,,{\i1}Toho, şampiyonluk rakibi olarak kabul ediliyor,{\i0}
Dialogue: 0,0:03:07.33,0:03:12.04,Default,,0,0,0,,{\i1}asları Hyuga'yı korurken, maçlarını kolaylıkla kazanıyorlardı.{\i0}
Dialogue: 0,0:03:12.04,0:03:17.71,Default,,0,0,0,,{\i1}Öte yandan, Meiwa Higashi, karakteristik olarak saldırgan futbol oynayarak kazandı.{\i0}
Dialogue: 0,0:03:17.71,0:03:19.15,Default,,0,0,0,,{\i1}Sadece izle, Toho.{\i0}
Dialogue: 0,0:03:19.15,0:03:21.26,Default,,0,0,0,,{\i1}Sizi yenecek olanlar biziz.{\i0}
Dialogue: 0,0:03:21.94,0:03:24.14,Default,,0,0,0,,{\i1}Senpai, kaybetmeyeceğiz!{\i0}
Dialogue: 0,0:03:24.14,0:03:27.56,Default,,0,0,0,,{\i1}Görünüşe göre Hyuga bugün de yedek kulübesinde.{\i0}
Dialogue: 0,0:03:27.56,0:03:28.31,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:03:28.31,0:03:30.06,Default,,0,0,0,,Demek yine yedek kulübesindesin.
Dialogue: 0,0:03:30.06,0:03:31.27,Default,,0,0,0,,Hyuga-kun...
Dialogue: 0,0:03:35.02,0:03:37.32,Default,,0,0,0,,{\ i1} Bu maç bizimdir. {\ i0}
Dialogue: 0,0:03:38.86,0:03:40.48,Default,,0,0,0,,Git Meiwa Higashi!
Dialogue: 0,0:03:40.48,0:03:43.87,Default,,0,0,0,,{\i1}Evde oynadıkları için, standlar Meiwa Higashi destekçileriyle dolu.{\i0}
Dialogue: 0,0:03:43.87,0:03:47.12,Default,,0,0,0,,{\i1}Bu önemli maçta güvenilir müttefikler olacaklar.{\i0}
Dialogue: 0,0:03:47.12,0:03:49.41,Default,,0,0,0,,Beklendiği gibi, Hyuga yedek kulübesinde.
Dialogue: 0,0:03:49.41,0:03:52.87,Default,,0,0,0,,Sadece Takeshi ve Wakashimazu'ya dikkat etmemiz gerekecek.
Dialogue: 0,0:03:52.87,0:03:55.68,Default,,0,0,0,,Onlar hakkında her şeyi biliyoruz:
Dialogue: 0,0:03:55.68,0:03:58.55,Default,,0,0,0,,Kişilikleri, oyunları, hamleleri ve zayıf noktaları.
Dialogue: 0,0:03:58.55,0:04:00.88,Default,,0,0,0,,Çünkü eskiden takım arkadaşıydık.
Dialogue: 0,0:04:00.88,0:04:04.62,Default,,0,0,0,,Takeshi'yi kontrol altında tutabilir ve Wakashimazu'dan bir gol çalabiliriz.
Dialogue: 0,0:04:04.62,0:04:08.76,Default,,0,0,0,,Toho'da Kojiro Hyuga yoksa, kesinlikle kazanabiliriz!
Dialogue: 0,0:04:08.76,0:04:11.85,Default,,0,0,0,,Kesinlikle Toho'yu yeneceğiz!
Dialogue: 0,0:04:11.85,0:04:13.35,Default,,0,0,0,,Evet!
Dialogue: 0,0:04:14.24,0:04:19.69,Default,,0,0,0,,{\i1}İlk yarı final maçı Meiwa Higashi'nin ilk vuruşuyla başladı.{\i0}
Dialogue: 0,0:04:21.49,0:04:23.49,Default,,0,0,0,,Tamam, işte başlıyoruz!
Dialogue: 0,0:04:23.49,0:04:24.74,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:04:31.29,0:04:35.58,Default,,0,0,0,,{\i1}Maç başladığında, Meiwa Higashi bir dizi pas atıyor ve sürekli saldırıyor!{\i0}
Dialogue: 0,0:04:35.58,0:04:37.41,Default,,0,0,0,,Git git Meiwa Higashi!
Dialogue: 0,0:04:37.41,0:04:39.21,Default,,0,0,0,,Git git Meiwa Higashi!
Dialogue: 0,0:04:39.21,0:04:41.17,Default,,0,0,0,,Sanki senin gibilere kaybederiz!
Dialogue: 0,0:04:41.17,0:04:41.84,Default,,0,0,0,,Sawaki!
Dialogue: 0,0:04:43.85,0:04:46.72,Default,,0,0,0,,{\i1}Meiwa Higashi'nin saldırısı iyi gidiyor!\N{\i0}
Dialogue: 0,0:04:46.72,0:04:48.55,Default,,0,0,0,,İlk gol bizim olacak!
Dialogue: 0,0:04:50.29,0:04:54.64,Default,,0,0,0,,{\i1}Bir anda, Toho'nun Sawada Takeshi-kun'u Meiwa Higashi'nin şiddetli saldırısını durduruyor!{\i0}
Dialogue: 0,0:04:55.69,0:04:56.94,Default,,0,0,0,,Güzel oynadı.
Dialogue: 0,0:04:56.94,0:04:57.93,Default,,0,0,0,,{\ i1} Kazanacağız! {\ i0}
Dialogue: 0,0:04:57.93,0:05:01.19,Default,,0,0,0,,{\i1}Hyuga'sız oynamak zorunda olduğumuz son maç.{\i0}
Dialogue: 0,0:05:01.71,0:05:03.03,Default,,0,0,0,,{\i1}Takeshi...{\i0}
Dialogue: 0,0:05:03.03,0:05:07.66,Default,,0,0,0,,{\i1}Meiwa Higashi, Toho'nun oyun kurucu Sawada'yı durdurmak için iki oyuncu gönderiyor.{\i0}
Dialogue: 0,0:05:07.66,0:05:09.49,Default,,0,0,0,,{\ i1} Hadi, Takeshi! {\ i0}
Dialogue: 0,0:05:09.49,0:05:13.16,Default,,0,0,0,,{\i1}Bizden daha gençsin, sana kaybetmemize imkan yok!{\i0}
Dialogue: 0,0:05:13.83,0:05:14.54,Default,,0,0,0,,İşte!
Dialogue: 0,0:05:14.54,0:05:17.04,Default,,0,0,0,,{\i1}Sawada işini bir pasla tamamladı.{\i0}
Dialogue: 0,0:05:18.28,0:05:20.29,Default,,0,0,0,,{\i1}Ancak onun pası okundu!{\i0}
Dialogue: 0,0:05:20.79,0:05:22.59,Default,,0,0,0,,{\i1}Sorimachi-kun'a ulaşamıyor!{\i0}
Dialogue: 0,0:05:22.59,0:05:25.17,Default,,0,0,0,,Hareketlerinizi tamamen okuyabiliriz.
Dialogue: 0,0:05:25.84,0:05:26.80,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:05:26.80,0:05:29.30,Default,,0,0,0,,{\i1}Meiwa Higashi yine saldırıyor!{\i0}
Dialogue: 0,0:05:30.18,0:05:32.81,Default,,0,0,0,,Meiwa Higashi bugün çok iyi gidiyor.
Dialogue: 0,0:05:32.81,0:05:36.19,Default,,0,0,0,,Özellikle Toho, Meiwa Higashi için özel bir rakip.
Dialogue: 0,0:05:36.19,0:05:40.19,Default,,0,0,0,,Gözlerini sadece bu maça odaklamış ve gerçekten hazırlıklı olmalılar.
Dialogue: 0,0:05:40.19,0:05:41.36,Default,,0,0,0,,Sawaki!
Dialogue: 0,0:05:42.53,0:05:45.90,Default,,0,0,0,,{\i1}Meiwa Higashi hızla atış menziline giriyor.{\i0}
Dialogue: 0,0:05:45.90,0:05:47.99,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:05:47.99,0:05:51.37,Default,,0,0,0,,{\i1}Meiwa Higashi takımından Sawaki, maçın ilk vuruşunu yaptı!{\i0}
Dialogue: 0,0:05:51.37,0:05:52.24,Default,,0,0,0,,Kalede!
Dialogue: 0,0:05:53.27,0:05:54.34,Default,,0,0,0,,{\ İ1} Başardı! {\ İ0}
Dialogue: 0,0:05:54.34,0:05:56.54,Default,,0,0,0,,{\i1}Kaleci Wakashimazu-kun'dan iyi kurtarış!{\i0}
Dialogue: 0,0:05:56.54,0:05:58.04,Default,,0,0,0,,İyi, Wakashimazu-san!
Dialogue: 0,0:05:58.04,0:06:00.92,Default,,0,0,0,,{\i1}Turnuvanın 1 numaralı kalecisinden beklendiği gibi.{\i0}
Dialogue: 0,0:06:00.92,0:06:03.63,Default,,0,0,0,,{\i1}Wakashimazu rekorunu hala koruyor! {\i0}{not sure about record part, term would be clean sheet but match's not over yet so i'm leaving you}
Dialogue: 0,0:06:05.75,0:06:07.43,Default,,0,0,0,,{\i1}Tamda senden beklendiği gibi Wakashimazu.{\i0}
Dialogue: 0,0:06:07.43,0:06:09.35,Default,,0,0,0,,{\ i1} Ama daha yeni başlıyoruz... {\ i0}
Dialogue: 0,0:06:09.35,0:06:11.55,Default,,0,0,0,,{\ i1} Kesinlikle senden bir gol alacağım! {\ i0}
Dialogue: 0,0:06:13.31,0:06:14.43,Default,,0,0,0,,Koşun!
Dialogue: 0,0:06:15.56,0:06:17.89,Default,,0,0,0,,Top forvet Sorimachi-kun'a ulaşıyor.
Dialogue: 0,0:06:17.89,0:06:19.06,Default,,0,0,0,,Sorimachi-san!
Dialogue: 0,0:06:19.73,0:06:22.19,Default,,0,0,0,,{\i1}Bu, Toho'nun bir başka favori taktiği!{\i0}
Dialogue: 0,0:06:23.39,0:06:25.31,Default,,0,0,0,,{\i1}Ahh, bu pas da kesildi!{\i0}
Dialogue: 0,0:06:25.31,0:06:27.53,Default,,0,0,0,,{\i1}Meiwa Higashi bu oyunu da okudu!{\i0}
Dialogue: 0,0:06:27.53,0:06:28.61,Default,,0,0,0,,Buraya!
Dialogue: 0,0:06:30.43,0:06:33.41,Default,,0,0,0,,{\i1}İlk yarı da 20 dakikamız kaldı,{\i0}
Dialogue: 0,0:06:33.41,0:06:35.47,Default,,0,0,0,,{\i1}ve her iki takım da şimdiye kadar gol atamadı.{\i0}
Dialogue: 0,0:06:35.47,0:06:38.08,Default,,0,0,0,,{\i1}Bu 0-0 gerginlik dengesi bozulmadan kaldı.{\i0}
Dialogue: 0,0:06:38.64,0:06:43.59,Default,,0,0,0,,{\i1}Toho'nun ası Hyuga'nın yerini dolduran forvet Sorimachi ile Toho'nun genç{\i0}
Dialogue: 0,0:06:43.59,0:06:47.09,Default,,0,0,0,,{\i1}oyun kurucusu Sawada arasındaki \Nkombinasyon oyun tamamen tıkandı!{\i0}
Dialogue: 0,0:06:47.09,0:06:49.15,Default,,0,0,0,,{\i1}Skor yapma şansı bulamıyorlar.{\i0}
Dialogue: 0,0:06:49.15,0:06:50.01,Default,,0,0,0,,{\i1}Tamamdır!{\i0}
Dialogue: 0,0:06:50.01,0:06:52.41,Default,,0,0,0,,Bu iyi değil. Paslarım işe yaramıyor.
Dialogue: 0,0:06:52.97,0:06:56.00,Default,,0,0,0,,{\i1}Oyun Meiwa Higashi kontrolü altındaymış gibi hissettirmesine rağmen,{\i0}
Dialogue: 0,0:06:57.42,0:06:59.42,Default,,0,0,0,,{\i1}Wakashimazu'nun onları durdurması,
Dialogue: 0,0:06:59.42,0:07:02.90,Default,,0,0,0,,{\i1}gol atmalarına engel oluyor ve skor yapamıyorlar.{\i0}
Dialogue: 0,0:07:02.21,0:07:02.90,Default-TOP,,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:03.41,0:07:05.19,Default,,0,0,0,,Senin için Takeshi!
Dialogue: 0,0:07:07.41,0:07:09.09,Default,,0,0,0,,{\i1}Sawada topu karşı sahaya getiriyor!{\i0}
Dialogue: 0,0:07:09.09,0:07:11.45,Default,,0,0,0,,{\i1}Bir sonraki pası kime gönderecek?{\i0}
Dialogue: 0,0:07:12.00,0:07:14.58,Default,,0,0,0,,{\ i1} Sorimachi-san tutuluyor. {\ i0}
Dialogue: 0,0:07:14.58,0:07:15.28,Default,,0,0,0,,İşte!
Dialogue: 0,0:07:15.28,0:07:16.35,Default,,0,0,0,,{\i1}Yan tarafa gönderiyor.{\i0}
Dialogue: 0,0:07:16.35,0:07:16.83,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:07:17.33,0:07:17.65,Default,,0,0,0,,Ah!
Dialogue: 0,0:07:17.65,0:07:20.16,Default,,0,0,0,,{\i1}Meiwa Higashi yine kesti!{\i0}
Dialogue: 0,0:07:20.16,0:07:21.25,Default,,0,0,0,,Faydasız.
Dialogue: 0,0:07:21.25,0:07:23.63,Default,,0,0,0,,Hareketlerimin her biri okunuyor.
Dialogue: 0,0:07:23.63,0:07:26.25,Default,,0,0,0,,Keşke şimdi Hyuga-san burada olsaydı...
Dialogue: 0,0:07:34.50,0:07:37.05,Default,,0,0,0,,{\i1}Maalesef, Meiwa Higashi son bir saldırıda{\i0}
Dialogue: 0,0:07:37.05,0:07:39.60,Default,,0,0,0,,{\i1} bulunmak üzereyken, düdük çaldı!{\i0}
Dialogue: 0,0:07:39.60,0:07:42.10,Default,,0,0,0,,{\i1}İlk yarı da iki taraf da gol atamadı.{\i0}
Dialogue: 0,0:07:43.06,0:07:44.54,Default,,0,0,0,,{\i1}Şampiyonluk yarışmacısı Toho{\i0}
Dialogue: 0,0:07:44.54,0:07:49.07,Default,,0,0,0,,{\i1}ilk kez gol atmadan yarı devreye giriyor.{\i0}
Dialogue: 0,0:07:51.69,0:07:54.28,Default,,0,0,0,,Toho bastırılıyor.
Dialogue: 0,0:07:54.28,0:07:54.91,Default,,0,0,0,,Evet.
Dialogue: 0,0:07:54.91,0:07:57.54,Default,,0,0,0,,Bu maç Hyuga olmadan onlar için zor olacak.
Dialogue: 0,0:08:03.54,0:08:06.67,Default-TOP,,0,0,0,,MEİWA HİGASHİ ORTAOKULU \N SAİTAMA EYALETİ
Dialogue: 0,0:08:03.54,0:08:06.67,Default,,0,0,0,,Tamam! Savunmamız ilk yarıda kusursuzdu.
Dialogue: 0,0:08:06.67,0:08:08.40,Default,,0,0,0,,Tek yapmamız gereken, gol atmak.
Dialogue: 0,0:08:08.40,0:08:10.17,Default,,0,0,0,,Her ne pahasına olursa olsun 1 puan yapmalıyız!
Dialogue: 0,0:08:10.17,0:08:14.30,Default,,0,0,0,,Böyle saldırmaya devam edersek, kesin bir şans gelecektir!
Dialogue: 0,0:08:14.87,0:08:16.36,Default,,0,0,0,,Bu şansın kaçmasına izin vermeyin!
Dialogue: 0,0:08:16.36,0:08:17.30,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:17.30,0:08:18.89,Default-TOP,,0,0,0,,TOHO AKADEMİ \NTOKYO
Dialogue: 0,0:08:18.89,0:08:19.97,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:08:19.97,0:08:22.06,Default,,0,0,0,,Hızları tarafından ayaklarımız yerden kesiliyor.
Dialogue: 0,0:08:22.06,0:08:24.19,Default,,0,0,0,,Topu bizden bu kadar kolay nasıl çalabilirler?
Dialogue: 0,0:08:24.19,0:08:26.45,Default,,0,0,0,,Bu devam ederse, işler iyi bitmeyecek.
Dialogue: 0,0:08:29.39,0:08:31.17,Default,,0,0,0,,Tamam millet, toplanın.
Dialogue: 0,0:08:35.07,0:08:38.93,Default,,0,0,0,,Sawada. Tamamen okunuyorsun.
Dialogue: 0,0:08:38.93,0:08:40.33,Default,,0,0,0,,Risk alman sorun olmaz.
Dialogue: 0,0:08:40.33,0:08:44.05,Default,,0,0,0,,Taktiklerinizi ikinci yarıda biraz değiştirin; konumunuzu değiştirmeyi deneyin.
Dialogue: 0,0:08:44.05,0:08:45.56,Default,,0,0,0,,T-Tamam.
Dialogue: 0,0:08:45.56,0:08:47.71,Default,,0,0,0,,Sorimachi, aktif olarak gol atmaya devam et.
Dialogue: 0,0:08:47.71,0:08:49.34,Default,,0,0,0,,Gerekirse uzun şutlar at.
Dialogue: 0,0:08:49.34,0:08:52.42,Default,,0,0,0,,Kalecileri Wakashimazu kadar iyi değil.
Dialogue: 0,0:08:52.42,0:08:54.18,Default,,0,0,0,,Fırsatınız olursa şut çekin.
Dialogue: 0,0:08:54.18,0:08:54.97,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:54.97,0:08:56.10,Default,,0,0,0,,Anlaşıldı mı?
Dialogue: 0,0:08:56.10,0:08:57.97,Default,,0,0,0,,Bu maçı kesinlikle kazanacağız!
Dialogue: 0,0:08:57.97,0:08:59.91,Default,,0,0,0,,Oyuncu değişikliği yapılmayacak.
Dialogue: 0,0:08:59.91,0:09:02.18,Default,,0,0,0,,İlk yarıdaki oyuncularla oynayacağız.
Dialogue: 0,0:09:02.18,0:09:03.85,Default,,0,0,0,,Tamam...
Dialogue: 0,0:09:04.47,0:09:08.91,Default,,0,0,0,,{\i1}Sadece Kaptan oynasaydı, bu oyun çok daha kolay olurdu...{\i0}
Dialogue: 0,0:09:11.11,0:09:13.04,Default,,0,0,0,,Ne yapacaksınız Mikami-san?
Dialogue: 0,0:09:13.04,0:09:18.03,Default,,0,0,0,,Kesinlikle yeteneği var, ancak Kojiro Hyuga tüm bu turnuvada oynamadı.
Dialogue: 0,0:09:18.03,0:09:19.12,Default,,0,0,0,,Gerçekten.
Dialogue: 0,0:09:19.12,0:09:21.35,Default,,0,0,0,,{\i1}3-0...{\i0}
Dialogue: 0,0:09:21.35,0:09:24.62,Default,,0,0,0,,{\i1}Oynuyor olsaydım, bu maçta skor 3-0 olurdu.{\i0}
Dialogue: 0,0:09:24.62,0:09:26.07,Default,,0,0,0,,{\i1}Lanet olsun.{\i0}
Dialogue: 0,0:09:26.07,0:09:30.17,Default,,0,0,0,,{\i1}Eğer ikinci yarıda önümüze geçerlerse, çıkarım...{\i0}
Dialogue: 0,0:09:30.17,0:09:32.55,Default,,0,0,0,,{\i1}Sahaya doğru koşup oynayacağım!{\i0}
Dialogue: 0,0:09:34.92,0:09:38.76,Default,,0,0,0,,{\i1}İkinci yarı Toho Akademi'nin başlama vuruşuyla başlayacak.{\i0}
Dialogue: 0,0:09:36.80,0:09:39.47,Default-TOP,,0,0,0,,İyi şanslar Toho!
Dialogue: 0,0:09:40.51,0:09:43.11,Default,,0,0,0,,{\ i1} Ne olursa olsun, sadece 30 dakika kaldı. {\ i0}
Dialogue: 0,0:09:43.11,0:09:45.27,Default,,0,0,0,,{\ i1} Hangi takım büyük finallere yükselicek? {\ i0}
Dialogue: 0,0:09:45.27,0:09:47.25,Default,,0,0,0,,Git git, Meiwa Higashi!
Dialogue: 0,0:09:47.25,0:09:49.02,Default,,0,0,0,,Git git, Meiwa Higashi!
Dialogue: 0,0:09:49.79,0:09:53.15,Default,,0,0,0,,{\i1}Belki de hamlelerimi okuyabilmeleri çok doğal...{\i0}
Dialogue: 0,0:09:53.15,0:09:56.78,Default,,0,0,0,,{\i1}Meiwa Higashi oyuncularının çoğu, Meiwa FC takımından arkadaşlarım.{\i0}
Dialogue: 0,0:09:56.78,0:09:59.74,Default,,0,0,0,,{\i1}İlkokuldayken onlarla oynadım.{\i0}
Dialogue: 0,0:09:59.74,0:10:03.56,Default,,0,0,0,,{\i1}Dahası, hepsi Koç Kira tarafından eğitildi.{\i0}
Dialogue: 0,0:10:03.56,0:10:05.41,Default,,0,0,0,,{\i1}Ortalama oyuncular değiller.{\i0}
Dialogue: 0,0:10:05.41,0:10:08.46,Default,,0,0,0,,{\i1}Benim gibi başka bir orta saha oyuncusu, Tsubasa{\i0}
Dialogue: 0,0:10:08.46,0:10:11.50,Default,,0,0,0,,{\i1}olsaydı... merak ediyorum, nasıl geçecekti?{\i0}
Dialogue: 0,0:10:11.50,0:10:13.50,Default,,0,0,0,,{\ i1} Keşke Hyuga-san olsaydı... {\ i0}
Dialogue: 0,0:10:14.49,0:10:15.46,Default,,0,0,0,,Aldım!
Dialogue: 0,0:10:15.46,0:10:17.72,Default,,0,0,0,,{\i1}Sawada-kun topu kolayca kaptırıyor!{\i0}
Dialogue: 0,0:10:17.72,0:10:18.80,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:10:18.80,0:10:20.30,Default,,0,0,0,,İyi çalım!
Dialogue: 0,0:10:20.30,0:10:22.67,Default,,0,0,0,,{\ i1} Meiwa Higashi hızla saldırmaya devam ediyor! {\ i0}
Dialogue: 0,0:10:22.67,0:10:24.81,Default,,0,0,0,,{\i1}Meiwa Higashi bu yarıda da hız kazanacak mı?{\i0}
Dialogue: 0,0:10:24.81,0:10:27.71,Default,,0,0,0,,Bu kadar kolay okunabilmesi, \Nrahatlığını kaybetmesine neden oldu.
Dialogue: 0,0:10:27.71,0:10:28.41,Default,,0,0,0,,Eh?
Dialogue: 0,0:10:28.41,0:10:32.06,Default,,0,0,0,,Belki de bir oyun kurucu olmak Sawada gibi\N birinci sınıf öğrencisi için çok büyük bir yüktür.
Dialogue: 0,0:10:32.06,0:10:33.53,Default,,0,0,0,,{\ i1} Ne yapıyorum? {\ i0}
Dialogue: 0,0:10:33.53,0:10:36.32,Default,,0,0,0,,{\ i1} Eğer böyle davranmaya devam\N edersem, tekrar hızlarına kapılırız. {\ i0}
Dialogue: 0,0:10:36.32,0:10:37.57,Default,,0,0,0,,{\i1}Takeshi...{\i0}
Dialogue: 0,0:10:37.57,0:10:38.32,Default,,0,0,0,,Seni durduracağım!
Dialogue: 0,0:10:38.69,0:10:39.57,Default,,0,0,0,,Ah!
Dialogue: 0,0:10:39.99,0:10:41.49,Default,,0,0,0,,{\ i1} Bu köşe vuruşu. {\ i0}
Dialogue: 0,0:10:41.49,0:10:43.45,Default,,0,0,0,,{\ i1} Bu ikinci yarının ilk korneri. {\ i0}
Dialogue: 0,0:10:43.45,0:10:45.12,Default,,0,0,0,,Tamam, şimdi bizim şansımız!
Dialogue: 0,0:10:45.12,0:10:46.76,Default,,0,0,0,,Bu dördüncü köşe vuruşumuz.
Dialogue: 0,0:10:46.76,0:10:48.96,Default,,0,0,0,,Bizim şansımız olabilir.
Dialogue: 0,0:10:48.96,0:10:50.96,Default,,0,0,0,,Imai! Daha ileri git!
Dialogue: 0,0:10:50.96,0:10:53.33,Default,,0,0,0,,{\i1}Toho, kalenin önünde saflarını sıklaştırıyor.{\i0}
Dialogue: 0,0:10:53.33,0:10:55.25,Default,,0,0,0,,{\ i1} Wakashimazu-kun emirlerini veriyor. {\ i0}
Dialogue: 0,0:10:55.25,0:10:57.21,Default,,0,0,0,,{\ i1} Kawagoe-kun köşe vuruşu kullanacak. {\ i0}
Dialogue: 0,0:10:57.21,0:11:00.78,Default,,0,0,0,,{\i1}Berbat edersem, Wakashimazu yakalayacaktır.{\i0}
Dialogue: 0,0:11:00.78,0:11:04.22,Default,,0,0,0,,{\i1}İlk önce, topa ulaşamayacağı bir yere göndermeliyim...{\i0}
Dialogue: 0,0:11:05.27,0:11:05.97,Default,,0,0,0,,İşte!
Dialogue: 0,0:11:05.97,0:11:07.97,Default,,0,0,0,,{\i1}Kaleden çok uzak!
Dialogue: 0,0:11:07.97,0:11:09.97,Default,,0,0,0,,{\i1}Wakashimazu onu almak için zıplayamaz!
Dialogue: 0,0:11:10.54,0:11:11.85,Default,,0,0,0,,Anladım!
Dialogue: 0,0:11:11.85,0:11:13.27,Default,,0,0,0,,Hadi yapalım millet!
Dialogue: 0,0:11:14.48,0:11:15.71,Default,,0,0,0,,Git!
Dialogue: 0,0:11:15.71,0:11:17.86,Default,,0,0,0,,{\i1}Meiwa Higashi, tüm üyeleri ile saldırıyor!
Dialogue: 0,0:11:17.86,0:11:18.62,Default,,0,0,0,,Ne?
Dialogue: 0,0:11:18.62,0:11:19.82,Default,,0,0,0,,Uzaklaştırın!
Dialogue: 0,0:11:19.82,0:11:22.20,Default,,0,0,0,,{\i1}Toho tam güçle onları durdurmak için gidiyor!{\i0}
Dialogue: 0,0:11:22.20,0:11:25.49,Default,,0,0,0,,{\i1}Kalenin tam önünde olan Hori-kun için büyük bir şans!{\i0}
Dialogue: 0,0:11:25.49,0:11:27.24,Default,,0,0,0,,Git!
Dialogue: 0,0:11:27.24,0:11:28.17,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:28.17,0:11:29.45,Default,,0,0,0,,{\ i1} Durdu! {\ i0}
Dialogue: 0,0:11:29.45,0:11:32.75,Default,,0,0,0,,{\i1}Bitmiş bir anlaşma gibi görünen bu şuta tepki vermeyi başardı!
Dialogue: 0,0:11:32.75,0:11:35.25,Default,,0,0,0,,{\ i1} Ama top hala oyunda! {\ i0}
Dialogue: 0,0:11:35.90,0:11:38.26,Default,,0,0,0,,Lütfen uzaklaştırın! Sadece topu uzaklaştırın!
Dialogue: 0,0:11:38.26,0:11:39.51,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:11:39.51,0:11:41.26,Default,,0,0,0,,Savunacağız! Topu uzaklaştırın!
Dialogue: 0,0:11:41.26,0:11:42.55,Default,,0,0,0,,{\ i1} Kim daha hızlı?! {\ i0}
Dialogue: 0,0:11:42.55,0:11:43.76,Default,,0,0,0,,{\ i1} Şut mu yoksa açma mı?! {\ i0}
Dialogue: 0,0:11:44.09,0:11:45.00,Default,,0,0,0,,Ye bunu!
Dialogue: 0,0:11:45.00,0:11:47.93,Default,,0,0,0,,Saldırgan Futbol Antrenörü Kira bizi eğitti!
Dialogue: 0,0:11:47.93,0:11:48.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:48.85,0:11:52.06,Default,,0,0,0,,Meiwa'nın Özel Kayan Takımı başladı!
Dialogue: 0,0:11:53.81,0:11:55.86,Default,,0,0,0,,Yakaladık!
Dialogue: 0,0:11:55.86,0:11:57.52,Default,,0,0,0,,Sana izin vermeme imkân yok...!
Dialogue: 0,0:12:04.66,0:12:06.53,Default,,0,0,0,,{\i1}İçerde!{\i0}
Dialogue: 0,0:12:06.53,0:12:09.16,Default,,0,0,0,,{\i1}Meiwa Higashi'nin ısrarı meyve veriyor!{\i0}
Dialogue: 0,0:12:09.16,0:12:11.91,Default,,0,0,0,,{\i1}Maçın ilk golü Meiwa Higashi'den!{\i0}
Dialogue: 0,0:12:16.00,0:12:22.50,AnimeSeverler,,0,0,0,,~Anime Severler~\N İnstagram: AnimeSeverlerrr
Dialogue: 0,0:12:22.47,0:12:25.97,Default,,0,0,0,,{\i1}Sonunda, gergin 0-0 kilitlenme kırıldı!{\i0}
Dialogue: 0,0:12:27.02,0:12:31.27,Default,,0,0,0,,{\i1}Meiwa Higashi, serbest topu kayan bir şutla Wakashimazu-kun saptırdı.
Dialogue: 0,0:12:31.27,0:12:34.58,Default,,0,0,0,,{\i1}Toho'nun savunması, gururlu demir duvarları,
Dialogue: 0,0:12:34.58,0:12:37.06,Default,,0,0,0,,{\i1}nihayet bu turnuvada ilk golünü yedi!{\i0}
Dialogue: 0,0:12:37.06,0:12:39.36,Default,,0,0,0,,Toho... atmalarına izin verdi.
Dialogue: 0,0:12:41.86,0:12:43.11,Default,,0,0,0,,Başardık!
Dialogue: 0,0:12:43.11,0:12:44.70,Default,,0,0,0,,Bir gol attık!
Dialogue: 0,0:12:44.70,0:12:47.70,Default,,0,0,0,,{\i1}Skor nihayet değiştiği için kutluyorlar.
Dialogue: 0,0:12:47.70,0:12:51.83,Default,,0,0,0,,{\i1}Bununla Meiwa Higashi büyük finale bir adım daha yaklaştı!{\i0}
Dialogue: 0,0:12:55.16,0:12:56.21,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:12:56.21,0:12:57.54,Default,,0,0,0,,Bekle, Hyuga!
Dialogue: 0,0:12:58.29,0:12:59.71,Default,,0,0,0,,Bu Hyuga.
Dialogue: 0,0:12:59.71,0:13:00.34,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:13:00.34,0:13:01.51,Default,,0,0,0,,Kojiro! 
Dialogue: 0,0:13:01.51,0:13:03.05,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:13:03.05,0:13:04.38,Default,,0,0,0,,Koç.
Dialogue: 0,0:13:04.38,0:13:06.47,Default,,0,0,0,,Tam olarak ne yapıyorsun?
Dialogue: 0,0:13:06.47,0:13:08.89,Default,,0,0,0,,Bu maçı oynamana izin vermeyi düşünmüyorum.
Dialogue: 0,0:13:08.89,0:13:10.60,Default,,0,0,0,,Otur, Hyuga.
Dialogue: 0,0:13:10.60,0:13:12.18,Default,,0,0,0,,Bunlar emrimlerim!
Dialogue: 0,0:13:15.07,0:13:18.56,Default,,0,0,0,,Emirler... Emirler, emirler...!
Dialogue: 0,0:13:19.59,0:13:22.11,Default,,0,0,0,,Kim öldü ve seni dünyanın kralı yaptı?!
Dialogue: 0,0:13:22.11,0:13:24.70,Default,,0,0,0,,Her zaman haklı olduğunu nereden çıkıyorsun?!
Dialogue: 0,0:13:25.09,0:13:25.86,Default,,0,0,0,,Ne?
Dialogue: 0,0:13:26.85,0:13:32.29,Default,,0,0,0,,Neden? Neden sadece bir maç oynayamıyorum?
Dialogue: 0,0:13:32.68,0:13:34.08,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:13:41.96,0:13:43.38,Default,,0,0,0,,Dur Hyuga!
Dialogue: 0,0:13:43.38,0:13:45.00,Default,,0,0,0,,Millet, şimdi kaybetmeyin!
Dialogue: 0,0:13:45.00,0:13:46.30,Default,,0,0,0,,Sadece bir puan öndeler.
Dialogue: 0,0:13:46.30,0:13:48.30,Default,,0,0,0,,Bolca zamanınız var!
Dialogue: 0,0:13:48.30,0:13:51.23,Default,,0,0,0,,Bunu tersine çevirmeniz mümkün!
Dialogue: 0,0:13:51.23,0:13:54.06,Default,,0,0,0,,Ama, sadece bu seferlik, bensiz yapmalısınız!
Dialogue: 0,0:13:54.06,0:13:56.44,Default,,0,0,0,,Size yalvarıyorum millet!
Dialogue: 0,0:13:56.44,0:13:57.56,Default,,0,0,0,,Hyuga. {I'll never forgive this shitcoach}
Dialogue: 0,0:13:57.56,0:13:58.72,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:13:58.72,0:14:00.19,Default,,0,0,0,,Hyuga-san.
Dialogue: 0,0:14:00.71,0:14:03.94,Default,,0,0,0,,Ne olursa olsun, finalde oynayacağım!
Dialogue: 0,0:14:06.20,0:14:07.50,Default,,0,0,0,,Hyuga-kun.
Dialogue: 0,0:14:10.24,0:14:12.08,Default,,0,0,0,,Tamam. Hadi yapalım millet!
Dialogue: 0,0:14:12.08,0:14:13.49,Default,,0,0,0,,Aynen kaptanımızın söylediği gibi.
Dialogue: 0,0:14:13.49,0:14:14.71,Default,,0,0,0,,Sadece bir puan öndeler.
Dialogue: 0,0:14:14.71,0:14:16.33,Default,,0,0,0,,Hadi hemen intikam alalım!
Dialogue: 0,0:14:18.66,0:14:19.46,Default,,0,0,0,,Evet!
Dialogue: 0,0:14:19.46,0:14:21.54,Default,,0,0,0,,Daha önce kaptanımız olmadan kazandık.
Dialogue: 0,0:14:21.54,0:14:24.34,Default,,0,0,0,,Toho'nun yapabileceği her şeyi gösterelim!
Dialogue: 0,0:14:24.34,0:14:26.59,Default,,0,0,0,,Bu maçı kesinlikle kazanacağız!
Dialogue: 0,0:14:26.59,0:14:27.83,Default,,0,0,0,,{\ i1} Doğru! {\ i0}
Dialogue: 0,0:14:27.83,0:14:34.71,Default,,0,0,0,,{\i1} Bu maçtan önce, hepimiz Hyuga-san olmadan kazanacağımıza yemin ettik.{\i0}
Dialogue: 0,0:14:34.71,0:14:39.56,Default,,0,0,0,,{\i1}Ayrıca, eğer koç Hyuga'nın yarınki final maçında oynamasına izin vermezse,{\i0}
Dialogue: 0,0:14:39.56,0:14:42.52,Default,,0,0,0,,{\ i1}maçı tamamen boykot edeceğiz.
Dialogue: 0,0:14:42.99,0:14:45.03,Default,,0,0,0,,{\ i1} Sadece izle Kaptan! {\ i0}
Dialogue: 0,0:14:45.47,0:14:47.03,Default,,0,0,0,,Millet...
Dialogue: 0,0:14:47.03,0:14:49.03,Default,,0,0,0,,{\ i1} Maç devam ediyor! {\ i0}
Dialogue: 0,0:14:49.03,0:14:52.98,Default,,0,0,0,,{\i1}Bir gol yemişken Toho nasıl bir saldırı oluşturacak?{\i0}
Dialogue: 0,0:14:52.98,0:14:53.80,Default,,0,0,0,,Anladınız mı millet?
Dialogue: 0,0:14:53.80,0:14:55.04,Default,,0,0,0,,Ne olursa olsun yakalayacağız!
Dialogue: 0,0:14:55.04,0:14:56.08,Default,,0,0,0,,Evet!!
Dialogue: 0,0:14:56.08,0:15:00.17,Default,,0,0,0,,{\i1}Hah, oyun kurucu Takeshi'nin \Ndeneyebileceği her hareketi biliyoruz.{\i0}
Dialogue: 0,0:15:00.17,0:15:03.50,Default,,0,0,0,,{\i1}Bu golle, şimdi finallere biletimizi aldık{\i0}
Dialogue: 0,0:15:05.34,0:15:06.46,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:15:06.46,0:15:10.84,Default,,0,0,0,,{\i1}Toho çaresiz beraberlik için, şiddetle Meiwa tarafına ilerliyor.
Dialogue: 0,0:15:10.84,0:15:12.84,Default,,0,0,0,,Özgürce hareket etmelerine izin vermeyin!
Dialogue: 0,0:15:12.84,0:15:17.77,Default,,0,0,0,,{\i1}Ancak, Meiwa Higashi'nin savunması \Nbugün muhteşem, tam puan kazanıyor!{\i0}
Dialogue: 0,0:15:17.77,0:15:23.30,Default,,0,0,0,,{\i1}Bu savunma, Toho'nun saha dışı olan ası Hyuga ile kırılmayacak kadar zor olacak mı?{\i0}
Dialogue: 0,0:15:23.30,0:15:24.61,Default,,0,0,0,,Millet...
Dialogue: 0,0:15:24.61,0:15:28.44,Default,,0,0,0,,{\ i1} Eğer bu oyunda Toho'nun standardını oynayabilirsek, kesinlikle kazanabiliriz.
Dialogue: 0,0:15:28.44,0:15:29.53,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:15:30.49,0:15:32.13,Default,,0,0,0,,{\ i1} Kesinlikle okunuyor! {\ i0}
Dialogue: 0,0:15:32.13,0:15:33.75,Default,,0,0,0,,{\ i1} Sawada'nın pası ulaşmayacak! {\ i0}
Dialogue: 0,0:15:33.75,0:15:34.49,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:15:34.49,0:15:35.50,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:35.50,0:15:37.50,Default,,0,0,0,,{\i1} Göz açıp kapayana kadar çaldı!{\i0}
Dialogue: 0,0:15:37.50,0:15:38.75,Default,,0,0,0,,İyi, Takeshi!
Dialogue: 0,0:15:38.75,0:15:41.04,Default,,0,0,0,,İşte bu! İşte ruh bu, Takeshi!
Dialogue: 0,0:15:41.73,0:15:43.40,Default,,0,0,0,,{\i1}Eğer senden çalarlarsa, geri al.{\i0}
Dialogue: 0,0:15:43.40,0:15:45.29,Default,,0,0,0,,{\ i1} Bütün yapman gereken bu.
Dialogue: 0,0:15:45.29,0:15:47.05,Default,,0,0,0,,{\ i1} Doğru değil mi, Tsubasa-san...? {\ i0}
Dialogue: 0,0:15:47.05,0:15:51.18,Default,,0,0,0,,{\ i1} Ben de senin gibi gol atan bir orta saha oyuncusu olacağım. {\ i0}
Dialogue: 0,0:15:51.18,0:15:52.38,Default,,0,0,0,,Durdurun!
Dialogue: 0,0:15:52.38,0:15:53.68,Default,,0,0,0,,Kahretsin!
Dialogue: 0,0:15:53.68,0:15:56.22,Default,,0,0,0,,{\i1}Sawada ustalıkla orta sahaya doğru ilerliyor.{\i0}
Dialogue: 0,0:15:56.22,0:15:57.77,Default,,0,0,0,,Şut çekecek!
Dialogue: 0,0:15:57.77,0:15:59.22,Default,,0,0,0,,Engelleyin!
Dialogue: 0,0:15:59.22,0:16:01.95,Default,,0,0,0,,{\ i1} Eski üst sınıf arkadaşlarım... Ben de kendimi geliştirdim! {\ i0}\N \N
Dialogue: 0,0:16:01.95,0:16:04.22,Default,,0,0,0,,{\ i1} Sawada şut çekmeye hazır! {\ i0}
Dialogue: 0,0:16:04.22,0:16:05.65,Default,,0,0,0,,Gol atmana izin vermeyeceğim!
Dialogue: 0,0:16:06.27,0:16:07.77,Default,,0,0,0,,Al!
Dialogue: 0,0:16:07.77,0:16:08.78,Default,,0,0,0,,Ne?!
Dialogue: 0,0:16:08.78,0:16:09.44,Default,,0,0,0,,Takeshi! {hyuga is a proud dad}
Dialogue: 0,0:16:09.44,0:16:11.44,Default,,0,0,0,,Bu senin hareketin, Tsubasa.
Dialogue: 0,0:16:12.91,0:16:16.07,Default,,0,0,0,,{\i1}Sorimachi'nin ilk kez pası ulaştı! {\i0}
Dialogue: 0,0:16:16.07,0:16:24.17,Default,,0,0,0,,Kaptanımız dönene kadar, merkez forvetteki iş benim!
Dialogue: 0,0:16:25.58,0:16:27.38,Default,,0,0,0,,{\i1}İçerde!{\i0}
Dialogue: 0,0:16:27.38,0:16:29.00,Default,,0,0,0,,Evet! İyi şut!
Dialogue: 0,0:16:29.00,0:16:32.00,Default,,0,0,0,,{\ i1} Toho, ikinci yarının 15. dakikasında,
Dialogue: 0,0:16:32.00,0:16:35.68,Default,,0,0,0,,{\ i1}mükemmel bir kombinasyonla skoru eşitledi! Artık 1-1!
Dialogue: 0,0:16:35.68,0:16:36.83,Default,,0,0,0,,Başardık!
Dialogue: 0,0:16:36.83,0:16:38.03,Default,,0,0,0,,Başardık Kaptan!
Dialogue: 0,0:16:38.03,0:16:39.12,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:16:39.12,0:16:40.02,Default,,0,0,0,,Millet!
Dialogue: 0,0:16:40.70,0:16:42.90,Default,,0,0,0,,Sonunda oyunu eşitledik!
Dialogue: 0,0:16:42.90,0:16:44.54,Default,,0,0,0,,{\ i1} Güzel şut, Sorimachi! {\ i0}
Dialogue: 0,0:16:44.54,0:16:48.02,Default,,0,0,0,,{\ i1} Ve Takeshi, şutdan pasa geçmek mükemmel bir karardı! {\ i0}
Dialogue: 0,0:16:48.02,0:16:50.47,Default,,0,0,0,,{\ i1} Şimdi kaybedemeyiz. {\ i0}
Dialogue: 0,0:16:50.47,0:16:56.28,Default,,0,0,0,,{\ i1} Çünkü ne olursa olsun rakibimizin tekrar gol atmasına izin vermeyeceğim! {\ i0}
Dialogue: 0,0:17:00.79,0:17:03.46,Default,,0,0,0,,Toho, ilk yarıda gol atamadığı için panik yapıyordu,
Dialogue: 0,0:17:03.46,0:17:05.38,Default,,0,0,0,,ama şimdi güvenlerini geri kazandılar.
Dialogue: 0,0:17:06.04,0:17:09.29,Default,,0,0,0,,Bu gol, Hyuga'nın yüreklendirmesi sayesinde oldu.
Dialogue: 0,0:17:09.72,0:17:10.70,Default,,0,0,0,,Lanet olsun.
Dialogue: 0,0:17:10.70,0:17:12.46,Default,,0,0,0,,Hala berabere.
Dialogue: 0,0:17:12.46,0:17:16.34,Default,,0,0,0,,{\ i1} Toho eşitliği sağladıktan sonra, \Nsaldırılarını sürdürüp hız kazanıyor.
Dialogue: 0,0:17:16.34,0:17:17.68,Default,,0,0,0,,Git!
Dialogue: 0,0:17:17.68,0:17:19.10,Default,,0,0,0,,Hemen öne geçelim çocuklar!
Dialogue: 0,0:17:19.65,0:17:22.22,Default,,0,0,0,,{\i1}Oyun şimdi tamamen Toho'nun hızına düştü.{\i0}
Dialogue: 0,0:17:22.22,0:17:27.48,Default,,0,0,0,,{\i1}Toho Hyuga'nın bu turnuvayı sürdürmemesini telafi etmek için sık sık takım olarak savaştı.
Dialogue: 0,0:17:27.48,0:17:34.03,Default,,0,0,0,,{\ i1} Bu nedenle, takım çalışması ve oyuncuların kişisel becerileri çok daha gelişti.
Dialogue: 0,0:17:34.03,0:17:37.49,Default,,0,0,0,,{\i1}Eğer şimdi Hyuga'yı bu takıma eklerseniz, korkunç olurlar.{\i0}
Dialogue: 0,0:17:37.49,0:17:41.05,Default,,0,0,0,,{\ i1} Bu maçta çok az dakika kaldı! {\ i0}
Dialogue: 0,0:17:41.05,0:17:43.55,Default,,0,0,0,,{\i1}Böyle biterse, Toho’nun Wakashimazu'su
Dialogue: 0,0:17:43.55,0:17:46.78,Default,,0,0,0,,{\i1}turnuvadaki 1 numaralı kaleci olduğunu da düşünürsek,
Dialogue: 0,0:17:46.78,0:17:49.13,Default,,0,0,0,,{\ i1} Meiwa Higashi çok büyük bir dezavantajda olacak!{\ i0}
Dialogue: 0,0:17:49.13,0:17:52.63,Default,,0,0,0,,Beraberlik oyunu Meiwa Higashi için temelde bir kayıp.
Dialogue: 0,0:17:52.63,0:17:55.13,Default,,0,0,0,,Bu kadar geldikten sonra kaybedemeyiz!
Dialogue: 0,0:17:55.13,0:17:58.05,Default,,0,0,0,,Millet! Beraberlik oyununa razı gelmeyin!
Dialogue: 0,0:17:58.05,0:18:01.51,Default,,0,0,0,,Toho'nun futbolu ne pahasına olursa olsun kazanmaktır!
Dialogue: 0,0:18:01.51,0:18:02.31,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:02.31,0:18:05.43,Default,,0,0,0,,{\ i1} Sonuçta Toho'nun kaptanı olduğunu kabul etmeli miyim? {\ i0}
Dialogue: 0,0:18:05.43,0:18:10.25,Default,,0,0,0,,{\ i1}Arkadaşlarını terk eden ve böylesine kritik bir zamanda kaybolan çocuk, {\ i0}
Dialogue: 0,0:18:10.25,0:18:13.61,Default,,0,0,0,,{\ i1}ön hazırlıklarda kazandığımız zaferden hemen sonra, Ulusal yarışmaya girdi.
Dialogue: 0,0:18:13.61,0:18:16.53,Default-TOP,,0,0,0,,Evet! Korkma, Sorimachi!
Dialogue: 0,0:18:16.53,0:18:18.32,Default-TOP,,0,0,0,,Kendiniz de yapabilirsiniz!
Dialogue: 0,0:18:13.61,0:18:18.32,Default,,0,0,0,,{\ i1} Her şeye rağmen, oyuncularımız hala bu çocuğa güveniyor Kojiro Hyuga. {\ i0}
Dialogue: 0,0:18:20.61,0:18:22.79,Default,,0,0,0,,Tek yaptığımız savunma.
Dialogue: 0,0:18:22.79,0:18:24.37,Default,,0,0,0,,Bir şekilde saldırmalıyız...
Dialogue: 0,0:18:24.37,0:18:25.37,Default,,0,0,0,,Hayır.
Dialogue: 0,0:18:25.37,0:18:26.87,Default,,0,0,0,,Devam etmelerine izin verin.
Dialogue: 0,0:18:27.93,0:18:30.88,Default,,0,0,0,,Karşı saldırıyı bekleyip şansımızı yakalayacağız!
Dialogue: 0,0:18:30.88,0:18:33.50,Default,,0,0,0,,Wakashimazu'ya karşı puan almak istiyorsak elimizdeki tek şey bu.
Dialogue: 0,0:18:34.03,0:18:35.96,Default,,0,0,0,,Tamam, anladım.
Dialogue: 0,0:18:39.51,0:18:40.18,Default,,0,0,0,,Sorimachi-san!
Dialogue: 0,0:18:40.91,0:18:42.80,Default,,0,0,0,,{\ i1} Toho'nun Sorimachi'si gönde—
Dialogue: 0,0:18:43.27,0:18:44.25,Default,,0,0,0,,{\ i1} Yapamadılar! {\ i0}
Dialogue: 0,0:18:44.25,0:18:46.31,Default,,0,0,0,,{\ i1} Meiwa Higashi pası durdurdu! {\ i0}
Dialogue: 0,0:18:46.31,0:18:47.60,Default,,0,0,0,,Tamam, şimdi!
Dialogue: 0,0:18:47.60,0:18:50.06,Default,,0,0,0,,{\ i1} Hızlı ve uzun bir pastı! {\ i0}
Dialogue: 0,0:18:50.06,0:18:52.81,Default,,0,0,0,,{\ i1} Anlık bir karşı saldırı! {\ i0}
Dialogue: 0,0:18:53.27,0:18:54.32,Default,,0,0,0,,{\ i1} Pas attılar! {\ i0}
Dialogue: 0,0:18:54.32,0:18:58.32,Default,,0,0,0,,{\i1}Toho saldırıyla o kadar meşguldü ki savunması deliklerle dolu!
Dialogue: 0,0:18:58.32,0:18:59.57,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:18:59.57,0:19:02.03,Default,,0,0,0,,{\ i1} Hiç kimse Sawaki'nin peşinde koşmuyor! {\ i0}
Dialogue: 0,0:19:03.24,0:19:04.37,Default,,0,0,0,,Bu kötü, Toho!
Dialogue: 0,0:19:05.34,0:19:07.04,Default,,0,0,0,,Sana izin vereceğimi mi düşündün?!
Dialogue: 0,0:19:07.04,0:19:09.29,Default,,0,0,0,,Voah, senden beklendiği gibi Wakashimazu.
Dialogue: 0,0:19:09.29,0:19:13.29,Default,,0,0,0,,Ceza alanının dışında, kaleci olarak bile başka bir saha oyuncususunuz!
Dialogue: 0,0:19:13.29,0:19:15.67,Default,,0,0,0,,Beraberlik oyunu yerine kazanmayı hedefleyeceğiz!
Dialogue: 0,0:19:15.67,0:19:16.88,Default,,0,0,0,,Wakashimazu.
Dialogue: 0,0:19:16.88,0:19:18.63,Default,,0,0,0,,Kahretsin, bizi küçümsüyor!
Dialogue: 0,0:19:18.63,0:19:19.67,Default,,0,0,0,,Ezin onu!
Dialogue: 0,0:19:19.67,0:19:23.23,Default,,0,0,0,,Topu Wakashimazu'dan çalarsak, bedava bir gol olacaktır!
Dialogue: 0,0:19:23.23,0:19:25.18,Default,,0,0,0,,Beklediğimiz şans bu!
Dialogue: 0,0:19:25.18,0:19:31.44,Default,,0,0,0,,Ancak sizleri ne kadar çok geçersem, önünüz o kadar fazla korunmaz!
Dialogue: 0,0:19:31.44,0:19:32.40,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:32.40,0:19:33.52,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:19:34.91,0:19:35.52,Default,,0,0,0,,Al hadi!
Dialogue: 0,0:19:35.52,0:19:37.24,Default,,0,0,0,,{\ i1} Top Sorimachi'ye ulaştı! {\ i0}
Dialogue: 0,0:19:37.24,0:19:38.28,Default,,0,0,0,,{\ i1} Şut çekecek mi? {\ i0}
Dialogue: 0,0:19:38.28,0:19:39.61,Default,,0,0,0,,Şut çekmesine izin vermeyin!
Dialogue: 0,0:19:40.24,0:19:42.49,Default,,0,0,0,,{\ i1}Ah, geriye pas gönderdi!
Dialogue: 0,0:19:42.49,0:19:43.28,Default,,0,0,0,,Ne?!
Dialogue: 0,0:19:43.28,0:19:47.24,Default,,0,0,0,,{\i1}Orada! Wakashimazu-kun topa doğru koşuyor!{\i0}
Dialogue: 0,0:19:47.24,0:19:48.37,Default,,0,0,0,,Wakashimazu-san!
Dialogue: 0,0:19:48.37,0:19:49.37,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:19:49.37,0:19:50.62,Default,,0,0,0,,Hepsi bu kadar Wakashimazu!
Dialogue: 0,0:19:52.06,0:19:54.29,Default,,0,0,0,,{\ i1} Kaleci Wakashimazu topa vuruyor! {\ i0}
Dialogue: 0,0:19:56.63,0:19:57.99,Default,,0,0,0,,{\i1}İçerde!{\i0}
Dialogue: 0,0:19:57.99,0:20:00.80,Default,,0,0,0,,{\ i1} Wakashimazu-kun'dan korkunç derecede güçlü bir atış!
Dialogue: 0,0:20:00.80,0:20:04.54,Default,,0,0,0,,{\ i1} Maç bitmeden hemen önce bir geri dönüş yaptı, 2-1!
Dialogue: 0,0:20:04.54,0:20:06.30,Default,,0,0,0,,Başardın, Wakashimazu!
Dialogue: 0,0:20:06.30,0:20:08.38,Default,,0,0,0,,Toho'dan ne harika bir saldırı!
Dialogue: 0,0:20:08.38,0:20:09.06,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:09.06,0:20:10.06,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:20:10.06,0:20:11.22,Default,,0,0,0,,Bunu unuttuk.
Dialogue: 0,0:20:11.22,0:20:13.60,Default,,0,0,0,,Wakashimazu aslında bir forvetti!
Dialogue: 0,0:20:13.60,0:20:16.63,Default,,0,0,0,,Fakat Meiwa FC, Hyuga'yı aldı, yani Koç Kira'nın talebi üzerine,
Dialogue: 0,0:20:16.63,0:20:18.82,Default,,0,0,0,,şampiyonayı kazanabilmemiz için,
Dialogue: 0,0:20:18.82,0:20:21.61,Default,,0,0,0,,onun yerine kaleci olmaya geçti.
Dialogue: 0,0:20:22.13,0:20:22.94,Default,,0,0,0,,Tch.
Dialogue: 0,0:20:22.94,0:20:24.61,Default,,0,0,0,,Bunu biliyorduk!
Dialogue: 0,0:20:24.61,0:20:30.62,Default,,0,0,0,,Savunması ve hücumuyla Wakashimazu, \Ngerçekten Japonya'nın 1 numaralı kalecisi.
Dialogue: 0,0:20:30.62,0:20:34.50,Default,,0,0,0,,{\ i1} Wakashimazu'dan 2 gol aldın, Jun.
Dialogue: 0,0:20:34.50,0:20:39.55,Default,,0,0,0,,{\i1}Gerçekten diğerleri gibi tam zamanlı olarak futbol oynamana yardım etmek istiyorum.{\i0}
Dialogue: 0,0:20:40.37,0:20:43.46,Default,,0,0,0,,{\ i1} Maçın sonunu işaret eden düdük çaldı! {\ i0}
Dialogue: 0,0:20:43.46,0:20:47.72,Default,,0,0,0,,{\ i1} Toho, finale kalan ilk takım oldu! {\ i0}
Dialogue: 0,0:20:47.72,0:20:49.88,Default,,0,0,0,,Başardık, Kaptan! Biz kazandık!
Dialogue: 0,0:20:49.88,0:20:50.72,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:20:50.72,0:20:51.69,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:20:51.69,0:20:52.82,Default,,0,0,0,,İyi iş!
Dialogue: 0,0:20:52.82,0:20:54.48,Default,,0,0,0,,Harika iş, millet!
Dialogue: 0,0:20:56.23,0:20:57.77,Default,,0,0,0,,Wakashimazu, harikaydın!
Dialogue: 0,0:20:57.77,0:20:58.34,Default,,0,0,0,,Evet!
Dialogue: 0,0:20:58.34,0:20:59.76,Default,,0,0,0,,Sen de, Takeshi.
Dialogue: 0,0:20:59.76,0:21:00.73,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:21:00.73,0:21:03.03,Default,,0,0,0,,Ve sen, Sorimachi, harika bir şuttu!
Dialogue: 0,0:21:03.03,0:21:04.49,Default,,0,0,0,,Kaybettik.
Dialogue: 0,0:21:04.49,0:21:08.99,Default,,0,0,0,,Toho'yu takımlarında Hyuga \Nolmadan yenebileceğimize emindik.
Dialogue: 0,0:21:08.99,0:21:11.98,Default,,0,0,0,,Hayır, aslında Hyuga'nın gücü çok büyüktü.
Dialogue: 0,0:21:13.04,0:21:18.42,Default,,0,0,0,,Yedek kulübesinde bile, Hyuga\N bugün Toho için büyük bir nimet.
Dialogue: 0,0:21:18.42,0:21:23.38,Default,,0,0,0,,Onları şevklendirmeseydi, bu işten kurtulabilirdik.
Dialogue: 0,0:21:23.38,0:21:26.38,Default,,0,0,0,,Toho'nun tamamı gerçekten Hyuga.
Dialogue: 0,0:21:26.81,0:21:28.65,Default,,0,0,0,,Katagiri-kun, karar verdim.
Dialogue: 0,0:21:28.65,0:21:31.97,Default,,0,0,0,,Bu turnuvada tek bir maç oynamamış olsa bile,
Dialogue: 0,0:21:31.97,0:21:37.92,Default,,0,0,0,,Avrupa’ya Kojiro Hyuga’yı Japonya’nın orta forveti olarak götüreceğim.
Dialogue: 0,0:21:39.32,0:21:40.19,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:21:40.19,0:21:40.90,Default,,0,0,0,,Hah?
Dialogue: 0,0:21:40.90,0:21:44.47,Default,,0,0,0,,Yarın finali kazan ve şampiyon ol!
Dialogue: 0,0:21:44.47,0:21:46.24,Default,,0,0,0,,Bizi yendin!
Dialogue: 0,0:21:46.24,0:21:48.80,Default,,0,0,0,,Sana güveniyoruz, Meiwa FC'den küçük alt sınıfımız!
Dialogue: 0,0:21:48.80,0:21:50.20,Default,,0,0,0,,Tamam!
Dialogue: 0,0:21:50.20,0:21:53.70,Default,,0,0,0,,Wakashimazu! Yarın onları sıfırda tutmak için elinden geleni yap.
Dialogue: 0,0:21:53.70,0:21:57.96,Default,,0,0,0,,Bunu yaparsan, sana karşı gol atabilecek tek kişi biz olacağız!
Dialogue: 0,0:21:58.47,0:22:00.34,Default,,0,0,0,,Evet, elimden geleni yapacağım!
Dialogue: 0,0:22:00.34,0:22:02.17,Default,,0,0,0,,Kazansan iyi olur!
Dialogue: 0,0:22:05.48,0:22:08.05,Default,,0,0,0,,Tamam, şimdi sıra bizde!
Dialogue: 0,0:22:09.55,0:22:11.81,Default,,0,0,0,,{\i1}Başladı Matsuyama-kun.{\i0}
Dialogue: 0,0:22:11.81,0:22:14.56,Default,,0,0,0,,{\i1}Tam da umduğum gibi, Tsubasa!{\i0}
