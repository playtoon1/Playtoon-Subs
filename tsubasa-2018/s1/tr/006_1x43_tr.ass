Dialogue: 0,0:23:48.94,0:23:58.53,Default,,0,0,0,,44.BÖLÜM: 10 NUMARA VS. 10 NUMARA
Dialogue: 0,0:01:12.21,0:01:14.92,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:15.84,0:01:18.51,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:19.43,0:01:22.14,OPED-TOP,,0,0,0,,Ai! Ai! Ai!
Dialogue: 0,0:01:29.02,0:01:31.86,OPED-TOP,,0,0,0,,moeru you ni hitori demo
Dialogue: 0,0:01:31.86,0:01:38.11,OPED-TOP,,0,0,0,,ikiteyukeru to usobuite hashiritsudzukete
Dialogue: 0,0:01:38.11,0:01:44.00,OPED-TOP,,0,0,0,,unubore no morosa wo kimi wa shitteta no ni
Dialogue: 0,0:01:44.00,0:01:50.59,OPED-TOP,,0,0,0,,kokoro made uchinomaresareta kono yoru ni
Dialogue: 0,0:01:50.59,0:01:54.59,OPED-TOP,,0,0,0,,kimi no koe sagasu
Dialogue: 0,0:01:54.59,0:01:59.09,OPED-TOP,,0,0,0,,kono yowasa ga nikui yo
Dialogue: 0,0:01:59.09,0:02:04.68,OPED-TOP,,0,0,0,,ima sugu torimodoshi ni ikanakya
Dialogue: 0,0:02:04.68,0:02:06.23,OPED-TOP,,0,0,0,,baka darou?
Dialogue: 0,0:02:06.23,0:02:07.44,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:07.44,0:02:10.94,OPED-TOP,,0,0,0,,kizudarake no ai wo shinjite
Dialogue: 0,0:02:10.94,0:02:20.82,OPED-TOP,,0,0,0,,nagareochita namida sae mo tsuyosa e to kaete
Dialogue: 0,0:02:20.82,0:02:21.66,OPED-TOP,,0,0,0,,ai
Dialogue: 0,0:02:21.66,0:02:25.45,OPED-TOP,,0,0,0,,kizudarake no ai da to shite mo
Dialogue: 0,0:02:25.45,0:02:29.46,OPED-TOP,,0,0,0,,bokura no sekai wo tomoshiteru
Dialogue: 0,0:02:29.46,0:02:35.71,OPED-TOP,,0,0,0,,kono ai mo ichido taritomo
Dialogue: 0,0:02:35.71,0:02:38.51,OPED-TOP,,0,0,0,,hanasanai
Dialogue: 0,0:01:12.21,0:01:14.92,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:15.84,0:01:18.51,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:19.43,0:01:22.14,OPED,,0,0,0,,Aşk! Aşk! Aşk!
Dialogue: 0,0:01:29.02,0:01:31.86,OPED,,0,0,0,,Kendime yalan söylemeye devam ediyorum.
Dialogue: 0,0:01:31.86,0:01:38.11,OPED,,0,0,0,,Yalnız yaşayabileceğimi söylüyorum, yanlızlık beni yaksa bile
Dialogue: 0,0:01:38.11,0:01:44.00,OPED,,0,0,0,,Kendime olan kibrimin ne kadar kırılgan olduğunu biliyordun.
Dialogue: 0,0:01:44.00,0:01:50.59,OPED,,0,0,0,,Bu gece kalbim bile paramparça oldu
Dialogue: 0,0:01:50.59,0:01:54.59,OPED,,0,0,0,,Aciz olmaktan nefret ediyorum.
Dialogue: 0,0:01:54.59,0:01:59.09,OPED,,0,0,0,,sesinin özlemi
Dialogue: 0,0:01:59.09,0:02:04.68,OPED,,0,0,0,,"Hemen geri dönmeliyim!"
Dialogue: 0,0:02:04.68,0:02:06.23,OPED,,0,0,0,,Aptalım, değil mi?
Dialogue: 0,0:02:06.23,0:02:07.44,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:07.44,0:02:10.94,OPED,,0,0,0,,Yaralı aşkıma inanmak...
Dialogue: 0,0:02:10.94,0:02:20.82,OPED,,0,0,0,,Bu gömülü gözyaşlarını güce dönüştüreceğim.
Dialogue: 0,0:02:20.82,0:02:21.66,OPED,,0,0,0,,Aşk!
Dialogue: 0,0:02:21.66,0:02:25.45,OPED,,0,0,0,,Yaralı bir aşk olmasına rağmen
Dialogue: 0,0:02:25.45,0:02:29.46,OPED,,0,0,0,,dünyamı aydınlatıyor.
Dialogue: 0,0:02:29.46,0:02:35.71,OPED,,0,0,0,,Bir an için bile
Dialogue: 0,0:02:35.71,0:02:38.51,OPED,,0,0,0,,bu aşkın gitmesine izin vermeyeceğim!
Dialogue: 0,0:00:05.00,0:00:05.97,Default,,0,0,0,,
Dialogue: 0,0:22:38.21,0:22:44.25,OPED-TOP,,0,0,0,,chotto are mi na ace ga tooru
Dialogue: 0,0:22:44.25,0:22:50.26,OPED-TOP,,0,0,0,,suguremono zo to machijû sawagu
Dialogue: 0,0:22:50.26,0:22:56.31,OPED-TOP,,0,0,0,,chô-chô samba, zigzag samba
Dialogue: 0,0:22:56.31,0:23:00.94,OPED-TOP,,0,0,0,,aitsu no uwasa de chamba mo hashiru
Dialogue: 0,0:23:02.56,0:23:07.24,OPED-TOP,,0,0,0,,sore ni tsukete mo ore-tacha nan na no
Dialogue: 0,0:23:08.57,0:23:14.66,OPED-TOP,,0,0,0,,ball hitotsu ni kiri-kiri mai sa
Dialogue: 0,0:23:14.66,0:23:20.71,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:20.71,0:23:25.17,OPED-TOP,,0,0,0,,itsuka kimeru ze inazuma shoot
Dialogue: 0,0:23:26.46,0:23:32.80,OPED-TOP,,0,0,0,,son toki ore ga super hero sa
Dialogue: 0,0:23:32.80,0:23:38.85,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:38.85,0:23:45.15,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.21,0:22:44.25,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.25,0:22:50.26,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.26,0:22:56.31,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.31,0:23:00.94,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:02.56,0:23:07.24,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:08.57,0:23:14.66,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:14.66,0:23:20.71,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:20.71,0:23:25.17,OPED,,0,0,0,,Bir gün, bir şimşek atışı yapacağım!
Dialogue: 0,0:23:26.46,0:23:32.80,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:32.80,0:23:38.85,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:38.85,0:23:45.15,OPED,,0,0,0,,Bu hırslı gençlik sahada!
