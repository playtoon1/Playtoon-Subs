Dialogue: 0,0:03:22.22,0:03:27.22,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}BÖLÜM 33: {\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs65\pos(120,818.333)}\NTURNUVASININ SONUCU
Dialogue: 0,0:03:22.52,0:03:25.18,Default-TOP,,0,0,0,,İlk yarı o kadar da kötü değildi. {can't hear, gomen ahahahaha I cant too! but he most probably says went great, quick french check? mystery solved i don't have the FR sub file and all my VPNs died on me tonight :(}
Dialogue: 0,0:03:25.18,0:03:27.93,Default-TOP,,0,0,0,,Misugi'nin gol atmasından endişelenmeyin.
Dialogue: 0,0:03:27.93,0:03:31.84,Default,,0,0,0,,İkinci yarı anti-Misugi taktiğini uygulayacağız, Sawada onu sürekli markajlayacak.
Dialogue: 0,0:03:31.84,0:03:32.69,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:32.69,0:03:37.19,Default,,0,0,0,,Bir saniye koç, izin ver Misugi'yi ben markajlayayım.
Dialogue: 0,0:03:37.19,0:03:42.24,Default,,0,0,0,,İkinci yarı ona ödeteceğim, topu ondan alıp alayının içinden geçicem. {I know burcu nee did it for better readability but actualy he saus he stole the ball with a tackle , I owe him that, context for edit-sama}{tackling him back and stealing the ball back from him just didn't make any sense ;_; thanks for saving me}
Dialogue: 0,0:03:42.24,0:03:44.20,Default,,0,0,0,,Sakinleş, Hyuga.
Dialogue: 0,0:03:44.20,0:03:47.18,Default,,0,0,0,,Futbol bir takım oyunu.
Dialogue: 0,0:03:47.18,0:03:49.87,Default,,0,0,0,,Sen sadece sana verilen görevi yapmalısın.
Dialogue: 0,0:03:49.87,0:03:56.13,Default,,0,0,0,,Forvetin merkezi olarak ilerde kalıp kontra atak olmasını bekleyeceksin.
Dialogue: 0,0:03:56.13,0:03:59.99,Default,,0,0,0,,Kafanda bir şeylere tıkanıp\N kalırsan iyi oynamayı bekleyemezsin.
Dialogue: 0,0:03:59.99,0:04:01.73,Default,,0,0,0,,Anladın mı, Hyuga?
Dialogue: 0,0:04:01.73,0:04:02.63,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:03.22,0:04:04.36,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:04:04.36,0:04:06.88,Default,,0,0,0,,{\i1}Haklı, Futbol takım rekabetidir...{\i0}
Dialogue: 0,0:04:06.88,0:04:11.19,Default,,0,0,0,,{\i1}Ama, bireysel oyunculukta önemli!{\i0}
Dialogue: 0,0:04:11.19,0:04:14.52,Default,,0,0,0,,{\i1}Nasıl bir maç bu böyle?{\i0}
Dialogue: 0,0:04:14.52,0:04:21.35,Default,,0,0,0,,Hyuga, bizim amacımız Nankasu'nun Geleneksel turnuvada 3. kez şampiyon olmasını engellemek.
Dialogue: 0,0:04:21.35,0:04:24.80,Default,,0,0,0,,Bunu başarmak için bu maçı kazanmalıyız. {lit., can't lose}
Dialogue: 0,0:04:24.80,0:04:25.66,Default,,0,0,0,,Lütfen...
Dialogue: 0,0:04:27.18,0:04:28.79,Default,,0,0,0,,Bunu gayet iyi biliyorum, Takeshi.
Dialogue: 0,0:04:28.79,0:04:29.79,Default,,0,0,0,,Hyuga...
Dialogue: 0,0:04:32.82,0:04:35.59,Default,,0,0,0,,İlk yarı 3 gol yedik ama şimdi biz baskınız.
Dialogue: 0,0:04:35.59,0:04:37.49,Default,,0,0,0,,İkinci yarı da böyle devam edin!
Dialogue: 0,0:04:37.49,0:04:38.13,Default,,0,0,0,,Evet!
Dialogue: 0,0:04:38.13,0:04:42.61,Default,,0,0,0,,Ve Misugi sen sadece 20. dakikaya kadar oynayacaksın.
Dialogue: 0,0:04:42.61,0:04:44.12,Default,,0,0,0,,Biliyorum.
Dialogue: 0,0:04:44.12,0:04:46.52,Default,,0,0,0,,Ondan sonrasını biz hallederiz, Misugi!
Dialogue: 0,0:04:46.52,0:04:48.59,Default,,0,0,0,,Hadi kazanıp gelneksel turnuvaya gidelim!
Dialogue: 0,0:04:48.59,0:04:49.36,Default,,0,0,0,,Evet!
Dialogue: 0,0:04:49.36,0:04:50.14,Default,,0,0,0,,Gençler!
Dialogue: 0,0:04:52.46,0:04:54.31,Default,,0,0,0,,{\i1}20 dakika daha...{\i0}
Dialogue: 0,0:04:55.12,0:04:57.31,Default,,0,0,0,,{\i1}İki takımın oyuncuları da sahaya çıktı.{\i0}
Dialogue: 0,0:04:58.02,0:05:01.82,Default,,0,0,0,,{\i1}İlk yarıyı Toho Akademi 3-1 önde bitirdi,{\i0}
Dialogue: 0,0:05:01.82,0:05:05.07,Default,,0,0,0,,{\i1}ama Misugi sayesinde maçın yönü değişmiş durumda.{\i0}
Dialogue: 0,0:05:05.07,0:05:08.07,Default,,0,0,0,,{\i1}Toho skoru koruyabilecek mi?{\i0}
Dialogue: 0,0:05:08.82,0:05:11.95,Default,,0,0,0,,{\i1}Maçın sonunu tahmin bile edemiyoruz!{\i0}
Dialogue: 0,0:05:11.95,0:05:15.08,Default,,0,0,0,,{\i1}İkinci yarı Musashi Ortaokulu'nun santra vuruşuyla başlayacak!{\i0}
Dialogue: 0,0:05:18.71,0:05:20.43,Default,,0,0,0,,{\i1}Top Misugi'de!{\i0}
Dialogue: 0,0:05:20.43,0:05:23.59,Default,,0,0,0,,{\i1}Misugi ilk yarıdan beri pozisyonları tek başına hazılıyor.{\i0}
Dialogue: 0,0:05:23.59,0:05:27.30,Default,,0,0,0,,{\i1}Sawada topu Misugi'den almak için hemen harekete geçiyor.{\i0}
Dialogue: 0,0:05:27.30,0:05:33.06,Default,,0,0,0,,{\i1}Misugi'nin rahat hareket etmesine izin veremeyiz.{\i0} {i can't get what this dude's saying. really}
Dialogue: 0,0:05:33.06,0:05:33.56,Default,,0,0,0,,Suzuki!
Dialogue: 0,0:05:33.56,0:05:36.08,Default,,0,0,0,,{\i1}Misugi top çeviriyor.{\i0}
Dialogue: 0,0:05:36.08,0:05:37.81,Default,,0,0,0,,{\i1}Her şey yolunda gidiyor.{\i0}
Dialogue: 0,0:05:42.90,0:05:45.13,Default,,0,0,0,,{\i1}Musashi kendi sahasında top çeviriyor.{\i0}
Dialogue: 0,0:05:45.13,0:05:47.66,Default,,0,0,0,,{\i1}Kaşı takımın sahasına doğru adım bile atmadılar.{\i0}
Dialogue: 0,0:05:47.66,0:05:50.28,Default,,0,0,0,,{\i1}Gelin, burayı koruyacağım sonra kontra atak yapacağım.{\i0}
Dialogue: 0,0:05:50.28,0:05:52.83,Default,,0,0,0,,{\i1}Benden çaldığınız topu size gol olarak yedireceğim.{\i0}
Dialogue: 0,0:05:52.83,0:05:54.33,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:05:54.33,0:05:56.16,Default,,0,0,0,,{\i1}Top tekrar Misugi'de.{\i0}
Dialogue: 0,0:05:56.95,0:05:59.54,Default,,0,0,0,,{\i1}Ama Sawada hemen ardından onu takip ediyor.{\i0}
Dialogue: 0,0:05:59.54,0:06:01.63,Default,,0,0,0,,{\i1}Görünüşe göre top sürdürtmyecekler.{\i0}
Dialogue: 0,0:06:01.63,0:06:02.52,Default,,0,0,0,,{\i1}Eğer öylese...{\i0}
Dialogue: 0,0:06:02.52,0:06:04.34,Default,,0,0,0,,{\i1}Misugi'den uzun bir pas.{\i0}
Dialogue: 0,0:06:04.34,0:06:05.41,Default,,0,0,0,,Tamam.
Dialogue: 0,0:06:05.41,0:06:08.13,Default,,0,0,0,,{\i1}Musashi gol atabilecek mi?{\i0}
Dialogue: 0,0:06:08.13,0:06:09.64,Default,,0,0,0,,Çok safsınız!
Dialogue: 0,0:06:10.94,0:06:14.72,Default,,0,0,0,,{\i1}Ama kaleci Wakashimazu zıplayıp topu yakalıyor.{\i0} {firmly? more like fabulously! CAME IN LIKE A ROCK STAR}
Dialogue: 0,0:06:15.32,0:06:17.73,Default,,0,0,0,,{\i1}Toho beklediğim gibi iyi.{\i0}
Dialogue: 0,0:06:20.15,0:06:21.36,Default,,0,0,0,,Hadi!
Dialogue: 0,0:06:22.30,0:06:24.78,Default,,0,0,0,,{\i1}Toho'nun as oyuncusu Hyuga ileri doğru koşuyor.{\i0}
Dialogue: 0,0:06:24.78,0:06:26.49,Default,,0,0,0,,{\i1}Sıra onların kontra atağında!{\i0}
Dialogue: 0,0:06:27.32,0:06:28.03,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:06:29.03,0:06:29.74,Default,,0,0,0,,Bende!
Dialogue: 0,0:06:34.36,0:06:37.18,Default,,0,0,0,,{\i1}Ofsayt!{\i0} {hyuga was AMAI}
Dialogue: 0,0:06:37.18,0:06:38.28,Default,,0,0,0,,Ne...?
Dialogue: 0,0:06:38.28,0:06:41.75,Default,,0,0,0,,{\i1}Musashi ve Misugi'nin en sevdiği şey, ofsayt taktiği!{\i0}
Dialogue: 0,0:06:41.75,0:06:42.79,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:06:42.79,0:06:44.40,Default,,0,0,0,,{\i1}Oyun çok çekişmeli şekilde devam ediyor!{\i0} {isshin ittai, one mind one body}{i thought that was 一進一退, since they talk about 攻防 later, i thought they were related wait, thats better, I thougth of team acting like a unit, yup , you trusted me and I failed you :( }{no failure there, i thought of 一心 at first, then it just didn't make sense and I checked could you revert? <3 }{sure!}
Dialogue: 0,0:06:44.40,0:06:46.46,Default,,0,0,0,,{\i1}Forvetler de defanslarda çok hırslı!{\i0}
Dialogue: 0,0:06:46.92,0:06:50.43,Default,,0,0,0,,{\i1}Misugi Sawada'nın boşluğundan yararlanıyor{\i0}
Dialogue: 0,0:06:50.43,0:06:52.97,Default,,0,0,0,,{\i1}ve Musashi için bir gol şansı...{\i0}
Dialogue: 0,0:06:54.86,0:06:58.22,Default,,0,0,0,,{\i1}Ama yine Wakashimazu yine Wakashimazu!{\i0}
Dialogue: 0,0:06:58.22,0:07:00.14,Default,,0,0,0,,Güzel kurtarış Wakashimazu!
Dialogue: 0,0:07:02.46,0:07:06.48,Default,,0,0,0,,{\i1}Ofsayt tuzakları sayesinde, Musashi Toho'ya gol atma şansı vermedi.{\i0}
Dialogue: 0,0:07:07.13,0:07:08.11,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:09.24,0:07:13.53,Default,,0,0,0,,{\i1}İki takımda pozisyonlarını golle süsleyemediler, geçen her saniye çok önemli şu an.{\i0}
Dialogue: 0,0:07:15.05,0:07:17.56,Default,,0,0,0,,Bu kadar atak yapmamıza rağmen gol atamıyoruz!
Dialogue: 0,0:07:17.56,0:07:20.21,Default,,0,0,0,,Misugi'yi oyundan çıkarmanın vakti gelmek üzere.
Dialogue: 0,0:07:20.21,0:07:22.21,Default,,0,0,0,,Vakit gelmek üzere.
Dialogue: 0,0:07:22.21,0:07:25.21,Default,,0,0,0,,Onu bu kadar zorlayamayız.
Dialogue: 0,0:07:30.55,0:07:34.23,Default,,0,0,0,,{\i1}Bir gol daha atıp farkı bire düşürmeliyim!{\i0}
Dialogue: 0,0:07:35.70,0:07:37.68,Default,,0,0,0,,{\i1}Wakashimazu ünlü bir kaleci.{\i0}
Dialogue: 0,0:07:37.68,0:07:42.19,Default,,0,0,0,,{\i1}İlk goldeki gibi iyi bir pozisyon \Noluşturamazsam gol atamam.{\i0}
Dialogue: 0,0:07:42.67,0:07:43.27,Default,,0,0,0,,Honma!
Dialogue: 0,0:07:43.27,0:07:45.16,Default,,0,0,0,,{\i1}Misugi'den kısa bir pas.{\i0}
Dialogue: 0,0:07:45.16,0:07:47.07,Default,,0,0,0,,{\i1}1'e 2 taktiğiyle mi ilerleyecekler?{\i0}
Dialogue: 0,0:07:47.07,0:07:48.82,Default,,0,0,0,,İşe yaramaz, Misugi!
Dialogue: 0,0:07:50.82,0:07:51.40,Default,,0,0,0,,Al bunu!
Dialogue: 0,0:07:52.87,0:07:53.70,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:53.70,0:07:56.23,Default,,0,0,0,,{\i1}Wakashimazu tuzağa düştü!{\i0}
Dialogue: 0,0:07:56.23,0:07:58.70,Default,,0,0,0,,{\i1}Top Sanada'ya gidiyor!{\i0}
Dialogue: 0,0:07:58.70,0:08:00.04,Default,,0,0,0,,Bende!
Dialogue: 0,0:08:00.04,0:08:02.16,Default,,0,0,0,,{\i1}Kesin bir gol şansı!{\i0}
Dialogue: 0,0:08:02.16,0:08:04.42,Default,,0,0,0,,Sanki sana izin vericeğim! {UPPERCUT!}
Dialogue: 0,0:08:05.42,0:08:07.50,Default,,0,0,0,,{\i1}Ama bu da işe yaramadı!{\i0}
