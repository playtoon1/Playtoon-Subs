Dialogue: 0,0:17:58.76,0:18:01.10,Default,,0,0,0,,{\i1}Süre çok az kaldı.{\i0}
Dialogue: 0,0:18:01.10,0:18:03.44,Default,,0,0,0,,{\i1}Musashi yapabileceği her şeyi yaptı.{\i0}
Dialogue: 0,0:18:03.44,0:18:04.52,Default,,0,0,0,,{\i1}Beyler...{\i0}
Dialogue: 0,0:18:06.64,0:18:07.97,Default,,0,0,0,,Pes etmeyeceğiz!
Dialogue: 0,0:18:07.97,0:18:08.94,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:18:10.52,0:18:11.52,Default,,0,0,0,,Hyuga!
Dialogue: 0,0:18:17.03,0:18:19.11,Default,,0,0,0,,{\i1}Ve maçın bitiş düdüğü çalıyor!{\i0}
Dialogue: 0,0:18:19.11,0:18:19.79,Default,,0,0,0,,Başardık!
Dialogue: 0,0:18:19.79,0:18:24.20,Default,,0,0,0,,{\i1}Toho Akademi Geleneksel turnuvaya 3.kez katılacak!{\i0}
Dialogue: 0,0:18:28.25,0:18:29.17,Default,,0,0,0,,Güzel.
Dialogue: 0,0:18:31.52,0:18:33.71,Default,,0,0,0,,Çok yaklaşmıştık, Misugi.
Dialogue: 0,0:18:33.71,0:18:34.59,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:35.76,0:18:40.33,Default,,0,0,0,,{\i1}Tsubasa'ya karşı 3 yıldır oynayamıyorum.{\i0}
Dialogue: 0,0:18:43.00,0:18:45.52,Default,,0,0,0,,Tokyo turnuvası sonra erdi.
Dialogue: 0,0:18:45.52,0:18:48.98,Default,,0,0,0,,Toho maçı 3-2 kazandı.
Dialogue: 0,0:18:48.98,0:18:50.61,Default,,0,0,0,,Bir gol farkla he?
Dialogue: 0,0:18:50.64,0:18:51.66,Default,,0,0,0,,Ucu ucuna almış.
Dialogue: 0,0:18:51.75,0:18:52.94,Default,,0,0,0,,3-2.
Dialogue: 0,0:18:53.76,0:18:57.36,Default,,0,0,0,,{\i1}Görünüşe göre bu sene de karşımıza Toho and Kojiro Hyuga gelicek.{\i0}
Dialogue: 0,0:19:01.08,0:19:03.95,Default,,0,0,0,,Koç Kitazume, zaferinizi kutluyoruz. {yeah weay to kill your own players' spirit}
Dialogue: 0,0:19:03.95,0:19:07.40,Default,,0,0,0,,Şimdiki hedefiniz nedir?
Dialogue: 0,0:19:07.40,0:19:09.29,Default,,0,0,0,,Geleneksel turnuva şampiyonu olmak tabiki de.
Dialogue: 0,0:19:09.29,0:19:13.67,Default,,0,0,0,,Şu anki gücümüzle eminim ki Nankatsu'yu yeneceğiz.
Dialogue: 0,0:19:13.67,0:19:17.91,Default,,0,0,0,,Sawada'nın takıma katılması gerçekten etkili oldu.
Dialogue: 0,0:19:19.23,0:19:21.20,Default,,0,0,0,,Koç Kira. {killer kantoku wants killer back}
Dialogue: 0,0:19:21.20,0:19:26.01,Default,,0,0,0,,Görüşmeyeli oldukça yumuşamışsın Kojiro. {TL note: why is Misugi still alive?}
Dialogue: 0,0:19:27.60,0:19:28.85,Default,,0,0,0,,Şampiyonluk bayrağı he?
Dialogue: 0,0:19:29.62,0:19:32.67,Default,,0,0,0,,Böyle şeylerin seni mutlu etmeye yettiğine inanamıyorum. {back then he sought blood}
Dialogue: 0,0:19:34.11,0:19:38.36,Default,,0,0,0,,Sen kafeslenmiş amacından sapmış bir kaplansın! {bang bang!}
Dialogue: 0,0:19:41.42,0:19:43.74,Default,,0,0,0,,Amacından sapmış bir kaplan mı?
Dialogue: 0,0:19:43.74,0:19:45.58,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:19:45.58,0:19:47.58,Default,,0,0,0,,Anlıyor musun Kojiro?
Dialogue: 0,0:19:47.58,0:19:50.71,Default,,0,0,0,,Toho'ya geldiğinden beri çok yumuşadın.
Dialogue: 0,0:19:51.52,0:19:55.79,Default,,0,0,0,,Sahada olmana rağmen, Misugi için üzülüyorsun.
Dialogue: 0,0:19:55.79,0:20:00.19,Default,,0,0,0,,Kaybettiğin toptan dolayı karşı takım kontra atak yaptı.
Dialogue: 0,0:20:00.19,0:20:03.37,Default,,0,0,0,,Ve hepsinden kötüsü defansa gitmedin bile. {finish him!}
Dialogue: 0,0:20:03.37,0:20:05.37,Default,,0,0,0,,{sudden realization}
Dialogue: 0,0:20:05.85,0:20:09.75,Default,,0,0,0,,{\t(3400,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Wakashimazu'nun harika oynayışı sayesinde kazandınız.
Dialogue: 0,0:20:09.77,0:20:14.00,Default,,0,0,0,,Eğer berabere kalsaydınız bu senin suçun olurdu.
Dialogue: 0,0:20:15.27,0:20:19.40,Default,,0,0,0,,Sana böyle bir futbol öğrettiğimi hatırlamıyorum Kojiro!
Dialogue: 0,0:20:19.40,0:20:22.79,Default,,0,0,0,,Merhametini kenera atıp sahaya çık!
Dialogue: 0,0:20:22.79,0:20:25.22,Default,,0,0,0,,Sahip olman tek gereken şey acımasızlık!
Dialogue: 0,0:20:25.22,0:20:31.04,Default,,0,0,0,,Gol atmak için Misugi'nin kalbini parçalaman gerekse bile yapmalısın.
Dialogue: 0,0:20:31.04,0:20:34.04,Default,,0,0,0,,{A case for mouri kogoro}
Dialogue: 0,0:20:34.04,0:20:40.68,Default,,0,0,0,,Toho Akademesi'ne katıldığından beri futbol dışında başka hiçbir şeye odaklanmak gerekmiyordu.
Dialogue: 0,0:20:40.68,0:20:44.70,Default,,0,0,0,,Ama görüyorumki hırstan alev alev yanan {That actually stole that hungry personality from you instead,}
Dialogue: 0,0:20:44.70,0:20:48.39,Default,,0,0,0,,ruhundan geriye hiçbir şey kalmamış. {and put out that burning fighting spirit inside you as a result.}
Dialogue: 0,0:20:48.80,0:20:51.22,Default,,0,0,0,,Önceden böyle değildin...
Dialogue: 0,0:20:51.22,0:20:55.65,Default,,0,0,0,,Tüm engellere rağmen güçlü \Nolmak için her şeyi kenara ittin.
Dialogue: 0,0:20:57.61,0:20:59.03,Default,,0,0,0,,{\i1}Zamanı geldi.{\i0}
Dialogue: 0,0:20:59.03,0:21:02.29,Default,,0,0,0,,Ben burada olmasam bile antremanlarını düzgün yapın.
Dialogue: 0,0:21:02.29,0:21:04.03,Default,,0,0,0,,Tamam kaptan.
