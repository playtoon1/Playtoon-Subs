Dialogue: 0,0:16:48.27,0:16:49.60,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:16:49.60,0:16:50.59,Default,,0,0,0,,Ben iyiyim. {DIEjoubu}
Dialogue: 0,0:16:50.59,0:16:51.32,Default,,0,0,0,,Misugi.
Dialogue: 0,0:16:51.74,0:16:52.90,Default,,0,0,0,,Gol attınız mı?
Dialogue: 0,0:16:54.19,0:16:55.91,Default,,0,0,0,,Üzgünüz.
Dialogue: 0,0:16:56.86,0:16:58.41,Default,,0,0,0,,Öyle mi? {trashes!}
Dialogue: 0,0:16:58.41,0:16:59.94,Default,,0,0,0,,Daha fazla oynamasına izin veremeyiz!
Dialogue: 0,0:16:59.94,0:17:01.68,Default,,0,0,0,,Nishiyama hazırlan hemen!
Dialogue: 0,0:17:01.68,0:17:02.25,Default,,0,0,0,,Tamam koç!
Dialogue: 0,0:17:02.83,0:17:05.75,Default,,0,0,0,,{\i1}Misugi sonunda oyundan çıkıyor.{\i0}
Dialogue: 0,0:17:05.75,0:17:09.75,Default,,0,0,0,,{\i1}Takım arkadaşının yardımıyla sahadan çıkıyor.{\i0}
Dialogue: 0,0:17:10.26,0:17:11.63,Default,,0,0,0,,Kaptan.
Dialogue: 0,0:17:14.22,0:17:15.83,Default,,0,0,0,,Jun-sama!
Dialogue: 0,0:17:15.83,0:17:16.72,Default,,0,0,0,,Misugi!
Dialogue: 0,0:17:19.05,0:17:20.78,Default,,0,0,0,,Yapabildiğinizin en iyisini yapın beyler!
Dialogue: 0,0:17:20.78,0:17:23.14,Default,,0,0,0,,Geriye sadece birkaç dakika kaldı.
Dialogue: 0,0:17:23.75,0:17:25.74,Default,,0,0,0,,Pes etmeyin, sonuna kadar savaşın!
Dialogue: 0,0:17:25.74,0:17:26.65,Default,,0,0,0,,Kesinlikle!
Dialogue: 0,0:17:29.63,0:17:35.75,Default,,0,0,0,,{\i1}Misugi, sahanın asil genci, sessizce sahayı terk ediyor.{\i0}
Dialogue: 0,0:17:35.75,0:17:38.53,Default,,0,0,0,,{\i1}Gerçekten şu ana kadar çok iyi bir oyun çıkardı.{\i0}
Dialogue: 0,0:17:38.53,0:17:40.11,Default,,0,0,0,,{\i1}İşte Jun Misugi gidiyor!{\i0}
