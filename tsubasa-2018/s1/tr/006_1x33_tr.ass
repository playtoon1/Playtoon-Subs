Comment: 0,0:11:44.01,0:11:44.01,Default,,0,0,0,,BÖLÜM B
Dialogue: 0,0:00:02.20,0:00:04.69,Default,,0,0,0,,Gol yediğimde geri gol atmak benim oyun oynama stilimdir!
Dialogue: 0,0:00:04.69,0:00:11.19,Default,,0,0,0,,{\i1}Tokyo Bölge Turnuvasının final maçı, \NToho Akademi ve Musashi ortaokulu,  kafa kafaya mücadele ediyorlar.{\i0}
Dialogue: 0,0:00:11.69,0:00:16.00,Default,,0,0,0,,{\i1}Kojiro'dan 3 gol yedikten hemen sonra{\i0}
Dialogue: 0,0:00:16.00,0:00:20.25,Default,,0,0,0,,{\i1}Musashi Misugi'yi planlanandan önce oyuna soktu.{\i0}
Dialogue: 0,0:00:20.25,0:00:24.92,Default,,0,0,0,,Futbol tek başına oynanan bir oyun değil, bir takım oyunudur Hyuga.
Dialogue: 0,0:00:25.63,0:00:29.80,Default,,0,0,0,,{\i1}Oyuna girer girmez topu Toho Akademiden aldı{\i0}
Dialogue: 0,0:00:29.80,0:00:32.30,Default,,0,0,0,,{\i1}ve muhteşem bir oyunculuk sergiliyor.{\i0}
Dialogue: 0,0:00:32.30,0:00:34.63,Default,,0,0,0,,Fark şimdi bire düşüyor!
Dialogue: 0,0:00:35.68,0:00:38.43,Default,,0,0,0,,Bir gol daha atmana izin vermeyeceğim!
Dialogue: 0,0:00:38.43,0:00:42.90,Default,,0,0,0,,{\i1}Misugi'yi durduran Wakashimazu oldu.{\i0}
Dialogue: 0,0:00:42.90,0:00:46.28,Default,,0,0,0,,{\i1}İnanılmaz bir kurtarışla golü engelledi.{\i0}
Dialogue: 0,0:00:46.28,0:00:48.11,Default,,0,0,0,,{\i1}Sen nesin be Wakashimazı.{\i0}
Dialogue: 0,0:00:48.11,0:00:51.20,Default,,0,0,0,,{\i1}Hızlısın, reflekslerin sağlam bir de zıplama yeteneğin...{\i0}
Dialogue: 0,0:00:51.20,0:00:53.61,Default,,0,0,0,,{\i1}Uzaktan gol atmam imkansız.{\i0}
Dialogue: 0,0:00:54.64,0:00:56.36,Default,,0,0,0,,{\i1}İlk yarı bitti.{\i0}
Dialogue: 0,0:00:57.56,0:01:00.90,Default,,0,0,0,,Çok yaklaşmıştı. Az kala gol atıyordu.
Dialogue: 0,0:01:00.90,0:01:05.87,Default,,0,0,0,,Misugi muhteşem değil mi? Girdiği gibi oyunun atmosferi değişti.
Dialogue: 0,0:01:05.87,0:01:11.25,Default,,0,0,0,,Ayrıca havalı da. Ona sahanın asil genci demekte haklılar.
Dialogue: 0,0:01:13.72,0:01:17.59,Default,,0,0,0,,Tabiki de Tsubasa ondan çok daha havalı. {you are in the wrong neigborhood for misugi fangirling}
Dialogue: 0,0:01:17.59,0:01:19.74,Default,,0,0,0,,Hiç şühpesiz öyle.
Dialogue: 0,0:01:19.74,0:01:23.35,Default,,0,0,0,,O çok havalı ama Misugi de öyle...
Dialogue: 0,0:01:23.35,0:01:27.99,Default,,0,0,0,,Kumi, bu maçı neden izlediğimizi bile bilmiyorsun değil mi? {yeah, like you are watching it to see all those tactics and stuff and not cute boys}
Dialogue: 0,0:01:27.99,0:01:29.48,Default,,0,0,0,,Tabiki de biliyorum!
Dialogue: 0,0:01:29.48,0:01:34.22,Default,,0,0,0,,Rakibimizin kim olacağını öğrenebilmek ve maçları kaydedip oynayış stillerini görmek için.
Dialogue: 0,0:01:34.22,0:01:35.36,Default,,0,0,0,,Biliyorsan sıkıntı yok.
Dialogue: 0,0:01:35.36,0:01:38.14,Default,,0,0,0,,Gidip bizimkilere söylemeliyim!
Dialogue: 0,0:01:43.03,0:01:46.09,Default,,0,0,0,,Ne? Demek Misugi oyuna ilk yarıda girdi ha!
Dialogue: 0,0:01:46.09,0:01:46.77,Default,,0,0,0,,Evet.
Dialogue: 0,0:01:46.77,0:01:47.58,Default,,0,0,0,,Vov...
Dialogue: 0,0:01:47.58,0:01:50.28,Default,,0,0,0,,O zaman kim bilir ikinci yarı nasıl olur...
Dialogue: 0,0:01:52.00,0:03:21.97,Default,,0,0,0,,{OP}
