Dialogue: 0,0:23:33.39,0:23:39.43,OPED-TOP,,0,0,0,,Dash, dash, dash! Kick and dash!
Dialogue: 0,0:23:39.43,0:23:45.73,OPED-TOP,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.79,0:22:44.84,OPED,,0,0,0,,Hey, oradan geçen oyuncuya bak.
Dialogue: 0,0:22:44.84,0:22:50.84,OPED,,0,0,0,,O en iyisi ve bütün şehir onunla gurur duyuyor.
Dialogue: 0,0:22:50.84,0:22:56.89,OPED,,0,0,0,,Klebek samba zig-zag samba
Dialogue: 0,0:22:56.89,0:23:01.52,OPED,,0,0,0,,Küçük yaşlı bayanlar bile onun hakkında konuşuyorlar.
Dialogue: 0,0:23:03.15,0:23:07.82,OPED,,0,0,0,,Yani, ona sahip olsak bile, kimiz biz?
Dialogue: 0,0:23:09.15,0:23:15.24,OPED,,0,0,0,,Top etrafında dönüyor.
Dialogue: 0,0:23:15.24,0:23:21.29,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:21.29,0:23:25.75,OPED,,0,0,0,,Bir gün, bir şimşek vuruşunu yapacağım!
Dialogue: 0,0:23:27.05,0:23:33.39,OPED,,0,0,0,,Onu yaptığımda, süper kahraman olacağım!
Dialogue: 0,0:23:33.39,0:23:39.43,OPED,,0,0,0,,Koş, Koş, Koş! Vur ve koş!
Dialogue: 0,0:23:39.43,0:23:45.73,OPED,,0,0,0,,Bu hırslı gençlik sahada!
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
