Dialogue: 0,0:11:00.00,0:11:05.02,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:01.50,0:00:05.27,Default,,0,0,0,,{\i1}Nankatsu FC ile Meiwa FC\Narasındaki ilk maç...{\i0}
Dialogue: 0,0:00:05.61,0:00:08.15,Default,,0,0,0,,{\i1}...iki takımın as oyuncularının\Nkarşı karşıya gelmesiyle başlamıştı.{\i0}
Dialogue: 0,0:00:09.36,0:00:14.53,Default,,0,0,0,,{\i1}Tsubasa, mükemmel bir topuk kaldırmasıyla\NKojiro'yu geçip maçın ilk golünü atabilmişti.{\i0}
Dialogue: 0,0:00:15.08,0:00:19.83,Default,,0,0,0,,{\i1}Altta kalmamak için Kojiro da uzun mesafeden\Nbir şut çekip kaleciyi savurarak gol atmıştı.{\i0}
Dialogue: 0,0:00:21.20,0:00:26.33,Default,,0,0,0,,{\i1}Ne kadar güçlü olduğunu ilk elden\Ngören Morisaki korkudan donakalmıştı.{\i0}
Dialogue: 0,0:00:26.33,0:00:27.79,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:00:27.79,0:00:28.71,Default,,0,0,0,,Morisaki, tut!
Dialogue: 0,0:00:28.71,0:00:30.50,Default,,0,0,0,,Tutabilirsin!
Dialogue: 0,0:00:31.44,0:00:33.30,Default,,0,0,0,,Güzel kurtardın Tsubasa!
Dialogue: 0,0:00:34.50,0:00:38.01,Default,,0,0,0,,Morisaki-kun.\NTop senin arkadaşındır! Korkma!
Dialogue: 0,0:00:38.01,0:00:39.10,Default,,0,0,0,,Ne?
Dialogue: 0,0:00:39.10,0:00:41.59,Default,,0,0,0,,Top arkadaşındır saçmalığı da ne?!
Dialogue: 0,0:00:41.59,0:00:44.85,Default,,0,0,0,,Öyleyse bunu da al bakalım!{have your friend, on da face, with a chair}
Dialogue: 0,0:00:45.06,0:00:45.56,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:00:45.56,0:00:46.81,Default,,0,0,0,,- Dikkat et!\N- Tsubasa-kun!
Dialogue: 0,0:00:46.99,0:00:49.44,Default,,0,0,0,,{\i1}{\i1}Tam yüzüne geldi!{\i0}{\i0}
Dialogue: 0,0:00:50.73,0:00:51.65,Default,,0,0,0,,Ne?!
Dialogue: 0,0:00:51.65,0:00:53.69,Default,,0,0,0,,T-Tsubas!
Dialogue: 0,0:00:55.98,0:00:58.36,Default,,0,0,0,,Gördün mü? Hiçbir şey yok.
Dialogue: 0,0:01:00.20,0:01:01.20,Default,,0,0,0,,Anladım.
Dialogue: 0,0:01:01.20,0:01:03.51,Default,,0,0,0,,Artık korkmayacağım.
Dialogue: 0,0:01:03.51,0:01:04.80,Default,,0,0,0,,Deneyeceğim.
Dialogue: 0,0:01:05.50,0:01:07.37,Default,,0,0,0,,{\i1}Al bakalım! Bir daha!{\i0}
Dialogue: 0,0:01:08.36,0:01:10.75,Default,,0,0,0,,Morisaki, güzel tuttun!
Dialogue: 0,0:01:11.37,0:01:14.17,Default,,0,0,0,,Futbol topu benim için\Nönemli bir arkadaş.
Dialogue: 0,0:01:14.17,0:01:15.80,Default,,0,0,0,,Asla onu bırakmam!
Dialogue: 0,0:01:15.80,0:01:17.89,Default,,0,0,0,,Lanet olası yer elması!
Dialogue: 0,0:01:17.89,0:01:20.72,Default,,0,0,0,,Kaleciyi yine kendine getirdi.
Dialogue: 0,0:01:21.55,0:01:23.13,Default,,0,0,0,,{\i1}Karşı atak vakti Tsubasa!{\i0}
Dialogue: 0,0:01:23.13,0:01:24.56,Default,,0,0,0,,{\i1}Arkadaşımıza güvenelim!{\i0}
Dialogue: 0,0:01:25.10,0:01:28.41,Default,,0,0,0,,{\i1}Tamamdır! Şimdi bizim atak zamanımız!{\i0}
Dialogue: 0,0:03:00.45,0:03:04.70,Default,,0,0,0,,{\fad(500,500)\pos(448,817)}15. Bölüm:\NKaybetmeyeceğim\NÇünkü Bu Benim Hayalim
Dialogue: 0,0:03:00.45,0:03:04.70,Default,,0,0,0,,{\fad(500,500)\pos(1532,1025)}Çeviri: ARE-YOU-SURE\N{\fs65)}AreyousureSubs Sunar
Dialogue: 0,0:03:00.94,0:03:02.95,Default-Top,,0,0,0,,{\i1}Genç Ulusal Futbol Turnuvası'nda...{\i0}
Dialogue: 0,0:03:02.95,0:03:05.07,Default-Top,,0,0,0,,{\i1}...1. grubun ilk grup\Naşaması maçı.{\i0}
Dialogue: 0,0:03:05.07,0:03:10.54,Default,,0,0,0,,{\i1}Nankatsu ve Meiwa arasındaki maçın\Nilk yarısı bitmek üzere ve Meiwa 2-1 önde.{\i0}
Dialogue: 0,0:03:10.54,0:03:13.50,Default,,0,0,0,,{\i1}Tsubasa-kun atak için\Nileri çıkıyor.{\i0}
Dialogue: 0,0:03:13.50,0:03:15.23,Default,,0,0,0,,Gidelim Misaki-kun!
Dialogue: 0,0:03:15.23,0:03:16.29,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:16.29,0:03:20.13,Default,,0,0,0,,Kojiro'ya topun arkadaşımız\Nolduğunu öğretelim!
Dialogue: 0,0:03:20.13,0:03:21.97,Default,,0,0,0,,Ne arkadaşıymış be?!
Dialogue: 0,0:03:21.97,0:03:23.72,Default,,0,0,0,,Şu ikiliyi rahat bırakmayın!
Dialogue: 0,0:03:23.72,0:03:25.19,Default,,0,0,0,,Ne olursa olsun durdurun!
Dialogue: 0,0:03:25.19,0:03:26.18,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:26.18,0:03:27.39,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:03:27.93,0:03:28.76,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:03:30.11,0:03:30.98,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:03:30.98,0:03:33.96,Default,,0,0,0,,{\i1}İşte geliyorlar.\NNankatsu'nun altın ikilisi!{\i0}
Dialogue: 0,0:03:33.96,0:03:36.96,Default,,0,0,0,,{\i1}Tsubasa-kun ve Misaki-kun\Ntopu mükemmel kontrol edip...{\i0}
Dialogue: 0,0:03:36.96,0:03:39.61,Default,,0,0,0,,{\i1}...tek vücut olarak Meiwa\Nsahasını yarıyorlar!{\i0}
Dialogue: 0,0:03:40.53,0:03:41.19,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:03:41.19,0:03:43.36,Default,,0,0,0,,Golü atalım Misaki-kun!
Dialogue: 0,0:03:43.36,0:03:44.07,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:44.07,0:03:45.66,Default,,0,0,0,,Sizi durduracağım!{you shall not pass!}
Dialogue: 0,0:03:46.17,0:03:48.21,Default,,0,0,0,,{\i1}Pasın rotasını mı tespit etti?{\i0}
Dialogue: 0,0:03:48.21,0:03:49.87,Default,,0,0,0,,{\i1}Hyuga-kun kesmek için harekete geçti!{\i0}
Dialogue: 0,0:03:49.87,0:03:50.79,Default,,0,0,0,,{\i1}Bende!{\i0}
Dialogue: 0,0:03:53.59,0:03:54.33,Default,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:03:54.33,0:03:56.04,Default,,0,0,0,,{\i1}Falso!{\i0}
Dialogue: 0,0:03:56.04,0:03:58.60,Default,,0,0,0,,{\i1}Hyuga-kun'un araya gireceğini\Ntahmin mi etti?!{\i0}
Dialogue: 0,0:03:58.60,0:04:01.13,Default,,0,0,0,,{\i1}Misaki-kun, Tsubasa-kun'a asist mi yapıyor?{\i0}
Dialogue: 0,0:04:01.50,0:04:03.88,Default,,0,0,0,,{\i1}Şutu engellemem yeterli!{\i0}
Dialogue: 0,0:04:03.88,0:04:06.10,Default,,0,0,0,,Arkadaş sende Misaki-kun!
Dialogue: 0,0:04:06.10,0:04:09.84,Default,,0,0,0,,{\i1}Hayır, şut çekmiyor!\NSon pası Tsubasa-kun kale önünden atıyor!{\i0}
Dialogue: 0,0:04:09.84,0:04:11.02,Default,,0,0,0,,{\i1}Bunlar...{\i0}
Dialogue: 0,0:04:11.02,0:04:13.56,Default,,0,0,0,,{\i1}Misaki-kun topa doğru koşuyor!{\i0}
Dialogue: 0,0:04:14.31,0:04:16.06,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:04:17.52,0:04:21.40,Default,,0,0,0,,{\i1}Nankatsu, ilk yarı bitmeden önce\Nskoru eşitliyor!{\i0}
Dialogue: 0,0:04:22.25,0:04:24.50,Default,,0,0,0,,Misaki-kun, güzel şuttu!
Dialogue: 0,0:04:24.50,0:04:26.74,Default,,0,0,0,,Güzel pastı Tsubasa-kun!
Dialogue: 0,0:04:28.07,0:04:30.49,Default,,0,0,0,,Harikasın Misaki!
Dialogue: 0,0:04:31.77,0:04:33.50,Default,,0,0,0,,{\i1}İlk yarı sona eriyor.{\i0}
Dialogue: 0,0:04:33.50,0:04:36.75,Default,,0,0,0,,{\i1}İkinci yarıdan 2-2 devam edeceğiz.{\i0}
Dialogue: 0,0:04:36.75,0:04:39.13,Default,,0,0,0,,Harikasın Nankatsu!
Dialogue: 0,0:04:39.13,0:04:41.50,Default,,0,0,0,,Tsubasa! Misaki!
Dialogue: 0,0:04:42.46,0:04:43.42,Default,,0,0,0,,Başardınız!
Dialogue: 0,0:04:43.42,0:04:44.36,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:54.82,0:04:58.31,Default,,0,0,0,,Bu maçın nasıl biteceğini\Nkestirmek imkansız.
Dialogue: 0,0:04:58.31,0:05:00.90,Default,,0,0,0,,Ellerinize sağlık.
Dialogue: 0,0:05:00.90,0:05:02.61,Default,,0,0,0,,Tsubasa, çabana sağlık.
Dialogue: 0,0:05:02.61,0:05:04.41,Default,,0,0,0,,Teşekkürler Ishizaki-kun.
Dialogue: 0,0:05:04.41,0:05:06.15,Default,,0,0,0,,Millet, hepiniz iyi iş çıkardınız.
Dialogue: 0,0:05:06.15,0:05:08.02,Default,,0,0,0,,İlk yarıyı berabere bitirmek önemliydi.
Dialogue: 0,0:05:08.02,0:05:09.11,Default,,0,0,0,,Evet.
Dialogue: 0,0:05:09.11,0:05:11.33,Default,,0,0,0,,Morisaki, ikinci yarıda\Niyi olacak mısın?
Dialogue: 0,0:05:11.33,0:05:15.72,Default,,0,0,0,,Evet. Bana bırakın lütfen.\NKalemizi koruyacağım!
Dialogue: 0,0:05:15.72,0:05:17.33,Default,,0,0,0,,Siz endişelenmeden atağa çıkın!
Dialogue: 0,0:05:17.33,0:05:18.58,Default,,0,0,0,,Tamam!
Dialogue: 0,0:05:18.58,0:05:21.92,Default,,0,0,0,,Tamamdır! İkinci yarı başladığı\Ngibi maça abanacağız!
Dialogue: 0,0:05:21.92,0:05:24.32,Default,,0,0,0,,Sonuna kadar atağa devam!
Dialogue: 0,0:05:24.32,0:05:25.67,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:25.67,0:05:26.38,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:05:27.78,0:05:30.23,Default,,0,0,0,,Öyleyse gol şovu olacak.
Dialogue: 0,0:05:30.85,0:05:34.18,Default,,0,0,0,,Siz topu bana atın ben\Nkesin gole çeviririm!
Dialogue: 0,0:05:34.18,0:05:36.81,Default,,0,0,0,,Canınız pahasına topu kale önüne taşıyın!
Dialogue: 0,0:05:37.42,0:05:39.98,Default,,0,0,0,,Bizim futbolumuz kaybedemez!
Dialogue: 0,0:05:39.98,0:05:40.73,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:40.73,0:05:46.55,Default,,0,0,0,,{\i1}Tsubasa denilen velet\NKojiro'yu gerçekten gaza getirmiş.{\i0}
Dialogue: 0,0:05:46.55,0:05:47.78,Default,,0,0,0,,İşte böyle Kojiro.
Dialogue: 0,0:05:48.42,0:05:50.61,Default,,0,0,0,,Atak, en iyi defanstır.
Dialogue: 0,0:05:50.61,0:05:52.88,Default,,0,0,0,,Gücünüzle düşmanı zapt edin.
Dialogue: 0,0:05:52.88,0:05:53.78,Default,,0,0,0,,Evet!
Dialogue: 0,0:05:54.60,0:05:57.99,Default,,0,0,0,,{\i1}Kaybetmek için buraya gelmedim ben!{\i0}
Dialogue: 0,0:05:57.99,0:06:01.25,Default,,0,0,0,,{\i1}Özelliklere de onlara!{\i0}
Dialogue: 0,0:06:02.35,0:06:06.39,Default,,0,0,0,,Herkes takımdaki eksikliğini kapatmak\Niçin elinden geleni yapıyor.
Dialogue: 0,0:06:06.39,0:06:07.09,Default,,0,0,0,,Evet.
Dialogue: 0,0:06:07.56,0:06:10.71,Default,,0,0,0,,Tamamdır! İkinci yarıda da\Nböyle devam edin!
Dialogue: 0,0:06:10.71,0:06:13.22,Default,,0,0,0,,Tsubasa! Misaki! Morisaki!
Dialogue: 0,0:06:13.96,0:06:17.00,Default,,0,0,0,,{\i1}Genzo, sen de oynamak istiyorsun değil mi?{\i0}
Dialogue: 0,0:06:17.00,0:06:20.39,Default,,0,0,0,,{\i1}Ama şimdilik sabretmen gerekecek,\Nazıcık sabırlık olman.{\i0}
Dialogue: 0,0:06:20.81,0:06:23.01,Default,,0,0,0,,{\i1}Oyuncular sahaya çıkıyor.{\i0}
Dialogue: 0,0:06:23.01,0:06:25.48,Default,,0,0,0,,{\i1}İkinci yarı başlamak üzere.{\i0}
Dialogue: 0,0:06:25.48,0:06:27.49,Default,,0,0,0,,İkinci yarı.
Dialogue: 0,0:06:27.49,0:06:29.86,Default,,0,0,0,,Maç bu yarıda belli olacak.
Dialogue: 0,0:06:29.86,0:06:31.24,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:06:31.24,0:06:32.99,Default,,0,0,0,,Tsubasa ve Hyuga...
Dialogue: 0,0:06:32.99,0:06:35.12,Default,,0,0,0,,Misaki, kaybetme sakın.
Dialogue: 0,0:06:35.78,0:06:37.62,Default,,0,0,0,,Mücadelelerinin son kısmı olacak bu.
Dialogue: 0,0:06:37.62,0:06:41.58,Default,,0,0,0,,Tsubasa mı daha iyi mi Kojiro mu?
Dialogue: 0,0:06:42.77,0:06:46.38,Default,,0,0,0,,{\i1}Sana gerçek futbolumu göstereceğim...{\i0}
Dialogue: 0,0:06:46.38,0:06:48.34,Default,,0,0,0,,{\i1}...Ozora Tsubasa!{\i0}
Dialogue: 0,0:06:49.59,0:06:52.34,Default,,0,0,0,,{\i1}İkinci yarı başlıyor.{\i0}
Dialogue: 0,0:06:52.81,0:06:56.47,Default,,0,0,0,,{\i1}Şuna bakın! Hızlı başlayan\Ntaraf Nankatsu!{\i0}
Dialogue: 0,0:06:56.47,0:07:01.30,Default,,0,0,0,,{\i1}İlk yarıda skoru eşitledikten sonra\Nçok gaza gelen Misaki-kun topu alıyor ve...{\i0}
Dialogue: 0,0:07:01.30,0:07:03.35,Default,,0,0,0,,{\i1}...yetenekli bir şekilde ileri doğru sürüyor.{\i0}
Dialogue: 0,0:07:03.35,0:07:04.40,Default,,0,0,0,,İzin vermeyin!
Dialogue: 0,0:07:04.40,0:07:05.27,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:05.27,0:07:07.07,Default,,0,0,0,,{\i1}Meiwa kayarak bariyer oluşturuyor!{\i0}
Dialogue: 0,0:07:07.94,0:07:10.11,Default,,0,0,0,,{\i1}Ama top Misaki-kun'da kalıyor.{\i0}
Dialogue: 0,0:07:11.32,0:07:13.07,Default,,0,0,0,,Kendini bir şey sanma!
Dialogue: 0,0:07:13.80,0:07:16.37,Default,,0,0,0,,{\i1}Hyuga-kun kayarak topu alıyor!{\i0}
Dialogue: 0,0:07:16.37,0:07:19.37,Default,,0,0,0,,{\i1}Neredeyse faul sayılabilecek\Nağır bir kaymaydı.{\i0}
Dialogue: 0,0:07:19.37,0:07:22.75,Default,,0,0,0,,Futbol oynama şeklinizle\Nbize karşı kazanma şansınız yok!
Dialogue: 0,0:07:23.44,0:07:27.92,Default,,0,0,0,,İkinci yarıda gerçek gücümüzü\Ngördükten sonra ağlayacaksınız!
Dialogue: 0,0:07:27.92,0:07:29.21,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:07:29.21,0:07:31.22,Default,,0,0,0,,{\i1}Nankatsu topu almaya çalışıyor!{\i0}
Dialogue: 0,0:07:33.30,0:07:35.89,Default,,0,0,0,,{\i1}Bu sefer top Izawa-kun'a çarpıyor!{\i0}
Dialogue: 0,0:07:35.89,0:07:36.76,Default,,0,0,0,,Izawa-kun!
Dialogue: 0,0:07:37.37,0:07:38.10,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:07:38.57,0:07:41.77,Default,,0,0,0,,{\i1}Sawada-kun'a pas atan Hyuga-kun\Ndirekt koşmaya başlıyor.{\i0}
Dialogue: 0,0:07:42.55,0:07:43.35,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:07:43.35,0:07:45.48,Default,,0,0,0,,{\i1}Orta geliyor!{\i0}
Dialogue: 0,0:07:45.48,0:07:47.69,Default,,0,0,0,,Kaçmayacağım. Kesinlikle tutacağım.
Dialogue: 0,0:07:48.65,0:07:51.19,Default,,0,0,0,,Al bakalım!
Dialogue: 0,0:07:51.19,0:07:52.53,Default,,0,0,0,,{\i1}Sert bir şut!{\i0}
Dialogue: 0,0:07:53.82,0:07:55.86,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:07:55.86,0:07:58.42,Default,,0,0,0,,{\i1}Bu kez kaleciyi hedef almak yerine...{\i0}
Dialogue: 0,0:07:58.42,0:08:00.66,Default,,0,0,0,,{\i1}...kaleyi bulan bir şut.{\i0}
Dialogue: 0,0:08:00.66,0:08:04.17,Default,,0,0,0,,{\i1}Meiwa 3-2 ile tekrar\Nliderliği ele geçiriyor.{\i0}
Dialogue: 0,0:08:04.17,0:08:05.34,Default,,0,0,0,,Izawa-kun.
Dialogue: 0,0:08:05.34,0:08:07.57,Default,,0,0,0,,İyi misin Izawa?
Dialogue: 0,0:08:07.57,0:08:08.51,Default,,0,0,0,,Evet.
Dialogue: 0,0:08:09.39,0:08:11.25,Default,,0,0,0,,Anladınız mı şimdi Nankatsu?!
Dialogue: 0,0:08:12.09,0:08:14.34,Default,,0,0,0,,Bizim futbolumuz bu işte!
Dialogue: 0,0:08:16.59,0:08:19.60,Default,,0,0,0,,Daha bitmedi!\N Her şey döner hala!
Dialogue: 0,0:08:20.02,0:08:22.36,Default,,0,0,0,,{\i1}Bu kez Nankatsu atağa çıkıyor.{\i0}
Dialogue: 0,0:08:22.36,0:08:23.35,Default,,0,0,0,,Kaybetmeyeceğiz!
Dialogue: 0,0:08:25.70,0:08:26.60,Default,,0,0,0,,Kisugi!
Dialogue: 0,0:08:27.60,0:08:28.36,Default,,0,0,0,,Taki!
Dialogue: 0,0:08:28.74,0:08:29.73,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:08:29.73,0:08:31.80,Default,,0,0,0,,{\i1}Nankatsu pes etmiyor!{\i0}
Dialogue: 0,0:08:31.80,0:08:33.99,Default,,0,0,0,,{\i1}Atakları çok senkronize!{\i0}
Dialogue: 0,0:08:33.99,0:08:36.49,Default,,0,0,0,,Tsubasa'yı tutun!\NTsubasa'yı yalnız bırakmayın!
Dialogue: 0,0:08:38.53,0:08:40.24,Default,,0,0,0,,Al Misaki!
Dialogue: 0,0:08:40.24,0:08:42.75,Default,,0,0,0,,{\i1}Top oyun kurucu Misaki-un'a gidiyor.{\i0}
Dialogue: 0,0:08:42.75,0:08:46.60,Default,,0,0,0,,{\i1}Ne var ki as oyuncu Tsubasa-kun\Nfeci şekilde markaja alınmış durumda!{\i0}
Dialogue: 0,0:08:47.04,0:08:47.63,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:48.31,0:08:51.55,Default,,0,0,0,,{\i1}Tsubasa-kun hızlı bir aldatmacayla\Nmarkajdan kurtuluyor!{\i0}
Dialogue: 0,0:08:51.55,0:08:52.55,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:53.26,0:08:54.01,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:08:57.68,0:09:00.14,Default,,0,0,0,,{\i1}Tsubasa-kun'dan bir kafa vuruşu!{\i0}
Dialogue: 0,0:09:00.67,0:09:03.85,Default,,0,0,0,,{\i1}Nankatsu yine skoru eşitliyor!{\i0}
Dialogue: 0,0:09:05.14,0:09:06.56,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:09:07.26,0:09:10.82,Default,,0,0,0,,{\i1}Çok çekişmeli bir maç oluyor!{\i0}
Dialogue: 0,0:09:10.82,0:09:14.09,Default,,0,0,0,,{\i1}İki takım da tüm çabalarıyla...{\i0}
Dialogue: 0,0:09:14.09,0:09:19.01,Default,,0,0,0,,{\i1}...karşı kalenin önündeki forvetleri Hyuga-kun\Nile Tsubasa-kun'a topu ulaştırmaya çalışıyor.{\i0}
Dialogue: 0,0:09:19.01,0:09:21.78,Default,,0,0,0,,{\i1}Ve top ne zaman onlara gelse...{\i0}
Dialogue: 0,0:09:21.78,0:09:24.67,Default,,0,0,0,,{\i1}...ikisi de gole çeviriyor.{\i0}
Dialogue: 0,0:09:24.67,0:09:27.68,Default,,0,0,0,,{\i1}Maçın sonucunu kestirmek imkansız!{\i0}
Dialogue: 0,0:09:29.79,0:09:32.80,Default,,0,0,0,,{\i1}Nankatsu yine skoru eşitliyor!{\i0}
Dialogue: 0,0:09:36.09,0:09:37.77,Default,,0,0,0,,{\i1}Skor 5-5.{\i0}
Dialogue: 0,0:09:37.77,0:09:42.13,Default,,0,0,0,,{\i1}Kavurucu güneş altında Nankatsu, Meiwa,\NTsubasa-kun, Hyuga-kun...{\i0}
Dialogue: 0,0:09:42.13,0:09:43.90,Default,,0,0,0,,{\i1}...teslim olmayı kabullenmiyor!{\i0}
Dialogue: 0,0:09:43.90,0:09:46.28,Default,,0,0,0,,{\i1}Maçın bitmesine sadece 5 dakika kaldı.{\i0}
Dialogue: 0,0:09:46.28,0:09:48.06,Default,,0,0,0,,Şu adi...
Dialogue: 0,0:09:48.06,0:09:51.17,Default,,0,0,0,,İki takım da aynı seviyede.
Dialogue: 0,0:09:51.17,0:09:55.28,Default,,0,0,0,,Bu korkunç sıcaklıkta teknik yerine\Nazim öne çıkıyor.
Dialogue: 0,0:09:55.28,0:10:00.98,Default,,0,0,0,,{\i1}Kendi futbol tarzlarına\Ntüm duygularını vermiş...{\i0}
Dialogue: 0,0:10:00.98,0:10:03.41,Default,,0,0,0,,{\i1}...iki oyuncu arasındaki bir mücadele.{\i0}
Dialogue: 0,0:10:03.41,0:10:05.16,Default,,0,0,0,,{\i1}Hayatta kaybetmem!{\i0}
Dialogue: 0,0:10:05.16,0:10:08.21,Default,,0,0,0,,{\i1}Sıradaki golü Nankatsu mu\NMeiwa mı atacak?{\i0}
Dialogue: 0,0:10:09.79,0:10:13.79,Default,,0,0,0,,{\i1}Topu alan Sawada-kun\Nkanattan yardırıyor!{\i0}
Dialogue: 0,0:10:14.14,0:10:14.84,Default,,0,0,0,,Bana ver!
Dialogue: 0,0:10:16.16,0:10:17.24,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:10:17.24,0:10:18.92,Default,,0,0,0,,{\i1}Sawada-kun orta açıyor!{\i0}
Dialogue: 0,0:10:18.92,0:10:20.18,Default,,0,0,0,,{\i1}Yüksek bir top!{\i0}
Dialogue: 0,0:10:22.16,0:10:25.51,Default,,0,0,0,,{\i1}Ne olursa olsun kaybedemem!{\i0}
Dialogue: 0,0:10:26.77,0:10:29.81,Default,,0,0,0,,Kaybedemem be!
Dialogue: 0,0:10:30.56,0:10:32.06,Default,,0,0,0,,{\i1}Kafa topu mücadelesi!{\i0}
Dialogue: 0,0:10:35.90,0:10:37.44,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:10:38.49,0:10:42.45,Default,,0,0,0,,{\i1}İkinci yarının 16. dakikasında\NMeiwa bir kez daha öne geçiyor.{\i0}
Dialogue: 0,0:10:42.45,0:10:45.74,Default,,0,0,0,,{\i1}Büyük fiziğiyle Hyuga-kun'un\Nkazandığını söyleyebilir miyiz?{\i0}
Dialogue: 0,0:10:45.74,0:10:46.91,Default,,0,0,0,,Gördün mü?!
Dialogue: 0,0:10:46.91,0:10:50.96,Default,,0,0,0,,Benim futbolum senin çocuk\Noyunundan farklıdır!
Dialogue: 0,0:10:50.96,0:10:52.42,Default,,0,0,0,,Oyun değil bizimki!
Dialogue: 0,0:10:52.42,0:10:53.81,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:53.81,0:10:57.33,Default,,0,0,0,,Futbol... Futbol benim hayalim!
Dialogue: 0,0:11:06.46,0:11:10.73,Default,,0,0,0,,{\i1}Son düdüğün çalmasına 4 dakika\Ngibi az bir süre kaldı.{\i0}
Dialogue: 0,0:11:10.73,0:11:12.43,Default,,0,0,0,,{\i1}Nankatsu beraberliği sağlayabilecek mi?{\i0}
Dialogue: 0,0:11:12.43,0:11:14.77,Default,,0,0,0,,Millet, kesinlikle beraberliği sağlayacağız!
Dialogue: 0,0:11:14.77,0:11:18.07,Default,,0,0,0,,Attığımız golü kesinlikle koruyacağız!
Dialogue: 0,0:11:18.07,0:11:21.43,Default,,0,0,0,,{\i1}Ozora Tsubasa... Ne hayali bu?{\i0}
Dialogue: 0,0:11:21.43,0:11:23.99,Default,,0,0,0,,{\i1}Futbol çocuk oyunu değildir.{\i0}
Dialogue: 0,0:11:23.99,0:11:26.37,Default,,0,0,0,,{\i1}Sana bunu öğreteceğim!{\i0}
Dialogue: 0,0:11:26.77,0:11:27.87,Default,,0,0,0,,{\i1}Maç devam ediyor.{\i0}
Dialogue: 0,0:11:27.87,0:11:31.29,Default,,0,0,0,,{\i1}Nankatsu tüm oyuncularıyla\Nileri çıkıyor.{\i0}
Dialogue: 0,0:11:31.29,0:11:33.13,Default,,0,0,0,,Bastır Nankatsu!
Dialogue: 0,0:11:33.13,0:11:35.29,Default,,0,0,0,,Beraberliği sağlayın!
Dialogue: 0,0:11:35.29,0:11:37.17,Default,,0,0,0,,Sana güveniyorum Tsubasa!
Dialogue: 0,0:11:37.17,0:11:41.92,Default,,0,0,0,,{\i1}Nankatsu as oyuncuları\NTsubasa-kun'a topu ulaştırmaya çalışıyor.{\i0}
Dialogue: 0,0:11:41.92,0:11:46.97,Default,,0,0,0,,{\i1}Ne var ki kalenin önündeki\NTsubasa-kun, Hyuga-kun tarafından tutuluyor!{\i0}
Dialogue: 0,0:11:46.97,0:11:51.62,Default,,0,0,0,,Tsubasa! Sana gelen her pası keseceğim!
Dialogue: 0,0:11:53.10,0:11:54.64,Default,,0,0,0,,Lanet olası Hyuga!
Dialogue: 0,0:11:54.64,0:11:56.36,Default,,0,0,0,,Dikkat et Urabe!
Dialogue: 0,0:11:57.36,0:11:59.11,Default,,0,0,0,,{\i1}Nankatsu topu kaybetti.{\i0}
Dialogue: 0,0:11:59.11,0:12:00.49,Default,,0,0,0,,Atak!
Dialogue: 0,0:12:00.49,0:12:02.57,Default,,0,0,0,,Topu aldıysanız tek yapmanız\Ngereken atak yapmak!
Dialogue: 0,0:12:02.57,0:12:04.07,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:04.07,0:12:09.58,Default,,0,0,0,,{\i1}Sadece defans yapmayıp sonuna kadar\Natak da yapmak Meiwa'nın gücünün sırrı mı yoksa?{\i0}
Dialogue: 0,0:12:09.58,0:12:11.22,Default,,0,0,0,,{\i1}Aynen öyle.{\i0}
Dialogue: 0,0:12:11.22,0:12:13.88,Default,,0,0,0,,{\i1}Takımın sadece defansta iyiyse...{\i0}
Dialogue: 0,0:12:13.88,0:12:16.04,Default,,0,0,0,,{\i1}...iyi takım yetiştirememişsin demektir.{\i0}
Dialogue: 0,0:12:16.04,0:12:19.34,Default,,0,0,0,,Geri dönün! Bir daha\Ngol atarlarsa işimiz biter!
Dialogue: 0,0:12:22.16,0:12:24.01,Default,,0,0,0,,{\i1}Sawada-kun topu içeri yolluyor.{\i0}
Dialogue: 0,0:12:24.01,0:12:24.84,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:12:24.84,0:12:27.58,Default,,0,0,0,,Bende! Bitirici vuruş!
Dialogue: 0,0:12:28.30,0:12:32.22,Default,,0,0,0,,{\i1}Morisaki-kun zıplayıp harika\Nbir şekilde kurtarıyor!{\i0}
Dialogue: 0,0:12:32.22,0:12:32.93,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:32.93,0:12:34.49,Default,,0,0,0,,Güzeldi Morisaki!
Dialogue: 0,0:12:34.49,0:12:35.56,Default,,0,0,0,,Kurtulduk.
Dialogue: 0,0:12:35.56,0:12:39.11,Default,,0,0,0,,Nankatsu kaybetmeyecek!
Dialogue: 0,0:12:39.11,0:12:41.82,Default,,0,0,0,,{\i1}Morisaki-kun'un pası Misaki-kun'a gidiyor.{\i0}
Dialogue: 0,0:12:41.82,0:12:42.78,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:12:43.99,0:12:45.57,Default,,0,0,0,,{\i1}Tek dokunuşla ileri yolluyor.{\i0}
Dialogue: 0,0:12:45.57,0:12:48.49,Default,,0,0,0,,{\i1}Orada sadece Tsubasa-kun ve\NHyuga-kun var.{\i0}
Dialogue: 0,0:12:48.49,0:12:49.39,Default,,0,0,0,,{\i1}Kojiro!{\i0}
Dialogue: 0,0:12:49.39,0:12:50.91,Default,,0,0,0,,{\i1}Al topu Tsubasa-kun!{\i0}
Dialogue: 0,0:12:50.91,0:12:52.29,Default,,0,0,0,,{\i1}Kesinlikle alacağım!{\i0}
Dialogue: 0,0:12:52.29,0:12:53.16,Default,,0,0,0,,{\i1}Kaybetmem!{\i0}
Dialogue: 0,0:12:53.16,0:12:55.46,Default,,0,0,0,,{\i1}Maçın son karşılaşması!{\i0}
Dialogue: 0,0:12:56.65,0:12:58.00,Default,,0,0,0,,{\i1}Yine hava topu mücadelesi!{\i0}
Dialogue: 0,0:12:58.00,0:13:00.09,Default,,0,0,0,,{\i1}Bu kez ikisi de eşit!{\i0}
Dialogue: 0,0:13:01.88,0:13:04.01,Default,,0,0,0,,{\i1}İkisi de kazanamıyor ve yere düşüyorlar!{\i0}
Dialogue: 0,0:13:04.01,0:13:05.26,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:13:05.90,0:13:08.30,Default,,0,0,0,,{\i1}Tsubasa-kun hemen ayağa kalkıp\Nkoşmaya başlıyor!{\i0}
Dialogue: 0,0:13:08.30,0:13:10.14,Default,,0,0,0,,Başardın Tsubasa-kun!
Dialogue: 0,0:13:10.14,0:13:14.39,Default,,0,0,0,,{\i1}Boştaki topu hızlıca alan Tsubasa-kun\NMeiwa kalesine doğru koşmaya başlıyor.{\i0}
Dialogue: 0,0:13:15.21,0:13:15.98,Default,,0,0,0,,Lanet olası!
Dialogue: 0,0:13:15.98,0:13:19.44,Default,,0,0,0,,{\i1}Hyuga-kun da hemen kalkıyor\Nve peşinden gitmeye başlıyor!{\i0}
Dialogue: 0,0:13:19.44,0:13:21.51,Default,,0,0,0,,{\i1}Hyuga-kun yetişebilecek mi acaba?{\i0}
Dialogue: 0,0:13:21.51,0:13:23.37,Default,,0,0,0,,{\i1}Son mücadele!{\i0}
Dialogue: 0,0:13:23.37,0:13:27.28,Default,,0,0,0,,{\i1}Wakabayashi-kun'a verdiğim sözü\Ntutmak için beraberliği sağlamam gerek!{\i0}
Dialogue: 0,0:13:27.28,0:13:29.97,Default,,0,0,0,,{\i1}Futbolun hayalin olduğu\Nsöylemi de ne?!{\i0}
Dialogue: 0,0:13:29.97,0:13:32.29,Default,,0,0,0,,{\i1}Futbolda sadece kazanmak ve\Nkaybetmek vardır!{\i0}
Dialogue: 0,0:13:32.29,0:13:33.81,Default,,0,0,0,,{\i1}Sadece bu kadar!{\i0}
Dialogue: 0,0:13:34.09,0:13:39.38,Default,,0,0,0,,{\i1}Bu top çalmamla yanıldığını\Nsana göstereceğim Ozora Tsubasa!{\i0}
Dialogue: 0,0:13:41.74,0:13:44.96,Default,,0,0,0,,{\i1}Hyuga-kun'un kaymasından kurtuluyor!{\i0}
Dialogue: 0,0:13:44.96,0:13:45.84,Default,,0,0,0,,Ne?!
Dialogue: 0,0:13:45.84,0:13:49.08,Default,,0,0,0,,{\i1}Ve oradan vole vuruyor!{\i0}
Dialogue: 0,0:13:49.95,0:13:51.35,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:13:51.99,0:13:56.27,Default,,0,0,0,,{\i1}Nankatsu maçın sonunda yine\Nberaberliği sağlıyor!{\i0}
Dialogue: 0,0:13:58.33,0:14:02.41,Default,,0,0,0,,{\i1}Tüm gücümle top çalmaya\Nçalışmama rağmen kurtuldu.{\i0}
Dialogue: 0,0:14:03.62,0:14:05.21,Default,,0,0,0,,{\i1}Saçmalık.{\i0}
Dialogue: 0,0:14:05.73,0:14:09.53,Default,,0,0,0,,{\i1}Benim kaybetmem mümkün değil.{\i0}
Dialogue: 0,0:14:13.24,0:14:15.75,Default,,0,0,0,,{\t(1738,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Futbol benim hayalim!{\i0}
Dialogue: 0,0:14:17.25,0:14:18.52,Default,,0,0,0,,Başardın! Başardın!
Dialogue: 0,0:14:18.52,0:14:19.56,Default,,0,0,0,,Harikaydın!
Dialogue: 0,0:14:19.56,0:14:21.13,Default,,0,0,0,,Başardın Tsubasa-kun!
Dialogue: 0,0:14:21.13,0:14:21.78,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:21.78,0:14:23.25,Default,,0,0,0,,{\i1}İşte bizim Tsubasa.{\i0}
Dialogue: 0,0:14:23.76,0:14:27.18,Default,,0,0,0,,{\i1}Hava topunda ve top çalmada\Nbir kez kaybetmiş olabilirsin.{\i0}
Dialogue: 0,0:14:27.18,0:14:29.26,Default,,0,0,0,,{\i1}Ama bir kez daha kaybetmeyeceksin.{\i0}
Dialogue: 0,0:14:29.26,0:14:31.90,Default,,0,0,0,,{\i1}Tsubasa'nın gücü bu işte.{\i0}
Dialogue: 0,0:14:31.90,0:14:34.86,Default,,0,0,0,,Tamamdır millet.\NSadece bir dakika kaldı.
Dialogue: 0,0:14:34.86,0:14:37.47,Default,,0,0,0,,Buraya kadar geldik!\NKesinlikle kazanacağız!
Dialogue: 0,0:14:37.47,0:14:38.77,Default,,0,0,0,,Evet!
Dialogue: 0,0:14:39.39,0:14:40.93,Default,,0,0,0,,Hyuga-san.
Dialogue: 0,0:14:40.93,0:14:45.40,Default,,0,0,0,,Takeshi, maç başlayınca\Nbana yavaş bir pas ver.
Dialogue: 0,0:14:49.19,0:14:53.33,Default,,0,0,0,,{\i1}Ozora Tsubasa, yetenekli birisin.{\i0}
Dialogue: 0,0:14:53.33,0:14:55.72,Default,,0,0,0,,{\i1}Ulusal turnuvada...{\i0}
Dialogue: 0,0:14:55.72,0:15:00.16,Default,,0,0,0,,{\i1}...benimle birebir mücadeleye\Ngirebilecek birisi olabileceğini düşünmezdim.{\i0}
Dialogue: 0,0:15:00.16,0:15:02.17,Default,,0,0,0,,{\i1}Ama her şey burada sona erecek.{\i0}
Dialogue: 0,0:15:02.17,0:15:04.75,Default,,0,0,0,,{\i1}Bu şutla... Bu tek şutla...{\i0}
Dialogue: 0,0:15:05.50,0:15:06.17,Default,,0,0,0,,Bu--
Dialogue: 0,0:15:07.29,0:15:10.84,Default,,0,0,0,,{\i1}Şimdiye kadarki her şeyi boşa çıkaracağım!{\i0}
Dialogue: 0,0:15:12.51,0:15:13.30,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:15:13.30,0:15:18.39,Default,,0,0,0,,{\i1}Direkt kaleyi hedefleyen uzun bir şut bu!{\i0}
Dialogue: 0,0:15:19.17,0:15:20.43,Default,,0,0,0,,{\i1}Olmuyor! Ulaşamıyor!{\i0}
Dialogue: 0,0:15:24.01,0:15:26.94,Default,,0,0,0,,{\i1}Hayır! Girmiyor!\NKale direğine çarptı!{\i0}
Dialogue: 0,0:15:28.62,0:15:30.30,Default,,0,0,0,,{\i1}Nankatsu uzaklaştırıyor!{\i0}
Dialogue: 0,0:15:30.30,0:15:33.61,Default,,0,0,0,,{\i1}Hayır! Hyuga-kun topu kesiyor!{\i0}
Dialogue: 0,0:15:33.61,0:15:36.08,Default,,0,0,0,,{\i1}Son ana kadar pes etmiyor!{\i0}
Dialogue: 0,0:15:36.08,0:15:38.52,Default,,0,0,0,,{\i1}İnanılmazsın Hyuga Kojiro.{\i0}
Dialogue: 0,0:15:38.52,0:15:40.85,Default,,0,0,0,,{\i1}Kazanmak için bu kadar hırslı olmak...{\i0}
Dialogue: 0,0:15:40.85,0:15:42.42,Default,,0,0,0,,{\i1}Wakabayashi-kun'dan bile daha fazla.{\i0}
Dialogue: 0,0:15:42.42,0:15:43.96,Default,,0,0,0,,{\i1}Şut çekme mesafesinde.{\i0}
Dialogue: 0,0:15:43.96,0:15:46.34,Default,,0,0,0,,{\i1}Ama artık uzatmalara girdik.{\i0}
Dialogue: 0,0:15:49.26,0:15:52.55,Default,,0,0,0,,{\i1}Ne? Tsubasa, şut yoluna dikildi.{\i0}
Dialogue: 0,0:15:52.55,0:15:55.55,Default,,0,0,0,,{\i1}Bu kez Tsubasa-kun, Hyuga-kun'u tutuyor.{\i0}
Dialogue: 0,0:15:55.55,0:16:01.56,Default,,0,0,0,,{\i1}Hyuga-kun geçmeye çalışıyor ama kaleyi\Nkorumaya çalışan Tsubasa-kun izin vermiyor.{\i0}
Dialogue: 0,0:16:02.09,0:16:05.31,Default,,0,0,0,,{\i1}Ben de asla kaybetmem!\NHayatta izin vermeyeceğim!{\i0}
Dialogue: 0,0:16:05.31,0:16:08.57,Default,,0,0,0,,{\i1}Kazanan ben olacağım!\NBen olacağım!{\i0}
Dialogue: 0,0:16:08.57,0:16:10.53,Default,,0,0,0,,Devam et Tsubasa!
Dialogue: 0,0:16:10.53,0:16:11.69,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:16:11.69,0:16:13.15,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:13.91,0:16:17.16,Default,,0,0,0,,{\i1}Stadyum çığlıklarla yıkılıyor!{\i0}
Dialogue: 0,0:16:17.16,0:16:23.66,Default,,0,0,0,,{\i1}Tsubasa-kun ve Hyuga-kun arasındaki\Nkarşılaşma ile başlayan maç...{\i0}
Dialogue: 0,0:16:23.66,0:16:28.54,Default,,0,0,0,,{\i1}...ikili arasında devam etti ve\Nşimdi de ikili arasında bitecek!{\i0}
Dialogue: 0,0:16:29.36,0:16:31.05,Default,,0,0,0,,Kaybetme Tsubasa!
Dialogue: 0,0:16:31.05,0:16:32.88,Default,,0,0,0,,{\i1}Sonuna kadar yapış Kojiro!{\i0}
Dialogue: 0,0:16:32.88,0:16:35.80,Default,,0,0,0,,{\i1}Sonuna kadar yapış ve şutunu çek!{\i0}
Dialogue: 0,0:16:37.43,0:16:41.85,Default,,0,0,0,,{\i1}Tsubasa-kun'un ayağı kayıyor\Nve dengesini kaybediyor!{\i0}
Dialogue: 0,0:16:42.60,0:16:43.65,Default,,0,0,0,,{\i1}İşte fırsat!{\i0}
Dialogue: 0,0:16:43.65,0:16:48.02,Default,,0,0,0,,{\i1}Hyuga-kun, Tsubasa-kun'u geçiyor\Nve şut pozisyonu alıyor!{\i0}
Dialogue: 0,0:16:48.02,0:16:48.77,Default,,0,0,0,,{\i1}Şimdi!{\i0}
Dialogue: 0,0:16:49.48,0:16:53.03,Default,,0,0,0,,{\i1}Hyuga-kun şut çekemiyor!\NTsubasa-kun topu uzaklaştırıyor!{\i0}
Dialogue: 0,0:16:53.03,0:16:53.90,Default,,0,0,0,,Başardım!
Dialogue: 0,0:16:53.90,0:16:56.53,Default,,0,0,0,,Bilerek öyle davranmış!
Dialogue: 0,0:16:56.53,0:16:57.87,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:16:58.63,0:17:00.62,Default,,0,0,0,,{\i1}Top Takasugi-kun'a gidiyor.{\i0}
Dialogue: 0,0:17:00.62,0:17:01.79,Default,,0,0,0,,{\i1}Son düdük--{\i0}
Dialogue: 0,0:17:17.84,0:17:20.05,Default,,0,0,0,,{\i1}G-Gol!{\i0}
Dialogue: 0,0:17:21.60,0:17:25.08,Default,,0,0,0,,{\i1}Ve hakem düdüğü çalıyor.{\i0}
Dialogue: 0,0:17:25.08,0:17:27.10,Default,,0,0,0,,{\i1}Nankatsu kaybediyor!{\i0}
Dialogue: 0,0:17:32.96,0:17:35.34,Default,,0,0,0,,{\i1}Ne son ama!{\i0}
Dialogue: 0,0:17:35.34,0:17:37.82,Default,,0,0,0,,{\i1}İki takım da kazanmak için çabalıyordu...{\i0}
Dialogue: 0,0:17:37.82,0:17:42.70,Default,,0,0,0,,{\i1}...ve as forvetler arasındaki mücadelede...{\i0}
Dialogue: 0,0:17:42.70,0:17:46.12,Default,,0,0,0,,{\i1}...kargaşadan yararlanarak\NNankatsu'yu yakalayan Sawada-kun oldu!{\i0}
Dialogue: 0,0:17:46.12,0:17:52.55,Default,,0,0,0,,{\i1}7-6! 1. gruptaki ilk maçı,\NNankatsu'ya karşı Meiwa kazanıyor!{\i0}
Dialogue: 0,0:17:53.49,0:17:55.92,Default,,0,0,0,,{\i1}Maçı Meiwa kazandı ama...{\i0}
Dialogue: 0,0:17:55.92,0:17:59.55,Default,,0,0,0,,{\i1}...Tsubasa ve Hyuga arasındaki\Nmücadele berabere bitti.{\i0}
Dialogue: 0,0:18:02.09,0:18:03.56,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:18:07.55,0:18:09.06,Default,,0,0,0,,{\i1}Lanet olsun...{\i0}
Dialogue: 0,0:18:09.96,0:18:13.07,Default,,0,0,0,,{\i1}O... Ağlıyor mu?{\i0}
Dialogue: 0,0:18:13.55,0:18:15.25,Default,,0,0,0,,Gidelim Tsubasa.
Dialogue: 0,0:18:16.17,0:18:16.98,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:19.07,0:18:22.47,Default,,0,0,0,,Güzel maçtı Nankatsu, Meiwa!
Dialogue: 0,0:18:22.47,0:18:24.08,Default,,0,0,0,,Güzel oyundu!
Dialogue: 0,0:18:25.38,0:18:29.81,Default,,0,0,0,,{\i1}Sahadan ayrılan iki takım için de\Nseyirciler büyük tezahüratlarda bulunuyor.{\i0}
Dialogue: 0,0:18:29.81,0:18:34.46,Default,,0,0,0,,{\i1}Nankatsu ve Meiwa'nın on biri\Niyi mücadele etti.{\i0}
Dialogue: 0,0:18:41.42,0:18:43.58,Default,,0,0,0,,{\i1}Neden herkesin yüzü düşük?{\i0}
Dialogue: 0,0:18:43.92,0:18:46.56,Default,,0,0,0,,Kaybetmiş olabiliriz ama iyi bir maçtı.
Dialogue: 0,0:18:46.56,0:18:48.98,Default,,0,0,0,,Hemen modunuz düşmesin.
Dialogue: 0,0:18:48.98,0:18:52.56,Default,,0,0,0,,Daha turnuvadan elenmedik.
Dialogue: 0,0:18:52.56,0:18:53.54,Default,,0,0,0,,Ne?
Dialogue: 0,0:18:53.54,0:18:55.14,Default,,0,0,0,,Doğru ya.
Dialogue: 0,0:18:55.14,0:18:59.61,Default,,0,0,0,,Elemelere her gruptan 2 takım çıkacak.
Dialogue: 0,0:18:59.61,0:19:03.76,Default,,0,0,0,,Kalan maçları kazanırsak\Nelemelere çıkma şansını yakalarız!
Dialogue: 0,0:19:03.76,0:19:05.08,Default,,0,0,0,,Doğru ya.
Dialogue: 0,0:19:05.08,0:19:06.12,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:19:06.68,0:19:11.25,Default,,0,0,0,,Tsubasa! Bir kaptan asla\Nmoralini bozmamalı!
Dialogue: 0,0:19:11.25,0:19:16.55,Default,,0,0,0,,Bugünkü yenilgiyi unut ve\Nbundan sonraki her maçı kazanmaya bak!
Dialogue: 0,0:19:16.55,0:19:21.08,Default,,0,0,0,,O zaman Meiwa ile\Nfinallerde yine karşılaşabiliriz.
Dialogue: 0,0:19:22.30,0:19:23.64,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:23.64,0:19:25.00,Default,,0,0,0,,Sıradaki maça bakalım!
Dialogue: 0,0:19:25.00,0:19:27.60,Default,,0,0,0,,Hepsini kazanalım!
Dialogue: 0,0:19:30.38,0:19:31.52,Default,,0,0,0,,Ben Shiroyama.
Dialogue: 0,0:19:33.48,0:19:35.74,Default,,0,0,0,,Morisaki, telefon var.
Dialogue: 0,0:19:35.74,0:19:36.98,Default,,0,0,0,,Ne?
Dialogue: 0,0:19:37.77,0:19:41.17,Default,,0,0,0,,Kaybettik ama iyi bir maçtı.
Dialogue: 0,0:19:41.17,0:19:43.99,Default,,0,0,0,,Çabana sağlık.
Dialogue: 0,0:19:43.99,0:19:46.58,Default,,0,0,0,,Wakabayashi-san!
Dialogue: 0,0:19:46.58,0:19:49.57,Default,,0,0,0,,Ben dönene kadar Nankatsu\Nkalesi sana emanet.
Dialogue: 0,0:19:49.57,0:19:51.67,Default,,0,0,0,,Evet. Elimden geleni yapacağım.
Dialogue: 0,0:19:51.67,0:19:54.34,Default,,0,0,0,,Bu arada Tsubasa iyi mi?
Dialogue: 0,0:19:54.34,0:19:57.04,Default,,0,0,0,,Ne? Hemen ona vereyim.
Dialogue: 0,0:19:57.61,0:19:59.26,Default,,0,0,0,,Sen misin Tsubasa?
Dialogue: 0,0:19:59.82,0:20:01.26,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:01.71,0:20:02.71,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:03.31,0:20:04.76,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:04.76,0:20:06.28,Default,,0,0,0,,Her şey yolunda.
Dialogue: 0,0:20:06.28,0:20:11.52,Default,,0,0,0,,Sıradaki 4 maçın hepsini kazanacak\Nve elemelere çıkacağız.
Dialogue: 0,0:20:11.52,0:20:14.56,Default,,0,0,0,,Aynen öyle. Bize güvenebilirsin Wakabayashi-san.
Dialogue: 0,0:20:14.56,0:20:18.02,Default,,0,0,0,,Kesinlikle kazanacağız!\NDeğil mi millet?
Dialogue: 0,0:20:18.02,0:20:20.02,Default,,0,0,0,,Evet!
Dialogue: 0,0:20:20.65,0:20:22.97,Default,,0,0,0,,{\i1}Size güveniyorum çocuklar.{\i0}
Dialogue: 0,0:20:22.97,0:20:28.53,Default,,0,0,0,,{\i1}Bacağım iyileştiği gibi yanınıza geleceğim.{\i0}
Dialogue: 0,0:20:31.54,0:20:38.29,Default,,0,0,0,,{\i1}Öte yandan 3. gruptaki Hokkai takımı\NFurano, takım oyunu ile...{\i0}
Dialogue: 0,0:20:38.29,0:20:41.13,Default,,0,0,0,,{\i1}...Nagano FC'yi 2-0 yenmişti.{\i0}
Dialogue: 0,0:20:41.13,0:20:45.63,Default,,0,0,0,,{\i1}4. gruptaki Musashi FC ile Jonan\Narasındaki maç devam ediyordu.{\i0}
Dialogue: 0,0:20:45.63,0:20:49.01,Default,,0,0,0,,{\i1}İşte yine Misugi-kun pası aldı.{\i0}
Dialogue: 0,0:20:49.98,0:20:51.43,Default,,0,0,0,,Misugi-san!
Dialogue: 0,0:20:51.43,0:20:54.60,Default,,0,0,0,,Bu da ne?! Tonla kız var burada!
Dialogue: 0,0:20:56.69,0:20:58.48,Default,,0,0,0,,{\i1}Dahice bir çalım!{\i0}
Dialogue: 0,0:20:59.29,0:21:01.07,Default,,0,0,0,,{\i1}Harika bir denge!{\i0}
Dialogue: 0,0:21:02.22,0:21:06.41,Default,,0,0,0,,{\i1}Misugi-kun'un yetenek fışkıran oyunlarını\Nseyirci nefessiz izliyor!{\i0}
Dialogue: 0,0:21:07.00,0:21:10.83,Default,,0,0,0,,{\i1}Tsubasa-kun, maç yapacağımız\Nzamanı iple çekiyorum!{\i0}
Dialogue: 0,0:21:11.48,0:21:13.37,Default,,0,0,0,,{\i1}Misugi Jun.{\i0}
Dialogue: 0,0:21:15.23,0:21:16.35,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:21:16.35,0:21:20.21,Default,,0,0,0,,{\i1}Musashi FC, ilk yarı başlayalı\N6 dakika olmuşken 5 gol attı!{\i0}
Dialogue: 0,0:21:20.21,0:21:22.09,Default,,0,0,0,,İşte bizim kaptan!
Dialogue: 0,0:21:26.35,0:21:29.84,Default,,0,0,0,,{\i1}Kojiro'dan sonra Misugi-kun var.{\i0}
Dialogue: 0,0:21:29.84,0:21:32.87,Default,,0,0,0,,{\i1}Asıl turnuvada karşılaşacağımız\Nbaşka bir rakip.{\i0}
Dialogue: 0,0:21:32.87,0:21:39.23,Default,,0,0,0,,{\i1}Misugi Jun. Musashi FC'yi yenmediğimiz\Nsürece şampiyon olamayız.{\i0}
Dialogue: 0,0:21:43.83,0:21:48.78,Default,,0,0,0,,{\i1}Uzun şutum gol olmalıydı.{\i0}
Dialogue: 0,0:21:51.71,0:21:57.66,Default,,0,0,0,,{\t(5550,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Ama zar zor dokunarak\Nyönünü değiştirdi.{\i0}
Dialogue: 0,0:21:57.71,0:22:05.20,Default,,0,0,0,,{\i1}O son çekişmede de tamamen kaybettim.{\i0}
Dialogue: 0,0:22:05.20,0:22:07.05,Default,,0,0,0,,Sen Hyuga Kojiro-kun'sun değil mi?
Dialogue: 0,0:22:08.57,0:22:11.05,Default,,0,0,0,,Yetenek avcısı olarak geldim.
Dialogue: 0,0:22:11.48,0:22:13.42,Default,,0,0,0,,Yetenek avcısı mı?
Dialogue: 0,0:22:13.42,0:22:17.72,Default,,0,0,0,,Evet. Toho Akademisi'ne gelmen için.
Dialogue: 0,0:22:17.81,0:22:20.37,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:23:50.07,0:24:00.64,Default,,0,0,0,,Gelecek 16. Bölümde:\NAkrobatik Futbol
