Dialogue: 0,0:11:52.00,0:11:57.00,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:00.31,0:00:03.04,Default,,0,0,0,,{\fad(500,100)\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}Haziran, Nankatsu Ortaokulu
Dialogue: 0,0:00:00.78,0:00:05.40,Default - Top,,0,0,0,,{\an8}Hora! Hora! Nankatsu!
Dialogue: 0,0:00:06.01,0:00:08.87,Default,,0,0,0,,{\i1}Nankatsu Ortaokulu.{\i0}
Dialogue: 0,0:00:08.87,0:00:11.90,Default,,0,0,0,,{\i1}Kısa bir süre önce normal\Nbir ortaokul olan Nankatsu Ortaokulu...{\i0}
Dialogue: 0,0:00:11.90,0:00:17.32,Default,,0,0,0,,{\i1}...şimdi tutkulu genç futbolcuların\Ntoplandığı bir yer.{\i0}
Dialogue: 0,0:00:18.20,0:00:24.04,Default,,0,0,0,,{\i1}Nankatsu Ortaokulu'na giren Tsubasa,\Nkısa sürede futbol kulübünün yıldızı oldu ve...{\i0}
Dialogue: 0,0:00:24.04,0:00:31.25,Default,,0,0,0,,{\i1}...Nankatsu SC'den arkadaşlarıyla birlikte\NUlusal Bölge Turnuvası'nı arka arkaya iki kez kazandı.{\i0}
Dialogue: 0,0:00:31.25,0:00:36.30,Default,,0,0,0,,{\i1}Şimdi de ortaokulun son yazına giriyor.{\i0}
Dialogue: 0,0:00:37.35,0:00:38.23,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:00:38.23,0:00:39.72,Default,,0,0,0,,Aptal! Ne yapıyorsun?!
Dialogue: 0,0:00:39.72,0:00:42.30,Default,,0,0,0,,Ishizaki-kun, öbür tarafı sana bırakıyorum!
Dialogue: 0,0:00:42.30,0:00:45.06,Default,,0,0,0,,Eğlenceli olacaktı bir de!
Dialogue: 0,0:00:45.06,0:00:49.31,Default,,0,0,0,,{\pos(960,938)}Hisami Sugimoto
Dialogue: 0,0:00:45.06,0:00:49.31,Default - Top,,0,0,0,,{\an8}Tsubasa-senpai, tüm defans işini\NIshizaki-san'a bırakamazsınız!
Dialogue: 0,0:00:49.31,0:00:50.44,Default,,0,0,0,,Hey oradaki!
Dialogue: 0,0:00:50.44,0:00:51.94,Default,,0,0,0,,Seni duyuyorum birinci sınıf bebe!
Dialogue: 0,0:00:52.85,0:00:54.38,Default,,0,0,0,,Öyle değil.
Dialogue: 0,0:00:54.38,0:00:55.70,Default,,0,0,0,,Ne?
Dialogue: 0,0:00:55.70,0:01:00.74,Default,,0,0,0,,Tsubasa-kun artık forvet yerine\Norta saha oynuyor.
Dialogue: 0,0:01:00.74,0:01:01.91,Default,,0,0,0,,Pardon?
Dialogue: 0,0:01:01.91,0:01:03.91,Default,,0,0,0,,{\pos(940,930)}Yukari Nishimoto
Dialogue: 0,0:01:01.91,0:01:04.84,Default - Top,,0,0,0,,{\an8}Hiçbir şey bilmiyor musun sen ya?
Dialogue: 0,0:01:04.84,0:01:07.17,Default - Top,,0,0,0,,{\an8}Dur--. Acıyor Yukari-senpai.
Dialogue: 0,0:01:07.17,0:01:09.73,Default,,0,0,0,,Orta saha oyuncuları takımın çekirdeğidir.
Dialogue: 0,0:01:09.73,0:01:12.46,Default,,0,0,0,,Takımın kontrol kulesi olarak görev alırlar.
Dialogue: 0,0:01:12.46,0:01:17.72,Default,,0,0,0,,Bu yüzden sadece atakta değil\Nsavunmada da iyi olmaları gerekir.
Dialogue: 0,0:01:17.72,0:01:19.55,Default,,0,0,0,,Zorlu bir görev olmasına rağmen...
Dialogue: 0,0:01:19.55,0:01:23.76,Default,,0,0,0,,...takımın kaptanı Tsubasa-kun\Niçin en uygun pozisyon bence.
Dialogue: 0,0:01:26.14,0:01:28.42,Default - Top,,0,0,0,,{\an8}Tsubasa-senpai, bastır!{he aint gonna look at ya girl, he is all about balls}
Dialogue: 0,0:01:28.42,0:01:30.77,Default - Top,,0,0,0,,{\an8}Hadi, hadi! Gol at!
Dialogue: 0,0:01:28.19,0:01:30.77,Default,,0,0,0,,{\pos(960,838)}Futbol Kulübü Koçu\NTakeshi Furuoya
Dialogue: 0,0:01:37.40,0:01:39.03,Default,,0,0,0,,# Nankatsu vs Kida #
Dialogue: 0,0:01:39.03,0:01:42.28,Default,,0,0,0,,Nankatsu Ortaokulu cidden güçlü.
Dialogue: 0,0:01:42.28,0:01:45.12,Default,,0,0,0,,Ama bu sene Shizuoka Bölgesi'ni\Nbiz temsil edeceğiz.
Dialogue: 0,0:01:45.12,0:01:50.58,Default,,0,0,0,,Evet, dördümüz ataklarını kestirip atacağız.
Dialogue: 0,0:01:50.58,0:01:56.66,Default,,0,0,0,,Ve zafer gollerimizi atan\Nsen olacaksın Nitta.
Dialogue: 0,0:01:56.66,0:01:58.46,Default,,0,0,0,,Biliyorum.
Dialogue: 0,0:01:58.46,0:02:00.68,Default,,0,0,0,,Bir gol de atarım iki gol de.
Dialogue: 0,0:02:01.36,0:02:09.07,Default,,0,0,0,,Sonuçta sizin yokluğunuzda\NNankatsu SC'yi şampiyonluğa taşıyan bendim.
Dialogue: 0,0:03:40.53,0:03:45.53,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(108,810.333)}Bölüm 29:\NYazın Başlangıcı!
Dialogue: 0,0:03:40.53,0:03:45.53,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\xbord4.5\blur1\b1\fs70\pos(1524,1026.333)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:03:41.02,0:03:45.40,Default - Top,,0,0,0,,{\an8}Ozora Tsubasa-kun, şimdiye kadarki olanlar\Ngibi harika bir performanstı.
Dialogue: 0,0:03:45.40,0:03:47.23,Default - Top,,0,0,0,,{\an8}Çok teşekkür ederim.
Dialogue: 0,0:03:45.71,0:03:48.24,Default,,0,0,0,,Soccer Eleven bile röportaja mı gelmiş?
Dialogue: 0,0:03:47.23,0:03:48.59,Default - Top,,0,0,0,,{\an8}Maçtan bahsedin biraz.
Dialogue: 0,0:03:48.59,0:03:50.00,Default - Top,,0,0,0,,{\an8}Pekala.
Dialogue: 0,0:03:48.24,0:03:51.07,Default,,0,0,0,,Her zamanki gibi çok popüler.
Dialogue: 0,0:03:51.07,0:03:52.67,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:03:52.67,0:03:56.25,Default,,0,0,0,,İlkbaharda bile liselilerle\Nantrenmanlara katılıyordu.
Dialogue: 0,0:03:56.25,0:04:00.05,Default,,0,0,0,,3 senede bize toz yutturdu resmen.
Dialogue: 0,0:04:00.05,0:04:00.96,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:00.96,0:04:02.46,Default,,0,0,0,,Ne diyorsunuz?
Dialogue: 0,0:04:02.46,0:04:05.47,Default,,0,0,0,,Futbol 11 kişilik bir mücadele oyunu değil mi?
Dialogue: 0,0:04:05.47,0:04:08.08,Default,,0,0,0,,Hepinizin gücü bu.
Dialogue: 0,0:04:08.08,0:04:11.43,Default,,0,0,0,,Tsubasa hiç değişmedi ama\Nsen çok değiştin.
Dialogue: 0,0:04:11.52,0:04:15.58,Default,,0,0,0,,Nankatsu Amigo Takımı başkanı...
Dialogue: 0,0:04:15.58,0:04:18.21,Default,,0,0,0,,...böyle bir hanımefendi oldu.
Dialogue: 0,0:04:18.21,0:04:21.28,Default,,0,0,0,,Nankatsu'dan gelenler için büyük şok gerçekten.
Dialogue: 0,0:04:21.28,0:04:22.97,Default,,0,0,0,,Öyle mi?!
Dialogue: 0,0:04:22.97,0:04:25.08,Default,,0,0,0,,Sanae-san, amigo takımı kaptanı mıydın?
Dialogue: 0,0:04:25.08,0:04:26.24,Default,,0,0,0,,Hiç beklemezdim!
Dialogue: 0,0:04:26.24,0:04:28.32,Default,,0,0,0,,Artık çok farklı birisi.
Dialogue: 0,0:04:28.32,0:04:31.49,Default,,0,0,0,,Aşk insanı değiştirir derler.
Dialogue: 0,0:04:31.49,0:04:33.20,Default,,0,0,0,,Ne?! Yoksa--
Dialogue: 0,0:04:33.98,0:04:35.14,Default,,0,0,0,,Ne diyorsunuz?
Dialogue: 0,0:04:35.14,0:04:36.21,Default,,0,0,0,,Yapmayın.
Dialogue: 0,0:04:36.21,0:04:38.47,Default,,0,0,0,,Ama çok bariz!
Dialogue: 0,0:04:38.47,0:04:42.21,Default,,0,0,0,,Çünkü Tsubasa-senpai çok havalı!
Dialogue: 0,0:04:42.21,0:04:44.54,Default,,0,0,0,,Peh! Tsubasa da Tsubasa!
Dialogue: 0,0:04:44.54,0:04:46.63,Default,,0,0,0,,Biz de varız Nankatsu Ortaokulu'nda.
Dialogue: 0,0:04:47.38,0:04:51.22,Default,,0,0,0,,Ishizaki'ye düşenin aklından şüphe ederim!{monozuki is actually, the one sucker for trouble?} {yeah I was about to say, she just jinxed it because she definitely is the one going after him later} {yep middle school arc is full of romance}
Dialogue: 0,0:04:51.22,0:04:52.31,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:04:52.31,0:04:53.94,Default,,0,0,0,,Bir daha söyle de göreyim!
Dialogue: 0,0:04:53.94,0:04:55.53,Default,,0,0,0,,Ne be?!
Dialogue: 0,0:04:57.06,0:05:01.58,Default,,0,0,0,,Yaz turnuvası için bölgesel\Nelemeler başlamak üzere, değil mi?
Dialogue: 0,0:05:01.58,0:05:03.14,Default,,0,0,0,,Duyguların nasıl?{how should I add "your enhusiasms!" god...}{something like what's your drive?}
Dialogue: 0,0:05:03.14,0:05:08.07,Default,,0,0,0,,Evet, her seneki gibi elimizden\Ngelenin en iyisini yapacağız.
Dialogue: 0,0:05:08.07,0:05:13.66,Default,,0,0,0,,Rakiplerinizin hepsi Nankatsu'nun\Nliderliğini bozmayı hedefliyor. {gotta give the emphasis on "we will get them this year arrrghhh" and I suck at that}{" like they've never been before"?}
Dialogue: 0,0:05:13.66,0:05:18.27,Default,,0,0,0,,Toho Akademisi'nden Hyuga Kojiro-kun'un\Nilkokuldaki eski partneri...
Dialogue: 0,0:05:18.27,0:05:21.54,Default,,0,0,0,,...Sawada Takeshi-kun da bu sene\Nkatılım sağlayacak.
Dialogue: 0,0:05:21.54,0:05:23.44,Default,,0,0,0,,Hokkaido'dan Furano Ortaokulu...
Dialogue: 0,0:05:23.44,0:05:27.80,Default,,0,0,0,,...kaptanları Matsuyama-kun liderliğinde her\Nzamankinden daha çok takım çalışmasına önem veriyor.
Dialogue: 0,0:05:27.80,0:05:30.07,Default,,0,0,0,,Tachibana İkizlerin bulunduğu Hanawa Ortaokulu...
Dialogue: 0,0:05:30.07,0:05:33.35,Default,,0,0,0,,...ve Camdan Yıldız Oyuncu\NMisugi-kun'un bulunduğu Musashi Ortaokulu da...
Dialogue: 0,0:05:33.35,0:05:37.11,Default,,0,0,0,,....bu sene Nankatsu Ortaokulu'nun\Ngalibiyet serisini bozmak istiyor.
Dialogue: 0,0:05:37.11,0:05:38.60,Default,,0,0,0,,Ben de bunu isterdim.
Dialogue: 0,0:05:38.60,0:05:40.86,Default,,0,0,0,,Kaybetmeyi planlamıyoruz.
Dialogue: 0,0:05:40.86,0:05:42.56,Default,,0,0,0,,Çok teşekkür ederiz.
Dialogue: 0,0:05:42.56,0:05:45.15,Default,,0,0,0,,Turnuvada iyi bir mücadele bekliyoruz.
Dialogue: 0,0:05:45.15,0:05:46.14,Default,,0,0,0,,Görüşürüz.
Dialogue: 0,0:05:46.14,0:05:47.72,Default,,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:05:48.92,0:05:49.86,Default,,0,0,0,,{\i1}Evet.{\i0}
Dialogue: 0,0:05:50.46,0:05:53.63,Default,,0,0,0,,{\i1}Hyuga-kun, Misugi-kun ve diğerleri...{\i0}
Dialogue: 0,0:05:53.63,0:05:55.25,Default,,0,0,0,,{\i1}Hepsi elinden geleni yapacak.{\i0}
Dialogue: 0,0:05:57.72,0:06:01.73,Default,,0,0,0,,{\i1}Ama Misaki-kun...\NŞu an ne durumdasın acaba?{\i0}
Dialogue: 0,0:06:01.73,0:06:04.75,Default,,0,0,0,,{\i1}O zamandan beri yıllarca görüşemedik.{\i0}
Dialogue: 0,0:06:05.49,0:06:08.84,Default,,0,0,0,,{\i1}Ve de Roberto...{\i0}
Dialogue: 0,0:06:13.63,0:06:18.81,Default,,0,0,0,,{\i1}Sen gittikten sonra dediğin gibi\Nforvetten orta sahaya geçtim.{\i0}
Dialogue: 0,0:06:18.81,0:06:22.27,Default,,0,0,0,,{\i1}Bıraktığın defterdeki talimatlara uydum.{\i0} {I did what your teachings in the note you left told me}
Dialogue: 0,0:06:22.27,0:06:27.44,Default,,0,0,0,,{\i1}Yeni hareketler öğrendim ve\Nkondisyonumu arttırdım.{\i0}
Dialogue: 0,0:06:27.44,0:06:32.48,Default,,0,0,0,,{\i1}Tekniklerini öğrenip özümsemek...{\i0}
Dialogue: 0,0:06:32.48,0:06:34.70,Default,,0,0,0,,{\i1}...beni Brezilya'ya daha tutkulu yaptı.{\i0} {plot twist, he aims for that samba booties}
Dialogue: 0,0:06:35.43,0:06:40.25,Default,,0,0,0,,{\i1}Futbol ülkesi Brezilya'ya gitme\Nhayalim gittikçe alevleniyor.{\i0}
Dialogue: 0,0:06:42.25,0:06:48.22,Default - Top,,0,0,0,,{\an8\i1}Queria falar mais devagar que disse? Manda vir um taxi.{\i0}
Dialogue: 0,0:06:45.84,0:06:49.13,Default,,0,0,0,,{\pos(964,842)}Tsubasa'nın Portekizce Öğretmeni\NCarlos
Dialogue: 0,0:06:48.22,0:06:49.48,Default - Top,,0,0,0,,{\an8\i1}Pronto!{\i0}
Dialogue: 0,0:06:49.48,0:06:52.34,Default - Top,,0,0,0,,{\an8}Tsubasa, telaffuzun gittikçe iyileşiyor.
Dialogue: 0,0:06:52.34,0:06:53.70,Default,,0,0,0,,Gerçekten mi?
Dialogue: 0,0:06:54.35,0:06:56.16,Default,,0,0,0,,Nereye gidiyorsun Carlos?{damn he can't stand a brazilian guy leaving him, that trauma}{kek}
Dialogue: 0,0:06:56.16,0:06:58.60,Default,,0,0,0,,Kısa bir tuvalet molası.
Dialogue: 0,0:06:58.60,0:07:00.85,Default,,0,0,0,,"{\i1}Retrete{\i0}" değil mi?
Dialogue: 0,0:07:02.16,0:07:03.65,Default,,0,0,0,,Carlos.
Dialogue: 0,0:07:03.65,0:07:07.32,Default,,0,0,0,,Tsubasa'nın Portekizce dersi nasıl gidiyor?
Dialogue: 0,0:07:07.32,0:07:11.99,Default,,0,0,0,,Gördüğüm kadarıyla konuşma\Nkonusunda sıkıntı çekmiyor.
Dialogue: 0,0:07:11.99,0:07:13.72,Default,,0,0,0,,Çok iyi, çok.
Dialogue: 0,0:07:13.72,0:07:15.26,Default,,0,0,0,,Endişeye gerek yok.
Dialogue: 0,0:07:15.26,0:07:18.20,Default,,0,0,0,,Ama ailesi olarak sorun etmeyecek misiniz?
Dialogue: 0,0:07:18.20,0:07:19.38,Default,,0,0,0,,Ne?
Dialogue: 0,0:07:19.38,0:07:22.72,Default,,0,0,0,,Tsubasa'yı gerçekten\NBrezilya'ya göndermeyi mi planlıyorsunuz?
Dialogue: 0,0:07:22.72,0:07:24.93,Default,,0,0,0,,Biricik oğlunuz sonuçta.
Dialogue: 0,0:07:26.16,0:07:28.21,Default,,0,0,0,,Kararımızı çoktan verdik.
Dialogue: 0,0:07:28.21,0:07:33.23,Default,,0,0,0,,Ulusal Futbol Federasyonu'ndaki\Nkişiler de yardımcı olacak.
Dialogue: 0,0:07:33.23,0:07:37.30,Default,,0,0,0,,Muhtemelen ortaokuldan mezun\Nolduktan sonra hemen göndereceğiz.
Dialogue: 0,0:07:38.04,0:07:45.86,Default,,0,0,0,,Ama bundan önce Japonya'daki son yazını pişman\Nolmayacağı şekilde geçirmesini istiyoruz Tsubasa'nın.
Dialogue: 0,0:07:45.86,0:07:48.23,Default,,0,0,0,,# Mutlak 3. Turnuva Galibiyeti! #
Dialogue: 0,0:07:50.32,0:07:52.44,Default,,0,0,0,,Sonunda duyurdular.
Dialogue: 0,0:07:52.44,0:07:55.74,Default,,0,0,0,,Bölgesel eleme eşleşmeleri.
Dialogue: 0,0:07:57.03,0:08:01.16,Default,,0,0,0,,Seri başı olduğumuz için\Nikinci tura kadar oynayamayacağız demek.
Dialogue: 0,0:08:01.16,0:08:03.34,Default,,0,0,0,,Sonuç hep aynı olacak zaten.
Dialogue: 0,0:08:03.34,0:08:06.79,Default,,0,0,0,,Bu bölgede bizi yenebilecek takım yok ki!
Dialogue: 0,0:08:06.79,0:08:10.63,Default,,0,0,0,,Sensei, Otomo Ortaokulu\Nöbür seride değil mi?
Dialogue: 0,0:08:10.63,0:08:13.30,Default,,0,0,0,,Evet, onlarla sadece finalde oynayabiliriz.
Dialogue: 0,0:08:13.30,0:08:18.68,Default,,0,0,0,,Otomo; Urabe, Kishida,\NNakayama ve Nishio'nun olduğu takım değil mi?{bunch of traitors}
Dialogue: 0,0:08:18.68,0:08:21.64,Default,,0,0,0,,Söylentilere göre bu sene\Nbayağı güçlenmişler.{The rumors tells that they got a boost to their squad this year too.}
Dialogue: 0,0:08:21.64,0:08:23.78,Default,,0,0,0,,Neyden korkuyorsunuz be?
Dialogue: 0,0:08:23.78,0:08:25.63,Default,,0,0,0,,Bu kadar endişeleniyorsanız...
Dialogue: 0,0:08:25.63,0:08:28.58,Default,,0,0,0,,...antrenman maçı yapıp\Ngünlerini gösterelim.
Dialogue: 0,0:08:28.58,0:08:31.72,Default,,0,0,0,,Antrenman maçı isteğimizi reddetmişlerdi.
Dialogue: 0,0:08:31.72,0:08:32.49,Default,,0,0,0,,Ne?
Dialogue: 0,0:08:32.49,0:08:36.03,Default,,0,0,0,,Yani bize ellerini göstermek istemiyorlar henüz.
Dialogue: 0,0:08:36.03,0:08:37.11,Default,,0,0,0,,Evet.
Dialogue: 0,0:08:37.11,0:08:41.55,Default,,0,0,0,,Bu bile Nankatsu'yu yenmeye ne kadar\Nhevesli olduklarını göstermeye yeter.
Dialogue: 0,0:08:41.55,0:08:43.67,Default,,0,0,0,,Rakibimiz kim olursa olsun kazanmalıyız.
Dialogue: 0,0:08:43.67,0:08:46.31,Default,,0,0,0,,Bölgeler elemelere dikkatimizi vereceğiz!
Dialogue: 0,0:08:46.31,0:08:47.33,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:47.33,0:08:51.25,Default,,0,0,0,,# Nankatsu Belediyesi - Nankatsu Ortaokulu #
Dialogue: 0,0:08:54.26,0:08:55.40,Default,,0,0,0,,Tamamdır, hadi!
Dialogue: 0,0:08:55.40,0:08:56.83,Default,,0,0,0,,Bir gol daha!
Dialogue: 0,0:08:57.47,0:09:00.64,Default,,0,0,0,,Şuradan izleyen kişiler\NUrabe'ler değil mi?
Dialogue: 0,0:09:01.08,0:09:02.79,Default,,0,0,0,,Evet, Otomo Ortaokulu.
Dialogue: 0,0:09:02.79,0:09:04.64,Default,,0,0,0,,Bilgi almaya gelmiş gibiler.
Dialogue: 0,0:09:04.64,0:09:06.25,Default,,0,0,0,,Yakala Ishizaki.
Dialogue: 0,0:09:06.25,0:09:07.44,Default,,0,0,0,,Uzaklaştırma!
Dialogue: 0,0:09:08.16,0:09:08.94,Default,,0,0,0,,Maç bitti!
Dialogue: 0,0:09:12.86,0:09:15.44,Default,,0,0,0,,Hey! Uzun zaman oldu millet.
Dialogue: 0,0:09:15.44,0:09:17.44,Default,,0,0,0,,Bir zahmet topu atsanıza.
Dialogue: 0,0:09:17.44,0:09:19.44,Default,,0,0,0,,İstiyorsan kendin al.
Dialogue: 0,0:09:19.44,0:09:20.95,Default,,0,0,0,,N-Ne?!
Dialogue: 0,0:09:20.95,0:09:22.78,Default,,0,0,0,,Artık rakibiz.
Dialogue: 0,0:09:22.78,0:09:24.62,Default,,0,0,0,,Ne kadar dost canlısı tavırlar bunlar.{need better word}
Dialogue: 0,0:09:24.62,0:09:25.94,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:09:25.94,0:09:30.45,Default,,0,0,0,,Tek yaptığınız korkup bizden\Nkaçmakken bu kadar ahkam kesmeyin!
Dialogue: 0,0:09:30.45,0:09:32.50,Default,,0,0,0,,Ne cüretle gelip saçmalıyorsunuz?!
Dialogue: 0,0:09:32.50,0:09:35.33,Default,,0,0,0,,Aslında sizden kaçmıyoruz.
Dialogue: 0,0:09:35.33,0:09:40.38,Default,,0,0,0,,Sadece Nankatsu'nun kazanma serisini\Nantrenman maçında bozmak hiç ilgi çekici durmuyor!{edge is real, edgelord urabe}
Dialogue: 0,0:09:40.38,0:09:43.51,Default,,0,0,0,,Bunu bölge turnuvasında yapmayı tercih ederiz!
Dialogue: 0,0:09:44.66,0:09:45.93,Default,,0,0,0,,Hadi ama.
Dialogue: 0,0:09:45.93,0:09:50.53,Default,,0,0,0,,İkiniz de eski takım arkadaşısınız.
Dialogue: 0,0:09:50.53,0:09:52.44,Default,,0,0,0,,Bu kadar çatışmaya gerek yok.
Dialogue: 0,0:09:52.44,0:09:55.44,Default,,0,0,0,,Gücümüzü gösterelim!
Dialogue: 0,0:09:57.24,0:09:59.20,Default,,0,0,0,,Tsubasa, top geliyor!
Dialogue: 0,0:10:01.49,0:10:03.01,Default,,0,0,0,,Tamamdır, gidelim!
Dialogue: 0,0:10:10.74,0:10:11.75,Default,,0,0,0,,Bu hareketler...
Dialogue: 0,0:10:11.75,0:10:14.30,Default,,0,0,0,,Avının peşindeki köpek balıkları gibiler!
Dialogue: 0,0:10:14.30,0:10:16.05,Default,,0,0,0,,Kim bunlar?
Dialogue: 0,0:10:16.05,0:10:20.84,Default,,0,0,0,,Urabe-kun, Kishida-kun,\NNishio-kun ve Nakayama-kun bile...
Dialogue: 0,0:10:20.84,0:10:23.92,Default,,0,0,0,,Koç, durdurmanızda bir mahsur yok mu?{they arent real sharks bud}
Dialogue: 0,0:10:25.71,0:10:27.73,Default,,0,0,0,,Hey, ne oldu Tsubasa?
Dialogue: 0,0:10:30.55,0:10:32.44,Default,,0,0,0,,Tsubasa'dan topu aldılar!
Dialogue: 0,0:10:32.44,0:10:33.37,Default,,0,0,0,,İmkansız!
Dialogue: 0,0:10:33.37,0:10:34.57,Default,,0,0,0,,Dörde tek olmalarına rağmen...
Dialogue: 0,0:10:34.57,0:10:35.93,Default,,0,0,0,,...Tsubasa'dan topu aldılar!
Dialogue: 0,0:10:35.93,0:10:36.60,Default,,0,0,0,,Nitta!
Dialogue: 0,0:10:37.28,0:10:38.03,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:39.16,0:10:39.86,Default,,0,0,0,,{\i1}Hızlı.{\i0}
Dialogue: 0,0:10:39.86,0:10:41.53,Default,,0,0,0,,{\i1}Kaba hareketler ama...{\i0}
Dialogue: 0,0:10:41.98,0:10:42.78,Default,,0,0,0,,Morisaki!
Dialogue: 0,0:10:45.11,0:10:48.08,Default,,0,0,0,,Hadi! Şahin Vuruşu!{EDITOR NOTE: From now on, "Hayabusa Shot" should always be T/L as "Falcon Shot"}
Dialogue: 0,0:10:54.31,0:10:56.09,Default,,0,0,0,,Ne?!{omae wa mou gooru sarete iru}
Dialogue: 0,0:10:58.58,0:11:02.74,Default,,0,0,0,,Gördünüz mü Nankatsu?!\NBizim gücümüz bu işte!
Dialogue: 0,0:11:02.74,0:11:04.14,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:11:04.14,0:11:06.01,Default,,0,0,0,,Aynen öyle!
Dialogue: 0,0:11:06.01,0:11:10.14,Default,,0,0,0,,Bu sene ulusal turnuvaya katılacak\Ntakım Otomo Ortaokulu!
Dialogue: 0,0:11:14.07,0:11:17.23,Default,,0,0,0,,Tsubasa, bu kadar yüzünü asma.
Dialogue: 0,0:11:17.23,0:11:23.10,Default,,0,0,0,,Sonuçta ulusal şampiyon olan\NNankatsu SC oyuncuları.
Dialogue: 0,0:11:23.10,0:11:24.02,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:24.02,0:11:26.74,Default,,0,0,0,,Ama çok güçlenmişler.
Dialogue: 0,0:11:26.74,0:11:30.29,Default - Top,,0,0,0,,{\an8}Elemelerde bile gardımızı düşüremeyiz.
Dialogue: 0,0:11:27.52,0:11:31.16,Default,,0,0,0,,{\i1}Hızlarının eskisi gibi olmadığı aşikar.{\i0}
Dialogue: 0,0:11:30.29,0:11:33.22,Default - Top,,0,0,0,,{\an8}Hem kaybetmemiz imkansız.
Dialogue: 0,0:11:31.16,0:11:34.50,Default,,0,0,0,,{\i1}Ama topu almalarının tek sebebi bu değildi.{\i0}
Dialogue: 0,0:11:34.97,0:11:36.50,Default,,0,0,0,,{\i1}Vurduğu o top...{\i0}
Dialogue: 0,0:11:36.50,0:11:40.42,Default,,0,0,0,,{\t(3030,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Karşıladığım zaman bacağım uyuştu.{\i0}
Dialogue: 0,0:11:41.03,0:11:43.76,Default,,0,0,0,,{\i1}O maçtan beri hiç olmamıştı bu.{\i0}
Dialogue: 0,0:11:45.73,0:11:47.80,Default,,0,0,0,,{\i1}Adına Nitta demişlerdi değil mi?{\i0}
Dialogue: 0,0:11:47.80,0:11:49.69,Default,,0,0,0,,{\i1}Kimin nesi tam olarak?{\i0}
Dialogue: 0,0:11:58.12,0:11:59.53,Default,,0,0,0,,Nitta Shun.
Dialogue: 0,0:11:59.53,0:12:03.70,Default,,0,0,0,,Nankatsu SC'nin kurtarıcısı diyebilirim.
Dialogue: 0,0:12:04.22,0:12:05.45,Default,,0,0,0,,Kurtarıcı mı?
Dialogue: 0,0:12:05.45,0:12:06.80,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:12:06.80,0:12:11.12,Default,,0,0,0,,Nitta, 100 metreyi 11 saniyede koşacak kadar hızlı.
Dialogue: 0,0:12:11.12,0:12:13.90,Default,,0,0,0,,Ayrıca bacakları da çok esnek.{bane is spring, like flexibility I guess, what does french say?}
Dialogue: 0,0:12:13.90,0:12:16.86,Default,,0,0,0,,Özel hareketi Şahin Vuruşu denilen bir vuruş...
Dialogue: 0,0:12:16.86,0:12:19.11,Default,,0,0,0,,...ve de esnekliğinden kaynaklı.
Dialogue: 0,0:12:19.11,0:12:21.16,Default,,0,0,0,,Çok keskin bir vuruştur.
Dialogue: 0,0:12:21.16,0:12:23.22,Default,,0,0,0,,Evet, ben de şaşırdım.
Dialogue: 0,0:12:23.22,0:12:26.80,Default,,0,0,0,,Ayrıca çok yürekli oynadığını söylüyorlar.
Dialogue: 0,0:12:26.80,0:12:31.71,Default,,0,0,0,,Üst sınıfı Sawada Takeshi,\NMeiwa FC'de olmasına rağmen onları yenip...{what is the first word here}
Dialogue: 0,0:12:31.71,0:12:37.23,Default,,0,0,0,,...siz Nankatsu SC'den mezun olduktan\Nsonra onları şampiyonluğa taşıdı.
Dialogue: 0,0:12:37.23,0:12:42.25,Default,,0,0,0,,Açıkçası bu sene ulusal turnuvaya\Nkatılmak o kadar kolay olmayacak.
Dialogue: 0,0:12:42.25,0:12:43.12,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:43.12,0:12:45.61,Default,,0,0,0,,Şey, Ozora Tsubasa-san mısınız?
Dialogue: 0,0:12:45.61,0:12:47.82,Default,,0,0,0,,Antrenmanımızı izleyebilir misiniz?
Dialogue: 0,0:12:47.82,0:12:51.79,Default,,0,0,0,,Biz de sizin gibi şut\Nçekmek istiyoruz Tsubasa-san!
Dialogue: 0,0:12:51.79,0:12:53.95,Default,,0,0,0,,Elbette, seve seve.{i hate the literal tl of "if you're okay with me"}
Dialogue: 0,0:12:53.95,0:12:56.00,Default,,0,0,0,,Otomo Takımı! Bastırın!
Dialogue: 0,0:12:56.00,0:12:56.48,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:56.48,0:12:56.84,Default,,0,0,0,,Bastırın!
Dialogue: 0,0:12:56.84,0:12:57.28,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:57.28,0:12:57.64,Default,,0,0,0,,Bastırın!
Dialogue: 0,0:12:57.64,0:12:58.13,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:58.13,0:12:58.48,Default,,0,0,0,,Bastırın!
Dialogue: 0,0:12:58.48,0:12:59.26,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:59.26,0:13:01.05,Default,,0,0,0,,Hey Urabe, şuna bak.
Dialogue: 0,0:13:01.05,0:13:01.75,Default,,0,0,0,,Ne?
Dialogue: 0,0:13:01.75,0:13:02.80,Default,,0,0,0,,İşte!
Dialogue: 0,0:13:06.39,0:13:08.05,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:08.70,0:13:09.64,Default,,0,0,0,,Urabe!
Dialogue: 0,0:13:09.64,0:13:12.13,Default,,0,0,0,,Turnuvaya bu kadar az kalmışken...
Dialogue: 0,0:13:12.13,0:13:14.64,Default,,0,0,0,,...çocuklarla oynayacak vaktin\Nolduğuna emin misin?
Dialogue: 0,0:13:14.64,0:13:18.00,Default,,0,0,0,,Dün ne kadar güçlü olduğumuzu gösterdik...
Dialogue: 0,0:13:18.00,0:13:20.06,Default,,0,0,0,,...ama bakıyorum da hala rahatsın!{you didn't react etc.}
Dialogue: 0,0:13:20.65,0:13:22.06,Default,,0,0,0,,İzle de gör Tsubasa!
Dialogue: 0,0:13:22.06,0:13:27.57,Default,,0,0,0,,Bölgesel turnuvada\No kalkmış burnunu indireceğiz!
Dialogue: 0,0:13:27.57,0:13:29.78,Default,,0,0,0,,Urabe, sözlerine dikkat et.
Dialogue: 0,0:13:29.78,0:13:31.45,Default,,0,0,0,,Pekala, gidelim.
Dialogue: 0,0:13:31.45,0:13:32.20,Default,,0,0,0,,Evet!
Dialogue: 0,0:13:35.33,0:13:37.92,Default,,0,0,0,,Sonucu şimdiden görebiliyorum.
Dialogue: 0,0:13:37.92,0:13:42.44,Default,,0,0,0,,Ama finallere kadar sabret Tsubasa-senpai.
Dialogue: 0,0:13:44.78,0:13:50.22,Default,,0,0,0,,2 yıldır her gün bu sahaya kadar koşuyorlar.
Dialogue: 0,0:13:50.22,0:13:50.89,Default,,0,0,0,,Ne?
Dialogue: 0,0:13:50.89,0:13:54.39,Default,,0,0,0,,Buradan Otomo Ortaokulu\Nyaklaşık 30 kilometre.
Dialogue: 0,0:13:54.39,0:13:57.89,Default,,0,0,0,,Rahat rahat koşabileceğin bir mesafe değil.
Dialogue: 0,0:13:57.89,0:14:01.80,Default,,0,0,0,,Otomo Ortaokulu'nun defansı bölgenin en iyisi.
Dialogue: 0,0:14:01.80,0:14:04.42,Default,,0,0,0,,Ama atak konusunda sıkıntıları vardı.{Here is your help <3}
Dialogue: 0,0:14:04.42,0:14:07.65,Default,,0,0,0,,Ne var ki bu sene Nitta'nın\Nkatılması kozları oldu.
Dialogue: 0,0:14:07.65,0:14:12.83,Default - Top,,0,0,0,,{\an8}Eksik son parça da tamamlandı
Dialogue: 0,0:14:11.57,0:14:12.83,Default,,0,0,0,,Otomo Ortaokulu
Dialogue: 0,0:14:20.62,0:14:23.17,Default,,0,0,0,,Yarın için sana güveniyorum dost.{great, now she has imaginary friends too I think she uses it as tomodachi-kun, like his friend}
Dialogue: 0,0:14:28.20,0:14:29.30,Default,,0,0,0,,{\i1}Aynen öyle!{\i0}
Dialogue: 0,0:14:29.30,0:14:31.68,Default,,0,0,0,,{\i1}Gardımızı indirmiştik.{\i0}
Dialogue: 0,0:14:31.68,0:14:35.26,Default,,0,0,0,,{\i1}Her zaman kazanacağımızı düşünüyorduk.{\i0}
Dialogue: 0,0:14:35.26,0:14:37.85,Default,,0,0,0,,{\i1}Çok kibirli davrandık.{\i0}
Dialogue: 0,0:14:37.85,0:14:43.86,Default,,0,0,0,,{\i1}Bu kibirden kurtulmanın tek yolu\Nantrenmandan başka bir şey değil!{\i0}
Dialogue: 0,0:14:43.86,0:14:47.11,Default,,0,0,0,,{\i1}Daha da güçlenip özgüvenimizi kazanmalıyız!{\i0}
Dialogue: 0,0:14:47.11,0:14:50.86,Default,,0,0,0,,{\i1}Başka yolu yok!{\i0} {felt like breaking it}
Dialogue: 0,0:14:56.44,0:14:57.87,Default,,0,0,0,,Buyur, havlu.
Dialogue: 0,0:14:57.87,0:14:59.37,Default,,0,0,0,,Menajer!{she has a name dammit}
Dialogue: 0,0:14:59.37,0:15:01.51,Default,,0,0,0,,Hadi sil terini.
Dialogue: 0,0:15:01.51,0:15:03.54,Default,,0,0,0,,Böylelikle daha çok çabalayabilirsin.
Dialogue: 0,0:15:04.88,0:15:06.38,Default,,0,0,0,,Tamamdır, hadi!
Dialogue: 0,0:15:09.28,0:15:12.30,Default,,0,0,0,,Şimdi 5 ve 4 kişilik takımlara\Nayrılıp mini bir maç yapacağız.
Dialogue: 0,0:15:12.95,0:15:15.62,Default,,0,0,0,,Hey Tsubasa. Biraz abartıyorsun.
Dialogue: 0,0:15:15.62,0:15:18.31,Default,,0,0,0,,Aynen öyle. Biraz dinlenelim.
Dialogue: 0,0:15:18.31,0:15:20.02,Default,,0,0,0,,Duymadınız mı?
Dialogue: 0,0:15:20.02,0:15:21.31,Default,,0,0,0,,5 ve 4 kişi.
Dialogue: 0,0:15:21.75,0:15:28.11,Default,,0,0,0,,Bölgesel turnuvalarda ve ulusal turnuvada\Nyaz güneşi altında oynamamız gerekecek.
Dialogue: 0,0:15:28.11,0:15:31.05,Default,,0,0,0,,Bu şekilde 3 kez kazanmamız imkansız.
Dialogue: 0,0:15:31.05,0:15:35.62,Default,,0,0,0,,Tamam da alt sınıfları da düşün biraz.
Dialogue: 0,0:15:35.62,0:15:37.62,Default,,0,0,0,,Hadi millet! 5'e 4!
Dialogue: 0,0:15:37.62,0:15:39.62,Default,,0,0,0,,L-Lan Tsubasa!
Dialogue: 0,0:15:39.62,0:15:41.12,Default,,0,0,0,,Durun ikiniz de!
Dialogue: 0,0:15:42.32,0:15:43.56,Default,,0,0,0,,Koç...
Dialogue: 0,0:15:43.56,0:15:48.61,Default,,0,0,0,,5 dakika aradan sonra 3. sınıflar\N1 ve 2. sınıflara karşı oynayacak.
Dialogue: 0,0:15:48.61,0:15:51.44,Default,,0,0,0,,Tsubasa, sen 1 ve 2. sınıflarla oyna.
Dialogue: 0,0:15:51.44,0:15:52.13,Default,,0,0,0,,Ne?!
Dialogue: 0,0:15:52.13,0:15:53.68,Default,,0,0,0,,Uygun mu Tsubasa?
Dialogue: 0,0:15:53.68,0:15:55.09,Default,,0,0,0,,Evet.
Dialogue: 0,0:15:56.12,0:15:59.51,Default,,0,0,0,,Tsubasa biraz fazla kafasına\Ntakmıyor mu sence?
Dialogue: 0,0:15:59.51,0:16:00.68,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:16:00.68,0:16:03.93,Default,,0,0,0,,Biz de elimizden gelenin\Nen iyisini yapmaya çalışıyoruz.
Dialogue: 0,0:16:03.93,0:16:05.15,Default,,0,0,0,,Gerçekten öyle mi?
Dialogue: 0,0:16:06.06,0:16:07.54,Default,,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:16:07.54,0:16:08.65,Default,,0,0,0,,Hiçbir şey.
Dialogue: 0,0:16:08.65,0:16:11.65,Default,,0,0,0,,Sadece gözleriniz farklı bakıyor.
Dialogue: 0,0:16:13.18,0:16:16.99,Default,,0,0,0,,Az önce Tsubasa'nın gözleri\Nhepinizden farklı bakıyordu.
Dialogue: 0,0:16:16.99,0:16:18.99,Default,,0,0,0,,Tsubasa-senpai!{Sanae she's stealing your man!}
Dialogue: 0,0:16:21.98,0:16:25.79,Default - Top,,0,0,0,,{\an8}- Millet, sakin olup acele etmeyin.\N- Tamam!
Dialogue: 0,0:16:23.00,0:16:25.79,Default,,0,0,0,,Lanet olsun! Gözleriniz farklı bakıyor da ne demek?!
Dialogue: 0,0:16:25.79,0:16:29.29,Default,,0,0,0,,Tsubasa olmadan da iyi mücadele\Nedebileceğimizi gösterelim!
Dialogue: 0,0:16:29.29,0:16:30.17,Default,,0,0,0,,Evet!
Dialogue: 0,0:16:31.21,0:16:32.84,Default,,0,0,0,,Geliyoruz Tsubasa!
Dialogue: 0,0:16:32.84,0:16:33.64,Default,,0,0,0,,Durdurun!
Dialogue: 0,0:16:33.64,0:16:34.42,Default,,0,0,0,,Tamam!
Dialogue: 0,0:16:35.30,0:16:36.22,Default,,0,0,0,,Havalanmayın!{nameru? nameru it is haha}
Dialogue: 0,0:16:40.47,0:16:44.52,Default,,0,0,0,,Izawa, top sürüşün hala yetersiz!
Dialogue: 0,0:16:44.52,0:16:45.44,Default,,0,0,0,,İşte!
Dialogue: 0,0:16:46.19,0:16:48.02,Default,,0,0,0,,T-Tamam.
Dialogue: 0,0:16:48.02,0:16:49.56,Default,,0,0,0,,Aldım!
Dialogue: 0,0:16:49.56,0:16:50.82,Default,,0,0,0,,Al Taki!
Dialogue: 0,0:16:51.69,0:16:54.31,Default,,0,0,0,,Tamamdır, çizgiye kadar süreceğim!
Dialogue: 0,0:16:54.31,0:16:54.95,Default,,0,0,0,,Taki!
Dialogue: 0,0:16:55.89,0:16:58.03,Default,,0,0,0,,Özel hareketine çok güveniyorsun!
Dialogue: 0,0:16:58.74,0:17:00.99,Default,,0,0,0,,Başka atak şekilleri de düşün!
Dialogue: 0,0:17:00.99,0:17:01.74,Default,,0,0,0,,Taki!
Dialogue: 0,0:17:01.74,0:17:04.16,Default,,0,0,0,,Kisugi! Etrafına bak!
Dialogue: 0,0:17:05.56,0:17:07.84,Default,,0,0,0,,Bu kadar kolay markaja alınırsan nasıl olacak?
Dialogue: 0,0:17:07.84,0:17:12.14,Default,,0,0,0,,Orta saha olacaksan daha hareketli ol\Nve kendine boş alan yarat!
Dialogue: 0,0:17:12.14,0:17:13.17,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:17:14.13,0:17:16.18,Default,,0,0,0,,Geliyoruz! Beni takip etin!
Dialogue: 0,0:17:16.18,0:17:16.93,Default,,0,0,0,,Evet!
Dialogue: 0,0:17:16.93,0:17:18.41,Default,,0,0,0,,Durduralım Takasugi!
Dialogue: 0,0:17:18.41,0:17:18.93,Default,,0,0,0,,Evet!
Dialogue: 0,0:17:20.67,0:17:21.31,Default,,0,0,0,,Lan--{and you used to be bffs}
Dialogue: 0,0:17:23.14,0:17:27.14,Default,,0,0,0,,Nankatsu kalesini korumak için\Nbu kadarı yeterli mi sizce defanstakiler?!{putting izen screws this sentence, hmmm}
Dialogue: 0,0:17:32.73,0:17:34.17,Default,,0,0,0,,Sen de Morisaki!
Dialogue: 0,0:17:34.17,0:17:37.87,Default,,0,0,0,,Wakabayashi olsa bu şutu\Ngöğsüyle durdururdu!
Dialogue: 0,0:17:40.76,0:17:42.53,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:17:50.00,0:17:51.54,Default,,0,0,0,,Tamamdır, yapalım şunu!
Dialogue: 0,0:17:51.54,0:17:52.88,Default,,0,0,0,,Şimdi başlıyoruz!
Dialogue: 0,0:17:52.88,0:17:54.44,Default,,0,0,0,,Bir daha gel bakalım Tsubasa!
Dialogue: 0,0:17:54.44,0:17:57.55,Default,,0,0,0,,Evet! Bir daha böyle\Nkolayca topu alamayacaksın!{silly boys, sanae's been polishing that thing hard, it will go to tsu}
Dialogue: 0,0:17:57.55,0:17:59.28,Default,,0,0,0,,Gelecek sefere seni durduracağız!
Dialogue: 0,0:17:59.28,0:18:00.26,Default,,0,0,0,,Millet...
Dialogue: 0,0:18:01.26,0:18:03.89,Default,,0,0,0,,N-Neler oluyor?{male bonding; you wouldn't understand, honey}
Dialogue: 0,0:18:03.89,0:18:04.88,Default,,0,0,0,,Yapalım şunu!
Dialogue: 0,0:18:04.88,0:18:05.39,Default,,0,0,0,,Evet!
Dialogue: 0,0:18:05.39,0:18:07.14,Default,,0,0,0,,Aynen öyle!
Dialogue: 0,0:18:07.14,0:18:09.74,Default,,0,0,0,,Yağmurdan sonra gökkuşağı ortaya çıkar.
Dialogue: 0,0:18:09.74,0:18:10.40,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:10.40,0:18:14.69,Default,,0,0,0,,Herkesin gözü, Tsubasa-kun'unki\Ngibi parlamaya başladı.
Dialogue: 0,0:18:14.69,0:18:17.09,Default,,0,0,0,,{\i1}Bunu gördükten sonra...{\i0}
Dialogue: 0,0:18:17.09,0:18:20.70,Default,,0,0,0,,{\i1}...Sanae-senpai ile aşık atamam.{\i0}
Dialogue: 0,0:18:30.34,0:18:31.63,Default,,0,0,0,,İyi misiniz?
Dialogue: 0,0:18:31.63,0:18:34.28,Default,,0,0,0,,Sadece cüsseden ibaret değilsin gerçekten.
Dialogue: 0,0:18:34.28,0:18:37.63,Default,,0,0,0,,Evet. Arkadaşın bayağı iyiymiş.
Dialogue: 0,0:18:37.63,0:18:38.82,Default,,0,0,0,,Değil mi?
Dialogue: 0,0:18:38.82,0:18:43.14,Default,,0,0,0,,Ichijo, Nankatsu'da şampiyon olduğum\Nsıradaki kalecimizdi.
Dialogue: 0,0:18:43.74,0:18:44.89,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:18:44.89,0:18:48.10,Default,,0,0,0,,Sen atak yaparken o kaleyi\Nkoruduğu için şampiyon oldunuz.{"omae wa seme" urabe is a fudanshi?}
Dialogue: 0,0:18:49.14,0:18:50.16,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:18:50.16,0:18:53.70,Default,,0,0,0,,Böylelikle Otomo Ortaokulu'nun\Nfutbolu mükemmel olmaya bir adım daha yakın!
Dialogue: 0,0:18:53.70,0:18:56.11,Default,,0,0,0,,Bu sene Nankatsu'yu alaşağı edeceğiz!
Dialogue: 0,0:18:58.87,0:19:02.26,Default,,0,0,0,,{\i1}Bugün Ulusal Ortaokul\NFutbol Turnuvası öncesi...{\i0}
Dialogue: 0,0:19:02.26,0:19:05.74,Default,,0,0,0,,{\i1}...Shizuoka Bölge Turnuvası'nın\Nbaşladığı gün.{\i0}
Dialogue: 0,0:19:05.74,0:19:07.59,Default,,0,0,0,,Geldi çattı.
Dialogue: 0,0:19:07.59,0:19:08.48,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:10.00,0:19:11.50,Default,,0,0,0,,# Wakabayashi Genzo - Mail #
Dialogue: 0,0:19:12.06,0:19:13.08,Default,,0,0,0,,Wakabayashi-kun!
Dialogue: 0,0:19:14.72,0:19:15.71,Default,,0,0,0,,Hey, dursana!
Dialogue: 0,0:19:15.71,0:19:18.86,Default,,0,0,0,,Tsubasa ve Nankatsu Ortaokulu'ndakiler.
Dialogue: 0,0:19:18.86,0:19:21.72,Default,,0,0,0,,Şu an Japonya'daki\Nelemeler başlamak üzere olmalı.
Dialogue: 0,0:19:21.72,0:19:24.74,Default,,0,0,0,,Ulusal Turnuvadaki 3. zaferiniz için\Nelinizden geleni yapın.{V3? lol}
Dialogue: 0,0:19:24.74,0:19:26.94,Default,,0,0,0,,Almanya'dan sizi destekliyor olacağım.
Dialogue: 0,0:19:26.94,0:19:29.44,Default,,0,0,0,,Eski Nankatsu SC kalecisi,
Dialogue: 0,0:19:29.44,0:19:31.23,Default,,0,0,0,,Wakabayashi Genzo.{why is the letter so fuckin formal? my dude just be like AYY LMAO Y'ALL FINNA WIN THIS SHIT? AAAAAAAAAAAAAYY TELL HYUGA HE SUCKS FOR ME K PEACE}
Dialogue: 0,0:19:31.23,0:19:34.69,Default,,0,0,0,,Wakabayashi-san hala bizi unutmamış.{this part needed Morisaki's girly screams}
Dialogue: 0,0:19:36.66,0:19:37.98,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:19:38.42,0:19:39.79,Default,,0,0,0,,Katagiri-san!
Dialogue: 0,0:19:39.79,0:19:41.15,Default,,0,0,0,,Uzun zaman oldu.
Dialogue: 0,0:19:41.15,0:19:44.74,Default,,0,0,0,,{\pos(996,846)}Japon Futbol Federasyonu\NKatagiri Munemasa
Dialogue: 0,0:19:41.15,0:19:44.74,Default - Top,,0,0,0,,{\an8}İlkbahardaki lise antrenmanlarından\Nberi görüşemedik değil mi?
Dialogue: 0,0:19:45.94,0:19:50.65,Default,,0,0,0,,Videolarından çoğunu Brezilya'daki\Nfutbol kulüplerine gönderdim.
Dialogue: 0,0:19:50.65,0:19:54.16,Default,,0,0,0,,Düşündüğüm gibi yeteneklerin\Nonları çok etkiledi.
Dialogue: 0,0:19:54.16,0:19:57.72,Default,,0,0,0,,Öyleyse mezun olduktan sonra\Nhemen Brezilya'ya gidebilecek miyim?
Dialogue: 0,0:19:57.72,0:19:58.25,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:58.25,0:20:00.38,Default,,0,0,0,,Ama onlar profesyonel kişiler.
Dialogue: 0,0:20:00.38,0:20:02.17,Default,,0,0,0,,Oynamanı direkt olarak görmedikleri sürece...
Dialogue: 0,0:20:02.17,0:20:04.76,Default,,0,0,0,,...seninle hemen kontrat imzalamayacaklardır.
Dialogue: 0,0:20:04.76,0:20:05.39,Default,,0,0,0,,Evet.
Dialogue: 0,0:20:05.39,0:20:08.64,Default,,0,0,0,,Şimdilik tüm dikkatini turnuvaya ver.
Dialogue: 0,0:20:08.64,0:20:10.64,Default,,0,0,0,,Brezilya konusunu sonra konuşuruz.{tsu knows better than to trust guys with sunglasses who keeps saying that, mister}
Dialogue: 0,0:20:11.28,0:20:13.64,Default,,0,0,0,,Kesinlikle kazan Tsubasa.{ooooOOOOOOoooo they only show one eye}
Dialogue: 0,0:20:14.72,0:20:17.94,Default,,0,0,0,,Önce Japonya'da efsane olacaksın.{SHOUNEN YO SHINWA NI NAREEEEE}
Dialogue: 0,0:20:17.94,0:20:19.86,Default,,0,0,0,,Arka arkaya üç şampiyonluk...
Dialogue: 0,0:20:19.86,0:20:24.20,Default,,0,0,0,,Hayır, ilkokulu da sayarsan 4 ediyor.
Dialogue: 0,0:20:23.70,0:20:29.49,Default - Top,,0,0,0,,# Shizuoka Bölge Ortaokul Turnuvası Şampiyonluğu #
Dialogue: 0,0:20:24.20,0:20:26.70,Default,,0,0,0,,Nankatsu'ya geleli 4 yıl oldu zaten.
Dialogue: 0,0:20:26.70,0:20:29.49,Default,,0,0,0,,Namağlup şekilde Brezilya'ya gideceksin.
Dialogue: 0,0:20:29.49,0:20:32.28,Default,,0,0,0,,Sonrasında Brezilya'da en tepeye çıkacaksın.
Dialogue: 0,0:20:32.28,0:20:37.97,Default,,0,0,0,,Orada bir numara olarak\NJapon futbolunu değiştireceksin!
Dialogue: 0,0:20:37.97,0:20:42.76,Default,,0,0,0,,Tsubasa, liderlik yaparak\Nbu ülkenin futbolunu değiştireceksin!
Dialogue: 0,0:20:42.76,0:20:44.01,Default,,0,0,0,,Evet!
Dialogue: 0,0:20:44.94,0:20:48.01,Default,,0,0,0,,Arka arkaya üç kez şampiyonluk kazanacağız!
Dialogue: 0,0:20:48.53,0:20:50.51,Default,,0,0,0,,Kimseye kaybetmeyeceğiz!
Dialogue: 0,0:20:53.70,0:20:56.32,Default,,0,0,0,,{\i1}Doğru ya. Aynen öyle.{\i0}
Dialogue: 0,0:20:58.52,0:21:02.53,Default,,0,0,0,,{\i1}Tsubasa-kun'la beraber olduğum\Nson sene bu.{\i0}
Dialogue: 0,0:21:04.26,0:21:06.53,Default,,0,0,0,,{\i1}Sonunda başlıyor.{\i0}
Dialogue: 0,0:21:06.53,0:21:09.49,Default,,0,0,0,,{\i1}Futbolun harman olduğu yer,\NShizuoka Bölgesel Futbol Turnuvası.{\i0} {soccerdokoro? what? soccer place <3}{soccer'in harman oldugu yer you know your stuff <3} {}
Dialogue: 0,0:21:09.49,0:21:11.74,Default,,0,0,0,,{\i1}Şampiyonluk flaması döndü.{\i0} {tsubasa's equivalent of "hold my beer"}
Dialogue: 0,0:21:11.74,0:21:17.00,Default,,0,0,0,,{\i1}Geçen seneki şampiyon, Kaptan Tsubasa\Nliderliğindeki Nankatsu Ortaokulu'ydu.{\i0}
Dialogue: 0,0:21:17.00,0:21:20.75,Default,,0,0,0,,{\i1}Ortaokula başladıktan sonra\Nyenilgi görmedi...{\i0}
Dialogue: 0,0:21:20.75,0:21:23.84,Default,,0,0,0,,{\i1}...ve 2 yıldır şampiyonluk\Nflamasını dalgalandırıyor.{\i0}
Dialogue: 0,0:21:23.84,0:21:28.64,Default,,0,0,0,,Ishizaki. Bu sene şampiyonluk\Nflamasını biz alacağız.
Dialogue: 0,0:21:28.64,0:21:30.79,Default,,0,0,0,,Ne zırvalıyorsun be?
Dialogue: 0,0:21:30.79,0:21:33.97,Default,,0,0,0,,Önce bir finallere çıkın da sonra konuşuruz.
Dialogue: 0,0:21:33.97,0:21:39.85,Default,,0,0,0,,Sizden daha çok gol atarak\Nfinallere ulaşacağız hem de.
Dialogue: 0,0:21:39.85,0:21:41.31,Default,,0,0,0,,Saçmalama be!
Dialogue: 0,0:21:41.31,0:21:42.94,Default,,0,0,0,,Kaybetmeyiz biz.
Dialogue: 0,0:21:42.94,0:21:44.61,Default,,0,0,0,,Tamam, iddiaya girelim o zaman!{i don't get what he says there}
Dialogue: 0,0:21:44.61,0:21:47.74,Default,,0,0,0,,Finallere kadar kimin daha çok\Ngol atacağının iddiası!
Dialogue: 0,0:21:47.74,0:21:50.95,Default,,0,0,0,,Kaybeden, kazanan ne derse desin yapacak!{silly urabe, that's how doujins start ahahaha dare game}
Dialogue: 0,0:21:50.95,0:21:52.99,Default,,0,0,0,,Bak şimdi ilgimi çektin!
Dialogue: 0,0:21:52.99,0:21:54.74,Default,,0,0,0,,Mücadeleye varım ben!
Dialogue: 0,0:21:54.74,0:21:55.50,Default,,0,0,0,,Urabe!
Dialogue: 0,0:21:55.50,0:21:56.71,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:21:57.98,0:22:00.59,Default,,0,0,0,,{\i1}Finallere kadar kazanmaya devam et.{\i0}
Dialogue: 0,0:22:00.59,0:22:03.44,Default,,0,0,0,,{\i1}Seni kesinlikle yeneceğim.{\i0}
Dialogue: 0,0:22:04.63,0:22:05.46,Default,,0,0,0,,Ne?!{you'll fall in love with him too, fang-kun}
Dialogue: 0,0:22:07.90,0:22:10.30,Default,,0,0,0,,{\i1}Gülecek kadar rahatsın demek.{\i0}
Dialogue: 0,0:22:10.90,0:22:16.47,Default,,0,0,0,,{\i1}Ama finallerde yüzünde endişeyi\Nve yenilgiyi göreceğim kesinlikle!{\i0} {i'll paint your face with..." sounds better, lol}
