Dialogue: 0,0:11:24.03,0:11:29.00,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:00:01.13,0:00:06.21,Default,,0,0,0,,{\i1}Nankatsu SC, turnuvada elemelere\Nçıkmak için...{\i0}
Dialogue: 0,0:00:06.21,0:00:08.86,Default,,0,0,0,,{\i1}....Hanawa Genç Futbol Takımı'nı\Nkesinlikle yenmeliydi.{\i0}
Dialogue: 0,0:00:08.86,0:00:13.94,Default,,0,0,0,,{\i1}Misaki ile koordine oyunu sayesinde\NTsubasa, açık bulup gol atmayı başarmıştı.{\i0}
Dialogue: 0,0:00:13.94,0:00:16.03,Default,,0,0,0,,{\i1}Ne var ki ikinci yarıda\Noyunun akışı değişmişti.{\i0}
Dialogue: 0,0:00:16.03,0:00:20.62,Default,,0,0,0,,{\i1}Tachibana Kardeşlerin kozu,\Nüçlü vuruş ortaya çıkmıştı!{\i0}
Dialogue: 0,0:00:20.62,0:00:24.41,Default,,0,0,0,,{\i1}Üstüne üstlük defans oyuncusu\NNishio bacağından yaralanmıştı.{\i0}
Dialogue: 0,0:00:24.41,0:00:28.63,Default,,0,0,0,,{\i1}{\i1}Nankatsu oyuncu değişikliği yapıyor.{\i0}{\i0}
Dialogue: 0,0:00:28.63,0:00:35.38,Default,,0,0,0,,{\i1}{\i1}3 numara Nishio-kun yerine\N14 numara Ishizaki-kun giriyor.{\i0}{\i0}
Dialogue: 0,0:00:35.38,0:00:36.51,Default,,0,0,0,,Ishizaki-kun!
Dialogue: 0,0:00:36.51,0:00:37.30,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:00:37.30,0:00:38.80,Default,,0,0,0,,Sana güveniyoruz Ishizaki!
Dialogue: 0,0:00:38.80,0:00:41.26,Default,,0,0,0,,Çocuklar, koçtan mesaj var.
Dialogue: 0,0:00:41.26,0:00:45.38,Default,,0,0,0,,Bu maçta berabere kalırsak\Nelemelere çıkamayacağız.
Dialogue: 0,0:00:45.38,0:00:49.90,Default,,0,0,0,,Bu yüzden Tsubasa ve Misaki\Nher zamanki gibi atak yapsın.
Dialogue: 0,0:00:50.87,0:00:53.78,Default,,0,0,0,,Tamamdır! Her şeyimizi kullanarak\Ngol atalım! Değil mi Misaki-kun?
Dialogue: 0,0:00:53.78,0:00:54.53,Default,,0,0,0,,Evet!
Dialogue: 0,0:00:54.53,0:00:57.92,Default,,0,0,0,,Masao, Kazuo! Böyle devam etme\Nkonusunda size güveniyoruz!
Dialogue: 0,0:00:57.92,0:00:58.61,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:00:58.61,0:01:01.20,Default,,0,0,0,,Siz defansı sıkı tutun!
Dialogue: 0,0:01:01.20,0:01:02.52,Default,,0,0,0,,Tsubasa-kun! Elinden geleni yap!
Dialogue: 0,0:01:02.52,0:01:06.39,Default,,0,0,0,,{\i1}Hanawa'nın beraberliği sağlamasıyla\Nişler ilginç bir hal aldı.{\i0}
Dialogue: 0,0:01:06.39,0:01:09.71,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvası\Ngrup aşamalarının son maçı...{\i0}
Dialogue: 0,0:01:09.71,0:01:15.97,Default,,0,0,0,,{\i1}...Nankatsu SC-Hanawa Genç Futbol Kulübü\Nmaçı Nankatsu top vuruşuyla devam edecek.{\i0}
Dialogue: 0,0:01:18.22,0:01:22.86,Default,,0,0,0,,{\i1}Nankatsu, oyun berabere olduktan\Nsonra düzenini değiştiriyor!{\i0}
Dialogue: 0,0:01:22.86,0:01:27.64,Default,,0,0,0,,{\i1}Tachibana Kardeşleri tutan Tsubasa-kun\Nve Misaki-kun ileri doğru çıkıyor!{\i0}
Dialogue: 0,0:01:27.64,0:01:29.21,Default,,0,0,0,,Tsubasa ve Misaki!
Dialogue: 0,0:01:29.21,0:01:31.15,Default,,0,0,0,,Onlar da atağa geliyor!
Dialogue: 0,0:01:31.15,0:01:34.67,Default,,0,0,0,,Tamamdır! İlerleyişlerini durduralım!
Dialogue: 0,0:01:34.67,0:01:35.57,Default,,0,0,0,,Tamam!
Dialogue: 0,0:01:35.57,0:01:41.57,Default,,0,0,0,,{\i1}Nankatsu'nun altın ikilisi Tsubasa-kun ve Misaki-kun,\NHanawa'nın sıkı defansını aşabilecek mi?{\i0}
Dialogue: 0,0:01:42.58,0:01:44.91,Default,,0,0,0,,{\i1}Yoksa Hanawa ilerleyişlerini kesecek mi?{\i0}
Dialogue: 0,0:01:45.62,0:01:48.98,Default,,0,0,0,,{\i1}Elemelere çıkan takım\NNankatsu mu Hanawa mı olacak?{\i0}
Dialogue: 0,0:01:48.98,0:01:52.04,Default,,0,0,0,,{\i1}Son gülen kim olacak?{\i0}
Dialogue: 0,0:03:22.51,0:03:27.54,Default,,0,0,0,,{\fad(500,500)\fs85\pos(276,822)}17. Bölüm
Dialogue: 0,0:03:22.51,0:03:27.54,Default,,0,0,0,,{\fad(500,500)\pos(728,914)}4 Dakika Kaldı!\NBelirleyici Hava Topu!
Dialogue: 0,0:03:22.51,0:03:27.54,Default,,0,0,0,,{\fad(500,500)\pos(1504,1021)}Çeviri: ARE-YOU-SURE\N{\fs65)}www.areyousuresubs.com
Dialogue: 0,0:03:28.26,0:03:31.54,Default,,0,0,0,,{\i1}Sol bacağımdaki ağrı geçti sayılır.{\i0}
Dialogue: 0,0:03:31.54,0:03:33.70,Default,,0,0,0,,{\i1}Böyleyken en azından bir maçlık...{\i0}
Dialogue: 0,0:03:33.70,0:03:34.81,Default,,0,0,0,,Genzo!
Dialogue: 0,0:03:34.81,0:03:37.51,Default,,0,0,0,,Nankatsu'ya yetiştiler.
Dialogue: 0,0:03:37.51,0:03:39.17,Default,,0,0,0,,Ne? Nasıl?
Dialogue: 0,0:03:39.17,0:03:40.78,Default,,0,0,0,,O kadar iyi durumdaydılar.
Dialogue: 0,0:03:40.78,0:03:42.78,Default,,0,0,0,,Hanawa'nın Tachibana Kardeşleri.
Dialogue: 0,0:03:42.78,0:03:45.61,Default,,0,0,0,,{\i1}Tsubasa-kun topu aldı!{\i0}
Dialogue: 0,0:03:46.62,0:03:47.43,Default,,0,0,0,,Durdurun!
Dialogue: 0,0:03:47.43,0:03:47.91,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:47.91,0:03:51.66,Default,,0,0,0,,{\i1}Tsubasa-kun defansta küçük bir\Naçık buluyor ve şut çekiyor!{\i0}
Dialogue: 0,0:03:51.66,0:03:55.21,Default,,0,0,0,,{\i1}Top, Aizawa-kun'a çarpıp uzaklaşıyor!{\i0}
Dialogue: 0,0:03:56.21,0:03:58.38,Default,,0,0,0,,İşte! Masao! Kazuo!
Dialogue: 0,0:03:58.38,0:03:59.25,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:03:59.25,0:04:01.55,Default,,0,0,0,,{\i1}Top, Tachibana Kardeşlere geliyor.{\i0}
Dialogue: 0,0:04:01.55,0:04:04.04,Default,,0,0,0,,{\i1}Hanawa'nın bir gol daha atma şansı var.{\i0}
Dialogue: 0,0:04:04.04,0:04:09.27,Default,,0,0,0,,Bu ikisi, şimdiye kadar göstermedikleri\Nözel bir hareket gösterdiler beraber.
Dialogue: 0,0:04:09.27,0:04:10.93,Default,,0,0,0,,Özel bir beraber hareket mi?
Dialogue: 0,0:04:10.93,0:04:12.55,Default,,0,0,0,,Tekrar yapalım Kazuo!
Dialogue: 0,0:04:12.55,0:04:13.43,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:04:15.41,0:04:16.27,Default,,0,0,0,,Bu--
Dialogue: 0,0:04:16.83,0:04:18.31,Default,,0,0,0,,Az önceki ile aynı hareket!
Dialogue: 0,0:04:18.31,0:04:19.11,Default,,0,0,0,,Durduracağız!
Dialogue: 0,0:04:19.11,0:04:22.99,Default,,0,0,0,,{\i1}Nankatsu hızlıca Masao-kun'un\Npeşinden gidiyor!{\i0}
Dialogue: 0,0:04:22.99,0:04:24.99,Default,,0,0,0,,Sana bırakıyorum Matsumoto.
Dialogue: 0,0:04:24.99,0:04:27.11,Default,,0,0,0,,{\i1}Masao-kun geri pas veriyor...{\i0}
Dialogue: 0,0:04:27.91,0:04:30.59,Default,,0,0,0,,{\i1}...ve kaleye doğru koşmaya başlıyor!{\i0}
Dialogue: 0,0:04:30.59,0:04:31.45,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:32.83,0:04:34.71,Default,,0,0,0,,Geliyor, Masao, Kazuo!
Dialogue: 0,0:04:35.93,0:04:38.54,Default,,0,0,0,,{\i1}Matsumoto yüksek bir top atıyor!{\i0}
Dialogue: 0,0:04:38.54,0:04:42.46,Default,,0,0,0,,{\i1}Masao-kun ve Kazuo-kun'un\Nikisi de ileri doğru koşuyor!{\i0}
Dialogue: 0,0:04:46.22,0:04:47.68,Default,,0,0,0,,Bu--
Dialogue: 0,0:04:48.34,0:04:52.06,Default,,0,0,0,,{\i1}Yine ikizlerin havada akrobatik\Nhareketlerini görüyoruz!{\i0}
Dialogue: 0,0:04:52.06,0:04:53.03,Default,,0,0,0,,Bu kez...
Dialogue: 0,0:04:53.03,0:04:54.52,Default,,0,0,0,,İkisi de aynı anda zıpladı!
Dialogue: 0,0:04:54.52,0:04:55.56,Default,,0,0,0,,Hangisi...
Dialogue: 0,0:04:55.56,0:04:57.40,Default,,0,0,0,,Hangisi vuracak?
Dialogue: 0,0:04:58.61,0:05:02.07,Default,,0,0,0,,{\i1}Masao-kun havada vole şutla\Ngolü hedefliyor!{\i0}
Dialogue: 0,0:05:02.07,0:05:04.99,Default,,0,0,0,,{\i1}Hanawa sonunda liderliği\Nele geçirecek mi?{\i0}
Dialogue: 0,0:05:06.12,0:05:09.53,Default,,0,0,0,,{\i1}Hayır! Kaleci Morisaki yumrukla uzaklaştırıyor!{\i0}
Dialogue: 0,0:05:09.53,0:05:10.28,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:11.33,0:05:12.99,Default,,0,0,0,,Başardın Morisaki!
Dialogue: 0,0:05:12.99,0:05:15.20,Default,,0,0,0,,{\i1}Top, arkalarda bulunan\NIshizaki-kun'a gidiyor.{\i0}
Dialogue: 0,0:05:15.20,0:05:18.26,Default,,0,0,0,,Tamamdır Ishizaki! Tsubasa ve Misaki'ye pas ver!
Dialogue: 0,0:05:18.26,0:05:19.46,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:05:19.46,0:05:20.17,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:20.54,0:05:21.40,Default,,0,0,0,,Olamaz!
Dialogue: 0,0:05:21.40,0:05:23.30,Default,,0,0,0,,{\i1}Olamaz! Iskaladı!{\i0}
Dialogue: 0,0:05:24.88,0:05:29.72,Default,,0,0,0,,{\i1}Kaleye girdi!\NNankatsu kendi kalesine attı!{\i0}
Dialogue: 0,0:05:31.47,0:05:33.17,Default,,0,0,0,,Başardık! Başardık be! Çok şanslıyız!
Dialogue: 0,0:05:33.17,0:05:34.93,Default,,0,0,0,,İkinci golümüzü attık!
Dialogue: 0,0:05:38.57,0:05:41.19,Default,,0,0,0,,{\i1}Aptal. Böyle birisini çıkarmışlar.{\i0}
Dialogue: 0,0:05:41.19,0:05:44.90,Default,,0,0,0,,{\i1}İşler lehimize ilerliyor.{\i0}
Dialogue: 0,0:05:44.90,0:05:47.07,Default,,0,0,0,,Ne yapıyorsun Ishizaki?!
Dialogue: 0,0:05:47.07,0:05:49.28,Default,,0,0,0,,Kendi kalene nasıl gol atarsın?!
Dialogue: 0,0:05:49.28,0:05:51.20,Default,,0,0,0,,Ö-Özür dilerim...
Dialogue: 0,0:05:51.20,0:05:55.40,Default,,0,0,0,,Bu maçı ne pahasına olursa\Nolsun kazanmamız gerek!
Dialogue: 0,0:05:55.40,0:05:56.48,Default,,0,0,0,,Bir de sen--
Dialogue: 0,0:05:56.48,0:05:57.36,Default,,0,0,0,,Yapmayın!
Dialogue: 0,0:05:58.33,0:06:00.16,Default,,0,0,0,,Misaki...
Dialogue: 0,0:06:00.16,0:06:03.25,Default,,0,0,0,,Lütfen birbirinizle kavga etmeyin.
Dialogue: 0,0:06:03.25,0:06:09.51,Default,,0,0,0,,Henüz söylememek istememiştim ama\Nbu turnuva, hep beraber son maçlarımız olabilir.
Dialogue: 0,0:06:09.51,0:06:11.28,Default,,0,0,0,,Ne?
Dialogue: 0,0:06:11.28,0:06:12.34,Default,,0,0,0,,Misaki...
Dialogue: 0,0:06:12.34,0:06:15.22,Default,,0,0,0,,Bu yüzden lütfen kavgayı kesin.
Dialogue: 0,0:06:15.22,0:06:17.40,Default,,0,0,0,,Misaki-kun...
Dialogue: 0,0:06:17.40,0:06:19.21,Default,,0,0,0,,Yani yine...
Dialogue: 0,0:06:19.21,0:06:20.23,Default,,0,0,0,,Transfer mi olacaksın?
Dialogue: 0,0:06:20.86,0:06:21.81,Default,,0,0,0,,Evet.
Dialogue: 0,0:06:22.85,0:06:25.77,Default,,0,0,0,,Ama okul değiştirsem bile...
Dialogue: 0,0:06:25.77,0:06:32.62,Default,,0,0,0,,...ulusal turnuvaya katılıp oynayabildiğim\Ntek ve ilk takım Nankatsu olacak.
Dialogue: 0,0:06:32.62,0:06:37.66,Default,,0,0,0,,Bu yüzden ne olursa olsun kazanmak\Nve hep birlikte şampiyon olmak istiyorum.
Dialogue: 0,0:06:38.25,0:06:39.41,Default,,0,0,0,,Misaki...
Dialogue: 0,0:06:44.17,0:06:46.83,Default,,0,0,0,,Hadi millet. Maç şimdi başlıyor.
Dialogue: 0,0:06:46.83,0:06:50.26,Default,,0,0,0,,Misaki-kun için bu maçı kesinlikle çevirelim!
Dialogue: 0,0:06:50.26,0:06:52.26,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:06:52.26,0:06:53.90,Default,,0,0,0,,Evet, aynen öyle!
Dialogue: 0,0:06:53.90,0:06:55.33,Default,,0,0,0,,Maç şimdi başlıyor!
Dialogue: 0,0:06:55.33,0:06:56.01,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:56.01,0:06:57.94,Default,,0,0,0,,Kesinlikle çevirelim!
Dialogue: 0,0:06:57.94,0:07:01.21,Default,,0,0,0,,Elemelere kalanlar biz olacağız!
Dialogue: 0,0:07:01.96,0:07:02.60,Default,,0,0,0,,Morisaki-kun!
Dialogue: 0,0:07:04.28,0:07:04.86,Default,,0,0,0,,Al.
Dialogue: 0,0:07:06.24,0:07:08.61,Default,,0,0,0,,Tamamdır millet. Her şeyinizi ortaya koyun.
Dialogue: 0,0:07:08.61,0:07:10.49,Default,,0,0,0,,Evet!
Dialogue: 0,0:07:10.49,0:07:12.00,Default,,0,0,0,,İşte böyle! Kaybetmeyin!
Dialogue: 0,0:07:12.00,0:07:13.51,Default,,0,0,0,,Hızlı bir dönüş yapın!
Dialogue: 0,0:07:13.51,0:07:15.94,Default,,0,0,0,,Nankatsu bastır!
Dialogue: 0,0:07:15.94,0:07:19.36,Default,,0,0,0,,Ishizaki-kun, takma kafana, takma.
Dialogue: 0,0:07:20.20,0:07:21.12,Default,,0,0,0,,Tamam.
Dialogue: 0,0:07:21.12,0:07:22.95,Default,,0,0,0,,Süzme salaklar.
Dialogue: 0,0:07:22.95,0:07:25.29,Default,,0,0,0,,Bir golle liderliği alınca maç bizim oldu.
Dialogue: 0,0:07:25.29,0:07:29.59,Default,,0,0,0,,{\i1}Nankatsu yediği talihsiz golle\Nzor bir duruma düştü.{\i0}
Dialogue: 0,0:07:29.59,0:07:34.72,Default,,0,0,0,,{\i1}Elemelere kalmak için\Nbu maçı kazanmaları gerek.{\i0}
Dialogue: 0,0:07:34.72,0:07:37.17,Default,,0,0,0,,{\i1}İki gol atıp kazanmadıkları sürece...{\i0}
Dialogue: 0,0:07:37.17,0:07:40.10,Default,,0,0,0,,{\i1}...elemelere kalamayacaklar.{\i0}
Dialogue: 0,0:07:42.94,0:07:44.70,Default,,0,0,0,,{\i1}Maç devam ediyor.{\i0}
Dialogue: 0,0:07:44.70,0:07:48.11,Default,,0,0,0,,{\i1}Oyunun akışının değişmesiyle Nankatsu,\Nhızlıca Hanawa'ya atağa çıkıyor!{\i0}
Dialogue: 0,0:07:48.11,0:07:50.15,Default,,0,0,0,,Tamamdır, önce bir gol atalım!
Dialogue: 0,0:07:50.15,0:07:51.03,Default,,0,0,0,,Tamam!
Dialogue: 0,0:07:51.63,0:07:54.16,Default,,0,0,0,,{\i1}Tsubasa-kun, lütfen bunu kazanın.{\i0}
Dialogue: 0,0:07:54.16,0:07:57.87,Default,,0,0,0,,{\i1}Size karşı oynamayı iple çekiyorum.{\i0}
Dialogue: 0,0:07:57.87,0:08:03.12,Default,,0,0,0,,{\i1}Geri dönüş yapmak için Nankatsu\Ntüm gücüyle atak yapıyordu.{\i0}
Dialogue: 0,0:08:03.12,0:08:04.92,Default,,0,0,0,,Sen! Bastır!
Dialogue: 0,0:08:04.92,0:08:06.13,Default,,0,0,0,,Burada durduracağım seni!
Dialogue: 0,0:08:06.89,0:08:10.55,Default,,0,0,0,,{\i1}Ne var ki Hanawa defansı sıkıydı.{\i0}
Dialogue: 0,0:08:11.90,0:08:12.80,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:08:13.50,0:08:16.51,Default,,0,0,0,,{\i1}Tsubasa-kun'a gelen pas kesildi.{\i0}
Dialogue: 0,0:08:16.51,0:08:21.06,Default,,0,0,0,,{\i1}Taki-kun koşuyor ama\NOizumi-kun izin vermiyor.{\i0}
Dialogue: 0,0:08:21.66,0:08:24.69,Default,,0,0,0,,{\i1}Matsumoto-kun topu taca yolluyor.{\i0}
Dialogue: 0,0:08:24.69,0:08:26.45,Default,,0,0,0,,{\i1}Nankatsu her şeyiyle saldırıyor...{\i0}
Dialogue: 0,0:08:26.45,0:08:29.82,Default,,0,0,0,,{\i1}...ne var ki Hanawa'nın sert defansını\Ngeçip gol atamıyor!{\i0}
Dialogue: 0,0:08:30.61,0:08:32.40,Default,,0,0,0,,{\i1}Ne yapıyorsunuz çocuklar?{\i0}
Dialogue: 0,0:08:36.64,0:08:37.49,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:08:38.01,0:08:40.16,Default,,0,0,0,,{\i1}Hepsi benim hatam!{\i0}
Dialogue: 0,0:08:40.16,0:08:42.62,Default,,0,0,0,,{\i1}Nankatsu'nun taç atışıyla maç devam edecek.{\i0}
Dialogue: 0,0:08:42.62,0:08:43.79,Default,,0,0,0,,Buraya!
Dialogue: 0,0:08:44.52,0:08:45.04,Default,,0,0,0,,Ne?
Dialogue: 0,0:08:46.96,0:08:47.63,Default,,0,0,0,,Al!
Dialogue: 0,0:08:48.54,0:08:51.80,Default,,0,0,0,,{\i1}Top Taki-kun'a gidiyor.\NBir kez daha atağa çıkıyor.{\i0}
Dialogue: 0,0:08:51.80,0:08:58.43,Default,,0,0,0,,{\i1}Ne var ki Nankatsu, tamamen markaja alınan\NTsubasa-kun'a top gönderemeyerek çok zor bir durumda!{\i0}
Dialogue: 0,0:08:58.43,0:08:59.05,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:08:59.05,0:09:03.84,Default,,0,0,0,,Meiwa maçında Hyuga'yı tutmak\Nbize iyi bir ders oldu!
Dialogue: 0,0:09:03.84,0:09:05.06,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:09:05.06,0:09:09.13,Default,,0,0,0,,Bu markajda Tsubasa'ya pas atmak zor.
Dialogue: 0,0:09:10.01,0:09:11.07,Default,,0,0,0,,Taki!
Dialogue: 0,0:09:11.07,0:09:12.35,Default,,0,0,0,,Buraya!
Dialogue: 0,0:09:12.35,0:09:15.44,Default,,0,0,0,,{\i1}Nankatsu'dan Kisugi-kun ters tarafa koşuyor!{\i0}
Dialogue: 0,0:09:15.44,0:09:18.24,Default,,0,0,0,,Bana Shutetsu'nun golcüsü\Ndemelerinin sebebi var!
Dialogue: 0,0:09:18.24,0:09:21.62,Default,,0,0,0,,Bununla birlikte beraberliği sağlayacağım!
Dialogue: 0,0:09:21.62,0:09:22.87,Default,,0,0,0,,{\i1}Hızlı bir şut!{\i0}
Dialogue: 0,0:09:23.79,0:09:27.04,Default,,0,0,0,,{\i1}Kaleci Kobayashi-kun zıplayarak tutuyor!{\i0}
Dialogue: 0,0:09:27.04,0:09:28.71,Default,,0,0,0,,Güzel kurtardın!
Dialogue: 0,0:09:28.71,0:09:29.71,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:09:29.71,0:09:31.03,Default,,0,0,0,,Bastırın!
Dialogue: 0,0:09:31.03,0:09:33.80,Default,,0,0,0,,Yalvarıyoruz Nankatsu!\NHemen toparlayın!
Dialogue: 0,0:09:33.80,0:09:36.43,Default,,0,0,0,,Size yetişmelerine izin vermeyin Hanawa!
Dialogue: 0,0:09:36.43,0:09:40.31,Default,,0,0,0,,{\i1}Elemeler bileti söz konusuyken\NNankatsu-Hanawa maçı devam ediyor!{\i0}
Dialogue: 0,0:09:40.31,0:09:44.95,Default,,0,0,0,,{\i1}15 dakika geçti ve sadece\N5 dakika kaldı.{\i0}
Dialogue: 0,0:09:44.95,0:09:47.56,Default,,0,0,0,,{\i1}Nankatsu'nun işi buraya kadarmış anlaşılan.{\i0}
Dialogue: 0,0:09:47.56,0:09:51.44,Default,,0,0,0,,{\i1}Nankatsu'nun ataklarına Hanawa'nın\Nne kadar iyi dayandığı çok belli.{\i0}
Dialogue: 0,0:09:51.44,0:09:55.86,Default,,0,0,0,,{\i1}Bir gollük liderliği koruyarak\Nkazanacaklarına inanıyorlar ve...{\i0}
Dialogue: 0,0:09:55.86,0:09:57.95,Default,,0,0,0,,{\i1}...baskıya boğun eğmiyorlar.{\i0}
Dialogue: 0,0:09:57.95,0:09:59.91,Default,,0,0,0,,{\i1}Hanawa'nın defansı harika.{\i0}
Dialogue: 0,0:09:59.91,0:10:00.91,Default,,0,0,0,,Izawa!
Dialogue: 0,0:10:01.96,0:10:02.78,Default,,0,0,0,,Bende!
Dialogue: 0,0:10:02.78,0:10:03.74,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:10:03.74,0:10:06.47,Default,,0,0,0,,{\i1}Nankatsu fena yakalandı!{\i0}
Dialogue: 0,0:10:06.47,0:10:08.66,Default,,0,0,0,,{\i1}Top Hanawa tarafından alındı.{\i0}
Dialogue: 0,0:10:08.66,0:10:09.58,Default,,0,0,0,,Al!
Dialogue: 0,0:10:09.58,0:10:12.23,Default,,0,0,0,,{\i1}İlerideki Tachibana Kardeşlere\Nuzun bir pas geliyor!{\i0}
Dialogue: 0,0:10:12.23,0:10:14.63,Default,,0,0,0,,{\i1}Nankatsu bir gol daha yerse...{\i0}
Dialogue: 0,0:10:14.63,0:10:18.09,Default,,0,0,0,,{\i1}...elemelere kalma umudu biter!{\i0}
Dialogue: 0,0:10:18.09,0:10:20.38,Default,,0,0,0,,Tamamdır! Bir gol daha atıp kesinleştirelim!
Dialogue: 0,0:10:23.21,0:10:23.99,Default,,0,0,0,,Ne?!
Dialogue: 0,0:10:23.99,0:10:25.92,Default,,0,0,0,,{\i1}Ne?! Harika bir hareket!{\i0}
Dialogue: 0,0:10:25.92,0:10:28.77,Default,,0,0,0,,{\i1}Defans Ishizaki-kun topu kesiyor!{\i0}
Dialogue: 0,0:10:28.77,0:10:29.77,Default,,0,0,0,,- Ishizaki-kun!\N- Ishizaki-kun!
Dialogue: 0,0:10:29.77,0:10:30.77,Default,,0,0,0,,Ishizaki!
Dialogue: 0,0:10:30.77,0:10:33.31,Default,,0,0,0,,{\i1}Ishizaki-kun topu sürüyor.{\i0}
Dialogue: 0,0:10:33.31,0:10:36.84,Default,,0,0,0,,{\i1}Benim yüzümden geriye düştük.{\i0}
Dialogue: 0,0:10:36.84,0:10:39.25,Default,,0,0,0,,{\i1}Herkes o kadar kazandıktan sonra...{\i0}
Dialogue: 0,0:10:39.25,0:10:41.57,Default,,0,0,0,,{\i1}...böyle bitmesine asla izin vermem!{\i0}
Dialogue: 0,0:10:41.57,0:10:43.20,Default,,0,0,0,,{\i1}Ishizaki-kun!{\i0}
Dialogue: 0,0:10:43.20,0:10:46.54,Default,,0,0,0,,{\i1}Transfer olacak Misaki'nin\Nhatırı için o golü...{\i0}
Dialogue: 0,0:10:47.78,0:10:50.83,Default,,0,0,0,,{\i1}...iade edeceğim!{\i0}
Dialogue: 0,0:10:50.83,0:10:53.63,Default,,0,0,0,,{\i1}Ishizaki-kun uzun bir şut çekiyor!{\i0}
Dialogue: 0,0:10:53.63,0:10:55.04,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:10:55.04,0:10:58.30,Default,,0,0,0,,{\i1}Ama direkt kalecinin üzerine gidiyor.{\i0}
Dialogue: 0,0:11:00.62,0:11:04.68,Default,,0,0,0,,{\i1}Ne?! Misaki-kun kayarak\Ntopun yönünü değiştiriyor!{\i0}
Dialogue: 0,0:11:05.88,0:11:07.43,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:11:07.43,0:11:10.42,Default,,0,0,0,,{\i1}Nankatsu 4 dakika kalmışken\Nberaberliği sağlıyor!{\i0}
Dialogue: 0,0:11:10.42,0:11:12.19,Default,,0,0,0,,{\i1}Sonunda beraberliği sağladılar!{\i0}
Dialogue: 0,0:11:12.95,0:11:14.56,Default,,0,0,0,,{\i1}2-2. Berabere.{\i0}
Dialogue: 0,0:11:14.56,0:11:17.62,Default,,0,0,0,,{\i1}Bununla birlikte başa döndük!{\i0}
Dialogue: 0,0:11:17.62,0:11:20.79,Default,,0,0,0,,Başardık!
Dialogue: 0,0:11:30.76,0:11:32.54,Default,,0,0,0,,{\i1}Nankatsu beraberliği sağlıyor!{\i0}
Dialogue: 0,0:11:32.54,0:11:35.35,Default,,0,0,0,,T-Teşekkürler Misaki!
Dialogue: 0,0:11:35.35,0:11:38.91,Default,,0,0,0,,{\i1}İkinci yarıdan sadece 4 dakika\Nkalmışken beraberlik sağlanıyor!{\i0}
Dialogue: 0,0:11:38.91,0:11:40.46,Default,,0,0,0,,Berabere!
Dialogue: 0,0:11:40.46,0:11:42.76,Default,,0,0,0,,{\i1}Çok harika bir oyundu.{\i0}
Dialogue: 0,0:11:42.76,0:11:45.24,Default,,0,0,0,,{\i1}Misaki-kun'un planlanan dokunuşu.{\i0}
Dialogue: 0,0:11:45.24,0:11:50.14,Default,,0,0,0,,{\i1}Ve de Ishizaki-kun'un harika bir şekilde\Nkesmesinden sonra attığı uzun şut!{\i0}
Dialogue: 0,0:11:50.14,0:11:54.56,Default,,0,0,0,,{\i1}Önceki hatalarını kapatan\Nharika bir oyundu!{\i0}
Dialogue: 0,0:11:54.56,0:11:59.72,Default,,0,0,0,,{\i1}Zor durumdan illaki bir yolunu\Nbulup sıyrılan bir adamsın Ishizaki.{\i0}
Dialogue: 0,0:11:59.72,0:12:03.40,Default,,0,0,0,,Tamamdır! Bir tane daha atıp kazanalım!
Dialogue: 0,0:12:03.40,0:12:04.66,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:04.66,0:12:09.66,Default,,0,0,0,,İşte bu Ishizaki! Herkesle\Nberaber canavar gibi antrenman yaptın sen!
Dialogue: 0,0:12:09.66,0:12:11.31,Default,,0,0,0,,Böyle devam et!
Dialogue: 0,0:12:12.12,0:12:18.75,Default,,0,0,0,,{\i1}Ne var ki Nankatsu'nun elemelere kalması\Niçin 4 dakikada bir gol daha atması lazım.{\i0}
Dialogue: 0,0:12:18.75,0:12:23.92,Default,,0,0,0,,{\i1}Bu sırada beraberlik\NHanawa'nın işine geliyor.{\i0}
Dialogue: 0,0:12:23.92,0:12:27.18,Default,,0,0,0,,Lanet olsun! Attığımız golü kesinlikle korumalıyız!
Dialogue: 0,0:12:27.18,0:12:30.51,Default,,0,0,0,,{\i1}Hangi takıma zafer tanrıçası gülecek?{\i0}
Dialogue: 0,0:12:30.51,0:12:34.14,Default,,0,0,0,,{\i1}Maçta heyecan dorukta!{\i0}
Dialogue: 0,0:12:34.14,0:12:36.37,Default,,0,0,0,,{\i1}Buraya kadar geldiniz.{\i0}
Dialogue: 0,0:12:36.37,0:12:38.90,Default,,0,0,0,,{\i1}Hanawa, bir şekilde halledin şunu.{\i0}
Dialogue: 0,0:12:39.90,0:12:44.40,Default,,0,0,0,,{\i1}Bir gol daha atıp elemelere kalın Tsubasa-kun.{\i0}
Dialogue: 0,0:12:47.08,0:12:50.58,Default,,0,0,0,,Öyleyse bir gol daha atmamız gerek!
Dialogue: 0,0:12:51.02,0:12:54.82,Default,,0,0,0,,{\i1}Tachibana Kardeşlerin top sürmesiyle\Nmaç kaldığı yerden devam ediyor!{\i0}
Dialogue: 0,0:12:54.82,0:12:57.96,Default,,0,0,0,,Havada akrobatik hareketler\Nyapmadan önce topu çalalım!
Dialogue: 0,0:12:58.41,0:12:59.04,Default,,0,0,0,,Evet!
Dialogue: 0,0:13:02.21,0:13:06.15,Default,,0,0,0,,{\i1}Nankatsu beraberliği sağlayınca\Nçok gaza geldi!{\i0}
Dialogue: 0,0:13:06.15,0:13:08.26,Default,,0,0,0,,{\i1}Tachibana Kardeşlerin istediklerini\Nyapmalarına izin vermiyorlar!{\i0}
Dialogue: 0,0:13:08.26,0:13:09.39,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:13:10.30,0:13:11.39,Default,,0,0,0,,Masao!
Dialogue: 0,0:13:15.02,0:13:17.27,Default,,0,0,0,,{\i1}Masao-kun'un peşinde sıkı bir takip var!{\i0}
Dialogue: 0,0:13:17.98,0:13:18.56,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:13:19.66,0:13:23.11,Default,,0,0,0,,{\i1}Ne var ki Tachibana Kardeşler\Ntopu o kadar kolay kaybetmiyor!{\i0}
Dialogue: 0,0:13:24.44,0:13:25.67,Default,,0,0,0,,Şimdi topu çalacağız!
Dialogue: 0,0:13:25.67,0:13:26.36,Default,,0,0,0,,Evet!
Dialogue: 0,0:13:29.24,0:13:32.99,Default,,0,0,0,,{\i1}Masao-kun hızlıca iki kişiyi atlatıyor!{\i0}
Dialogue: 0,0:13:32.99,0:13:34.37,Default,,0,0,0,,Güzeldi Masao!
Dialogue: 0,0:13:34.37,0:13:36.33,Default,,0,0,0,,Eyvah! Düş peşlerine!
Dialogue: 0,0:13:36.33,0:13:40.13,Default,,0,0,0,,{\i1}Tachibana Kardeşler, Nankatsu'nun\Ndefans sahasına yaklaşıyorlar!{\i0}
Dialogue: 0,0:13:40.13,0:13:44.13,Default,,0,0,0,,{\i1}Bu topu ne olursa olsun çalacağım.{\i0}
Dialogue: 0,0:13:44.13,0:13:47.63,Default,,0,0,0,,{\i1}Nankatsu, Masao-kun'a yetişiyor.{\i0}
Dialogue: 0,0:13:49.14,0:13:50.59,Default,,0,0,0,,Kazuo!
Dialogue: 0,0:13:50.59,0:13:51.35,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:13:51.35,0:13:57.35,Default,,0,0,0,,{\i1}Misaki-kun havadaki topu okumasıyla\NTachibana Kardeşlerin pasını kesiyor!{\i0}
Dialogue: 0,0:13:57.35,0:13:58.14,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:13:58.14,0:14:00.19,Default,,0,0,0,,Güzel kestin Misaki!
Dialogue: 0,0:14:00.19,0:14:03.27,Default,,0,0,0,,{\i1}Tamamdır, ben de kaybetmeyeceğim!{\i0}
Dialogue: 0,0:14:05.05,0:14:07.80,Default,,0,0,0,,{\i1}Nankatsu sonunda topu aldı!{\i0}
Dialogue: 0,0:14:07.80,0:14:09.66,Default,,0,0,0,,{\i1}Hızlıca Hanawa kalesine doğru ilerliyorlar!{\i0}
Dialogue: 0,0:14:09.66,0:14:11.94,Default,,0,0,0,,Gol atmalarına izin verirsek biter!
Dialogue: 0,0:14:11.94,0:14:14.35,Default,,0,0,0,,Son ana kadar kaleyi koruyun!
Dialogue: 0,0:14:14.35,0:14:15.16,Default,,0,0,0,,Tamam!
Dialogue: 0,0:14:15.16,0:14:17.82,Default,,0,0,0,,{\i1}Nankatsu'nun atağı ve Hanawa'nın defansı.{\i0}
Dialogue: 0,0:14:17.82,0:14:21.08,Default,,0,0,0,,{\i1}Son mücadeleleri elemelere\Ngidecek tarafı belirleyecek!{\i0}
Dialogue: 0,0:14:22.10,0:14:23.00,Default,,0,0,0,,İşte!
Dialogue: 0,0:14:23.00,0:14:25.00,Default,,0,0,0,,{\i1}Misaki-kun hızlı bir şut çekiyor!{\i0}
Dialogue: 0,0:14:25.76,0:14:28.01,Default,,0,0,0,,{\i1}Ama top defansa çarpıp çıkıyor.{\i0}
Dialogue: 0,0:14:28.81,0:14:30.76,Default,,0,0,0,,{\i1}Nankatsu korner kullanacak.{\i0}
Dialogue: 0,0:14:30.76,0:14:32.21,Default,,0,0,0,,{\i1}Şuna bir bakın.{\i0}
Dialogue: 0,0:14:32.21,0:14:35.99,Default,,0,0,0,,{\i1}Hanawa, Tachibana Kardeşleri bırakmak\Niçin tüm oyuncularıyla birlikte defansta!{\i0}
Dialogue: 0,0:14:35.99,0:14:38.35,Default,,0,0,0,,{\i1}Kale önünde inanılmaz bir duvar ördüler!{\i0}
Dialogue: 0,0:14:38.35,0:14:42.61,Default,,0,0,0,,{\i1}Nankatsu bu duvarı aşıp\Ngol atabilecek mi acaba?{\i0}
Dialogue: 0,0:14:42.61,0:14:45.52,Default,,0,0,0,,{\i1}Sadece 3 dakika kaldı.{\i0}
Dialogue: 0,0:14:51.36,0:14:52.36,Default,,0,0,0,,Acele et Taki!
Dialogue: 0,0:14:57.12,0:14:58.80,Default,,0,0,0,,{\i1}Kale önüne doğru!{\i0}
Dialogue: 0,0:14:58.80,0:15:01.08,Default,,0,0,0,,{\i1}Nankatsu kafa vuruşu mu yapacak?{\i0}
Dialogue: 0,0:15:01.85,0:15:04.61,Default,,0,0,0,,{\i1}Kaleci Kobayashi-kun yumruklayarak uzaklaştırıyor!{\i0}
Dialogue: 0,0:15:04.61,0:15:05.75,Default,,0,0,0,,{\i1}Harika bir karar!{\i0}
Dialogue: 0,0:15:05.75,0:15:07.63,Default,,0,0,0,,Güzeldi kaleci!
Dialogue: 0,0:15:07.63,0:15:10.63,Default,,0,0,0,,{\i1}Ama top Tsubasa-kun'un önüne düşüyor.{\i0}
Dialogue: 0,0:15:10.63,0:15:11.47,Default,,0,0,0,,Tamamdır!
Dialogue: 0,0:15:11.47,0:15:13.97,Default,,0,0,0,,{\i1}Kaleci daha kalkamadı.{\i0}
Dialogue: 0,0:15:13.97,0:15:16.03,Default,,0,0,0,,{\i1}Tsubasa-kun şut çekiyor!{\i0}
Dialogue: 0,0:15:20.03,0:15:22.94,Default,,0,0,0,,{\i1}T-Tsubasa'nın şutunu bedeniyle engelledi.{\i0}
Dialogue: 0,0:15:23.55,0:15:26.27,Default,,0,0,0,,{\i1}Tachibana Masao-kun bu!{\i0}
Dialogue: 0,0:15:26.27,0:15:28.48,Default,,0,0,0,,Böyle devam Hanawa!
Dialogue: 0,0:15:28.48,0:15:33.49,Default,,0,0,0,,{\i1}Defansta yer almaması gereken Tachibana\NKardeşler defansa gelmiş!{\i0}
Dialogue: 0,0:15:34.40,0:15:37.33,Default,,0,0,0,,{\i1}Ölsem bile gol atmanıza izin vermem!{\i0}
Dialogue: 0,0:15:38.45,0:15:41.37,Default,,0,0,0,,Siz var ya 100 adama bedelsiniz!
Dialogue: 0,0:15:41.37,0:15:43.42,Default,,0,0,0,,Evet, bize bırak!
Dialogue: 0,0:15:43.42,0:15:48.21,Default,,0,0,0,,{\i1}Tachibana Kardeşlerin de defansa\Nkatılmasıyla herkes defansa katılmış oldu!{\i0}
Dialogue: 0,0:15:48.76,0:15:52.21,Default,,0,0,0,,{\i1}Hanawa duvarı her zamankinden daha kalın.{\i0}
Dialogue: 0,0:15:52.21,0:15:54.22,Default,,0,0,0,,{\i1}Hanawa gibi defansıyla ünlü bir takım...{\i0}
Dialogue: 0,0:15:54.22,0:15:59.31,Default,,0,0,0,,{\i1}...defansı iki katına çıkarmışken\NNankatsu şut bile çekemiyor!{\i0}
Dialogue: 0,0:16:00.48,0:16:02.77,Default,,0,0,0,,{\i1}İkinci yarının 20 dakikası doldu.{\i0}
Dialogue: 0,0:16:02.77,0:16:04.90,Default,,0,0,0,,{\i1}1 dakikalık uzatma var.{\i0}
Dialogue: 0,0:16:04.90,0:16:06.77,Default,,0,0,0,,{\i1}Nankatsu şansı tükeniyor.{\i0}
Dialogue: 0,0:16:06.77,0:16:09.33,Default,,0,0,0,,Tsubasa-kun! Misaki-kun! Bir şeyler yapın!
Dialogue: 0,0:16:09.33,0:16:10.78,Default,,0,0,0,,Vakit kalmadı artık!
Dialogue: 0,0:16:15.03,0:16:17.04,Default,,0,0,0,,Tamamdır, biraz daha.
Dialogue: 0,0:16:17.04,0:16:20.41,Default,,0,0,0,,Şut çekmene asla izin vermeyeceğim.
Dialogue: 0,0:16:20.41,0:16:24.92,Default,,0,0,0,,{\i1}Böyle büyük bir defansı nasıl geçebiliriz?{\i0}
Dialogue: 0,0:16:36.00,0:16:40.14,Default,,0,0,0,,{\i1}Herkesle beraber son maçım mı olacak bu?{\i0}
Dialogue: 0,0:16:40.14,0:16:42.68,Default,,0,0,0,,{\i1}Burada bitmesine izin vermem!{\i0}
Dialogue: 0,0:16:43.68,0:16:46.30,Default,,0,0,0,,{\i1}Nankatsu kazanacak!{\i0}
Dialogue: 0,0:16:46.30,0:16:48.61,Default,,0,0,0,,{\i1}Kaptan olarak başka bir\Nseçenek kabullenemem!{\i0}
Dialogue: 0,0:16:50.40,0:16:52.40,Default,,0,0,0,,Misaki-kun, havadan!
Dialogue: 0,0:16:54.73,0:16:55.82,Default,,0,0,0,,Anladım!
Dialogue: 0,0:16:55.82,0:17:01.45,Default,,0,0,0,,{\i1}Misaki-kun, Tsubasa-kun'un sinyaliyle\Nyüksek bir top gönderiyor!{\i0}
Dialogue: 0,0:17:01.45,0:17:02.33,Default,,0,0,0,,{\i1}Neyin peşindeler?{\i0}
Dialogue: 0,0:17:02.33,0:17:04.66,Default,,0,0,0,,Masao, yoksa o--
Dialogue: 0,0:17:06.58,0:17:10.91,Default,,0,0,0,,{\i1}B-Bu, Tachibana Kardeşlerin\Nözel hava topu hareketi!{\i0}
Dialogue: 0,0:17:10.91,0:17:13.09,Default,,0,0,0,,{\i1}Tsubasa-kun aynısını yapıyor!{\i0}
Dialogue: 0,0:17:13.09,0:17:16.59,Default,,0,0,0,,{\i1}Havadayken kendisini tutan kimse yok!{\i0}
Dialogue: 0,0:17:18.38,0:17:21.47,Default,,0,0,0,,{\i1}Tsubasa-kun havada röveşata vuruyor!{\i0}
Dialogue: 0,0:17:22.54,0:17:25.43,Default,,0,0,0,,{\i1}Girdi! Gol!{\i0}
Dialogue: 0,0:17:27.01,0:17:28.90,Default,,0,0,0,,{\i1}Nankatsu toparladı!{\i0}
Dialogue: 0,0:17:28.90,0:17:30.02,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:17:30.02,0:17:31.90,Default,,0,0,0,,Başardık! Toparladık!
Dialogue: 0,0:17:31.90,0:17:34.29,Default,,0,0,0,,Başardın Tsubasa!
Dialogue: 0,0:17:37.49,0:17:39.99,Default,,0,0,0,,{\i1}Maçı bitiren düdük çalıyor.{\i0}
Dialogue: 0,0:17:40.48,0:17:43.74,Default,,0,0,0,,{\i1}Son bir çabayla maç 3-2 bitiyor!{\i0}
Dialogue: 0,0:17:43.74,0:17:49.25,Default,,0,0,0,,{\i1}Son anda zaferi göğüsleyenler\NShizuoka bölgesinden Nankatsu SC!{\i0}
Dialogue: 0,0:17:49.25,0:17:57.38,Default,,0,0,0,,{\i1}Böylelikle Nankatsu, Meiwa FC'nin\Narkasından elemelere katılmayı garantiledi!{\i0}
Dialogue: 0,0:17:57.38,0:17:58.69,Default,,0,0,0,,Başardık! Başardık!
Dialogue: 0,0:17:58.69,0:17:59.84,Default,,0,0,0,,Elemelere çıktık!
Dialogue: 0,0:17:59.84,0:18:00.85,Default,,0,0,0,,Harikasınız!
Dialogue: 0,0:18:01.41,0:18:02.85,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:18:04.06,0:18:05.35,Default,,0,0,0,,Tebrikler.
Dialogue: 0,0:18:06.01,0:18:11.36,Default,,0,0,0,,{\i1}Teşekkürler Tsubasa-kun. Böylelikle\Nherkesle birlikte futbol oynamaya devam edebilirim.{\i0}
Dialogue: 0,0:18:11.36,0:18:13.48,Default,,0,0,0,,{\an8\i1}Nankatsu zor durumu aştı.{\i0}
Dialogue: 0,0:18:12.87,0:18:13.48,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:13.48,0:18:16.44,Default,,0,0,0,,{\an8}3-2 skorla elemelere yükseliyorlar.
Dialogue: 0,0:18:14.04,0:18:16.44,Default,,0,0,0,,Burada soğuk terler döktüm.
Dialogue: 0,0:18:16.44,0:18:18.45,Default,,0,0,0,,Başardın Tsubasa-kun!
Dialogue: 0,0:18:18.45,0:18:22.74,Default,,0,0,0,,{\i1}Size karşı oynamak için\Nsabırsızlanıyorum Tsubasa-kun.{\i0}
Dialogue: 0,0:18:22.74,0:18:26.75,Default,,0,0,0,,{\i1}Nankatsu başardı cidden.{\i0}
Dialogue: 0,0:18:26.75,0:18:30.00,Default,,0,0,0,,Roberto, Tsubasa başardı gerçekten.
Dialogue: 0,0:18:31.93,0:18:33.34,Default,,0,0,0,,Roberto?
Dialogue: 0,0:18:33.34,0:18:34.99,Default,,0,0,0,,Harikaydınız Hanawa!
Dialogue: 0,0:18:34.99,0:18:36.59,Default,,0,0,0,,Nankatsu, tebrikler!
Dialogue: 0,0:18:36.59,0:18:38.44,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:18:38.44,0:18:40.59,Default,,0,0,0,,Elemelere kalmaya çok yakındık.
Dialogue: 0,0:18:40.59,0:18:43.28,Default,,0,0,0,,Her şeyimizle mücadele ettik.
Dialogue: 0,0:18:43.28,0:18:45.43,Default,,0,0,0,,Son ana kadar başımızı dik tutalım.
Dialogue: 0,0:18:46.24,0:18:47.10,Default,,0,0,0,,Evet.
Dialogue: 0,0:18:47.10,0:18:49.35,Default,,0,0,0,,Desteğiniz için teşekkürler!
Dialogue: 0,0:18:50.02,0:18:51.85,Default,,0,0,0,,Tekrar deneyin!
Dialogue: 0,0:18:54.43,0:18:58.15,Default,,0,0,0,,Elemelerde bizim yerimize de\Nelinizden geleni yapın.
Dialogue: 0,0:18:58.15,0:18:59.20,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:15.75,0:19:21.54,Default,,0,0,0,,{\t(5367,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Bilinen hiçbir futbol tekniğini\Nuygulamaktan çekinmiyor.{\i0}
Dialogue: 0,0:19:22.19,0:19:26.06,Default,,0,0,0,,Tsubasa, ilk tanışmamızı hatırlıyorum.
Dialogue: 0,0:19:29.37,0:19:31.73,Default,,0,0,0,,{\i1}Sana hiçbir şey öğretmesem bile...{\i0}
Dialogue: 0,0:19:31.73,0:19:34.98,Default,,0,0,0,,{\i1}...her maçta gelişmeye devam ettin.{\i0}
Dialogue: 0,0:19:38.00,0:19:43.19,Default,,0,0,0,,Belki de Tsubasa'nın artık\Nihtiyacı yoktur.
Dialogue: 0,0:19:48.13,0:19:52.99,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvası'nın\Ngrup aşamaları bitmişti.{\i0}
Dialogue: 0,0:19:52.99,0:19:57.80,Default,,0,0,0,,{\i1}Elemelere kalan 16 takım burada toplanmıştı.{\i0}
Dialogue: 0,0:19:58.37,0:20:00.88,Default,,0,0,0,,Yani gerçekten okul mu değiştireceksin?
Dialogue: 0,0:20:00.88,0:20:04.97,Default,,0,0,0,,Evet. İkinci dönemde başka\Nbir okula geçeceğim.
Dialogue: 0,0:20:05.39,0:20:06.31,Default,,0,0,0,,Demek öyle.
Dialogue: 0,0:20:07.26,0:20:10.98,Default,,0,0,0,,Öyleyse Misaki-kun ile birlikte\Nşampiyon olmaktan başka şansımız yok.
Dialogue: 0,0:20:10.98,0:20:12.69,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:20:12.69,0:20:15.76,Default,,0,0,0,,Misaki'nin kaybetmiş olarak\Ngitmesine asla izin vermem.
Dialogue: 0,0:20:15.76,0:20:17.25,Default,,0,0,0,,Tamamdır! Şampiyonluğa!
Dialogue: 0,0:20:17.25,0:20:18.87,Default,,0,0,0,,Misaki ile şampiyon olacağız!
Dialogue: 0,0:20:19.58,0:20:21.12,Default,,0,0,0,,Teşekkürler çocuklar!
Dialogue: 0,0:20:21.12,0:20:23.15,Default,,0,0,0,,Hey Misaki!
Dialogue: 0,0:20:23.85,0:20:25.36,Default,,0,0,0,,Furano'daki çocuklar.
Dialogue: 0,0:20:25.36,0:20:28.45,Default,,0,0,0,,Bugünkü maçta harikaydınız Misaki.
Dialogue: 0,0:20:28.45,0:20:31.50,Default,,0,0,0,,Elemelerdeki kuraya göre...
Dialogue: 0,0:20:31.50,0:20:35.48,Default,,0,0,0,,...Furano ve Nankatsu,\Nfinale kadar oynamayacak.
Dialogue: 0,0:20:35.48,0:20:37.04,Default,,0,0,0,,Evet, haklısın.
Dialogue: 0,0:20:37.04,0:20:40.86,Default,,0,0,0,,Mümkünse final maçı Nankatsu\Nve Furano arasında olsun.
Dialogue: 0,0:20:40.86,0:20:42.30,Default,,0,0,0,,Evet, aynen öyle!
Dialogue: 0,0:20:43.17,0:20:50.26,Default,,0,0,0,,{\i1}Okul değiştirmeye devam etse de\Nfutbol sayesinde bu kadar arkadaş edindim.{\i0}
Dialogue: 0,0:20:50.26,0:20:52.69,Default,,0,0,0,,Kaptan, toplantı başlamak üzere.
Dialogue: 0,0:20:52.69,0:20:54.14,Default,,0,0,0,,Tamamdır, anladım.
Dialogue: 0,0:20:54.54,0:20:56.12,Default,,0,0,0,,Görüşürüz Misaki.
Dialogue: 0,0:21:00.49,0:21:01.27,Default,,0,0,0,,Özür dilerim.
Dialogue: 0,0:21:03.98,0:21:04.95,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:21:04.95,0:21:06.91,Default,,0,0,0,,Aptal! Dikkat etsene!
Dialogue: 0,0:21:06.91,0:21:07.95,Default,,0,0,0,,Kojiro!
Dialogue: 0,0:21:09.03,0:21:10.63,Default,,0,0,0,,Adi!
Dialogue: 0,0:21:10.63,0:21:12.25,Default,,0,0,0,,Yapma Matsuyama!
Dialogue: 0,0:21:12.25,0:21:13.44,Default,,0,0,0,,Misaki...
Dialogue: 0,0:21:13.44,0:21:18.02,Default,,0,0,0,,Misaki, elemelere kaldınız\Ndiye bir yerleriniz kalkmasın!
Dialogue: 0,0:21:18.02,0:21:18.71,Default,,0,0,0,,Ne?
Dialogue: 0,0:21:18.71,0:21:21.71,Default,,0,0,0,,Sonuçta kazananın Meiwa olacağı belli!
Dialogue: 0,0:21:21.71,0:21:23.96,Default,,0,0,0,,Canıma tak etti artık bu!
Dialogue: 0,0:21:23.96,0:21:26.88,Default,,0,0,0,,Yapmayın! Buna sahada karar verin!
Dialogue: 0,0:21:27.88,0:21:29.34,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:21:31.01,0:21:36.64,Default,,0,0,0,,Tsubasa-kun haklı. Maçtan önce\Nyaralanmak sıkıntı olabilir.
Dialogue: 0,0:21:36.64,0:21:39.02,Default,,0,0,0,,Misugi Jun...
Dialogue: 0,0:21:39.02,0:21:42.78,Default,,0,0,0,,Eğleniyor gibisiniz.
Dialogue: 0,0:21:42.78,0:21:44.72,Default,,0,0,0,,O-O...
Dialogue: 0,0:21:44.72,0:21:47.36,Default,,0,0,0,,Naniwa FC'nin kalecisi Nakanishi!
Dialogue: 0,0:21:47.36,0:21:52.54,Default,,0,0,0,,Nankatsulular, yanılmıyorum elemelerin\Nilk maçı aramızda olacak.
Dialogue: 0,0:21:52.54,0:21:55.83,Default,,0,0,0,,İyi geçinelim olur mu?
Dialogue: 0,0:22:06.59,0:22:09.54,Default,,0,0,0,,Herkes çok güçlü görünüyor, Tsubasa-kun.
Dialogue: 0,0:22:09.54,0:22:12.60,Default,,0,0,0,,Evet. Maçlarımızı iple çekiyorum.
Dialogue: 0,0:22:13.04,0:22:17.38,Default,,0,0,0,,Tamamdır! Bekle bizi elemeler!
Dialogue: 0,0:22:17.53,0:22:19.80,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\Nwww.areyousuresubs.com
Dialogue: 0,0:22:19.89,0:22:23.21,Default,,0,0,0,,Not: Bu bölümdeki kapanış şarkısını\NMisaki'nin ses sanatçısı seslendiriyor.
Dialogue: 0,0:23:50.11,0:24:00.68,Default,,0,0,0,,Gelecek 18. Bölümde:\Nİşte Geliyoruz Elemeler!
Dialogue: 0,0:02:04.01,0:02:09.60,Opening Türkçe,,0,0,0,,tökezlediğimde aldığım çimen kokusu
Dialogue: 0,0:02:09.60,0:02:14.27,Opening Türkçe,,0,0,0,,üzerimde uzanan sonu gelmez masmavi gökyüzü
Dialogue: 0,0:02:15.52,0:02:20.19,Opening Türkçe,,0,0,0,,dolambaçlı ve rastgele bu yol
Dialogue: 0,0:02:21.07,0:02:28.78,Opening Türkçe,,0,0,0,,sonsuz rüyalarımız için bir harita
Dialogue: 0,0:02:28.78,0:02:34.54,Opening Türkçe,,0,0,0,,umutlarım kaçırsa da hedefi
Dialogue: 0,0:02:34.54,0:02:43.30,Opening Türkçe,,0,0,0,,ayakta kaldığım sürece hayallerimin sonu gelmeyecek
Dialogue: 0,0:02:43.30,0:02:48.85,Opening Türkçe,,0,0,0,,1 numara! ileri çık herkesten önce
Dialogue: 0,0:02:48.85,0:02:54.77,Opening Türkçe,,0,0,0,,koşmaya başla aldatıcı oyunlarınla\Ndünya sahnesine doğru
Dialogue: 0,0:02:54.77,0:02:56.44,Opening Türkçe,,0,0,0,,koş ve koş
Dialogue: 0,0:02:56.44,0:03:03.65,Opening Türkçe,,0,0,0,,beklentiler bizi harekete geçiren sinyaller
Dialogue: 0,0:03:03.65,0:03:06.66,Opening Türkçe,,0,0,0,,alevlen alevlen alevlen ve yapıştır tekmeyi
Dialogue: 0,0:03:06.66,0:03:11.08,Opening Türkçe,,0,0,0,,boy göster kocaman televizyonda
Dialogue: 0,0:02:04.01,0:02:09.60,Opening Romaji,,0,0,0,,koronde toki no shibafu no nioi
Dialogue: 0,0:02:09.60,0:02:14.27,Opening Romaji,,0,0,0,,aogimita sora no ao hateshinakatta
Dialogue: 0,0:02:15.52,0:02:20.19,Opening Romaji,,0,0,0,,mayotte modori susumu kido ga
Dialogue: 0,0:02:21.07,0:02:28.78,Opening Romaji,,0,0,0,,hateshinai yume o miru boku-tachi no chizu
Dialogue: 0,0:02:28.78,0:02:34.54,Opening Romaji,,0,0,0,,goal o soreta kibo ga atte mo
Dialogue: 0,0:02:34.54,0:02:43.30,Opening Romaji,,0,0,0,,mata tachiagaru nara yume wa owaranai
Dialogue: 0,0:02:43.30,0:02:48.85,Opening Romaji,,0,0,0,,No. 1! dare yori hayaku kakenuke
Dialogue: 0,0:02:48.85,0:02:54.77,Opening Romaji,,0,0,0,,tricky na play de sekai e muke Start! Dash!
Dialogue: 0,0:02:54.77,0:02:56.44,Opening Romaji,,0,0,0,,Run & Run!
Dialogue: 0,0:02:56.44,0:03:03.65,Opening Romaji,,0,0,0,,akogare dake ga boku-ra o chiri-chiri-chiri ugokasu yo\N
Dialogue: 0,0:03:03.65,0:03:06.66,Opening Romaji,,0,0,0,,mera-mera-mera iku ze kick o
Dialogue: 0,0:03:06.66,0:03:11.08,Opening Romaji,,0,0,0,,tobidaso dodekai TV
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Romaji,,0,0,0,,chotto aremi na eesu ga tooru
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Romaji,,0,0,0,,suguremono da to machijuu sawagu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Romaji,,0,0,0,,chochou sanba, jiguzagu sanba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Romaji,,0,0,0,,aitsu no uwasa de chanba mo hashiru
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Romaji,,0,0,0,,sore ni tsukete mo oretacha nan darou
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Romaji,,0,0,0,,booru hitotsu ni kirikiri mai sa
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Romaji,,0,0,0,,itsuka kimeru ze, inazuma shuuto
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Romaji,,0,0,0,,son toki ore ga suupaa hiiroo sa
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Romaji,,0,0,0,,dasshu dasshu dasshu
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Romaji,,0,0,0,,kikku enddo dasshu
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Romaji,,0,0,0,,moete seishun kakenukero
Dialogue: 0,0:22:38.83,0:22:44.71,Opening Türkçe,,0,0,0,,sert bakışıyla geçiyor bir yıldız
Dialogue: 0,0:22:44.71,0:22:50.72,Opening Türkçe,,0,0,0,,tüm şehir söylüyor harika birisi olduğunu
Dialogue: 0,0:22:50.72,0:22:56.73,Opening Türkçe,,0,0,0,,kelebek sambası, zikzak samba
Dialogue: 0,0:22:56.73,0:23:02.86,Opening Türkçe,,0,0,0,,onun hakkındaki söylentiler\Nsambayı bile harekete geçiriyor
Dialogue: 0,0:23:02.86,0:23:08.95,Opening Türkçe,,0,0,0,,onun aksine bizim burada olma sebebimiz
Dialogue: 0,0:23:08.95,0:23:15.04,Opening Türkçe,,0,0,0,,top için delirmek
Dialogue: 0,0:23:15.04,0:23:18.19,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:18.19,0:23:21.08,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:21.08,0:23:26.09,Opening Türkçe,,0,0,0,,bir gün şimşek gibi vuruşum hedefine ulaşacak
Dialogue: 0,0:23:27.55,0:23:33.26,Opening Türkçe,,0,0,0,,o an bir süper kahraman olacağım işte ben
Dialogue: 0,0:23:33.26,0:23:36.18,Opening Türkçe,,0,0,0,,koş koş koş
Dialogue: 0,0:23:36.18,0:23:39.14,Opening Türkçe,,0,0,0,,sonuna kadar koş
Dialogue: 0,0:23:39.14,0:23:45.69,Opening Türkçe,,0,0,0,,alevlen ve ez geç delikanlı
