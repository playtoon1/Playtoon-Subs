Dialogue: 0,0:11:56.96,0:12:01.95,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:01.88,0:00:03.77,Default,,0,0,0,,{\i1}Yarı finallerin ikinci maçı.{\i0}
Dialogue: 0,0:00:03.77,0:00:08.94,Default,,0,0,0,,{\i1}Nankatsu SC, Misugi Jun liderliğindeki\NMusashi FC'ye karşı oynuyor.{\i0}
Dialogue: 0,0:00:08.94,0:00:12.36,Default,,0,0,0,,{\i1}Başta iki takım da denk\Nşekilde mücadele ediyordu.{\i0}
Dialogue: 0,0:00:12.36,0:00:15.28,Default,,0,0,0,,{\i1}Ne var ki teknik üstünlüğüyle Misugi...{\i0}
Dialogue: 0,0:00:15.83,0:00:21.29,Default,,0,0,0,,{\i1}...gizli planı ofsayt tuzağını da\Nkullanarak Tsubasa'yı geriye düşürdü.{\i0}
Dialogue: 0,0:00:21.29,0:00:23.58,Default,,0,0,0,,{\i1}Ofsayt durumu söz konusu!{\i0}
Dialogue: 0,0:00:25.58,0:00:27.08,Default,,0,0,0,,{\i1}Yine ofsayt!{\i0}
Dialogue: 0,0:00:27.08,0:00:33.55,Default,,0,0,0,,{\i1}Bununla birlikte Nankatsu'nun ataklarının\Nönü kesilmiş ve zor duruma sokulmuştu.{\i0}
Dialogue: 0,0:00:33.55,0:00:37.18,Default,,0,0,0,,{\i1}Benden çok daha teknik oynuyor.{\i0}
Dialogue: 0,0:00:37.18,0:00:42.14,Default,,0,0,0,,{\i1}Kaptan olarak takımını yönlendirme\Nkonusunda da benden daha başarılı.{\i0}
Dialogue: 0,0:00:42.14,0:00:47.10,Default,,0,0,0,,{\i1}Ayrıca bir de kalp rahatsızlığının\Nengeli söz konusu.{\i0}
Dialogue: 0,0:00:48.26,0:00:50.44,Default,,0,0,0,,{\i1}Gerçekten de kazanamam.{\i0}
Dialogue: 0,0:00:51.65,0:00:53.90,Default,,0,0,0,,{\i1}Misugi-kun'a denk olamam.{\i0}
Dialogue: 0,0:00:53.90,0:00:55.57,Default,,0,0,0,,{\i1}{\i1}Ne oldu Tsubasa-kun?!{\i0}{\i0}
Dialogue: 0,0:00:55.57,0:00:58.49,Default,,0,0,0,,{\i1}{\i1}Mücadele azmini kayıp mı ettin?!{\i0}{\i0}
Dialogue: 0,0:00:58.49,0:01:00.07,Default,,0,0,0,,{\i1}{\i1}Ona denk olamam.{\i0}{\i0}
Dialogue: 0,0:01:00.07,0:01:03.08,Default,,0,0,0,,{\i1}{\i1}Yalvarıyorum Tsubasa-kun! Bana gel!{\i0}{\i0}
Dialogue: 0,0:01:03.08,0:01:05.20,Default,,0,0,0,,{\i1}{\i1}Top sürüşümü durdur!{\i0}{\i0}
Dialogue: 0,0:01:05.20,0:01:06.66,Default,,0,0,0,,{\i1}{\i1}Denk olamam.{\i0}{\i0}
Dialogue: 0,0:01:10.82,0:01:12.13,Default,,0,0,0,,{\i1}Bitti.{\i0}
Dialogue: 0,0:01:14.80,0:01:18.55,Default,,0,0,0,,{\i1}Sanada-kun gol atıyor! 3-1!{\i0}
Dialogue: 0,0:01:18.55,0:01:21.14,Default,,0,0,0,,{\i1}{\i1}2 gol öndeler!{\i0}{\i0}
Dialogue: 0,0:01:21.14,0:01:24.94,Default,,0,0,0,,Millet, bu maç artık bizimdir.
Dialogue: 0,0:01:24.94,0:01:28.02,Default,,0,0,0,,Kendinizi tutmayın! Nankatsu'yu ezin geçin!
Dialogue: 0,0:01:28.02,0:01:29.81,Default,,0,0,0,,Tamam!
Dialogue: 0,0:03:05.33,0:03:10.08,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(288,746.333)}Bölüm 21:
Dialogue: 0,0:03:05.33,0:03:10.08,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(512,834.333)}Camdan Yıldız Oyuncu
Dialogue: 0,0:03:05.33,0:03:10.08,Default,,0,0,0,,{\fad(500,500)\pos(1476,1030)}Çeviri: ARE-YOU-SURE\N{\fs70}AreyousureSubs Sunar
Dialogue: 0,0:03:10.29,0:03:11.58,Default,,0,0,0,,Ayağa kalk Tsubasa!
Dialogue: 0,0:03:12.36,0:03:15.00,Default,,0,0,0,,Ayağa kalkmalısın Tsubasa!
Dialogue: 0,0:03:16.67,0:03:17.92,Default,,0,0,0,,Wakabayashi-san!
Dialogue: 0,0:03:18.62,0:03:19.92,Default,,0,0,0,,Wakabayashi.
Dialogue: 0,0:03:19.92,0:03:23.24,Default,,0,0,0,,Böyle bitmesine izin verme niyetinde misin?
Dialogue: 0,0:03:23.24,0:03:26.35,Default,,0,0,0,,Buraya gelmek için herkesin\Nverdiği çabayı boşa mı götüreceksin?
Dialogue: 0,0:03:26.35,0:03:31.48,Default,,0,0,0,,Nankatsu'nun futbolu... Senin\Nfutbolun bu kadar mı?!
Dialogue: 0,0:03:31.48,0:03:33.76,Default,,0,0,0,,Cevap ver Tsubasa!
Dialogue: 0,0:03:33.76,0:03:36.15,Default,,0,0,0,,W-Wakabayashi-kun.
Dialogue: 0,0:03:36.15,0:03:39.65,Default,,0,0,0,,Yarınki finalde oynayabilmek\Niçin o kadar yol geldim.{or "i came all this way" even}
Dialogue: 0,0:03:39.65,0:03:43.65,Default,,0,0,0,,Cevap ver Tsubasa!\NHavlu mu atıyorsun şimdiden?!
Dialogue: 0,0:03:44.90,0:03:47.32,Default,,0,0,0,,Wakabayashi haklı!
Dialogue: 0,0:03:47.32,0:03:49.62,Default,,0,0,0,,Böyle bitmesine izin mi vereceksin?!
Dialogue: 0,0:03:49.62,0:03:53.46,Default,,0,0,0,,Benimle birlikte Brezilya'ya\Ngelmeyecek misin Tsubasa?!{honeymoon intensifies}
Dialogue: 0,0:03:54.14,0:03:55.12,Default,,0,0,0,,Roberto...
Dialogue: 0,0:03:55.52,0:03:56.58,Default,,0,0,0,,Aynen öyle!
Dialogue: 0,0:03:56.58,0:03:59.50,Default,,0,0,0,,Kaybetmek sana yakışmaz!
Dialogue: 0,0:03:59.50,0:04:01.30,Default,,0,0,0,,Elinden geleni yap Tsubasa-kun!
Dialogue: 0,0:04:01.30,0:04:02.92,Default,,0,0,0,,Seni destekliyorum.
Dialogue: 0,0:04:02.92,0:04:04.81,Default,,0,0,0,,Bu yüzden kazan!
Dialogue: 0,0:04:07.20,0:04:10.93,Default,,0,0,0,,Tsubasa, böyle bitmesine izin\Nverecek birisi değilsin sen.{need better wording}{does this work? ofc <3}
Dialogue: 0,0:04:11.52,0:04:14.64,Default,,0,0,0,,Rakip olarak kabul ettiğim ilk kişisin sen.
Dialogue: 0,0:04:15.35,0:04:17.69,Default,,0,0,0,,Bu rakibimden daha güçlü birisi olamaz.
Dialogue: 0,0:04:17.69,0:04:21.02,Default,,0,0,0,,{\t(2818,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)}Sen kabul etsen bile ben etmem!
Dialogue: 0,0:04:21.61,0:04:23.07,Default,,0,0,0,,Ayağa kalk Tsubasa!
Dialogue: 0,0:04:23.07,0:04:27.95,Default,,0,0,0,,Bu kez birlikte Meiwa'dan\NHyuga Kojiro'yu yeneceğiz!
Dialogue: 0,0:04:28.95,0:04:31.33,Default,,0,0,0,,Ona iade edeceklerim var.
Dialogue: 0,0:04:31.33,0:04:34.96,Default,,0,0,0,,Tsubasa, sen de elemeler için ona borçlusun.
Dialogue: 0,0:04:35.70,0:04:39.84,Default,,0,0,0,,Buna rağmen mücadele\Netmeyecek misin Tsubasa?!
Dialogue: 0,0:04:39.84,0:04:41.84,Default,,0,0,0,,Aynen öyle Tsubasa-kun.
Dialogue: 0,0:04:41.84,0:04:46.99,Default,,0,0,0,,Misugi-kun da bunun sana\Nyakıştığını düşünmüyordur zaten.
Dialogue: 0,0:04:46.99,0:04:47.68,Default,,0,0,0,,Ne?
Dialogue: 0,0:04:48.37,0:04:50.30,Default,,0,0,0,,Böyle bitmesine izin veremezsin.
Dialogue: 0,0:04:50.30,0:04:54.44,Default,,0,0,0,,Böyle biterse takım arkadaşlarına,\Nseni destekleyen herkese...
Dialogue: 0,0:04:54.44,0:05:00.02,Default,,0,0,0,,...şimdiye kadar mücadele ettiğin rakiplerine\Nve bu futbol topuna bile ihanet etmiş olursun.
Dialogue: 0,0:05:16.08,0:05:17.16,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:05:17.16,0:05:18.42,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:05:19.96,0:05:21.04,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:05:24.86,0:05:26.55,Default,,0,0,0,,Özür dilerim millet.
Dialogue: 0,0:05:26.55,0:05:29.30,Default,,0,0,0,,Kaptan olmama rağmen böyle\Nbir zayıflık gösterdim.{seriously, wimpy? yowaki? showing weakness. you can always change it, better I guess, oh and also, yowaki is not showing weakness, it sure does suit this instance but, just writing this for info}
Dialogue: 0,0:05:29.30,0:05:30.83,Default,,0,0,0,,Haklısınız.
Dialogue: 0,0:05:30.83,0:05:33.48,Default,,0,0,0,,Böyle bitmesine izin veremeyiz.
Dialogue: 0,0:05:33.48,0:05:36.93,Default,,0,0,0,,Hepimizin futbola koyduğu\Nalın terini boşa çıkarmak üzereydim.{tsubasa the party pooper}
Dialogue: 0,0:05:36.93,0:05:38.44,Default,,0,0,0,,Yapacağım.{just do it!!}
Dialogue: 0,0:05:40.07,0:05:43.40,Default,,0,0,0,,2 gol atıp maçı çevireceğim!
Dialogue: 0,0:05:43.40,0:05:44.48,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:05:44.48,0:05:47.20,Default,,0,0,0,,Tsubasa iyi olduğuna göre\Nçantada keklik bu iş!
Dialogue: 0,0:05:47.20,0:05:49.57,Default,,0,0,0,,Evet! Gerçek maç şimdi başlıyor!
Dialogue: 0,0:05:49.57,0:05:51.41,Default,,0,0,0,,Nankatsu'nun neye bedel olduğunu gösterelim!
Dialogue: 0,0:05:52.04,0:05:53.33,Default,,0,0,0,,{\i1}Dikkatle izle Wakabayashi-kun.{\i0}
Dialogue: 0,0:05:53.33,0:05:55.37,Default,,0,0,0,,{\i1}Başaracağım.{\i0}
Dialogue: 0,0:05:55.37,0:05:56.87,Default,,0,0,0,,{\i1}Tsubasa...{\i0}
Dialogue: 0,0:05:59.45,0:06:02.67,Default,,0,0,0,,{\i1}Daha havlu atmamışsın Tsubasa-kun.{\i0}
Dialogue: 0,0:06:02.67,0:06:06.22,Default,,0,0,0,,{\i1}Nankatsu SC kendine gelmiş görünüyor.{\i0}
Dialogue: 0,0:06:06.22,0:06:09.68,Default,,0,0,0,,{\i1}Atağa yüklenecek gibi duruyorlar\Nama 2 skor gerideler!{\i0}
Dialogue: 0,0:06:09.68,0:06:13.68,Default,,0,0,0,,{\i1}Kalan 10 dakika içerisinde\N2 gol atabilecekler mi?{\i0}
Dialogue: 0,0:06:13.68,0:06:15.36,Default,,0,0,0,,Elinden geleni yap Tsubasa-kun!{or good luck}
Dialogue: 0,0:06:15.36,0:06:16.93,Default,,0,0,0,,Size güveniyoruz millet!
Dialogue: 0,0:06:18.43,0:06:20.94,Default,,0,0,0,,{\i1}Nankatsu'nun top vuruşuyla maç devam ediyor.{\i0}
Dialogue: 0,0:06:20.94,0:06:22.33,Default,,0,0,0,,Geliyorum Musashi!{for ya fools!!}
Dialogue: 0,0:06:22.33,0:06:24.69,Default,,0,0,0,,Tamamdır! Biz de Tsubasa'yı takip edelim!
Dialogue: 0,0:06:24.69,0:06:25.61,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:06:26.38,0:06:29.65,Default,,0,0,0,,{\i1}Tsubasa-kun bir kez daha\Nharika bir şekilde top sürüyor.{\i0} {need wording so bad}{re-worded}
Dialogue: 0,0:06:29.65,0:06:30.74,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:06:35.58,0:06:37.33,Default,,0,0,0,,Aynen böyle Tsubasa-kun!
Dialogue: 0,0:06:37.33,0:06:39.02,Default,,0,0,0,,{\i1}İşte bu Tsubasa.{\i0}
Dialogue: 0,0:06:39.02,0:06:44.00,Default,,0,0,0,,{\i1}Şu ana kadar Misugi'ye karşı teknik\Nyüzünden değil istek yüzünden kaybediyordun.{\i0} {pun intended}{kek}
Dialogue: 0,0:06:44.00,0:06:46.05,Default,,0,0,0,,{\i1}Bu azmi unutma...{\i0}
Dialogue: 0,0:06:46.05,0:06:51.63,Default,,0,0,0,,{\i1}...ve bir kez daha benim dahi futbolum\NTsubasa olarak ilerle!{\i0} {actually he says my tsubasa, I made it less creepy}
Dialogue: 0,0:06:52.84,0:06:55.68,Default,,0,0,0,,{\i1}Tsubasa-kun bu kez zıplayarak atlatıyor!{\i0}
Dialogue: 0,0:06:55.68,0:07:01.64,Default,,0,0,0,,{\i1}Yağmura rağmen ne yavaşlıyor\Nne de dengesini kaybediyor.{\i0}
Dialogue: 0,0:07:01.64,0:07:04.69,Default,,0,0,0,,{\i1}İşte gerçek Tsubasa-kun böyle olur!{\i0}
Dialogue: 0,0:07:07.01,0:07:07.82,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:07:10.53,0:07:11.74,Default,,0,0,0,,Ne?!
Dialogue: 0,0:07:11.74,0:07:13.99,Default,,0,0,0,,İade ediyorum Tsubasa-kun!{or "back at you, tsubasa!"}{NO U}
Dialogue: 0,0:07:15.98,0:07:17.37,Default,,0,0,0,,{\i1}Harika paslaşma!{\i0}
Dialogue: 0,0:07:17.37,0:07:19.37,Default,,0,0,0,,{\i1}Tsubasa-kun ve Misaki-kun'un birlikte oyunu!{\i0}
Dialogue: 0,0:07:19.87,0:07:22.06,Default,,0,0,0,,{\i1}Nankatsu'nun Altın İkilisi geri döndü!{\i0}
Dialogue: 0,0:07:22.06,0:07:24.00,Default,,0,0,0,,Harikasınız Tsubasa, Misaki!
Dialogue: 0,0:07:24.00,0:07:27.52,Default,,0,0,0,,{\i1}Ama kaleci Tazawa-kun ve Misugi-kun\Nönlerinde duruyor.{\i0}
Dialogue: 0,0:07:27.52,0:07:29.76,Default,,0,0,0,,{\i1}Şu an Misugi-kun'un tekniği daha iyi olabilir.{\i0}
Dialogue: 0,0:07:29.76,0:07:33.26,Default,,0,0,0,,{\i1}...ama bu mücadeleyi\Nazmimle kesinlikle kazanacağım!{\i0}
Dialogue: 0,0:07:33.26,0:07:34.88,Default,,0,0,0,,{\i1}Gel Tsubasa-kun!{\i0}
Dialogue: 0,0:07:34.88,0:07:37.01,Default,,0,0,0,,{\i1}Misugi Jun olarak sana izin veremyeceğim!{\i0}
Dialogue: 0,0:07:37.01,0:07:38.51,Default,,0,0,0,,{\i1}- Mücadele vakti!\N- Mücadele vakti!{\i0}
Dialogue: 0,0:07:44.92,0:07:46.56,Default,,0,0,0,,{\i1}Vay canına! Durdurdu!{\i0}
Dialogue: 0,0:07:49.19,0:07:50.19,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:07:50.19,0:07:51.32,Default,,0,0,0,,{\i1}Kazandım!{\i0}
Dialogue: 0,0:07:51.32,0:07:52.57,Default,,0,0,0,,Daha değil!
Dialogue: 0,0:07:53.36,0:07:54.28,Default,,0,0,0,,Ne?!{Waaaaaaaaas!!! Oh nein!}
Dialogue: 0,0:07:54.28,0:07:55.84,Default,,0,0,0,,{\i1}Harika bir hareket!{\i0}
Dialogue: 0,0:07:55.84,0:07:58.83,Default,,0,0,0,,{\i1}Tsubasa-kun düşerken topuğuyla\Ntopu havalandırıyor!{\i0}
Dialogue: 0,0:07:58.83,0:08:01.08,Default,,0,0,0,,{\i1}Ama Kido-kun topu uzaklaştırmak için koşuyor!{\i0}
Dialogue: 0,0:08:01.08,0:08:02.39,Default,,0,0,0,,Tsubasa zıpla!
Dialogue: 0,0:08:02.39,0:08:03.46,Default,,0,0,0,,Karnını kullan!
Dialogue: 0,0:08:03.46,0:08:05.75,Default,,0,0,0,,{\i1}Wakabayashi-kun.{\i0}
Dialogue: 0,0:08:08.88,0:08:13.01,Default,,0,0,0,,{\i1}Tsubasa-kun zor bir durumda\Nolmasına rağmen zıplıyor!{\i0} {and he now flies!} {kite-o-basa}
Dialogue: 0,0:08:14.73,0:08:16.64,Default,,0,0,0,,{\i1}Kaleci yetişemiyor!{\i0}
Dialogue: 0,0:08:16.64,0:08:17.64,Default,,0,0,0,,Başardı!
Dialogue: 0,0:08:19.60,0:08:22.02,Default,,0,0,0,,{\i1}Top direğe çarpıp sekiyor.{\i0} {bar?}
Dialogue: 0,0:08:23.06,0:08:26.02,Default,,0,0,0,,{\i1}Nankatsu'nun dirilen yıldız\Noyuncusu gol atamıyor!{\i0}
Dialogue: 0,0:08:26.02,0:08:28.94,Default,,0,0,0,,Tsubasa'nın çabalamasına rağmen\Nyeterli değil mi?
Dialogue: 0,0:08:28.94,0:08:30.69,Default,,0,0,0,,Daha bitmiş değil!
Dialogue: 0,0:08:31.44,0:08:34.12,Default,,0,0,0,,Nankatsu'nun topyekun atağını onlara gösterelim!
Dialogue: 0,0:08:34.12,0:08:34.89,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:34.89,0:08:35.70,Default,,0,0,0,,Millet!
Dialogue: 0,0:08:35.70,0:08:38.45,Default,,0,0,0,,{\i1}Nankatsu'nun mücadeleci ruhu\Nhenüz pes etmedi!{\i0} {fighting spirit he says}
Dialogue: 0,0:08:40.89,0:08:42.50,Default,,0,0,0,,{\i1}Urabe-kun topu çalıyor!{\i0}
Dialogue: 0,0:08:42.50,0:08:44.71,Default,,0,0,0,,Tamamdır! Gidelim Tsubasa!
Dialogue: 0,0:08:44.71,0:08:46.40,Default,,0,0,0,,Uzun pas atacaklar!
Dialogue: 0,0:08:46.40,0:08:47.04,Default,,0,0,0,,Hadi!
Dialogue: 0,0:08:47.04,0:08:48.48,Default,,0,0,0,,Ofsayt tuzağı!
Dialogue: 0,0:08:48.48,0:08:49.40,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:52.84,0:08:53.87,Default,,0,0,0,,{\i1}İşte bu!{\i0}
Dialogue: 0,0:08:53.87,0:08:56.18,Default,,0,0,0,,{\i1}Ofsayt çizgisini takip edeceğim!{\i0}
Dialogue: 0,0:08:59.30,0:09:00.76,Default,,0,0,0,,Şimdi pas verme!{dat kickblock <3}
Dialogue: 0,0:09:01.40,0:09:02.11,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:02.11,0:09:05.94,Default,,0,0,0,,{\i1}Misaki-kun, Urabe-kun'un pasını engelledi!{\i0}
Dialogue: 0,0:09:12.27,0:09:14.10,Default,,0,0,0,,Şimdi!
Dialogue: 0,0:09:14.10,0:09:16.10,Default,,0,0,0,,{\i1}Misaki-kun, Tsubasa-kun'a pas atıyor!{\i0}
Dialogue: 0,0:09:16.10,0:09:16.74,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:09:16.74,0:09:18.57,Default,,0,0,0,,Bu kez gol at Tsubasa!
Dialogue: 0,0:09:18.57,0:09:20.83,Default,,0,0,0,,{\i1}Hala geçmesi gereken oyuncular ve kaleci var!{\i0}
Dialogue: 0,0:09:20.83,0:09:23.08,Default,,0,0,0,,{\i1}Bu ofsayt değil!{\i0}
Dialogue: 0,0:09:28.58,0:09:29.96,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:09:29.96,0:09:34.00,Default,,0,0,0,,{\i1}Tsubasa-kun ofsayt tuzağından kurtulup\Nzıplayarak harika bir voleyle gol atıyor!{\i0}
Dialogue: 0,0:09:34.00,0:09:35.63,Default,,0,0,0,,Başardım!
Dialogue: 0,0:09:35.63,0:09:37.63,Default,,0,0,0,,Tsubasa, güzel şuttu!
Dialogue: 0,0:09:37.63,0:09:39.51,Default,,0,0,0,,Başardın Tsubasa-kun!
Dialogue: 0,0:09:39.51,0:09:41.51,Default,,0,0,0,,Tsubasa-kun başardı.
Dialogue: 0,0:09:41.51,0:09:44.40,Default,,0,0,0,,{\i1}Yıldız oyuncunun geri döndüğünü\Nbelli eden harika bir şut!{\i0}
Dialogue: 0,0:09:44.40,0:09:47.14,Default,,0,0,0,,{\i1}Misaki-kun ile birlikte Nankatsu'nun\NAltın İkilisi de geri döndü.{\i0}
Dialogue: 0,0:09:47.14,0:09:48.72,Default,,0,0,0,,{\an8}Tsubasa-kun!
Dialogue: 0,0:09:47.50,0:09:48.72,Default,,0,0,0,,{\i1}3-2.{\i0}
Dialogue: 0,0:09:48.72,0:09:53.15,Default,,0,0,0,,{\i1}İkinci yarının 10. dakikasaında\NNankatsu'nun lideri yakalamasına bir gol kaldı!{\i0}
Dialogue: 0,0:09:53.15,0:09:54.53,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:09:54.53,0:09:56.89,Default,,0,0,0,,{\i1}Başardın Tsubasa.{\i0} {ffs , he did it yeah}
Dialogue: 0,0:09:56.89,0:10:00.78,Default,,0,0,0,,{\i1}Şu an teknik açıdan\NMisugi daha iyi olabilir.{\i0}
Dialogue: 0,0:10:01.36,0:10:05.79,Default,,0,0,0,,{\i1}Ama bunun tek sebebi\NMisugi'nin yeteneklerini geliştirmiş olması.{\i0}
Dialogue: 0,0:10:05.79,0:10:10.00,Default,,0,0,0,,{\i1}Aksine sen daha iyi bir\Noyuncu olmaya doğru ilerliyorsun.{\i0}
Dialogue: 0,0:10:10.00,0:10:12.42,Default,,0,0,0,,{\i1}Potansiyelin, azmin...{\i0}
Dialogue: 0,0:10:12.42,0:10:17.58,Default,,0,0,0,,{\i1}...ve de en önemlisi birlikte\Nbüyüyeceğin arkadaşlarla kutsanmışsın.{\i0}
Dialogue: 0,0:10:17.58,0:10:21.82,Default,,0,0,0,,Seni bu kadar mutlu\Ngörmeyeli uzun zaman olmuştu Roberto.
Dialogue: 0,0:10:23.41,0:10:26.34,Default,,0,0,0,,{\i1}Şimdi ofsayt tuzağımız da işe yaramaz oldu.{\i0}
Dialogue: 0,0:10:26.34,0:10:28.81,Default,,0,0,0,,{\i1}Güzel kendini toparladın Tsubasa-kun.{\i0}
Dialogue: 0,0:10:28.81,0:10:31.56,Default,,0,0,0,,{\i1}Bitmemiş bir meselemiz var!{\i0}
Dialogue: 0,0:10:31.56,0:10:35.76,Default,,0,0,0,,Hayatım, doktorun söylediği\Nsüre geçeli çok oldu.
Dialogue: 0,0:10:35.76,0:10:38.61,Default,,0,0,0,,Jun'u yedek kulübesine aldıralım.
Dialogue: 0,0:10:38.61,0:10:41.04,Default,,0,0,0,,Kojima, ısın.
Dialogue: 0,0:10:41.04,0:10:42.61,Default,,0,0,0,,Senin girmen gerekebilir.
Dialogue: 0,0:10:42.61,0:10:44.95,Default,,0,0,0,,Ne? T-Tamam.
Dialogue: 0,0:10:45.60,0:10:49.71,Default,,0,0,0,,Dinleyin. Şu an Nankatsu\Nkendini bir dalgaya kaptırmış geliyor.
Dialogue: 0,0:10:49.71,0:10:53.61,Default,,0,0,0,,Ruhumuzu ortaya koyarak\Nbu dalgayı atlatalım!
Dialogue: 0,0:10:53.61,0:10:54.34,Default,,0,0,0,,Evet!
Dialogue: 0,0:10:55.59,0:10:58.59,Default,,0,0,0,,{\i1}Musashi'nin top vuruşuyla\Nmaç devam ediyor.{\i0}
Dialogue: 0,0:10:58.59,0:11:01.34,Default,,0,0,0,,{\i1}Geliyorum Tsubasa ve Nankatsu!{\i0}
Dialogue: 0,0:11:01.34,0:11:04.35,Default,,0,0,0,,{\i1}Bir kez daha yeteneğimle\NNankatsu'nun üstünden geleceğim!{\i0}
Dialogue: 0,0:11:12.68,0:11:15.48,Default,,0,0,0,,Doktor, Kojiro'nun durumu nasıl?
Dialogue: 0,0:11:15.48,0:11:17.20,Default,,0,0,0,,Gün içerisinde o sıcağa maruz kalınca...
Dialogue: 0,0:11:17.20,0:11:21.44,Default,,0,0,0,,...birikmiş yorgunluğun ve zihinsel\Nstresin de eklenmesiyle...
Dialogue: 0,0:11:21.44,0:11:23.49,Default,,0,0,0,,...durumunu kötüleştirmiş görünüyor.
Dialogue: 0,0:11:23.49,0:11:26.16,Default,,0,0,0,,Aşırı efor gibi görünüyor.
Dialogue: 0,0:11:26.16,0:11:30.25,Default,,0,0,0,,Şu an ihtiyacı olan\Nyatak istirahati ve uyku.
Dialogue: 0,0:11:30.25,0:11:32.50,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:11:33.75,0:11:35.79,Default,,0,0,0,,Koç Kira, Hyuga-san nasıl?
Dialogue: 0,0:11:35.79,0:11:37.88,Default,,0,0,0,,Kaptanımız yarınki maçta oynayabilecek mi?
Dialogue: 0,0:11:38.92,0:11:40.42,Default,,0,0,0,,Endişelenmeyin!
Dialogue: 0,0:11:40.42,0:11:43.43,Default,,0,0,0,,Kojiro'nun bu mücadeleyi\Nkaçırması mümkün değil!
Dialogue: 0,0:11:43.43,0:11:45.05,Default,,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:11:46.26,0:11:52.98,Default,,0,0,0,,Şu an kaplanın dinlenmesi lazım sadece.\NYarınki finale güç toplaması için.
Dialogue: 0,0:12:03.02,0:12:07.70,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvası yarı\Nfinalinde Musashi FC ve Nankatsu SC.{\i0}
Dialogue: 0,0:12:07.70,0:12:09.95,Default,,0,0,0,,{\i1}Maçta çok az bir süre kalmasına rağmen...{\i0}
Dialogue: 0,0:12:09.95,0:12:12.24,Default,,0,0,0,,{\i1}...çok çekişmeli gidiyor.{\i0}
Dialogue: 0,0:12:13.46,0:12:16.08,Default,,0,0,0,,{\i1}İki takım da bardaktan boşalırcasına\Nyağan yağmurun altında mücadele ediyor!{\i0}
Dialogue: 0,0:12:17.63,0:12:19.71,Default,,0,0,0,,Dayanın Nankatsu!
Dialogue: 0,0:12:19.71,0:12:21.46,Default,,0,0,0,,Vakit elinizden geleni yapma vakti!
Dialogue: 0,0:12:23.30,0:12:25.04,Default,,0,0,0,,{\i1}Takımının bel kemiği...{\i0}
Dialogue: 0,0:12:25.04,0:12:27.39,Default,,0,0,0,,{\i1}...Misugi-kun'un enerjisi mi bitti?{\i0}
Dialogue: 0,0:12:27.39,0:12:29.76,Default,,0,0,0,,{\i1}Hareketleri yavaşlamaya başladı.{\i0}
Dialogue: 0,0:12:29.76,0:12:31.02,Default,,0,0,0,,Jun!
Dialogue: 0,0:12:31.02,0:12:31.93,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:12:34.30,0:12:37.56,Default,,0,0,0,,Hep senin borunun öteceğini sanma Misugi!
Dialogue: 0,0:12:39.01,0:12:40.83,Default,,0,0,0,,{\i1}Nankatsu sürekli mücadesle ediyor!{\i0}
Dialogue: 0,0:12:40.83,0:12:43.90,Default,,0,0,0,,{\i1}Ama Misugi-kun topu vermeyi reddediyor!{\i0}
Dialogue: 0,0:12:44.74,0:12:46.86,Default,,0,0,0,,Yağmurun altında nasıl\Nböyle harekete edebiliyor?!
Dialogue: 0,0:12:46.86,0:12:48.74,Default,,0,0,0,,Yorulmuş olması gerek!
Dialogue: 0,0:12:49.78,0:12:53.83,Default,,0,0,0,,{\i1}Bu kez Tsubasa-kun topu almaya geliyor!{\i0}
Dialogue: 0,0:12:53.83,0:12:57.29,Default,,0,0,0,,{\i1}Misugi-kun, her şeyimle geliyorum!{\i0}
Dialogue: 0,0:12:58.66,0:13:00.04,Default,,0,0,0,,{\i1}Topu aldı!{\i0}
Dialogue: 0,0:13:00.04,0:13:04.30,Default,,0,0,0,,{\i1}Tsubasa-kun bu kez Misugi-kun'dan\Nçok güzel bir şekilde topu aldı!{\i0}
Dialogue: 0,0:13:04.30,0:13:05.92,Default,,0,0,0,,Aynen böyle Tsubasa!
Dialogue: 0,0:13:05.92,0:13:07.80,Default,,0,0,0,,Futbol sadece teknik değildir!
Dialogue: 0,0:13:07.80,0:13:12.68,Default,,0,0,0,,Bazen tıpkı Hyuga'nın yaptığı gibi\Ngüce ve hıza ihtiyaç duyar!
Dialogue: 0,0:13:12.68,0:13:14.27,Default,,0,0,0,,Lanet olsun! Durdurun şunu!
Dialogue: 0,0:13:14.27,0:13:17.14,Default,,0,0,0,,{\i1}Musashi'nin defansı geri geliyor!{\i0}
Dialogue: 0,0:13:17.14,0:13:21.65,Default,,0,0,0,,{\i1}Saha çamurlu. Bu gidişle\Nyetişecekler! Ya hep ya hiç!{\i0}
Dialogue: 0,0:13:21.65,0:13:23.44,Default,,0,0,0,,Tamamdır! Bende!
Dialogue: 0,0:13:25.72,0:13:26.57,Default,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:13:26.57,0:13:29.96,Default,,0,0,0,,{\i1}Tsubasa-kun yerdeki suyu\Nkullanarak uzun bir mesafe kayıyor!{\i0}
Dialogue: 0,0:13:29.96,0:13:32.58,Default,,0,0,0,,{\i1}Musashi defansının koşuşundan daha hızlı!{\i0}
Dialogue: 0,0:13:32.58,0:13:33.58,Default,,0,0,0,,Ne?!
Dialogue: 0,0:13:33.58,0:13:36.66,Default,,0,0,0,,{\i1}Ve kayarken şut çekme pozisyonu alıyor!{\i0}
Dialogue: 0,0:13:39.62,0:13:40.76,Default,,0,0,0,,{\i1}Gol!{\i0}
Dialogue: 0,0:13:40.76,0:13:41.67,Default,,0,0,0,,{\i1}Beraberlik!{\i0}
Dialogue: 0,0:13:41.67,0:13:46.42,Default,,0,0,0,,{\i1}Islak sahayı zekice kullanması\Nsonucu Tsubasa-kun kayarak gol atıyor!{\i0}
Dialogue: 0,0:13:46.42,0:13:48.42,Default,,0,0,0,,Sonunda beraberliği sağladık!
Dialogue: 0,0:13:48.42,0:13:50.12,Default,,0,0,0,,Başardın Tsubasa-kun!
Dialogue: 0,0:13:50.12,0:13:52.43,Default,,0,0,0,,Yağmurlu sahayı da arkadaş edindin.
Dialogue: 0,0:13:55.06,0:13:57.98,Default,,0,0,0,,{\i1}N-Ne oluyor böyle?{\i0}
Dialogue: 0,0:13:57.98,0:14:03.57,Default,,0,0,0,,{\i1}Musashi FC'nin Kaptanı Misugi-kun\Ngöğsünü tutarak yerde kıvranıyor!{\i0}
Dialogue: 0,0:14:03.57,0:14:04.69,Default,,0,0,0,,Misugi-kun!
Dialogue: 0,0:14:04.69,0:14:05.61,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:14:05.61,0:14:06.82,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:14:06.82,0:14:08.57,Default,,0,0,0,,Jun!
Dialogue: 0,0:14:08.57,0:14:09.57,Default,,0,0,0,,Hayatım!
Dialogue: 0,0:14:11.49,0:14:13.95,Default,,0,0,0,,Oyuncu değişikliği! Kojima!
Dialogue: 0,0:14:13.95,0:14:14.73,Default,,0,0,0,,Tamam.
Dialogue: 0,0:14:14.73,0:14:19.58,Default,,0,0,0,,Bekleyin. Bekleyin lütfen. Koç...
Dialogue: 0,0:14:19.58,0:14:22.71,Default,,0,0,0,,Söz vermiştin.
Dialogue: 0,0:14:22.71,0:14:27.09,Default,,0,0,0,,Tüm maç boyunca oynayacağıma dair.
Dialogue: 0,0:14:27.09,0:14:28.84,Default,,0,0,0,,Misugi...
Dialogue: 0,0:14:28.84,0:14:32.91,Default,,0,0,0,,Millet, şimdiye kadar sakladığım için özür dilerim.
Dialogue: 0,0:14:32.91,0:14:36.06,Default,,0,0,0,,Gördüğünüz gibi kalp rahatsızlığım var.
Dialogue: 0,0:14:37.14,0:14:40.27,Default,,0,0,0,,Bu yüzden maçlarda oynama\Nmiktarım kısıtlıydı.
Dialogue: 0,0:14:40.27,0:14:43.10,Default,,0,0,0,,Ama bu maç farklı.
Dialogue: 0,0:14:43.10,0:14:47.28,Default,,0,0,0,,Nankatsu birkaç dakika oynarsam\Nyenebileceğimiz bir rakip değil.
Dialogue: 0,0:14:47.28,0:14:49.81,Default,,0,0,0,,Bu yüzden bu kararı verdim!
Dialogue: 0,0:14:49.81,0:14:52.66,Default,,0,0,0,,Bu son maçım olsa bile umurumda değil!
Dialogue: 0,0:14:52.88,0:14:55.34,Default,,0,0,0,,Karşılığında tüm maç boyunca oynayacak...
Dialogue: 0,0:14:55.34,0:14:59.13,Default,,0,0,0,,...ve son maçımda her şeyimi ortaya\Nkoyarak mücadele edeceğim!
Dialogue: 0,0:14:59.13,0:15:00.41,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:15:00.41,0:15:03.33,Default,,0,0,0,,Bu yüzden çıkmayı reddediyorum!
Dialogue: 0,0:15:03.33,0:15:07.92,Default,,0,0,0,,Tsubasa-kun, mücadelemiz daha bitmedi!
Dialogue: 0,0:15:07.92,0:15:09.12,Default,,0,0,0,,Misugi-kun...
Dialogue: 0,0:15:09.12,0:15:11.60,Default,,0,0,0,,Böyle devam et Jun!
Dialogue: 0,0:15:12.34,0:15:16.66,Default,,0,0,0,,Bugün sevdiğin futbolu oynaman\Nkonusunda kimse seni durdurmayacak.
Dialogue: 0,0:15:16.66,0:15:18.85,Default,,0,0,0,,Sonuna kadar tüm gücünle mücadele et!
Dialogue: 0,0:15:18.85,0:15:20.48,Default,,0,0,0,,Baba...
Dialogue: 0,0:15:20.48,0:15:23.60,Default,,0,0,0,,Kojima, oyuncu değişikliği olmayacak.
Dialogue: 0,0:15:23.60,0:15:26.98,Default,,0,0,0,,Misugi, maç sana emanet!
Dialogue: 0,0:15:26.98,0:15:28.35,Default,,0,0,0,,Koç...
Dialogue: 0,0:15:28.35,0:15:30.16,Default,,0,0,0,,Yapalım şunu Kaptan!
Dialogue: 0,0:15:30.16,0:15:32.42,Default,,0,0,0,,Sonuna kadar seni izleyeceğiz!
Dialogue: 0,0:15:32.42,0:15:33.61,Default,,0,0,0,,Çocuklar...
Dialogue: 0,0:15:33.61,0:15:35.70,Default,,0,0,0,,Misugi'nin kalp rahatsızlığı varmış!
Dialogue: 0,0:15:35.70,0:15:37.38,Default,,0,0,0,,Onun mu?!
Dialogue: 0,0:15:37.38,0:15:40.06,Default,,0,0,0,,Millet, her zamanki gibi oynayın.
Dialogue: 0,0:15:40.06,0:15:40.75,Default,,0,0,0,,Ne?
Dialogue: 0,0:15:41.24,0:15:45.84,Default,,0,0,0,,Mücadeleci ruhumuzla her şeyimizi\Nortaya koyarak karşılık vereceğiz!
Dialogue: 0,0:15:45.84,0:15:51.34,Default,,0,0,0,,{\i1}Tsubasa-kun, Misugi-kun'un kalp\Nrahatsızlığını biliyormuşsun.{\i0}
Dialogue: 0,0:15:51.86,0:15:56.10,Default,,0,0,0,,{\i1}Ulusal Genç Futbol Turnuvası yarı final\Nmaçının bitmesine sadece 7 dakika kaldı.{\i0}
Dialogue: 0,0:15:56.10,0:15:59.14,Default,,0,0,0,,{\i1}Misugi-kun'un vücudunda bir\Nsorun var gibi duruyor hala.{\i0}
Dialogue: 0,0:15:59.14,0:16:02.48,Default,,0,0,0,,{\i1}Göğsünü tutuyor ve orta sahaya geriledi.{\i0}
Dialogue: 0,0:16:02.48,0:16:04.07,Default,,0,0,0,,{\i1}Kaptan...{\i0}
Dialogue: 0,0:16:04.98,0:16:08.40,Default,,0,0,0,,{\i1}Musashi'nin top vuruşuyla maç devam ediyor.{\i0}
Dialogue: 0,0:16:08.40,0:16:11.07,Default,,0,0,0,,Biz de Kaptan'ımızın yükünü paylaşacağız!
Dialogue: 0,0:16:11.07,0:16:11.78,Default,,0,0,0,,Evet!
Dialogue: 0,0:16:11.78,0:16:13.36,Default,,0,0,0,,{\i1}Misugi-kun...{\i0}
Dialogue: 0,0:16:15.89,0:16:17.72,Default,,0,0,0,,{\i1}Tsubasa-kun topu çalıyor!{\i0}
Dialogue: 0,0:16:17.72,0:16:19.58,Default,,0,0,0,,{\i1}Musashi tarafına yaklaşıyor.{\i0}
Dialogue: 0,0:16:19.58,0:16:21.32,Default,,0,0,0,,Tamamdır, skoru tersine çevirme vakti!
Dialogue: 0,0:16:21.32,0:16:21.95,Default,,0,0,0,,Evet!
Dialogue: 0,0:16:21.95,0:16:25.29,Default,,0,0,0,,{\i1}Ama Tsubasa-kun'un önünde\NMisugi-kun duruyor!{\i0}
Dialogue: 0,0:16:27.90,0:16:30.82,Default,,0,0,0,,{\i1}Misugi-kun, rahatsızlığın olmasa...{\i0}
Dialogue: 0,0:16:30.82,0:16:33.55,Default,,0,0,0,,{\i1}...sevdiğin futbolu oynamaya devam edebilirdin.{\i0}
Dialogue: 0,0:16:35.55,0:16:37.25,Default,,0,0,0,,{\i1}Ama ben kaybetmeyeceğim.{\i0}
Dialogue: 0,0:16:37.25,0:16:38.85,Default,,0,0,0,,{\i1}Ben de futbolu çok seviyorum.{\i0}
Dialogue: 0,0:16:38.85,0:16:43.31,Default,,0,0,0,,{\i1}Sevdiğim futbolda kimseye kaybedemem!{\i0}
Dialogue: 0,0:16:43.31,0:16:46.90,Default,,0,0,0,,{\i1}Olmuyor! Misugi-kun hala hareket edemiyor!{\i0}
Dialogue: 0,0:16:51.60,0:16:53.07,Default,,0,0,0,,Olamaz! Misugi-san!
Dialogue: 0,0:16:53.07,0:16:56.28,Default,,0,0,0,,Sahanın Genç Asili çamurla kaplandı.
Dialogue: 0,0:16:56.28,0:16:57.62,Default,,0,0,0,,Kaptan...
Dialogue: 0,0:16:57.62,0:16:59.52,Default,,0,0,0,,{\i1}Musashi umutsuzca savunma yapıyor!{\i0}
Dialogue: 0,0:16:59.52,0:17:00.87,Default,,0,0,0,,Al Kisugi-kun!
Dialogue: 0,0:17:01.28,0:17:02.24,Default,,0,0,0,,Bende!
Dialogue: 0,0:17:03.54,0:17:05.25,Default,,0,0,0,,{\i1}Kanda-kun güzel bir şekilde önünü kapatıyor!{\i0}
Dialogue: 0,0:17:05.25,0:17:06.19,Default,,0,0,0,,Gol atacağım!
Dialogue: 0,0:17:06.19,0:17:07.92,Default,,0,0,0,,{\i1}Taki-kun hava topuna kalkıyor!{\i0}
Dialogue: 0,0:17:07.92,0:17:09.33,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:17:09.33,0:17:11.42,Default,,0,0,0,,{\i1}Hayır, Sanada-kun önünü kapatıyor.{\i0}
Dialogue: 0,0:17:11.42,0:17:13.42,Default,,0,0,0,,{\i1}Izawa-kun şut çekiyor.{\i0}
Dialogue: 0,0:17:14.13,0:17:15.88,Default,,0,0,0,,{\i1}Kaleci uzaklaştırıyor!{\i0}
Dialogue: 0,0:17:15.88,0:17:18.30,Default,,0,0,0,,{\i1}Top, Honma-kun'a gidiyor.{\i0}
Dialogue: 0,0:17:18.30,0:17:19.88,Default,,0,0,0,,{\i1}Musashi zor bir durumu atlatıyor.{\i0}
Dialogue: 0,0:17:19.88,0:17:22.72,Default,,0,0,0,,Gel Honma! Pas ver!
Dialogue: 0,0:17:22.72,0:17:24.89,Default,,0,0,0,,Bana pas ver Honma!
Dialogue: 0,0:17:24.89,0:17:27.77,Default,,0,0,0,,Kaptan, sana güveniyorum!
Dialogue: 0,0:17:27.77,0:17:29.73,Default,,0,0,0,,{\i1}Honma-kun'dan Misugi-kun'a pas.{\i0}
Dialogue: 0,0:17:29.73,0:17:32.02,Default,,0,0,0,,{\i1}Musashi karşı atağa çıkmak üzere.{\i0}
Dialogue: 0,0:17:32.02,0:17:32.61,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:17:33.46,0:17:37.20,Default,,0,0,0,,{\i1}Misugi-kun gücü tükenmenin\Neşiğindeyken top sürmeye başlıyor!{\i0}
Dialogue: 0,0:17:37.20,0:17:38.45,Default,,0,0,0,,Herkes geri dönsün!
Dialogue: 0,0:17:38.45,0:17:39.96,Default,,0,0,0,,{\i1}Acıyor.{\i0}
Dialogue: 0,0:17:39.96,0:17:43.52,Default,,0,0,0,,{\i1}Göğsüm... Kalbim patlayacak gibi hissediyorum.{\i0}
Dialogue: 0,0:17:43.52,0:17:48.25,Default,,0,0,0,,{\i1}Sahada her adım attığımda\Nkalbime bir bıçak saplanıyor.{\i0}
Dialogue: 0,0:17:48.25,0:17:51.72,Default,,0,0,0,,{\i1}Ama kalbim hala atıyor.{\i0}
Dialogue: 0,0:17:51.72,0:17:53.24,Default,,0,0,0,,{\i1}Top sürebilirim.{\i0}
Dialogue: 0,0:17:53.24,0:17:56.76,Default,,0,0,0,,{\i1}Hala zıplayabilir ve şut çekebilirim.{\i0}
Dialogue: 0,0:17:56.76,0:18:03.07,Default,,0,0,0,,{\i1}Baba, anne, menajer, koç, takım arkadaşlarım...{\i0}
Dialogue: 0,0:18:03.07,0:18:05.77,Default,,0,0,0,,{\i1}Ve beni şu ana kadar destekleyen kişiler...{\i0}
Dialogue: 0,0:18:06.46,0:18:08.67,Default,,0,0,0,,{\i1}Hepinize teşekkür ediyorum.{\i0}
Dialogue: 0,0:18:08.67,0:18:11.88,Default,,0,0,0,,{\i1}Misugi Jun olarak...\NMusashi FC Kaptanı olarak...{\i0}
Dialogue: 0,0:18:11.88,0:18:16.03,Default,,0,0,0,,{\i1}...herkes adına ölsem bile bu golü atacağım!{\i0}
Dialogue: 0,0:18:16.03,0:18:18.28,Default,,0,0,0,,{\i1}Misugi-kun çok hızlı hareket ediyor!{\i0}
Dialogue: 0,0:18:18.94,0:18:20.23,Default,,0,0,0,,Ne hız ama!
Dialogue: 0,0:18:20.23,0:18:23.41,Default,,0,0,0,,Top süren o olmasına rağmen\Nne kadar da hızlı gidiyor?!
Dialogue: 0,0:18:23.41,0:18:25.20,Default,,0,0,0,,{\i1}Bu gidişle ona yetişemeyeceğiz!{\i0}
Dialogue: 0,0:18:25.20,0:18:26.79,Default,,0,0,0,,{\i1}Bundan başka çarem yok!{\i0}
Dialogue: 0,0:18:26.79,0:18:30.12,Default,,0,0,0,,{\i1}Misaki-kun uzaktan kayarak\Nmüdahale etmeye geliyor!{\i0}
Dialogue: 0,0:18:30.12,0:18:32.13,Default,,0,0,0,,{\i1}Hızlanmak için sahadaki suyu kullanıyor!{\i0}
Dialogue: 0,0:18:32.13,0:18:33.13,Default,,0,0,0,,Harikasın Misaki!
Dialogue: 0,0:18:33.13,0:18:34.38,Default,,0,0,0,,Kaptan, dikkat et!
Dialogue: 0,0:18:34.38,0:18:37.26,Default,,0,0,0,,{\i1}Zıpla! Yükselip savuştur!{\i0}
Dialogue: 0,0:18:39.13,0:18:40.97,Default,,0,0,0,,{\i1}Yükselip savuşturuyor!{\i0}
Dialogue: 0,0:18:40.97,0:18:45.06,Default,,0,0,0,,{\i1}Saha bu kadar kayganken\Nnasıl o kadar yükseğe zıplıyor?{\i0}
Dialogue: 0,0:18:45.06,0:18:47.85,Default,,0,0,0,,{\i1}Ama orta defans Takasugi-kun peşinde!{\i0}
Dialogue: 0,0:18:47.85,0:18:49.60,Default,,0,0,0,,Seni durduracağım Misugi!
Dialogue: 0,0:18:49.60,0:18:52.10,Default,,0,0,0,,Dikkat et! Sol tarafta Misugi'nin kalbi var!
Dialogue: 0,0:18:53.40,0:18:54.15,Default,,0,0,0,,Jun!
Dialogue: 0,0:18:54.98,0:18:57.15,Default,,0,0,0,,{\i1}Dengesini kaybediyor!{\i0}
Dialogue: 0,0:18:57.15,0:18:58.40,Default,,0,0,0,,Misugi!
Dialogue: 0,0:18:59.98,0:19:04.20,Default,,0,0,0,,{\i1}Ama Misugi-kun düşerken bacağını\Nkullanarak topu tutmayı başarıyor!{\i0}
Dialogue: 0,0:19:05.28,0:19:07.15,Default,,0,0,0,,{\i1}Takasugi-kun devriliyor!{\i0}
Dialogue: 0,0:19:07.15,0:19:09.83,Default,,0,0,0,,{\i1}Şimdiye kadar görmediğimiz\Nkararlılıkta bir çocuk!{\i0}
Dialogue: 0,0:19:09.83,0:19:12.21,Default,,0,0,0,,{\i1}Misugi-kun şut çekebilecek mi peki?{\i0}
Dialogue: 0,0:19:12.21,0:19:15.37,Default,,0,0,0,,{\i1}Nankatsu Kaptanı Tsubasa-kun da dönüyor.{\i0}
Dialogue: 0,0:19:16.42,0:19:17.67,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:19:17.67,0:19:19.76,Default,,0,0,0,,{\i1}Harika mücadele ettin Misugi-kun.{\i0}
Dialogue: 0,0:19:20.28,0:19:21.93,Default,,0,0,0,,{\i1}Ama şu an kendimi tutmayacağım.{\i0}
Dialogue: 0,0:19:22.41,0:19:26.02,Default,,0,0,0,,{\i1}Tsubasa-kun, bu topu sana veremem.{\i0}
Dialogue: 0,0:19:26.02,0:19:28.18,Default,,0,0,0,,{\i1}Bu top benim topum.{\i0}
Dialogue: 0,0:19:28.18,0:19:30.14,Default,,0,0,0,,{\i1}Şut çekeceğim top!{\i0}
Dialogue: 0,0:19:30.94,0:19:32.99,Default,,0,0,0,,{\i1}Tsubasa-kun topu uzaklaştırıyor!{\i0}
Dialogue: 0,0:19:32.99,0:19:35.15,Default,,0,0,0,,{\i1}Ama Misugi-kun umutsuzca blokluyor!{\i0}
Dialogue: 0,0:19:36.61,0:19:40.99,Default,,0,0,0,,{\t(3401,$end,\1c&H000000&\3c&H000000&\2c&H000000&\4c&H000000&)\i1}Ne?! Top ikisinin üstünde yükseliyor!{\i0}
Dialogue: 0,0:19:44.63,0:19:45.95,Default,,0,0,0,,Gözlerim...
Dialogue: 0,0:19:45.95,0:19:47.95,Default,,0,0,0,,{\i1}Uzaklaştı! Uzaklaştırdım!{\i0}
Dialogue: 0,0:19:50.40,0:19:53.29,Default,,0,0,0,,Top... Topum...
Dialogue: 0,0:19:53.29,0:19:56.09,Default,,0,0,0,,Top! Top nerede?
Dialogue: 0,0:19:56.09,0:19:59.38,Default,,0,0,0,,Top nerede?!
Dialogue: 0,0:19:59.38,0:20:03.72,Default,,0,0,0,,Kaptan! Top hafif sağ tarafında önünde!
Dialogue: 0,0:20:04.53,0:20:06.97,Default,,0,0,0,,{\i1}Görebiliyorum. Görebiliyorum!{\i0}
Dialogue: 0,0:20:06.97,0:20:08.56,Default,,0,0,0,,{\i1}Topum...{\i0}
Dialogue: 0,0:20:10.93,0:20:12.21,Default,,0,0,0,,{\i1}...tam burada!{\i0}
Dialogue: 0,0:20:12.21,0:20:14.44,Default,,0,0,0,,{\i1}Misugi-kun bir saniye daha erken şut çekiyor!{\i0}
Dialogue: 0,0:20:15.19,0:20:17.38,Default,,0,0,0,,{\i1}Morisaki-kun yetişemiyor!{\i0}
Dialogue: 0,0:20:17.38,0:20:21.19,Default,,0,0,0,,{\i1}Gol! Misugi-kun azmiyle gol atıyor!{\i0}
Dialogue: 0,0:20:24.59,0:20:26.03,Default,,0,0,0,,{\i1}4-3!{\i0}
Dialogue: 0,0:20:26.03,0:20:29.54,Default,,0,0,0,,{\i1}Musashi, 2 dakikadan az bir süre\Nkalmışken gol atıp liderliği alıyor!{\i0}
Dialogue: 0,0:20:30.40,0:20:32.41,Default,,0,0,0,,Girdi...
Dialogue: 0,0:20:32.41,0:20:34.04,Default,,0,0,0,,Başardın Misugi-san!
Dialogue: 0,0:20:34.04,0:20:36.42,Default,,0,0,0,,Ne ısrarla attı.
Dialogue: 0,0:20:36.42,0:20:38.54,Default,,0,0,0,,Kaptan'ımızdan da bu beklenirdi!
Dialogue: 0,0:20:51.84,0:20:53.35,Default,,0,0,0,,Misugi-kun...
Dialogue: 0,0:21:03.75,0:21:05.17,Default,,0,0,0,,Atıyor.
Dialogue: 0,0:21:08.83,0:21:12.75,Default,,0,0,0,,Kalbim hala atıyor.
Dialogue: 0,0:21:13.95,0:21:15.42,Default,,0,0,0,,İyiyim!
Dialogue: 0,0:21:15.42,0:21:18.21,Default,,0,0,0,,Kalbim hala pes etmedi!
Dialogue: 0,0:21:18.21,0:21:19.21,Default,,0,0,0,,Misugi-kun!
Dialogue: 0,0:21:19.21,0:21:20.21,Default,,0,0,0,,Kaptan!
Dialogue: 0,0:21:20.21,0:21:21.21,Default,,0,0,0,,Jun!
Dialogue: 0,0:21:21.21,0:21:23.84,Default,,0,0,0,,Misugi-san, iyi misin?
Dialogue: 0,0:21:23.84,0:21:26.97,Default,,0,0,0,,Tsubasa-kun, bir gol önünüzdeyiz.
Dialogue: 0,0:21:28.22,0:21:33.35,Default,,0,0,0,,Bu golü koruyacağız ve\Nfinale çıkanlar Musashi olacak.
Dialogue: 0,0:21:36.60,0:21:37.77,Default,,0,0,0,,Misugi-kun...
Dialogue: 0,0:21:39.62,0:21:41.48,Default,,0,0,0,,{\i1}Maçta 2 dakikadan az bir süre kaldı.{\i0}
Dialogue: 0,0:21:41.48,0:21:47.54,Default,,0,0,0,,{\i1}Misugi-kun'un büyük çabasıyla oynaması\Nsonucu skor 4-3! Musashi bir golle önde!{\i0}
Dialogue: 0,0:21:47.54,0:21:49.26,Default,,0,0,0,,Ne oldu millet?!
Dialogue: 0,0:21:49.26,0:21:51.37,Default,,0,0,0,,Maç daha bitmedi!
Dialogue: 0,0:21:51.37,0:21:52.82,Default,,0,0,0,,Sadece bir gol!
Dialogue: 0,0:21:52.82,0:21:54.33,Default,,0,0,0,,Hala çevirebilirsiniz!
Dialogue: 0,0:21:54.33,0:21:56.74,Default,,0,0,0,,Aynen öyle! Kazanın Nankatsu!
Dialogue: 0,0:21:54.33,0:21:56.74,Default,,0,0,0,,{\an8}Elinizden geleni yapın!
Dialogue: 0,0:21:56.74,0:21:59.44,Default,,0,0,0,,Son düdük çalana kadar ne olacağı belli olmaz!
Dialogue: 0,0:21:59.44,0:22:01.25,Default,,0,0,0,,Tamamdır, elimizden geleni yapalım millet.
Dialogue: 0,0:22:01.25,0:22:03.88,Default,,0,0,0,,Evet. Maç henüz bitmedi.
Dialogue: 0,0:22:03.88,0:22:06.26,Default,,0,0,0,,Son ana kadar her şeyimizi ortaya koyalım!
Dialogue: 0,0:22:06.75,0:22:08.63,Default,,0,0,0,,{\i1}Bir gol büyük bir fark.{\i0}
Dialogue: 0,0:22:09.13,0:22:12.14,Default,,0,0,0,,{\i1}Ve sen de çok daha büyük\Nşeyler hissediyorsun Misugi-kun.{\i0}
Dialogue: 0,0:22:12.14,0:22:16.06,Default,,0,0,0,,{\i1}Ama futbolda gol atmak için 10 saniye yeter.{\i0}
Dialogue: 0,0:22:16.06,0:22:18.09,Default,,0,0,0,,{\i1}Kesinlikle sana yetişeceğim!{\i0}
Dialogue: 0,0:22:19.56,0:22:22.64,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:23:50.03,0:24:00.64,Default,,0,0,0,,Gelecek 22. Bölümde:\NBelirleyici Uzatmalar
