Dialogue: 0,0:00:00.29,0:00:03.89,Default,,0,0,0,,{\fad(500,500)\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}— Kapanış Töreni —
Dialogue: 0,0:00:01.28,0:00:05.89,Default - Top,,0,0,0,,{\i1}6. Ulusal Genç Futbol Turnuvası kazananı...{\i0}
Dialogue: 0,0:00:05.89,0:00:09.24,Default,,0,0,0,,{\i1}...Shizuoka Bölgesi temsilcisi Nankatsu SC.{\i0}
Dialogue: 0,0:00:09.24,0:00:10.07,Default,,0,0,0,,Biziz.
Dialogue: 0,0:00:14.99,0:00:16.96,Default,,0,0,0,,Tebrikler.
Dialogue: 0,0:00:16.96,0:00:18.57,Default,,0,0,0,,Çok teşekkürler.
Dialogue: 0,0:00:19.44,0:00:26.37,Default,,0,0,0,,{\i1}Şu an mor şampiyonluk flaması,\NNankatsu SC Kaptanı Ozora Tsubasa-kun'un ellerinde.{\i0}
Dialogue: 0,0:00:28.10,0:00:30.14,Default,,0,0,0,,Başardık!
Dialogue: 0,0:02:03.64,0:02:08.77,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}Bölüm 28:\NHerkes için Ayrılık Vakti
Dialogue: 0,0:02:03.64,0:02:08.77,Default,,0,0,0,,{\fad(500,500)\\pos(1496,1034.333)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:02:04.24,0:02:09.64,Default - Top,,0,0,0,,{\an8\i1}Şu an Kaptan Ozora Tsubasa-kun,\Nşampiyonluk flamasını göğe kaldırıyor!{\i0}
Dialogue: 0,0:02:09.64,0:02:12.77,Default,,0,0,0,,{\i1}Şampiyon Nankatsu SC'yi kutluyoruz!{\i0}
Dialogue: 0,0:02:12.77,0:02:14.90,Default,,0,0,0,,Başardık!
Dialogue: 0,0:02:14.90,0:02:17.03,Default,,0,0,0,,Yaşasın! Yaşasın!
Dialogue: 0,0:02:17.03,0:02:18.94,Default,,0,0,0,,Çok havalısın Tsubasa!
Dialogue: 0,0:02:18.94,0:02:19.99,Default,,0,0,0,,Harikasın!
Dialogue: 0,0:02:19.99,0:02:22.95,Default,,0,0,0,,Tebrikler Tsubasa-kun...
Dialogue: 0,0:02:22.95,0:02:27.43,Default,,0,0,0,,{\i1}Ayrıca Tsubasa-kun, turnuvanın\Nen değerli oyuncusu seçildi ve...{\i0}
Dialogue: 0,0:02:27.43,0:02:31.33,Default,,0,0,0,,{\i1}...31 golle turnuvanın gol kralı oldu.{\i0} {"the king of scorers" is the literal tl; i'm not too sure about using "golden boot/shoe"}
Dialogue: 0,0:02:31.33,0:02:34.62,Default,,0,0,0,,{\i1}Babası, Tsubasa kazandı.{\i0}
Dialogue: 0,0:02:34.62,0:02:36.25,Default,,0,0,0,,Başardı, Roberto.{aaaaaand he's gone}
Dialogue: 0,0:02:36.95,0:02:38.65,Default,,0,0,0,,Ne?
Dialogue: 0,0:02:38.65,0:02:39.76,Default,,0,0,0,,Roberto?
Dialogue: 0,0:02:39.76,0:02:45.81,Default,,0,0,0,,{\i1}Ve Tsubasa-kun'un ortağı Misaki-kun,\Ntoplamda 15 asistle birincilikte.{\i0} {i have no idea why i'm not being literal today}
Dialogue: 0,0:02:45.81,0:02:49.93,Default,,0,0,0,,{\i1}İşte turnuvanın en iyi 20 oyuncusu.{\i0}
Dialogue: 0,0:02:49.93,0:02:55.40,Default,,0,0,0,,{\i1}Bu gençlerin Japonya'nın futbol\Ngeleceğini belirleyeceğine şüphe yok!{\i0}
Dialogue: 0,0:02:56.77,0:02:59.69,Default,,0,0,0,,Tsubasa-kun, şampiyon olmanın nasıl\Nhissettirdiğini duyabilir miyiz?
Dialogue: 0,0:02:59.69,0:03:01.56,Default,,0,0,0,,Elbette! Çok mutluyum!{duh}
Dialogue: 0,0:03:01.56,0:03:03.78,Default,,0,0,0,,Şampiyon olduğunuza göre\Nsıradaki hayalin ne?
Dialogue: 0,0:03:03.78,0:03:07.29,Default,,0,0,0,,Roberto ile Brezilya'ya gideceğim!{kek, that's a dream indeed}
Dialogue: 0,0:03:10.34,0:03:12.72,Default,,0,0,0,,İkinci olduk!
Dialogue: 0,0:03:12.72,0:03:14.36,Default,,0,0,0,,Başınız dik olsun!
Dialogue: 0,0:03:14.36,0:03:15.28,Default,,0,0,0,,Evet.
Dialogue: 0,0:03:15.28,0:03:17.50,Default,,0,0,0,,Harika oynadın.{her mouth says subarashii, but not her tone}
Dialogue: 0,0:03:18.78,0:03:19.67,Default,,0,0,0,,Siz...
Dialogue: 0,0:03:19.67,0:03:26.18,Default,,0,0,0,,Hyuga Kojiro-kun, konuştuğumuz koşullar aynı\Nkalmak şartıyla seni Toho Akademisi'ne istiyoruz.
Dialogue: 0,0:03:27.38,0:03:29.93,Default,,0,0,0,,A-Ama Tsubasa'ya...
Dialogue: 0,0:03:29.93,0:03:34.44,Default,,0,0,0,,Evet. Tsubasa-kun'u da almayı planlıyoruz.
Dialogue: 0,0:03:34.44,0:03:41.44,Default,,0,0,0,,Ama onu forvet yerine\Noyun kurucu olarak almak istiyoruz.
Dialogue: 0,0:03:34.44,0:03:36.72,Default - Top,,0,0,0,,{\an8}Başardın Tsubasa!
Dialogue: 0,0:03:36.72,0:03:37.98,Default - Top,,0,0,0,,{\an8}Şampiyonluğunuzu kutlarım!
Dialogue: 0,0:03:37.98,0:03:38.94,Default - Top,,0,0,0,,{\an8}Teşekkürler!
Dialogue: 0,0:03:38.94,0:03:41.44,Default - Top,,0,0,0,,{\an8}- Başardınız harbiden.\N- Evet.
Dialogue: 0,0:03:41.44,0:03:46.55,Default,,0,0,0,,Baş forvet olarak seni almak\Nistiyoruz Hyuga-kun.
Dialogue: 0,0:03:46.55,0:03:47.20,Default,,0,0,0,,Ne?!
Dialogue: 0,0:03:47.20,0:03:52.37,Default,,0,0,0,,Böylelikle Toho Akademisi, ülke\Nçapında yenilmez olacak.
Dialogue: 0,0:03:52.37,0:03:57.29,Default,,0,0,0,,Tsubasa-kun ve Hyuga-kun'un\Nnihai altın ikilisi olacak.
Dialogue: 0,0:03:58.44,0:04:01.68,Default,,0,0,0,,B-Ben ve Tsubasa'nın ikilisi mi?
Dialogue: 0,0:04:01.68,0:04:03.42,Default,,0,0,0,,B-Bu harika!{really, takeshi? they are steling your bf there}
Dialogue: 0,0:04:03.42,0:04:05.51,Default,,0,0,0,,Yenilmez olacaksınız Kaptan!{lel, Waka#2's fallen for him too0}
Dialogue: 0,0:04:05.51,0:04:08.72,Default,,0,0,0,,Gelirsin değil mi, Hyuga-kun?
Dialogue: 0,0:04:08.72,0:04:10.72,Default,,0,0,0,,A-Ama...
Dialogue: 0,0:04:10.72,0:04:13.21,Default,,0,0,0,,Ne duruyorsun be?!
Dialogue: 0,0:04:13.21,0:04:14.74,Default,,0,0,0,,Gitsene Kojiro!
Dialogue: 0,0:04:14.74,0:04:17.38,Default,,0,0,0,,Hayalin gerçek olmadı mı?
Dialogue: 0,0:04:17.38,0:04:18.44,Default,,0,0,0,,Koç...
Dialogue: 0,0:04:18.44,0:04:19.78,Default,,0,0,0,,Abi!
Dialogue: 0,0:04:19.78,0:04:20.94,Default,,0,0,0,,Kojiro!
Dialogue: 0,0:04:20.94,0:04:23.19,Default,,0,0,0,,H-Hepiniz...
Dialogue: 0,0:04:23.24,0:04:26.14,Default,,0,0,0,,İkinciliğini kutlarız abi!
Dialogue: 0,0:04:26.14,0:04:27.99,Default,,0,0,0,,Harika iş çıkardın Kojiro!
Dialogue: 0,0:04:27.99,0:04:31.90,Default,,0,0,0,,Finalde Tsubasa-kun'a kaybetmek\Ngururundan bir şey eksiltmedi.
Dialogue: 0,0:04:31.90,0:04:34.03,Default,,0,0,0,,Cevabını şu an vermesen de olur.
Dialogue: 0,0:04:34.03,0:04:35.06,Default,,0,0,0,,Gidelim.
Dialogue: 0,0:04:35.06,0:04:35.79,Default,,0,0,0,,Tamam.
Dialogue: 0,0:04:36.98,0:04:38.79,Default,,0,0,0,,Abi...
Dialogue: 0,0:04:42.48,0:04:48.09,Default,,0,0,0,,B-Ben... Toho Akademisi'ne\Nkatılmak isterim!{shit i hate tl'ing 世話世になる}{kojiro-nii a cute!}
Dialogue: 0,0:05:13.54,0:05:16.79,Default,,0,0,0,,Misaki-kun, veda vakti geldi sayılır değil mi?
Dialogue: 0,0:05:17.44,0:05:18.79,Default,,0,0,0,,Evet.
Dialogue: 0,0:05:23.27,0:05:24.67,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:05:25.47,0:05:26.63,Default,,0,0,0,,Anne.
Dialogue: 0,0:05:26.63,0:05:30.34,Default,,0,0,0,,Durum kötü Tsubasa!\NOtelde bunu buldum!
Dialogue: 0,0:05:30.34,0:05:31.60,Default,,0,0,0,,Ne?
Dialogue: 0,0:05:31.60,0:05:37.02,Default,,0,0,0,,Roberto... Roberto tek başına\NBrezilya'ya dönmüş.
Dialogue: 0,0:05:37.02,0:05:38.23,Default,,0,0,0,,Ne?!{i want capital letters for this}
Dialogue: 0,0:05:43.32,0:05:46.32,Default - Top,,0,0,0,,# Tsubasa'ya #
Dialogue: 0,0:05:44.85,0:05:46.32,Default,,0,0,0,,Neden?
Dialogue: 0,0:05:46.32,0:05:50.49,Default,,0,0,0,,Söz vermişti. Neden?
Dialogue: 0,0:05:50.49,0:05:53.12,Default,,0,0,0,,Neden Roberto tek başına gitti?
Dialogue: 0,0:05:53.12,0:05:55.54,Default,,0,0,0,,Söylesenize çocuklar!\NRoberto neden böyle yaptı?!
Dialogue: 0,0:05:55.54,0:05:56.41,Default,,0,0,0,,Tsubasa...{they were like, the fuck boi how should we know}
Dialogue: 0,0:05:56.41,0:06:00.12,Default,,0,0,0,,Tsubasa-kun, şu an yola\Nçıkarsan belki de yetişirsin.
Dialogue: 0,0:06:01.18,0:06:04.88,Default,,0,0,0,,Aynen öyle! Acele edersen\Nhavaalanında yakalayabilirsin!
Dialogue: 0,0:06:04.88,0:06:06.14,Default,,0,0,0,,Amca!
Dialogue: 0,0:06:06.14,0:06:07.09,Default,,0,0,0,,Tamamdır!{HONK HONK}
Dialogue: 0,0:06:15.64,0:06:17.02,Default,,0,0,0,,Tsubasa-kun...
Dialogue: 0,0:06:17.78,0:06:20.52,Default,,0,0,0,,{\i1}Brezilya'ya gitmek en büyük hayalindi.{\i0}
Dialogue: 0,0:06:21.16,0:06:24.79,Default,,0,0,0,,{\i1}Roberto'yu yakalamalısın Tsubasa.{\i0}
Dialogue: 0,0:06:29.56,0:06:31.34,Default,,0,0,0,,{\i1}Sevgili Tsubasa,{\i0}
Dialogue: 0,0:06:31.34,0:06:33.45,Default,,0,0,0,,{\i1}Tsubasa, affet beni.{\i0}
Dialogue: 0,0:06:33.45,0:06:38.28,Default,,0,0,0,,{\i1}Seni Brezilya'ya götüremem.{\i0}
Dialogue: 0,0:06:38.28,0:06:42.98,Default,,0,0,0,,{\i1}Bildiğin gibi gözlerimde retina\Nayrılması denen bir hastalık var.{\i0}
Dialogue: 0,0:06:42.98,0:06:46.16,Default,,0,0,0,,{\i1}Bu yüzden futbol oynamaya devam edemem.{\i0}
Dialogue: 0,0:06:46.16,0:06:48.26,Default,,0,0,0,,{\i1}Hayattaki tek amacı futbol\Nolan ben için...{\i0}
Dialogue: 0,0:06:48.26,0:06:51.38,Default,,0,0,0,,{\i1}...büyük bir şok oldu bu bana.{\i0}
Dialogue: 0,0:06:51.38,0:06:58.16,Default,,0,0,0,,{\t(5868,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Ama dibe vurmuşken bana yaşama\Nisteği veren sendin Tsubasa.{\i0}
Dialogue: 0,0:06:58.22,0:07:01.73,Default,,0,0,0,,{\i1}Dahice futbol içgüdülerin\Nbeni çok etkiledi...{\i0}
Dialogue: 0,0:07:01.73,0:07:06.52,Default,,0,0,0,,{\i1}...ve seni dünyanın en iyi\Nfutbolcusu olarak yetiştirmek istedim.{\i0}
Dialogue: 0,0:07:06.52,0:07:12.07,Default,,0,0,0,,{\i1}Ama Tsubasa seni Brezilya'ya götüremem.{\i0}
Dialogue: 0,0:07:13.09,0:07:17.79,Default,,0,0,0,,{\i1}Seni götürürsem Ozora ailesi\Nparçalanmış olacak.{\i0} {A little too late for that thought, don't you think?}{roberto is like a fickle young girl}
Dialogue: 0,0:07:17.79,0:07:21.08,Default,,0,0,0,,{\i1}Ailelerin bir arada bulunması daha iyidir.{\i0}
Dialogue: 0,0:07:22.72,0:07:27.17,Default,,0,0,0,,{\i1}Ama seni götürmemenin asıl\Nsebebi daha çok benimle alakalı.{\i0}
Dialogue: 0,0:07:28.18,0:07:36.18,Default,,0,0,0,,{\i1}Sebebi ne olursa olsun futbolu bırakmış\Nbirisi olarak bir yüz karasıyım.{\i0}
Dialogue: 0,0:07:36.18,0:07:40.94,Default,,0,0,0,,{\i1}Bu yüzden hayatını gerçekten\Nfutbola adamak isteyen sana...{\i0} {You are serious about living your life\Nas a football player from now on.}
Dialogue: 0,0:07:40.94,0:07:42.69,Default,,0,0,0,,{\i1}...öğretebileceğim hiçbir şey yok.{\i0}
Dialogue: 0,0:07:42.69,0:07:48.90,Default,,0,0,0,,{\i1}Öğretebilsem bile sen ilerledikçe\Nantrenmanların da zorlaşacak...{\i0}
Dialogue: 0,0:07:48.90,0:07:52.90,Default,,0,0,0,,{\i1}...ve gözlerimi kaybetme\Nihtimalimden korkuyorum.{\i0}
Dialogue: 0,0:07:52.90,0:07:55.24,Default,,0,0,0,,{\i1}O zaman çok geç kalmış olacağız.{\i0}
Dialogue: 0,0:07:55.24,0:07:58.95,Default,,0,0,0,,{\i1}Durumu kabullenmesi gereken sensin Tsubasa.{\i0}
Dialogue: 0,0:08:01.00,0:08:04.07,Default,,0,0,0,,Olmuyor. Gerçekten telefonunu kapatmış.
Dialogue: 0,0:08:04.07,0:08:05.96,Default,,0,0,0,,Ulaşamıyorum.
Dialogue: 0,0:08:05.96,0:08:10.21,Default,,0,0,0,,{\i1}Roberto...\NSen yüz karası değilsin Roberto!{\i0}
Dialogue: 0,0:08:10.21,0:08:16.89,Default,,0,0,0,,{\i1}Bana futbolu... Gerçek futbolu\Nöğreten sendin Roberto!{\i0}
Dialogue: 0,0:08:19.18,0:08:20.22,Default,,0,0,0,,{\i1}Tsubasa...{\i0}
Dialogue: 0,0:08:20.22,0:08:24.69,Default,,0,0,0,,{\i1}Japonya'da kalsan bile\Neminim ki harika bir oyuncu olacaksın.{\i0}
Dialogue: 0,0:08:25.36,0:08:29.11,Default,,0,0,0,,{\i1}Bensiz bile eminim ki olursun.{\i0}
Dialogue: 0,0:08:29.95,0:08:32.99,Default,,0,0,0,,{\i1}Tek başıma Brezilya'ya döneceğim.{\i0}
Dialogue: 0,0:08:32.99,0:08:37.11,Default,,0,0,0,,{\i1}Burada, sonsuza dek\Nsenden ayrılacağım.{\i0}
Dialogue: 0,0:08:37.71,0:08:38.74,Default,,0,0,0,,{\i1}Tsubasa...{\i0}
Dialogue: 0,0:08:39.90,0:08:40.87,Default,,0,0,0,,{\i1}Elveda.{\i0}
Dialogue: 0,0:08:51.67,0:08:56.88,Default,,0,0,0,,{\i1}Roberto ile Brezilya'ya gitme\Nhayalimi gerçekleştirmek için çok çalıştım.{\i0}
Dialogue: 0,0:08:58.64,0:09:01.62,Default,,0,0,0,,{\i1}Söz verdiğim gibi şampiyon da oldum!{\i0}
Dialogue: 0,0:09:03.85,0:09:06.35,Default,,0,0,0,,{\i1}Neden tek başına dönüyorsun?{\i0}
Dialogue: 0,0:09:20.03,0:09:21.16,Default,,0,0,0,,{\i1}Roberto!{\i0}
Dialogue: 0,0:09:24.58,0:09:25.79,Default,,0,0,0,,{\i1}Roberto...{\i0}
Dialogue: 0,0:09:28.16,0:09:29.79,Default,,0,0,0,,{\i1}Roberto!{\i0}
Dialogue: 0,0:09:33.52,0:09:34.55,Default,,0,0,0,,{\i1}Roberto!{\i0}
Dialogue: 0,0:09:39.72,0:09:40.89,Default,,0,0,0,,{\i1}Roberto...{\i0}
Dialogue: 0,0:09:41.69,0:09:42.94,Default,,0,0,0,,{\i1}Neden?{\i0}
Dialogue: 0,0:09:45.26,0:09:47.89,Default,,0,0,0,,Neden tek başına gidiyorsun?!{ok, he actually says "why are you going back alone. change if you like to, I just feel like adding some more drama}
Dialogue: 0,0:09:47.89,0:09:51.04,Default,,0,0,0,,Roberto!
Dialogue: 0,0:09:55.07,0:10:00.07,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:10:00.07,0:10:03.91,Default,,0,0,0,,{\fad(500,500)\fscy110\fscx110\fsp4\fs60\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}— Ulusal Genç Futbol Turnuvası'ndan Birkaç Gün Sonra, Nankatsu Şehri —
Dialogue: 0,0:10:03.91,0:10:05.83,Default,,0,0,0,,# Kiralık #
Dialogue: 0,0:10:14.17,0:10:16.21,Default,,0,0,0,,Taro, toparlanman bitti mi?
Dialogue: 0,0:10:17.64,0:10:19.30,Default,,0,0,0,,Evet, hazırım.
Dialogue: 0,0:10:20.10,0:10:21.43,Default,,0,0,0,,O zaman gidelim artık.
Dialogue: 0,0:10:22.24,0:10:23.55,Default,,0,0,0,,Tamam.
Dialogue: 0,0:10:23.55,0:10:25.26,Default,,0,0,0,,# Nankatsu İlkokulu #
Dialogue: 0,0:10:25.26,0:10:27.06,Default,,0,0,0,,# Futbol Kulübü #
Dialogue: 0,0:10:27.66,0:10:29.18,Default,,0,0,0,,Kusura bakmayın çocuklar.
Dialogue: 0,0:10:29.18,0:10:31.55,Default,,0,0,0,,Hepinizi buraya kadar yol teptirdim.
Dialogue: 0,0:10:31.55,0:10:32.98,Default,,0,0,0,,Lafı mı olur be?
Dialogue: 0,0:10:32.98,0:10:37.70,Default,,0,0,0,,Misaki, Nankatsu SC'nin önemli\Nbir takım arkadaşı sonuçta.
Dialogue: 0,0:10:37.70,0:10:40.32,Default,,0,0,0,,Wakabayashi-san'dan da imzasını aldım.{better wording, he probs carried the ball to waka, as a faithful servant}
Dialogue: 0,0:10:40.32,0:10:43.71,Default,,0,0,0,,Yarın Misaki'yi yolcu etmeye\Ngeleceğini söyledi.
Dialogue: 0,0:10:43.71,0:10:46.73,Default,,0,0,0,,Tsubasa bugün de mi gelmedi?
Dialogue: 0,0:10:46.73,0:10:50.74,Default,,0,0,0,,Evet, şoktan kendisini odaya\Nkapatmış durumda hala.
Dialogue: 0,0:10:50.74,0:10:52.63,Default,,0,0,0,,Demek öyle.
Dialogue: 0,0:10:52.63,0:10:56.78,Default,,0,0,0,,Roberto yokken ne yapacak acaba?
Dialogue: 0,0:10:58.48,0:10:59.91,Default,,0,0,0,,Bir şeyler duydum ben.
Dialogue: 0,0:10:59.91,0:11:03.60,Default,,0,0,0,,Tsubasa, Toho Akademisi tarafından istenmedi mi?
Dialogue: 0,0:11:03.60,0:11:04.62,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:04.62,0:11:06.04,Default,,0,0,0,,Harika.
Dialogue: 0,0:11:06.04,0:11:09.36,Default,,0,0,0,,Toho Akademisi'nin onu istemesi...
Dialogue: 0,0:11:09.36,0:11:12.23,Default,,0,0,0,,Henüz gitmeye karar vermedi ki.
Dialogue: 0,0:11:12.23,0:11:15.96,Default,,0,0,0,,Bizimle birlikte Nankatsu\NOrtaokulu'na devam edebilir.
Dialogue: 0,0:11:15.96,0:11:21.32,Default,,0,0,0,,Ama Tsubasa gibi yetenekli birisi\NNankatsu Ortaokulu'nda yeteneklerini israf eder.
Dialogue: 0,0:11:21.32,0:11:28.83,Default,,0,0,0,,Tsubasa, Nankatsu'ya giderse Shutetsu\Nolarak bu kez kozlarımızı paylaşabiliriz ama.
Dialogue: 0,0:11:30.32,0:11:32.24,Default,,0,0,0,,Ne oldu Takasugi?
Dialogue: 0,0:11:32.24,0:11:39.22,Default,,0,0,0,,Ortaokul başlayınca Nankatsu SC'nin\Nparçalanacağını fark ettim.{way to screw the mood}
Dialogue: 0,0:11:41.62,0:11:47.93,Default,,0,0,0,,Bu yüzden Misaki'nin veda hediyesinde\NTsubasa'nın da bir parçası olmalı.
Dialogue: 0,0:11:51.93,0:11:53.69,Default,,0,0,0,,Emin misin Taro?
Dialogue: 0,0:11:53.69,0:11:55.44,Default,,0,0,0,,Herkese yalan söyledin.
Dialogue: 0,0:11:56.19,0:11:57.04,Default,,0,0,0,,Evet.
Dialogue: 0,0:11:59.73,0:12:01.52,Default,,0,0,0,,M-Misaki-kun!
Dialogue: 0,0:12:01.52,0:12:02.24,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:03.21,0:12:04.24,Default,,0,0,0,,Çocuklar!
Dialogue: 0,0:12:04.24,0:12:06.92,Default,,0,0,0,,Misaki! Neden elinde bagaj var?
Dialogue: 0,0:12:06.92,0:12:09.33,Default,,0,0,0,,Yarın yola çıkmayacak mıydınız?
Dialogue: 0,0:12:09.96,0:12:11.18,Default,,0,0,0,,Özür dilerim.
Dialogue: 0,0:12:11.18,0:12:14.71,Default,,0,0,0,,Sizi görünce ayrılmanın\Nzor olacağını düşündüm.
Dialogue: 0,0:12:14.71,0:12:16.79,Default,,0,0,0,,Çok zalimsin Misaki!
Dialogue: 0,0:12:16.79,0:12:18.46,Default,,0,0,0,,Özür dilerim...
Dialogue: 0,0:12:18.46,0:12:20.62,Default,,0,0,0,,Ishizaki, o zaman acele etmeliyiz.
Dialogue: 0,0:12:20.62,0:12:21.84,Default,,0,0,0,,Doğru ya!
Dialogue: 0,0:12:21.84,0:12:23.92,Default,,0,0,0,,Misaki, kaç otobüsüne bineceksin?
Dialogue: 0,0:12:25.01,0:12:27.09,Default,,0,0,0,,15 dakikaya gelecek olana.
Dialogue: 0,0:12:27.09,0:12:28.31,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:12:28.31,0:12:31.23,Default,,0,0,0,,Tamamdır, hemen Tsubasa'nın yanına uçuyorum ben.
Dialogue: 0,0:12:31.23,0:12:33.25,Default,,0,0,0,,Ben de Wakabayahi-san'ı arayacağım.
Dialogue: 0,0:12:33.25,0:12:35.02,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:12:36.15,0:12:38.02,Default,,0,0,0,,Çocuklar...
Dialogue: 0,0:12:38.72,0:12:40.27,Default,,0,0,0,,Ne?! Yok mu?!
Dialogue: 0,0:12:40.27,0:12:43.68,Default,,0,0,0,,Sanırım bugün de nehir kenarına gitmiştir.
Dialogue: 0,0:12:43.68,0:12:44.78,Default,,0,0,0,,Bir şey mi oldu?
Dialogue: 0,0:12:44.78,0:12:47.24,Default,,0,0,0,,Misaki bugün gidiyormuş.
Dialogue: 0,0:12:47.24,0:12:48.41,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:54.27,0:13:02.17,Default,,0,0,0,,{\i1}İleri derecede top sürme, yeni\Nşut çekme tekniği, etkili antrenman programı...{\i0}
Dialogue: 0,0:13:02.17,0:13:09.60,Default,,0,0,0,,{\i1}Bana bıraktığın defterde ihtiyaç\Nduyacağım her şey mevcut.{\i0}
Dialogue: 0,0:13:09.60,0:13:10.55,Default,,0,0,0,,{\i1}Ama...{\i0} {I wanted you roberto<3}
Dialogue: 0,0:13:13.89,0:13:19.48,Default,,0,0,0,,{\i1}Roberto, ben yine de Brezilya'ya gitmek istiyordum.{\i0} {serves you right with that hairdo}
Dialogue: 0,0:13:19.48,0:13:21.44,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:13:23.81,0:13:24.94,Default,,0,0,0,,Ishizaki-kun?
Dialogue: 0,0:13:24.94,0:13:26.83,Default,,0,0,0,,Durum kötü Tsubasa!
Dialogue: 0,0:13:26.83,0:13:27.95,Default,,0,0,0,,Misaki...{pregnant}{o m e g a v e r s e}{dead}
Dialogue: 0,0:13:33.32,0:13:35.08,Default,,0,0,0,,Otobüs geldi.
Dialogue: 0,0:13:42.47,0:13:45.56,Default,,0,0,0,,Ishizaki-kun, çabuk gel.
Dialogue: 0,0:13:47.05,0:13:49.30,Default,,0,0,0,,Taro, gidelim.{heartless fatty}
Dialogue: 0,0:13:49.30,0:13:50.58,Default,,0,0,0,,Tamam.
Dialogue: 0,0:13:51.39,0:13:53.39,Default,,0,0,0,,Görüşürüz millet.
Dialogue: 0,0:13:53.39,0:13:55.39,Default,,0,0,0,,Gidiyor musun Misaki?
Dialogue: 0,0:13:55.39,0:13:56.60,Default,,0,0,0,,Evet.
Dialogue: 0,0:13:56.60,0:13:59.35,Default,,0,0,0,,Tsubasa-kun'a da selam söyleyin.
Dialogue: 0,0:14:02.15,0:14:03.82,Default,,0,0,0,,Misaki, görüşürüz.
Dialogue: 0,0:14:03.82,0:14:05.24,Default,,0,0,0,,Kendine iyi bak Misaki.
Dialogue: 0,0:14:05.24,0:14:06.68,Default,,0,0,0,,Elveda.
Dialogue: 0,0:14:09.15,0:14:10.91,Default,,0,0,0,,- Kendine iyi bak!\N- Misaki!
Dialogue: 0,0:14:14.80,0:14:16.10,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:14:23.38,0:14:25.38,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:14:25.38,0:14:27.63,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:14:29.13,0:14:31.64,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:14:33.26,0:14:35.18,Default,,0,0,0,,Tsubasa-kun, elveda!
Dialogue: 0,0:14:35.18,0:14:36.93,Default,,0,0,0,,Kendine iyi bak!
Dialogue: 0,0:14:36.93,0:14:38.77,Default,,0,0,0,,Tsubasa.
Dialogue: 0,0:14:39.94,0:14:42.94,Default,,0,0,0,,Yakala Misaki-kun!{or you know, you guys could ship it as a cargo with less drama}
Dialogue: 0,0:14:49.32,0:14:52.78,Default,,0,0,0,,{\i1}# Ulusal takımda yine beraber oynayalım.\N- Ozora Tsubasa #{\i0} {or national team?}{i am in doubt too. zennihon works both ways}
Dialogue: 0,0:14:53.20,0:14:54.78,Default,,0,0,0,,Misaki-kun...
Dialogue: 0,0:14:58.30,0:15:00.29,Default,,0,0,0,,Teşekkürler Tsubasa-kun!
Dialogue: 0,0:15:00.29,0:15:02.79,Default,,0,0,0,,Teşekkürler çocuklar!
Dialogue: 0,0:15:09.18,0:15:12.42,Default,,0,0,0,,{\i1}Elveda...\NElveda Misaki-kun!{\i0}
Dialogue: 0,0:15:13.90,0:15:15.97,Default,,0,0,0,,Misaki de gitti demek.
Dialogue: 0,0:15:16.66,0:15:17.85,Default,,0,0,0,,Wakabayashi-kun.
Dialogue: 0,0:15:18.32,0:15:19.47,Default,,0,0,0,,Wakabayashi.
Dialogue: 0,0:15:20.35,0:15:22.06,Default,,0,0,0,,Misaki de mi?
Dialogue: 0,0:15:22.06,0:15:25.90,Default,,0,0,0,,Tsubasa, ben Almanya'ya gidiyorum.{kamm, wir haben cookies}{Kekseeeee *-*}{everbody wants to kill tsu}
Dialogue: 0,0:15:28.34,0:15:32.20,Default,,0,0,0,,{\i1}Genzo, gelecek sene ortaokula\Ngeçeceksin değil mi?{\i0}
Dialogue: 0,0:15:32.20,0:15:33.07,Default,,0,0,0,,{\i1}Evet.{\i0}
Dialogue: 0,0:15:34.27,0:15:40.43,Default,,0,0,0,,{\i1}Açıkçası Genzo, bu sene sana\Nkoçluk yaptığım son sene olabilir.{\i0}
Dialogue: 0,0:15:41.08,0:15:43.82,Default,,0,0,0,,{\i1}Japon Futbol Federasyonu...{\i0}
Dialogue: 0,0:15:43.82,0:15:48.73,Default,,0,0,0,,{\i1}...Almanya'da koçluk yapıp\Nyapamayacağımı sordu.{\i0}
Dialogue: 0,0:15:48.73,0:15:53.22,Default,,0,0,0,,{\i1}Japon futbolunun seviyesini yükseltmek\Niçin gidip görmek istiyorum.{\i0}
Dialogue: 0,0:15:53.22,0:15:55.47,Default,,0,0,0,,{\i1}B-Bu...{\i0}
Dialogue: 0,0:15:56.08,0:15:58.44,Default,,0,0,0,,{\i1}Gelecek sene ilkbahardan itibaren...{\i0}
Dialogue: 0,0:15:58.44,0:16:04.48,Default,,0,0,0,,{\i1}...2 yıl veya mümkünse daha uzun\Nsüre Avrupa futbolunu görmek istiyorum.{\i0}
Dialogue: 0,0:16:04.48,0:16:10.23,Default,,0,0,0,,{\i1}Durum böyle işte Genzo!\NSen de benimle gelmez misin?!{\i0} {you see, mikami-san is da real man unlike hobo liar roberto, being hobo is okay, liar? I DONT THINK SO}
Dialogue: 0,0:16:10.23,0:16:12.24,Default,,0,0,0,,{\t(1197,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Ne?!{\i0}
Dialogue: 0,0:16:13.74,0:16:16.03,Default,,0,0,0,,Almanya'ya mı gidiyorsun?
Dialogue: 0,0:16:16.03,0:16:22.04,Default,,0,0,0,,Tsubasa, Brezilya'ya gideceğini\Nduyduktan sonra ben de düşünmeye başladım.
Dialogue: 0,0:16:22.04,0:16:24.90,Default,,0,0,0,,Dünyaca ünlü bir oyuncu olmak istiyorsam...
Dialogue: 0,0:16:24.90,0:16:27.54,Default,,0,0,0,,...dünyanın kalanındaki\Nfutboldan eksik kalamam.{I should see how football is being played in the world.}
Dialogue: 0,0:16:27.54,0:16:32.00,Default,,0,0,0,,Alman ligi dünyanın en iyi liglerinden...
Dialogue: 0,0:16:32.00,0:16:35.54,Default,,0,0,0,,...ve harika kaleciler barındırıyor.{amazing how it didnt change for 50 years lol}{top left oliver kahn, bottom left jens lehmann, top right ter stegen ,bottom right manuel neuer}
Dialogue: 0,0:16:35.54,0:16:38.37,Default,,0,0,0,,Gitmem gereken yer Almanya.
Dialogue: 0,0:16:38.37,0:16:41.06,Default,,0,0,0,,Dünyanın en iyi kalecisi olmak istiyorum.{number one}
Dialogue: 0,0:16:41.06,0:16:43.31,Default,,0,0,0,,Wakabayashi-san...
Dialogue: 0,0:16:46.10,0:16:47.80,Default,,0,0,0,,Elinden geleni yap ve dön.
Dialogue: 0,0:16:47.80,0:16:52.02,Default,,0,0,0,,Eminim dünyanın en iyi\Nkalecisi olabilirsin Wakabayashi-kun.
Dialogue: 0,0:16:52.02,0:16:53.99,Default,,0,0,0,,Evet, elimden geleni yapacağım.
Dialogue: 0,0:16:53.99,0:16:59.83,Default,,0,0,0,,Ama bundan önce Tsubasa,\Nbenimle bir karşılaşmayı kabul eder misin?
Dialogue: 0,0:16:59.83,0:17:02.83,Default,,0,0,0,,Evet, seve seve.{thats exactly what I would ask for, context}
Dialogue: 0,0:17:03.04,0:17:07.04,Default,,0,0,0,,{\fad(500,500)\fscy110\fscx110\fsp4\fs55\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(350.666,915.999)}Bir Hafta Sonra
Dialogue: 0,0:17:13.34,0:17:18.34,Default,,0,0,0,,İlk karşılaşmamız ve ilk mücadelemiz de\Nburada olmuştu Wakabayashi-kun.
Dialogue: 0,0:17:19.06,0:17:21.85,Default,,0,0,0,,Aynen öyle Tsubasa.
Dialogue: 0,0:17:22.30,0:17:23.37,Default,,0,0,0,,Gel Tsubasa!
Dialogue: 0,0:17:23.37,0:17:25.04,Default,,0,0,0,,Birebir bir mücadele!
Dialogue: 0,0:17:25.04,0:17:26.10,Default,,0,0,0,,Tamamdır.
Dialogue: 0,0:17:26.10,0:17:27.58,Default,,0,0,0,,Tsubasa...
Dialogue: 0,0:17:27.58,0:17:29.10,Default,,0,0,0,,Wakabayashi-san...
Dialogue: 0,0:17:30.13,0:17:31.11,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:17:36.24,0:17:38.07,Default,,0,0,0,,Al bakalım Wakabayashi-kun!{didnt wanna tl as eat this lol}
Dialogue: 0,0:17:38.95,0:17:41.95,Default,,0,0,0,,{\i1}Sen de dahil kimseden\Nceza sahası dışından gol yemeyeceğim!{\i0}
Dialogue: 0,0:17:47.16,0:17:48.83,Default,,0,0,0,,G-Geçti!
Dialogue: 0,0:17:49.58,0:17:51.08,Default,,0,0,0,,Hayır, direğe çarptı!
Dialogue: 0,0:17:52.75,0:17:53.71,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:18:02.91,0:18:04.47,Default,,0,0,0,,Y-Yakaladı!
Dialogue: 0,0:18:13.69,0:18:15.78,Default,,0,0,0,,Wakabayashi-kun'dan da bu beklenirdi.
Dialogue: 0,0:18:17.04,0:18:18.78,Default,,0,0,0,,Az önceki sadece şanstı.
Dialogue: 0,0:18:18.78,0:18:22.03,Default,,0,0,0,,Top, rastgele atladığım yere geldi.
Dialogue: 0,0:18:31.12,0:18:34.30,Default,,0,0,0,,Tsubasa, Almanya'da profesyonel\Nbir oyuncu olana dek...
Dialogue: 0,0:18:34.30,0:18:36.36,Default,,0,0,0,,...Japonya'ya dönmeyi planlamıyorum.
Dialogue: 0,0:18:38.51,0:18:42.01,Default,,0,0,0,,Wakabayashi-kun, ben...
Dialogue: 0,0:18:47.34,0:18:49.98,Default,,0,0,0,,Ben herkesle birlikte\NNankatsu Ortaokulu'na gideceğim!{i think saying this takes more courage than LEAVING like everyone else}
Dialogue: 0,0:18:50.78,0:18:52.48,Default,,0,0,0,,Yaşasın!
Dialogue: 0,0:18:52.48,0:18:54.36,Default,,0,0,0,,Nankatsu Ortaokulu!
Dialogue: 0,0:18:54.36,0:18:57.57,Default,,0,0,0,,Yine Tsubasa ile birlikte oynayabileceğim!{sounds so wrong}{ofc you can ishi, all the predators are gone}
Dialogue: 0,0:18:57.57,0:18:59.63,Default,,0,0,0,,Hayallerimden vazgeçmedim.
Dialogue: 0,0:18:59.63,0:19:04.01,Default,,0,0,0,,Herkesle birlikte Nankatsu Ortaokulu'nda\Nmücadele ederek bir gün Brezilya'ya gideceğim.
Dialogue: 0,0:19:04.01,0:19:04.99,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:19:04.99,0:19:09.02,Default,,0,0,0,,O zaman bir sonraki karşılaşmamızda\NJapon Ulusal Takımı'nda olalım.
Dialogue: 0,0:19:09.02,0:19:09.50,Default,,0,0,0,,Evet.
Dialogue: 0,0:19:17.66,0:19:21.88,Default,,0,0,0,,{\i1}O zamana kadar elveda Tsubasa.{\i0}
Dialogue: 0,0:19:26.10,0:19:28.93,Default,,0,0,0,,{\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,911.999)}— 3 Yıl Sonra —
Dialogue: 0,0:19:30.35,0:19:34.91,Default,,0,0,0,,{\i1}Wakabayashi Genzo, son maçta da\Nharika kurtarışlar yaptı.{\i0}
Dialogue: 0,0:19:34.91,0:19:39.69,Default,,0,0,0,,{\i1}B takımının as kalecisi\Nolma yolunda başarmak üzere.{\i0} {says second group,}
Dialogue: 0,0:19:40.90,0:19:43.16,Default,,0,0,0,,{\i1}{hmph!}Gayet iyi.{\i0}
Dialogue: 0,0:19:46.54,0:19:48.54,Default,,0,0,0,,Hey Ishizaki!
Dialogue: 0,0:19:48.54,0:19:49.58,Default,,0,0,0,,Selam.
Dialogue: 0,0:19:49.58,0:19:51.83,Default,,0,0,0,,İlkbahar tatilin iyi miydi?{yuuiginisugosu is "having a good time" while yuuigi is worthwhile hmmmmmmmm}
Dialogue: 0,0:19:51.83,0:19:55.33,Default,,0,0,0,,{\fscy110\fscx110\fsp4\fs85\fnKozuka Gothic Pr6N B\blur0.6\bord3.7\c&HFFFFFF&\3c&H2C2C2C&\pos(960,869.332)}Nankatsu Ortaokulu Futbol Kulübü, 3. Sınıf\NRyo Ishizaki
Dialogue: 0,0:19:51.83,0:19:54.68,Default - Top,,0,0,0,,{\an8}İlkbahar tatili diyorsun ama...
Dialogue: 0,0:19:54.68,0:19:59.29,Default - Top,,0,0,0,,{\an8}...tek yaptığımız il turnuvasını\Nkazanıp yine şampiyon olmaktı.
Dialogue: 0,0:19:59.29,0:20:03.47,Default,,0,0,0,,3 günlük tatilin neresi iyi olacak?
