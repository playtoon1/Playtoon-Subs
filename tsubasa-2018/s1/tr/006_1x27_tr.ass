Dialogue: 0,0:00:00.83,0:00:06.77,Default,,0,0,0,,{\i1}6. Ulusal Genç Futbol Turnuvası'nın\Nsonuna doğru yaklaşıyoruz.{\i0}
Dialogue: 0,0:00:06.81,0:00:10.11,Default,,0,0,0,,{\i1}40 dakika sonucunda iki\Ntakım da şampiyon olamadı.{\i0}
Dialogue: 0,0:00:10.11,0:00:13.70,Default,,0,0,0,,{\i1}Çekişmeli maç birinci ve\Nikinci uzatmalarla devam etti.{\i0}
Dialogue: 0,0:00:13.70,0:00:16.82,Default,,0,0,0,,{\t(2856,$end,\1c&HFEFEFE&\3c&HFEFEFE&\2c&HFEFEFE&\4c&HFEFEFE&)\i1}Ve şu an 5 dakikaya girdik!{\i0}
Dialogue: 0,0:00:17.36,0:00:20.99,Default,,0,0,0,,{\i1}Nankatsu ve Meiwa'nın\N11 oyuncusunu her şeyini ortaya koyuyor...{\i0} {in literal, both elevens}
Dialogue: 0,0:00:20.99,0:00:22.87,Default,,0,0,0,,{\i1}...ama skor 2-2!{\i0}
Dialogue: 0,0:00:22.87,0:00:25.56,Default,,0,0,0,,{\i1}Zaferi göğüsleyecek taraf olacak mı?{\i0}
Dialogue: 0,0:00:25.56,0:00:28.88,Default,,0,0,0,,{\i1}Yoksa iki takım da\Nşampiyon mu olacak?{\i0}
Dialogue: 0,0:00:28.88,0:00:33.63,Default,,0,0,0,,{\i1}Turnuvanın son top vuruşu\Nhakemin düdüğüyle yapılacak.{\i0}
Dialogue: 0,0:00:33.63,0:00:37.39,Default,,0,0,0,,{\i1}Söz verdiğimiz gibi\Nilk yarıda gol yemedik.{\i0} {stopped them at 0 literal}
Dialogue: 0,0:00:37.39,0:00:40.26,Default,,0,0,0,,{\i1}Kalanı size emanet, Tsubasa ve Misaki.{\i0}
Dialogue: 0,0:00:40.26,0:00:42.08,Default,,0,0,0,,Tsubasa! Misaki!
Dialogue: 0,0:00:42.08,0:00:44.73,Default,,0,0,0,,İkinci yarıda altın ikiliye emanetiz!
Dialogue: 0,0:00:44.73,0:00:48.15,Default,,0,0,0,,{\i1}Bacağım kırılsa bile son ana dek oynayacağım!{\i0}
Dialogue: 0,0:00:48.15,0:00:50.15,Default,,0,0,0,,{\i1}Kesinlikle gol atacağım.{\i0}
Dialogue: 0,0:00:50.15,0:00:54.44,Default,,0,0,0,,{\i1}Yoksa ilk yarıdaki herkesin\Nçabasını boşa çıkarmış olacağım!{\i0}
Dialogue: 0,0:00:54.94,0:00:56.50,Default,,0,0,0,,{\i1}Gelecekseniz gelin!{\i0}
Dialogue: 0,0:00:56.50,0:00:58.41,Default,,0,0,0,,{\i1}Gol yiyeceğime ölürüm daha iyi.{\i0}
Dialogue: 0,0:00:58.41,0:00:59.78,Default,,0,0,0,,{\i1}Kaybetmeyeceğiz.{\i0}
Dialogue: 0,0:00:59.78,0:01:02.87,Default,,0,0,0,,{\i1}Ne tür bir plan kurduğunuz önemsiz!{\i0}
Dialogue: 0,0:01:02.87,0:01:04.66,Default,,0,0,0,,{\i1}Sadece atak yapacağız!{\i0}
Dialogue: 0,0:01:06.34,0:01:07.92,Default,,0,0,0,,Gidelim Misaki-kun!
Dialogue: 0,0:01:07.92,0:01:08.78,Default,,0,0,0,,Tamam!
Dialogue: 0,0:02:40.30,0:02:44.72,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(120,818.333)}Bölüm 27:\NZafer Vakti
Dialogue: 0,0:02:40.30,0:02:44.72,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs55\pos(1504,1022.333)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:02:43.43,0:02:44.84,Default - Top,,0,0,0,,Son 5 dakika!
Dialogue: 0,0:02:44.84,0:02:46.26,Default,,0,0,0,,Bastır Nankatsu!
Dialogue: 0,0:02:46.26,0:02:47.68,Default,,0,0,0,,Sakın kaybetme Meiwa!
Dialogue: 0,0:02:47.68,0:02:49.48,Default,,0,0,0,,Kesinlikle şampiyonsunuz!
Dialogue: 0,0:02:50.98,0:02:54.25,Default,,0,0,0,,Gelin! Son ana dek atak yapacağız!
Dialogue: 0,0:02:54.25,0:02:56.08,Default,,0,0,0,,Topu çalıp atağa çıkacağız!
Dialogue: 0,0:02:56.08,0:02:59.02,Default,,0,0,0,,Meiwa'nın futbolunu son\Nana dek göstereceğiz!
Dialogue: 0,0:02:59.02,0:03:00.07,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:03.49,0:03:05.50,Default,,0,0,0,,{\i1}Tsubasa-kun çalımlayarak geçiyor.{\i0}
Dialogue: 0,0:03:05.50,0:03:09.00,Default,,0,0,0,,{\i1}İlk yarıda dinlendiğini\Ngösteren harika hareketler!{\i0}  {It might be thanks to his preserving his energy during the first half, but he shows some extraordinary moves!}
Dialogue: 0,0:03:13.33,0:03:15.21,Default,,0,0,0,,{\i1}Kesinlikle gol atacağım!{\i0}
Dialogue: 0,0:03:16.71,0:03:17.59,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:03:17.59,0:03:20.84,Default,,0,0,0,,{\i1}Şimdi de rakiplerini kandırarak\Nharika bir pas atıyor!{\i0} {"no" is troublesome haha}
Dialogue: 0,0:03:20.84,0:03:22.76,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:03:22.76,0:03:25.97,Default,,0,0,0,,{\i1}Atlatıyor! Misaki-kun'un da\Nhareketleri çok iyi!{\i0}
Dialogue: 0,0:03:25.97,0:03:28.39,Default,,0,0,0,,{\i1}Nankatsu'nun altın ikilisi dirildi!{\i0} {way to jinx}
Dialogue: 0,0:03:28.39,0:03:29.81,Default,,0,0,0,,Tamamdır, başarabiliriz!
Dialogue: 0,0:03:31.70,0:03:33.72,Default,,0,0,0,,{\i1}Dengesini kaybetti!{\i0}
Dialogue: 0,0:03:33.72,0:03:35.85,Default,,0,0,0,,{\i1}Bacağındaki yaralanma ciddi gibi.{\i0}
Dialogue: 0,0:03:36.73,0:03:37.73,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:03:40.27,0:03:42.49,Default,,0,0,0,,{\i1}Hyuga-kun ileri çıkıp topu alıyor.{\i0} {hesitation might work better}
Dialogue: 0,0:03:42.49,0:03:44.83,Default,,0,0,0,,Tamamdır, golü atacağız!
Dialogue: 0,0:03:44.83,0:03:45.53,Default,,0,0,0,,Evet!
Dialogue: 0,0:03:45.53,0:03:49.91,Default,,0,0,0,,{\i1}Hyuga-kun ortadan hızla ilerlerken\NMeiwa hızlı bir atağa çıkıyor!{\i0}
Dialogue: 0,0:03:53.54,0:03:54.60,Default,,0,0,0,,Misaki işin altından\Nkalkmayacak mı gerçekten?
Dialogue: 0,0:03:53.54,0:03:55.25,Default - Top,,0,0,0,,Taro...
Dialogue: 0,0:03:55.25,0:03:56.88,Default,,0,0,0,,Millet! Sakin kalın!{Stay calm!}
Dialogue: 0,0:03:56.88,0:03:58.64,Default,,0,0,0,,Misaki'ye inanın!{no gen-chan, it should be "don't believe in misaki! just believe in me who believes in misaki!"}
Dialogue: 0,0:03:58.64,0:04:00.24,Default,,0,0,0,,Kesinlikle başaracaktır!{he'll do it}
Dialogue: 0,0:04:00.24,0:04:02.24,Default,,0,0,0,,Bu atağı durduracağız!
Dialogue: 0,0:04:02.24,0:04:02.88,Default,,0,0,0,,Evet.
Dialogue: 0,0:04:06.28,0:04:07.43,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:04:07.43,0:04:09.01,Default,,0,0,0,,Elinizden geleni yapın çocuklar!
Dialogue: 0,0:04:09.01,0:04:11.92,Default,,0,0,0,,{\i1}Bacağım da sınırına ulaştı.{\i0}
Dialogue: 0,0:04:11.92,0:04:17.02,Default,,0,0,0,,{\i1}Ama Meiwa'nın bu atağını\Nburada durdurmam gerek.{\i0} {However, I'll make sure to stop Meiwa's attack!}
Dialogue: 0,0:04:17.02,0:04:19.52,Default,,0,0,0,,{\i1}Yalvarıyorum. Biraz daha dayan bacağım.{\i0} {O MY RUBBER LEG}
Dialogue: 0,0:04:19.52,0:04:22.08,Default,,0,0,0,,{\i1}Herkes benim için...{\i0}
Dialogue: 0,0:04:22.08,0:04:23.05,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:04:23.05,0:04:25.59,Default,,0,0,0,,{\i1}Misaki Taro'nun sonu böyle mi olacaktı?{\i0}
Dialogue: 0,0:04:25.59,0:04:27.78,Default,,0,0,0,,{\i1}Son bir güç ver bana.{\i0}
Dialogue: 0,0:04:27.78,0:04:29.45,Default,,0,0,0,,{\i1}Baba!{\i0}
Dialogue: 0,0:04:29.45,0:04:31.29,Default,,0,0,0,,{\i1}Anne!{\i0}
Dialogue: 0,0:04:32.74,0:04:33.66,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:04:34.58,0:04:35.57,Default,,0,0,0,,Eyvah!
Dialogue: 0,0:04:35.57,0:04:38.21,Default,,0,0,0,,{\i1}Boşta olan Hyuga-kun pası alıyor!{\i0}
Dialogue: 0,0:04:38.21,0:04:40.71,Default,,0,0,0,,{\i1}Hyuga-kun şut çekiyor!{\i0}
Dialogue: 0,0:04:40.71,0:04:42.38,Default,,0,0,0,,{\i1}Gol olacak mı?!{\i0}
Dialogue: 0,0:04:43.76,0:04:45.65,Default,,0,0,0,,{\i1}Hayır, durduruyor!{\i0} {wtf is that?}
Dialogue: 0,0:04:45.65,0:04:48.51,Default,,0,0,0,,{\i1}Tsubasa-kun, Hyuga-kun'un şutunu engelliyor!{\i0}
Dialogue: 0,0:04:48.51,0:04:49.39,Default,,0,0,0,,Ne?!
Dialogue: 0,0:04:49.39,0:04:50.22,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:04:51.14,0:04:53.06,Default,,0,0,0,,Misaki-kun, karşı atak!{he's dying tsu, no time for quickies lold}
Dialogue: 0,0:04:53.06,0:04:56.05,Default,,0,0,0,,{\i1}Bacağındaki yaralanma sebebiyle\Noyuna kendini veremeyen Misaki-kun'a...{\i0}
Dialogue: 0,0:04:56.05,0:04:58.31,Default,,0,0,0,,{\i1}...Tsubasa-kun yine de pas gönderiyor.{\i0}
Dialogue: 0,0:04:58.31,0:05:01.32,Default,,0,0,0,,{\i1}Benim tek ortağım Misaki-kun.{\i0} {this sounds better than "my only partner is misaki"}
Dialogue: 0,0:05:01.32,0:05:03.14,Default,,0,0,0,,{\i1}Başarabilirsin Misaki-kun!{\i0}
Dialogue: 0,0:05:03.14,0:05:06.61,Default,,0,0,0,,{\i1}Son altın ikili oyunumuzu gösterelim!{\i0}
Dialogue: 0,0:05:07.38,0:05:08.49,Default,,0,0,0,,{\i1}Tsubasa-kun.{\i0}
Dialogue: 0,0:05:09.91,0:05:10.70,Default,,0,0,0,,{\i1}Baba!{\i0}
Dialogue: 0,0:05:11.29,0:05:12.37,Default,,0,0,0,,{\i1}Anne!{\i0}
Dialogue: 0,0:05:12.37,0:05:14.50,Default,,0,0,0,,{\i1}Son oyunum bu!{\i0}
Dialogue: 0,0:05:14.50,0:05:18.21,Default,,0,0,0,,{\i1}Misaki-kun bacağının acısına\Nkatlanarak ileri doğru çıkıyor!{\i0}
Dialogue: 0,0:05:22.17,0:05:23.13,Default,,0,0,0,,Ne?!
Dialogue: 0,0:05:24.59,0:05:25.59,Default,,0,0,0,,Misaki!
Dialogue: 0,0:05:25.59,0:05:26.72,Default,,0,0,0,,Misaki-kun!
Dialogue: 0,0:05:26.72,0:05:28.30,Default,,0,0,0,,{\i1}Tsubasa-kun da peşinde!{\i0}
Dialogue: 0,0:05:32.64,0:05:34.94,Default,,0,0,0,,{\i1}İşte sonunda!{\i0}
Dialogue: 0,0:05:34.94,0:05:38.14,Default,,0,0,0,,{\i1}Nankatsu'nun altın ikilisinin oyunu bu!{\i0}
Dialogue: 0,0:05:38.14,0:05:42.06,Default,,0,0,0,,{\i1}Defansı birbir atlatacak\Nharika bir pas senkronizasyonu!{\i0}
Dialogue: 0,0:05:42.06,0:05:44.57,Default,,0,0,0,,Misaki-kun, böyle devam!
Dialogue: 0,0:05:44.57,0:05:47.43,Default,,0,0,0,,Al bakalım Wakashimazu!
Dialogue: 0,0:05:50.11,0:05:52.91,Default,,0,0,0,,{\i1}Ne var ki gol olmuyor!{\i0}
Dialogue: 0,0:05:52.91,0:05:54.49,Default,,0,0,0,,Adamsın Wakashimazu!
Dialogue: 0,0:05:55.24,0:05:56.20,Default,,0,0,0,,Alıyorum.
Dialogue: 0,0:05:56.20,0:05:57.94,Default,,0,0,0,,{\i1}Ishizaki-kun topu kurtarıyor.{\i0}
Dialogue: 0,0:05:57.94,0:05:58.79,Default,,0,0,0,,Ishizaki-kun!{lol, they look like they've seen ishi be useful for the first time}
Dialogue: 0,0:05:58.79,0:06:00.42,Default,,0,0,0,,Tsubasa! Misaki!
Dialogue: 0,0:06:00.42,0:06:02.34,Default,,0,0,0,,Beni de sayın!
Dialogue: 0,0:06:02.34,0:06:03.17,Default,,0,0,0,,Alın!
Dialogue: 0,0:06:03.17,0:06:05.34,Default,,0,0,0,,{\i1}Ishizaki-kun orta açıyor.{\i0}
Dialogue: 0,0:06:05.34,0:06:07.84,Default,,0,0,0,,{\i1}Ne var ki durdurmak için Hyuga-kun var.{\i0}
Dialogue: 0,0:06:07.84,0:06:09.01,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:06:09.01,0:06:11.97,Default,,0,0,0,,{\i1}Misaki-kun'un röveşatası bu!{\i0}
Dialogue: 0,0:06:11.97,0:06:13.01,Default,,0,0,0,,Misaki!
Dialogue: 0,0:06:17.64,0:06:22.02,Default,,0,0,0,,{\i1}Ama zamanlamaları tamamen yanlış!{\i0}
Dialogue: 0,0:06:22.02,0:06:22.90,Default,,0,0,0,,Ne?!
Dialogue: 0,0:06:22.90,0:06:23.77,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:06:28.36,0:06:32.26,Default,,0,0,0,,{\i1}Misaki-kun tuzağa düşürmek için\Nyapmışken Tsubasa-kun röveşata vuruyor!{\i0}
Dialogue: 0,0:06:32.26,0:06:35.99,Default,,0,0,0,,{\i1}Nankatsu'nun altın ikilisinin\Nsonradan gelme röveşatası!{\i0}
Dialogue: 0,0:06:35.99,0:06:38.87,Default,,0,0,0,,Hadi!
Dialogue: 0,0:06:40.98,0:06:44.13,Default,,0,0,0,,{\i1}İ-İçeride! Gol!{\i0}
Dialogue: 0,0:06:49.13,0:06:51.00,Default,,0,0,0,,- Başardın!\N- Harikasın Tsubasa!
Dialogue: 0,0:06:51.00,0:06:52.43,Default,,0,0,0,,Harika gol!
Dialogue: 0,0:06:52.43,0:06:54.18,Default,,0,0,0,,{\an8}- İşte bu!\N- Başardık!
Dialogue: 0,0:06:52.43,0:06:56.02,Default,,0,0,0,,{\i1}Nankatsu'nun altın ikilisi harika\Nbir iş birliği sergiliyor.{\i0}
Dialogue: 0,0:06:56.02,0:06:59.67,Default,,0,0,0,,{\i1}Son uzatmanın 1.5 dakikası geçti...{\i0}
Dialogue: 0,0:06:59.67,0:07:02.56,Default,,0,0,0,,{\i1}...ve Nankatsu sonunda liderliği eline aldı!{\i0}
Dialogue: 0,0:07:02.56,0:07:04.66,Default,,0,0,0,,Tsubasa! Misaki!
Dialogue: 0,0:07:04.66,0:07:07.32,Default,,0,0,0,,Wakabayashi-san'ın planı işe yaradı.{KEIKAKU DOORI keikaku means plan}{ACCORDING TO KEIKAKU}
Dialogue: 0,0:07:07.32,0:07:09.61,Default,,0,0,0,,- Tsubasa!\N- Tsubasa...
Dialogue: 0,0:07:09.61,0:07:12.54,Default,,0,0,0,,{\i1}Hyuga-kun, Misaki-kun zıplayışına kandı.{\i0}
Dialogue: 0,0:07:12.54,0:07:15.74,Default,,0,0,0,,{\i1}Tsubasa-kun'un röveşatasını durduramadı.{\i0}
Dialogue: 0,0:07:15.74,0:07:21.39,Default,,0,0,0,,{\i1}Wakashimazu-kun bile bu şuta\Ntepki vermekte yetersiz kaldı.{\i0}
Dialogue: 0,0:07:21.39,0:07:22.37,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:23.14,0:07:26.88,Default,,0,0,0,,{\i1}Nankatsu'nun altın ikilisinin\Niş birliği mükemmel!{\i0}
Dialogue: 0,0:07:26.88,0:07:28.13,Default,,0,0,0,,Misaki-kun...
Dialogue: 0,0:07:28.13,0:07:29.09,Default,,0,0,0,,Tsubasa-kun!
Dialogue: 0,0:07:29.63,0:07:31.42,Default,,0,0,0,,{\i1}Aferin Taro.{\i0}
Dialogue: 0,0:07:31.42,0:07:32.93,Default,,0,0,0,,Taro...
Dialogue: 0,0:07:32.93,0:07:36.07,Default,,0,0,0,,{\i1}Ama hala 3 dakika var.{\i0}
Dialogue: 0,0:07:36.07,0:07:39.84,Default,,0,0,0,,{\i1}Acımasız kaplan Hyuga-kun'un\Npes etmesini bekleyen kimse yok.{\i0}
Dialogue: 0,0:07:39.84,0:07:41.49,Default,,0,0,0,,{\i1}Kaybetme Kojiro.{\i0}
Dialogue: 0,0:07:41.49,0:07:43.23,Default,,0,0,0,,{\i1}Umudunu yitirme!{\i0}
Dialogue: 0,0:07:43.23,0:07:44.84,Default,,0,0,0,,Abi...
Dialogue: 0,0:07:44.84,0:07:46.31,Default,,0,0,0,,Kojiro...
Dialogue: 0,0:07:46.31,0:07:49.22,Default,,0,0,0,,{\i1}Tsubasa ve Misaki'den de bu beklenirdi.{\i0}
Dialogue: 0,0:07:49.22,0:07:54.29,Default,,0,0,0,,{\i1}Sanki zihinsel olarak konuşuyormuş gibi\Nbir iş birliği sergiliyorsunuz.{\i0}
Dialogue: 0,0:07:54.29,0:07:57.28,Default,,0,0,0,,{\i1}Ama henüz kaybetmiş değilim!{\i0}
Dialogue: 0,0:07:58.78,0:08:01.75,Default,,0,0,0,,{\i1}Top vuruşuyla Meiwa FC\Nhemen atağa çıkıyor!{\i0}
Dialogue: 0,0:08:01.75,0:08:04.46,Default,,0,0,0,,{\i1}Beraberlik sağlamaya yetecek azimleri var!{\i0}
Dialogue: 0,0:08:04.46,0:08:07.17,Default,,0,0,0,,Millet! Öne geçtik diye gardınızı indirmeyin!{not sure about the first half of this sentece}
Dialogue: 0,0:08:07.17,0:08:09.06,Default,,0,0,0,,Dikkatinizi verin!
Dialogue: 0,0:08:09.06,0:08:09.88,Default,,0,0,0,,Tamam!
Dialogue: 0,0:08:11.55,0:08:14.38,Default,,0,0,0,,Sadece biraz daha dayan.\NYalvarıyorum.
Dialogue: 0,0:08:14.86,0:08:16.18,Default,,0,0,0,,Sık dişini Misaki-kun.
Dialogue: 0,0:08:16.18,0:08:17.57,Default,,0,0,0,,Çok az kaldı.
Dialogue: 0,0:08:17.57,0:08:18.73,Default,,0,0,0,,Evet.
Dialogue: 0,0:08:18.73,0:08:20.71,Default,,0,0,0,,{\i1}Tsubasa... Misaki...{\i0}
Dialogue: 0,0:08:20.71,0:08:25.14,Default,,0,0,0,,{\i1}Tek başıma futbol\Noynayamayacağımı öğrettiniz bana.{\i0}
Dialogue: 0,0:08:25.90,0:08:26.99,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:08:26.99,0:08:30.94,Default,,0,0,0,,{\i1}Ayrıca futbolun sadece\Ngüçten ibaret olmadığını.{\i0}
Dialogue: 0,0:08:30.94,0:08:35.33,Default,,0,0,0,,{\i1}Ama en önemlisi size karşı\Nmücadele ederken hissettiğim şey...{\i0}
Dialogue: 0,0:08:35.33,0:08:36.95,Default,,0,0,0,,{\i1}...futbolun gerçek zevkiydi!{\i0}
Dialogue: 0,0:08:36.95,0:08:40.92,Default,,0,0,0,,{\i1}Futbol gerçekten de çok zevkli.{\i0} {or, was actually a fun thing to do}{fun things are fun!}
Dialogue: 0,0:08:41.95,0:08:45.05,Default,,0,0,0,,{\i1}Hyuga-kun hızlıca Nankatsu\Nkalesine doğru ilerliyor.{\i0}
Dialogue: 0,0:08:45.05,0:08:47.54,Default,,0,0,0,,{\i1}Meiwa'nın atağı çok dengeli.{\i0}
Dialogue: 0,0:08:47.54,0:08:48.40,Default,,0,0,0,,Durdurun!
Dialogue: 0,0:08:48.40,0:08:49.92,Default,,0,0,0,,Yaklaşmasına izin vermeyin!
Dialogue: 0,0:08:50.39,0:08:55.42,Default,,0,0,0,,{\i1}Şimdiye kadar sadece ailem için\Nveya kazanmak için mücadele ettim.{\i0}
Dialogue: 0,0:08:56.30,0:09:02.47,Default,,0,0,0,,{\i1}Ama rakibim sizken futbol\Noynamanın gerçek zevkini tattım.{\i0}
Dialogue: 0,0:09:04.55,0:09:07.06,Default,,0,0,0,,{\i1}Hyuga-kun bu kez gücüyle geçiyor!{\i0}
Dialogue: 0,0:09:07.06,0:09:08.73,Default,,0,0,0,,{\i1}Yine de...{\i0}
Dialogue: 0,0:09:08.73,0:09:12.07,Default,,0,0,0,,{\i1}...kazanmaktan vazgeçemem!{\i0}
Dialogue: 0,0:09:12.07,0:09:14.44,Default,,0,0,0,,{\i1}Benim futbolum kazanmayı hedefler.{\i0}
Dialogue: 0,0:09:14.44,0:09:16.32,Default,,0,0,0,,{\i1}Yenilmez bir futboldur!{\i0}
Dialogue: 0,0:09:16.32,0:09:18.36,Default,,0,0,0,,{\i1}Ishizaki-kun'dan bir müdahale!{\i0}
Dialogue: 0,0:09:18.36,0:09:22.12,Default,,0,0,0,,{\i1}Ama Hyuga-kun harika bir\Nzamanlamayla zıplayarak atlatıyor!{\i0}
Dialogue: 0,0:09:22.12,0:09:25.87,Default,,0,0,0,,{\i1}Eğlenceli bile olsa\Nkaybedersen bir anlamı olmaz!{\i0}
Dialogue: 0,0:09:25.87,0:09:29.25,Default,,0,0,0,,{\i1}Hyuga-kun hemen şut\Nçekme pozisyonu alıyor!{\i0}
Dialogue: 0,0:09:29.25,0:09:31.63,Default,,0,0,0,,Bu durumda gol atmana izin veremem!
Dialogue: 0,0:09:31.63,0:09:32.50,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:09:32.50,0:09:35.18,Default,,0,0,0,,{\i1}Tsubasa-kun engellemek için zıplıyor!{\i0}
Dialogue: 0,0:09:35.18,0:09:37.42,Default,,0,0,0,,Al Takeshi!
Dialogue: 0,0:09:37.42,0:09:42.10,Default,,0,0,0,,{\i1}Hyuga-kun hızlı bir kararlar\Nşut çekmek yerine pas veriyor!{\i0}
Dialogue: 0,0:09:42.10,0:09:44.65,Default,,0,0,0,,{\i1}Boşta olan Sawada-kun koşuyor.{\i0}
Dialogue: 0,0:09:44.65,0:09:46.85,Default,,0,0,0,,{\i1}Meiwa için gol şansı!{\i0}
Dialogue: 0,0:09:47.56,0:09:49.85,Default,,0,0,0,,{\i1}Sawada-kun şut çekiyor!{\i0}
Dialogue: 0,0:09:50.65,0:09:53.65,Default,,0,0,0,,{\i1}Wakabayashi-kun bir kez daha durduruyor!{\i0}
Dialogue: 0,0:09:54.90,0:09:56.03,Default,,0,0,0,,Başardın!
Dialogue: 0,0:09:56.03,0:09:57.99,Default,,0,0,0,,Güzel yakaladın Wakabayashi-san!
Dialogue: 0,0:10:00.32,0:10:05.33,Default,,0,0,0,,{\i1}Meiwa için büyük bir şans olmasına rağmen\Nkaleci Wakabayashi-kun'un iyi oynamasıyla...{\i0}
Dialogue: 0,0:10:05.33,0:10:06.87,Default,,0,0,0,,{\i1}...yine golü bulamadılar!{\i0}
Dialogue: 0,0:10:07.79,0:10:09.61,Default,,0,0,0,,Özür dilerim Hyuga-san.
Dialogue: 0,0:10:09.61,0:10:11.38,Default,,0,0,0,,Kafana takma Takeshi.
Dialogue: 0,0:10:11.38,0:10:13.71,Default,,0,0,0,,Hala 2 dakikamız var.
Dialogue: 0,0:10:13.71,0:10:17.72,Default,,0,0,0,,Her dakika şut çekersem kazanabiliriz.
Dialogue: 0,0:10:17.72,0:10:22.57,Default,,0,0,0,,Tsubasa ve Misaki gibi\NWakabayashi'nin de bacağı yaralı.{and whose fault is that? wasnt because of him?} {no actually}
Dialogue: 0,0:10:22.57,0:10:26.85,Default,,0,0,0,,Son kurtarışta yaralanmasının\Nciddi olduğu belli oluyordu.
Dialogue: 0,0:10:26.85,0:10:30.74,Default,,0,0,0,,Rahatça şut çekebilirsem Wakabayashi'nin\Nördüğü duvarı kırıp geçebilirim.
Dialogue: 0,0:10:30.74,0:10:33.16,Default,,0,0,0,,Bu maçı kazanabiliriz!
Dialogue: 0,0:10:36.07,0:10:41.07,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:10:41.07,0:10:44.37,Default,,0,0,0,,{\i1}Hala Nankatsu 3-2 önde.{\i0}
Dialogue: 0,0:10:44.37,0:10:46.51,Default,,0,0,0,,{\i1}Sadece 2 dakika kaldı.{\i0}
Dialogue: 0,0:10:46.51,0:10:50.16,Default,,0,0,0,,{\i1}Final maçı sonuca bağlanmak üzere!{\i0}
Dialogue: 0,0:10:50.16,0:10:52.40,Default,,0,0,0,,O gol benim suçumdu.
Dialogue: 0,0:10:52.40,0:10:55.04,Default,,0,0,0,,Karate yaparak bunu telafi edeceğim!
Dialogue: 0,0:10:55.04,0:10:59.80,Default,,0,0,0,,{\i1}Nankatsu kalan sürede topu elinde\Ntutarsa kazanacak. Ne olacak acaba?!{\i0}
Dialogue: 0,0:11:00.31,0:11:02.22,Default,,0,0,0,,Gidelim Wakabayashi-kun!
Dialogue: 0,0:11:02.22,0:11:04.26,Default,,0,0,0,,Atak yapmaya devam edeceğim!
Dialogue: 0,0:11:04.26,0:11:06.10,Default,,0,0,0,,Tamamdır, al!
Dialogue: 0,0:11:08.82,0:11:12.64,Default,,0,0,0,,{\i1}Wakabayashi-kun topu atmaya\Nçalışırken yere kapaklanıyor!{\i0}
Dialogue: 0,0:11:13.56,0:11:14.90,Default,,0,0,0,,Wakabayashi-san!
Dialogue: 0,0:11:14.90,0:11:21.90,Default,,0,0,0,,{\i1}Sol bacağında ağrı olduğu belliydi ama Wakabayashi-kun\Nhiç bu kadar acı çekiyor görünmemişti!{\i0}
Dialogue: 0,0:11:21.90,0:11:22.98,Default,,0,0,0,,Şimdi!
Dialogue: 0,0:11:22.98,0:11:26.91,Default,,0,0,0,,{\i1}Bu fırsatı kullanarak Meiwa'dan\NSawada-kun kaleye doğru koşuyor!{\i0}
Dialogue: 0,0:11:26.91,0:11:28.16,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:11:29.66,0:11:31.35,Default,,0,0,0,,{\i1}Takasugi-kun uzaklaştırıyor.{\i0}
Dialogue: 0,0:11:31.35,0:11:33.04,Default,,0,0,0,,{\i1}Nankatsu büyük bir tehlike atlattı.{\i0}
Dialogue: 0,0:11:33.04,0:11:36.54,Default,,0,0,0,,{\i1}Ama Wakabayashi-kun hala ayağa kalkamadı.{\i0}
Dialogue: 0,0:11:36.54,0:11:39.51,Default,,0,0,0,,{\i1}Lanet olsun!\NBuraya kadar mıydı?{\i0} {deliberately made it dramatic <3 he means my leg can only go this far? etc}
Dialogue: 0,0:11:39.51,0:11:41.02,Default,,0,0,0,,Genzo!
Dialogue: 0,0:11:41.02,0:11:43.26,Default,,0,0,0,,Morisaki, ısınmaya başla.
Dialogue: 0,0:11:43.26,0:11:44.09,Default,,0,0,0,,Tamam!
Dialogue: 0,0:11:44.09,0:11:46.00,Default,,0,0,0,,{\i1}Tamamdır, işte bu!{\i0}
Dialogue: 0,0:11:46.00,0:11:47.60,Default,,0,0,0,,{\i1}Wakabayashi artık yok.{\i0} {waka is no more}
Dialogue: 0,0:11:47.60,0:11:50.10,Default,,0,0,0,,{\i1}Şut çektiğim sürece gol olacaktır.{\i0}
Dialogue: 0,0:11:50.10,0:11:52.52,Default,,0,0,0,,{\i1}Uzaklaştırılan topu Meiwa alıyor.{\i0}
Dialogue: 0,0:11:52.52,0:11:54.90,Default,,0,0,0,,Gidelim! İşte fırsat!
Dialogue: 0,0:11:54.90,0:11:59.53,Default,,0,0,0,,{\i1}Meiwa FC hızlı bir atakla\Nkaleye doğru ilerliyor!{\i0}
Dialogue: 0,0:11:59.53,0:12:02.88,Default,,0,0,0,,Millet, ne olursa olsun şut\Nçekmelerine engel olmalıyız!
Dialogue: 0,0:12:02.88,0:12:04.64,Default,,0,0,0,,Topu geri alacağız!
Dialogue: 0,0:12:04.64,0:12:05.36,Default,,0,0,0,,Evet!
Dialogue: 0,0:12:05.36,0:12:11.37,Default,,0,0,0,,{\i1}Nankatsu kaptanı Tsubasa-kun defansı\Nyönlendirerek sıklaştırıyor!{\i0}
Dialogue: 0,0:12:12.20,0:12:15.19,Default,,0,0,0,,{\i1}Wakabayashi-kun'un daha fazla\Noynaması imkansızken...{\i0}
Dialogue: 0,0:12:15.19,0:12:18.13,Default,,0,0,0,,{\i1}...Nankatsu, yedek kaleci\NMorisaki'yi oyuna sokuyor.{\i0}
Dialogue: 0,0:12:18.13,0:12:21.74,Default,,0,0,0,,{\i1}Ama oyuncu değişikliği\Ntop saha dışındayken veya...{\i0}
Dialogue: 0,0:12:21.74,0:12:25.47,Default,,0,0,0,,{\i1}...faul sebepli oyun\Nduraklatıldığında yapılabilir.{\i0}
Dialogue: 0,0:12:25.47,0:12:28.53,Default,,0,0,0,,{\i1}Düşündüğüm gibi Nankatsu,\NWakabayashi'yi dışarı alacak.{\i0}
Dialogue: 0,0:12:28.53,0:12:31.39,Default,,0,0,0,,{\i1}Bu olmadan önce gol atmalıyım!{\i0} {that's a lot of respect shown for Morisaki}
Dialogue: 0,0:12:31.39,0:12:33.89,Default,,0,0,0,,{\i1}Hyuga-kun kaleye doğru koşuyor!{\i0}
Dialogue: 0,0:12:34.32,0:12:36.90,Default,,0,0,0,,{\i1}Ama Misaki-kun peşinde!{\i0}
Dialogue: 0,0:12:36.90,0:12:40.78,Default,,0,0,0,,{\i1}Tsubasa-kun ile ikili\Noyun oynamayı devam ettiremeyebilirim.{\i0}
Dialogue: 0,0:12:40.78,0:12:42.06,Default,,0,0,0,,{\i1}Ama yine de savunma yaparım!{\i0}
Dialogue: 0,0:12:42.06,0:12:45.11,Default,,0,0,0,,{\i1}Gücümün son damlasına kadar\NNankatsu adına oynayacağım!{\i0}
Dialogue: 0,0:12:45.80,0:12:48.07,Default,,0,0,0,,{\i1}Kojiro'yu ben tutacağım!{\i0}
Dialogue: 0,0:12:48.07,0:12:51.54,Default,,0,0,0,,{\i1}Yıldız oyuncu Hyuga-kun,\NMisaki-kun tarafından sıkı markaja alınıyor!{\i0}
Dialogue: 0,0:12:51.54,0:12:54.13,Default,,0,0,0,,{\i1}Meiwa pas veremiyor!{\i0}
Dialogue: 0,0:12:54.13,0:12:55.33,Default,,0,0,0,,İşte!
Dialogue: 0,0:12:55.33,0:12:56.96,Default,,0,0,0,,Topu çalalım!
Dialogue: 0,0:12:59.38,0:13:02.40,Default,,0,0,0,,{\i1}Lanet olsun!\NNankatsu her zamanki gibi inatçı!{\i0}
Dialogue: 0,0:13:02.40,0:13:05.30,Default,,0,0,0,,{\i1}Bu gidişle işimiz yaş!\NBir şeyler yapmak gerek!{\i0}
Dialogue: 0,0:13:05.30,0:13:08.28,Default,,0,0,0,,{\i1}Bir dakikadan az bir süre kaldı.{\i0}
Dialogue: 0,0:13:07.45,0:13:08.28,Default,,0,0,0,,{\an8}Durdurun!
Dialogue: 0,0:13:08.28,0:13:11.93,Default,,0,0,0,,{\i1}Nankatsu, Meiwa'nın şut\Nçekmesini engellemeye devam edebilecek mi?{\i0}
Dialogue: 0,0:13:11.93,0:13:13.18,Default,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:13:14.60,0:13:17.88,Default,,0,0,0,,{\i1}Meiwa ne yapıyor böyle?!{\i0}
Dialogue: 0,0:13:17.88,0:13:20.52,Default,,0,0,0,,{\i1}Kaleci Wakashimazu-kun geliyor!{\i0}
Dialogue: 0,0:13:20.52,0:13:23.15,Default,,0,0,0,,Beraberlik golünü ben atacağım!
Dialogue: 0,0:13:23.15,0:13:26.99,Default,,0,0,0,,{\i1}Meiwa tüm takım olarak\Nson bir atağa yükleniyor!{\i0}
Dialogue: 0,0:13:26.99,0:13:28.20,Default,,0,0,0,,Wakashimazu!
Dialogue: 0,0:13:28.20,0:13:29.32,Default,,0,0,0,,Takeshi!
Dialogue: 0,0:13:29.32,0:13:33.49,Default,,0,0,0,,{\i1}Misaki-kun'un bir anlık dikkat dağınıklığından\Nyararlanan Hyuga-kun boşta kalıyor!{\i0}
Dialogue: 0,0:13:33.49,0:13:34.37,Default,,0,0,0,,Hyuga-san!
Dialogue: 0,0:13:35.80,0:13:37.61,Default,,0,0,0,,{\i1}Hyuga-kun topu alıyor!{\i0}
Dialogue: 0,0:13:37.61,0:13:38.87,Default,,0,0,0,,{\i1}Tamamdır, bende!{\i0}
Dialogue: 0,0:13:38.87,0:13:39.88,Default,,0,0,0,,Ne?!
Dialogue: 0,0:13:39.88,0:13:41.19,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:13:41.19,0:13:44.38,Default,,0,0,0,,{\i1}Tsubasa-kun kalan son gücü ile\Ntop adına mücadele ediyor!{\i0} {how the hell I can tl saigo no iji?}{when in doubt, go more dramatic}
Dialogue: 0,0:13:45.63,0:13:48.88,Default,,0,0,0,,{\i1}Tsubasa-kun'un kayarak\Nmüdahalesi mi erken gelecek...{\i0}
Dialogue: 0,0:13:48.88,0:13:51.39,Default,,0,0,0,,{\i1}...yoksa Hyuga-kun'un şutu mu?!{\i0}
Dialogue: 0,0:13:51.39,0:13:54.14,Default,,0,0,0,,{\i1}Son mücadele!{\i0}
Dialogue: 0,0:13:56.29,0:13:58.52,Default,,0,0,0,,{\i1}Şutu daha hızlıydı!{\i0}
Dialogue: 0,0:13:58.52,0:14:01.31,Default,,0,0,0,,{\i1}Hyuga-kun'dan zıplayarak bir vole!{\i0}
Dialogue: 0,0:14:01.31,0:14:03.41,Default,,0,0,0,,{\i1}Girecek mi yoksa?!{\i0}
Dialogue: 0,0:14:03.41,0:14:04.29,Default,,0,0,0,,{\i1}Lanet olsun...{\i0}
Dialogue: 0,0:14:04.29,0:14:05.49,Default,,0,0,0,,{\i1}Pes edecek değilim.{\i0}
Dialogue: 0,0:14:05.49,0:14:07.49,Default,,0,0,0,,{\i1}Sadece sol bacağım ağrıyor.{\i0}
Dialogue: 0,0:14:07.49,0:14:10.07,Default,,0,0,0,,{\i1}Hala sağlam bir bacağım var!{\i0}
Dialogue: 0,0:14:10.07,0:14:13.33,Default,,0,0,0,,{\i1}Sağ ayağını kullanarak zıplıyor!{\i0}
Dialogue: 0,0:14:13.33,0:14:14.45,Default,,0,0,0,,Ne?!
Dialogue: 0,0:14:15.64,0:14:17.70,Default,,0,0,0,,{\i1}Ama ulaşamıyor!{\i0}
Dialogue: 0,0:14:21.50,0:14:23.50,Default,,0,0,0,,{\i1}Durdurdu!{\i0}
Dialogue: 0,0:14:24.59,0:14:25.96,Default,,0,0,0,,Wakabayashi-san!
Dialogue: 0,0:14:26.78,0:14:29.38,Default,,0,0,0,,{\i1}Sağ ayağıyla zıpladıktan sonra\Nelini kullanarak...{\i0}
Dialogue: 0,0:14:29.38,0:14:33.10,Default,,0,0,0,,{\i1}...atılmasını uzatıp topu uzaklaştırdı!{\i0}  {?, cant find a good word}{"rebounded and stopped"? feel free to change <3}
Dialogue: 0,0:14:33.10,0:14:35.26,Default,,0,0,0,,{\i1}Meiwa beraberliği sağlayamıyor!{\i0}
Dialogue: 0,0:14:35.26,0:14:36.72,Default,,0,0,0,,Tamamdır, uzaklaştıracağım!
Dialogue: 0,0:14:36.72,0:14:39.23,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:14:44.90,0:14:49.06,Default,,0,0,0,,{\i1}Bu, uçan tekme denilen karate hareketi!{\i0} {also known as "tobi yoko geri" in Karate}{i remove moonspeak} {says jump but <3}
Dialogue: 0,0:14:49.06,0:14:50.96,Default,,0,0,0,,{\i1}Bu gidişle beraberliği sağlayacaklar!{\i0}
Dialogue: 0,0:14:50.96,0:14:51.68,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:14:51.68,0:14:53.24,Default,,0,0,0,,O-Olamaz...
