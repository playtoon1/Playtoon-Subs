Dialogue: 0,0:13:10.03,0:13:15.02,Default,,0,0,0,,Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:00:01.23,0:00:04.10,Default,,0,0,0,,{\i1}Tsubasa'nın karşısına yeni bir rakip çıkar.{\i0}
Dialogue: 0,0:00:04.10,0:00:06.38,Default,,0,0,0,,{\i1}Adı ise Nitta Shun!{\i0}
Dialogue: 0,0:00:06.38,0:00:08.04,Default,,0,0,0,,{\i1}Muazzam güçlü bu oyuncu...{\i0}
Dialogue: 0,0:00:08.04,0:00:13.57,Default,,0,0,0,,{\i1}...kendine has güçlü Şahin Vuruşu ile\NTsubasa'yı bile şaşırtır.{\i0}
Dialogue: 0,0:00:13.57,0:00:18.95,Default,,0,0,0,,{\i1}Ne var ki Nankatsu oyuncuları,\Nrahat bir şekilde pratiklerine devam eder.{\i0} {who were practicing as usual, pay no heed to him.}
Dialogue: 0,0:00:18.95,0:00:23.92,Default,,0,0,0,,{\i1}Tsubasa duruma dikkat çekerek daha sıkı\Nçalışmaları konusunda onları azimlendirir.{\i0}
Dialogue: 0,0:00:23.92,0:00:25.58,Default,,0,0,0,,Tamamdır! Yapalım şunu!
Dialogue: 0,0:00:25.58,0:00:29.13,Default,,0,0,0,,{\i1}Ishizaki ve Kisugi'lerde de aynı duygunun uyanmasıyla...{\i0} {so 秘めたるis a word, huh? derived from himeru <3}
Dialogue: 0,0:00:29.13,0:00:32.67,Default,,0,0,0,,{\i1}...Nankatsu Ortaokulu birlik olur.{\i0}
Dialogue: 0,0:00:32.67,0:00:36.02,Default,,0,0,0,,{\i1}Öte yandan Urabe'nin\Nbulunduğu Otomo Ortaokulu...{\i0}
Dialogue: 0,0:00:36.02,0:00:38.68,Default,,0,0,0,,{\i1}...önceki şampiyon Tsubasa'yı devirmek\Niçin hazırlıklara devam ediyordur.{\i0}
Dialogue: 0,0:00:38.68,0:00:40.74,Default,,0,0,0,,{\i1}Ve de....{\i0}
Dialogue: 0,0:00:40.74,0:00:46.56,Default,,0,0,0,,{\i1}...Ulusal Ortaokul Futbol Turnuvası'na gidecek\Nbileti verecek Shizuoka Bölge Turnuvası başlar.{\i0}
Dialogue: 0,0:00:46.56,0:00:51.01,Default,,0,0,0,,{\i1}Tarihte ilk kez üst üste şampiyon\Nolmak isteyen Nankatsu Ortaokulu ve....{\i0}
Dialogue: 0,0:00:51.02,0:00:53.32,Default,,0,0,0,,{\i1}...aynı bölgeden Otomo Ortaokulu\Noldukça iddialıdır.{\i0}
Dialogue: 0,0:00:53.32,0:00:55.82,Default,,0,0,0,,{\i1}İkisi de güçlerini göstermeye kararlıdır...{\i0}
Dialogue: 0,0:00:55.82,0:00:58.32,Default,,0,0,0,,{\i1}...ve her maçı kazanarak bunu kanıtlar.{\i0}
Dialogue: 0,0:00:55.82,0:00:58.32,Default - Top,,0,0,0,,{\pos(428,446)}Otomo Ortaokulu
Dialogue: 0,0:00:58.32,0:01:00.12,Default,,0,0,0,,Şahin...
Dialogue: 0,0:01:00.68,0:01:02.00,Default,,0,0,0,,...Vuruşu!
Dialogue: 0,0:01:07.25,0:01:08.25,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:01:08.25,0:01:10.25,Default - Top,,0,0,0,,{\an8}Başardı!
Dialogue: 0,0:01:08.25,0:01:12.76,Default,,0,0,0,,{\pos(1296,662)}Yarı Final\NOtomo Ortaokulu: 5\NKawazuichi Ortaokulu: 0
Dialogue: 0,0:01:09.16,0:01:12.76,Default,,0,0,0,,{\i1}Gruplardan finale çıkan\Nilk takım Otomo Ortaokulu'yken...{\i0}
Dialogue: 0,0:01:12.76,0:01:14.51,Default,,0,0,0,,{\i1}...Nankatsu ise peşlerindedir.{\i0}
Dialogue: 0,0:01:14.51,0:01:15.43,Default,,0,0,0,,İşte!
Dialogue: 0,0:01:16.10,0:01:16.59,Default,,0,0,0,,Taki!
Dialogue: 0,0:01:17.96,0:01:18.47,Default,,0,0,0,,Kisugi!
Dialogue: 0,0:01:19.78,0:01:24.89,Default,,0,0,0,,{\i1}Yarı finallerde Okabe Ortaokulu'nu\N5-1 yenerek finallere çıkar.{\i0}
Dialogue: 0,0:01:22.56,0:01:24.89,Default,,0,0,0,,{\pos(500,682)}Yarı Final\NNankatsu Ortaokulu: 5:\NOkabe Ortaokulu: 1
Dialogue: 0,0:01:25.91,0:01:27.49,Default,,0,0,0,,Nankatsu'dan da bu beklenirdi.
Dialogue: 0,0:01:27.49,0:01:30.36,Default,,0,0,0,,Harika hareketleri var ve\Ndüzenlerinde açık yok.
Dialogue: 0,0:01:30.36,0:01:34.26,Default,,0,0,0,,Tsubasa as oyuncuları iken Izawa,\NTaki ve Kisugi atakta.
Dialogue: 0,0:01:34.26,0:01:38.00,Default,,0,0,0,,Defanslarında ise Morisaki,\NTakasugi ve Ishizaki var.
Dialogue: 0,0:01:38.82,0:01:43.58,Default,,0,0,0,,Harika bir takım gibi gözükmelerine\Nrağmen aslında sadece Tsubasa'dan ibaretler.
Dialogue: 0,0:01:43.58,0:01:48.58,Default,,0,0,0,,Atak ve savunma sadece Tsubasa'nın\Ntopu alıp onlara atmasına bağlı.
Dialogue: 0,0:01:48.58,0:01:52.59,Default,,0,0,0,,Bu yüzden Tsubasa'yı tuttuğumuz\Nsürece kazanabiliriz!{you're so wrong}
Dialogue: 0,0:01:52.59,0:01:54.46,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:01:55.34,0:02:00.45,Default,,0,0,0,,Ne var ki sadece Tsubasa'yı\Ntutmak, en zor şey.
Dialogue: 0,0:02:00.45,0:02:01.40,Default,,0,0,0,,Sen...
Dialogue: 0,0:02:01.40,0:02:02.89,Default,,0,0,0,,Hyuga Kojiro!
Dialogue: 0,0:02:02.89,0:02:09.90,Default,,0,0,0,,Sağ olsun geçen iki senenin\Nikincisi olarak bunun çok iyi farkına varmamı sağladı.{i'm the one who knows about that the most}
Dialogue: 0,0:02:09.90,0:02:12.52,Default,,0,0,0,,Ama bu sene farklı olacak.
Dialogue: 0,0:02:13.17,0:02:18.05,Default,,0,0,0,,Bu sene Toho Akademisi, takım\Nolarak Nankatsu'dan kesinlikle daha iyi!
Dialogue: 0,0:02:18.05,0:02:21.53,Default,,0,0,0,,Futbolda güçlü takım kazanır.
Dialogue: 0,0:02:21.53,0:02:25.50,Default,,0,0,0,,Bunu bu sene şampiyon\Nolarak kanıtlayacağım.
Dialogue: 0,0:02:25.50,0:02:26.76,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:02:26.76,0:02:30.96,Default,,0,0,0,,Ama Nankatsu'yu önce Otomo\Nolarak biz yeneceğiz!
Dialogue: 0,0:02:32.29,0:02:33.83,Default,,0,0,0,,Bu imkansız!
Dialogue: 0,0:02:33.83,0:02:39.20,Default,,0,0,0,,Oynayışınızı gördüm. Nankatsu'yu\Nyenmek sizin için çok uzak bir hayal!{there was a specific word for such impossible dreams?}
Dialogue: 0,0:02:39.20,0:02:39.97,Default,,0,0,0,,Ne dedin?!
Dialogue: 0,0:02:39.97,0:02:41.81,Default,,0,0,0,,Hyuga-san.
Dialogue: 0,0:02:41.81,0:02:45.38,Default,,0,0,0,,Bunu en azından bir kez\Nulusal şampiyon olduktan sonra söyle.{You should be saying such things only after you become the national champion even once.}
Dialogue: 0,0:02:45.38,0:02:46.47,Default,,0,0,0,,Ne?!
Dialogue: 0,0:02:46.47,0:02:49.87,Default,,0,0,0,,Dediğim gibi.\NBunu ben başarmıştım.
Dialogue: 0,0:02:49.87,0:02:56.03,Default,,0,0,0,,Biricik öğrencin Sawada Takeshi'yi\Nyenerek Japonya birincisi oldum.
Dialogue: 0,0:02:56.03,0:02:58.19,Default,,0,0,0,,Ben Nitta Shun!
Dialogue: 0,0:02:58.19,0:02:59.74,Default,,0,0,0,,Bunu iyice aklına kazı!
Dialogue: 0,0:04:32.25,0:04:37.25,ST_BAS_GAUCHE,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\fscx126\fscy126\xbord4.5\blur1\b1\fs70\pos(108,810.333)}Bölüm 30:\NBölgesel Turnuva Finalleri! Şahin Vuruşu!
Dialogue: 0,0:04:32.25,0:04:37.25,Default,,0,0,0,,{\fad(500,500)\bord2\3c&H373737&\xbord4.5\blur1\b1\fs70\pos(1516,914.333)}Çeviri: ARE-YOU-SURE\NAreyousureSubs Sunar
Dialogue: 0,0:04:37.85,0:04:39.92,Default,,0,0,0,,Günaydın!
Dialogue: 0,0:04:39.92,0:04:41.67,Default,,0,0,0,,Günaydın Kumi-chan!{why u not hisami, mocking me with your name;_;}
Dialogue: 0,0:04:41.67,0:04:45.64,Default,,0,0,0,,Nakazawa-senpai, final vakti geldi sayılır.
Dialogue: 0,0:04:45.64,0:04:47.68,Default,,0,0,0,,Kazanırsak ulusallara gideceğiz.
Dialogue: 0,0:04:47.68,0:04:50.68,Default,,0,0,0,,Bugün her şeyimle tezahürat yapacağım!
Dialogue: 0,0:04:51.27,0:04:52.90,Default,,0,0,0,,Bu da ne?
Dialogue: 0,0:04:53.56,0:04:56.81,Default,,0,0,0,,Limonları dilimleyip bala koydum.
Dialogue: 0,0:04:56.81,0:04:59.09,Default,,0,0,0,,Devre arasında yemeleri\Nhoş olur diye düşündüm.
Dialogue: 0,0:04:59.09,0:05:00.98,Default,,0,0,0,,Tsubasa-senpai için mi?
Dialogue: 0,0:05:00.98,0:05:02.94,Default,,0,0,0,,H-Herkes için...
Dialogue: 0,0:05:02.94,0:05:04.50,Default,,0,0,0,,Senden de bu beklenirdi Senpai!
Dialogue: 0,0:05:04.50,0:05:06.38,Default,,0,0,0,,Dışarısı çok sıcak gerçekten.{or you're too intense. i'm confused}{nah, it is "well in this heat it is only natural, first guess is correct}{lemons soaked in honey are no cure for the heat, silly anego}
Dialogue: 0,0:05:06.38,0:05:09.60,Default,,0,0,0,,Yorulup geldiğinde Tsubasa-senpai'yi\Nlimonlarla besleyeceksin.
Dialogue: 0,0:05:09.60,0:05:11.48,Default,,0,0,0,,İlk yarının yorgunluğu kaybolacak!
Dialogue: 0,0:05:11.48,0:05:13.50,Default,,0,0,0,,{\i1}"Evet! İkinci yarıda da böyle devam!"{\i0}
Dialogue: 0,0:05:14.25,0:05:15.50,Default,,0,0,0,,{\i1}"Şut!"{\i0}
Dialogue: 0,0:05:15.50,0:05:16.66,Default,,0,0,0,,{\i1}"Gol!"{\i0}
Dialogue: 0,0:05:16.66,0:05:17.78,Default,,0,0,0,,Ne yapıyorsun?
Dialogue: 0,0:05:19.74,0:05:21.08,Default,,0,0,0,,Hadi gidelim hemen.
Dialogue: 0,0:05:21.08,0:05:22.71,Default,,0,0,0,,Tamam...
Dialogue: 0,0:05:22.71,0:05:26.22,Default,,0,0,0,,{\i1}Shizuoka Bölge Turnuvası Finali\Nbaşlamak üzere.{\i0}
Dialogue: 0,0:05:26.22,0:05:32.27,Default,,0,0,0,,{\i1}Stadyum ağzına kadar doluyken\Ntaraflar tezahürat yarışması yapıyor!{\i0}
Dialogue: 0,0:05:30.67,0:05:33.21,Default - Top,,0,0,0,,{\an8}Otomo Ortaokulu, bastır!
Dialogue: 0,0:05:36.60,0:05:39.11,Default,,0,0,0,,Sonunda Ozora Tsubasa'yı göreceğiz.
Dialogue: 0,0:05:39.11,0:05:42.15,Default,,0,0,0,,Evet, sonunda.
Dialogue: 0,0:05:42.78,0:05:44.40,Default,,0,0,0,,Dinleyin millet.
Dialogue: 0,0:05:44.40,0:05:49.66,Default,,0,0,0,,Şimdiye kadar rahat bir şekilde geldik ama\NOtomo Ortaokulu biraz farklı olacak.
Dialogue: 0,0:05:49.66,0:05:52.60,Default,,0,0,0,,Her zamankinden daha dikkatli olmanızı istiyorum.
Dialogue: 0,0:05:52.60,0:05:53.49,Default,,0,0,0,,Tamam!
Dialogue: 0,0:05:53.49,0:05:55.43,Default,,0,0,0,,Koç.{is he the coach, or a teacher? i'll check}
Dialogue: 0,0:05:55.43,0:05:56.66,Default,,0,0,0,,Ne oldu Tsubasa?
Dialogue: 0,0:05:56.66,0:06:02.00,Default,,0,0,0,,Bugün ilk yarıda defans oynayıp Nitta'yı\Ntutmama izin verir misiniz?{do they seriously call that boranchi?borantia, volunteer <3}
Dialogue: 0,0:06:02.00,0:06:03.72,Default,,0,0,0,,Nitta'yı tutmak mı?
Dialogue: 0,0:06:03.72,0:06:04.52,Default,,0,0,0,,Evet.
Dialogue: 0,0:06:04.52,0:06:07.24,Default,,0,0,0,,Otobe takımında Urabe'ler\Nsıkıca kaleyi koruyorken...
Dialogue: 0,0:06:07.24,0:06:10.05,Default,,0,0,0,,...Nitta ile kontra atağa çıkıyorlar.
Dialogue: 0,0:06:10.05,0:06:13.43,Default,,0,0,0,,Her zamanki gibi atağa\Nyönelik oynarsam...
Dialogue: 0,0:06:13.43,0:06:17.85,Default,,0,0,0,,...onların istediği gibi Nitta\Nboşta kalmış olacak.
Dialogue: 0,0:06:17.85,0:06:22.61,Default,,0,0,0,,Ayrıca Nitta bana meydan\Nokuma konusunda oldukça ciddi.
Dialogue: 0,0:06:22.61,0:06:25.40,Default,,0,0,0,,Bunu kabul edip yüzleşmek istiyorum!
Dialogue: 0,0:06:26.36,0:06:28.99,Default,,0,0,0,,Anladım. Tsubasa'nın planını uygulayalım.
Dialogue: 0,0:06:28.99,0:06:30.72,Default,,0,0,0,,Millet, size de uygun mu?{as if you leave them any choice}{I'd translate this as, "Got it guys?" as iina? can be used as confirmation}
Dialogue: 0,0:06:30.72,0:06:31.82,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:32.33,0:06:37.04,Default,,0,0,0,,Bu sene, eski şampiyon Nankatsu'yu\Ndevirmek için çok çalıştık!
Dialogue: 0,0:06:37.04,0:06:41.70,Default,,0,0,0,,Ve bugün sonunda bu amacımıza\Nulaşacağımız vakit geldi!
Dialogue: 0,0:06:41.70,0:06:42.94,Default,,0,0,0,,Dinleyin millet.
Dialogue: 0,0:06:42.94,0:06:46.17,Default,,0,0,0,,Şu anki halimizle Nankatsu'yu\Nkesinlikle yenebiliriz!
Dialogue: 0,0:06:46.17,0:06:50.50,Default,,0,0,0,,Bu sene Nankatsu'yu yenerek\NUlusal Turnuva'ya katılacağız!
Dialogue: 0,0:06:50.50,0:06:51.30,Default,,0,0,0,,Evet!
Dialogue: 0,0:06:53.54,0:06:56.64,Default,,0,0,0,,{\i1}İki takım da sahaya çıkıyor.{\i0}
Dialogue: 0,0:06:56.64,0:06:59.12,Default,,0,0,0,,Bu zamana kadar hep aynı şeyi hedefledik.
Dialogue: 0,0:06:59.12,0:07:01.06,Default,,0,0,0,,Bu maç bir düello olacak.
Dialogue: 0,0:07:01.06,0:07:03.52,Default,,0,0,0,,{\i1}Taraflar çok heyecanlı!{\i0}
Dialogue: 0,0:07:03.52,0:07:06.36,Default,,0,0,0,,Otomo Ortaokulu! Bu sene Nankatsu'yu ezin geçin!
Dialogue: 0,0:07:06.36,0:07:10.15,Default,,0,0,0,,{\i1}İki takım da ilk maçtan beri\Nen iyi oyuncularını oynatıyor.{\i0}
Dialogue: 0,0:07:10.15,0:07:14.26,Default,,0,0,0,,{\i1}Bölgesel turnuvayı kazanıp Ulusal Turnuva'ya\Ngiden taraf Nankatsu mu Otomo mu olacak?{\i0} {do we need those names? how do we even show them?}
Dialogue: 0,0:07:14.26,0:07:17.18,Default,,0,0,0,,{\i1}İki takım da baştan beri\Noldukça iddialı.{\i0}
Dialogue: 0,0:07:17.18,0:07:19.12,Default,,0,0,0,,{\i1}Sonuç için çok heyecanlıyız!{\i0}
Dialogue: 0,0:07:19.70,0:07:24.34,Default,,0,0,0,,{\i1}Bildiğin gibi iki takımın da as oyuncuları...{\i0}
Dialogue: 0,0:07:24.34,0:07:28.88,Default,,0,0,0,,{\i1}...ilkokul sıralarındayken\NNankatsu'da takım arkadaşıydı.{\i0}
Dialogue: 0,0:07:28.88,0:07:32.89,Default,,0,0,0,,{\i1}Üstelik Otomo'dan Nitta-kun,\NTsubasa-kun'dan sonra...{\i0}
Dialogue: 0,0:07:32.89,0:07:40.14,Default,,0,0,0,,{\i1}...Nankatsu SC Kaptanı olarak Kaleci Ichijo-kun ile\Nbirlikte Ulusal Genç Futbol Turnuvası şampiyonu oldu.{\i0}
Dialogue: 0,0:07:40.14,0:07:43.27,Default,,0,0,0,,{\i1}Kaderlerinde olan bir karşılaşma\Ndenilebilir bu maça.{\i0}
Dialogue: 0,0:07:43.27,0:07:46.02,Default,,0,0,0,,{\i1}Yenilmez Nankatsu mu kazanacak?{\i0}
Dialogue: 0,0:07:46.02,0:07:48.15,Default,,0,0,0,,{\i1}Yoksa yeni Otomo mu kazanacak?{\i0}
Dialogue: 0,0:07:50.11,0:07:53.45,Default,,0,0,0,,{\i1}Shizuoka Bölge Turnuvası\Ntop vuruşuyla başladı.{\i0}
Dialogue: 0,0:07:53.45,0:07:56.45,Default,,0,0,0,,{\i1}Kisugi-kun ve Izawa-kun\Nrakip sahada ilerliyor.{\i0}
Dialogue: 0,0:07:56.45,0:07:59.54,Default,,0,0,0,,{\i1}Oyun kurucu Tsubasa-kun da gelecek mi?{\i0}
Dialogue: 0,0:08:00.08,0:08:01.49,Default,,0,0,0,,{\i1}Hayır, hareket etmiyor.{\i0}
Dialogue: 0,0:08:01.49,0:08:04.29,Default,,0,0,0,,{\i1}Tsubasa-kun arkada kalmayı sürdürüyor.{\i0}
Dialogue: 0,0:08:04.29,0:08:05.13,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:05.13,0:08:06.42,Default,,0,0,0,,Bu da ne demek?
Dialogue: 0,0:08:06.42,0:08:08.30,Default,,0,0,0,,Tsubasa atak yapmayacak mı?!
Dialogue: 0,0:08:08.30,0:08:11.92,Default,,0,0,0,,Tsubasa gelmese bile biz size yeteriz!{kisugi is pro at trashtalking lol}
Dialogue: 0,0:08:11.92,0:08:13.05,Default,,0,0,0,,Ne dedin?
Dialogue: 0,0:08:14.05,0:08:14.72,Default,,0,0,0,,Gidelim!
Dialogue: 0,0:08:14.72,0:08:15.69,Default,,0,0,0,,Evet!
Dialogue: 0,0:08:15.69,0:08:19.22,Default,,0,0,0,,{\i1}Nankatsu; Kisugi-kun, Taki-kun ve\NIzawa-kun ile atak yapıyor!{\i0}
Dialogue: 0,0:08:19.22,0:08:20.47,Default,,0,0,0,,Bizi hafife almayın!
Dialogue: 0,0:08:21.27,0:08:22.70,Default,,0,0,0,,{\i1}Aynen öyle.{\i0}
Dialogue: 0,0:08:22.70,0:08:26.52,Default,,0,0,0,,{\i1}Nankatsu'yu yenmeye bu kadar\Ntakmamızın sebebi...{\i0}
Dialogue: 0,0:08:26.52,0:08:28.76,Default,,0,0,0,,{\i1}...sizdiniz.{\i0}
Dialogue: 0,0:08:28.76,0:08:34.45,Default,,0,0,0,,{\i1}Nankatsu SC'deyken nasıl bakarsanız\Nbakın biz arka planda kalmıştık.{\i0}
Dialogue: 0,0:08:34.45,0:08:40.29,Default,,0,0,0,,{\i1}Ve siz Genç Futbol Turnuvası'nda\Nen değerli oyuncular seçildiniz.{\i0}
Dialogue: 0,0:08:40.29,0:08:44.54,Default,,0,0,0,,Aynen öyle! Aşağılık kompleksimi\Nyıllardır güçlenmek için kullandım!{boi, your pockets are overflowing with jelly}
Dialogue: 0,0:08:44.54,0:08:46.92,Default,,0,0,0,,Size de aynı şeyleri hissettireceğiz!{we'll make you feel the same}
Dialogue: 0,0:08:46.92,0:08:48.42,Default,,0,0,0,,Kazanan biz olacağız!
Dialogue: 0,0:08:48.42,0:08:50.05,Default,,0,0,0,,Geliyoruz Nankatsu!{Mob SC}
Dialogue: 0,0:08:50.05,0:08:52.13,Default,,0,0,0,,İzin verir miyiz sanıyorsunuz?!
Dialogue: 0,0:08:52.13,0:08:53.67,Default,,0,0,0,,Taki!
Dialogue: 0,0:08:56.72,0:08:58.72,Default,,0,0,0,,{\i1}Otomo Ortaokulu topu alıyor!{\i0}
Dialogue: 0,0:08:58.72,0:08:59.97,Default,,0,0,0,,Ne?!
Dialogue: 0,0:08:59.97,0:09:02.05,Default,,0,0,0,,{\i1}Otomo defansında bir duvar ören...{\i0}
Dialogue: 0,0:09:02.06,0:09:05.56,Default,,0,0,0,,{\i1}...Urabe-kun, Nishio-kun, Kishida-kun ve\MNakayama-kun Otomo Dörtlüsü'nü oluşturuyor!{\i0}
Dialogue: 0,0:09:05.56,0:09:07.62,Default,,0,0,0,,{\i1}Çok harika hareketleri var!{\i0}
Dialogue: 0,0:09:07.62,0:09:09.82,Default,,0,0,0,,Ne zaman güçlendiler bu kadar?
Dialogue: 0,0:09:09.82,0:09:11.30,Default,,0,0,0,,Onları durduracağız!
Dialogue: 0,0:09:11.30,0:09:12.32,Default,,0,0,0,,Evet!
Dialogue: 0,0:09:12.32,0:09:13.74,Default,,0,0,0,,Siz öyle sanın!
Dialogue: 0,0:09:15.11,0:09:17.28,Default,,0,0,0,,{\i1}Otomo Ortaokulu pas atıyor!{\i0}
Dialogue: 0,0:09:17.28,0:09:21.29,Default,,0,0,0,,{\i1}Pas direkt orta forvet Nitta-kun'a geliyor!{\i0}
Dialogue: 0,0:09:21.29,0:09:22.95,Default,,0,0,0,,Güzel pas Senpai!
Dialogue: 0,0:09:22.95,0:09:24.08,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:09:26.17,0:09:27.21,Default,,0,0,0,,Ne?!
Dialogue: 0,0:09:27.21,0:09:32.84,Default,,0,0,0,,{\i1}Nitta-kun, 100 metreyi 11 saniyede\Nkoşan hızıyla kaleye doğru ilerliyor!{\i0}
Dialogue: 0,0:09:32.84,0:09:35.59,Default,,0,0,0,,Tamamdır! Bir golle başlayalım!
Dialogue: 0,0:09:35.59,0:09:38.59,Default,,0,0,0,,{\i1}Ne var ki Nankatsu Kaptanı Tsubasa-kun\Nonu tutmak için geliyor!{\i0}
Dialogue: 0,0:09:38.59,0:09:41.60,Default,,0,0,0,,Tsubasa bu yüzden mi arkada kalmış?!
Dialogue: 0,0:09:41.60,0:09:42.76,Default,,0,0,0,,{\i1}Geldin demek!{\i0}
Dialogue: 0,0:09:42.76,0:09:45.10,Default,,0,0,0,,{\i1}Bu anı bekliyordum!{\i0}
Dialogue: 0,0:09:45.10,0:09:46.59,Default,,0,0,0,,{\i1}Gel Nitta.{\i0}
Dialogue: 0,0:09:46.59,0:09:48.85,Default,,0,0,0,,{\i1}Meydan okumanı kabul edeceğim.{\i0}
Dialogue: 0,0:10:00.28,0:10:03.87,Default,,0,0,0,,{\i1}Erken bir karşılaşma oldu!{\i0}
Dialogue: 0,0:10:08.66,0:10:11.75,Default,,0,0,0,,{\i1}Top, daha tecrübeli Tsubasa-kun'da kalıyor!{\i0}  {i cheated with FR subs to tl that senpai}
Dialogue: 0,0:10:11.75,0:10:13.30,Default,,0,0,0,,L-Lanet olsun!
Dialogue: 0,0:10:13.30,0:10:15.34,Default,,0,0,0,,Tamamdır, şimdi atak yapalım!
Dialogue: 0,0:10:15.34,0:10:17.34,Default,,0,0,0,,Lanet olası Ozora Tsubasa!{"this doesn't count"-tier sore loser}
Dialogue: 0,0:10:17.34,0:10:19.34,Default,,0,0,0,,Gerçek mücadelemiz şimdi başlayacak!
Dialogue: 0,0:10:19.34,0:10:21.34,Default,,0,0,0,,Ozora Tsubasa'dan da bu beklenirdi.{SASUGA JOKER}
Dialogue: 0,0:10:21.34,0:10:23.14,Default,,0,0,0,,Güzel hareketler.
Dialogue: 0,0:10:23.14,0:10:24.35,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:10:24.35,0:10:25.52,Default,,0,0,0,,Gel Tsubasa!
Dialogue: 0,0:10:25.52,0:10:28.02,Default,,0,0,0,,Bana gelmezsen hiç eğlencesi kalmayacak!
Dialogue: 0,0:10:28.02,0:10:31.81,Default,,0,0,0,,{\i1}Tsubasa-kun, Otomo Dörtlüsü bekliyor!{\i0}
Dialogue: 0,0:10:31.81,0:10:36.84,Default,,0,0,0,,{\i1}Geçen senemizi Nankatsu'yu,\NTsubasa'yı yenmeye adadık!{\i0}
Dialogue: 0,0:10:36.84,0:10:39.82,Default,,0,0,0,,{\i1}Tsubasa'nın hızına yetişebilmek için...
Dialogue: 0,0:10:39.82,0:10:42.70,Default,,0,0,0,,{\i1}Tsubasa'nın çalımlarına karşı koyabilmek için...{\i0} {he says "feint" but this flows more, no?}
Dialogue: 0,0:10:42.70,0:10:45.70,Default,,0,0,0,,{\i1}...bir yıl boyunca sürekli antrenman yaptık!{\i0}
Dialogue: 0,0:10:45.70,0:10:48.26,Default,,0,0,0,,{\i1}Futbol konusunda sizin kadar\Nyetenekli olmasak da...{\i0}
Dialogue: 0,0:10:48.26,0:10:51.21,Default,,0,0,0,,{\i1}...çabalama ve sıkı çalışma\Nkonusunda size kaybetmeyeceğiz!{\i0}
Dialogue: 0,0:10:51.21,0:10:54.30,Default,,0,0,0,,Antrenmanlarımızın meyvesini\Nsana göstereceğiz Tsubasa!
Dialogue: 0,0:10:54.30,0:10:56.09,Default,,0,0,0,,Geçebiliyorsan geç bakalım bizi!
Dialogue: 0,0:10:56.09,0:10:57.78,Default,,0,0,0,,{\i1}Bu kez geçeceğim.{\i0}
Dialogue: 0,0:10:57.78,0:10:59.51,Default,,0,0,0,,{\i1}Yaptıklarını iade edeceğim.{\i0}
Dialogue: 0,0:11:00.11,0:11:02.85,Default,,0,0,0,,{\i1}Başa baş bir mücadele bu!{\i0}
Dialogue: 0,0:11:06.98,0:11:07.60,Default,,0,0,0,,{\i1}Bende!{\i0}
Dialogue: 0,0:11:09.14,0:11:12.52,Default,,0,0,0,,{\i1}Tsubasa-kun'un ayağı takılıp\Ndengesini kaybediyor!{\i0}
Dialogue: 0,0:11:12.52,0:11:13.56,Default,,0,0,0,,Tsubasa!
Dialogue: 0,0:11:16.14,0:11:17.11,Default,,0,0,0,,Tsubasa?
Dialogue: 0,0:11:17.11,0:11:19.85,Default,,0,0,0,,Ne oldu?\NO hareket de neydi?
Dialogue: 0,0:11:19.85,0:11:22.20,Default,,0,0,0,,Rakipleri de oldukça iyi.
Dialogue: 0,0:11:22.20,0:11:22.87,Default,,0,0,0,,Ne?
Dialogue: 0,0:11:22.87,0:11:29.12,Default,,0,0,0,,Tsubasa o dörtlüyü geçmek istese\Ntopu kesinlikle kaptıracaktı.
Dialogue: 0,0:11:29.12,0:11:31.44,Default,,0,0,0,,{\i1}Ne kadar keskin refleksler.{\i0}
Dialogue: 0,0:11:31.44,0:11:34.79,Default,,0,0,0,,{\i1}Çalım atabileceğim tüm yolları kapattılar.{\i0}
Dialogue: 0,0:11:34.79,0:11:36.38,Default,,0,0,0,,{\i1}Bu beklenirdi zaten.{\i0}
Dialogue: 0,0:11:36.38,0:11:40.64,Default,,0,0,0,,{\i1}Hareketlerimizi fark edip\Nhemen geri pas attın.{\i0}
Dialogue: 0,0:11:40.64,0:11:42.67,Default,,0,0,0,,Tamamdır! Bu kez Ishizaki'ye!
Dialogue: 0,0:11:42.67,0:11:43.80,Default,,0,0,0,,Evet!
Dialogue: 0,0:11:43.31,0:11:43.80,Default,,0,0,0,,Ne?!
Dialogue: 0,0:11:43.80,0:11:45.80,Default,,0,0,0,,Tsubasa yapamıyorsa bana imkansız!{this tl sucks, i probs didn't get this part nah, perfectly correct haha}
Dialogue: 0,0:11:46.93,0:11:48.76,Default,,0,0,0,,Tsubasa geri çekiliyor!
Dialogue: 0,0:11:48.76,0:11:49.85,Default,,0,0,0,,İşte fırsat!
Dialogue: 0,0:11:51.42,0:11:52.06,Default,,0,0,0,,Oda!
Dialogue: 0,0:11:55.08,0:11:55.94,Default,,0,0,0,,Takasugi!
Dialogue: 0,0:11:56.56,0:12:01.07,Default,,0,0,0,,{\i1}Geçen senenin şampiyonu Nankatsu,\Ntopu tutmasına rağmen sahada geri çekiliyor.{\i0} {they managed to put last year's champion under pressure}
Dialogue: 0,0:12:01.07,0:12:02.18,Default,,0,0,0,,Gördünüz mü?!
Dialogue: 0,0:12:02.18,0:12:05.32,Default,,0,0,0,,Tsubasa'yı alt edersek\NNankatsu'nun çapı bu kadar işte!
Dialogue: 0,0:12:05.32,0:12:06.80,Default,,0,0,0,,L-Lanet girsin...
Dialogue: 0,0:12:06.80,0:12:09.08,Default,,0,0,0,,Millet! Oyunun gidişatını onlara bırakmayın!{i love morisaki}
Dialogue: 0,0:12:09.08,0:12:10.93,Default,,0,0,0,,Topu Tsubasa'ya ulaştırın!
Dialogue: 0,0:12:10.93,0:12:12.00,Default,,0,0,0,,E-Evet.
Dialogue: 0,0:12:12.00,0:12:14.33,Default,,0,0,0,,{\i1}Nankatsu, topu Tsubasa-kun'a ulaştırıyor.{\i0}
Dialogue: 0,0:12:15.56,0:12:18.54,Default,,0,0,0,,{\i1}Tsubasa-kun'un yönettiği bir\Nkontra atak mı yapacaklar?{\i0}
Dialogue: 0,0:12:18.54,0:12:19.67,Default,,0,0,0,,Gel Tsubasa!
Dialogue: 0,0:12:19.67,0:12:20.46,Default,,0,0,0,,Izawa!
Dialogue: 0,0:12:20.46,0:12:23.13,Default,,0,0,0,,{\i1}Ofsayt olmaktan zorla\Nsıyrılan bir pas bu!{\i0} {let's have a moment of silence for Misugi}{amen}
Dialogue: 0,0:12:23.13,0:12:24.39,Default,,0,0,0,,İzin vermem!
Dialogue: 0,0:12:24.39,0:12:27.43,Default,,0,0,0,,{\i1}Ne var ki Otomo'dan\NNakayama-kun pası kesecek gibi.{\i0}
Dialogue: 0,0:12:28.16,0:12:28.85,Default,,0,0,0,,Ne?!
Dialogue: 0,0:12:28.89,0:12:32.14,Default,,0,0,0,,{\i1}Ne?! Top havada yön değiştiriyor!{\i0}
Dialogue: 0,0:12:32.72,0:12:33.64,Default,,0,0,0,,Hadi!
Dialogue: 0,0:12:33.64,0:12:36.40,Default,,0,0,0,,{\i1}Tsubasa-kun, Nakayama-kun'un\Npası keseceğini anlayarak...{\i0}
Dialogue: 0,0:12:36.40,0:12:38.77,Default,,0,0,0,,{\i1}...topu hafif bir falsoyla göndermiş.{\i0}
Dialogue: 0,0:12:38.77,0:12:40.27,Default,,0,0,0,,Başardın Tsubasa!
Dialogue: 0,0:12:40.27,0:12:41.78,Default,,0,0,0,,{\i1}Ulan Nakayama...{\i0}
Dialogue: 0,0:12:41.78,0:12:44.36,Default,,0,0,0,,{\i1}Tsubasa'yı hafife alırsan bu olur işte.{\i0}
Dialogue: 0,0:12:44.36,0:12:48.20,Default,,0,0,0,,{\i1}Izawa-kun pası aldıktan sonra\Nboşta kalıyor ve şut çekiyor!{\i0}
Dialogue: 0,0:12:49.87,0:12:51.33,Default,,0,0,0,,Tamamdır, gol!
Dialogue: 0,0:12:52.24,0:12:53.44,Default,,0,0,0,,{\i1}Yakaladı!{\i0}
Dialogue: 0,0:12:53.44,0:12:57.84,Default,,0,0,0,,{\i1}Otomo kalecisi Ichijo-kun\Natılarak yakalıyor!{\i0}
Dialogue: 0,0:12:57.84,0:12:59.46,Default,,0,0,0,,O-Olamaz...{what can't be? just a GK doing his job}
Dialogue: 0,0:13:02.46,0:13:06.89,Default,,0,0,0,,Finallere kadar geldik.\NSonunda kendimi gösterme vaktim geldi.
Dialogue: 0,0:13:15.02,0:13:20.23,Default,,0,0,0,,{\i1}Kaleci Ichijo-kun harika bir yakalayışla\NOtomo'yu zor durumdan kurtarıyor!{\i0}
Dialogue: 0,0:13:20.23,0:13:21.57,Default,,0,0,0,,Çok güzel Ichijo.
Dialogue: 0,0:13:21.57,0:13:23.87,Default,,0,0,0,,Oradan gelen şutu yakaladı.
Dialogue: 0,0:13:23.87,0:13:29.03,Default,,0,0,0,,Bu turnuvada Izawa'nın boştayken\Nattığı tüm şutlar gol olmuştu.
Dialogue: 0,0:13:29.03,0:13:30.50,Default,,0,0,0,,Çok yakındı!
Dialogue: 0,0:13:30.50,0:13:32.81,Default,,0,0,0,,Kesin gol demiştim!
Dialogue: 0,0:13:32.81,0:13:35.77,Default,,0,0,0,,Görünen o ki rakibin kalecisi de çok iyi.
Dialogue: 0,0:13:35.77,0:13:39.00,Default,,0,0,0,,Bu maçı Nankatsu kaybedebilir.
Dialogue: 0,0:13:39.00,0:13:42.55,Default,,0,0,0,,Dur bakalım!\NNankatsu kaybedebilir de ne demek?
Dialogue: 0,0:13:42.55,0:13:44.30,Default,,0,0,0,,Hiroshi-kun!
Dialogue: 0,0:13:45.13,0:13:46.34,Default,,0,0,0,,Yukari!
Dialogue: 0,0:13:46.34,0:13:48.38,Default,,0,0,0,,Gerçekten de sensin Hiroshi-kun.
Dialogue: 0,0:13:48.38,0:13:49.92,Default,,0,0,0,,Ne işin var burada?
Dialogue: 0,0:13:49.92,0:13:51.35,Default,,0,0,0,,Ne işi mi?
Dialogue: 0,0:13:51.35,0:13:54.00,Default,,0,0,0,,Nankatsu maçını izlemeye geldim.{SO, he says "tai" after everything and this is part of Jito's fucking annoying charm. the scanlation loves using "okay" for everything, but i'm thinking y'know.}
Dialogue: 0,0:13:54.00,0:13:56.58,Default,,0,0,0,,Yukari, asıl senin ne işin var?
Dialogue: 0,0:13:56.58,0:13:59.77,Default,,0,0,0,,Nankatsu Ortaokulu Futbol\NKulübü'nün menajeriyim.
Dialogue: 0,0:13:59.77,0:14:02.91,Default,,0,0,0,,Yukari-senpai, tanışıyor musunuz?
Dialogue: 0,0:14:02.91,0:14:04.65,Default,,0,0,0,,Tanıştırayım.
Dialogue: 0,0:14:04.65,0:14:08.34,Default,,0,0,0,,Kyushu'da futbol oyuncusu olan\Nkuzenim Jito Hiroshi-kun.
Dialogue: 0,0:14:08.34,0:14:09.32,Default,,0,0,0,,Evet.
Dialogue: 0,0:14:09.32,0:14:12.38,Default,,0,0,0,,Ee, Nankatsu kaybedebilir de ne demek?
Dialogue: 0,0:14:13.08,0:14:14.83,Default,,0,0,0,,Aynen dediğim gibi.
Dialogue: 0,0:14:14.83,0:14:18.24,Default,,0,0,0,,Nankatsu'nun gücünü görmek\Niçin geldik ama...
Dialogue: 0,0:14:18.24,0:14:22.29,Default,,0,0,0,,...rakipleri Otomo Ortaokulu da\Noldukça güçlü görünüyor.
Dialogue: 0,0:14:22.97,0:14:25.34,Default,,0,0,0,,Tsubasa'nın geçemediği o dörtlü.
Dialogue: 0,0:14:25.34,0:14:30.59,Default,,0,0,0,,Ayrıca başka bir durumda gol olacak\No şutu durduran kaleci.
Dialogue: 0,0:14:30.59,0:14:34.64,Default,,0,0,0,,Çok gösterişli olmasalar da\Nyetenekleri bayağı iyi.
Dialogue: 0,0:14:34.64,0:14:38.81,Default,,0,0,0,,Ayrıca özellikle 9 numara ilgimi çekiyor.{yes, i plan on doing this for every fucking "tai" so get ready}
Dialogue: 0,0:14:38.81,0:14:39.85,Default,,0,0,0,,Aynen öyle.
Dialogue: 0,0:14:40.94,0:14:43.96,Default,,0,0,0,,Tsubasa ile mücadelesinde\Ntopu kaybetmesine rağmen...
Dialogue: 0,0:14:43.96,0:14:46.07,Default,,0,0,0,,...oldukça yakın bir mücadeleydi.
Dialogue: 0,0:14:46.07,0:14:49.23,Default,,0,0,0,,Eminim Tsubasa da onun\Nyeteneklerinin farkındadır.
Dialogue: 0,0:14:49.23,0:14:51.03,Default,,0,0,0,,Bugün onu kendisi tutuyor.
Dialogue: 0,0:14:51.03,0:14:53.82,Default,,0,0,0,,Sen de kimsin?{seemed a lil bit rudish, so, well we may add sir kek}
Dialogue: 0,0:14:53.82,0:14:57.75,Default,,0,0,0,,Japonya Ulusal Futbol\NFederasyonu'ndan Katagiri.
Dialogue: 0,0:14:57.75,0:15:03.93,Default,,0,0,0,,Sen ise Nagasaki bölgesi temsilcisi\NHirado Ortaokulu'ndan Jito Hiroshi-kun'sun.{is he a middle schooler? wtf?}
Dialogue: 0,0:15:04.71,0:15:08.28,Default,,0,0,0,,İki takımın da defansa odaklandığı bu maçta...
Dialogue: 0,0:15:08.28,0:15:10.39,Default,,0,0,0,,...çok gol beklemiyorum.{many is used for COUNTABLE things, much is for things you can't count; there's "too much arrogance" because arrogance is not something you can count (1 arrogance, 2 arrogances... what the hell? no, shit's an adjective not a noun), while there are "too many goals" because you can count goals (1 goal, 2 goals, 3 goals)}
Dialogue: 0,0:15:10.39,0:15:13.60,Default,,0,0,0,,Yani ilk gol çok etkili olacak.
Dialogue: 0,0:15:13.60,0:15:16.36,Default,,0,0,0,,Otomo Ortaokulu'nun kalecisi\Niçin gördüğüm kadarıyla...
Dialogue: 0,0:15:16.36,0:15:19.39,Default,,0,0,0,,...Tsubasa'nın şut çekip gol atması gerekiyor.
Dialogue: 0,0:15:19.39,0:15:21.91,Default,,0,0,0,,Ama Tsubasa atağa çıkarsa...
Dialogue: 0,0:15:21.91,0:15:24.15,Default,,0,0,0,,...9 numara boşta kalacak.
Dialogue: 0,0:15:24.15,0:15:31.12,Default,,0,0,0,,Bu durumda Otomo atak ve defansta daha\Ndengeli olarak avantajı elinde tutuyor.
